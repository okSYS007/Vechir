КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ЗаявкиНаРасходованиеНаличные.Очистить();
	ЗаявкиНаРасходованиеБезналичные.Очистить();

	ИнициализироватьКомпоновкуДанных(Ложь);

	СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СхемаЗаполнения");	
	
	Если ЗаВесьПериод Тогда   
		
			
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода");
		ЭД.Значение = Дата(2000,1,1);
		ЭД.Использование = Истина;
		
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
		ЭД.Значение = Дата(2050,1,1);
		ЭД.Использование = Истина;

				
	Иначе 
		
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода");
		ЭД.Значение = Период.ДатаНачала;
		ЭД.Использование = Истина;
		
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
		ЭД.Значение = Период.ДатаОкончания;
		ЭД.Использование = Истина;
	
		
	КонецЕсли;
	
	ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ФормаОплаты");
	ЭД.Значение = Перечисления.ВидыДенежныхСредств.Безналичные;
	ЭД.Использование = Истина;

	
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпановщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ = Новый ТаблицаЗначений;
	//ТЗ = ЗаявкиНаРасходованиеБезналичные.Выгрузить();
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ЗаявкиНаРасходованиеБезналичные.Загрузить(ТЗ);	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	КомпановщикНастроек = Неопределено;
	ИнициализироватьКомпоновкуДанных(Ложь);
	
	
	Если ЗаВесьПериод Тогда   
		
			
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода");
		ЭД.Значение = Дата(2000,1,1);
		ЭД.Использование = Истина;
		
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
		ЭД.Значение = Дата(2050,1,1);
		ЭД.Использование = Истина;

				
	Иначе 
		
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода");
		ЭД.Значение = Период.ДатаНачала;
		ЭД.Использование = Истина;
		
		ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
		ЭД.Значение = Период.ДатаОкончания;
		ЭД.Использование = Истина;
	
		
	КонецЕсли;
	
	ЭД = КомпановщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ФормаОплаты");
	ЭД.Значение = Перечисления.ВидыДенежныхСредств.Наличные;
	ЭД.Использование = Истина;


	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпановщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ = Новый ТаблицаЗначений;
	//ТЗ = ЗаявкиНаРасходованиеНаличные.Выгрузить();
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);

	ЗаявкиНаРасходованиеНаличные.Загрузить(ТЗ);
		
КонецПроцедуры


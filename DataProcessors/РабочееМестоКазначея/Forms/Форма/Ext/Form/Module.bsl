&НаСервере
Функция СоздатьРеестрНаОплатуНаСервере(ФормаОплаты) 
	
	Реестр        = Документы.РеестрПлатежей.СоздатьДокумент();
	Реестр.ФормаОплаты = ФормаОплаты;
	Реестр.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Реестр.Статус = Перечисления.СтатусыРеестраНаОплатуДС.Черновик;
	
	Если ФормаОплаты = Перечисления.ВидыДенежныхСредств.Наличные Тогда 
		Для Каждого Строка из ЗаявкиНаРасходованиеНаличные цикл
			Если Строка.использовать тогда 
				//Если не НайтиРеестр(строка.Документ) Тогда 
					Реестр.Дата                  = ТекущаяДата();
					СтрокаРеестра                = Реестр.ЗаявкиНаРасходованиеДС.Добавить();
					СтрокаРеестра.Заявка         = строка.Документ;
					СтрокаРеестра.СуммаДокумента = ПолучитьОстатокПоЗаявке(строка.Документ);
					СтрокаРеестра.СуммаКОплате   = ПолучитьОстатокПоЗаявке(строка.Документ);
					СтрокаРеестра.СтатьяДДС      = строка.Документ.РасшифровкаПлатежа[0].СтатьяДвиженияДенежныхСредств;
					СтрокаРеестра.Проект         = строка.Документ.РасшифровкаПлатежа[0].Проект;
					Реестр.Записать();
					строка.НомерРеестра = Реестр.Номер; 
				//КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Для Каждого Строка из ЗаявкиНаРасходованиеБезналичные цикл
			Если Строка.использовать тогда 
				//Если не НайтиРеестр(строка.Документ) Тогда 
					Реестр.Дата   		 		 = ТекущаяДата();
					СтрокаРеестра		 		 = Реестр.ЗаявкиНаРасходованиеДС.Добавить();
					СтрокаРеестра.Заявка 		 = строка.Документ;
					СтрокаРеестра.СуммаДокумента = ПолучитьОстатокПоЗаявке(строка.Документ);
					СтрокаРеестра.СуммаКОплате   = ПолучитьОстатокПоЗаявке(строка.Документ);
					СтрокаРеестра.СтатьяДДС      = строка.Документ.РасшифровкаПлатежа[0].СтатьяДвиженияДенежныхСредств;
					СтрокаРеестра.Проект         = строка.Документ.РасшифровкаПлатежа[0].Проект;
					Реестр.Записать();
					строка.НомерРеестра = Реестр.Номер; 
				//КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Реестр.Ссылка;
	
КонецФункции

&НаСервере
Функция НайтиРеестр(Заявка)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеестрПлатежейЗаявкиНаРасходованиеДС.Ссылка
	               |ИЗ
	               |	Документ.РеестрПлатежей.ЗаявкиНаРасходованиеДС КАК РеестрПлатежейЗаявкиНаРасходованиеДС
	               |ГДЕ
	               |	РеестрПлатежейЗаявкиНаРасходованиеДС.Заявка = &Заявка
	               |	И РеестрПлатежейЗаявкиНаРасходованиеДС.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Заявка",Заявка);
	
	Возврат Запрос.Выполнить().Выгрузить().Количество();
КонецФункции


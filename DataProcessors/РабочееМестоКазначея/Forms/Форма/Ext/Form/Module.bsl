Функция ПолучитьОстатокПоЗаявке(Заявка)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДенежныеСредстваКВыплатеОстатки.СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.ЗаявкиНаРасходованиеСредств.Остатки КАК ДенежныеСредстваКВыплатеОстатки
	               |ГДЕ
	               |	ДенежныеСредстваКВыплатеОстатки.ЗаявкаНаРасходование = &ЗаявкаНаРасходованиеДенежныхСредств";
	Запрос.УстановитьПараметр("ЗаявкаНаРасходованиеДенежныхСредств",Заявка);
	
	РезультатЗапрос = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапрос.Количество() Тогда 
		Возврат РезультатЗапрос[0].СуммаОстаток;
		
	КонецЕсли;
	Возврат 0;	
КонецФункции

&НаСервере
Процедура ОтправитьПисьмоНаСервере(ИмяТч)
	
	Если ИмяТч = "ЗаявкиБезнал" Тогда
		
		стрПоиска = Новый Структура;
		стрПоиска.Вставить("Использовать", Истина);
		стрПоиска.Вставить("Статус", Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Согласована);
		
		НайденныеСтроки = ЗаявкиНаРасходованиеБезналичные.НайтиСтроки(стрПоиска);
		
	ИначеЕсли ИмяТч = "ЗаявкиНал" Тогда	
		
		стрПоиска = Новый Структура;
		стрПоиска.Вставить("Использовать", Истина);
		стрПоиска.Вставить("Статус", Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Согласована);
		
		НайденныеСтроки = ЗаявкиНаРасходованиеНаличные.НайтиСтроки(стрПоиска);
		
	ИначеЕсли ИмяТч = "ЗаявкиРеестр" Тогда	
		
		стрПоиска = Новый Структура;
		стрПоиска.Вставить("Использовать", Истина);
		стрПоиска.Вставить("Статус", Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Согласована);
		
		НайденныеСтроки = ЗаявкиНаРасходованиеНаличные.НайтиСтроки(стрПоиска);
		
	КонецЕсли;
	
	ПользовательОтправкиПоПочте = Справочники.Пользователи.НайтиПоНаименованию("Почтовый пользователь", Истина);
	ПутьСохранения = Неопределено;
	
	СоответсвиеОрганизацииИЗаявки = Новый Соответствие;
	
	Для Каждого НайденнаяСтрока из НайденныеСтроки Цикл
		
		Если СоответсвиеОрганизацииИЗаявки[НайденнаяСтрока.Документ.Организация] = Неопределено Тогда
			МассЗаявок = Новый Массив;
			МассЗаявок.Добавить(НайденнаяСтрока.Документ);
			СоответсвиеОрганизацииИЗаявки.Вставить(НайденнаяСтрока.Документ.Организация, МассЗаявок);
		Иначе
			СоответсвиеОрганизацииИЗаявки[НайденнаяСтрока.Документ.Организация].Добавить(НайденнаяСтрока.Документ);
		КонецЕсли;

	КонецЦикла;
	
	УчЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Автоматична система відправки повідоплень");
	Для Каждого ЗаявкиИОтправители из СоответсвиеОрганизацииИЗаявки Цикл
		
		СписокПолучателей = Новый СписокЗначений;
		ЗаполнитьПоОрганизации(СписокПолучателей, ЗаявкиИОтправители.Ключ);
		
		ТемаПисьма 	= "Заявки узгодженні";
		ТекстПисьма = "Список заявок: <br>" ;
		Для Каждого стрЗаявка из ЗаявкиИОтправители.Значение Цикл
			
			ТекстПисьма = ТекстПисьма + " №" + стрЗаявка.Номер + ". від " + Формат(стрЗаявка.Дата, "ДЛФ=В") + "; <br> " ;
			
		КонецЦикла;
		
		Если СписокПолучателей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрПисьма = Новый Структура;
		СтрПисьма.Вставить("ОтправленоФоном", Истина);
		СтрПисьма.Вставить("Тело", ТекстПисьма);
		СтрПисьма.Вставить("Тема", ТемаПисьма);
		СтрПисьма.Вставить("УчетнаяЗапись", УчЗапись);
		СтрПисьма.Вставить("Кому", СписокПолучателей);
		СтрПисьмо = УправлениеЭлектроннойПочтой.НаписатьПисьмо(ПользовательОтправкиПоПочте, СтрПисьма,,,,,,,Ложь); 
		СтрПисьмо.Письмо.ОтправитьПисьмо(, ПользовательОтправкиПоПочте);
		
	КонецЦикла;
	
	Сообщить("Листи надіслано");

КонецПроцедуры


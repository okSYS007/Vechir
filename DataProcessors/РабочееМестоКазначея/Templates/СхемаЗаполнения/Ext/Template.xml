		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаявкаНаРасходованиеСредств.Дата,
	ЗаявкаНаРасходованиеСредств.Номер,
	ЗаявкаНаРасходованиеСредств.ВидОперации,
	ЗаявкаНаРасходованиеСредств.ДатаРасхода КАК ДатаПлатежа,
	ЗаявкаНаРасходованиеСредств.ФормаОплаты,
	ЗаявкаНаРасходованиеСредств.ВалютаДокумента КАК Валюта,
	ЗаявкаНаРасходованиеСредств.БанковскийСчетКасса КАК БанковскийСчет,
	ЗаявкаНаРасходованиеСредств.БанковскийСчетКасса.Банк КАК Банк,
	ЗаявкаНаРасходованиеСредств.ЦФО КАК подразделение,
	ЗаявкаНаРасходованиеСредств.Контрагент,
	РеестрПлатежейЗаявкиНаРасходованиеДС.Ссылка.Номер КАК НомерРеестра,
	МАКСИМУМ(СогласованиеЗаявкиНаРасходованиеДенежныхСредствРезультатыСогласования.ДатаСогласования) КАК ДатаУтверждения,
	ЗаявкаНаРасходованиеСредств.Ссылка КАК Документ,
	ЗаявкаНаРасходованиеСредств.СуммаДокумента,
	РеестрПлатежейЗаявкиНаРасходованиеДС.Ссылка КАК Реестр,
	ЗаявкиНаРасходованиеСредствОстатки.СуммаОстаток КАК ОстатокКОплате,
	ЗаявкаНаРасходованиеСредств.Статус
ИЗ
	Документ.ЗаявкаНаРасходованиеСредств КАК ЗаявкаНаРасходованиеСредств
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеестрПлатежей.ЗаявкиНаРасходованиеДС КАК РеестрПлатежейЗаявкиНаРасходованиеДС
		ПО ЗаявкаНаРасходованиеСредств.Ссылка = РеестрПлатежейЗаявкиНаРасходованиеДС.Заявка
		ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.СогласованиеЗаявкиНаРасходованиеДенежныхСредств.РезультатыСогласования КАК СогласованиеЗаявкиНаРасходованиеДенежныхСредствРезультатыСогласования
		ПО ЗаявкаНаРасходованиеСредств.Ссылка = СогласованиеЗаявкиНаРасходованиеДенежныхСредствРезультатыСогласования.Ссылка.Предмет
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаявкиНаРасходованиеСредств.Остатки КАК ЗаявкиНаРасходованиеСредствОстатки
		ПО ЗаявкаНаРасходованиеСредств.Ссылка = ЗаявкиНаРасходованиеСредствОстатки.ЗаявкаНаРасходование
ГДЕ
	ЗаявкаНаРасходованиеСредств.Проведен
	И (ЗаявкаНаРасходованиеСредств.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокНаРасходованиеДенежныхСредств.согласована)
			ИЛИ ЗаявкаНаРасходованиеСредств.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокНаРасходованиеДенежныхСредств.ЧастичноОплачена)
			ИЛИ ЗаявкаНаРасходованиеСредств.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокНаРасходованиеДенежныхСредств.кОплате))
	И ЗаявкаНаРасходованиеСредств.ДатаРасхода МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЗаявкаНаРасходованиеСредств.ФормаОплаты = &amp;ФормаОплаты
	И (РеестрПлатежейЗаявкиНаРасходованиеДС.Документ.Ссылка ЕСТЬ NULL
			ИЛИ РеестрПлатежейЗаявкиНаРасходованиеДС.Ссылка ЕСТЬ NULL)

СГРУППИРОВАТЬ ПО
	ЗаявкаНаРасходованиеСредств.Дата,
	ЗаявкаНаРасходованиеСредств.Номер,
	ЗаявкаНаРасходованиеСредств.ВидОперации,
	ЗаявкаНаРасходованиеСредств.ДатаРасхода,
	ЗаявкаНаРасходованиеСредств.ВалютаДокумента,
	ЗаявкаНаРасходованиеСредств.Контрагент,
	ЗаявкаНаРасходованиеСредств.БанковскийСчетКасса,
	ЗаявкаНаРасходованиеСредств.ФормаОплаты,
	РеестрПлатежейЗаявкиНаРасходованиеДС.Ссылка.Номер,
	ЗаявкаНаРасходованиеСредств.ЦФО,
	ЗаявкаНаРасходованиеСредств.БанковскийСчетКасса.Банк,
	ЗаявкаНаРасходованиеСредств.Ссылка,
	ЗаявкаНаРасходованиеСредств.СуммаДокумента,
	РеестрПлатежейЗаявкиНаРасходованиеДС.Ссылка,
	ЗаявкиНаРасходованиеСредствОстатки.СуммаОстаток,
	ЗаявкаНаРасходованиеСредств.Статус</query>


// Хранит дерево документов на сервере.
&НаСервере
Перем мДерево;

// Хранит соответствие документов и признак присутствия в списке на сервере.
&НаСервере
Перем мУжеВСписке;

// Хранит соответствие имени документов и их метаданных на сервере.
&НаСервере
Перем мКэшРеквизитовДокумента;

&НаСервере
Перем мКэшПраваДоступаКМетаданным;


&НаКлиенте
Процедура ЗаказыПокупателейПриАктивизацииСтроки(Элемент)
	Попытка
		ДокументСсылка = Элемент.ТекущиеДанные.ссылка;
	Исключение
		ДокументСсылка = Документы.ЗаказПокупателя.ПустаяСсылка();	
	КонецПопытки;

	
	УстановитьОтборДинамическогоСписка(ДокументСсылка);
	ЗаполнитьТаблицуСоставаЗаказа(ДокументСсылка);
	ВывестиСтруктуруПодчиненности();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСоставаЗаказа(мЗаказПокупателя)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателяТовары.НомерСтроки,
	               |	ЗаказПокупателяТовары.Номенклатура,
	               |	ЗаказПокупателяТовары.Количество,
	               |	ЗаказПокупателяТовары.Цена,
	               |	ЗаказПокупателяТовары.Сумма,
	               |	ЗаказПокупателяТовары.УникальныйИдентификаторСтроки,
	               |	ЗаказПокупателяТовары.Размещение,
	               |	СтатусыЗаказов.Статус КАК СтатусСтроки,
	               |	СтатусОплатыЗаказов.Статус КАК СтатусОплаты
	               |ИЗ
	               |	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаказов КАК СтатусыЗаказов
	               |		ПО ЗаказПокупателяТовары.УникальныйИдентификаторСтроки = СтатусыЗаказов.УникальныйИдентификаторСтроки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусОплатыЗаказов КАК СтатусОплатыЗаказов
	               |		ПО ЗаказПокупателяТовары.УникальныйИдентификаторСтроки = СтатусОплатыЗаказов.УникальныйИдентификаторСтроки
	               |ГДЕ
	               |	ЗаказПокупателяТовары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",мЗаказПокупателя);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТоварыЗаказаПокупателя.Загрузить(РезультатЗапроса);
	
	//Для Каждого стрЗакза из ТоварыЗаказаПокупателя Цикл 
	//	
	//	стрЗакза.СтатусСтроки = ПолучитьСтатусЗаказа(стрЗакза.УникальныйИдентификаторСтроки, стрЗакза.Номенклатура, мЗаказПокупателя);

	//	стрЗакза.СтатусОплаты = ПолучитьСтатусОплаты(стрЗакза.УникальныйИдентификаторСтроки, стрЗакза.Номенклатура, мЗаказПокупателя);
	//	
	//	//Сообщить(Строка(ПолучитьСтатусЗаказа(стрЗакза.УникальныйИдентификаторСтроки, стрЗакза.Номенклатура, мЗаказПокупателя)));
	//	//Сообщить(стрЗакза.СтатусСтроки);
	//	//Сообщить(ТипЗнч(стрЗакза.СтатусСтроки));	
	//	
	//КонецЦикла;
	//
	Элементы.ТоварыЗаказа.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическогоСписка(мЗаказПокупателя)
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателяТовары.НомерСтроки,
	               |	ЗаказПокупателяТовары.Номенклатура,
	               |	ЗаказПокупателяТовары.Количество,
	               |	ЗаказПокупателяТовары.Цена,
	               |	ЗаказПокупателяТовары.Сумма,
	               |	ЗаказПокупателяТовары.УникальныйИдентификаторСтроки
	               |ИЗ
	               |	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |ГДЕ
	               |	ЗаказПокупателяТовары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",мЗаказПокупателя);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ЗаказыПоставщикам.Отбор.Элементы.Очистить();
	
	ЗапросПоЗаказамПоставщику = Новый Запрос;
	ЗапросПоЗаказамПоставщику.Текст = "ВЫБРАТЬ
	|	ЗаказПоставщикуТовары.Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.УникальныйИдентификаторСтроки В(&УникальныйИдентификаторСтроки)
	|	И ЗаказПоставщикуТовары.УникальныйИдентификаторСтроки <> """"";
	ЗапросПоЗаказамПоставщику.УстановитьПараметр("УникальныйИдентификаторСтроки",РезультатЗапроса.ВыгрузитьКолонку("УникальныйИдентификаторСтроки"));
	
	РезультатЗапросаПоЗаказамПоставщику = ЗапросПоЗаказамПоставщику.Выполнить().Выгрузить();
	
	Если РезультатЗапросаПоЗаказамПоставщику.Количество() > 0 Тогда 
		
		ТоварыЗаказаПокупателя.Загрузить(РезультатЗапроса);
		НовЭлементОтбора 			    = ЗаказыПоставщикам.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ссылка"); 
		НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		НовЭлементОтбора.Использование  = Истина;
		НовЭлементОтбора.ПравоеЗначение = РезультатЗапросаПоЗаказамПоставщику.ВыгрузитьКолонку("Ссылка");
	Иначе
		
		НовЭлементОтбора 			    = ЗаказыПоставщикам.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ссылка"); 
		НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		НовЭлементОтбора.Использование  = Истина;
		НовЭлементОтбора.ПравоеЗначение = Документы.ЗаказПоставщику.ПустаяСсылка();
		
	КонецЕсли;
	
	КонецПроцедуры
	
&НаСервере
Функция ПолучитьСтатусЗаказа(УидСтроки, Номенклатура, Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыЗаказов.Номенклатура,
		|	СтатусыЗаказов.УникальныйИдентификаторСтроки КАК УникальныйИдентификаторСтроки,
		|	СтатусыЗаказов.Статус КАК СтатусЗаказа
		|ИЗ
		|	РегистрСведений.СтатусыЗаказов КАК СтатусыЗаказов
		|ГДЕ
		|	СтатусыЗаказов.ЗаказПокупателя = &Ссылка
		|	И СтатусыЗаказов.Номенклатура = &Номенклатура
		|	И СтатусыЗаказов.УникальныйИдентификаторСтроки = &УникальныйИдентификаторСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("УникальныйИдентификаторСтроки", УидСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Возврат ВыборкаДетальныеЗаписи.СтатусЗаказа;
		
	КонецЦикла;

КонецФункции

&НаСервере
Функция ПолучитьСтатусОплаты(УидСтроки, Номенклатура, Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусОплатыЗаказов.Номенклатура,
		|	СтатусОплатыЗаказов.УникальныйИдентификаторСтроки КАК УникальныйИдентификаторСтроки,
		|	СтатусОплатыЗаказов.Статус КАК СтатусОплаты
		|ИЗ
		|	РегистрСведений.СтатусОплатыЗаказов КАК СтатусОплатыЗаказов
		|ГДЕ
		|	СтатусОплатыЗаказов.ЗаказПокупателя = &Ссылка
		|	И СтатусОплатыЗаказов.Номенклатура = &Номенклатура
		|	И СтатусОплатыЗаказов.УникальныйИдентификаторСтроки = &УникальныйИдентификаторСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("УникальныйИдентификаторСтроки", УидСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Возврат ВыборкаДетальныеЗаписи.СтатусОплаты;
		
	КонецЦикла;

КонецФункции

&НаКлиенте
Процедура ЗаказыПоставщикамПриАктивизацииСтроки(Элемент)
	Попытка
		ДокументСсылка = Элемент.ТекущиеДанные.ссылка;
	Исключение
		ДокументСсылка = Документы.ЗаказПокупателя.ПустаяСсылка();	
	КонецПопытки;

	
	ЗаполнитьТаблицуСоставаЗаказаПоставщику(ДокументСсылка);
	
	Если не Элементы.ЗаказыПокупателей.Видимость Тогда 
			ВывестиСтруктуруПодчиненности();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСоставаЗаказаПоставщику(ссылка)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПоставщикуТовары.НомерСтроки,
	               |	ЗаказПоставщикуТовары.Номенклатура,
	               |	ЗаказПоставщикуТовары.Количество,
	               |	ЗаказПоставщикуТовары.Цена,
	               |	ЗаказПоставщикуТовары.Сумма,
	               |	ЗаказПоставщикуТовары.УникальныйИдентификаторСтроки,
	               |	МАКСИМУМ(СтатусыЗаказовПоставщику.Статус) КАК СтатусСтроки,
	               |	МАКСИМУМ(СтатусОплатыЗаказовПоставщику.Статус) КАК СтатусОплаты
	               |ИЗ
	               |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаказовПоставщику КАК СтатусыЗаказовПоставщику
	               |		ПО ЗаказПоставщикуТовары.УникальныйИдентификаторСтроки = СтатусыЗаказовПоставщику.УникальныйИдентификаторСтроки
	               |			И (ЗаказПоставщикуТовары.УникальныйИдентификаторСтроки <> """")
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусОплатыЗаказовПоставщику КАК СтатусОплатыЗаказовПоставщику
	               |		ПО ЗаказПоставщикуТовары.Ссылка = СтатусОплатыЗаказовПоставщику.ЗаказПоставщика
	               |ГДЕ
	               |	ЗаказПоставщикуТовары.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказПоставщикуТовары.Номенклатура,
	               |	ЗаказПоставщикуТовары.УникальныйИдентификаторСтроки,
	               |	ЗаказПоставщикуТовары.Сумма,
	               |	ЗаказПоставщикуТовары.Цена,
	               |	ЗаказПоставщикуТовары.Количество,
	               |	ЗаказПоставщикуТовары.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка",ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	//Для Каждого Строка из РезультатЗапроса Цикл 
	//	
	//	Строка.СтатусСтроки = ПолучитьСтатусЗаказа(Строка.УникальныйИдентификаторСтроки, Строка.Номенклатура, Ссылка);

	//	Строка.СтатусОплаты = ПолучитьСтатусОплаты(Строка.УникальныйИдентификаторСтроки, Строка.Номенклатура, Ссылка);
	//	
	//КонецЦикла;
	
	ТоварыЗаказаПоставщику.Загрузить(РезультатЗапроса);
	
КонецПроцедуры



/////////////////////////////////////////Структура подчинености////////////////////////////////
&НаКлиенте
Процедура ВывестиСтруктуруПодчиненности()
	
	
	Если ДокументСсылка = Неопределено 
		Или ДокументСсылка.Пустая() Тогда
		
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбновлениеДереваДокументов();

	КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьОбновлениеДереваДокументов()
	
	ВывестиДеревоДокументов();
	РазвернутьТаблицуДокументов();
		
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьТаблицуДокументов()

	ЭлементыДерева = ДеревоДокументов.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыДерева Цикл

		Элементы.ДеревоДокументов.Развернуть(Элемент.ПолучитьИдентификатор(), Истина);

	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ВывестиДеревоДокументов()
	
	ДанныеДерева = ДеревоДокументов.ПолучитьЭлементы();
	ДанныеДерева.Очистить();
	
	мДерево = ДанныеДерева;	
	мУжеВСписке.Очистить();
	ВывестиРодительскиеДокументы(ДокументСсылка);
	
	ВывестиПодчиненныеДокументы(мДерево, мКэшПраваДоступаКМетаданным);
	ВывестиПодчинённыеИзТабличныхЧастей(ДокументСсылка);
	
	//ВывестиДокументыОплатыПлатежныхПозиций(ДанныеДерева);
	
КонецПроцедуры // ВывестиДеревоДокументов()

// бит_DKravchenko Процедура устанавливает индекс пиктограммы текущего состояния документа на сервере.
//
// Параметры:
//  ДанныеТекущейСтроки - ДанныеФормыЭлементДерева.
//
&НаСервереБезКонтекста 
Процедура УстановитьИндексПиктограммыСостоянияДокументаСервер(ДанныеТекущейСтроки)
	
	// Установим индекс пиктограммы текущего состояния документа:
	// 0 - Проведен
	// 1 - помечен на удаление
	// 2 - непроведен
	
	Если ДанныеТекущейСтроки.Проведен Тогда
		ДанныеТекущейСтроки.ИндексПиктограммы = 0;
		
	ИначеЕсли ДанныеТекущейСтроки.ПометкаУдаления Тогда
		ДанныеТекущейСтроки.ИндексПиктограммы = 1;
		
	Иначе
		ДанныеТекущейСтроки.ИндексПиктограммы = 2;
	КонецЕсли;
	
КонецПроцедуры



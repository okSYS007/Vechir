&НаКлиенте
Процедура СформироватьКомплектацию(Команда)
	ДокументСсылка = Элементы.ЗаказыПокупателей.ТекущиеДанные.ссылка;

	
	
	Если НЕ МожноСоздатьКомплектацию(ДокументСсылка) Тогда
		Сообщить("Не все позиции есть на складе");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Создать документ комплектации?';uk='Створити документ комплектації?'");
	Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "");
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураПроект = Справочники.Номенклатура.НайтиПоНаименованию(ДокументСсылка.Проект.Наименование, Истина); 
	
	Если ЗначениеЗаполнено(НоменклатураПроект) И НЕ НоменклатураПроект.ЭтоГруппа Тогда
		Сообщить("Не найдена группа " + ДокументСсылка.Проект.Наименование);
		Возврат;
	КонецЕсли;

	
	Для Каждого Элем из ДокументСсылка.ТоварыИКомплектующие.Строки Цикл
		
		ДокОб = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
		ДанныеСтроки = Элем;
		
		ДокОб.Номенклатура 					= СоздатьНоменклатуру(ДанныеСтроки, НоменклатураПроект, Ложь);
		ДокОб.ЕдиницаИзмерения				= ДокОб.Номенклатура.ЕдиницаХраненияОстатков;
		ДокОб.Организация					= ДокументСсылка.Организация;
		ДокОб.Подразделение					= ДокументСсылка.Подразделение;
		ДокОб.Склад							= ДокументСсылка.СкладГруппа;
		ДокОб.ВидОперации					= Перечисления.ВидыОперацийКомплектацияНоменклатуры.Комплектация;
		ДокОб.Заказ							= ДокументСсылка;
		ДокОб.Количество					= ДанныеСтроки.Количество;
		ДокОб.Коэффициент					= ДанныеСтроки.Коэффициент;
		
		Для Каждого стрТовар из Элем.Строки Цикл
			
			НовСтр = ДокОб.Комплектующие.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, стрТовар);
			НовСтр.Номенклатура     = ПолучитьНоменклатуру(стрТовар.Номенклатура, стрТовар.УникальныйИдентификаторСтроки ,ДокументСсылка);
			НовСтр.ЕдиницаИзмерения = НовСтр.Номенклатура.ЕдиницаХраненияОстатков;
			
			НовСтр.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.СоСклада;
			
		КонецЦикла;
		
		ОткрытьЗначение(ДокОб);
		
	КонецЦикла;
	

КонецПроцедуры

&НаСервере
Функция МожноСоздатьКомплектацию(Ссылка) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	0 КАК Поле1
		|ИЗ
		|	РегистрСведений.СтатусыЗаказов КАК СтатусыЗаказов
		|ГДЕ
		|	СтатусыЗаказов.ЗаказПокупателя = &ЗаказПокупателя
		|	И СтатусыЗаказов.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.НаСкладе)";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Пустой();
	
КонецФункции

&НаСервере
Функция СоздатьНоменклатуру(Данные, грПроект, ЭтоКомплектующее)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование = &Наименование
		|	И Номенклатура.Родитель = &грПроект";
	
	Запрос.УстановитьПараметр("Наименование", Данные.Номенклатура);
	Запрос.УстановитьПараметр("грПроект", грПроект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		СпрОБ 							= Справочники.Номенклатура.СоздатьЭлемент();
		СпрОБ.Родитель 					= грПроект.Ссылка;
		СпрОБ.Наименование 				= Данные.Номенклатура;
		СпрОБ.НаименованиеПолное		= СпрОБ.Наименование;
		
		СпрОБ.ВидНоменклатуры			= Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар");
		СпрОБ.БазоваяЕдиницаИзмерения	= Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(Данные.ЕдиницаИзмерения);
		
		СпрОБ.Записать();
		
		НайденнаяЕдиницаОбъект 							= Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		НайденнаяЕдиницаОбъект.Наименование            = СокрЛП(СпрОБ.БазоваяЕдиницаИзмерения);
		НайденнаяЕдиницаОбъект.ЕдиницаПоКлассификатору = СпрОБ.БазоваяЕдиницаИзмерения;
		НайденнаяЕдиницаОбъект.Коэффициент             = 1;
		НайденнаяЕдиницаОбъект.Владелец                = СпрОБ.Ссылка;
		НайденнаяЕдиницаОбъект.Записать();
			
		СпрОБ.ЕдиницаХраненияОстатков 	= НайденнаяЕдиницаОбъект.Ссылка;
		СпрОБ.ЕдиницаИзмеренияМест		= НайденнаяЕдиницаОбъект.Ссылка;
		СпрОБ.Записать();
		
	Иначе
		
		СпрОБ = РезультатЗапроса.Выгрузить()[0].Номенклатура;
		
	КонецЕсли;
	
	Возврат СпрОБ.Ссылка;
	
КонецФункции

&НаСервере
Функция ПолучитьНоменклатуру(Номенклатура, УИДСтроки, Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыЗаказов.НоменклатураПоставщика КАК Номенклатура
		|ИЗ
		|	РегистрСведений.СтатусыЗаказов КАК СтатусыЗаказов
		|ГДЕ
		|	СтатусыЗаказов.ЗаказПокупателя = &ЗаказПокупателя
		|	И СтатусыЗаказов.УникальныйИдентификаторСтроки = &УникальныйИдентификаторСтроки";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", Заказ);
	Запрос.УстановитьПараметр("УникальныйИдентификаторСтроки", УИДСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаДетальныеЗаписи.Следующий();
	Возврат ВыборкаДетальныеЗаписи.Номенклатура;
	
КонецФункции

&НаКлиенте
Процедура ЗаказыПокупателей(Команда)
	Если Элементы.ЗаказыПокупателей.Видимость Тогда 
		
		Элементы.ЗаказыПокупателей.Видимость = Ложь;
		Элементы.ТоварыЗаказа.Видимость      = Ложь;
		ЗаказыПоставщикам.Отбор.Элементы.Очистить();
		
	Иначе
		
		Элементы.ЗаказыПокупателей.Видимость = Истина;
		Элементы.ТоварыЗаказа.Видимость      = Истина;
		
	КонецЕсли;
	Элементы.ФормаЗаказыПокупателей.Пометка = Элементы.ЗаказыПокупателей.Видимость;
	Если Элементы.ФормаМоиЗаказы.Пометка Тогда 
			Если ЗаказыПоставщикам.Отбор.Элементы.Количество() Тогда 
				ЗаказыПоставщикам.Отбор.Элементы.Очистить();
			Иначе
				
				
				
				НовЭлементОтбора 			    =  ЗаказыПоставщикам.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Менеджер"); 
				НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
				НовЭлементОтбора.Использование  = Истина;
				НовЭлементОтбора.ПравоеЗначение = ПараметрыСеанса.ТекущийПользователь;
			КонецЕсли;
			
		КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыПоставщикам(Команда)
	Если Элементы.ЗаказыПоставщикам.Видимость Тогда 
		
		Элементы.ЗаказыПоставщикам.Видимость = Ложь;
		Элементы.ТоварыЗаказаПоставщику.Видимость      = Ложь;
		
	Иначе
		
		Элементы.ЗаказыПоставщикам.Видимость = Истина;
		Элементы.ТоварыЗаказаПоставщику.Видимость      = Истина;

	КонецЕсли;
	Элементы.ФормаЗаказыПоставщиков.Пометка = Элементы.ЗаказыПоставщикам.Видимость;

КонецПроцедуры

&НаКлиенте
Процедура МоиЗаказы(Команда)
	
	
	Если ЗаказыПокупателей.Отбор.Элементы.Количество() Тогда 
		ЗаказыПокупателей.Отбор.Элементы.Очистить();
	Иначе
		
		
		
		НовЭлементОтбора 			    =  ЗаказыПокупателей.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Менеджер"); 
		НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		НовЭлементОтбора.Использование  = Истина;
		НовЭлементОтбора.ПравоеЗначение = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	
	Если ЗаказыПоставщикам.Отбор.Элементы.Количество() Тогда 
		ЗаказыПоставщикам.Отбор.Элементы.Очистить();
	Иначе
		
		
		
		НовЭлементОтбора 			    =  ЗаказыПоставщикам.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Менеджер"); 
		НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		НовЭлементОтбора.Использование  = Истина;
		НовЭлементОтбора.ПравоеЗначение = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;

	
	
	Элементы.ФормаМоиЗаказы.Пометка = ЗаказыПокупателей.Отбор.Элементы.Количество();
	
	Если Элементы.ЗаказыПокупателей.Видимость Тогда 
		ЗаказыПокупателейПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
	ЗаказыПоставщикамПриАктивизацииСтроки(Неопределено);

КонецПроцедуры


&НаКлиенте
Процедура ДеревоДокументовПередНачаломИзменения(Элемент, Отказ)	
	Отказ = Истина;
	ОткрытьДокумент();
	
КонецПроцедуры


&НаКлиенте
Процедура ОткрытьДокумент()
	
	ДанныеТекущейСтроки = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ДанныеТекущейСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ДанныеТекущейСтроки.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаказыПоставщику(Команда)
	Попытка
		
		ДокументСсылка = Элементы.ЗаказыПокупателей.ТекущиеДанные.ссылка;
		ПараметрыЗаказы = новый Структура("ЗаказПокупателя",ДокументСсылка);
		
		Форма = ПолучитьФорму("Обработка.СоздатьЗаказыПоставщику.Форма.Форма",ПараметрыЗаказы);
    	Обработка = Форма.ОбработкаОбъект;
    	Обработка.СсылкаНаОбъект = ДокументСсылка;
		Форма.Открыть();
		
	Исключение
		ДокументСсылка = Документы.ЗаказПокупателя.ПустаяСсылка();	
	КонецПопытки;

	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаРасходованиеДС(Команда)
	Попытка
		ДокументСсылка = Элементы.ЗаказыПоставщикам.ТекущиеДанные.ссылка;		
	Исключение		
		ДокументСсылка = Документы.ЗаказПоставщику.ПустаяСсылка();		
	КонецПопытки;
	
	
	ДО = Документы.ЗаявкаНаРасходованиеСредств.СоздатьДокумент();
	ДО.Заполнить(ДокументСсылка);
	ДО.ПолучитьФорму().Открыть();	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаявкуНаРасходованиеДСНаСервере(Ссылка)

	ДокументЗаявка = Документы.ЗаявкаНаРасходованиеСредств.СоздатьДокумент();
	ДокументЗаявка.Заполнить(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	Элементы.ЗаказыПокупателей.Обновить();
	Элементы.ЗаказыПоставщикам.Обновить();
	
	Если не Элементы.ЗаказыПокупателей.Видимость Тогда 
		Попытка
			ДокументСсылка = Элементы.ЗаказыПоставщикам.ТекущиеДанные.ссылка;
		Исключение
			ДокументСсылка = Документы.ЗаказПоставщику.ПустаяСсылка();	
		КонецПопытки;
		
		
		ЗаполнитьТаблицуСоставаЗаказаПоставщику(ДокументСсылка);
		
		Если не Элементы.ЗаказыПокупателей.Видимость Тогда 
			ВывестиСтруктуруПодчиненности();		
		КонецЕсли;
		
	Иначе
		Попытка
			ДокументСсылка = Элементы.ЗаказыПокупателей.ТекущиеДанные.ссылка;
		Исключение
			ДокументСсылка = Документы.ЗаказПокупателя.ПустаяСсылка();	
		КонецПопытки;
		
		
		УстановитьОтборДинамическогоСписка(ДокументСсылка);
		ЗаполнитьТаблицуСоставаЗаказа(ДокументСсылка);
		ВывестиСтруктуруПодчиненности();
	КонецЕсли;
	//ВыполнитьОбновлениеДереваДокументов();
	
	
		

КонецПроцедуры



мУжеВСписке 				= Новый Соответствие;
мКэшРеквизитовДокумента 	= Новый Соответствие;
мКэшПраваДоступаКМетаданным	= Новый Соответствие;

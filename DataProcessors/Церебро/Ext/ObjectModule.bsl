Процедура ЗаполнитьНаименованиеУкр() Экспорт
	
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	стрОтбор = Новый Структура;
	стрОтбор.Вставить("Отметка", Ложь);
	тзДанные = Товары.НайтиСтроки(стрОтбор); 
	
	Для Каждого стрТовар из тзДанные Цикл
		
		Таймаут();
		
		Если ЗначениеЗаполнено(стрТовар.productID) Тогда
			HTTPЗапрос = Новый HTTPЗапрос("/product/" + стрТовар.productID + "/" + ИдентификаторСессии + "?lang=ua", Заголовки);
			Ответ 	= Соединение.Получить(HTTPЗапрос);	
			мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
			Если Ответ.КодСостояния = 200 Тогда
				
				ЗначениеУзла = "";
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(мОтвет); //сделал именно так, т.к. возвращают не читаемую структуру json. например stocks: [253].
				
				Попытка
					СтрJSON = ПрочитатьJSON(ЧтениеJSON);
					Если СтрJSON.Свойство("error_message")
						И СтрJSON.error_message = "Session identifier is fault" Тогда
						Залогиниться();
						ЗаполнитьНаименованиеУкр();
					КонецЕсли;
				Исключение КонецПопытки;
				
				
				Пока ЧтениеJSON.Прочитать() Цикл
					
					ТипЗначения = ЧтениеJSON.ТипТекущегоЗначения;
					
					Если ТипЗначения = ТипЗначенияJSON.НачалоОбъекта Тогда						
					ИначеЕсли ТипЗначения = ТипЗначенияJSON.НачалоМассива Тогда
					ИначеЕсли ТипЗначения = ТипЗначенияJSON.ИмяСвойства
						ИЛИ ТипЗначения = ТипЗначенияJSON.Строка
						ИЛИ ТипЗначения = ТипЗначенияJSON.Число
						ИЛИ ТипЗначения = ТипЗначенияJSON.Булево
						ИЛИ ТипЗначения = ТипЗначенияJSON.Null Тогда
						
						Значение = ЧтениеJSON.ТекущееЗначение;
						
						Если ЗначениеУзла = "name" Тогда
							стрТовар.name_ua = Значение;
							Прервать;
						КонецЕсли;
						
						ЗначениеУзла = ЧтениеJSON.ТекущееЗначение;
						
					КонецЕсли;			
					
				КонецЦикла;
				
				Если НЕ ЗначениеЗаполнено(стрТовар.name_ua) И ТипЗнч(СтрJSON) = Тип("Структура") 
					И СтрJSON.Свойство("result") И ТипЗнч(СтрJSON.result) = Тип("Структура") Тогда
					стрТовар.name_ua = СтрJSON.result.name;			
				КонецЕсли;
				
				ЧтениеJSON.Закрыть();
				
				стрТовар.Отметка = Истина;
				
			Иначе
				
				Если ЗначениеЗаполнено(стрТовар.articul) Тогда
					HTTPЗапрос = Новый HTTPЗапрос("/product/articul/" + стрТовар.articul + "/" + ИдентификаторСессии + "?lang=ua", Заголовки);
					Ответ 	= Соединение.Получить(HTTPЗапрос);	
					мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
					Если Ответ.КодСостояния = 200 Тогда
						
						ЗначениеУзла = "";
						
						ЧтениеJSON = Новый ЧтениеJSON;
						ЧтениеJSON.УстановитьСтроку(мОтвет); //сделал именно так, т.к. возвращают не читаемую структуру json. например stocks: [253].
						
						Попытка
							СтрJSON = ПрочитатьJSON(ЧтениеJSON);
							Если СтрJSON.Свойство("error_message")
								И СтрJSON.error_message = "Session identifier is fault" Тогда
								Залогиниться();
								ЗаполнитьНаименованиеУкр();
							КонецЕсли;
						Исключение КонецПопытки;
						
						
						Пока ЧтениеJSON.Прочитать() Цикл
							
							ТипЗначения = ЧтениеJSON.ТипТекущегоЗначения;
							
							Если ТипЗначения = ТипЗначенияJSON.НачалоОбъекта Тогда						
							ИначеЕсли ТипЗначения = ТипЗначенияJSON.НачалоМассива Тогда
							ИначеЕсли ТипЗначения = ТипЗначенияJSON.ИмяСвойства
								ИЛИ ТипЗначения = ТипЗначенияJSON.Строка
								ИЛИ ТипЗначения = ТипЗначенияJSON.Число
								ИЛИ ТипЗначения = ТипЗначенияJSON.Булево
								ИЛИ ТипЗначения = ТипЗначенияJSON.Null Тогда
								
								Значение = ЧтениеJSON.ТекущееЗначение;
								
								Если ЗначениеУзла = "name" Тогда
									стрТовар.name_ua = Значение;
									Прервать;
								КонецЕсли;
								
								ЗначениеУзла = ЧтениеJSON.ТекущееЗначение;
								
							КонецЕсли;			
							
						КонецЦикла;
						
						Если НЕ ЗначениеЗаполнено(стрТовар.name_ua) И ТипЗнч(СтрJSON) = Тип("Структура") 
							И СтрJSON.Свойство("result") И ТипЗнч(СтрJSON.result) = Тип("Структура") Тогда
							стрТовар.name_ua = СтрJSON.result.name;			
						КонецЕсли;
						
						ЧтениеJSON.Закрыть();
						
						стрТовар.Отметка = Истина;
					Иначе
						
						Сообщить(Ответ.КодСостояния);
						ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
						
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьВсеИзображенияПоНоменклатуре() Экспорт
	
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	Для Каждого стрТовар из Товары Цикл
		
		Таймаут();
		
		Если ЗначениеЗаполнено(стрТовар.productID) Тогда
			HTTPЗапрос = Новый HTTPЗапрос("/product_pictures/" + стрТовар.productID + "/" + ИдентификаторСессии + "?lang=ua", Заголовки);
			Ответ 	= Соединение.Получить(HTTPЗапрос);	
			мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
			Если Ответ.КодСостояния = 200 Тогда
				
				ЗначениеУзла = "";
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(мОтвет); //сделал именно так, т.к. возвращают не читаемую структуру json. например stocks: [253].
				
				Попытка 
					СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);					
				Исключение
					Сообщить("Не удалось прочитать JSON " + мОтвет);
					Возврат;
				КонецПопытки;
				ЧтениеJSON.Закрыть();
				
			Иначе
				Сообщить(Ответ.КодСостояния);
				ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
			КонецЕсли;
			
			Если СтруктураJSON.Свойство("status") Тогда
				
				Если СтруктураJSON.status = 0 Тогда
					ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, СтруктураJSON.error_message);	
					Возврат;
				КонецЕсли;
				
				Если СтруктураJSON.Свойство("result") Тогда
					
					Номенклаутра = НайтиНоменклатуруПоАртикулу(стрТовар.articul);
					
					Для Каждого стрДанные из СтруктураJSON.result Цикл
						
						Таймаут();
						
						НаименованиеИзображения = СтрЗаменить(стрДанные.full_image, "https://source.dclink.com.ua/images/", "");
						
						HTTPСоединение = Новый HTTPСоединение("source.dclink.com.ua",,,,,,Новый ЗащищенноеСоединениеOpenSSL);
						HTTPЗапрос = Новый HTTPЗапрос("images/"+ НаименованиеИзображения); 
						HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
						
						НайденноеИзображение = НайтиИзображениеПоНаименованию(Номенклаутра, НаименованиеИзображения);
						
						Если НЕ ЗначениеЗаполнено(НайденноеИзображение) Тогда
							НовыйОбъект = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
						Иначе
							НовыйОбъект = НайденноеИзображение.ПолучитьОбъект();
						КонецЕсли;
						
						Если HTTPОтвет.КодСостояния = 200 Тогда
							ДвоичныеДанныеКартинки = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
							ВыбранноеИзображение = Новый Картинка(ДвоичныеДанныеКартинки);
							
							НовыйОбъект.ВидДанных 		= Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение;
							НовыйОбъект.Хранилище 		= Новый ХранилищеЗначения(ВыбранноеИзображение, Новый СжатиеДанных);
							НовыйОбъект.Объект 			= Номенклаутра;
							НовыйОбъект.ИмяФайла		= стрТовар.full_image;
							НовыйОбъект.Наименование	= НаименованиеИзображения;
							НовыйОбъект.Записать();
							
						Иначе
							ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось получить изображение " + стрТовар.articul);	
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура Таймаут()
	
	//таймаут	
	ДатаКон = ТекущаяДата() + 1;//пауза 2 сек
	Пока ТекущаяДата() < ДатаКон Цикл КонецЦикла;	
	

Процедура ЗаполнитьДопСвойства() Экспорт
	
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	стрОтбор = Новый Структура;
	стрОтбор.Вставить("Отметка", Ложь);
	тзДанные = Товары.НайтиСтроки(стрОтбор); 
	
	Для Каждого стрТовар из тзДанные Цикл
		
		Таймаут();
		
		Если ЗначениеЗаполнено(стрТовар.productID) Тогда
			HTTPЗапрос = Новый HTTPЗапрос("/product_options/" + стрТовар.productID + "/" + ИдентификаторСессии + "?lang=ua", Заголовки);
			Ответ 	= Соединение.Получить(HTTPЗапрос);	
			мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
			Если Ответ.КодСостояния = 200 Тогда
				
				ЧтениеJSONДопСвойства = Новый ЧтениеJSON;
				ЧтениеJSONДопСвойства.УстановитьСтроку(мОтвет);
				
				Попытка
					СтрJSON = ПрочитатьJSON(ЧтениеJSONДопСвойства);
					Если СтрJSON.Свойство("error_message")
						И СтрJSON.error_message = "Session identifier is fault" Тогда
						Залогиниться();
						ЗаполнитьДопСвойства();
					КонецЕсли;
				Исключение КонецПопытки;
				
				Попытка
					Если ТипЗнч(СтрJSON) = Тип("Структура")
						И СтрJSON.Свойство("result") Тогда
					Иначе
						СтрJson = ПрочитатьJSON(ЧтениеJSONДопСвойства);
					КонецЕсли;
					стрТовар.ДопСвойстваJSON = ЗначениеВСтрокуВнутр(СтрJson.result);
					стрТовар.Отметка = Истина;
				Исключение
					ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, "не удалось прочитать доп свойства. product id " + стрТовар.productID);
				КонецПопытки;
				
				ЧтениеJSONДопСвойства.Закрыть();
				
			Иначе
				Сообщить(Ответ.КодСостояния);
				ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


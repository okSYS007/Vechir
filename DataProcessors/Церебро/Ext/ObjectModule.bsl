	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(мОтвет);
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
		Возврат;
	КонецПопытки;
	ЧтениеJSON.Закрыть();
	
	Если Ответ.КодСостояния = 200 Тогда
	Иначе
		ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКатегории() Экспорт
	
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	HTTPЗапрос = Новый HTTPЗапрос("/categories/" + ИдентификаторСессии, Заголовки);
	
	Ответ 	= Соединение.Получить(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку();	
	
	Если Ответ.КодСостояния = 200 Тогда
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(мОтвет);
		
		Попытка
			СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);;
		Исключение
			ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось прочитать JSON");	
			Возврат;
		КонецПопытки;
		
		Если СтруктураJSON.Свойство("status") Тогда
			
			Если СтруктураJSON.status = 0 Тогда
				ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, СтруктураJSON.error_message);	
				Возврат;
			КонецЕсли;
			
			Если СтруктураJSON.Свойство("result") Тогда
				
				Для Каждого стрДанные из СтруктураJSON.result Цикл
					
					НовСтр 				= Категории.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр, стрДанные);
					НовСтр.categoryID 	= СтрЗаменить(стрДанные.categoryID, Символы.НПП, "");
					НовСтр.parentID		= СтрЗаменить(стрДанные.parentID, Символы.НПП, "");
					
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьКатегорииВБазу() Экспорт
	
	Для Каждого стрДанные из Категории Цикл
		
		id = СтрЗаменить(стрДанные.categoryID, Символы.НПП, "");
		НайденнаяКатегория = НайтиКатегориюПоID(стрДанные.name, id);
		
		Если НЕ ЗначениеЗаполнено(НайденнаяКатегория) Тогда
			СоздатьГруппы(стрДанные.name, стрДанные.categoryID);
		КонецЕсли;
		
	КонецЦикла;
	
	ПроставитьРодителей();
	
КонецПроцедуры

Процедура ЗаполнитьПроизводителей() Экспорт
	
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	тзКатегории = ПолучитьВсеКатегории();
	
	Для каждого Категория из тзКатегории Цикл
		
		//таймаут	
		Таймаут();
		
		HTTPЗапрос = Новый HTTPЗапрос("/vendors/" +Категория.ID +"/" + ИдентификаторСессии, Заголовки);
		
		Ответ 	= Соединение.Получить(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();	
		
		Если Ответ.КодСостояния = 200 Тогда
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(мОтвет);
			
			Попытка
				СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);;
			Исключение
				ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось прочитать JSON");	
				Продолжить;
			КонецПопытки;
			
			Если СтруктураJSON.Свойство("status") Тогда
				
				Если СтруктураJSON.status = 0 Тогда
					ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, СтруктураJSON.error_message);	
					Продолжить;
				КонецЕсли;
				
				Если СтруктураJSON.Свойство("result") Тогда
					
					Для Каждого стрДанные из СтруктураJSON.result Цикл
						
						НовСтр 				= Производители.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, стрДанные);
						НовСтр.vendorID 		= СтрЗаменить(стрДанные.vendorID, Символы.НПП, "");
						НовСтр.КатегорияCerebro = Категория.Ссылка;
						
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,,мОтвет);	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьПроизводителейВБазу() Экспорт
	Для Каждого стрПроизводитель из Производители Цикл
		НайденныйПроизводитель = НайтиПроизводителяПоID(стрПроизводитель.name, стрПроизводитель.vendorID);
		Если НЕ ЗначениеЗаполнено(НайденныйПроизводитель) Тогда
			СоздатьПроизводителя(стрПроизводитель.КатегорияCerebro, стрПроизводитель.name, стрПроизводитель.vendorID);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьТовары() Экспорт
	
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	тзКатегории = ПолучитьВсеКатегории();
	
	Для Каждого Категория из тзКатегории Цикл
		
		Таймаут();
		
		HTTPЗапрос = Новый HTTPЗапрос("/products/" + Категория.ID + "/" + ИдентификаторСессии, Заголовки);
		
		Ответ 	= Соединение.Получить(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
			Продолжить;
		КонецЕсли;
		
		ЗначениеУзла = "";
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(мОтвет); //сделал именно так, т.к. возвращают не читаемую структуру json. например stocks: [253].
		
		Пока ЧтениеJSON.Прочитать() Цикл
			
			ТипЗначения = ЧтениеJSON.ТипТекущегоЗначения;
			
			Если ТипЗначения = ТипЗначенияJSON.НачалоОбъекта Тогда
				
				Если ЗначениеЗаполнено(ЗначениеУзла)  //возвращает не правильный json. тут должен быть массив, а возвращает как новый объект { }
					И ЗначениеУзла <> "available" 
					И ЗначениеУзла <> "result" 
					И ЗначениеУзла <> "stocks_expected" 
					Тогда
					НовСтр = Товары.Добавить();
				КонецЕсли;
				
			ИначеЕсли ТипЗначения = ТипЗначенияJSON.НачалоМассива Тогда
			ИначеЕсли ТипЗначения = ТипЗначенияJSON.ИмяСвойства
				ИЛИ ТипЗначения = ТипЗначенияJSON.Строка
				ИЛИ ТипЗначения = ТипЗначенияJSON.Число
				ИЛИ ТипЗначения = ТипЗначенияJSON.Булево
				ИЛИ ТипЗначения = ТипЗначенияJSON.Null Тогда
				
				Значение = ЧтениеJSON.ТекущееЗначение;
				
				Если ЗначениеУзла = "name" Тогда
					НовСтр.name_ru = Значение;
				ИначеЕсли ЗначениеУзла = "brief_description" Тогда
					НовСтр.brief_description = Значение;
				ИначеЕсли ЗначениеУзла = "description" Тогда
					НовСтр.description = Значение;
				ИначеЕсли ЗначениеУзла = "country" Тогда
					НовСтр.country = Значение;
				ИначеЕсли ЗначениеУзла = "product_code" Тогда
					НовСтр.product_code = Значение;
				ИначеЕсли ЗначениеУзла = "date_added" Тогда
					НовСтр.date_added = Значение;
				ИначеЕсли ЗначениеУзла = "date_last_change" Тогда
					НовСтр.date_last_change = Значение;
				ИначеЕсли ЗначениеУзла = "date_last_price_change" Тогда
					НовСтр.date_last_price_change = Значение;
				ИначеЕсли ЗначениеУзла = "date_last_change_description" Тогда
					НовСтр.date_last_change_description = Значение;
				ИначеЕсли ЗначениеУзла = "warranty" Тогда
					НовСтр.warranty = Значение;
				ИначеЕсли ЗначениеУзла = "is_archive" Тогда
					НовСтр.is_archive = Значение;
				ИначеЕсли ЗначениеУзла = "is_exclusive" Тогда
					НовСтр.is_exclusive = Значение;
				ИначеЕсли ЗначениеУзла = "productID" Тогда
					НовСтр.productID = СтрЗаменить(Значение, Символы.НПП, "");
				ИначеЕсли ЗначениеУзла = "vendorID" Тогда
					НовСтр.vendorID = СтрЗаменить(Значение, Символы.НПП, "");
				ИначеЕсли ЗначениеУзла = "articul" Тогда
					НовСтр.articul = Значение;
				ИначеЕсли ЗначениеУзла = "categoryID" Тогда
					НовСтр.categoryID = СтрЗаменить(Значение, Символы.НПП, "");
				ИначеЕсли ЗначениеУзла = "small_image" Тогда
					НовСтр.small_image = СтрЗаменить(Значение, "https://source.dclink.com.ua/images/", "");
				ИначеЕсли ЗначениеУзла = "medium_image" Тогда
					НовСтр.medium_image = СтрЗаменить(Значение, "https://source.dclink.com.ua/images/", "");
				ИначеЕсли ЗначениеУзла = "large_image" Тогда
					НовСтр.large_image = СтрЗаменить(Значение, "https://source.dclink.com.ua/images/", "");
				ИначеЕсли ЗначениеУзла = "full_image" Тогда
					НовСтр.full_image = СтрЗаменить(Значение, "https://source.dclink.com.ua/images/", "");
				ИначеЕсли ЗначениеУзла = "price" Тогда
					НовСтр.price = Значение;
				ИначеЕсли ЗначениеУзла = "price_uah" Тогда
					НовСтр.price_uah = Значение;
				ИначеЕсли ЗначениеУзла = "recommendable_price" Тогда
					НовСтр.recommendable_price = Значение;
				ИначеЕсли ЗначениеУзла = "retail_price_uah" Тогда
					НовСтр.retail_price_uah = Значение;
				КонецЕсли;
				
				ЗначениеУзла = ЧтениеJSON.ТекущееЗначение;
				
			КонецЕсли;			
			
		КонецЦикла;
		
		ЧтениеJSON.Закрыть();
		
		ЗаполнитьНаименованиеУкр();
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьТоварыИзБазы1с() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Наименование,
	|	Номенклатура.IDCerebro,
	|	Номенклатура.АртикулПоставщика
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.Родитель = &РодительЦеребро";
	
	Запрос.УстановитьПараметр("РодительЦеребро", Справочники.Номенклатура.НайтиПоНаименованию("Cerebro", Истина));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НовСтр 				= Товары.Добавить();
		НовСтр.articul 		= ВыборкаДетальныеЗаписи.АртикулПоставщика;
		НовСтр.productID 	= ВыборкаДетальныеЗаписи.IDCerebro;
		НовСтр.name_ua		= ВыборкаДетальныеЗаписи.Наименование;
		
	КонецЦикла;
	
КонецПроцедуры


Функция ПолучитьНоменеклатуруДляУстановкиЦены(ТЗНоменклатураИЦены, ТипЦен)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураИЦена.Номенклатура,
	|	НоменклатураИЦена.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&ТЗНоменклатураИЦены КАК НоменклатураИЦена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	УстановкаЦенНоменклатурыТовары.Ссылка,
	|	УстановкаЦенНоменклатурыТовары.Номенклатура,
	|	УстановкаЦенНоменклатурыТовары.Цена
	|ПОМЕСТИТЬ ВТ_УстановкаЦен
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры.Товары КАК УстановкаЦенНоменклатурыТовары
	|ГДЕ
	|	НЕ УстановкаЦенНоменклатурыТовары.Ссылка.ПометкаУдаления
	|	И УстановкаЦенНоменклатурыТовары.Ссылка.Проведен
	|	И УстановкаЦенНоменклатурыТовары.ТипЦен = &ТипЦен
	|	И УстановкаЦенНоменклатурыТовары.Номенклатура В
	|			(ВЫБРАТЬ
	|				ВТ_Данные.Номенклатура
	|			ИЗ
	|				ВТ_Данные КАК ВТ_Данные)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УстановкаЦенНоменклатурыТовары.Ссылка.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Номенклатура,
	|	ВТ_Данные.Цена,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.Цена <> ЕСТЬNULL(ВТ_УстановкаЦен.Цена, 0)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПризнакОтбора
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УстановкаЦен КАК ВТ_УстановкаЦен
	|		ПО ВТ_Данные.Номенклатура = ВТ_УстановкаЦен.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итог.Номенклатура,
	|	ВТ_Итог.Цена
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог
	|ГДЕ
	|	ВТ_Итог.ПризнакОтбора";
	
	Запрос.УстановитьПараметр("ТЗНоменклатураИЦены", ТЗНоменклатураИЦены);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура СоздатьГруппы(Name, Id)
	
	НовКатегория 				= Справочники.КатегорииCerebro.СоздатьЭлемент();
	НовКатегория.ID 			= Id;
	НовКатегория.Наименование 	= Name;
	НовКатегория.Записать();
	
КонецПроцедуры

Процедура СоздатьПроизводителя(КатегорияCerebro, Name, Id)
	
	НовКатегория 					= Справочники.ПроизводителиCerebro.СоздатьЭлемент();
	НовКатегория.ID 				= Id;
	НовКатегория.Наименование 		= Name;
	НовКатегория.КатегорияCerebro 	= КатегорияCerebro;
	НовКатегория.Записать();
	
КонецПроцедуры

Процедура ПроставитьРодителей()
	
	Для Каждого стрДанные из Категории Цикл
		
		Если стрДанные.parentID = "0" Тогда
			Продолжить;
		КонецЕсли;
		
		категорияОб = НайтиКатегориюПоID(стрДанные.name, стрДанные.categoryID).ПолучитьОбъект();			
		
		стрПоиска = Новый Структура;
		стрПоиска.Вставить("categoryID", стрДанные.categoryID);
		
		НайденныеСтроки = Категории.НайтиСтроки(стрПоиска);
		
		
		категорияОб.Родитель = НайтиКатегориюПоID(,НайденныеСтроки[0].parentID);
		
		Если НЕ ЗначениеЗаполнено(категорияОб.Родитель) Тогда
			Сообщить("не найдена категория " + НайденныеСтроки[0].parentID);
			Продолжить;
		КонецЕсли;
		
		категорияОб.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьВсеКатегории()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КатегорииCerebro.ID,
	|	КатегорииCerebro.Ссылка
	|ИЗ
	|	Справочник.КатегорииCerebro КАК КатегорииCerebro
	|ГДЕ
	|	КатегорииCerebro.ID <> ""0""
	|	И НЕ КатегорииCerebro.ПометкаУдаления";
	//|	И КатегорииCerebro.Ссылка = &Ссылка";
	//|	И КатегорииCerebro.Родитель = ЗНАЧЕНИЕ(Справочник.КатегорииCerebro.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", Справочники.КатегорииCerebro.НайтиПоНаименованию("Аудио", Истина));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


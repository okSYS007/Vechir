КонецПроцедуры

&НаСервере
Процедура СоздатьЦепочкуДокументовПеремещенияОС(ДокПеремещения)
	
	НачатьТранзакцию();
	//Распроведем док перемещения			
	ДокПеремещенияОб = ДокПеремещения.ПолучитьОбъект();
	Попытка
		ДокПеремещенияОб.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		Сообщить(ОписаниеОшибки());	
		ОтменитьТранзакцию();
	КонецПопытки;
	
	СкладПолучатель 	= ДокПеремещения.СкладПолучатель;
	СкладОтправитель 	= ДокПеремещения.СкладОтправитель;
	
	//Создаем вместо перемещения - документ ОС
	ДокПеремещениеОС = Документы.ПеремещениеОС.СоздатьДокумент();
	
	ДокПеремещениеОС.Дата 			= ТекущаяДата();
	ДокПеремещениеОС.Организация 	= ДокПеремещения.Организация;
	ДокПеремещениеОС.Ответственный  = ПараметрыСеанса.ТекущийПользователь;
	ДокПеремещениеОС.Подразделение 	= СкладПолучатель.Подразделение;
	ДокПеремещениеОС.МОЛОрганизации = ПолучитьОтветственноеЛицо(ДокПеремещения.Организация);
	ДокПеремещениеОС.СобытиеОС		= Справочники.СобытияОС.НайтиПоНаименованию("Внутреннее перемещение", Истина);
	ДокПеремещениеОС.Сдал			= ПолучитьОтветственноеЛицо(СкладОтправитель);
	ДокПеремещениеОС.Принял			= ПолучитьОтветственноеЛицо(СкладПолучатель);;
	
	ДокПеремещениеОС.ОтражатьВБухгалтерскомУчете 	= Истина;
	ДокПеремещениеОС.ОтражатьВУправленческомУчете 	= Истина;
	ДокПеремещениеОС.ДокументПеремещения			= ДокПеремещения;
	
	ДокПеремещениеОС.ОС.Загрузить(ПолучитьОС(ДокПеремещения.Товары.Выгрузить(,"Номенклатура")));
	
	Попытка
		ДокПеремещениеОС.Записать(РежимЗаписиДокумента.Запись);
		Сообщить(ОписаниеОшибки());
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();	
	КонецПопытки;
	
	Элементы.ДокументыПеремещенияОС.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЦепочкуДокументовПередачаОСНаСервере(ДокПеремещения)
	
	НачатьТранзакцию();
	//Распроведем док перемещения			
	ДокПеремещенияОб = ДокПеремещения.ПолучитьОбъект();
	Попытка
		ДокПеремещенияОб.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		Сообщить(ОписаниеОшибки());	
		ОтменитьТранзакцию();
	КонецПопытки;
	
	СкладПолучатель 	= ДокПеремещения.СкладПолучатель;
	СкладОтправитель 	= ДокПеремещения.СкладОтправитель;
	
	//Создаем вместо перемещения - документ ОС
	ДокПеремещениеОС = Документы.ПередачаМалоценкиВЭксплуатацию.СоздатьДокумент();
	
	ДокПеремещениеОС.Дата 			= ТекущаяДата();
	ДокПеремещениеОС.Организация 	= ДокПеремещения.Организация;
	ДокПеремещениеОС.Ответственный  = ПараметрыСеанса.ТекущийПользователь;
	ДокПеремещениеОС.Подразделение 	= СкладПолучатель.Подразделение;
	//ДокПеремещениеОС.МОЛОрганизации = ПолучитьОтветственноеЛицо(ДокПеремещения.Организация);
	//ДокПеремещениеОС.СобытиеОС		= Справочники.СобытияОС.НайтиПоНаименованию("Внутреннее перемещение", Истина);
	//ДокПеремещениеОС.Сдал			= ПолучитьОтветственноеЛицо(СкладОтправитель);
	//ДокПеремещениеОС.Принял			= ПолучитьОтветственноеЛицо(СкладПолучатель);;
	
	ДокПеремещениеОС.ОтражатьВБухгалтерскомУчете 	= Истина;
	ДокПеремещениеОС.ОтражатьВУправленческомУчете 	= Истина;
	ДокПеремещениеОС.ДокументПеремещения			= ДокПеремещения;
	
	ДокПеремещениеОС.МалоценныеАктивы.Загрузить(ПолучитьМалоценку(ДокПеремещения.Товары.Выгрузить(,"Номенклатура")));
	
	Сообщить("ок");
	Попытка
		ДокПеремещениеОС.Записать(РежимЗаписиДокумента.Запись);
		Сообщить(ОписаниеОшибки());
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();	
		Сообщить("Ошибка");
	КонецПопытки;
	
	Элементы.ДокументыПередачаМалоценки.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическогоСписка(ссылка)
	
	ВсеПеремещения = ПолучитьВсеПеремещенияПоПриходному(ссылка);

	ДокументыПеремещенияОС.Отбор.Элементы.Очистить();	
	
	НовЭлементОтбора 			    = ДокументыПеремещенияОС.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДокументПеремещения"); 
	НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	НовЭлементОтбора.Использование  = Истина;
	НовЭлементОтбора.ПравоеЗначение = ?(ВсеПеремещения.Количество() > 0, ВсеПеремещения, Неопределено);
	
	ДокументыПередачаМалоценки.Отбор.Элементы.Очистить();
	
	НовЭлементОтбора 			    = ДокументыПередачаМалоценки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДокументПеремещения"); 
	НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	НовЭлементОтбора.Использование  = Истина;
	НовЭлементОтбора.ПравоеЗначение = ?(ВсеПеремещения.Количество() > 0, ВсеПеремещения, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическогоСпискаПоступления(ссылка)
	
	ДокВводОС.Отбор.Элементы.Очистить();	
	
	НовЭлементОтбора 			    = ДокВводОС.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДокументПоступления"); 
	НовЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	НовЭлементОтбора.Использование  = Истина;
	НовЭлементОтбора.ПравоеЗначение = ссылка;
	
КонецПроцедуры

Функция ПолучитьОС(Номенклатура) 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВводВЭксплуатациюОСОС.ОсновноеСредство КАК ОсновноеСредство
		|ИЗ
		|	Документ.ВводВЭксплуатациюОС.ОС КАК ВводВЭксплуатациюОСОС
		|ГДЕ
		|	ВводВЭксплуатациюОСОС.Ссылка.Проведен
		|	И НЕ ВводВЭксплуатациюОСОС.Ссылка.ПометкаУдаления
		|	И ВводВЭксплуатациюОСОС.Ссылка.Номенклатура В(&Номенклатура)";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьМалоценку(Номенклатура) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВводВЭксплуатациюОСОС.ОсновноеСредство КАК Номенклатура
		|ИЗ
		|	Документ.ВводВЭксплуатациюОС.ОС КАК ВводВЭксплуатациюОСОС
		|ГДЕ
		|	ВводВЭксплуатациюОСОС.Ссылка.Проведен
		|	И НЕ ВводВЭксплуатациюОСОС.Ссылка.ПометкаУдаления
		|	И ВводВЭксплуатациюОСОС.Ссылка.Номенклатура В(&Номенклатура)";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьВсеПеремещенияПоПриходному(Приходный)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеТоваров.Ссылка КАК ДокументПеремещения
		|ИЗ
		|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
		|ГДЕ
		|	НЕ ПеремещениеТоваров.ПометкаУдаления
		|	И ПеремещениеТоваров.ДокументОснование.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Приходный);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОтветственноеЛицо(Склад)
	
	Отбор = Новый Структура("СтруктурнаяЕдиница");
	Отбор.СтруктурнаяЕдиница = Склад;
	СрезПоследних = РегистрыСведений.ОтветственныеЛица.СрезПоследних(ТекущаяДата(), Отбор);

	Если СрезПоследних.Количество() < 1 Тогда
		Возврат Неопределено;
	Иначе
		Возврат СрезПоследних[0].ФизическоеЛицо;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЗаполнитьДокументНаСервере();

	ТекПоступление = Элементы.ДокументыПоступления.ТекущаяСтрока;
	
	ДокВводОСОБ = Документы.ВводВЭксплуатациюОС.СоздатьДокумент();
	ДокВводОСОБ.Заполнить(ТекПоступление);
	ДокВводОСОБ.Дата = ТекущаяДата();
	
	ДокВводОСОБ.Записать();
	
	Возврат ДокВводОСОБ.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура СоздатьВводОС(Команда)
	
	ДокВвод = ЗаполнитьДокументНаСервере();
	
	ПарамОткрытия = Новый Структура("Ключ", ДокВвод);
	Форм = ПолучитьФорму("Документ.ВводВЭксплуатациюОС.ФормаОбъекта", ПарамОткрытия);
	Форм.Открыть();
	
	Элементы.ДокВводОС.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовПриАктивизацииСтроки(Элемент)
	
	ДанныеТекущейСтроки = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ДанныеТекущейСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТоварыНаСервере(ДанныеТекущейСтроки.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыНаСервере(Док)
	
	тчТовары.Загрузить(Док.Товары.Выгрузить());
	

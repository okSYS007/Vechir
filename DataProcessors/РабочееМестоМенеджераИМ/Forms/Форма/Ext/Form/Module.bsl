КонецПроцедуры

&НаСервере
Процедура ОбновитьСвойства(ТекущаяНоменклатура)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Объект,
	|	ЗначенияСвойствОбъектов.Свойство,
	|	ЗначенияСвойствОбъектов.Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект",ТекущаяНоменклатура);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Свойства.Загрузить(РезультатЗапроса);
КонецПроцедуры

&НаКлиенте
Процедура КартинкаТовараПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// + 003676 ДДГ 10 ноя 2020
	Если МассивСобственныхКартинокСсылки.Количество() < 1 Тогда
		Возврат;
	КонецЕсли;
	// - 003676 ДДГ 10 ноя 2020
	
	КартинкаБольшаяСобсвеннаяВрем = МассивСобственныхКартинокСсылки[0].Значение;
	Если ЗначениеЗаполнено(КартинкаБольшаяСобсвеннаяВрем) Тогда
		
		КартинкаБольшаяТовараАдрес = ПоместитьВоВременноеХранилище(КартинкаБольшаяСобсвеннаяВрем.Хранилище.Получить(), Новый УникальныйИдентификатор);
		
		
		
		МассивКартинокТекущие = новый Массив;
		//ОткрытьЗначение(ПолучитьИзВременногоХранилища(КартинкаБольшаяАдрес));
		ПараметрыДляФормы = Новый Структура;
		ПараметрыДляФормы.Вставить("АдресКартинки"  , КартинкаБольшаяТовараАдрес);
		ПараметрыДляФормы.Вставить("МассивКартинок" , МассивСобственныхКартинок);
		ПараметрыДляФормы.Вставить("МассивКартинокСсылки" , МассивСобственныхКартинокСсылки);
		ПараметрыДляФормы.Вставить("СсылкаНаТовар" , Элементы.НоменклатураПоставщиков.ТекущаяСтрока);
		
		ОткрытьФормуМодально("Обработка.РабочееМестоМенеджераИМ.Форма.ФормаПросмотраКартинки", ПараметрыДляФормы);		
		
	КонецЕсли;
	
КонецПроцедуры



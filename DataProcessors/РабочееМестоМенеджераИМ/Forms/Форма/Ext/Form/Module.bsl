Функция ПодготовитьТаблицуПереносаДляНоменклатурыПоставщика()
	
	
	СписокЗначений 	 = новый СписокЗначений;
	СписокЗначений.Добавить(Номенклатура);
	
	ПараметрыДляПереноса = новый Структура;
	ПараметрыДляПереноса.Вставить("Товары",СписокЗначений);
	
	Возврат ПараметрыДляПереноса;

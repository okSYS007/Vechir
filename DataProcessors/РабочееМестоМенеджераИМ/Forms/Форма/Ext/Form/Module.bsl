&НаКлиенте
Процедура УстановитьПараметрДинамическогоСпискаНоменклатураНайденная(НоменклатураПоставщика = Неопределено)

	Если НЕ ЗначениеЗаполнено(НоменклатураПоставщика) Тогда
		
		НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("Артикул", "");
		НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("Наименование", "");
		НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("АртикулПоставщика", "");
		НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
		
	Иначе
		
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		Элементы.НоменклатураНадпись.Заголовок = "<Номенклатура на створена, або не прив'язана>";
		НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("Артикул", НоменклатураПоставщика.Артикул);
		НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("Наименование", НоменклатураПоставщика.Наименование);
	    НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("АртикулПоставщика", НоменклатураПоставщика.Модель);
		
		Если ЗначениеЗаполнено(НоменклатураПоставщика.Номенклатура) Тогда 
			НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("Номенклатура", НоменклатураПоставщика.Номенклатура);
		Иначе
			НоменклатураНайденная.Параметры.УстановитьЗначениеПараметра("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
		КонецЕсли;	
			
	КонецЕсли;

КонецПроцедуры
 

&НаКлиенте
Процедура НоменклатураНадписьНажатие(Элемент)
	НоменклатураПоставщика = Элементы.НоменклатураПоставщиковИнтернетМагазина.ТекущаяСтрока;
	Если Номенклатура.Пустая() Тогда 
		
		
		СписокЗначений = Новый СписокЗначений;
		СписокЗначений.Добавить("Створити");
		СписокЗначений.Добавить("Прив'язати");
		
		Ответ = Вопрос("Прив'язати або створити номенклатуру",СписокЗначений,,,"Виконайте дію");
		
		Если Ответ = "Створити" Тогда 
			
			
			ОбНоменклатура                         = Справочники.Номенклатура.СоздатьЭлемент();
			ОбНоменклатура.АртикулПоставщика       = НоменклатураПоставщика.Артикул; 

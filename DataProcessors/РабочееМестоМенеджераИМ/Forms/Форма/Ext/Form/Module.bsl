&НаКлиенте
Процедура НоменклатураПоставщиковСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	
	НоменклатураПоставщика = Элементы.НоменклатураПоставщиковСписок.ТекущиеДанные.ссылка;
	
	Если ЗначениеЗаполнено(НоменклатураПоставщика) Тогда 
		
		Если ЗначениеЗаполнено(НоменклатураПоставщика.Номенклатура) Тогда 
			ОткрытьЗначение(НоменклатураПоставщика);
		Иначе
			
			СпиокВариантовОтвета = новый СписокЗначений;
			СпиокВариантовОтвета.Добавить("Так");
			СпиокВариантовОтвета.Добавить("Ні");
			Ответ = Вопрос("Вы намагаєтесь прив'язати номенклатуру постачальника до номенклатури. Продавжити?",СпиокВариантовОтвета);
			
			Если Ответ = "Так" Тогда 
				
				НоменклатураПоставщика = Элементы.НоменклатураПоставщиковСписок.ТекущиеДанные.ссылка;
				
				Если ЗначениеЗаполнено(НоменклатураПоставщика) Тогда 
					//ОбНоменклатура.Записать();
					НоменклатураПоставщикаОб = НоменклатураПоставщика.ПолучитьОбъект();
					НоменклатураПоставщикаОб.Номенклатура = Номенклатура;
					НоменклатураПоставщикаОб.Записать();
					Элементы.НоменклатураПоставщиковСписок.Обновить();
					
				Иначе
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Вставити вміст обробника.
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)
	Ответ = Вопрос("Створити номенклатуру",РежимДиалогаВопрос.ДаНетОтмена,,,"Виконайте дію");
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		СписокЗначений 	 = новый СписокЗначений;
		Для Каждого Строка из Элементы.НоменклатураПоставщиковИнтернетМагазина.ВыделенныеСтроки Цикл 
			
			если Строка.Номенклатура.Пустая() Тогда 
				ОбНоменклатура                         = Справочники.Номенклатура.СоздатьЭлемент();
				ОбНоменклатура.АртикулПоставщика       = Строка.Артикул;
				ОбНоменклатура.МодельПроизводителя     = Строка.Модель;
				ОбНоменклатура.Наименование            = Строка.Наименование;
				ОбНоменклатура.Наименование_ru         = Строка.Наименование;
				ОбНоменклатура.Наименование_en         = "";
				ОбНоменклатура.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
				ОбНоменклатура.ВидНоменклатуры         = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар");
				ОбНоменклатура.СтавкаНДС			   = Перечисления.СтавкиНДС.НДС20;
				ОбНоменклатура.Записать();
				
				НовЕдиница 				= Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
				НовЕдиница.Наименование = "шт";
				НовЕдиница.Владелец 	= ОбНоменклатура.Ссылка;
				НовЕдиница.Коэффициент  = 1;
				НовЕдиница.ЕдиницаПоКлассификатору = ОбНоменклатура.БазоваяЕдиницаИзмерения;
				НовЕдиница.Записать();
				
				ОбНоменклатура.ЕдиницаДляОтчетов 		= НовЕдиница.Ссылка;
				ОбНоменклатура.ЕдиницаХраненияОстатков 	= НовЕдиница.Ссылка;		
				
				// t.me/konstantyn_buhantsev [6 лютого 2025 р.] --> 
				Бренд = Справочники.Бренды.НайтиПоНаименованию(Строка.Бренд);
				Если НЕ ЗначениеЗаполнено(Бренд) Тогда
					БрендОбъект = Справочники.Бренды.СоздатьЭлемент();
					БрендОбъект.Наименование = Строка.Бренд;
					БрендОбъект.Записать();
					Бренд = БрендОбъект.Ссылка;
				КонецЕсли;
				ОбНоменклатура.Бренд = Бренд;
				// <-- t.me/konstantyn_buhantsev [6 лютого 2025 р.] 
				
				ОбНоменклатура.Записать();		
				ПривязатьКартинкуКНоменклатуре(Строка,ОбНоменклатура);

				Номенклатура = ОбНоменклатура.Ссылка;
				НоменклатураПоставщикаОб = Строка.ПолучитьОбъект();
				НоменклатураПоставщикаОб.Номенклатура = Номенклатура;
				НоменклатураПоставщикаОб.Записать();
				
				УстановитьЦенуНаСервере(ОбНоменклатура.ссылка,Строка.РРЦ);				
				СписокЗначений.Добавить(Номенклатура);
			КонецЕсли;
			
		КонецЦикла;
		
		ПараметрыДляПереноса = новый Структура;
		ПараметрыДляПереноса.Вставить("Товары",СписокЗначений);
		ОткрытьФормуМодально("Обработка.РабочееМестоМенеджераИМ.Форма.ФормаДеревоКатегорийНоменклатураПоставщика",ПараметрыДляПереноса);
		
		Элементы.НоменклатураПоставщиковИнтернетМагазина.Обновить();
		
	КонецЕсли;
КонецПроцедуры


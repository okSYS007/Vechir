			ОбНоменклатура.ЕдиницаХраненияОстатков 	= НовЕдиница.Ссылка;
			
			
			ОбНоменклатура.Записать();
			ПривязатьКартинкуКНоменклатуре(НоменклатураПоставщика,ОбНоменклатура);

			
			Номенклатура = ОбНоменклатура.Ссылка;
			
			ОткрытьФормуМодально("Обработка.РабочееМестоМенеджераИМ.Форма.ФормаДеревоКатегорийНоменклатураПоставщика",ПодготовитьТаблицуПереносаДляНоменклатурыПоставщика());	
			
			//ОбНоменклатура.Записать();

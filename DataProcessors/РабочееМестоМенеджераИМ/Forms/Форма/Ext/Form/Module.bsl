&НаКлиенте
Процедура ПослеОтветаСоздатьПакетДокументов(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		ЗаказПокупателя = Элементы.ЗаказыПокупателей.ТекущаяСтрока;
		Если ЕстьЧекПоЗаказу(ЗаказПокупателя) Тогда
			Сообщить("По заказу є чек");
			Возврат;
		КонецЕсли;

		НачатьТранзакцию();
		Чек = СоздатьЧекККМНаСервере(ЗаказПокупателя);	
		
		Результат = Истина;
		Ответ     = "";
		ФормаДокумента = Чек.ПолучитьФорму("ФормаРегистрацииПродаж");
		
		Чек.ПровестиИРаспечататьЧек(Ответ, Ложь, ФормаДокумента);
		Если Чек.ЧекПробитНаККМ Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
			Сообщить("Не вдалось створити чек");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьЧекККМНаСервере(ЗаказПокупателя) Экспорт
	
	Чек 					= Документы.ЧекККМ.СоздатьДокумент();
	Чек.Дата				= ТекущаяДата();
	Чек.ЗаказПокупателя 	= ЗаказПокупателя;
	Чек.ДокументОснование 	= ЗаказПокупателя;
	Чек.ВидОперации 		= Перечисления.ВидыОперацийЧекККМ.Продажа;
	Чек.КассаККМ			= Константы.КассаККМБезналичные.Получить();
	Чек.Комментарий			= "#Створено з обробки робоче місце ІМ";
	Чек.Организация			= Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9"));
	Чек.Ответственный		= ПараметрыСеанса.ТекущийПользователь;
	Чек.СтатусЧека			= Перечисления.СтатусыЧековККМ.Пробитый;
	Чек.Склад				= ЗаказПокупателя.СкладГруппа;
	
	Чек.Товары.Загрузить(ЗаказПокупателя.Товары.Выгрузить());
	
	НовСтр 				= Чек.Оплата.Добавить();
	НовСтр.ВидОплаты 	= Справочники.ВидыОплатЧекаККМ.НайтиПоКоду("00002");
	НовСтр.Сумма 		= ЗаказПокупателя.СуммаДокумента;
	
	Чек.Записать();
	
	Возврат Чек;
	
КонецФункции

&НаКлиенте
Процедура СоздатьЧекККМ(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаСоздатьПакетДокументов", ЭтаФорма),"Створити пакет документів?",РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьЧекПоЗаказу(Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	"""" КАК Поле1
		|ИЗ
		|	Документ.ЧекККМ КАК ЧекККМ
		|ГДЕ
		|	ЧекККМ.ЗаказПокупателя = &ЗаказПокупателя";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции



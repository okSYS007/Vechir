&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПоставщикиПриИзменении(Неопределено);
	
	Если Элементы.СтраницыРаботыССзаказами.ТекущаяСтраница = Элементы.ВРаботеМенеджера Тогда 	
		ЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("СтатусИМ", Перечисления.СтатусыЗаказаИМ.ВРаботеМенеджера);
		
	ИначеЕсли Элементы.СтраницыРаботыССзаказами.ТекущаяСтраница = Элементы.ВРаботеЛогистики Тогда 
		ЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("СтатусИМ", Перечисления.СтатусыЗаказаИМ.ВРаботеКладовщиков);
		
	ИначеЕсли Элементы.СтраницыРаботыССзаказами.ТекущаяСтраница = Элементы.ВРаботеЗакупщика Тогда 
		ЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("СтатусИМ", Перечисления.СтатусыЗаказаИМ.ВРаботеЗакупщиков);
		
	ИначеЕсли Элементы.СтраницыРаботыССзаказами.ТекущаяСтраница = Элементы.ВРаботеСервисногоИнженера Тогда 
		ЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("СтатусИМ", Перечисления.СтатусыЗаказаИМ.ВРаботеСервисныхИнженеров);
		
	ИначеЕсли Элементы.СтраницыРаботыССзаказами.ТекущаяСтраница = Элементы.ВРаботеЦентраОбслуживанияАбонентов Тогда 
		ЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("Статус", Перечисления.СтатусыЗаказаИМ.ВРаботеМЦОА);
		
	ИначеЕсли Элементы.СтраницыРаботыССзаказами.ТекущаяСтраница = Элементы.Завершен Тогда 
		ЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("СтатусИМ", Перечисления.СтатусыЗаказаИМ.Завершен);
		
	ИначеЕсли Элементы.СтраницыРаботыССзаказами.ТекущаяСтраница = Элементы.Отклонен Тогда 
		ЗаказыПокупателей.Параметры.УстановитьЗначениеПараметра("СтатусИМ", Перечисления.СтатусыЗаказаИМ.Отклонено);
	Иначе

			НоменклатураПоставщикаОб.Номенклатура = Номенклатура;
			НоменклатураПоставщикаОб.Записать();
			
			НоменклатураПоставщиковИнтернетМагазинаПриАктивизацииСтроки(Неопределено);

			
			//НоменклатураПоставщиковИнтернетМагазинаПриАктивизацииСтроки(Неопределено);
			УстановитьЦенуНаСервере(Номенклатура.ссылка,НоменклатураПоставщика.РРЦ);

		ИначеЕсли Ответ = "Прив'язати" Тогда 
			
			
			
			Номенклатура = Элементы.НоменклатураНайденная.ТекущиеДанные.ссылка;
			

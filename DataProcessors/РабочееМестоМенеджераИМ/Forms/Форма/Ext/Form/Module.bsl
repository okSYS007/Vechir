	КартинкаТовара = "";
	КартинкаБольшаяСобсвенная = "";
	
	КартинкаТовараАдрес = "";
	КартинкаБольшаяТовараАдрес = "";
	
	МассивСобственныхКартинок       = Новый СписокЗначений;
	МассивСобственныхКартинокСсылки = новый СписокЗначений;	
	Для Индекс = 0 По НаборКартинок.Количество() - 1 Цикл
		//МассивСобственныхКартинок.Добавить(ПоместитьВоВременноеХранилище(НаборКартинок.Получить(Индекс).Хранилище.Получить(), ЭтаФорма.УникальныйИдентификатор));
		МассивСобственныхКартинокСсылки.Добавить(НаборКартинок.Получить(Индекс));
	КонецЦикла;
	
	Если КоличествоОтображаемыхКартинок > 0 Тогда
		
		//КоличествоНаборовКартинок = 1;
		//
		//Если ТекущийНаборКартинок > КоличествоНаборовКартинок - 1 Тогда
		//	
		//	ТекущийНаборКартинок = КоличествоНаборовКартинок - 1;
		//	
		//КонецЕсли;
		//
		//Если ТекущийНаборКартинок < 0 Тогда
		//	
		//	ТекущийНаборКартинок = 0;
		//	
		//КонецЕсли;
		
		
		ИмяКартинки = "КартинкаТовара";
		
		Адрес = ПоместитьВоВременноеХранилище(НаборКартинок.Получить(0).Хранилище.Получить(), ЭтаФорма.УникальныйИдентификатор);
		
		ЭтаФорма[ИмяКартинки] = 
		"<html>
		|<head>
		|</head>

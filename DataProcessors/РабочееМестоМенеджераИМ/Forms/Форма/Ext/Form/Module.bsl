Процедура ДеревоГруппПриАктивизацииСтроки(Элемент)
	
	ТекущаяГруппа = Элементы.ДеревоГрупп.ТекущаяСтрока;
	
	КоллекцияЭлементовОтбора = НоменклатураПоставщиковИнтернетМагазина.КомпоновщикНастроек.Настройки.Отбор.Элементы;
		
	Для каждого ЭлементОтбора Из КоллекцияЭлементовОтбора Цикл
		Если ЭлементОтбора.Представление = "Родитель" Тогда
			Если НЕ ЗначениеЗаполнено(ТекущаяГруппа) Тогда
				КоллекцияЭлементовОтбора.Удалить(ЭлементОтбора);
			Иначе
				ЭлементОтбора.ПравоеЗначение = ТекущаяГруппа;
			КонецЕсли;	
			Возврат;
		КонецЕсли; 		
	КонецЦикла; 		
	
	Если НЕ ЗначениеЗаполнено(ТекущаяГруппа) Тогда
		Возврат;
	КонецЕсли;	
		
	Элемент = КоллекцияЭлементовОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Родитель");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
	Элемент.ПравоеЗначение = ТекущаяГруппа;
	
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Элемент.Представление = "Родитель";
	Элемент.Использование = Истина;		
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПоставщиковОбработкаЗапросаОбновления()
	НоменклатураПоставщиковПриАктивизацииСтроки(Неопределено);
КонецПроцедуры



// Хранит дерево документов на сервере.
&НаСервере
Перем мДерево;

// Хранит соответствие документов и признак присутствия в списке на сервере.
&НаСервере
Перем мУжеВСписке;

// Хранит соответствие имени документов и их метаданных на сервере.
&НаСервере
Перем мКэшРеквизитовДокумента;

// Хранит соответствие документов и права доступа к ним на сервере.
&НаСервере
Перем мКэшПраваДоступаКМетаданным;


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Параметры.Свойство("ОбъектОтбора", ДокументСсылка);
	
	ИсходныйДокумент = ДокументСсылка;
	
	//Если ЗначениеЗаполнено(ДокументСсылка) Тогда
	//	ОбновитьДеревоСтруктурыПодчиненности();
	//КонецЕсли;
	ОбновитьЗадачи();
	 
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	ВывестиСтруктуруПодчиненности();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиДляТекущего(Команда)
	
	ТекущийДокумент = Элементы.ТаблицаОтчета.ТекущаяОбласть.Расшифровка;
	
	Если ЗначениеЗаполнено(ТекущийДокумент) Тогда
		ДокументСсылка = ТекущийДокумент;
	Иначе
		Возврат;
	КонецЕсли;
	
	//ВывестиСтруктуруПодчиненности();
	ДанныеТекущейСтроки = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ДанныеТекущейСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ДокументСсылка = ДанныеТекущейСтроки.Ссылка;
		
	Если ОсновнойДокументЕщеДоступен(ДокументСсылка) Тогда
		ВыполнитьОбновлениеДереваДокументов();
	Иначе
		ЗакрытьФормуСПредупреждением("ru = 'Документ, для которого сформирован отчет о структуре
									 |подчиненности был удален, или же стал недоступен.'");
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура ВывестиСтруктуруПодчиненности()
	
	
	Если ДокументСсылка = Неопределено 
		Или ДокументСсылка.Пустая() Тогда
		
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбновлениеДереваДокументов();

	КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ВыполнитьОбновлениеДереваДокументов()
	
	ВывестиДеревоДокументов();
	РазвернутьТаблицуДокументов();
		
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьТаблицуДокументов()

	ЭлементыДерева = ДеревоДокументов.ПолучитьЭлементы();
	Для Каждого Элемент Из ЭлементыДерева Цикл

		Элементы.ДеревоДокументов.Развернуть(Элемент.ПолучитьИдентификатор(), Истина);

	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ВывестиДеревоДокументов()
	
	ДанныеДерева = ДеревоДокументов.ПолучитьЭлементы();
	ДанныеДерева.Очистить();
	
	мДерево = ДанныеДерева;	
	мУжеВСписке.Очистить();
	ВывестиРодительскиеДокументы(ДокументСсылка);
	
	ВывестиПодчиненныеДокументы(мДерево, мКэшПраваДоступаКМетаданным);
	ВывестиПодчинённыеИзТабличныхЧастей(ДокументСсылка);
	
	//ВывестиДокументыОплатыПлатежныхПозиций(ДанныеДерева);
	
КонецПроцедуры // ВывестиДеревоДокументов()

#Область СлужебныеПроцедурыИФункции

//////////////////////////////////////////////////////////////////////////////////////////////
// Процедуры вывода в табличный документ.


&НаСервере
Функция ПолучитьПредставлениеДокументаДляПечати(Выборка)
	
	ПредставлениеДокумента = Выборка.Представление;
	Если (Выборка.СуммаДокумента <> 0) И (Выборка.СуммаДокумента <> NULL) Тогда
		ПредставлениеДокумента = ПредставлениеДокумента + " " + НСтр("ru='на сумму';uk='на суму'") + " " + Выборка.СуммаДокумента + " " + Выборка.Валюта;
	КонецЕсли;
	
	Возврат ПредставлениеДокумента;
	
КонецФункции


&НаСервере
Процедура ЗаменитьТекстЗапроса(ТекстЗапроса, МетаданныеДокумента, ЧтоЗаменять, ИмяРеквизита, Представление)

	Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЧтоЗаменять, ИмяРеквизита + " КАК " + Представление);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЧтоЗаменять, " NULL КАК " + Представление);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДополнитьТекстЗапросаПоРеквизитамДокумента(ТекстЗапроса, МассивРеквизитов)
	
	ТекстПредставление = "Представление КАК Представление";
	
	Для Инд = 1 По 3 Цикл
		
		ТекстПредставление = ТекстПредставление + ",
			|	" + ?(МассивРеквизитов.Количество() >= Инд,МассивРеквизитов[инд - 1],"NULL") + " Как ДополнительныйРеквизит" + Инд;
		
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Представление", ТекстПредставление);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкиПриАктивизацииСтроки(Элемент)
	Попытка
		ДокументСсылка = Элемент.ТекущиеДанные.ссылка;
	Исключение
		ДокументСсылка = Документы.ОбходнойЛист.ПустаяСсылка();	
	КонецПопытки;
	ВывестиСтруктуруПодчиненности();
	ОбновитьТаблицуЭтаповСогласования(ДокументСсылка);
	ОбновитьЗадачи();
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВРаботу(Команда)
	
	Если Элементы.ОбходныеЛисты.ТекущиеДанные.ссылка.Проведен тогда
		
		
		//Если ЕстьФайлы( Элементы.Заявки.ТекущаяСтрока) или ПроходитПоСумме(Элементы.Заявки.ТекущиеДанные.ссылка)  Тогда 
			
			УспешныйЗапуск = ЗапуститьВРаботуНаСервере(Элементы.ОбходныеЛисты.ТекущаяСтрока);
			
			Если УспешныйЗапуск Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обідний лист № "+Элементы.ОбходныеЛисты.ТекущиеДанные.Номер+" успішно відправлений на погодження!");	
			КонецЕсли;
			
			ОбновитьФорму();
			
		//Иначе
		//	
		//	Сообщить("Вы не можете запустить в работу заявку на расходование денежных средств без прикрепленных файлов!",СтатусСообщения.ОченьВажное);
		//	
		//КонецЕсли;
		
	Иначе
		
		Сообщить("Ви не можете запустити в роботу не проведений документ!",СтатусСообщения.ОченьВажное);
		
		
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Функция ЗапуститьВРаботуНаСервере(ОбходнойЛист)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СогласованиеОбходногоЛиста.Ссылка
	               |ИЗ
	               |	БизнесПроцесс.СогласованиеОбходногоЛиста КАК СогласованиеОбходногоЛиста
	               |ГДЕ
	               |	СогласованиеОбходногоЛиста.Предмет = &Предмет";
	
	Запрос.УстановитьПараметр("Предмет",ОбходнойЛист); 
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Процесс согласования уже запущен"); 
		
	ИначеЕсли ОбходнойЛист.Статус = Перечисления.СтатусыОбходныхЛистов.Согласован Тогда 

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Процесс согласования уже пройден"); 
	
		
	Иначе
		
		БизнесПроцесс = БизнесПроцессы.СогласованиеОбходногоЛиста.СоздатьБизнесПроцесс();
		БизнесПроцесс.Заполнить(ОбходнойЛист); 
		БизнесПроцесс.Дата = ОбходнойЛист.дата;
		БизнесПроцесс.Записать();
		БизнесПроцесс.Старт(); 
		
		ОбходнойЛистОб = ОбходнойЛист.ПолучитьОбъект();
		ОбходнойЛистОб.Статус = Перечисления.СтатусыОбходныхЛистов.НаСогласовании;
		ОбходнойЛистОб.записать();
		
		Возврат истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


&НаСервере
Процедура ОбновитьТаблицуЭтаповСогласования(Заявка)
	
	Запрос = новый запрос;
	Запрос.Текст =    "ВЫБРАТЬ
	                  |	СогласованиеОбходногоЛистаРезультатыСогласования.ДатаСогласования,
	                  |	СогласованиеОбходногоЛистаРезультатыСогласования.РезультатСогласования,
	                  |	СогласованиеОбходногоЛистаРезультатыСогласования.Рецензент КАК Ответственный,
	                  |	СогласованиеОбходногоЛистаРезультатыСогласования.ТочкаМаршрута.Порядок КАК Индекс,
	                  |	СогласованиеОбходногоЛистаРезультатыСогласования.ТочкаМаршрута,
	                  |	СогласованиеОбходногоЛистаРезультатыСогласования.Комментарий
	                  |ИЗ
	                  |	БизнесПроцесс.СогласованиеОбходногоЛиста.РезультатыСогласования КАК СогласованиеОбходногоЛистаРезультатыСогласования
	                  |ГДЕ
	                  |	СогласованиеОбходногоЛистаРезультатыСогласования.Ссылка.Предмет = &Предмет";
	Запрос.УстановитьПараметр("Предмет",Заявка);  
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	РезультатЗапроса.Колонки.Добавить("ЭтапСогласования"); 
	РезультатЗапроса.Колонки.Добавить("РольИсполнителя"); 
	
	Для Каждого Строка из РезультатЗапроса цикл     
			Строка.ЭтапСогласования = Строка.ТочкаМаршрута;	
	КонецЦикла;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗадачаИсполнителя.ТочкаМаршрута,
	               |	ЗадачаИсполнителя.РольИсполнителя
	               |ИЗ
	               |	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	               |ГДЕ
	               |	ЗадачаИсполнителя.БизнесПроцесс.Предмет = &Предмет
	               |	И НЕ ЗадачаИсполнителя.Выполнена"; 
	Запрос.УстановитьПараметр("Предмет",Заявка);
	РезультатЗапросаТекущийЭтапСогласования = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапросаТекущийЭтапСогласования.Следующий() Тогда 	
		СтрокаСогласование = РезультатЗапроса.Добавить();
		СтрокаСогласование. ЭтапСогласования =РезультатЗапросаТекущийЭтапСогласования.ТочкаМаршрута;
		СтрокаСогласование. РольИсполнителя =РезультатЗапросаТекущийЭтапСогласования.РольИсполнителя;
	КонецЕсли; 
	
	Согласование.Загрузить(РезультатЗапроса);					  
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗадачи()
	//ЗадачиПоЗаявке.Параметры.УстановитьЗначениеПараметра("Предмет",Элементы.Заявки.ТекущаяСтрока);
	

	Элементы.ЗадачиПоЗаявке.Обновить();	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	Элементы.ОбходныеЛисты.Обновить();
	ДокументСсылка = Элементы.ОбходныеЛисты.ТекущаяСтрока;
	ВывестиСтруктуруПодчиненности();
    ОбновитьТаблицуЭтаповСогласования(ДокументСсылка);
	ОбновитьЗадачи();
	
	
	Если ОсновнойДокументЕщеДоступен(ДокументСсылка) Тогда
		ВыполнитьОбновлениеДереваДокументов();
	Иначе
		ЗакрытьФормуСПредупреждением("ru = 'Документ, для которого сформирован отчет о структуре
									 |подчиненности был удален, или же стал недоступен.'");
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьФорму() Экспорт           
	
	ОбновитьЗадачи();
	ВывестиСтруктуруПодчиненности();
	Элементы.ОбходныеЛисты.Обновить();
	Элементы.Согласование.Обновить();
    ОбновитьТаблицуЭтаповСогласования(Элементы.ОбходныеЛисты.ТекущаяСтрока);
	
КонецПроцедуры


&НаКлиенте
Процедура ЗадачиПоЗаявкеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ФормаДокумента = Элементы.ЗадачиПоЗаявке.ТекущаяСтрока.Предмет.ПолучитьФорму();
	ФормаДокумента.ОткрытьМодально();
	
	ОбновитьФорму();
КонецПроцедуры

&НаСервере
Функция ЕстьФайлы(Заявка)
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ХранилищеДополнительнойИнформации.Ссылка
	               |ИЗ
	               |	Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	               |ГДЕ
	               |	ХранилищеДополнительнойИнформации.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект",Заявка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса.Количество();
КонецФункции 

#КонецОбласти


	ВЫБОР
		КОГДА ХозрасчетныйОстатки.Счет.Код = "301"
				ИЛИ ХозрасчетныйОстатки.Счет.Код = "302"
			ТОГДА ХозрасчетныйОстатки.Субконто2
		КОГДА ХозрасчетныйОстатки.Счет.Код = "311"
				ИЛИ ХозрасчетныйОстатки.Счет.Код = "312"
			ТОГДА ХозрасчетныйОстатки.Субконто1
	КОНЕЦ КАК IDCashAccount,
	&amp;Период ,
	&amp;Период как Day,

	ХозрасчетныйОстатки.Организация как IDOrganization,
	ХозрасчетныйОстатки.Счет.Код как AccountingAccount
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Остатки(
			&amp;Период,
			Счет.Код = "301"
				ИЛИ Счет.Код = "311"

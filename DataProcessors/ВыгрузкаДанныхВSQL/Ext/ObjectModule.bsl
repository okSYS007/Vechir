	СоотвПолейДаты.Вставить("date",		"DATE");
	СоотвПолейДаты.Вставить("time",		"TIME");
	СоотвПолейДаты.Вставить("day",		"INT");
	СоотвПолейДаты.Вставить("month",	"INT");

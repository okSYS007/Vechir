Процедура ВыгрузитьПодразделения(МассивСнятияРегистрации)

	
	Запрос = Новый Запрос();

	Запрос.Текст ="ВЫБРАТЬ
	              |	ПодразделенияИзменения.Ссылка.Ссылка КАК IDDepartment,
	              |	ПодразделенияИзменения.Ссылка.Наименование КАК Name,
	              |	ПодразделенияИзменения.Ссылка.Ссылка КАК СнятиеРегистрации,
	              |	ВЫБОР
	              |		КОГДА ПодразделенияИзменения.Ссылка.Родитель = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	              |			ТОГДА ПодразделенияИзменения.Ссылка.Представление
	              |		КОГДА ПодразделенияИзменения.Ссылка.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	              |			ТОГДА ПодразделенияИзменения.Ссылка.Родитель.Представление
	              |		КОГДА ПодразделенияИзменения.Ссылка.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	              |			ТОГДА ПодразделенияИзменения.Ссылка.Родитель.Родитель.Представление
	              |		КОГДА ПодразделенияИзменения.Ссылка.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	              |			ТОГДА ПодразделенияИзменения.Ссылка.Родитель.Родитель.Родитель.Представление
	              |	КОНЕЦ КАК Parent
	              |ИЗ
	              |	Справочник.Подразделения.Изменения КАК ПодразделенияИзменения
	              |ГДЕ
	              |	ПодразделенияИзменения.Узел = &Узел
	              |	И НЕ ПодразделенияИзменения.Ссылка.ПометкаУдаления";

	Запрос.УстановитьПараметр("Узел", УзелОбменаСPowerBI);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	МассивКлючевыхИмен = Новый Массив;
	МассивКлючевыхИмен.Добавить("IDDepartment");

	ВыгрузитьИзмененияТаблицы(РезультатЗапроса, "Departments", МассивКлючевыхИмен, ,МассивСнятияРегистрации);

КонецПроцедуры


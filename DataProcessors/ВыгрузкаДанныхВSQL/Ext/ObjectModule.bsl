	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		НовоеЗначение = Справочники.Номенклатура.ПустаяСсылка();
		СформированнаяСтрока = "'" + XMLСтрока(НовоеЗначение) + "'";
	Иначе

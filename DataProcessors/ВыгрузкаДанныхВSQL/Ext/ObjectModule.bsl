Функция ФорматЧислаSQL(ЧислоЗнч)
	Результат = СтрЗаменить(СтрЗаменить(Формат(ЧислоЗнч, "ЧРД=.; ЧН=; ЧГ=0")," ",""),Символы.НПП,"");;	
	Возврат Результат;
КонецФункции

Функция ФорматДатыSQL(ДатаЗнч)
	
	//Если ДатаЗнч = 0 Тогда
	//	ДатаЗнч = Дата('00010101');
	//КонецЕсли;
	Если ДатаЗнч = Дата('00010101') Тогда 
		
		Результат =
		"CONVERT(DateTime,'"
		+ Формат(Дата(1900,01,01), "ДФ = ""dd-MM-yyyy HH:mm:ss""")
		+ "')"
		;
	Иначе
		
		Результат =
		"CONVERT(DateTime,'"
		+ Формат(ДатаЗнч, "ДФ = ""dd-MM-yyyy HH:mm:ss""")
		+ "')"
		;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции


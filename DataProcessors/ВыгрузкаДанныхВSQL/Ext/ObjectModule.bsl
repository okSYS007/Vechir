Процедура ОчиститьЗначенияМассиваПолейSQL(МассивПолей)

	Для Каждого СтруктураПоля Из МассивПолей Цикл

		ПустоеЗначение = Неопределено;

		ТипПоля = СтруктураПоля.Тип;

		Если ТипПоля = "BIT" Тогда
			ПустоеЗначение = Ложь;
		ИначеЕсли ТипПоля = "DATE" ИЛИ ТипПоля = "DATETIME" ИЛИ ТипПоля = "TIME" Тогда
			ПустоеЗначение = Дата(1,1,1);
		ИначеЕсли ТипПоля = "INT" ИЛИ ТипПоля = "FLOAT" Тогда
			ПустоеЗначение = 0;
		ИначеЕсли ТипПоля = "TEXT" ИЛИ ЛЕВ(ТипПоля, 7) = "varchar" Тогда
			ПустоеЗначение = "";
		КонецЕсли;

		СтруктураПоля.Значение = ПустоеЗначение;

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьТипПоляПоОписаниюТиповДляSQL(ОписаниеТиповПоля,ИмяПоля)

	Если ОписаниеТиповПоля.СодержитТип(Тип("Булево")) Тогда
		ТипПоля = "BIT";
	ИначеЕсли ОписаниеТиповПоля.СодержитТип(Тип("Дата")) Тогда

		СвойстваДаты = ОписаниеТиповПоля.КвалификаторыДаты.ЧастиДаты;

		Если СвойстваДаты = ЧастиДаты.Дата Тогда
			ТипПоля = "DATE";
		ИначеЕсли СвойстваДаты = ЧастиДаты.Время Тогда
			ТипПоля = "TIME";
		Иначе
			ТипПоля = "DATETIME";
		КонецЕсли;

	ИначеЕсли ОписаниеТиповПоля.СодержитТип(Тип("Число")) Тогда
		ТипПоля = ?(ОписаниеТиповПоля.КвалификаторыЧисла.РазрядностьДробнойЧасти > 0, "FLOAT", "FLOAT");
	ИначеЕсли ОписаниеТиповПоля.СодержитТип(Тип("Строка"))  Тогда
		ДлинаСтроки = ОписаниеТиповПоля.КвалификаторыСтроки.Длина;
		ТипПоля = ?(ДлинаСтроки < 1, "TEXT", "varchar(" + Формат(ДлинаСтроки, "ЧГ=0") + ")");
	Иначе
		ТипПоля = "uniqueidentifier";
	КонецЕсли;

	Если Найти(ИмяПоля, "ID") > 0 Тогда
		ТипПоля = "uniqueidentifier";	
	КонецЕсли;
	
	Возврат ТипПоля;

КонецФункции

Функция ПолучитьСтруктуруСвойстваПоляSQL(ИмяПоля, ТипПоля, ПорядокПоля = 0, ЗначениеПоля = "", Ограничение = "", БезЗаменыNULL = Ложь)

	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Имя",			ИмяПоля);
	СтруктураСвойств.Вставить("Тип",			ТипПоля);
	СтруктураСвойств.Вставить("Значение",		ЗначениеПоля);
	СтруктураСвойств.Вставить("Ограничение",	Ограничение);
	СтруктураСвойств.Вставить("Порядок",		ПорядокПоля);
	СтруктураСвойств.Вставить("БезЗаменыNULL",	БезЗаменыNULL);

	Возврат СтруктураСвойств;

КонецФункции

Функция СформироватьПроизвольноеЗначениеSQL(СтруктураПоля)

	ТипПоля		= СтруктураПоля.Тип;
	СтрокаПоля	= СтруктураПоля.Значение;
	БезЗаменыNULL	= СтруктураПоля.БезЗаменыNULL;

	Если БезЗаменыNULL И (
			СтруктураПоля.Значение = null
		ИЛИ СтруктураПоля.Значение = Неопределено
	) Тогда
		СтрокаПоля = "null";
		Возврат СтрокаПоля;
	КонецЕсли;

	Если ТипПоля = "BIT" Тогда
		СтрокаПоля = СформироватьБулевДляSQL(СтрокаПоля);
	ИначеЕсли ТипПоля = "DATE" ИЛИ ТипПоля = "DATETIME" ИЛИ ТипПоля = "TIME" Тогда
		СтрокаПоля = ФорматДатыSQL(СтрокаПоля);
	ИначеЕсли ТипПоля = "INT" ИЛИ ТипПоля = "FLOAT" Тогда
		СтрокаПоля = СформироватьЧислоДляSQL(СтрокаПоля);
	ИначеЕсли ТипПоля = "TEXT" ИЛИ ЛЕВ(ТипПоля, 7) = "varchar" Тогда
		СтрокаПоля = СформироватьСтрокуДляSQL(СтрокаПоля);
	ИначеЕсли ТипПоля = "uniqueidentifier" Тогда
		СтрокаПоля = СформироватьУникальныйИдентификаторДляSQL(СтрокаПоля);
	КонецЕсли;

	Возврат СтрокаПоля;

КонецФункции

Функция ПолучитьМассивПолейИзКолонокТаблицы(
	КолонкиТаблицы
	, МассивКлючевыхИмен = Неопределено
	, Ограничение = ""
	, СоотвПереопределяемыхПолей = Неопределено
	, МассивПоляБезЗаменыNULL = Неопределено
)

	ЗаданоОграничение = НЕ ПустаяСтрока(Ограничение);

	СоотвПереопределяемыхПолей = ?(СоотвПереопределяемыхПолей = Неопределено, Новый Соответствие, СоотвПереопределяемыхПолей);
	СоотвПереопределяемыхПолей.Вставить("СнятиеРегистрации",	"НЕНУЖНО");
	СоотвПереопределяемыхПолей.Вставить("УдалениеОбъекта",		"НЕНУЖНО");

	МассивКлючевыхИмен = ?(МассивКлючевыхИмен = Неопределено, Новый Массив, МассивКлючевыхИмен);
	СоотвКлючевыхПолей = Новый Соответствие;

	Для Каждого КлючевоеИмя Из МассивКлючевыхИмен Цикл
		СоотвКлючевыхПолей.Вставить(КлючевоеИмя, Истина);
	КонецЦикла;

	МассивПоляБезЗаменыNULL = ?(МассивПоляБезЗаменыNULL = Неопределено, Новый Соответствие, МассивПоляБезЗаменыNULL);
	СоотвПоляБезЗаменыNULL = Новый Соответствие;

	Для Каждого ПолеБезЗамены Из МассивПоляБезЗаменыNULL Цикл
		СоотвПоляБезЗаменыNULL.Вставить(ПолеБезЗамены, Истина);
	КонецЦикла;

	МассивПолей = Новый Массив;

	Для Каждого КолонкаТаблицы Из КолонкиТаблицы Цикл

		ИмяПоля	= КолонкаТаблицы.Имя;

		ПереопределениеПоля = СоотвПереопределяемыхПолей.Получить(ИмяПоля);

		Если ПереопределениеПоля = Неопределено Тогда
			ТипПоля	= ПолучитьТипПоляПоОписаниюТиповДляSQL(КолонкаТаблицы.ТипЗначения,ИмяПоля);
		ИначеЕсли ПереопределениеПоля = "НЕНУЖНО" Тогда
			Продолжить;
		Иначе
			ТипПоля	= ПереопределениеПоля;
		КонецЕсли;

		БезЗаменыNULL = (СоотвПоляБезЗаменыNULL.Получить(ИмяПоля) = Истина);

		ЭтоКлючевоеПоле = (СоотвКлючевыхПолей.Получить(ИмяПоля) = Истина);

		ОграничениеПоля = ?(ЗаданоОграничение И ЭтоКлючевоеПоле, Ограничение, "");

		СтруктураСвойства = ПолучитьСтруктуруСвойстваПоляSQL(ИмяПоля, ТипПоля, , , ОграничениеПоля, БезЗаменыNULL);
		МассивПолей.Добавить(СтруктураСвойства);

	КонецЦикла;

	Возврат МассивПолей;

КонецФункции

Функция СформироватьКомбинированноеОграничение(НаименованиеОграничения, МассивКлючевыхИмен)

	СтрокиПолей = "";

	Для Каждого ИмяПоля Из МассивКлючевыхИмен Цикл

		СтрокаПоля	= " " + ИмяПоля + " ASC,";

		СтрокиПолей = СтрокиПолей + СтрокаПоля;

	КонецЦикла;

	СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(СтрокиПолей, 1);

	СтрокаОграничения = " , CONSTRAINT [" + НаименованиеОграничения + "] PRIMARY KEY CLUSTERED(" + СтрокиПолей +")";

	Возврат СтрокаОграничения;

КонецФункции

Функция ПолучитьТекстУсловия(МассивКлючевыхПолей)

	ПоляУсловия = "";

	Для Каждого СтруктураПоля Из МассивКлючевыхПолей Цикл

		ИмяПоля		= СтруктураПоля.Имя;
		СтрокаПоля	= СформироватьПроизвольноеЗначениеSQL(СтруктураПоля);

		СтрокаУсловия
			= Символы.ПС  + Символы.Таб + ИмяПоля
			+ Символы.Таб + " = " + СтрокаПоля + " AND"
		;

		ПоляУсловия = ПоляУсловия + СтрокаУсловия;

	КонецЦикла;

	СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(ПоляУсловия, 3);

	ТекстУсловия = " WHERE (" + ПоляУсловия + Символы.ПС + ")";

	Возврат ТекстУсловия;

КонецФункции

Функция ПолучитьТекстЗапросаCreateTable(НаименованиеТаблицы, ТекстОграничения = "", МассивПолей)

	ТекстСозданиеТаблицы = "CREATE TABLE " + НаименованиеТаблицы + "(";

	ПоляCreate	= "";

	Для Каждого СтруктураПоля Из МассивПолей Цикл

		СтрокаЗапроса
			= Символы.ПС + СтруктураПоля.Имя + Символы.Таб + СтруктураПоля.Тип
			+ ?(ПустаяСтрока(СтруктураПоля.Ограничение), "", Символы.Таб)
			+ СтруктураПоля.Ограничение + ","
		;

		ПоляCreate = ПоляCreate + СтрокаЗапроса;

	КонецЦикла;

	СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(ПоляCreate, 1);

	ТекстСозданиеТаблицы = ТекстСозданиеТаблицы + ПоляCreate + "
		|" + ТекстОграничения + "
		|)";

	Возврат ТекстСозданиеТаблицы;

КонецФункции

Функция ПолучитьТекстЗапросаInsertUpdate(НаименованиеТаблицы, ТекстУсловия, МассивПолей)

	ПоляUpdate	= "";
	ПоляInsert	= "";

	Для Каждого СтруктураПоля Из МассивПолей Цикл

		ИмяПоля		= СтруктураПоля.Имя;
		ТипПоля		= СтруктураПоля.Тип;
		СтрокаПоля	= СформироватьПроизвольноеЗначениеSQL(СтруктураПоля);

		СтрокаПоля = Строка(СтрокаПоля) + ",";

		СтрокаПоляInsert = Символы.ПС + СтрокаПоля;
		СтрокаПоляUpdate = Символы.ПС + ИмяПоля + Символы.Таб + " = " + СтрокаПоля;

		ПоляInsert = ПоляInsert + СтрокаПоляInsert;
		ПоляUpdate = ПоляUpdate + СтрокаПоляUpdate;

	КонецЦикла;

	СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(ПоляInsert, 1);
	СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(ПоляUpdate, 1);

	ТекстЗапроса =
		"IF(EXISTS
		|(SELECT * FROM " + НаименованиеТаблицы + "
		|" + ТекстУсловия + "
		|))
		|BEGIN
		|UPDATE " + НаименованиеТаблицы + "
		|SET " + ПоляUpdate + " 
		|" + ТекстУсловия + "
		|END
		|ELSE
		|BEGIN
		|INSERT INTO " + НаименованиеТаблицы + "
		|VALUES(" + ПоляInsert + "
		|)
		|END";

	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьТекстЗапросаDelete(НаименованиеТаблицы, ТекстУсловия)

	ТекстЗапроса =
		"DELETE FROM " + НаименованиеТаблицы + "
		|" + ТекстУсловия
	;

	Возврат ТекстЗапроса;

КонецФункции

Процедура ВыгрузитьИзмененияТаблицы(
	  РезультатЗапроса
	, НаименованиеТаблицы
	, МассивКлючевыхИмен
	, СоотвПереопределяемыхПолей	= Неопределено
	, МассивСнятияРегистрации		= Неопределено
	, МассивКлючевыхДляУдаления		= Неопределено
	, МассивПоляБезЗаменыNULL		= Неопределено
)

	Если НЕ РезультатЗапроса.Количество() Тогда
		Возврат;
	КонецЕсли;

	ВсегоКлючевыхПолей = МассивКлючевыхИмен.Количество();

	Если ВсегоКлючевыхПолей < 1 Тогда
		Возврат;
	ИначеЕсли ВсегоКлючевыхПолей = 1 Тогда
		НаименованиеОграничения	= "ID_" + НаименованиеТаблицы;
		ТекстОграничения		= "";
		Ограничение				= " CONSTRAINT " + НаименованиеОграничения + " PRIMARY KEY";
	Иначе
		НаименованиеОграничения	= "PK_" + НаименованиеТаблицы;
		ТекстОграничения		= СформироватьКомбинированноеОграничение(НаименованиеОграничения, МассивКлючевыхИмен);
		Ограничение				= "";
	КонецЕсли;

	//

	КолонкиТаблицы = РезультатЗапроса.Колонки;

	МассивПолей	= ПолучитьМассивПолейИзКолонокТаблицы(
		  КолонкиТаблицы
		, МассивКлючевыхИмен
		, Ограничение
		, СоотвПереопределяемыхПолей
		, МассивПоляБезЗаменыNULL
	);
	СоотвПолей	= Новый Соответствие;

	Для Каждого СтруктураПоля Из МассивПолей Цикл
		СоотвПолей.Вставить(СтруктураПоля.Имя, СтруктураПоля);
	КонецЦикла;

	//

	УстановитьАДОДБКоннект();

	Если НЕ ТаблицаСуществует(АДОДБКоннект, НаименованиеТаблицы) Тогда

		ТекстСозданиеТаблицы = ПолучитьТекстЗапросаCreateTable(НаименованиеТаблицы, ТекстОграничения, МассивПолей);

		Если ВыгружатьАДОДБ Тогда
			АДОДБКоннект.Execute(ТекстСозданиеТаблицы);
		КонецЕсли;

	КонецЕсли;

	//

	МассивКлючевыхПолей = Новый Массив;

	Для Каждого ИмяПоля Из МассивКлючевыхИмен Цикл
		СтруктураПоля	= СоотвПолей.Получить(ИмяПоля);
		МассивКлючевыхПолей.Добавить(СтруктураПоля);
	КонецЦикла;

	МассивПолейУдаления = ?(МассивКлючевыхДляУдаления = Неопределено, МассивКлючевыхПолей, Новый Массив);

	Если МассивКлючевыхДляУдаления <> Неопределено Тогда
		Для Каждого ИмяПоля Из МассивКлючевыхДляУдаления Цикл
			СтруктураПоля	= СоотвПолей.Получить(ИмяПоля);
			МассивПолейУдаления.Добавить(СтруктураПоля);
		КонецЦикла;
	КонецЕсли;

	//

	СниматьРегистрацию = (ТипЗнч(МассивСнятияРегистрации) = Тип("Массив"));

	Для Каждого СтрокаРезультата Из РезультатЗапроса Цикл

		ОчиститьЗначенияМассиваПолейSQL(МассивПолей);

		Для Каждого Колонка Из КолонкиТаблицы Цикл

			ИмяКолонки		= Колонка.Имя;
			СтруктураПоля	= СоотвПолей.Получить(ИмяКолонки);

			Если СтруктураПоля = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			СтруктураПоля.Значение = СтрокаРезультата[ИмяКолонки];

		КонецЦикла;

		//Если СтрокаРезультата.УдалениеОбъекта Тогда 
		//	ТекстУсловия = ПолучитьТекстУсловия(МассивПолейУдаления);
		//	ТекстЗапроса = ПолучитьТекстЗапросаDelete(НаименованиеТаблицы, ТекстУсловия);
		//Иначе
			ТекстУсловия = ПолучитьТекстУсловия(МассивКлючевыхПолей);
			ТекстЗапроса = ПолучитьТекстЗапросаInsertUpdate(НаименованиеТаблицы, ТекстУсловия, МассивПолей);
		//КонецЕсли;
		
		Попытка 
			Если ВыгружатьАДОДБ Тогда
				АДОДБКоннект.Execute(ТекстЗапроса);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ВыгрузкаВPowerBI",УровеньЖурналаРегистрации.Ошибка,,ТекстЗапроса,ТекстЗапроса);
		КонецПопытки;
		Если СниматьРегистрацию Тогда
			МассивСнятияРегистрации.Добавить(СтрокаРезультата.СнятиеРегистрации);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

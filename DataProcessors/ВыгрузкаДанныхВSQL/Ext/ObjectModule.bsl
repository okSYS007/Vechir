
Перем АДОДБКоннект Экспорт;
Перем АДОДБКоманда Экспорт;
Перем АДОДБЗапись Экспорт;

Перем УзелОбменаСPowerBI Экспорт;

Перем ВыгружатьАДОДБ Экспорт;

/////////////////////////////////////////////////////////////////////////////////////////////////////////

Процедура ВыгрузитьДанныеPowerBI() Экспорт
	
	Организации = Справочники.Организации.Выбрать();
	Пока Организации.Следующий() Цикл 
		ВыгрузитьНеоплаченныеЗаявки(Организации.Ссылка);
		
		
	КонецЦикла;
	АДОДБКоннект.Execute("USE [PowerBI_UPR] 
	|DROP TABLE UnpaidRequestsForExpenditureOfFunds
	| 
	| EXEC sp_rename 'UnpaidRequestsForExpenditureOfFunds_temp', 'UnpaidRequestsForExpenditureOfFunds'");
	
	АДОДБКоннект.Execute("USE [PowerBI_UPR]; EXEC sp_rename 'UnpaidRequestsForExpenditureOfFunds.ID_UnpaidRequestsForExpenditureOfFunds_temp', 'ID_UnpaidRequestsForExpenditureOfFunds', 'INDEX';");
	
	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьОрганизации(МассивСнятияРегистрации);
	СнятьРегистрациюОбъектовСсылочногоТипа(МассивСнятияРегистрации);

	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьСчетаКассы(МассивСнятияРегистрации);
	СнятьРегистрациюОбъектовСсылочногоТипа(МассивСнятияРегистрации);

	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьПодразделения(МассивСнятияРегистрации);
	СнятьРегистрациюОбъектовСсылочногоТипа(МассивСнятияРегистрации);

	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьПроекты(МассивСнятияРегистрации);
	СнятьРегистрациюОбъектовСсылочногоТипа(МассивСнятияРегистрации);

	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьСтатьиДДС(МассивСнятияРегистрации);
	СнятьРегистрациюОбъектовСсылочногоТипа(МассивСнятияРегистрации);

	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьСтатьиPL(МассивСнятияРегистрации);
	СнятьРегистрациюОбъектовСсылочногоТипа(МассивСнятияРегистрации);

	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьРазделыPL(МассивСнятияРегистрации);
	//СнятьРегистрациюОбъектовСсылочногоТипа(МассивСнятияРегистрации);
	
	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьПланПоБюджетуДДС(МассивСнятияРегистрации);
	//СнятьРегистрациюРегистра(Метаданные.РегистрыНакопления.ПланБюджетированияПоСтатьям,МассивСнятияРегистрации);

	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьПланПоБюджетуБДР(МассивСнятияРегистрации);
	//СнятьРегистрациюРегистра(Метаданные.РегистрыНакопления.ПланБюджетированияПоСтатьям,МассивСнятияРегистрации);
	МассивСнятияРегистрации = Новый Массив;
	ВыгрузитьФинРезультаты(МассивСнятияРегистрации);
	
	Организации = Справочники.Организации.Выбрать();
	
	Пока Организации.Следующий() Цикл 

		Если Организации.А_УправленческийУчет Тогда 
			ВыгрузитьОстаткиДДС(Организации.Ссылка);
			ВыгрузитьОборотыДДС(Организации.Ссылка);
			ВыгрузитьОборотыPL(Организации.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	АДОДБКоннект.Execute("USE [PowerBI_UPR] 
	|DROP TABLE CashBalance
	| 
	| EXEC sp_rename 'CashBalance_temp', 'CashBalance'");
	
	АДОДБКоннект.Execute("USE [PowerBI_UPR]; EXEC sp_rename 'CashBalance.PK_CashBalance_temp', 'PK_CashBalance', 'INDEX';");
	//---------------------------------------------------------------------------------------------------------------------------
	АДОДБКоннект.Execute("USE [PowerBI_UPR] 
	|DROP TABLE CashFlowTurnover
	| 
	| EXEC sp_rename 'CashFlowTurnover_temp', 'CashFlowTurnover'");
	
	АДОДБКоннект.Execute("USE [PowerBI_UPR]; EXEC sp_rename 'CashFlowTurnover.PK_CashFlowTurnover_temp', 'PK_CashFlowTurnover', 'INDEX';");
	//---------------------------------------------------------------------------------------------------------------------------

	АДОДБКоннект.Execute("USE [PowerBI_UPR] 
	|DROP TABLE PL
	| 
	| EXEC sp_rename 'PL_temp', 'PL'");
	
	АДОДБКоннект.Execute("USE [PowerBI_UPR]; EXEC sp_rename 'PL.PK_PL_temp', 'PK_PL', 'INDEX';");
	
	
	
КонецПроцедуры

Процедура ВыгрузитьОстаткиДДС(Организация)

	СхемаСКД = Обработки.ВыгрузкаДанныхВSQL.ПолучитьМакет("Макет");
	
	КомпоновщикНастроек = Неопределено;
	Если КомпоновщикНастроек = Неопределено Тогда
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);		
	КонецЕсли;
	
	Настройки         = КомпоновщикНастроек.ПолучитьНастройки(); 
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода",НачалоГода(НачалоМесяца(ТекущаяДата())-90*24*60*60));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода",КонецДня(ТекущаяДата()));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаСКД, Настройки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПараметрДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода");
	ПараметрДанных.Использование = Истина;
	ПараметрДанных.Значение = НачалоГода(НачалоМесяца(ТекущаяДата())-365*24*60*60);
	
	ПараметрДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
	ПараметрДанных.Использование = Истина;
	ПараметрДанных.Значение = КонецДня(ТекущаяДата());
	
	РезультатЗапроса = ПолучитьТаблицуЗначенийИзСКД(СхемаСКД,КомпоновщикНастроек);
	
	
	
	МассивКлючевыхИмен = Новый Массив;
	МассивКлючевыхИмен.Добавить("Day");
	МассивКлючевыхИмен.Добавить("IDOrganization");
	МассивКлючевыхИмен.Добавить("IDCashAccount");

	ВыгрузитьИзмененияТаблицы(РезультатЗапроса, "CashBalance_temp",МассивКлючевыхИмен , , );

	УстановитьАДОДБКоннект();

	
	
КонецПроцедуры

Процедура ВыгрузитьОборотыДДС(Организация)

	Запрос = Новый Запрос();

	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ХозрасчетныйОстаткиИОбороты.Счет.Код = ""301""
	               |				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет.Код = ""302""
	               |			ТОГДА ХозрасчетныйОстаткиИОбороты.Субконто2
	               |		КОГДА ХозрасчетныйОстаткиИОбороты.Счет.Код = ""311""
	               |				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет.Код = ""312""
	               |			ТОГДА ХозрасчетныйОстаткиИОбороты.Субконто1
	               |	КОНЕЦ КАК IDCashAccount,
	               |	ХозрасчетныйОстаткиИОбороты.Счет.Код КАК AccountingAccount,
	               |	ХозрасчетныйОстаткиИОбороты.Организация КАК IDOrganization,
	               |	ХозрасчетныйОстаткиИОбороты.СуммаОборот КАК Amount,
	               |	ХозрасчетныйОстаткиИОбороты.Субконто3 КАК IDDepartment,
	               |	ВЫБОР
	               |		КОГДА ХозрасчетныйОстаткиИОбороты.Счет.Код = ""301""
	               |				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет.Код = ""302""
	               |			ТОГДА ХозрасчетныйОстаткиИОбороты.Субконто1
	               |		КОГДА ХозрасчетныйОстаткиИОбороты.Счет.Код = ""311""
	               |				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет.Код = ""312""
	               |			ТОГДА ХозрасчетныйОстаткиИОбороты.Субконто2
	               |	КОНЕЦ КАК IDCashFlowStatement,
	               |	ХозрасчетныйОстаткиИОбороты.ПериодМесяц КАК Month,
	               |	ХозрасчетныйОстаткиИОбороты.ПериодДень КАК Day,
	               |	ВЫБОР
	               |		КОГДА ХозрасчетныйОстаткиИОбороты.Счет.Код = ""301""
	               |				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет.Код = ""302""
	               |			ТОГДА ХозрасчетныйОстаткиИОбороты.Субконто4
	               |		КОГДА ХозрасчетныйОстаткиИОбороты.Счет.Код = ""311""
	               |				ИЛИ ХозрасчетныйОстаткиИОбороты.Счет.Код = ""312""
	               |			ТОГДА ХозрасчетныйОстаткиИОбороты.Субконто4
	               |	КОНЕЦ КАК IDProject
	               |ПОМЕСТИТЬ ПредИтоги
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			Авто,
	               |			,
	               |			Счет.Код = ""301""
	               |				ИЛИ Счет.Код = ""311""
	               |				ИЛИ Счет.Код = ""302""
	               |				ИЛИ Счет.Код = ""312"",
	               |			,
	               |			Организация = &Организация) КАК ХозрасчетныйОстаткиИОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПредИтоги.IDCashAccount,
	               |	ПредИтоги.AccountingAccount,
	               |	ПредИтоги.IDOrganization,
	               |	ПредИтоги.Amount,
	               |	ПредИтоги.IDDepartment,
	               |	ПредИтоги.IDCashFlowStatement,
	               |	ПредИтоги.Month,
	               |	ПредИтоги.Day,
	               |	ПредИтоги.IDProject
	               |ИЗ
	               |	ПредИтоги КАК ПредИтоги";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(НачалоМесяца(ТекущаяДата())-365*24*60*60));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекущаяДата()));

	Запрос.УстановитьПараметр("Организация",Организация);


	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	МассивКлючевыхИмен = Новый Массив;
	МассивКлючевыхИмен.Добавить("Month");
	МассивКлючевыхИмен.Добавить("Day");
	МассивКлючевыхИмен.Добавить("IDOrganization");
	МассивКлючевыхИмен.Добавить("IDCashAccount");
	МассивКлючевыхИмен.Добавить("IDDepartment");
	МассивКлючевыхИмен.Добавить("IDCashFlowStatement");
	МассивКлючевыхИмен.Добавить("IDProject");

	
	ВыгрузитьИзмененияТаблицы(РезультатЗапроса, "CashFlowTurnover_temp",МассивКлючевыхИмен , , );
	
КонецПроцедуры

Процедура ВыгрузитьСчетаКассы(МассивСнятияРегистрации)

	Запрос = Новый Запрос();

	Запрос.Текст ="ВЫБРАТЬ
	              |	ОбособленныеПодразделенияОрганизацийИзменения.Ссылка.Ссылка КАК IDCashAccount,
	              |	ОбособленныеПодразделенияОрганизацийИзменения.Ссылка.Владелец КАК IDOrganization,
	              |	ОбособленныеПодразделенияОрганизацийИзменения.Ссылка.Наименование КАК Name,
	              |	Кассы.ВалютаДенежныхСредств.Наименование КАК CashCurrency,
	              |	""Cash"" КАК CashAccountType,
	              |	ОбособленныеПодразделенияОрганизацийИзменения.Ссылка КАК СнятиеРегистрации
	              |ИЗ
	              |	Справочник.ОбособленныеПодразделенияОрганизаций.Изменения КАК ОбособленныеПодразделенияОрганизацийИзменения
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кассы КАК Кассы
	              |		ПО ОбособленныеПодразделенияОрганизацийИзменения.Ссылка = Кассы.ОбособленноеПодразделение
	              |ГДЕ
	              |	ОбособленныеПодразделенияОрганизацийИзменения.Узел = &Узел
	              |
	              |ОБЪЕДИНИТЬ ВСЕ
	              |
	              |ВЫБРАТЬ
	              |	БанковскиеСчетаИзменения.Ссылка,
	              |	БанковскиеСчетаИзменения.Ссылка.Владелец,
	              |	БанковскиеСчетаИзменения.Ссылка.Наименование,
	              |	БанковскиеСчетаИзменения.Ссылка.ВалютаДенежныхСредств,
	              |	""Non-cash"",
	              |	БанковскиеСчетаИзменения.Ссылка
	              |ИЗ
	              |	Справочник.БанковскиеСчета.Изменения КАК БанковскиеСчетаИзменения
	              |ГДЕ
	              |	БанковскиеСчетаИзменения.Узел = &Узел";

	Запрос.УстановитьПараметр("Узел", УзелОбменаСPowerBI);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	МассивКлючевыхИмен = Новый Массив;
	МассивКлючевыхИмен.Добавить("IDCashAccount");

	ВыгрузитьИзмененияТаблицы(РезультатЗапроса, "CashAccounts", МассивКлючевыхИмен, ,МассивСнятияРегистрации);

КонецПроцедуры


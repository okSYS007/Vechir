

Функция НайтиКонтрагентаПоUID(ID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления
		|	И Контрагенты.ID = &ID";
	
	Запрос.УстановитьПараметр("ID", ID);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СоздатьКонтрагента(СтрЗаменить(ID, Символы.НПП, ""));
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция НайтиППК(ID, стрПодключения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ППК.Ссылка
		|ИЗ
		|	Справочник.ППК КАК ППК
		|ГДЕ
		|	НЕ ППК.ПометкаУдаления
		|	И ППК.Наименование = &ППК";
	
	Запрос.УстановитьПараметр("ППК", ID);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Контрагент 	= НайтиКонтрагентаПоUID(ID);

		Возврат СоздатьППК(Контрагент,ID,,,стрПодключения);
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
КонецФункции

Функция ПолучитьДоговор(Контрагент) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)";
	
	//Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СоздатьДоговор(Контрагент);
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция НайтиДоговорЭквайринга(Контрагент) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыЭквайринга.Ссылка
		|ИЗ
		|	Справочник.ДоговорыЭквайринга КАК ДоговорыЭквайринга
		|ГДЕ
		|	НЕ ДоговорыЭквайринга.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Эквайрер", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
КонецФункции

Функция СоздатьКонтрагента(ID)
	
	стрПодключения = ПолучитьСтруктуруПодключения();
	
	Соединение = Новый HTTPСоединение(стрПодключения.Сервер, стрПодключения.Порт,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("KEY", стрПодключения.Ключ);	
	
	Запрос = Новый HTTPЗапрос("/api.cgi/users/" + ID + "/pi", Заголовки);
	
	Ответ = Соединение.Получить(Запрос);
	
	Если Ответ.КодСостояния = 200 Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		стрJSON = Ответ.ПолучитьТелоКакСтроку();
		стрJSON = СтрЗаменить(стрJSON,"\", "");
		ЧтениеJSON.УстановитьСтроку(стрJSON);
		Попытка
			СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			ЗаписатьОшибкуЖР("Не удалось прочитать JSON, создание контрагента", 1);
			Сообщить(ОписаниеОшибки());
			СтруктураJSON = Неопределено;
			//Возврат Неопределено;
		КонецПопытки;
		ЧтениеJSON.Закрыть();
		Если ТипЗнч(СтруктураJSON) = Тип("Массив") И СтруктураJSON.Количество() = 0 Тогда
			ЗаписатьОшибкуЖР("Не удалось найти контрагента в ABILLS", 2, "ID = " + ID);
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Сообщить("Код ответа: "+Ответ.КодСостояния); //анализируем код состояния и делаем выводы
		Возврат Неопределено;
	КонецЕсли;
	
	КонтрОб 					= Справочники.Контрагенты.СоздатьЭлемент();
	КонтрОб.Родитель 			= Справочники.Контрагенты.НайтиПоНаименованию("Абоненти");
	КонтрОб.Наименование 		= ?(СтруктураJSON = Неопределено,"Проблемный контрагент "+ ID +" ",СтруктураJSON.fio);
	КонтрОб.НаименованиеПолное 	= ?(СтруктураJSON = Неопределено,"Проблемный контрагент "+ ID +" ",СтруктураJSON.fio); 
	КонтрОб.ID 					= ID;
	КонтрОб.Покупатель			= Истина;
	КонтрОб.ЮрФизЛицо			= Перечисления.ЮрФизЛицо.ФизЛицо;
	КонтрОб.КодПоЕДРПОУ         = ?(СтруктураJSON = Неопределено,"Проблемный контрагент "+ ID +" ",СтруктураJSON.edrpou);
	Попытка
		КонтрОб.Записать();
	Исключение
		ЗаписатьОшибкуЖР("Не удалось записать контрагента в базу 1с" , 1 , ID);
		Возврат Неопределено;	
	КонецПопытки;
	
	Договор = ПолучитьДоговор(КонтрОб.Ссылка);
	Если Договор = Неопределено Тогда
		Договор = СоздатьДоговор(КонтрОб.Ссылка);
	КонецЕсли;
	
	Если Договор = Неопределено Тогда
		ЗаписатьОшибкуЖР("Не удалось записать договор контрагента в базу 1с" , 1 , ID);
		Возврат КонтрОб.Ссылка;
	КонецЕсли;
		
	Попытка
		КонтрОб.Записать();
	Исключение
		ЗаписатьОшибкуЖР("Не удалось записать контрагента в базу 1с" , 1 , ID);
	КонецПопытки;
	
	Возврат КонтрОб.Ссылка;
	
КонецФункции

Функция СоздатьДоговор(Контрагент)
	
	ДоговорОб 						= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	ДоговорОб.ВидДоговора 			= Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	ДоговорОб.Наименование 			= Контрагент.ID;
	ДоговорОб.Номер 				= Контрагент.ID;
	ДоговорОб.Владелец 				= Контрагент;
	ДоговорОб.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
	ДоговорОб.ВалютаВзаиморасчетов 	= глЗначениеПеременной("ВалютаРегламентированногоУчета");
	ДоговорОб.Организация 			= Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9"));
	ДоговорОб.ВидУсловийДоговора 	= Перечисления.ВидыУсловийДоговоровВзаиморасчетов.БезДополнительныхУсловий;
	ДоговорОб.ТипЦен 				= Справочники.ТипыЦенНоменклатуры.ПустаяСсылка();
	ДоговорОб.ВыводитьИнформациюОСделкеПриПечатиДокументов = Истина;
	ДоговорОб.УстановитьСхемуНалогообложения();
	
	ДоговорОб.ВидДоговораПоГК 	= Справочники.ВидыДоговоровПоГК.Поставка;
	ДоговорОб.ФормаРасчетов 	= "Оплата з поточного рахунку";
	
	Попытка
		ДоговорОб.Записать();
		Возврат ДоговорОб.Ссылка;
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;	
	КонецПопытки;
	
КонецФункции

Функция СоздатьППК(Контрагент, ID, Договор = Неопределено, Адрес = "", СтрПодключения)
		
	СоединениеППК = Новый HTTPСоединение(СтрПодключения.Сервер, СтрПодключения.Порт,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("KEY", стрПодключения.Ключ);	
	
	Запрос = Новый HTTPЗапрос("/api.cgi/users/" + ID, Заголовки);
	
	Ответ = СоединениеППК.Получить(Запрос);
	
	Если Ответ.КодСостояния = 200 Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
		СтруктураJSONППК = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Если ТипЗнч(СтруктураJSONППК) = Тип("Массив") И СтруктураJSONППК.Количество() = 0 Тогда
			ЗаписатьОшибкуЖР("Не удалось найти контрагента в ABILLS", 2, "ID = " + ID);
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ЗаписатьОшибкуЖР("Не удалось подключиться к users/ID ; код ошибки " + Ответ.КодСостояния , 1 ,  ID = "");
		Возврат Неопределено;
	КонецЕсли;
	
	ППКОБ 					= Справочники.ППК.СоздатьЭлемент();
	ППКОБ.Код 				= ID;
	ППКОБ.Наименование 		= ID;
	ППКОБ.СпособОтправки 	= Перечисления.vr_СпособОтправки.Почта;
	ППКОБ.Контрагент 		= Контрагент;
	ППКОБ.Владелец 			= ?(Договор = Неопределено, ПолучитьДоговор(Контрагент), Договор);
	ППКОБ.UID_Билинг 		= ID;
	ППКОБ.billId 			= СтрЗаменить(Строка(СтруктураJSONППК.billId), Символы.НПП, "");
	ППКОБ.Адрес 			= Адрес;
	ППКОБ.Тариф 			= Справочники.Тарифы.НайтиПоКоду("000000001");
	ППКОБ.Активный			= Истина;
	
	Попытка
		ППКОБ.Записать();
		Возврат ППКОБ.Ссылка;
	Исключение
		ЗаписатьОшибкуЖР("Не удалось записать ППК ", 1 , ID + " ошибка " +ОписаниеОшибки());
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьСтруктуруПодключения() Экспорт 
	
	стрПодключения = Новый Структура;
	стрПодключения.Вставить("Ключ");
	стрПодключения.Вставить("Сервер");
	стрПодключения.Вставить("Порт");
	стрПодключения.Вставить("Настройка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиПодключенияКБилингуДанныеЭквайрера.Ссылка.АдресRestAPI КАК Сервер,
		|	НастройкиПодключенияКБилингуДанныеЭквайрера.Ссылка.APIKey КАК Ключ,
		|	НастройкиПодключенияКБилингуДанныеЭквайрера.Ссылка.ПортRestAPI КАК Порт,
		|	НастройкиПодключенияКБилингуДанныеЭквайрера.Ссылка КАК Настройка
		|ИЗ
		|	Справочник.НастройкиПодключенияКБилингу.ДанныеЭквайрера КАК НастройкиПодключенияКБилингуДанныеЭквайрера
		|ГДЕ
		|	НастройкиПодключенияКБилингуДанныеЭквайрера.Ссылка.Логин = &Логин";
	
	Запрос.УстановитьПараметр("Логин", "i.novash");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(стрПодключения, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	Возврат стрПодключения;
	
КонецФункции

Процедура ПолучениеПлатежейРегламент() Экспорт
	
	тчПлатежки.Очистить();
	тчСписания.Очистить();
	
	стрПодключения = ПолучитьСтруктуруПодключения();	
	
	ПолучитьОплаты(стрПодключения); 
	//ПолучитьСписания(стрПодключения);
	
КонецПроцедуры

Процедура ПолучитьОплаты(стрПодключения) Экспорт 
	КолвоЗаписейНаСтранице = "1000";
	НомерСтраницы 		   = 0;
	сч            		   = 1;
	
	Пока Истина Цикл
		
		ТаблицаДанныхОплаты = ПолучитьМассивДанныхПоОплате(НомерСтраницы,стрПодключения,КолвоЗаписейНаСтранице);
	
		Если ТаблицаДанныхОплаты.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
	
		Для Каждого стрПлатеж из ТаблицаДанныхОплаты Цикл
			
			Если стрПлатеж.innerDescribe = "Easypay_vechir" Тогда
				
				ДатаПлатежа = Дата(Лев(СтрЗаменить(стрПлатеж.regDate, "-", ""), 8) +СтрЗаменить(Прав(стрПлатеж.regDate, 8), ":", ""));
				
				//Если КонецДня(ДатаПлатежа) >= НачалоДня(ТекущаяДата()) Тогда
				//	Продолжить;
				//КонецЕсли;
				//
				ID 			= СтрЗаменить(Строка(стрПлатеж.uid),Символы.НПП, "");					
				ППК 		= НайтиППК(ID, стрПодключения);
				
				НовСтр 						= тчПлатежки.Добавить();
				НовСтр.СуммаОплаты 			= стрПлатеж.sum;
				НовСтр.ДатаПлатежки 		= ДатаПлатежа;
				НовСтр.ППК					= ППК;
				НовСтр.Контрагент 			= ППК.Контрагент;
				НовСтр.ДоговорКонтрагента 	= ПолучитьДоговорПоОрганизации(Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")),ППК.Наименование,ППК.Контрагент);
				НовСтр.Метод				= НайтиСодатьМетод(стрПлатеж.Method);
				НовСтр.ДоговорЭквайринга 	= стрПодключения.Настройка.ДанныеЭквайрера.Найти("Easypay_vechir","slug").ДоговорЭквайринга;
				НовСтр.Организация			= НовСтр.ДоговорЭквайринга.ДоговорВзаиморасчетов.Организация;
				НовСтр.Эквайрер 			= НовСтр.ДоговорЭквайринга.Эквайрер;
				НовСтр.ID					= СтрЗаменить(стрПлатеж.ID,Символы.НПП,"");	
			Иначе
				
				ДатаПлатежа = Дата(Лев(СтрЗаменить(стрПлатеж.regDate, "-", ""), 8) +СтрЗаменить(Прав(стрПлатеж.regDate, 8), ":", ""));
				
				//Если КонецДня(ДатаПлатежа) >= НачалоДня(ТекущаяДата()) Тогда
				//	Продолжить;
				//КонецЕсли;
				
				ID 			= СтрЗаменить(Строка(стрПлатеж.uid),Символы.НПП, "");
				ППК 		= НайтиППК(ID, стрПодключения);
				
				НовСтр 						= тчПлатежки.Добавить();
				НовСтр.СуммаОплаты 			= стрПлатеж.sum;
				НовСтр.ДатаПлатежки 		= ДатаПлатежа;
				НовСтр.ППК					= ППК;
				НовСтр.Контрагент 			= ППК.Контрагент;
				НовСтр.ДоговорКонтрагента 	= ПолучитьДоговорПоОрганизации(Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")),ППК.Наименование,ППК.Контрагент);
				НовСтр.Метод				= НайтиСодатьМетод(стрПлатеж.Method);
				НовСтр.ДоговорЭквайринга 	= стрПодключения.Настройка.ДанныеЭквайрера.Найти("","slug").ДоговорЭквайринга;;
				НовСтр.Организация			= НовСтр.ДоговорЭквайринга.ДоговорВзаиморасчетов.Организация;
				НовСтр.Эквайрер 			= НовСтр.ДоговорЭквайринга.Эквайрер;
				НовСтр.ID					= СтрЗаменить(стрПлатеж.ID,Символы.НПП,"");					
			КонецЕсли;
			
			сч = сч + 1;
		КонецЦикла;
		
		НомерСтраницы = Число(НомерСтраницы) + Число(КолвоЗаписейНаСтранице);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьСписания(стрПодключения) Экспорт 
	//
	//МетодыСписания = ПолучитьМедотыСписания();

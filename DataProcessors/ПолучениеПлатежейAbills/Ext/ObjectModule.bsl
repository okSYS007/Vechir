Функция ПолучитьМедотыСписания() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиПодключенияКБилингуСоответвиеМетодовИНоменклатуры.Метод,
		|	НастройкиПодключенияКБилингуСоответвиеМетодовИНоменклатуры.Номенклатура
		|ИЗ
		|	Справочник.НастройкиПодключенияКБилингу.СоответвиеМетодовИНоменклатуры КАК НастройкиПодключенияКБилингуСоответвиеМетодовИНоменклатуры
		|ГДЕ
		|	НастройкиПодключенияКБилингуСоответвиеМетодовИНоменклатуры.Ссылка.Логин = &Логин";
	
	Запрос.УстановитьПараметр("Логин", "i.novash");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Процедура СоздатьСводнуюОплату(Организация) Экспорт 
	
	Если тчПлатежки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СводнаяОплата.Ссылка
	               |ИЗ
	               |	Документ.СводнаяОплата КАК СводнаяОплата
	               |ГДЕ
	               |	СводнаяОплата.Дата МЕЖДУ &Дата1 И &Дата2";
	Запрос.УстановитьПараметр("Дата1",НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Дата2",КонецДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество()=0 Тогда 
		
		ДокОб 				= Документы.СводнаяОплата.СоздатьДокумент();
		////ДокОб.Организация 	= Организация;
		ДокОб.Дата 			= ТекущаяДата();
	Иначе
		ДокОб = РезультатЗапроса[0].Ссылка.ПолучитьОбъект();
		
	КонецЕсли;

	Для Каждого стрПлатеж из тчПлатежки Цикл
		Если ДокОб.тчДанные.НайтиСтроки(Новый структура("ID",стрПлатеж.ID)).Количество()=0 тогда
			СтрокаПлатежи = ДокОб.тчДанные.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаПлатежи, стрПлатеж);
			СтрокаПлатежи.ТипОплаты = стрПлатеж.Метод; 
		КонецЕсли;
	КонецЦикла;
	
	ДокОб.Записать();
	
	ДокОб.СоздатьОплату(флОбменДанными);
	
КонецПроцедуры

Процедура СоздатьСводноеНачисление(Организация) Экспорт 
	
	ДокОб 				= Документы.СводноеНачисление.СоздатьДокумент();
	ДокОб.Организация 	= Организация;
	ДокОб.Дата 			= ТекущаяДата();
	
	Для Каждого стрПлатеж из тчСписания Цикл
		ЗаполнитьЗначенияСвойств(ДокОб.тчДанные.Добавить(), стрПлатеж);		
	КонецЦикла;
	
	ДокОб.Записать();
	
	ДокОб.СоздатьНачисления(Организация, флОбменДанными);
	
КонецПроцедуры

Процедура ЗаписатьОшибкуЖР(Ошибка, Статус, ДопИнфа = Неопределено) Экспорт
	
	Если ДопИнфа <> Неопределено Тогда
		Ошибка = Ошибка + "----" + ДопИнфа
	КонецЕсли;
	
	Если Статус = 1 Тогда
		УровеньЖР = УровеньЖурналаРегистрации.Ошибка; 
	Иначе
		УровеньЖР = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Получение платежей ABILLS", УровеньЖР,,, Ошибка);
	
КонецПроцедуры

Функция ПолучитьМассивДанныхПоОплате(НомерСтраницы,стрПодключения,КолвоЗаписейНаСтранице)
	
		Соединение = Новый HTTPСоединение(стрПодключения.Сервер, стрПодключения.Порт,,,,,Новый ЗащищенноеСоединениеOpenSSL());
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("KEY", стрПодключения.Ключ);	
			
		ДатаНач 				= Формат(Дата(ТекущаяДата()), "ДФ=yyyy-MM-dd"); //вчерашний день
		ДатаКон 				= Формат(Дата(ТекущаяДата()), "ДФ=yyyy-MM-dd");//вчерашний день
		
		Если ЗначениеЗаполнено(ДатаС) Тогда
			ДатаНач = Формат(ДатаС, "ДФ=yyyy-MM-dd");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаПО) Тогда
			ДатаКон = Формат(ДатаПо, "ДФ=yyyy-MM-dd");	
		КонецЕсли;
		
		НомерСтраницы 			= СтрЗаменить(Строка(НомерСтраницы), Символы.НПП, "");
		
		
		Запрос = Новый HTTPЗапрос("/api.cgi/payments?fromDate="+ДатаНач + "&toDate=" + ДатаКон  
		+"&pageRows=" + КолвоЗаписейНаСтранице 
		//+"&method=" + Метод
		+"&pg=" + НомерСтраницы, Заголовки);
		
		Ответ = Соединение.Получить(Запрос);
		Если Ответ.КодСостояния = 200 Тогда
			ЧтениеJSON 	= Новый ЧтениеJSON;
			стрJSON 	= Ответ.ПолучитьТелоКакСтроку();
			ЧтениеJSON.УстановитьСтроку(стрJSON);
			Попытка
				СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);
			Исключение
				ЗаписатьОшибкуЖР("Не прочитать json", 1, стрJSON);
				Сообщить("Код ответа: "+Ответ.КодСостояния); //анализируем код состояния и делаем выводы
				ЧтениеJSON.Закрыть();
			КонецПопытки;
			ЧтениеJSON.Закрыть();
			Возврат СтруктураJSON; 
		Иначе
			ЗаписатьОшибкуЖР("Не удалось подключиться к методу payments", 1);
			Сообщить("Код ответа: "+Ответ.КодСостояния); //анализируем код состояния и делаем выводы
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		
	
	
	КонецФункции
	
Функция НайтиСодатьМетод(НомерМетода)
	
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	AbillsСписокТиповОплат.Ссылка
	               |ИЗ
	               |	Справочник.AbillsСписокТиповОплат КАК AbillsСписокТиповОплат
	               |ГДЕ
	               |	AbillsСписокТиповОплат.КодAbills = &КодAbills";
	Запрос.УстановитьПараметр("КодAbills",НомерМетода);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		
		Возврат РезультатЗапроса[0].Ссылка;
		
	Иначе
		
		Элемент = Справочники.AbillsСписокТиповОплат.СоздатьЭлемент();
		Элемент.Наименование = НомерМетода;
		Элемент.КодAbills    = НомерМетода;
		Элемент.Записать();
		
		Возврат Элемент.Ссылка;
		
	КонецЕсли;
	
	
	
КонецФункции

Функция ПолучитьДоговорПоОрганизации(Организация,НомерППК,Контрагент)
	
	Запрос = новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ДоговорыКонтрагентов.Ссылка
	                |ИЗ
	                |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	                |ГДЕ
	                |	ДоговорыКонтрагентов.Владелец = &Владелец
	                |	И ДоговорыКонтрагентов.Организация = &Организация
	                |	И ДоговорыКонтрагентов.Наименование = &Наименование
	                |	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)" ;
	Запрос.УстановитьПараметр("Владелец",Контрагент);
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Наименование",НомерППК);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Возврат РезультатЗапроса[0].Ссылка;
	Иначе
		Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Договор.Наименование 		  = НомерППК;
		Договор.ВидДоговора			  = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		Договор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
		Договор.Организация			  = Организация;
		Договор.Владелец			  = Контрагент;
		Договор.Номер				  = НомерППК;
		Договор.ВалютаВзаиморасчетов  = Константы.ВалютаРегламентированногоУчета.Получить();
		Договор.СхемаНалоговогоУчета = Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ПоПервомуСобытию;
		Договор.Записать();
		Возврат Договор.Ссылка;
		
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции
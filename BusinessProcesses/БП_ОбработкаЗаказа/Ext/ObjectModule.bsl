		задача.складВыдачи   = МассивСкладов[0];
		Задача.Подразделение = МассивСкладов[0].Подразделение; 
		Задача.типЗадачи     = Перечисления.БП_ТипыЗадач.ОтправитьТовар;
		задача.Заказпокупателя = ЗаказПокупателя;
	КонецЦикла;
	
	РезультатЗапроса.Свернуть("АдресДоставки,Номенклатура,ХарактеристикаНоменклатуры,Цена","Количество");
	Для каждого АдресДоствкаСтр из РезультатЗапроса цикл
		ДокументДоставки = Документы.УД_Доставка.СоздатьДокумент();
		ДокументДоставки.Дата = ТекущаяДата();
		ДокументДоставки.ПаспортныеДанныеПолучателя = АдресДоствкаСтр.АдресДоставки.ПаспортныеДанныеПолучателя;
		ДокументДоставки.АдресДоставки = АдресДоствкаСтр.АдресДоставки.АдресДоставки;
		ДокументДоставки.Получатель    = АдресДоствкаСтр.АдресДоставки.Получатель;
		ДокументДоставки.Телефон       = АдресДоствкаСтр.АдресДоставки.Телефон;
		ДокументДоставки.ИНН   		   = АдресДоствкаСтр.АдресДоставки.ИНН;
		ДокументДоставки.ТипПеревозки  = АдресДоствкаСтр.АдресДоставки.ТипПеревозки;
		ДокументДоставки.ТранспортнаяКомпания = АдресДоствкаСтр.АдресДоставки.ТранспортнаяКомпания;
		ДокументДоставки.ОплатаДоставки       = АдресДоствкаСтр.АдресДоставки.ОплатаДоставки;
		ДокументДоставки.ОфисСдекОправителя  =  АдресДоствкаСтр.АдресДоставки.ОфисОтправителя;
		ДокументДоставки.ОфисСдекПолучателя  =  АдресДоствкаСтр.АдресДоставки.ОфисПолучателя;
		
		НовСтрока = ДокументДоставки.ТоварыТК.Добавить();
		НовСтрока.Номенклатура = АдресДоствкаСтр.Номенклатура;
		НовСтрока.ХарактеристикаНоменклатуры = АдресДоствкаСтр.ХарактеристикаНоменклатуры;
		НовСтрока.Количество =  АдресДоствкаСтр.Количество;
		НовСтрока.Цена   =    АдресДоствкаСтр.Цена;
		ДокументДоставки.ДокументОснование = ЭтотОбъект.ЗаказПокупателя;
		ДокументДоставки.Записать(РежимЗаписиДокумента.Проведение);
		
		
		Отбор = новый Структура("АдресДоставки",АдресДоствкаСтр.АдресДоставки);
		Строки = задача.ТоварыКВыдачеКлиенту.НайтиСтроки(Отбор);
		Для каждого строкаТоварыКВыдачи из Строки Цикл 
			строкаТоварыКВыдачи.ДокументДоставки = ДокументДоставки.Ссылка;
			строкаТоварыКВыдачи.ТК = ДокументДоставки.ТранспортнаяКомпания;
		КонецЦикла;


	КонецЦикла;


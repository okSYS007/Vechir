Процедура ЗавершитьДочерниеБизнесПроцессыОбработка(ТочкаМаршрутаБизнесПроцесса)
	ЗапросПоДочернимБП = новый запрос;
	ЗапросПоДочернимБП.Текст = "ВЫБРАТЬ
	                           |	БП_ОбработкаСтрокиЗаказа.Ссылка
	                           |ИЗ
	                           |	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	                           |ГДЕ
	                           |	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес = &РодительскийБизнесПроцес";
	ЗапросПоДочернимБП.УстановитьПараметр("РодительскийБизнесПроцес",ЭтотОбъект.Ссылка);
	РезультатЗапроса = ЗапросПоДочернимБП.Выполнить().Выгрузить();
	Для каждого бп из РезультатЗапроса цикл
		БпОб 		  			= Бп.Ссылка.получитьОбъект();
		БпОб.Завершен 		    = истина;
		БПОб.СтатусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.ГотовКОтгрузке;
		БПОб.Записать();
	КонецЦикла;
	
	ЭтотОбъект.СтатусЗаказа = Перечисления.БП_СтатусыЗаказов.ГотовКОтгрузке;
	ЭтотОбъект.Записать();


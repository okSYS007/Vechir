Функция ДелатьИзНеРазборногоКомплекта(ХарактеристикаНоменклатуры)

	ВозвращаемоеЗначение = Ложь;
	
	
	Если ЗначениеЗаполнено(ХарактеристикаНоменклатуры) Тогда 
		
		Запрос = новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Объект = &Объект
		|	И ЗначенияСвойствОбъектов.Свойство = &Свойство";
		Запрос.УстановитьПараметр("Объект",ХарактеристикаНоменклатуры);
		Запрос.УстановитьПараметр("Свойство",ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("3.Вид комплекта"));
		
		РезультатЗапроса = запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество() Тогда 
			Если РезультатЗапроса[0].Значение = Перечисления.зетаБУВидыКомплектов.НеразборныйКомплект Тогда 
				
				ЗапросПоВидуКомплектации = Новый запрос;
				ЗапросПоВидуКомплектации.Текст = "ВЫБРАТЬ
				                                 |	ЗначенияСвойствОбъектов.Значение
				                                 |ИЗ
				                                 |	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
				                                 |ГДЕ
				                                 |	ЗначенияСвойствОбъектов.Объект = &Объект
				                                 |	И ЗначенияСвойствОбъектов.Свойство = &Свойство";
				ЗапросПоВидуКомплектации.УстановитьПараметр("Объект",ХарактеристикаНоменклатуры);
				ЗапросПоВидуКомплектации.УстановитьПараметр("Свойство",ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("4.Вид комплектации"));
				РезультатЗапроса = ЗапросПоВидуКомплектации.Выполнить().Выгрузить();
		
				Если РезультатЗапроса.Количество() Тогда
					Значение = РезультатЗапроса[0].Значение;
					
					Если Значение = Перечисления.зетаБУВидыКомплектации.НеосновнаяЧастьКомплекта 
						или Значение = Перечисления.зетаБУВидыКомплектации.ОсновнаяЧастьКомплекта Тогда 
						ВозвращаемоеЗначение = Истина;
	
					КонецЕсли;
				КонецЕсли;						 
				
				
			Иначе
				ВозвращаемоеЗначение = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


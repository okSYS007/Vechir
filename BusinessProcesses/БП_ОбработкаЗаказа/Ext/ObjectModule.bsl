				ЭтотОбъект.Записать();
			КонецЕсли;
		Иначе
			ЭтотОбъект.СтатусЗаказа = Перечисления.БП_СтатусыЗаказов.ЕстьПроблемныеПозиции;
			ЭтотОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
	


Процедура СтартПередСтартом(ТочкаМаршрутаБизнесПроцесса, Отказ)
	//Проверить есть ли другой бизнес процес по этому заказу
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БП_ОбработкаЗаказа.Ссылка
	               |ИЗ
	               |	БизнесПроцесс.БП_ОбработкаЗаказа КАК БП_ОбработкаЗаказа
	               |ГДЕ
	               |	БП_ОбработкаЗаказа.ЗаказПокупателя = &ЗаказПокупателя
	               |	И БП_ОбработкаЗаказа.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаказОплаченНаСайтеПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОплатаОтПокупателяПлатежнойКартой.Ссылка,
	               |	ОплатаОтПокупателяПлатежнойКартой.СуммаДокумента
	               |ИЗ
	               |	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
	               |ГДЕ
	               |	ОплатаОтПокупателяПлатежнойКартой.ДокументОснование = &Заказ";
	Запрос.УстановитьПараметр("Заказ",ЭтотОбъект.ЗаказПокупателя);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество()>0 Тогда 
		Результат = Истина;	
	Иначе 	
		Результат = Ложь;
	КонецЕсли;
	

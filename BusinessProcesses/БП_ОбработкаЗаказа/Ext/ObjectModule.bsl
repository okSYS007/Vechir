Процедура КоличествоСкладовКонсолидацииОбработкаВыбораВарианта(ТочкаВыбораВарианта, Результат)
	КоличествоСкладов = 0;
	
	Результат = ТочкаВыбораВарианта.Варианты.ОдинСклад;
	
	ЗапросПоКоличествуСкладов = новый Запрос;
	ЗапросПоКоличествуСкладов.Текст = "ВЫБРАТЬ
	                                  |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ БП_ОбработкаСтрокиЗаказа.СкладВыдачи) КАК КоличествоСкладов
	                                  |ИЗ
	                                  |	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	                                  |ГДЕ
	                                  |	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес.ЗаказПокупателя = &Ссылка
	                                  |	И БП_ОбработкаСтрокиЗаказа.СтатусСтрокиЗаказа = ЗНАЧЕНИЕ(Перечисление.БП_СтатусыСтрокЗазака.ГотовКОтгрузке)
	                                  |	И БП_ОбработкаСтрокиЗаказа.СпособДоставки <> ЗНАЧЕНИЕ(Перечисление.БП_СпособыДоставки.Самовывоз)";
	ЗапросПоКоличествуСкладов.УстановитьПараметр("Ссылка",ЭтотОбъект.Ссылка.ЗаказПокупателя);
	
	РезультатЗапроса = ЗапросПоКоличествуСкладов.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество()>0 Тогда 
		КоличествоСкладов = РезультатЗапроса[0].КоличествоСкладов;
	КонецЕсли;
	
	Если КоличествоСкладов = 1 Тогда 
		Результат = ТочкаВыбораВарианта.Варианты.ОдинСклад;
	ИначеЕсли КоличествоСкладов = 2 Тогда
		Результат = ТочкаВыбораВарианта.Варианты.ДваСклада;
	ИначеЕсли КоличествоСкладов = 3 Тогда 
		Результат = ТочкаВыбораВарианта.Варианты.ТриСклада;
	ИначеЕсли КоличествоСкладов = 4 Тогда 
		Результат = ТочкаВыбораВарианта.Варианты.ЧетыреСклада;
	ИначеЕсли КоличествоСкладов = 5 Тогда 
		Результат = ТочкаВыбораВарианта.Варианты.ПятьСкладов;
	
	Иначе

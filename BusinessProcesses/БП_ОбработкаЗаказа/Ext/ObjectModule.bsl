Процедура Действие23ПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	ЗапросПоСкладам = новый Запрос;
	ЗапросПоСкладам.Текст = "ВЫБРАТЬ
	                        |	БП_ОбработкаСтрокиЗаказа.СкладВыдачи КАК Склад
	                        |ИЗ
	                        |	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	                        |ГДЕ
	                        |	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес.Ссылка = &Ссылка
	                        |	И БП_ОбработкаСтрокиЗаказа.СтатусСтрокиЗаказа = &СтатусСтрокиЗаказа
	                        |	И БП_ОбработкаСтрокиЗаказа.СпособДоставки = ЗНАЧЕНИЕ(перечисление.БП_СпособыДоставки.ДоставкаКлиенту)
	                        |
	                        |СГРУППИРОВАТЬ ПО
	                        |	БП_ОбработкаСтрокиЗаказа.СкладВыдачи";
	ЗапросПоСкладам.УстановитьПараметр("Ссылка",ЭтотОбъект.Ссылка);
	ЗапросПоСкладам.УстановитьПараметр("СтатусСтрокиЗаказа",Перечисления.БП_СтатусыСтрокЗазака.ГотовКОтгрузке);
	
	МассивСкладов = ЗапросПоСкладам.Выполнить().Выгрузить().ВыгрузитьКолонку("склад");
	
	
	Запрос = новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	БП_ОбработкаСтрокиЗаказа.Номенклатура,
	                |	БП_ОбработкаСтрокиЗаказа.ХарактеристикаНоменклатуры,
	                |	БП_ОбработкаСтрокиЗаказа.Количество,
	                |	БП_ОбработкаСтрокиЗаказа.Цена,
	                |	БП_ОбработкаСтрокиЗаказа.АдресДоставки,
	                |	БП_ОбработкаСтрокиЗаказа.СпособДоставки,
	                |	БП_ОбработкаСтрокиЗаказа.СкладВыдачи
	                |ИЗ
	                |	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	                |ГДЕ
	                |	БП_ОбработкаСтрокиЗаказа.СкладВыдачи = &СкладВыдачи
	                |	И БП_ОбработкаСтрокиЗаказа.СтатусСтрокиЗаказа = &СтатусСтрокиЗаказа
	                |	И БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес.Ссылка = &Ссылка
	                |	И БП_ОбработкаСтрокиЗаказа.СпособДоставки В(&СпособДоставки)";
	Запрос.УстановитьПараметр("СкладВыдачи",МассивСкладов[3]);
	Запрос.УстановитьПараметр("СтатусСтрокиЗаказа",Перечисления.БП_СтатусыСтрокЗазака.ГотовКОтгрузке);
	Запрос.УстановитьПараметр("Ссылка",ЭтотОбъект.Ссылка);

	
	МассивСпособовДоствки = новый Массив;
	МассивСпособовДоствки.Добавить(Перечисления.БП_СпособыДоставки.ДоставкаКлиенту);
	Запрос.УстановитьПараметр("СпособДоставки",МассивСпособовДоствки);
	
	РезультатЗапроса =Запрос.Выполнить().Выгрузить();
		
	Для каждого задача из ФормируемыеЗадачи Цикл 
		задача.ТоварыКВыдачеКлиенту.загрузить(РезультатЗапроса);
		задача.складВыдачи   = МассивСкладов[3];
		Задача.Подразделение = МассивСкладов[3].Подразделение; 
		Задача.типЗадачи     = Перечисления.БП_ТипыЗадач.ОтправитьТовар;
		задача.Заказпокупателя = ЗаказПокупателя;
	КонецЦикла;
	
	РезультатЗапроса.Свернуть("АдресДоставки");
	Для каждого АдресДоствкаСтр из РезультатЗапроса цикл
		ДокументДоставки = Документы.УД_Доставка.СоздатьДокумент();
		ДокументДоставки.Дата = ТекущаяДата();
		ДокументДоставки.ПаспортныеДанныеПолучателя =АдресДоствкаСтр.АдресДоставки.ПаспортныеДанныеПолучателя;
		ДокументДоставки.АдресДоставки = АдресДоствкаСтр.АдресДоставки.АдресДоставки;
		ДокументДоставки.Получатель    = АдресДоствкаСтр.АдресДоставки.Получатель;
		ДокументДоставки.Телефон       = АдресДоствкаСтр.АдресДоставки.Телефон;
		ДокументДоставки.ИНН   		   = АдресДоствкаСтр.АдресДоставки.ИНН;
		ДокументДоставки.ТипПеревозки  = АдресДоствкаСтр.АдресДоставки.ТипПеревозки;
		ДокументДоставки.ТранспортнаяКомпания = АдресДоствкаСтр.АдресДоставки.ТранспортнаяКомпания;
		ДокументДоставки.ОплатаДоставки= АдресДоствкаСтр.АдресДоставки.ОплатаДоставки;
		ДокументДоставки.ДокументОснование = ЭтотОбъект.ЗаказПокупателя;
		ДокументДоставки.Записать(РежимЗаписиДокумента.Проведение);
		
		
		Отбор = новый Структура("АдресДоставки",АдресДоствкаСтр.АдресДоставки);
		Строки = задача.ТоварыКВыдачеКлиенту.НайтиСтроки(Отбор);
		Для каждого строкаТоварыКВыдачи из Строки Цикл 
			строкаТоварыКВыдачи.ДокументДоставки = ДокументДоставки.Ссылка;
			строкаТоварыКВыдачи.ТК = ДокументДоставки.ТранспортнаяКомпания;
		КонецЦикла;


	КонецЦикла;

КонецПроцедуры


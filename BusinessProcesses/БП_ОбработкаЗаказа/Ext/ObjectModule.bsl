Процедура ОтправитьСМСЗарегистрированаОплатаОбработка(ТочкаМаршрутаБизнесПроцесса)
	
	Контрагент  = ЗаказПокупателя.Контрагент;
	НомерТелефона = ry_ОбщиеПроцедуры.ПолучитьНомерТелефонаКонтрагента(ЗаказПокупателя.Контрагент);

	Попытка
		ОправитьСМС = Константы.БП_ИспользуемыйSMSШлюз.Получить().ПолучитьОбъект().отправитьСМС("По заказу " + ?(ЗначениеЗаполнено(ЗаказПокупателя.СайтНомер),ЗаказПокупателя.СайтНомер,ЗаказПокупателя.Номер)+" зарегистрированна оплата.", НомерТелефона);
		
	Исключение	
	КонецПопытки;
	
	Менеджер = РегистрыСведений.ЛегендаЗаказа.СоздатьМенеджерЗаписи();
	Менеджер.Активность = Истина;
	Менеджер.Период = ТекущаяДата();
	Менеджер.ЗаказПокупателя = ЗаказПокупателя;
	Менеджер.СодержаниеСобытия = "Отправленно SMS : По заказу " + ?(ЗначениеЗаполнено(ЗаказПокупателя.СайтНомер),ЗаказПокупателя.СайтНомер,ЗаказПокупателя.Номер)+" зарегистрированна оплата.";
	Менеджер.ТипСобытия = Перечисления.БП_ТипыСобытий.sms;
	Менеджер.Ответственный = Справочники.Пользователи.Система;
	Менеджер.Статус = СтатусЗаказа;
	Менеджер.СсылкаНаОбъект = "Отправленно SMS : По заказу " + ?(ЗначениеЗаполнено(ЗаказПокупателя.СайтНомер),ЗаказПокупателя.СайтНомер,ЗаказПокупателя.Номер)+" зарегистрированна оплата.";

	

	Менеджер.Записать();

КонецПроцедуры


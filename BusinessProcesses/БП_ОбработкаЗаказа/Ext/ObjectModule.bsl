	                                         |	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес = &РодительскийБизнесПроцес
	                                         |
	                                         |СГРУППИРОВАТЬ ПО
	                                         |	БП_ОбработкаСтрокиЗаказа.СтатусСтрокиЗаказа";
	ЗапросПоСтатусамПодчиненныхЗадач.УстановитьПараметр("РодительскийБизнесПроцес",ЭтотОбъект.Ссылка);
	РезультатЗапроса = ЗапросПоСтатусамПодчиненныхЗадач.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество()>0 Тогда 
		Если РезультатЗапроса.Количество()=1 Тогда 
			Если РезультатЗапроса[0].СтатусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.ГотовКОтгрузке Тогда 
				ЭтотОбъект.СтатусЗаказа = Перечисления.БП_СтатусыЗаказов.ГотовКОтгрузке;
				ЭтотОбъект.Записать();
			ИначеЕсли РезультатЗапроса[0].СтатусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.ОтказСклада или РезультатЗапроса[0].СтатусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.ОтказПоставщика Тогда 

Процедура СоздатьДокументРезервированиеТовараОбработка(ТочкаМаршрутаБизнесПроцесса)
	Попытка
		Если ТипЗнч(РодительскийБизнесПроцес) = Тип("БизнесПроцессСсылка.БП_ОбработкаСтрокиЗаказа") 
			и ЗначениеЗаполнено(РодительскийБизнесПроцес) 
			и не РодительскийБизнесПроцес.Завершен Тогда 
			Документ = Документы.РезервированиеТоваров.СоздатьДокумент();
			Документ.ВидОперации = Перечисления.ВидыОперацийРезервированиеТоваров.ПоСкладамИЗаказам;
			Документ.Дата  = ТекущаяДата()+1;
			Документ.Заказ = ЗаказПокупателя;
			Строка = Документ.Товары.Добавить();
			Строка.ЕдиницаИзмерения = Номенклатура.ЕдиницаХраненияОстатков;
			Строка.Количество = Количество;
			Строка.Коэффициент = 1;
			Строка.Номенклатура = Номенклатура;
			Строка.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
			Строка.ИсходноеРазмещение = ПолучитьРезервТовара(Номенклатура,ХарактеристикаНоменклатуры,ЗаказПокупателя);
			Строка.НовоеРазмещение = СкладВыдачи;
			Документ.Комментарий = "Созанно бизнесс процессов " + Номер;
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьРезервТовара(Номенклатура,ХарактеристикаНоменклатуры,ЗаказПокупателя)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыВРезервеНаСкладахОстатки.Склад
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
	               |ГДЕ
	               |	ТоварыВРезервеНаСкладахОстатки.Номенклатура = &Номенклатура
	               |	И ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	               |	И ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток > 0
	               |	И ТоварыВРезервеНаСкладахОстатки.ДокументРезерва = &ДокументРезерва" ;
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("ДокументРезерва",ЗаказПокупателя);

	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 		
		Возврат РезультатЗапроса[0].Склад;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции


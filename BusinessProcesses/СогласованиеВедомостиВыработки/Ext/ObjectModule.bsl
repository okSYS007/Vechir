// Заполняет согласование на основании установки цен номенклатуры.
//
// Параметры
//	ДокументОснование - ДокументСсылка.ЗаказКлиента - Ссылка на заказ клиента
//
Процедура ЗаполнитьБизнесПроцессНаОснованиВедомостиВыработки(ДокументОснование)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВедомостьВыработки.Ссылка КАК Предмет,
	                      |	ВедомостьВыработки.Статус КАК Статус,
	                      |	НЕ ВедомостьВыработки.Проведен КАК ЕстьОшибкиПроведен,
	                      |	ВЫБОР
	                      |		КОГДА ВедомостьВыработки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВедомостиВыработки.НеСогласован)
	                      |				ИЛИ ВедомостьВыработки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВедомостиВыработки.Черновик)
	                      |			ТОГДА ЛОЖЬ
	                      |		ИНАЧЕ ИСТИНА
	                      |	КОНЕЦ КАК ЕстьОшибкиСтатус,
	                      |	ВедомостьВыработки.Подразделение КАК ЦФО
	                      |ИЗ
	                      |	Документ.ВедомостьВыработки КАК ВедомостьВыработки
	                      |ГДЕ
	                      |	ВедомостьВыработки.Ссылка = &ДокументОснование");
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
		
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	
КонецПроцедуры

// Заполняет согласование заказа клиента в соответствии с отбором.
//
// Параметры:
//	ДанныеЗаполнения - Структура - Структура со значениями отбора
//
Процедура ЗаполнитьДокументПоОтбору(Знач ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.Свойство("Предмет") Тогда
		
		ТипПредмета = ТипЗнч(ДанныеЗаполнения.Предмет);
		
		Если ТипПредмета = Тип("ДокументСсылка.ВедомостьВыработки") Тогда
			ЗаполнитьБизнесПроцессНаОснованиВедомостиВыработки(ДанныеЗаполнения.Предмет);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Инициализирует согласование установки цен.
//
Процедура ИнициализироватьБизнесПроцесс()
	
	Автор = ПараметрыСеанса.ТекущийПользователь;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

// Создает и заполняет задачу исполнителя
//
// Параметры:
//	ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.СогласованиеЗаявкиНаВозвратТоваровОтКлиента
//
// Возвращаемое значение:
//	Созданная задача - ЗадачаОбъект.ЗадачаИсполнителя
//
Функция СоздатьЗадачу(Знач ТочкаМаршрутаБизнесПроцесса)
	
	Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
	
	Задача.Дата                          = ТекущаяДата();
	Задача.Автор                         = Автор;
	Задача.Наименование                  = ТочкаМаршрутаБизнесПроцесса.НаименованиеЗадачи;
	Задача.Описание                      = Наименование;
	Задача.Предмет                       = Предмет;
	Задача.Важность                      = Важность;
	Задача.РольИсполнителя               = ТочкаМаршрутаБизнесПроцесса.РольИсполнителя;
	
	Если  ТочкаМаршрутаБизнесПроцесса = БизнесПроцессы.СогласованиеВедомостиВыработки.ТочкиМаршрута.РуководительЦФО 
		или ТочкаМаршрутаБизнесПроцесса = БизнесПроцессы.СогласованиеВедомостиВыработки.ТочкиМаршрута.СогласованиеИнженер 
		Тогда
		//или ТочкаМаршрутаБизнесПроцесса = БизнесПроцессы.СогласованиеОбходногоЛиста.ТочкиМаршрута.МенеджерПоЛогистике  	
		Задача.ОсновнойОбъектАдресации       = ЦФО;
	//ИначеЕсли  ТочкаМаршрутаБизнесПроцесса = БизнесПроцессы.СогласованиеЗаявкиНаРасходованиеДенежныхСредств.ТочкиМаршрута.РуководительПроекта Тогда 
	//	Задача.ОсновнойОбъектАдресации       = Предмет.РасшифровкаПлатежа[0].Проект;		
	Иначе
		Задача.ОсновнойОбъектАдресации       = ТочкаМаршрутаБизнесПроцесса.ОсновнойОбъектАдресации;	
	КонецЕсли;
	Задача.ДополнительныйОбъектАдресации = ТочкаМаршрутаБизнесПроцесса.ДополнительныйОбъектАдресации;
	Задача.БизнесПроцесс                 = Ссылка;
	Задача.СрокИсполнения                = ДатаСогласования;
	Задача.ТочкаМаршрута                 = ТочкаМаршрутаБизнесПроцесса;
	
	Возврат Задача;

КонецФункции

Процедура УстановитьСтатусНаСогласованииОбработка(ТочкаМаршрутаБизнесПроцесса)
	УстановитьСтатусВедомостиВыработки(Перечисления.СтатусыВедомостиВыработки.НаСогласовании);
КонецПроцедуры

Процедура УстановитьСтатусВедомостиВыработки(Статус)
	ПредметОб        = ЭтотОбъект.Предмет.ПолучитьОбъект();
	ПредметОб.Статус = Статус;
	ПредметОб.Записать();
КонецПроцедуры
               

Функция ЗаявкаСогласована()  
	Возврат ЭтотОбъект.РезультатыСогласования[ЭтотОбъект.РезультатыСогласования.Количество()-1].РезультатСогласования = Перечисления.РезультатыСогласования.Согласовано;	
КонецФункции

Процедура УстановитьСтатусСогласованноОбработка(ТочкаМаршрутаБизнесПроцесса)
	УстановитьСтатусВедомостиВыработки(Перечисления.СтатусыВедомостиВыработки.Согласован);
КонецПроцедуры

Процедура УстановитьСтатусОтклоненаОбработка(ТочкаМаршрутаБизнесПроцесса)

//Содание внутреннего заказа и переопределение размещений
Процедура СоздатьВнутреннийЗаказИПеремещениеОбработка(ТочкаМаршрутаБизнесПроцесса)
Попытка	
	ЗаписьЖурналаРегистрации("БП_СозданиеДокументов.ВнутренийЗаказ.Начало", 
        УровеньЖурналаРегистрации.Информация, , ,
        "Начало");
		
	Документ = Документы.ВнутреннийЗаказ.СоздатьДокумент();
	Документ.ВидЗаказа     = Перечисления.ВидыВнутреннегоЗаказа.НаСклад;
	Документ.Дата 	       = Дата;
	Документ.Заказчик      = СкладВыдачи;
	Документ.Организация   = РодительскийБизнесПроцес.ЗаказПокупателя.Организация;
	Документ.Комментарий   = "Созданно Бизнес-процессом";
	Документ.Подразделение = СкладВыдачи.Подразделение;
	Документ.ДокументОснование = РодительскийБизнесПроцес.ЗаказПокупателя; 
	
	Товар = Документ.Товары.Добавить();
	Товар.Номенклатура 	   			 = Номенклатура;
	Товар.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
	Товар.ЕдиницаИзмерения 			 = Номенклатура.ЕдиницаХраненияОстатков;
	Товар.Коэффициент 	   			 = 1;
	Товар.Количество 	   			 = Количество;
	Товар.Размещение                 = СкладСОстаткомТовара;
	
	Документ.Записать(РежимЗаписиДокумента.Запись);
	ЗаписьЖурналаРегистрации("БП_СозданиеДокументов.ВнутренийЗаказ.Запись", 
        УровеньЖурналаРегистрации.Информация, , ,
        "Запись документа");

	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	ЗаписьЖурналаРегистрации("БП_СозданиеДокументов.ВнутренийЗаказ.Запись", 
        УровеньЖурналаРегистрации.Информация, , ,
        "Запись документа");
	
	ЗаказПокупателя = ЭтотОбъект.РодительскийБизнесПроцес.ЗаказПокупателя;
	ЗаказПокупателяоб =  ЗаказПокупателя.ПолучитьОбъект();
	
	ОтборСтроки = новый Структура;
	ОтборСтроки.Вставить("Номенклатура",Номенклатура);
	ОтборСтроки.Вставить("ХарактеристикаНоменклатуры",ХарактеристикаНоменклатуры);
	ОтборСтроки.Вставить("Количество",Количество);
	ОтборСтроки.Вставить("НомерСтроки",НомерСтроки);	
	
	СтрокиЗаказа = ЗаказПокупателяоб.Товары.НайтиСтроки(ОтборСтроки);
	Если СтрокиЗаказа.Количество()=1 Тогда 
		СтрокаЗаказа = СтрокиЗаказа[0];
		СтрокаЗаказа.размещение = Документ.Ссылка;
	КонецЕсли;
	
	ЗаказПокупателяоб.Записать(РежимЗаписиДокумента.Проведение);
	
	ДокументПеремещения = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ДокументПеремещения.ВидОперации      = Перечисления.ВидыОперацийПеремещениеТоваров.ТоварыПродукцияПоОрдерам;
	ДокументПеремещения.Дата 	         = Дата;
	ДокументПеремещения.ВнутреннийЗаказ  = Документ.Ссылка;
	ДокументПеремещения.Организация      = РодительскийБизнесПроцес.ЗаказПокупателя.Организация;
	ДокументПеремещения.Комментарий      = "Созданно Бизнес-процессом";
	ДокументПеремещения.Подразделение    = СкладВыдачи.Подразделение;
	ДокументПеремещения.СкладОтправитель = СкладСОстаткомТовара;
	ДокументПеремещения.СкладПолучатель  = СкладВыдачи;
	ДокументПеремещения.ОтражатьВУправленческомУчете = Истина;
	ДокументПеремещения.ТипПеремещения   = Перечисления.ТипыПеремещенияТовара.ПодКлиента;
	ДокументПеремещения.ЗаказПокупателя =  РодительскийБизнесПроцес.ЗаказПокупателя;

	
	Товар = ДокументПеремещения.Товары.Добавить();
	Товар.Номенклатура 	   			 = Номенклатура;
	Товар.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
	Товар.ЕдиницаИзмерения 			 = Номенклатура.ЕдиницаХраненияОстатков;
	Товар.Коэффициент 	   			 = 1;
	Товар.Количество 	   			 = Количество;
	Товар.ДокументРезерва            = Документ.Ссылка;
	Товар.Качество                   = Справочники.Качество.Новый;
	Товар.ВнутреннийЗаказ			 = Документ.Ссылка;
	
	ДокументПеремещения.Записать(РежимЗаписиДокумента.Запись);
	ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);
	
	ВнутреннийЗаказ    = Документ.Ссылка;
	ПеремещениеТоваров = ДокументПеремещения.Ссылка;
	ЭтотОбъект.Записать();
Исключение
	ЗаписьЖурналаРегистрации("БП_СозданиеДокументов.ВнутренийЗаказ.Исключение", 
        УровеньЖурналаРегистрации.Информация, , ,
        "исключение" + ОписаниеОшибки());
	
	
КонецПопытки;
КонецПроцедуры

Процедура ПроверитьОстатокСкладаПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	Для Каждого  Задача из ФормируемыеЗадачи цикл
		Задача.Подразделение = СкладСОстаткомТовара.Подразделение;
		Задача.Номенклатура  		      = Номенклатура;
		Задача.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
		Задача.СкладДляПроверкиОстатка    = СкладСОстаткомТовара;
		Задача.типЗадачи                  = Перечисления.БП_ТипыЗадач.ПроверитьОстаток;
		Задача.Количество                 = Количество;
		Задача.ЗаказПокупателя			  = РодительскийБизнесПроцес.ЗаказПокупателя;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОстатокПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	Для Каждого  Задача из ФормируемыеЗадачи цикл
		Задача.Подразделение              = СкладВыдачи.Подразделение;

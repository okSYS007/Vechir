		Документ.Заказ = РодительскийБизнесПроцес.ЗаказПокупателя;
		Строка = Документ.Товары.Добавить();
		Строка.ЕдиницаИзмерения = Номенклатура.ЕдиницаХраненияОстатков;
		Строка.Количество   = Количество;
		Строка.Коэффициент  = 1;

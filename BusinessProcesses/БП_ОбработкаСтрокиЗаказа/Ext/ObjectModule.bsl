Функция ЕстьОплата(ЗаказПокупателя) Экспорт 
	
	ВозвращаемоеЗначение = Ложь;
	
	СуммаДолгаПоКорректировке = 0;
	
	ЗапросПоСуммеКорректировки = новый Запрос;
	ЗапросПоСуммеКорректировки.Текст = "ВЫБРАТЬ
	                                   |	ЕстьNULL(СУММА(КорректировкаЗаказаПокупателя.СуммаДокумента),0) КАК СуммаДокумента
	                                   |ИЗ
	                                   |	Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
	                                   |ГДЕ
	                                   |	КорректировкаЗаказаПокупателя.ЗаказПокупателя = &ЗаказПокупателя";
	ЗапросПоСуммеКорректировки.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	
	РезультатЗапросаПоСуммеКорректировки = ЗапросПоСуммеКорректировки.Выполнить().Выгрузить();
	Если РезультатЗапросаПоСуммеКорректировки.Количество()>0 Тогда 
		СуммаДолгаПоКорректировке = РезультатЗапросаПоСуммеКорректировки[0].СуммаДокумента;
	КонецЕсли;
		
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОплатаОтПокупателяПлатежнойКартой.СуммаДокумента КАК СуммаДокумента
	               |ИЗ
	               |	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
	               |ГДЕ
	               |	ОплатаОтПокупателяПлатежнойКартой.Проведен
	               |	И ОплатаОтПокупателяПлатежнойКартой.ДокументОснование = &ЗаказПокупателя
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПлатежноеПоручениеВходящее.СуммаДокумента
	               |ИЗ
	               |	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	               |ГДЕ
	               |	ПлатежноеПоручениеВходящее.Проведен
	               |	И ПлатежноеПоручениеВходящее.РасшифровкаПлатежа.Сделка = &ЗаказПокупателя
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.СуммаДокумента
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.Проведен
	               |	И ПриходныйКассовыйОрдер.РасшифровкаПлатежа.Сделка = &ЗаказПокупателя";
	Запрос.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество()>0 Тогда  
		Если РезультатЗапроса[0].СуммаДокумента >= ЗаказПокупателя.СуммаДокумента+СуммаДолгаПоКорректировке Тогда 
			//Полученна оплата
			ВозвращаемоеЗначение =  Истина;
		Иначе
			//Не полученна оплата
			ВозвращаемоеЗначение =  Ложь;
		КонецЕсли;
	Иначе
		ВозвращаемоеЗначение =  Ложь;
	КонецЕсли;
	
	Если не ВозвращаемоеЗначение Тогда 
		
		ЗапросПоВзаиморасчетам = новый запрос;
		//ЗапросПоВзаиморасчетам.Текст = ;
		
	КонецЕсли;
	
	Если ЗаказПокупателя.ПодОтветственностьМенеджера Тогда 
		ВозвращаемоеЗначение = Истина;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


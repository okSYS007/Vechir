	Если не РезультатЗапроса.Количество() Тогда 
		Документ = Документы.РезервированиеТоваров.СоздатьДокумент();
		Документ.ВидОперации = Перечисления.ВидыОперацийРезервированиеТоваров.ПоЗаказам;

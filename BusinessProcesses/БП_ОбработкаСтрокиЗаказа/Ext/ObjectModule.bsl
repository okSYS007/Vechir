Функция ПолучитьНоменклатуруХарактеристикуКомплекта(Характеристика)
	
	Запрос = новый запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЗначенияСвойствОбъектов.Значение
	              |ИЗ
	              |	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	              |ГДЕ
	              |	ЗначенияСвойствОбъектов.Объект = &Объект
	              |	И ЗначенияСвойствОбъектов.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Объект",Характеристика);
	Запрос.УстановитьПараметр("Свойство",ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("6.Номер комплекта"));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
			НомерКомплекта = РезультатЗапроса[0].Значение;
			
			Запрос = новый запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Комплект.Объект
			               |ИЗ
			               |	(ВЫБРАТЬ
			               |		ЗначенияСвойствОбъектов.Объект КАК Объект
			               |	ИЗ
			               |		РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
			               |	ГДЕ
			               |		ЗначенияСвойствОбъектов.Свойство = &СвойствоНомер
			               |		И ЗначенияСвойствОбъектов.Значение = &ЗначениеНомер) КАК Комплект
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ВидКомплектации
			               |		ПО Комплект.Объект = ВидКомплектации.Объект
			               |ГДЕ
			               |	ВидКомплектации.Свойство = &СвойствоВидКомплектации
			               |	И ВидКомплектации.Значение = ЗНАЧЕНИЕ(Перечисление.зетаБУВидыКомплектации.ПустаяСсылка)";
			Запрос.УстановитьПараметр("СвойствоВидКомплектации",ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("4.Вид комплектации"));
			Запрос.УстановитьПараметр("СвойствоНомер",ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("6.Номер комплекта"));
			Запрос.УстановитьПараметр("ПустоеСвойстоВидКомплектации",Перечисления.зетаБУВидыКомплектации.ПустаяСсылка());
			Запрос.УстановитьПараметр("ЗначениеНомер",НомерКомплекта);

			РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			
			Если РезультатЗапроса.Количество() Тогда 
				Возврат РезультатЗапроса[0].Объект;

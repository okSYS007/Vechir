		Строка.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
		Строка.ИсходноеРазмещение = ЗаказПоставщику;
		Строка.НовоеРазмещение	  = СкладВыдачи;
		Документ.Комментарий = "Созанно бизнесс процессов " + Номер;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЕсли;
	

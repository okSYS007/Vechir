		|	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) КАК КоличествоСвободно
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			Склад = &Склад
		|				И Номенклатура = &Номенклатура) КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|				,
		|				Склад = &Склад
		|					И Номенклатура = &Номенклатура) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
		|			И ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыНаСкладахОстатки.Склад,
		|	ТоварыНаСкладахОстатки.Номенклатура";
		
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивОстатков = Новый массив;
	СтруктураОтвета = Новый Структура;
	
	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
		СтруктураОстатков = Новый Структура;
		СтруктураОстатков.Вставить("warehouse_id", warehouse_id);
		СтруктураОстатков.Вставить("item_id", item_id);
		Если ЗначениеЗаполнено(СерияНоменклатуры) Тогда
			СтруктураОстатков.Вставить("serial_number", serial_number);
		КонецЕсли;
		СтруктураОстатков.Вставить("stock_total", 0);
		СтруктураОстатков.Вставить("stock_reserved", 0);
		СтруктураОстатков.Вставить("stock_available", 0);
		МассивОстатков.Добавить(СтруктураОстатков);
	КонецЕсли;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураОстатков = Новый Структура;
		СтруктураОстатков.Вставить("warehouse_id", Строка(ВыборкаДетальныеЗаписи.Склад.УникальныйИдентификатор()));
		СтруктураОстатков.Вставить("item_id", Строка(ВыборкаДетальныеЗаписи.Номенклатура.УникальныйИдентификатор()));
		Если ЗначениеЗаполнено(СерияНоменклатуры) Тогда
			СтруктураОстатков.Вставить("serial_number", Строка(serial_number));
		КонецЕсли;
		СтруктураОстатков.Вставить("stock_total", ВыборкаДетальныеЗаписи.КоличествоОстаток);
		СтруктураОстатков.Вставить("stock_reserved", ВыборкаДетальныеЗаписи.КоличествоРезерв);
		СтруктураОстатков.Вставить("stock_available", ВыборкаДетальныеЗаписи.КоличествоСвободно);
		
		МассивОстатков.Добавить(СтруктураОстатков);
		
	КонецЦикла;
	
	ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОстатков);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьСкладПоUUID(Склад_UUID)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Пользователи.Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизЛицо.Код = &Код";
	Запрос.УстановитьПараметр("Код",Склад_UUID);
	РезультатЗапроса = запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Пользователь = РезультатЗапроса.ссылка;
		Склад = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь,"ОсновнойСклад");
		
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Склад) Тогда 
		
		Склад = Справочники.Склады.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат Склад; //Справочники.Склады.ПолучитьСсылку(Склад_UUID);
	

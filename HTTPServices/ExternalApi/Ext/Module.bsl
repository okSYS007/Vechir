Процедура ЛогAPIУстановкаТТН(Уровень, Сообщение, Заказ = Неопределено)
	
	Попытка
		
		Если ЗначениеЗаполнено(Заказ) Тогда
			ЗаписьЖурналаРегистрации(
			"API установка ТТН",
			Уровень,
			Метаданные.Документы.ЗаказПокупателя,
			Заказ,
			Сообщение
			);
		Иначе
			ЗаписьЖурналаРегистрации(
			"API установка ТТН",
			Уровень,
			Метаданные.Документы.ЗаказПокупателя,
			Неопределено,
			Сообщение
			);
		КонецЕсли;
		
	Исключение
		// Логирование не должно ломать основной API-метод.
	КонецПопытки;
	
КонецПроцедуры


Функция ЗначениеДляЛога(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат СокрЛП(Строка(Значение));
	Исключение
		Возврат "<Ошибка преобразования значения в строку>";
	КонецПопытки;
	
КонецФункции


Функция НайтиЗаказПоОрдерИД(OrderID) Экспорт
	
	ЛогAPIУстановкаТТН(
	УровеньЖурналаРегистрации.Информация,
	"Начало выполнения НайтиЗаказПоОрдерИД. OrderID: " + ЗначениеДляЛога(OrderID),
	Неопределено
	);
	
	Если ПустаяСтрока(ЗначениеДляЛога(OrderID)) Тогда
		
		ЛогAPIУстановкаТТН(
		УровеньЖурналаРегистрации.Предупреждение,
		"НайтиЗаказПоОрдерИД: передан пустой OrderID.",
		Неопределено
		);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	СвойствоПримечаниеКЗаказу = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Примечание к заказу");
	
	Если НЕ ЗначениеЗаполнено(СвойствоПримечаниеКЗаказу) Тогда
		
		ЛогAPIУстановкаТТН(
		УровеньЖурналаРегистрации.Ошибка,
		"НайтиЗаказПоОрдерИД: не найдено свойство 'Примечание к заказу'. Поиск заказа невозможен. OrderID: " 
		+ ЗначениеДляЛога(OrderID),
		Неопределено
		);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЛогAPIУстановкаТТН(
	УровеньЖурналаРегистрации.Информация,
	"НайтиЗаказПоОрдерИД: свойство найдено. Свойство: " 
	+ ЗначениеДляЛога(СвойствоПримечаниеКЗаказу)
	+ ". Начало выполнения запроса.",
	Неопределено
	);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Заказ
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.OrderID = &OrderID";
	
	Запрос.УстановитьПараметр("OrderID", СокрЛП(Строка(OrderID)));
	
	Попытка
		
		РезультатЗапроса = Запрос.Выполнить();
		
	Исключение
		
		ЛогAPIУстановкаТТН(
		УровеньЖурналаРегистрации.Ошибка,
		"НайтиЗаказПоОрдерИД: ошибка выполнения запроса. OrderID: " 
		+ ЗначениеДляЛога(OrderID)
		+ ". Ошибка: " + ОписаниеОшибки(),
		Неопределено
		);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		
		ЛогAPIУстановкаТТН(
		УровеньЖурналаРегистрации.Предупреждение,
		"НайтиЗаказПоОрдерИД: заказ не найден. OrderID: " + ЗначениеДляЛога(OrderID),
		Неопределено
		);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЛогAPIУстановкаТТН(
	УровеньЖурналаРегистрации.Информация,
	"НайтиЗаказПоОрдерИД: заказ найден. OrderID: " 
	+ ЗначениеДляЛога(OrderID)
	+ "; заказ: " + ЗначениеДляЛога(Выборка.Заказ)
	+ "; GUID: " + Строка(Выборка.Заказ.УникальныйИдентификатор()),
	Выборка.Заказ
	);
	
	Возврат Выборка.Заказ;
	
	
КонецФункции


Функция ПроверитьНоменклатуруPOST(Запрос)
	
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(); 
	
	
	ЧтениеДжСОН = Новый ЧтениеJSON;
	ЧтениеДжСОН.УстановитьСтроку(ТелоЗапроса);
	ДанныеДжСОН = ПрочитатьJSON(ЧтениеДжСОН);
	ЧтениеДжСОН.Закрыть();
	
	МассивНоменклатуры = Новый Массив;
	
	
	Для каждого СтрокиМассив Из ДанныеДжСОН.products Цикл
		
		СсылкаНоменклатуры = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокиМассив.guid));	
		
		Если Не СсылкаНоменклатуры.Пустая() Тогда
			
			МассивНоменклатуры.Добавить(СсылкаНоменклатуры);
			
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	Узел = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(ДанныеДжСОН.node_code);
	
	Если  Узел.Пустая() Тогда 
		
		Телотруктура = Новый Структура;
		Телотруктура.Вставить("succeses",False);
		
		Ответ = Новый HTTPСервисОтвет(200);
		ЗаписьJSON  = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Телотруктура);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON,ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
		
	КонецЕсли;
	
	
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.Ссылка В (&Массив)";
	
	Запрос.УстановитьПараметр("Массив", МассивНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл 
		
		
		
		
		ПланыОбмена.ЗарегистрироватьИзменения(Узел,РезультатЗапроса.Ссылка);
	КонецЦикла;
	Телотруктура = Новый Структура;
	Телотруктура.Вставить("succeses",False);
	
	Ответ = Новый HTTPСервисОтвет(200);
	ЗаписьJSON  = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Телотруктура);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON,,ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
	
КонецФункции

Функция СоздатьЗаказadd_order(Запрос)
	
	МассОтвета = Новый Массив;
	
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(); 
	ЗаписьЖурналаРегистрации("ОбменССайтом.ПолучениеЗаказа",УровеньЖурналаРегистрации.Информация,,,ТелоЗапроса);
	ЧтениеДжСОН = Новый ЧтениеJSON;
	ЧтениеДжСОН.УстановитьСтроку(ТелоЗапроса);
	СтруктураJSON = ПрочитатьJSON(ЧтениеДжСОН);
	ЧтениеДжСОН.Закрыть();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СвойстваОбъектов.Ссылка КАК Свойство
	|ИЗ
	|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
	|ГДЕ
	|	СвойстваОбъектов.НазначениеСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Документ_ЗаказПокупателя)
	|	И СвойстваОбъектов.Наименование = ""Способ оплаты""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СвойствоОплаты = ?(РезультатЗапроса.Пустой(), Неопределено, РезультатЗапроса.Выгрузить()[0].Свойство);
	
	СоответствиеСтатусов = Новый Соответствие;
	СоответствиеСтатусов.Вставить("Нове", Перечисления.СтатусыЗаказаИМ.НовыйЗаказ);
	СоответствиеСтатусов.Вставить("Новий (оплачений)", Перечисления.СтатусыЗаказаИМ.НовоеОплачено);
	СоответствиеСтатусов.Вставить("Тест-драйв", Перечисления.СтатусыЗаказаИМ.ТестДрайв);
	
	Для Каждого СтрДанные из СтруктураJSON Цикл
		
		СтрОтвета = Новый Структура;
		СтрОтвета.Вставить("order_id", СтрДанные.order.order_id);
		
		Заказ = НайтиЗаказПоOrderID(СтрДанные.order.order_id);
		Если Заказ = Неопределено Тогда
			ЗаказОб = Документы.ЗаказПокупателя.СоздатьДокумент();
		Иначе
			ЗаказОб = Заказ.ПолучитьОбъект();	
			
			Если ЗаказОб.Проведен Тогда
				СтрОтвета.Вставить("status", "Order is not available for editing.");
				МассОтвета.Добавить(СтрОтвета);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ЭтоТестДрайвЗаказ = (ЗаказОб.СтатусИМ = Перечисления.СтатусыЗаказаИМ.ТестДрайв);
		
		ЗаписьJSONЗаказ  = Новый ЗаписьJSON;
		ЗаписьJSONЗаказ.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSONЗаказ, СтрДанные);
		СтрокаJSON = ЗаписьJSONЗаказ.Закрыть();
		Если НЕ ЗначениеЗаполнено(ЗаказОб.JsonAPI) Тогда
			ЗаказОб.JsonAPI = СтрокаJSON;
		КонецЕсли;
		
		ЗаказОб.OrderID				= СтрДанные.order.order_id;
		ЗаказОб.Дата 				= СериализаторXDTO.XMLЗначение(Тип("Дата"),СтрДанные.order.order_date);
		ЗаказОб.ВалютаДокумента 	= Справочники.Валюты.НайтиПоНаименованию("грн");
		ЗаказОб.ВидОперации 		= Перечисления.ВидыОперацийЗаказПокупателя.ПродажаКомиссия;
		ЗаказОб.Проект 				= Справочники.Проекты.НайтиПоКоду("S00000085");
		ЗаказОб.Подразделение 		= Справочники.Подразделения.НайтиПоКоду("000000242");//Интернет магазин
		ЗаказОб.СкладГруппа			= ПолучитьСкладПоФизЛицу(СтрДанные.order.customer.code_1c); 
		
		ЗаказОб.Комментарий = "vstore.net.ua:" + "№ " + СтрДанные.order.order_id + " " + СтрДанные.order.comment;
		ЗаказОб.ДатаОплаты 		= СериализаторXDTO.XMLЗначение(Тип("Дата"),СтрДанные.order.payment.paid_at);
		ЗаказОб.Ответственный 	= глЗначениеПеременной("глТекущийПользователь");
		ЗаказОб.КурсВзаиморасчетов = 1;
		ЗаказОб.КратностьВзаиморасчетов = 1;
				
		Если СоответствиеСтатусов[СтрДанные.order.payment.status] <> Неопределено Тогда
			ЗаказОб.СтатусИМ = СоответствиеСтатусов[СтрДанные.order.payment.status];	
		КонецЕсли;
		
		Если ЗаказОб.СтатусИМ = Перечисления.СтатусыЗаказаИМ.ТестДрайв Тогда
			ЭтоТестДрайвЗаказ = Истина;
			ry_ОбщиеПроцедуры.УстановитьПризнакТестДрайв(ЗаказОб);
		КонецЕсли;
		
		Если СтрДанные.order.payment.payment_id  = "Безготівковий розрахунок" Тогда
			ЗаказОб.БезналичныйРасчет = Истина;
			ЗаказОб.СтатусИМ = Перечисления.СтатусыЗаказаИМ.ВРаботеЮО;
		КонецЕсли;
		
		ПривестиТелефонКНужномуФормату(СтрДанные.order.customer);
		
		Контрагент					= ПолучитьСоздатьКонтрагента(СтрДанные.order.customer);
		Организация 				= ПолучитьОрганизацию(СтрДанные.order.payment, СтрДанные.order.delivery, Контрагент);
		Договор                 	= ПолучитьСоздатьДоговорКонтрагента(Организация, Контрагент, ЗаказОб.ВалютаДокумента);
		
		ЗаказОб.Организация			= Организация;
		ЗаказОб.Контрагент 			= Контрагент;
		ЗаказОб.ДоговорКонтрагента	= Договор; 
		ЗаказОб.ППКСтрокой 			= СтрДанные.order.customer.uid;
		
		ЗаказОб.СпособОплаты 		= СтрДанные.order.payment.payment_id;
		ЗаказОб.СпособДоставки		= СтрДанные.order.delivery.method;
		ЗаказОб.АдресДоставки		= ?(ЗначениеЗаполнено(СтрДанные.order.customer.address.country), СтрДанные.order.customer.address.country, "")  + " " 
		+ ?(ЗначениеЗаполнено(СтрДанные.order.customer.address.city), СтрДанные.order.customer.address.city, "")  + " " 
		+ ?(ЗначениеЗаполнено(СтрДанные.order.customer.address.county), СтрДанные.order.customer.address.county, "")  + " " 
		+ ?(ЗначениеЗаполнено(СтрДанные.order.customer.address.street), СтрДанные.order.customer.address.street, "");
		
		
		ЗаказОб.НомерСЗаказа		= СтрДанные.order.customer.phone;
		
		СтрПлательщикНаименование 	= СтрЗаменить(СтрДанные.order.payment.cashless_payment_data.phisical_name, "&quot;", """");
		СтрПлательщикКонтакт		= СтрЗаменить(СтрДанные.order.customer.name, "&quot;", """");
		
		ЗаказОб.ПлательщикНаименование 	= СтрПлательщикНаименование;
		ЗаказОб.ПлательщикКодЕДРПОУ		= Строка(СтрДанные.order.payment.cashless_payment_data.edrpou_code);
		ЗаказОб.ПлательщикКонтакт		= СтрПлательщикКонтакт;
		
		Если ЗаказОб.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")) Тогда //Вечер
			ЗаказОб.АвторасчетНДС 		= Истина;
			ЗаказОб.УчитыватьНДС 		= Истина;
			ЗаказОб.СуммаВключаетНДС 	= Истина;
		Иначе
			ЗаказОб.АвторасчетНДС 	= Ложь;
		КонецЕсли;
		
		ИдентифицироватьНоменклатуру(СтрДанные.order.items, ЗаказОб);
		
		Если ЗаказОб.Товары.Количество() + ЗаказОб.Услуги.Количество() = 0 Тогда
			
			СтрОтвета.Вставить("status", "Nomenclature not identified");
			МассОтвета.Добавить(СтрОтвета);
			ЗаписьЖурналаРегистрации("Заказы API", УровеньЖурналаРегистрации.Ошибка,,,"Не заполнены табличные части товары и услуги "+ СтрДанные.order.order_id);
			Продолжить;	
			
		КонецЕсли;
		
		ЗаказОб.Записать(РежимЗаписиДокумента.Запись);
		ЗаказОб = ЗаказОб.Ссылка.ПолучитьОбъект();
		Попытка
			ЗаказОб.Записать(РежимЗаписиДокумента.Проведение);
			СтрОтвета.Вставить("status", "Order created");
		Исключение
			СтрОтвета.Вставить("status", "Failed to complete the order." + ОписаниеОшибки());
			ЗаписьЖурналаРегистрации("Заказы API", УровеньЖурналаРегистрации.Ошибка,,,"Не удалось провести документ "+ СтрДанные.order.order_id);
		КонецПопытки;
		
		МассОтвета.Добавить(СтрОтвета);
		
		Если ЗаказОб.СтатусИМ = Перечисления.СтатусыЗаказаИМ.НовоеОплачено Тогда
			СоздатьЧек(ЗаказОб.Ссылка);	
			
			Если ЭтоТестДрайвЗаказ Тогда
				ry_ОбщиеПроцедуры.СписатьТоварыТестДрайвПоОплаченномуЗаказу(ЗаказОб.Ссылка, Истина);
				ry_ОбщиеПроцедуры.СоздатьЗадачуИПисьмоТестДрайв(ЗаказОб.Ссылка, "Оплачене замовлення");
			КонецЕсли;
		КонецЕсли;
		
		//Дандали В. 23.03.2026 +
		А_ОбщегоНазначенияСервер.СоздатьЗадачу(ЗаказОб.Ссылка);		
		//Дандали В. 23.03.2026 -
		
		УдалитьРегистрациюЗаказаДляВыгрузкиНаСайтАпи(ЗаказОб.Ссылка);
		
	КонецЦикла;
	
	ЗаписьJSON  = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассОтвета);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON,,ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

Процедура УдалитьРегистрациюЗаказаДляВыгрузкиНаСайтАпи(Заказ)
	
	УзелОбменаЗаказамиАпи = Константы.УзелОбменаССайтомЗаказыАпи.Получить();
	Если ЗначениеЗаполнено(УзелОбменаЗаказамиАпи)
		И ЗначениеЗаполнено(Заказ) Тогда
		
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаЗаказамиАпи, Заказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПривестиТелефонКНужномуФормату(ДанныеКонтрагента)
	
	ИсходнаяСтрока = ДанныеКонтрагента.phone;
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, "(", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, ")", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, "-", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, " ", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, Символы.НПП, "");
	
	ДлинаИсходнойСтроки = СтрДлина(ИсходнаяСтрока);
	Цифры = "0123456789+";
	ЧислоСтрокой = ""; 
	
	МожноРедактировать = Истина;
	Для НомерСимвола = 1 по ДлинаИсходнойСтроки Цикл
		//Считываем очередной символ из исходной строки
		СимволИсходнойСтроки = Сред(ИсходнаяСтрока,НомерСимвола,1);   
		
		Если Найти(Цифры, СимволИсходнойСтроки) <> 0 Тогда
			//Собираем число из цифр в строку
			ЧислоСтрокой = ЧислоСтрокой + СимволИсходнойСтроки; 
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если ЧислоСтрокой <> "" 
		И МожноРедактировать Тогда
		
		ЧислоСтрокой = СтрЗаменить(ЧислоСтрокой, "+", "");
		Если Лев(ЧислоСтрокой, 1) = "3" Тогда
			ЧислоСтрокой = Сред(ЧислоСтрокой, 2, СтрДлина(ЧислоСтрокой)); 	
		КонецЕсли;
		Если Лев(ЧислоСтрокой, 1) = "8" Тогда
			ЧислоСтрокой = Сред(ЧислоСтрокой, 2, СтрДлина(ЧислоСтрокой)); 	
		КонецЕсли;
		
		Если СтрДлина(ЧислоСтрокой) < 10 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеКонтрагента.phone = ЧислоСтрокой;
	
КонецПроцедуры

Функция ПолучитьСоздатьКонтрагента(ДанныеКонтрагента)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", ДанныеКонтрагента.name);
	Запрос.УстановитьПараметр("НомерТелефона", ДанныеКонтрагента.phone);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	(Контрагенты.Наименование = &Наименование
	|			И Контрагенты.НомерТелефона = &НомерТелефона)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КонтрагентСсылка = Выборка.Контрагент;
	Иначе
		КонтрагентСсылка = СоздатьКонтрагента(ДанныеКонтрагента);
	КонецЕсли;
	
	Возврат КонтрагентСсылка;
	

Функция СоздатьКонтрагента(СтруктураДанныхКонтрагента)
	
	НовыйКонтрагент 					= Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Родитель 			= Справочники.Контрагенты.НайтиПоНаименованию("Абоненти");
	НовыйКонтрагент.Наименование 		= СтруктураДанныхКонтрагента.name;	
	НовыйКонтрагент.НаименованиеПолное 	= СтруктураДанныхКонтрагента.name;
	НовыйКонтрагент.Покупатель 			= Истина;
	НовыйКонтрагент.НомерТелефона		= СтруктураДанныхКонтрагента.phone;
	Попытка
		НовыйКонтрагент.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;	
	
	КонтрагентСсылка = НовыйКонтрагент.Ссылка;
	
	//Адрес
	НаборКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборКИ.отбор.Объект.Установить(КонтрагентСсылка);
	НаборКИ.отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Адрес);
	НаборКИ.отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
	
	СтрокаКи 		= НаборКИ.Добавить();
	СтрокаКи.Объект = КонтрагентСсылка;
	СтрокаКи.Тип 	= Перечисления.ТипыКонтактнойИнформации.Адрес;
	СтрокаКи.Вид 	= Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
	
	СтрокаКи.Представление = "Україна , "+ СтруктураДанныхКонтрагента.address.city + ", " + СтруктураДанныхКонтрагента.address.street;
	
	Попытка
		НаборКИ.Записать();
	Исключение
	КонецПопытки;
	
	//Телефон
	НаборКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборКИ.отбор.Объект.Установить(КонтрагентСсылка);
	НаборКИ.отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Телефон);
	НаборКИ.отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	
	СтрокаКи 			= НаборКИ.Добавить();
	СтрокаКи.Объект 	= КонтрагентСсылка;
	СтрокаКи.Тип 		= Перечисления.ТипыКонтактнойИнформации.Телефон;
	СтрокаКи.Вид 		= Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
	
	СтрокаКи.Представление = СтруктураДанныхКонтрагента.phone;
	
	НаборКИ.Записать();
	
	Попытка
		НаборКИ.Записать();
	Исключение
	КонецПопытки;
	
	//email
	НаборКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборКИ.отбор.Объект.Установить(КонтрагентСсылка);
	НаборКИ.отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	НаборКИ.отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами);
	
	СтрокаКи 			= НаборКИ.Добавить();
	СтрокаКи.Объект 	= КонтрагентСсылка;
	СтрокаКи.Тип 		= Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	СтрокаКи.Вид 		= Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами;
	
	СтрокаКи.Представление = СтруктураДанныхКонтрагента.email;
	
	НаборКИ.Записать();
	
	Попытка
		НаборКИ.Записать();
	Исключение
	КонецПопытки;
	
	Возврат НовыйКонтрагент.Ссылка;
	
КонецФункции	

Функция ПолучитьСоздатьДоговорКонтрагента(Организация, Контрагент, Валюта)
	
	Если НЕ ЗначениеЗаполнено(Организация) 
		ИЛИ НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ищем договр по контрагенту, организации и валюте
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.ВедениеВзаиморасчетов = ЗНАЧЕНИЕ(Перечисление.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам)
	|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|	И ДоговорыКонтрагентов.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекущийДоговор = Неопределено;
	
	ВалютаВзаиморасчетов = Валюта;
	
	Если НЕ ЗначениеЗаполнено(ВалютаВзаиморасчетов) Тогда
		ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаУправленческогоУчета");
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		ТекущийДоговор = Выборка.Ссылка;
		Если Выборка.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ТекущийДоговор) Тогда
		
		ТекущийДоговор = СоздатьДоговорПоПараметрам(Контрагент, Организация, ВалютаВзаиморасчетов);
		
		Если Не ЗначениеЗаполнено(ТекущийДоговор) Тогда
			Возврат Ложь;
		КонецЕсли;	
		
	КонецЕсли;
	
	Попытка
		
		КонтрагентОбъект = Контрагент.ПолучитьОбъект();
		КонтрагентОбъект.ОсновнойДоговорКонтрагента = ТекущийДоговор;
		КонтрагентОбъект.Записать();
		
	Исключение
	КонецПопытки;		
	
	Возврат ТекущийДоговор;
	
КонецФункции

Процедура ИдентифицироватьНоменклатуру(Товары, Заказ)
	
	ОргВечер = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9"));//Вечер
	Заказ.Товары.Очистить();
	Заказ.Услуги.Очистить();
	
	Если Заказ.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")) Тогда //Вечер
		СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
	Иначе
		СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;
	
	Для Каждого ТоварУслугаСвойство из Товары Цикл
		
		//Поиск по ГУИДу
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		Если ЗначениеЗаполнено(ТоварУслугаСвойство.item_1c_id) Тогда
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ТоварУслугаСвойство.item_1c_id));
		КонецЕсли;
		
		//Поиск по Артикулу
		Если НЕ ЗначениеЗаполнено(Номенклатура) 
			И ЗначениеЗаполнено(ТоварУслугаСвойство.sku) Тогда
			Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", ТоварУслугаСвойство.sku);
		КонецЕсли;
		
		//Поиск по Наименованию
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(ТоварУслугаСвойство.name, Истина);	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			ЗаписьЖурналаРегистрации("Заказы API", УровеньЖурналаРегистрации.Ошибка,,,"Не найдена номенклатура " + ТоварУслугаСвойство.name);
			Продолжить;	
		КонецЕсли;
		
		Если Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			НовСтр 					= Заказ.Услуги.Добавить();
			НовСтр.Номенклатура 	= Номенклатура;
			НовСтр.СтавкаНДС		= Перечисления.СтавкиНДС.БезНДС;
			
			НовСтр.Содержание   = Номенклатура.НаименованиеПолное;
			НовСтр.Количество 	= 1;
			НовСтр.Цена			= Число(ТоварУслугаСвойство.price);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтр, Заказ);
			
		Иначе
			
			МассСерий = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТоварУслугаСвойство.serial, ",");
			
			Если МассСерий.Количество() > 1 Тогда 
				
				Для Каждого стрСерия из МассСерий Цикл
					НовСтр 					= Заказ.Товары.Добавить();
					НовСтр.Номенклатура 	= Номенклатура;
					НовСтр.СтавкаНДС						=	СтавкаНДС;
					НовСтр.Количество 						= ТоварУслугаСвойство.qty;
					НовСтр.Коэффициент						= 1;
					НовСтр.ЕдиницаИзмерения					= Номенклатура.ЕдиницаХраненияОстатков;
					НовСтр.ХарактеристикаНоменклатуры 		= Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); 
					НовСтр.Сумма							= ТоварУслугаСвойство.price;
					НовСтр.УникальныйИдентификаторСтроки 	= Новый УникальныйИдентификатор;
					НовСтр.Размещение 						= ?(ЗначениеЗаполнено(Заказ.СкладГруппа), Заказ.СкладГруппа, Неопределено);
					НовСтр.СерияНоменклатуры 				= НайтиСериюПоВладельцу(СокрЛП(стрСерия), Номенклатура);
					
					ОбработкаТабличныхЧастей.ПриИзмененииСуммыТабЧасти(НовСтр, Заказ, глЗначениеПеременной("глТекущийПользователь"),,истина, ,истина, "Товары");
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтр, Заказ);
				КонецЦикла;
				
			Иначе
				НовСтр 					= Заказ.Товары.Добавить();
				НовСтр.Номенклатура 	= Номенклатура;
				НовСтр.СтавкаНДС						= СтавкаНДС;
				НовСтр.Количество 						= ТоварУслугаСвойство.qty;
				НовСтр.Коэффициент						= 1;
				НовСтр.ЕдиницаИзмерения					= Номенклатура.ЕдиницаХраненияОстатков;
				НовСтр.ХарактеристикаНоменклатуры 		= Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); 
				НовСтр.Сумма							= ТоварУслугаСвойство.total;
				НовСтр.УникальныйИдентификаторСтроки 	= Новый УникальныйИдентификатор;
				НовСтр.Размещение 						= ?(ЗначениеЗаполнено(Заказ.СкладГруппа), Заказ.СкладГруппа, Неопределено);
				НовСтр.СерияНоменклатуры 				= НайтиСериюПоВладельцу(СокрЛП(Строка(ТоварУслугаСвойство.serial)), Номенклатура);
				
				ОбработкаТабличныхЧастей.ПриИзмененииСуммыТабЧасти(НовСтр, Заказ, глЗначениеПеременной("глТекущийПользователь"),,истина, ,истина, "Товары");
				ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтр, Заказ);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЧек(ЗаказПокупателя)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЧекККМ.Ссылка
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.ЗаказПокупателя = &ЗаказПокупателя";
	Запрос.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя.Ссылка);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если не РезультатЗапроса.Количество() Тогда
		
		ЧекККМ 					 = Документы.ЧекККМ.СоздатьДокумент();
		ЧекККМ.Дата 			 = ТекущаяДата();
		ЧекККМ.ВидОперации 		 = Перечисления.ВидыОперацийЧекККМ.Продажа;
		ЧекККМ.ДокументОснование = ЗаказПокупателя.Ссылка;
		ЧекККМ.ЗаказПокупателя 	 = ЗаказПокупателя.Ссылка;
		ЧекККМ.КассаККМ 		 = Константы.КассаККМБезналичные.Получить();
		ЧекККМ.Комментарий 		 = "#Создан автоматически при загрузке с сайта";
		ЧекККМ.Организация 		 = Справочники.Организации.НайтиПоНаименованию("ВЕЧІР ТЕЛЕКОМ ТОВ");
		ЧекККМ.Ответственный 	 = ПараметрыСеанса.ТекущийПользователь;
		ЧекККМ.Склад 		     = Справочники.Склады.НайтиПоКоду("S00000285");
		ЧекККМ.СуммаДокумента    = ЗаказПокупателя.СуммаДокумента;
		
		оплаты 				= ЧекККМ.Оплата.Добавить();
		оплаты.ВидОплаты 	= Справочники.ВидыОплатЧекаККМ.НайтиПоКоду("00002");
		оплаты.Сумма 		= ЗаказПокупателя.СуммаДокумента;
		
		Для Каждого Строка из ЗаказПокупателя.товары цикл
			СтрокаЧека = ЧекККМ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЧека,Строка);
		КонецЦикла;
		
		ЧекККМ.Записать();
		ЧекККМ.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция НайтиЗаказПоOrderID(OrderID) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Заказ
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.OrderID = &OrderID";
	
	Запрос.УстановитьПараметр("OrderID", OrderID);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Заказ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьОрганизацию(Оплата, Доставка, Контрагент)
	
	ОрганизацияВЕЧЕР 	= Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")); //Вечир ТОВ					
	
	Если Доставка.method = "Доставка у відділення Нової пошти"
		И Оплата.payment_id = "Оплата при отримані готівкою" Тогда 
		
		Возврат ОрганизацияВЕЧЕР;
		
	КонецЕсли;
	
	Менеджер 			    = РегистрыСведений.СпособыДоставкиОрганизации.СоздатьМенеджерЗаписи();
	Менеджер.СпособДоставки = Оплата.payment_id;
	Менеджер.Прочитать();
	
	Если ЗначениеЗаполнено(Менеджер.Организация)
		и ЗначениеЗаполнено(Контрагент) Тогда 
		
		Возврат Менеджер.Организация;
	КонецЕсли;
	
	Возврат ОрганизацияВЕЧЕР
	
КонецФункции

Функция GetClientVerionGet(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	node_code = Запрос.ПараметрыURL.Получить("node_code");
	
	Узел = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(node_code);
	
	СтрВозврата = Новый Структура("client_version, max_version", Узел.version, СтрЗаменить(Константы.DeviceVersion.Получить(), ".", "_"));
	
	ЗаписьJSON  = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтрВозврата);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьСкладПоФизЛицу(КодФизЛица)
	
	ФизЛицо = Справочники.ФизическиеЛица.НайтиПоКоду(КодФизЛица);
	Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат Справочники.Склады.ПустаяСсылка();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтветственныеЛицаСрезПоследних.СтруктурнаяЕдиница КАК Склад
	|ИЗ
	|	РегистрСведений.ОтветственныеЛица.СрезПоследних(&ТекДата, ФизическоеЛицо = &ФизЛцио) КАК ОтветственныеЛицаСрезПоследних";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ФизЛцио", ФизЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Склад;
	КонецЕсли;
	
	Возврат Справочники.Склады.ПустаяСсылка();
	
КонецФункции

Функция НайтиСериюПоВладельцу(Серия, Владелец)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СерииНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	СерииНоменклатуры.Владелец = &Владелец
	|	И СерииНоменклатуры.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Наименование", Серия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();
	
КонецФункции

Процедура ЗаписатьСнимокЗаказаВЖурнал(Префикс, ЗаказСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		ЗаписьЖурналаРегистрации(
			"Заказы API.СменаСтатуса.Диагностика",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			Префикс + ": заказ не заполнен"
		);
		Возврат;
	КонецЕсли;
	
	ОбЗаказ = ЗаказСсылка.ПолучитьОбъект();
	
	КоличествоСтрокСРазмещением = 0;
	КоличествоСтрокССерией = 0;
	
	Для Каждого СтрТовары Из ОбЗаказ.Товары Цикл
		
		Если ЗначениеЗаполнено(СтрТовары.Размещение) Тогда
			КоличествоСтрокСРазмещением = КоличествоСтрокСРазмещением + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрТовары.СерияНоменклатуры) Тогда
			КоличествоСтрокССерией = КоличествоСтрокССерией + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстДвижений = ПолучитьТекстДвиженийДокумента(ЗаказСсылка);
	
	Текст =
		Префикс
		+ Символы.ПС + "Ссылка: " + Строка(ЗаказСсылка)
		+ Символы.ПС + "Номер: " + ОбЗаказ.Номер
		+ Символы.ПС + "Дата: " + Строка(ОбЗаказ.Дата)
		+ Символы.ПС + "OrderID: " + Строка(ОбЗаказ.OrderID)
		+ Символы.ПС + "Проведен: " + Строка(ОбЗаказ.Проведен)
		+ Символы.ПС + "СтатусИМ: " + Строка(ОбЗаказ.СтатусИМ)
		+ Символы.ПС + "Строк с Размещением: " + Строка(КоличествоСтрокСРазмещением)
		+ Символы.ПС + "Строк с Серией: " + Строка(КоличествоСтрокССерией)
		+ Символы.ПС + "Движения:"
		+ Символы.ПС + ТекстДвижений;
	
	ЗаписьЖурналаРегистрации(
		"Заказы API.СменаСтатуса.Диагностика",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Текст
	);
	
КонецПроцедуры


Функция ПолучитьТекстДвиженийДокумента(ДокументСсылка) Экспорт
	
	Текст = "";
	
	Для Каждого МетаРегистр Из Метаданные.РегистрыНакопления Цикл
		
		ИмяРегистра = МетаРегистр.Имя;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР
		|			КОГДА Регистр.Активность
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Активных
		|ИЗ
		|	РегистрНакопления." + ИмяРегистра + " КАК Регистр
		|ГДЕ
		|	Регистр.Регистратор = &Регистратор";
		
		Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
		
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если Выборка.Следующий() Тогда
			
			Если Выборка.Всего > 0 Тогда
				
				Текст = Текст
					+ Символы.ПС
					+ ИмяРегистра
					+ ": всего=" + Строка(Выборка.Всего)
					+ ", активных=" + Строка(Выборка.Активных);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПустаяСтрока(Текст) Тогда
		Текст = "движений по документу не найдено";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции


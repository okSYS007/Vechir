функция ЕстьОстаток(ТаблицаТоваров,Номенклатура,Серия) 
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура",Номенклатура);
	СтруктураПоиска.Вставить("СерияНоменклатуры",Серия);
	
	НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() Тогда
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОстаткиНаСкладе(Склад) 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Склад,
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.Качество,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток,
	|	ТоварыНаСкладахОстатки.СерияНоменклатуры
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	|ГДЕ
	|	ТоварыНаСкладахОстатки.Склад = &Склад";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапросаНоменклатура = Запрос.Выполнить().Выгрузить();
	
	
	Возврат РезультатЗапросаНоменклатура;
	
КонецФункции



Функция СписокСотрудниковGET(Запрос) 
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка,
	|	ФизическиеЛица.Код,
	|	ФизическиеЛица.Наименование
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛица.СрезПоследних КАК ОтветственныеЛица
	|		ПО (ОтветственныеЛица.ФизическоеЛицо = ФизическиеЛица.Ссылка)
	|ГДЕ
	|	ОтветственныеЛица.СтруктурнаяЕдиница ЕСТЬ НЕ NULL 
	|	И ОтветственныеЛица.СтруктурнаяЕдиница ССЫЛКА Справочник.Склады
	|
	|СГРУППИРОВАТЬ ПО
	|	ФизическиеЛица.Ссылка,
	|	ФизическиеЛица.Код,
	|	ФизическиеЛица.Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивСотрудников = Новый массив;
	СтруктураОтвета = Новый Структура;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураСотрудника = Новый Структура;
		СтруктураСотрудника.Вставить("id",ВыборкаДетальныеЗаписи.Код);
		
		СтруктураСотрудника.Вставить("name",ВыборкаДетальныеЗаписи.Наименование);
		
		МассивСотрудников.Добавить(СтруктураСотрудника);
		
	КонецЦикла;
	

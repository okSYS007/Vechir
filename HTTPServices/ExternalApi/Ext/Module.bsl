Функция versionget(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	
	node_code = Запрос.ПараметрыURL.Получить("node_code");
	user_version = Запрос.ПараметрыURL.Получить("version");
	user_version = СтрЗаменить(user_version, "_", ".");	
	
	Узел = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(node_code);
	УзелОбъект = Узел.ПолучитьОбъект();
	УзелОбъект.version = user_version;
	УзелОбъект.Записать();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(vrgМобильныеСклад.version) КАК version
	|ИЗ
	|	ПланОбмена.vrgМобильныеСклад КАК vrgМобильныеСклад");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Константы.DeviceVersion.Установить(Выборка.version);
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ПроверятьСтруктуру = Истина;
	ЗаписьJSON.ЗаписатьНачалоОбъекта();	
	ЗаписьJSON.ЗаписатьИмяСвойства("max_version");
	ЗаписьJSON.ЗаписатьЗначение(СтрЗаменить(Константы.DeviceVersion.Получить(), ".", "_"));	
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	
	СтрокаJSON = ЗаписьJSON.Закрыть();	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	Возврат Ответ;
КонецФункции

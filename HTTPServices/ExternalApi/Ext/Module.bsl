
Функция ДанныеСотрудникаGET(Запрос)
	
	Попытка
		
		КодФизЛица = Запрос.ПараметрыЗапроса.Получить("employee_id");
		
		СтруктураОтвета = Новый Структура;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныеЛицаСрезПоследних.Период,
		|	ОтветственныеЛицаСрезПоследних.СтруктурнаяЕдиница,
		|	ОтветственныеЛицаСрезПоследних.ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.ОтветственныеЛица.СрезПоследних КАК ОтветственныеЛицаСрезПоследних
		|ГДЕ
		|	ОтветственныеЛицаСрезПоследних.ФизическоеЛицо.Код = &Код";
		
		Запрос.УстановитьПараметр("Код", КодФизЛица);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			СтруктураСотрудника = Новый Структура;
			СтруктураСотрудника.Вставить("id",ВыборкаДетальныеЗаписи.ФизическоеЛицо.код);
			СтруктураСотрудника.Вставить("name",ВыборкаДетальныеЗаписи.ФизическоеЛицо.Наименование);
			СтруктураСотрудника.Вставить("position","");
			
			СтруктураОтвета.Вставить("employee",СтруктураСотрудника);
			
			СтруктураСклада = Новый Структура;
			СтруктураСклада.Вставить("id",ВыборкаДетальныеЗаписи.СтруктурнаяЕдиница.Код);
			СтруктураСклада.Вставить("name",ВыборкаДетальныеЗаписи.СтруктурнаяЕдиница.Наименование);
			
			СтруктураОтвета.Вставить("warehouse",СтруктураСклада); 
			
			
			
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТоварыНаСкладахОстатки.Склад,
			|	ТоварыНаСкладахОстатки.Номенклатура,
			|	ТоварыНаСкладахОстатки.Качество,
			|	ТоварыНаСкладахОстатки.КоличествоОстаток,
			|	ТоварыНаСкладахОстатки.СерияНоменклатуры
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
			|ГДЕ
			|	ТоварыНаСкладахОстатки.Склад = &Склад";
			
			Запрос.УстановитьПараметр("Склад", ВыборкаДетальныеЗаписи.СтруктурнаяЕдиница);
			
			РезультатЗапросаНоменклатура = Запрос.Выполнить().Выгрузить();
			
			
			МассивНоменклатуры = Новый Массив;
			
			
			
			
			
			
			Для Каждого СтрНоменклатуры из РезультатЗапросаНоменклатура Цикл
				
				СтруктураНоменклатуры = Новый Структура;
				СтруктураНоменклатуры.Вставить("id",СтрНоменклатуры.Номенклатура.код);
				СтруктураНоменклатуры.Вставить("guid",XMLСтрока(СтрНоменклатуры.Номенклатура));
				СтруктураНоменклатуры.Вставить("name",СтрНоменклатуры.Номенклатура.Наименование);
				СтруктураНоменклатуры.Вставить("quantity",СтрНоменклатуры.КоличествоОстаток);
				СтруктураНоменклатуры.Вставить("serial_numbers",Строка(СтрНоменклатуры.СерияНоменклатуры));
				
				
				
				
				
				МассивНоменклатуры.Добавить(СтруктураНоменклатуры);	
				
				
			КонецЦикла;
			
			СтруктураОтвета.Вставить("inventory",МассивНоменклатуры); 
			СтруктураОтвета.Вставить("description","");
			
			
		Иначе
			
			СтруктураСотрудника = Новый Структура;
			СтруктураСотрудника.Вставить("id","");
			СтруктураСотрудника.Вставить("name","");
			СтруктураСотрудника.Вставить("position","");
			
			СтруктураОтвета.Вставить("employee",СтруктураСотрудника);
			
			СтруктураСклада = Новый Структура;
			СтруктураСклада.Вставить("id","");
			СтруктураСклада.Вставить("name","");
			
			СтруктураОтвета.Вставить("warehouse",СтруктураСклада);
			МассивНоменклатуры = Новый Массив;
			СтруктураОтвета.Вставить("inventory",МассивНоменклатуры); 
			СтруктураОтвета.Вставить("description"," Не найден сотрудник с таким employee_id !!!");
			
			
			
			
			
		КонецЕсли;
		
		
		
		
		
		
	Исключение
		СтруктураОтвета.Вставить("IsError",Истина);
		СтруктураОтвета.Вставить("Error",ОписаниеОшибки());
		
		ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		Возврат Ответ;			
		
	КонецПопытки;
	
	СтруктураОтвета.Вставить("IsError",Ложь);
	СтруктураОтвета.Вставить("Error","");
	
	ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции


Функция ПолучитьТелоДжСОНИзСтруктуры(СтруктураДанных, УниверсальнаяДата = Ложь) 
	
	Перем СтрокаJSON, НастройкиСериализации;
	
	Если УниверсальнаяДата Тогда
		НастройкиСериализации = Новый НастройкиСериализацииJSON;
		НастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
	КонецЕсли;
	
	ЗаписьJSON  = Новый ЗаписьJSON;
	
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных, НастройкиСериализации);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаJSON;
	
КонецФункции

Функция ИзменитьТипОплатыЗаказаPATCH(Запрос)
	
	ИдЗаказа = Запрос.ПараметрыЗапроса.Получить("order_id");
	ТипОплаты = Запрос.ПараметрыЗапроса.Получить("payment_type"); 
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("order_id",ИдЗаказа);
	Если ЗначениеЗаполнено(ИдЗаказа) Тогда
		
		Заказ = НайтиЗаказПоИД(ИдЗАказа);
		
	Иначе
		СтруктураОтвета.Вставить("Error","Не указан order_id");
		ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
		
		
		
	КонецЕсли;
	
	Если Заказ <> Неопределено Тогда
		
		ЕстьОплата = ПроверитьОПлатуЗаказа(Заказ);
		
		Если ЕстьОплата Тогда
			
			СтруктураОтвета.Вставить("payment_type",ТипОплаты);
			СтруктураОтвета.Вставить("Error","Невозможно поменять тип оплаты. Заказ уже оплачен ");
			ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
			
			Ответ = Новый HTTPСервисОтвет(200);
			Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
			Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			Возврат Ответ;
			
			
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ТипОплаты) Тогда
			
			Если ТипОплаты = "card" Тогда
				
				
				
				Если Заказ.Организация.Код = "000000005" Тогда
					
					ЗаказОбъект = Заказ.ПолучитьОбъект();
					ЗаказОбъект.Организация = Справочники.Организации.НайтиПоКоду("000000000");
					ЗаполнениеДокументов.ПриИзмененииЗначенияОрганизации(ЗаказОбъект, ЗаказОбъект.мСтруктураПараметровДляПолученияДоговора);
					Если НЕ ЗначениеЗаполнено(ЗаказОбъект.ДоговорКонтрагента) Тогда
						
						ТекущийДоговор = СоздатьДоговорПоПараметрам(ЗаказОбъект.Контрагент, ЗаказОбъект.Организация, ЗаказОбъект.ВалютаДокумента);
						ЗаказОбъект.ДоговорКонтрагента = ТекущийДоговор;
					КонецЕсли;
					
					ЗаказОбъект.СпособОплаты = "Оплата при отримані карткою";
					ЗаказОбъект.Комментарий = СтрЗаменить(ЗаказОбъект.Комментарий,"Метод платежа: Оплата при отримані готівкою","Метод платежа: Оплата при отримані карткою");
					ЗаказОбъект.Записать();
					
					СтруктураОтвета.Вставить("new_payment_type",ТипОплаты);
					СтруктураОтвета.Вставить("status","success");
					
					
					
				Иначе
					СтруктураОтвета.Вставить("payment_type",ТипОплаты);
					СтруктураОтвета.Вставить("Error","Невозможно поменять тип оплаты с card на card ");
					ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
					
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
					Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
					Возврат Ответ;
					
					
					
				КонецЕсли;
			ИначеЕсли ТипОплаты = "cash" Тогда 
				
				
				Если Заказ.Организация.Код = "000000000" Тогда
					
					ЗаказОбъект = Заказ.ПолучитьОбъект();
					ЗаказОбъект.Организация = Справочники.Организации.НайтиПоКоду("000000005");
					ЗаказОбъект.СпособОплаты = "Оплата при отримані готівкою";
					ЗаполнениеДокументов.ПриИзмененииЗначенияОрганизации(ЗаказОбъект, ЗаказОбъект.мСтруктураПараметровДляПолученияДоговора);
					
					Если НЕ ЗначениеЗаполнено(ЗаказОбъект.ДоговорКонтрагента) Тогда
						
						ТекущийДоговор = СоздатьДоговорПоПараметрам(ЗаказОбъект.Контрагент, ЗаказОбъект.Организация, ЗаказОбъект.ВалютаДокумента);
						ЗаказОбъект.ДоговорКонтрагента = ТекущийДоговор;
					КонецЕсли;
					
					
					ЗаказОбъект.Комментарий = СтрЗаменить(ЗаказОбъект.Комментарий,"Метод платежа: Оплата при отримані карткою","Метод платежа: Оплата при отримані готівкою");
					ЗаказОбъект.Записать();
					
					СтруктураОтвета.Вставить("new_payment_type",ТипОплаты);
					СтруктураОтвета.Вставить("status","success");
					
					
					
				Иначе
					СтруктураОтвета.Вставить("payment_type",ТипОплаты);
					СтруктураОтвета.Вставить("Error","Невозможно поменять тип оплаты с cash на cash");
					ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
					
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
					Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
					Возврат Ответ;
					
					
					
				КонецЕсли;
				
				
				
			КонецЕсли;
			
		Иначе
			
			СтруктураОтвета.Вставить("Error","Не указан тип оплаты");
			ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
			
			Ответ = Новый HTTPСервисОтвет(200);
			Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
			Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			Возврат Ответ;	
			
			
		КонецЕсли;
		
		ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;	
	Иначе
		
		СтруктураОтвета.Вставить("Error","Заказ с таким order_id не найден");
		ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
		
		
		
	КонецЕсли;
КонецФункции


Функция ПроверитьОПлатуЗаказа(Заказ) 
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекККМ.Ссылка
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.ЗаказПокупателя = &ЗаказПокупателя";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь
	
	
	
КонецФункции // ()


Функция ИзменитьСтатусЗаказаPATCH(Запрос)
	
	//ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(); 
	
	ЕстьОшибка = Ложь;
	
	//ЧтениеДжСОН = Новый ЧтениеJSON;
	//ЧтениеДжСОН.УстановитьСтроку(ТелоЗапроса);
	//ДанныеДжСОН = ПрочитатьJSON(ЧтениеДжСОН);
	//ЧтениеДжСОН.Закрыть();
	
	ИдЗаказа = Запрос.ПараметрыЗапроса.Получить("order_id");
	Статус = Запрос.ПараметрыЗапроса.Получить("status");
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("order_id",ИдЗаказа);
	Если ЗначениеЗаполнено(ИдЗаказа) Тогда
		
		Заказ = НайтиЗаказПоOrderID(ИдЗАказа);
		
	Иначе
		СтруктураОтвета.Вставить("Error","Не указан order_id");
		ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
		
		
		
	КонецЕсли;
	
	ЗаписатьСнимокЗаказаВЖурнал("ДО смены статуса", Заказ);
	
	СтарыйСтатус = Заказ.СтатусИМ; 
	ЭтоТестДрайвЗаказ = (СтарыйСтатус = Перечисления.СтатусыЗаказаИМ.ТестДрайв);
	
	
	СоотвестивиСтатусов = ПолучитьСоотвествиеСтатусов();
	ПриоритетСтатусо = ПолучитьПриорететСтатусов();
	
	НовыйСтатус = СоотвестивиСтатусов.Получить(Статус);
	
	Если НовыйСтатус <> Неопределено Тогда
		ПриоритетСтарогоСтатуса = ПриоритетСтатусо.Получить(СтарыйСтатус);
		ПриоритетНовогоСтатуса  = ПриоритетСтатусо.Получить(НовыйСтатус);
		
		Если ПриоритетСтарогоСтатуса < ПриоритетНовогоСтатуса Тогда 
			ОбЗаказ = Заказ.ПолучитьОбъект();
			ОбЗаказ.СтатусИМ = НовыйСтатус;
			Если НовыйСтатус = Перечисления.СтатусыЗаказаИМ.ТестДрайв Тогда
				ЭтоТестДрайвЗаказ = Истина;
				ry_ОбщиеПроцедуры.УстановитьПризнакТестДрайв(ОбЗаказ);
			КонецЕсли;
			
			СтруктураОтвета.Вставить("NewStatus",Статус);
		Иначе
			СтруктураОтвета.Вставить("IsError",Истина);
			СтруктураОтвета.Вставить("Error","Нельзя изменить статус с "+СтарыйСтатус+" на Статус "+Статус);
			
			ЕстьОшибка = Истина;
		КонецЕсли; 
	Иначе	
		СтруктураОтвета.Вставить("IsError",Истина);
		СтруктураОтвета.Вставить("Error","Не найден Статус "+Статус);
		ЕстьОшибка = Истина;
	КонецЕсли;
	
	Попытка 
		Если Не ЕстьОшибка Тогда
			ОбЗаказ.Записать(РежимЗаписиДокумента.Проведение);
			ЗаписатьСнимокЗаказаВЖурнал("ПОСЛЕ смены статуса", ОбЗаказ.Ссылка);
		КонецЕсли;
	Исключение
		СтруктураОтвета.Вставить("IsError",Истина);
		СтруктураОтвета.Вставить("Error","Не удалось обновить заказ");
		СтруктураОтвета.Вставить("StatusUpdated",Ложь);
		ДжсонОтвет = ПолучитьТелоДжСОНИзСтруктуры(СтруктураОтвета);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ДжсонОтвет, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

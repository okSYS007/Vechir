Функция ЗаменаИУкр(СтрокаЗамены) Экспорт
	
	Строка1 = СтрЗаменить(СтрокаЗамены, "і", "i"); 
	Строка2 = СтрЗаменить(Строка1, "І", "I");
	Возврат Строка2;
	

		Источник.Дата = НачалоДня(Источник.Дата) + 60*60*9;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказПоставщику") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	
		Источник.Дата = НачалоДня(Источник.Дата) + 60*60*7;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	
		Источник.Дата = НачалоДня(Источник.Дата) + 60*60*8;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходныйОрдерНаТовары") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	
		Источник.Дата = НачалоДня(Источник.Дата) + 60*60*7 + 30*60;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПлатежноеПоручениеИсходящее") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	
		Источник.Дата = НачалоДня(Источник.Дата) + 60*60*7;
		
	////ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ОприходованиеТоваров") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	////
	////	Источник.Дата = НачалоДня(Источник.Дата) + 60*60*6;
	////	
	////ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	////
	////	Источник.Дата = НачалоДня(Источник.Дата) + 60*60*6;
	////	
	////ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	////
	////	Источник.Дата = НачалоДня(Источник.Дата) + 60*60*8;
	
	КонецЕсли;
	
	//ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.НалоговаяНакладная") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.НалоговаяНакладная") И Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
		
		////Если ЗначениеЗаполнено(Источник.ДокументОснование) Тогда 
		////	Источник.Дата = Источник.ДокументОснование.Дата;
		////КонецЕсли;
		
// ТипПричиныНевыдачиПокупателю		
		Если Источник.ТипПричиныНевыдачиПокупателю = 0 Тогда
			мВалютаРегламентированногоУчета   = глЗначениеПеременной("ВалютаРегламентированногоУчета");
			Если Источник.ВидОперации = Перечисления.ВидыОперацийНалоговаяНакладная.РаботыОтНерезидента Тогда
				Если глЗначениеПеременной("ДатаВступленияВСилуПриказа1379") > Источник.Дата  Тогда
					Источник.ТипПричиныНевыдачиПокупателю = 2;
				Иначе	
					Источник.ТипПричиныНевыдачиПокупателю = 14;
				КонецЕсли;
			ИначеЕсли Источник.ВидОперации = Перечисления.ВидыОперацийНалоговаяНакладная.СводнаяНаПревышениеБазыНадЦенойПоставки Тогда
				Источник.ТипПричиныНевыдачиПокупателю = 15;
			ИначеЕсли  НЕ Источник.ВалютаДокумента = мВалютаРегламентированногоУчета
				И Источник.ДоговорКонтрагента.Внешнеэкономический = Истина
				И НЕ Источник.ВидОперации = Перечисления.ВидыОперацийНалоговаяНакладная.РаботыОтНерезидента Тогда
				ТипПричиныНевыдачиПокупателю = 7;
			ИначеЕсли Источник.ВидОперации = Перечисления.ВидыОперацийНалоговаяНакладная.УсловнаяПродажа Тогда
				Если глЗначениеПеременной("ДатаВступленияВСилуПриказа1379") > Источник.Дата  Тогда
					Источник.ТипПричиныНевыдачиПокупателю = 4;
				Иначе	
					Источник.ТипПричиныНевыдачиПокупателю = 13;
				КонецЕсли;
			ИначеЕсли Источник.ВидОперации = Перечисления.ВидыОперацийНалоговаяНакладная.УсловнаяПродажаСписаниеОС Тогда
			    Источник.ТипПричиныНевыдачиПокупателю = 5;
			ИначеЕсли Источник.ВидОперации = Перечисления.ВидыОперацийНалоговаяНакладная.ИтоговаяРозницаОблагаемыеОперации 
				  ИЛИ Источник.ВидОперации = Перечисления.ВидыОперацийНалоговаяНакладная.ИтоговаяРозницаОсвобожденныеОперации Тогда
			    Источник.ТипПричиныНевыдачиПокупателю = 11;
			Иначе
				СхемыНалогообложения = РегистрыСведений.СхемыНалогообложенияКонтрагентов.СрезПоследних(Источник.Дата, Новый Структура("Контрагент", Источник.Контрагент));
				Если СхемыНалогообложения.Количество() = 0 Тогда
					ПлательщикНДС = Истина;
				Иначе
					ПлательщикНДС = СхемыНалогообложения[0].СхемаНалогообложения.НДС;
				КонецЕсли;

				Если НЕ ЗначениеЗаполнено(Источник.Контрагент.ИНН)
					ИЛИ Найти("0123456789",Лев(СокрЛ(Источник.Контрагент.ИНН),1)) = 0
					ИЛИ НЕ ПлательщикНДС Тогда		
					Источник.ТипПричиныНевыдачиПокупателю = 2;
				Иначе	
					Источник.ТипПричиныНевыдачиПокупателю = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
// ТипПричиныНевыдачиПокупателю		

	КонецЕсли;
	

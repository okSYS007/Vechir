		СтрокаВыписки.sumeq 	= Формат(Документ.СуммаДокумента,"ЧГ=;ЧРД=.");
		СтрокаВыписки.prizn 	= ЗаменаИУкр(СокрЛП(НазначениеПлатежа));
		СтрокаВыписки.kod_val   = Документ.ВалютаДокумента.Код;
		СтрокаВыписки.operat 	= "2";
		//СтрокаВыписки.dat_gn 	= ;
		//СтрокаВыписки.dat_arc 	= ;
		//СтрокаВыписки.tim_pr 	= ;
				

Процедура ОтправитьСтатусы(Источник)
	
	СоответствиеСтатусов = Новый Соответствие;
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыЗаказаИМ.ВРаботеМенеджера, "2");
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыЗаказаИМ.ВРаботеСервисныхИнженеров, "2");
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыЗаказаИМ.ВРаботеЮО, "2");
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыЗаказаИМ.Отправлено, "11");
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыЗаказаИМ.Завершен, "5");

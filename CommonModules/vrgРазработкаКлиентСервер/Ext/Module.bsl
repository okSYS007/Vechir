Процедура ОтправкаУведомлений() Экспорт
		Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронноеПисьмо.Ссылка
	               |ИЗ
	               |	Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
	               |ГДЕ
	               |	ЭлектронноеПисьмо.Уведомление
	               |	И ЭлектронноеПисьмо.ДатаОтправления = &ДатаОтправления
	               |	И ЭлектронноеПисьмо.УчетнаяЗапись = &УчетнаяЗапись";
	Запрос.УстановитьПараметр("ДатаОтправления",Дата(1,1,1));
	Запрос.УстановитьПараметр("УчетнаяЗапись",Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоКоду("000000001"));

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультат из РезультатЗапроса цикл
		Об = СтрокаРезультат.ссылка.ПолучитьОбъект();	
		об.ОтправитьПисьмо();
		Об.Записать();
	КонецЦикла;


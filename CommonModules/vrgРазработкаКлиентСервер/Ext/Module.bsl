		|	ВТ_ИтогСГруппировкой.ЕдиницаИзмерения,
		|	ВТ_ИтогСГруппировкой.Количество,
		|	ВТ_ИтогСГруппировкой.Номенклатура,
		|	ВТ_ИтогСГруппировкой.Размещение,
		|	ВТ_ИтогСГруппировкой.Сумма,
		|	ВТ_ИтогСГруппировкой.СуммаНДС,
		|	ВТ_ИтогСГруппировкой.ХарактеристикаНоменклатуры,
		|	ВТ_ИтогСГруппировкой.Цена,
		|	ВТ_ИтогСГруппировкой.СерияНоменклатуры
		|ИЗ
		|	ВТ_ИтогСГруппировкой КАК ВТ_ИтогСГруппировкой
		|ГДЕ
		|	(ВТ_ИтогСГруппировкой.Цена <> 0
		|			ИЛИ ВТ_ИтогСГруппировкой.Сумма <> 0
		|			ИЛИ ВТ_ИтогСГруппировкой.СуммаНДС <> 0
		|			ИЛИ ВТ_ИтогСГруппировкой.Количество <> 0)";

	Запрос.УстановитьПараметр("ТоварыОб", ТоварыОб);
	Запрос.УстановитьПараметр("ТоварыСсылка", ТоварыСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой(); //Товары изменились
	
КонецФункции
	


	Если НЕ ЗначениеЗаполнено(Источник.СтатусИМ)
		ИЛИ СоответствиеСтатусов[Источник.СтатусИМ] = Неопределено 
		ИЛИ Источник.СтатусИМ = Источник.Ссылка.СтатусИМ Тогда  //Если статус не менялся то и не надо отправлять еще раз
		Возврат;
	КонецЕсли;
	
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("vstore.net.ua");
	
	Если СтрПодключение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Url = СтрПодключение.Адрес;
	
	ОрдерИД = Сред(Источник.Комментарий, Найти(Источник.Комментарий, "№") +2, 5);
	
	Попытка
		темп_ = Число(Сред(Источник.Комментарий, Найти(Источник.Комментарий, "№") +2, 5));
	Исключение
		Возврат;
	КонецПопытки;
	
	Токен = "";
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки = Новый Соответствие;
	HTTPЗапрос = Новый HTTPЗапрос("index.php?route=api/order_status", Заголовки);
	
	token = ПланыОбмена.Website.НайтиПоНаименованию("vstore.net.ua", Истина).Токен;
	
	ВремГраница = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	ТелоЗапроса = Новый ТекстовыйДокумент();
	ТелоЗапроса.РазделительСтрок = Символы.CR + Символы.LF;
	
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
	ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""token"";");
	ТелоЗапроса.ДобавитьСтроку("");
	ТелоЗапроса.ДобавитьСтроку(token);
	
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
	ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""order_id"";");
	ТелоЗапроса.ДобавитьСтроку("");
	ТелоЗапроса.ДобавитьСтроку(СтрЗаменить(СокрЛП(Сред(Источник.Комментарий, Найти(Источник.Комментарий, "№") +2, 5)), " ", "")); 
	
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
	ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""status_id"";");
	ТелоЗапроса.ДобавитьСтроку("");
	ТелоЗапроса.ДобавитьСтроку(СоответствиеСтатусов[Источник.СтатусИМ]);
	
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница + "--");
	
	ТелоЗапросаСтрока = ТелоЗапроса.ПолучитьТекст();
	
	HTTPЗапрос.Заголовки["Content-Type"] = "multipart/form-data; boundary=" + ВремГраница;
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаСтрока, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(мОтвет);
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЗаписьЖурналаРегистрации("vstore.net.ua",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось записать статус в заказе №" + Источник.Номер);
	КонецПопытки;
	ЧтениеJSON.Закрыть();
	

		ТаблицаДанных = ПодготовитьТаблицуСДаннымиDBF(ПутьКФайлу);
		УдалитьФайлы(ПутьКФайлу);
	Иначе
		ТаблицаДанных = Новый ТаблицаЗначений;
		ТаблицаДанных.Колонки.Добавить("ACCOUNTA");
		ТаблицаДанных.Колонки.Добавить("ACCOUNTB");
		ТаблицаДанных.Колонки.Добавить("NAMEB");
		ТаблицаДанных.Колонки.Добавить("OKPOB");
		ТаблицаДанных.Колонки.Добавить("MFOB");
		ТаблицаДанных.Колонки.Добавить("SUMMAVKOP");
		ТаблицаДанных.Колонки.Добавить("GOAL");
		ТаблицаДанных.Колонки.Добавить("VDATE");
		ТаблицаДанных.Колонки.Добавить("DOC_DATE");
		ТаблицаДанных.Колонки.Добавить("DOC_NUM");	
		ТаблицаДанных.Колонки.Добавить("TAX_XML");
	КонецЕсли;	
	
	Для каждого Документ Из МассивДокументов Цикл
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаСрез", Документ.Дата);
		Запрос.УстановитьПараметр("Организация", Документ.Организация);
		Запрос.Текст =
				"ВЫБРАТЬ
				|	КодыОрганизацииСрезПоследних.КодПоЕДРПОУ
				|ИЗ
				|	РегистрСведений.КодыОрганизации.СрезПоследних(&ДатаСрез, Организация = &Организация) КАК КодыОрганизацииСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если НЕ Выборка.Следующий() Тогда
			Сообщить("РегистрСведений.КодыОрганизации, не найдена запись.");
			Продолжить;
		КонецЕсли;	
		
		НазначениеПлатежа = Документ.НазначениеПлатежа;
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, Символы.ПС, " ");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, Символы.Таб, " ");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, Символы.ВТаб, " ");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, Символы.ВК, " ");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, Символы.НПП, " ");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, Символы.ПФ, " ");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, "'", "'");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, "«", """");
		НазначениеПлатежа = СтрЗаменить(НазначениеПлатежа, "»", """");
		
		НазначениеПлатежаНалоги = СформироватьСтрокуXML(Документ);//Строка XML
		
		СтрокаВыписки = ТаблицаДанных.Добавить();
		СтрокаВыписки.ACCOUNTA 	= Строка(Документ.СчетОрганизации.НомерСчета);
		СтрокаВыписки.ACCOUNTB 	= Строка(Документ.СчетКонтрагента.НомерСчета);
		
		Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
			СтрокаВыписки.OKPOB = ?(Строка(Документ.Контрагент.КодПоЕДРПОУ)="" или Строка(Документ.Контрагент.КодПоЕДРПОУ)=0,Строка(Документ.Контрагент.ИНН),Строка(Документ.Контрагент.КодПоЕДРПОУ));
			СтрокаВыписки.NAMEB = ЗаменаИУкр(Документ.Контрагент.Наименование);
		Иначе
			СтрокаВыписки.OKPOB = Строка(Выборка.КодПоЕДРПОУ);
			СтрокаВыписки.NAMEB = ЗаменаИУкр(Документ.Организация.Наименование);
		КонецЕсли;
		
		СтрокаВыписки.MFOB 		= Строка(Документ.СчетКонтрагента.Банк.Код);
		СтрокаВыписки.SUMMAVKOP = Формат(Документ.СуммаДокумента*100,"ЧГ=;ЧРД=.");
		СтрокаВыписки.GOAL 		= ЗаменаИУкр(СокрЛП(НазначениеПлатежа));
		СтрокаВыписки.VDATE 	= "";
		СтрокаВыписки.DOC_DATE 	= Формат(Документ.Дата, "ДЛФ=Д");
		СтрокаВыписки.DOC_NUM 	= ОбщегоНазначения.ПолучитьНомерНаПечать(Документ);
		СтрокаВыписки.TAX_XML 	= СтрЗаменить(СтрЗаменить(НазначениеПлатежаНалоги, Символы.ПС, ""), Символы.Таб,"");
		
	КонецЦикла;	
		
	ВыгрузкаВDBF(ТаблицаДанных, ПутьКФайлу)		
	
КонецПроцедуры


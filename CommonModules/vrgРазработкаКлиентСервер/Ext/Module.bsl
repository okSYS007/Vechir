Процедура ВыгрузитьПоМассивуДокументов(МассивДокументов, СчетОрганизации) Экспорт
	
	ВариантВыгрузки = СчетОрганизации.Банк.ВариантВыгрузкиКлиентБанк;
	
	Если ВариантВыгрузки = Перечисления.ВариантВыгрузкиКлиентБанк.Укргазбанк Тогда
		
		ВыгрузитьУкргазбанк(МассивДокументов, СчетОрганизации);	
		
	ИначеЕсли ВариантВыгрузки = Перечисления.ВариантВыгрузкиКлиентБанк.КредитДнепр Тогда
		
		ВыгрузитьКредитДнепр(МассивДокументов, СчетОрганизации);
		
	ИначеЕсли ВариантВыгрузки = Перечисления.ВариантВыгрузкиКлиентБанк.Монобанк Тогда	
		
		ВыгрузитьМонобанк(МассивДокументов, СчетОрганизации);
		
	Иначе
		
		Сообщить("Нет программы для выгрузки");
		Возврат;
		
	КонецЕсли; 	
	
	
КонецПроцедуры

Процедура ВыгрузитьУкргазбанк(МассивДокументов, СчетОрганизации)
	
	ПутьФайлаВыгрузки = СчетОрганизации.Банк.ПутьФайлаВыгрузки;
		
	Если НЕ ЗначениеЗаполнено(ПутьФайлаВыгрузки) Тогда
		Сообщить("Не заполнен ПутьФайлаВыгрузки в Банке справочника Банковские счета.");
		Возврат;
	КонецЕсли;	
	
	ПутьКаталог = ПутьФайлаВыгрузки + "\"+СчетОрганизации.Владелец+"\"+СчетОрганизации.Банк;
	ПутьКаталог = СтрЗаменить(ПутьКаталог,Символ(34),"");
	СоздатьКаталог(ПутьКаталог);
	ПутьКФайлу = ПутьКаталог+"\export.xls";
	
	ТабДокумент = Новый ТабличныйДокумент;
	ФайлСуществует = ФайлСуществует(ПутьКФайлу);
	Если ФайлСуществует Тогда
		ТаблицаДанных = ПодготовитьТаблицуСДанными(ПутьКФайлу);
		УдалитьФайлы(ПутьКФайлу);
	Иначе	
		ТаблицаДанных = Новый ТаблицаЗначений;
		ТаблицаДанных.Колонки.Добавить("FIELD_CUST_BANK_CODE");
		ТаблицаДанных.Колонки.Добавить("FIELD_CUST_ACCOUNT");
		ТаблицаДанных.Колонки.Добавить("FIELD_CUST_IBAN");
		ТаблицаДанных.Колонки.Добавить("FIELD_BENEF_BANK_CODE");
		ТаблицаДанных.Колонки.Добавить("FIELD_BENEF_ACCOUNT");
		ТаблицаДанных.Колонки.Добавить("FIELD_BENEF_IBAN");
		ТаблицаДанных.Колонки.Добавить("FIELD_OPERATION_TYPE");
		ТаблицаДанных.Колонки.Добавить("FIELD_AMOUNT");
		ТаблицаДанных.Колонки.Добавить("FIELD_DOCUMENT_TYPE");
		ТаблицаДанных.Колонки.Добавить("FIELD_NUMBER");
		ТаблицаДанных.Колонки.Добавить("FIELD_CURRENCY_NUMBER");
		ТаблицаДанных.Колонки.Добавить("FIELD_DOCUMENT_DATE");
		ТаблицаДанных.Колонки.Добавить("FIELD_VALUE_DATE");
		ТаблицаДанных.Колонки.Добавить("FIELD_CUST_NAME");
		ТаблицаДанных.Колонки.Добавить("FIELD_BENEF_NAME");
		ТаблицаДанных.Колонки.Добавить("FIELD_PURPOSE");
		ТаблицаДанных.Колонки.Добавить("FIELD_ADDITIONAL_DATA");
		ТаблицаДанных.Колонки.Добавить("FIELD_PURPOSE_CODE");
		ТаблицаДанных.Колонки.Добавить("FIELD_EMPTY_COLUMN");
		ТаблицаДанных.Колонки.Добавить("FIELD_CUST_TAX_CODE");
		ТаблицаДанных.Колонки.Добавить("FIELD_BENEF_TAX_CODE");
		ТаблицаДанных.Колонки.Добавить("FIELD_EXT_DOCUMENT_NUMBER");
		ТаблицаДанных.Колонки.Добавить("FIELD_VAT_TYPE");
	КонецЕсли;
	
	Для каждого Документ Из МассивДокументов Цикл
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаСрез", Документ.Дата);
		Запрос.УстановитьПараметр("Организация", Документ.Организация);
		Запрос.Текст =
				"ВЫБРАТЬ
				|	КодыОрганизацииСрезПоследних.КодПоЕДРПОУ
				|ИЗ
				|	РегистрСведений.КодыОрганизации.СрезПоследних(&ДатаСрез, Организация = &Организация) КАК КодыОрганизацииСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если НЕ Выборка.Следующий() Тогда
			Сообщить("РегистрСведений.КодыОрганизации, не найдена запись.");
			Продолжить;
		КонецЕсли;	
		
		СтрокаВыписки = ТаблицаДанных.Добавить();
		СтрокаВыписки.FIELD_CUST_BANK_CODE 	= Строка(Документ.СчетОрганизации.Банк.Код);
		СтрокаВыписки.FIELD_CUST_IBAN 		= Строка(Документ.СчетОрганизации.НомерСчета);
		СтрокаВыписки.FIELD_BENEF_BANK_CODE = Строка(Документ.СчетКонтрагента.Банк.Код);
		СтрокаВыписки.FIELD_BENEF_IBAN 		= Строка(Документ.СчетКонтрагента.НомерСчета);
		ДатаБезФормат 						= Формат(Документ.СуммаДокумента, "ЧДЦ=2");
		СтрокаВыписки.FIELD_AMOUNT 			= СтрЗаменить(ДатаБезФормат,Символы.НПП,"");
		
		Если Документ.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			СтрокаВыписки.FIELD_DOCUMENT_TYPE = "1";
		КонецЕсли;	
		
		Если Документ.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду(980) Тогда
			СтрокаВыписки.FIELD_CURRENCY_NUMBER = "UAH";
		ИначеЕсли Документ.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду(840) Тогда
			СтрокаВыписки.FIELD_CURRENCY_NUMBER = "USD";
		ИначеЕсли Документ.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду(978) Тогда
			СтрокаВыписки.FIELD_CURRENCY_NUMBER = "EUR";
		КонецЕсли;	
		
		ДатаДень							= ?(День(Документ.Дата) < 10,"'0" + День(Документ.Дата), Строка(День(Документ.Дата)));
		ДатаМесяц							= ?(Месяц(Документ.Дата) < 10,"0" + Месяц(Документ.Дата), Строка(Месяц(Документ.Дата)));
		ДатаГод								= Формат(Год(Документ.Дата), "ЧГ=0");
		СтрокаВыписки.FIELD_DOCUMENT_DATE	= ДатаДень + ДатаМесяц + ДатаГод;
		СтрокаВыписки.FIELD_CUST_NAME 		= Документ.Организация.Наименование;
		СтрокаВыписки.FIELD_PURPOSE 		= ЗаменаИУкр(Документ.НазначениеПлатежа);
		СтрокаВыписки.FIELD_CUST_TAX_CODE 	= Строка(Выборка.КодПоЕДРПОУ);
		Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
			//Дандали В. 26.12.2023 поле должно заполняться как строка т.к. в некоторых ЕДРПОУ есть лидирующие нули.
			СтрокаВыписки.FIELD_BENEF_TAX_CODE 	= Строка(Документ.Контрагент.КодПоЕДРПОУ);
			СтрокаВыписки.FIELD_BENEF_NAME 		= ЗаменаИУкр(Документ.Контрагент.Наименование);
		Иначе
			СтрокаВыписки.FIELD_BENEF_TAX_CODE 	= Строка(Выборка.КодПоЕДРПОУ);
			СтрокаВыписки.FIELD_BENEF_NAME 		= ЗаменаИУкр(Документ.Организация.Наименование);
		КонецЕсли;	
		
		Если Документ.РасшифровкаПлатежа[0].СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
			СтрокаВыписки.FIELD_VAT_TYPE 	= "0";
		ИначеЕсли Документ.РасшифровкаПлатежа[0].СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
			СтрокаВыписки.FIELD_VAT_TYPE 	= "1";
		КонецЕсли;
	
	КонецЦикла;
	
	ВыгрузкаВЭксель(ТаблицаДанных, ПутьКФайлу);
	
КонецПроцедуры

Процедура ВыгрузитьКредитДнепр(МассивДокументов, СчетОрганизации)
	
	ПутьФайлаВыгрузки = СчетОрганизации.Банк.ПутьФайлаВыгрузки;
		
	Если НЕ ЗначениеЗаполнено(ПутьФайлаВыгрузки) Тогда
		Сообщить("Не заполнен ПутьФайлаВыгрузки в Банке справочника Банковские счета.");

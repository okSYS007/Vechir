	//Дандали В. 03.11.2023
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьСтрокуXML(Документ)
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(); 
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("Tax"); 
	ЗаписьXML.ЗаписатьАтрибут("TaxPayTypeCode", СтрЗаменить(Документ.ТипОплатыБюджета.Код, "0", ""));
		ЗаписьXML.ЗаписатьНачалоЭлемента("Rcrd");
		
		ТелоXML = ПолучитьТелоДляXML(Документ.ТипОплатыБюджета, Документ);
		
		Для Каждого Элем из ТелоXML Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента(Элем.ИмяНалога);
				ЗаписьXML.ЗаписатьТекст(Строка(Элем.ЗначениеНалога));			
			ЗаписьXML.ЗаписатьКонецЭлемента(); 
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); 
		
	ЗаписьXML.ЗаписатьКонецЭлемента(); 	
	
	стрВозврат = ЗаписьXML.Закрыть();
	
	Возврат стрВозврат;
КонецФункции

Функция ПолучитьТелоДляXML(ТипОплатыБюджета, Документ)
	
	СоответствиеНаименований = Новый Соответствие;
	СоответствиеНаименований.Вставить("КодВидаОплаты", "CertId");
	СоответствиеНаименований.Вставить("СуммаНалога", "TaxAmt");
	СоответствиеНаименований.Вставить("НомерСчета", "CtgyDtls");
	СоответствиеНаименований.Вставить("ДополнительнаяИнформация", "AddtlInf");
	СоответствиеНаименований.Вставить("ИнфоПроНалоговоеУведомление", "Ctgy");
	СоответствиеНаименований.Вставить("КодТипаКлассификацияДоходовБюджета", "Tp");
	
	тзВозврата = Новый ТаблицаЗначений;
	тзВозврата.Колонки.Добавить("ИмяНалога", Новый ОписаниеТипов(Новый КвалификаторыСтроки(50)));
	тзВозврата.Колонки.Добавить("ЗначениеНалога", Новый ОписаниеТипов(Новый КвалификаторыСтроки(50)));
	
	Для Каждого Элем из СоответствиеНаименований Цикл
		Попытка
			Если ТипОплатыБюджета[Элем.Ключ] Тогда
	         	НовСтр = тзВозврата.Добавить();
				НовСтр.ИмяНалога = СоответствиеНаименований[Элем.Ключ];
				Если НовСтр.ИмяНалога = "Tp" Тогда
						НовСтр.ЗначениеНалога = Документ[Элем.Ключ].Код;	
				Иначе
					НовСтр.ЗначениеНалога = Документ[Элем.Ключ];
				КонецЕсли;
			КонецЕсли;
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	Возврат тзВозврата;
	
КонецФункции

Функция ФайлСуществует(Знач ПутьКФайлу) Экспорт 
	Файл = Новый Файл(ПутьКФайлу); 
	Возврат Файл.Существует(); 
КонецФункции

Функция ПодготовитьТаблицуСДанными(ПутьКФайлу)
	
	Таблица = Новый ТаблицаЗначений;
	
	//подключаемся к эксель
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ПутьКФайлу);
	Исключение
		Сообщить("Ошибка при открытии файла с помощью Excel! Загрузка не будет произведена!");
		Сообщить(ОписаниеОшибки());
		ЗакрытьExcel(Excel);
		Возврат Таблица;
	КонецПопытки;

	Попытка
		//Открываем необходимый лист
		Excel.Sheets(1).Select();
	Исключение
		//Закрываем Excel
		Excel.ActiveWorkbook.Close();
		Excel = 0;
		Сообщить("Лист №" + 1 + " не найден.");
		ОтменитьТранзакцию();
		ЗакрытьExcel(Excel);
		Возврат Таблица;
	КонецПопытки;

	//Получим количество строк и колонок.
	//В разных версиях Excel получаются по-разному, поэтому сначала определим версию Excel
	Версия = Лев(Excel.Version,Найти(Excel.Version,".")-1);
	Если Версия = "8" Тогда
		ФайлСтрок    = Excel.Cells.CurrentRegion.Rows.Count;
		ФайлКолонок  = Макс(Excel.Cells.CurrentRegion.Columns.Count, 13);
	Иначе
		ФайлСтрок    = Excel.Cells(1,1).SpecialCells(11).Row;
		ФайлКолонок  = Excel.Cells(1,1).SpecialCells(11).Column;
	Конецесли;

	Сч = 1;
	Пока ЗначениеЗаполнено(Excel.Cells(1, Сч).Text) Цикл
		ИмяКолонки      = Excel.Cells(1, Сч).Text;
		ИмяБезПробелов  = ПолучитьИмяКолонки(ИмяКолонки);
		
		Таблица.Колонки.Добавить(ИмяБезПробелов,,ИмяКолонки);

		Сч = Сч + 1;
	КонецЦикла;

	// указываем с какой строки начинать обработку
	Для НС = 2 по ФайлСтрок Цикл
		// Состояние("Файл "+Строка(ИмяФайла)+": Обрабатывается первый лист "+Строка(Формат(?(ФайлСтрок=0,0,((100*НС)/ФайлСтрок)),"ЧЦ=3; ЧДЦ=0"))+" %");
		//ОбработкаПрерыванияПользователя(); //указав данный оператор, цикл можно прервать в любой момент нажатие ctrl+break
		НоваяСтрока = Таблица.Добавить();
		Для НомерКолонки = 1 по Таблица.Колонки.Количество() Цикл
			//заполняем строку значениями
			ТекущееЗначение = Excel.Cells(НС, НомерКолонки).Text;
			ИмяКолонки = Таблица.Колонки[НомерКолонки-1].Имя;
			НоваяСтрока[ИмяКолонки] = ТекущееЗначение;
		КонецЦикла;
	КонецЦикла;

	ЗакрытьExcel(Excel);
	
	Возврат Таблица;
КонецФункции

Функция ПолучитьИмяКолонки(ИмяСтолбца)
	ИмяКолонки = СтрЗаменить(ИмяСтолбца, " ", "_");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "(", "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, ")", "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "-", "");
	Возврат ИмяКолонки;
КонецФункции

Процедура ЗакрытьExcel(Excel)
	Excel.DisplayAlerts = 0; 
	Excel.Quit();
	Excel.DisplayAlerts = 1;
КонецПроцедуры

Процедура ВыгрузкаВЭксель(Т, ПутьКФайлу) Экспорт
	
	Попытка
		XL = Новый COMОбъект ("Excel.Application");
	Исключение
		Сообщить("Ошибка создания Excel.Application");
		Возврат;
	КонецПопытки;
	
	XL.Visible = 0;
	wb = XL.Workbooks.Add();
	sh = wb.Worksheets(1);
	Кол = Т.Колонки.Количество();
	
	Если Кол = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	Для К = 1 По Кол Цикл
		Заг = Т.Колонки[К-1].Имя;
		sh.Cells(1,К).FormulaR1C1 = Заг;
	КонецЦикла;
	
	Для Каждого Стр Из Т Цикл
		Для К = 1 По Кол Цикл
			//Дандали В. 26.12.2023 колока с лидирующими нулями "FIELD_BENEF_TAX_CODE"
			Если К = 21 Тогда
				sh.Cells(Т.Индекс(Стр)+2, К).NumberFormat = "@";
			КонецЕсли;
			Зн = Стр[К-1];
			sh.Cells(Т.Индекс(Стр)+2, К).FormulaR1C1 = Строка(Зн);
		КонецЦикла;
	КонецЦикла;
	sh.Columns.AutoFit();	
	
	Попытка 
		wb.SaveAs(ПутьКФайлу, 51);
	Исключение
		Сообщить(ОписаниеОшибки());    
	КонецПопытки;
	ЗакрытьExcel(XL);  
	
КонецПроцедуры 


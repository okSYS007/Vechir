Процедура ПередЗаписьюЗаказаПокупателя(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	
	Возврат; //// Віключил віполнение подписки из за того что блокирует обмен с мобильнім приложением
	
	Если ЗначениеЗаполнено(Источник.Ссылка) Тогда
		Если Не РольДоступна("РедактированиеЗаказаПокупателя") Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ЗаказПокупателя", Источник.Ссылка);
			Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ПоступлениеОплатыПоПлатежнымКартам);
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЧекККМ.Ссылка
			|ИЗ
			|	Документ.ЧекККМ КАК ЧекККМ
			|ГДЕ
			|	ЧекККМ.ЗаказПокупателя = &ЗаказПокупателя
			|	И ЧекККМ.Проведен = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Ссылка
			|ИЗ
			|	Документ.ПлатежноеПоручениеВходящее.РасшифровкаПлатежа КАК ПлатежноеПоручениеВходящееРасшифровкаПлатежа
			|ГДЕ
			|	ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Сделка = &ЗаказПокупателя
			|	И ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Ссылка.Проведен = ИСТИНА
			|	И ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Ссылка.ВидОперации = &ВидОперации";
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Сообщить(НСтр("ru='Существуют проведенные документы по данному заказу';uk='Існують проведені документи на це замовлення'"), СтатусСообщения.Внимание);		
				Отказ = истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	


Функция ВыгрузитьИзображениеНаСайт(УзелОбмена, ПрисоединенныйФайл) Экспорт
	
	Если ТипЗнч(ПрисоединенныйФайл.Объект) = Тип("СправочникСсылка.Номенклатура") Тогда 
		Картинка = ПрисоединенныйФайл.Хранилище.Получить();
		Попытка
			Расширение = НРег(Строка(Картинка.Формат()));
			Если Расширение="" Тогда 
				Расширение = "webp";
			КонецЕсли;
		Исключение
			//МассивИмени = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ПрисоединенныйФайл.ИмяФайла, ".");
			//Если МассивИмени.Количество() Тогда
			//    Расширение = МассивИмени[МассивИмени.Количество() - 1];
			//Иначе		
			//	ЗаписьЖурналаРегистрации("ОбменССайтом.ВыгрузитьИзображениеНаСайт", УровеньЖурналаРегистрации.Ошибка, , , "Не удалось получить расширение файла!");
			//	Возврат Ложь; 
			//КонецЕсли;
			Расширение = "webp";
		КонецПопытки;
		
		HTTPСоединение = Новый HTTPСоединение(УзелОбмена.URL,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		
		ВремГраница = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
		ТелоЗапроса = Новый ТекстовыйДокумент();
		ТелоЗапроса.РазделительСтрок = Символы.CR + Символы.LF;
		
		ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
		ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""guid"";");
		ТелоЗапроса.ДобавитьСтроку("");
		ТелоЗапроса.ДобавитьСтроку(Строка(ПрисоединенныйФайл.Объект.УникальныйИдентификатор()));
		
		ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
		ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""token"";");
		ТелоЗапроса.ДобавитьСтроку("");
		ТелоЗапроса.ДобавитьСтроку(УзелОбмена.Токен);
		
		ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
		ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""type"";");
		ТелоЗапроса.ДобавитьСтроку("");
		ТелоЗапроса.ДобавитьСтроку(?(ПрисоединенныйФайл.Объект.ОсновноеИзображение = ПрисоединенныйФайл.Ссылка, "primary", "secondary"));
		
		ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
		ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""image_url"";");
		ТелоЗапроса.ДобавитьСтроку("");
		Если НЕ ПрисоединенныйФайл.ПометкаУдаления Тогда
			ТелоЗапроса.ДобавитьСтроку(УзелОбмена.URLКартинки 
										+ Строка(ПрисоединенныйФайл.Ссылка.УникальныйИдентификатор()) 
										+ "."
										+ Расширение);
		Иначе
			ТелоЗапроса.ДобавитьСтроку("");								
		КонецЕсли; 
		
		ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
		ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""1c_id"";");
		ТелоЗапроса.ДобавитьСтроку("");
		ТелоЗапроса.ДобавитьСтроку(Строка(ПрисоединенныйФайл.Ссылка.УникальныйИдентификатор()));							
		
		ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница + "--");
		
		ТелоЗапросаСтрока = ТелоЗапроса.ПолучитьТекст();
		
		HTTPЗапрос = Новый HTTPЗапрос("index.php?route=api/upload_image");
		HTTPЗапрос.Заголовки["Content-Type"] = "multipart/form-data; boundary=" + ВремГраница;
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаСтрока, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		Попытка
			HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОбменССайтом.ВыгрузитьИзображениеНаСайт", УровеньЖурналаРегистрации.Ошибка, ,ПрисоединенныйФайл , ТекстОшибки);
			Возврат Ложь;
		КонецПопытки;
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("ОбменССайтом.ВыгрузитьИзображениеНаСайт", УровеньЖурналаРегистрации.Ошибка, , ПрисоединенныйФайл, "Ошибка сервера " + Строка(HTTPОтвет.КодСостояния) + " " + HTTPОтвет.ПолучитьТелоКакСтроку());
			Возврат Ложь;
		КонецЕсли; 
		
		JSON = Новый ЧтениеJSON;
		JSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
		
		Попытка
			РезультатСоответствие = ПрочитатьJSON(JSON, Истина);
			Если РезультатСоответствие.Получить("error") <> Неопределено Тогда
				ЗаписьЖурналаРегистрации("ОбменССайтом.ВыгрузитьИзображениеНаСайт", УровеньЖурналаРегистрации.Ошибка, ,ПрисоединенныйФайл , РезультатСоответствие.Получить("error"));
				Возврат Ложь;
			КонецЕсли;
			Возврат Истина;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОбменССайтом.ВыгрузитьИзображениеНаСайт", УровеньЖурналаРегистрации.Ошибка, ,ПрисоединенныйФайл, ТекстОшибки);
			Возврат Ложь;
		КонецПопытки;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции



Функция СоздатьПоступлениеТоваровУслугПоПриемкеАвто(
	ПодразделениеПриемкиАвто,ВхДата,КонтрагентПриемкиАвто,ВалютаПриемкиАвто,Комментарий
	,СтоимостьАвто,Перегон,Разборка,Растаможка,НовоеАвто,Отказ
)  Экспорт

	ПоступлениеТоваров                    			= Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	ПоступлениеТоваров.ОтражатьВУправленческомУчете = Истина;
	ПоступлениеТоваров.ОтражатьВБухгалтерскомУчете  = Истина;
	ПоступлениеТоваров.ОтражатьВНалоговомУчете      = Истина;
	ПоступлениеТоваров.Организация		  			= ry_ПолучениеДанных.ПолучитьОрганизациюРезервПоПодразделению(ПодразделениеПриемкиАвто);
	ПоступлениеТоваров.Дата			      			= ВхДата;
	ПоступлениеТоваров.Контрагент         			= КонтрагентПриемкиАвто;
	ПоступлениеТоваров.ДоговорКонтрагента 			= ry_ПолучениеДанных.ПолучитьДоговорКонтрагентаПоПодрИОрг(ПоступлениеТоваров.Контрагент,ПодразделениеПриемкиАвто,ПоступлениеТоваров.Организация);
	ПоступлениеТоваров.ОтражатьВУправленческомУчете = Истина;
	ПоступлениеТоваров.Подразделение = ПодразделениеПриемкиАвто;
	ПоступлениеТоваров.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Если ПоступлениеТоваров.ДоговорКонтрагента      = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда 
		ПоступлениеТоваров.ДоговорКонтрагента = СоздатьДоговорКонтрагента(ПоступлениеТоваров.Организация,ПоступлениеТоваров.Контрагент,ВалютаПриемкиАвто);	
	КонецЕсли;
	
	Если не Отказ Тогда 
		ПоступлениеТоваров.ВалютаДокумента    = ВалютаПриемкиАвто;
		ПоступлениеТоваров.Дата =   ВхДата;
		ПоступлениеТоваров.КурсВзаиморасчетов = МодульВалютногоУчета.ПолучитьКурсВалюты(ВалютаПриемкиАвто,ВхДата).курс;
		ПоступлениеТоваров.КратностьВзаиморасчетов = 1;
		ПоступлениеТоваров.СкладОрдер         = ry_ПолучениеДанных.ПолучитьСкладГрузовыхАвтомобилей(ПодразделениеПриемкиАвто);
		ПоступлениеТоваров.ВидПоступления     = Перечисления.ВидыПоступленияТоваров.НаСклад;
		ПоступлениеТоваров.Комментарий		  = Комментарий;
		ПоступлениеТоваров.РегистрироватьЦеныПоставщика = Ложь;

		// + 60249 ДДГ  9 июня 2023
		ПоступлениеТоваров.ЭтоПоступлениеАвтомобиля = Истина;

		СтрокаАвтомобиля = ПоступлениеТоваров.Автомобили.Добавить();
		СтрокаАвтомобиля.Автомобиль	= НовоеАвто;
		СтрокаАвтомобиля.Количество	= 1;
		СтрокаАвтомобиля.СтавкаНДС	= Перечисления.СтавкиНДС.БезНДС;;
		СтрокаАвтомобиля.Цена		= СтоимостьАвто + Перегон + Разборка + Растаможка;
		СтрокаАвтомобиля.Сумма		= СтрокаАвтомобиля.Количество * СтрокаАвтомобиля.Цена;
		СтрокаАвтомобиля.Склад		= ПоступлениеТоваров.СкладОрдер;
		// - 60249 ДДГ  9 июня 2023

//		СтрокаТовары = ПоступлениеТоваров.Товары.Добавить();
//		СтрокаТовары.Номенклатура = НовоеАвто.Ссылка;
//		СтрокаТовары.ЕдиницаИзмерения = НовоеАвто.Ссылка.ЕдиницаХраненияОстатков;
//		СтрокаТовары.Количество   = 1;
//		СтрокаТовары.Коэффициент  = 1;
//		СтрокаТовары.СтавкаНДС    = Перечисления.СтавкиНДС.БезНДС;
//		СтрокаТовары.Цена         = СтоимостьАвто + Перегон + Разборка + Растаможка;
//		СтрокаТовары.Сумма        = СтрокаТовары.Количество*СтрокаТовары.Цена;
//		СтрокаТовары.Склад        = ПоступлениеТоваров.СкладОрдер;
		
		//Форма = ПолучитьФорму("Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокумента",новый Структура("Ключ",ПоступлениеТоваров));
		//форма.открыть();
		//форма.ЗаписатьВФорме();
		//Форма.Закрыть();
		ПоступлениеТоваров.ОтражатьВУправленческомУчете = Истина;
		ПоступлениеТоваров.ОтражатьВБухгалтерскомУчете  = Истина;
		ПоступлениеТоваров.ОтражатьВНалоговомУчете      = Истина;
		ПоступлениеТоваров.РегистрироватьЦеныПоставщика = Ложь;
		ПоступлениеТоваров.РегистрироватьЦеныПоставщика = Ложь;
		ПоступлениеТоваров.Записать();
		Если РольДоступна("ПолныеПрава") Тогда 
			ПоступлениеТоваров.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		Возврат  ПоступлениеТоваров.Ссылка;
	КонецЕсли;
КонецФункции


Функция СоздатьПоступлениеТоваровУслугПоПриемкеСделки(
	ПодразделениеПриемки,ВхДата,КонтрагентПриемки,ВалютаПриемки,Комментарий
	,Сумма,СсылкаСделки,Отказ
)  Экспорт

	ПоступлениеТоваров                    			= Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	ПоступлениеТоваров.ОтражатьВУправленческомУчете = Истина;
	ПоступлениеТоваров.ОтражатьВБухгалтерскомУчете  = Истина;
	ПоступлениеТоваров.ОтражатьВНалоговомУчете      = Истина;
	ПоступлениеТоваров.Организация		  			= ry_ПолучениеДанных.ПолучитьОрганизациюРезервПоПодразделению(ПодразделениеПриемки);
	ПоступлениеТоваров.Дата			      			= ВхДата;
	ПоступлениеТоваров.Контрагент         			= КонтрагентПриемки;
	ПоступлениеТоваров.ДоговорКонтрагента 			= ry_ПолучениеДанных.ПолучитьДоговорКонтрагентаПоПодрИОрг(ПоступлениеТоваров.Контрагент,ПодразделениеПриемки,ПоступлениеТоваров.Организация);
	ПоступлениеТоваров.ОтражатьВУправленческомУчете = Истина;
	ПоступлениеТоваров.Подразделение = ПодразделениеПриемки;
	ПоступлениеТоваров.Ответственный = ПараметрыСеанса.ТекущийПользователь;

	Если ПоступлениеТоваров.ДоговорКонтрагента      = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда 
		ПоступлениеТоваров.ДоговорКонтрагента = СоздатьДоговорКонтрагента(ПоступлениеТоваров.Организация,ПоступлениеТоваров.Контрагент,ВалютаПриемки);	
	КонецЕсли;
	
	Если не Отказ Тогда 
		ПоступлениеТоваров.ВалютаДокумента    = ВалютаПриемки;
		ПоступлениеТоваров.Дата =   ВхДата;
		ПоступлениеТоваров.КурсВзаиморасчетов = МодульВалютногоУчета.ПолучитьКурсВалюты(ВалютаПриемки,ВхДата).курс;
		ПоступлениеТоваров.КратностьВзаиморасчетов = 1;
//		ПоступлениеТоваров.СкладОрдер         = ry_ПолучениеДанных.ПолучитьСкладГрузовыхАвтомобилей(ПодразделениеПриемки);
		ПоступлениеТоваров.ВидПоступления     = Перечисления.ВидыПоступленияТоваров.НаСклад;
		ПоступлениеТоваров.Комментарий		  = Комментарий;
		ПоступлениеТоваров.РегистрироватьЦеныПоставщика = Ложь;

		ПоступлениеТоваров.ЭтоПоступлениеПоСделке = Истина;

		СтрокаСделки = ПоступлениеТоваров.Сделки.Добавить();
		СтрокаСделки.Сделка		= СсылкаСделки;
		СтрокаСделки.Количество	= 1;
		СтрокаСделки.СтавкаНДС	= Перечисления.СтавкиНДС.БезНДС;;
		СтрокаСделки.Цена		= Сумма;
		СтрокаСделки.Сумма		= Сумма;
		СтрокаСделки.Склад		= ПоступлениеТоваров.СкладОрдер;

		ПоступлениеТоваров.ОтражатьВУправленческомУчете = Истина;
		ПоступлениеТоваров.ОтражатьВБухгалтерскомУчете  = Истина;
		ПоступлениеТоваров.ОтражатьВНалоговомУчете      = Истина;
		ПоступлениеТоваров.РегистрироватьЦеныПоставщика = Ложь;
		ПоступлениеТоваров.РегистрироватьЦеныПоставщика = Ложь;
		ПоступлениеТоваров.Записать();
		Если РольДоступна("ПолныеПрава") Тогда 
			ПоступлениеТоваров.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;

		Возврат  ПоступлениеТоваров.Ссылка;

	КонецЕсли;
КонецФункции

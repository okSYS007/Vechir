Функция ТаблицыНенужныеДляЗаполнения() Экспорт

	СоотвНенужного = Новый Соответствие;

	СоотвНенужного.Вставить("Справочник._УчетныеЗаписиEbay"					, Истина);
	СоотвНенужного.Вставить("Документ.ЗаказПокупателя.ТабличнаяЧасть.Услуги", Истина);
	СоотвНенужного.Вставить("Документ.КорректировкаСерийИХарактеристикТоваров.ТабличнаяЧасть.Товары", Истина);
	СоотвНенужного.Вставить("РегистрСведений.ДопустимыеКомбинации"			, Истина);
	СоотвНенужного.Вставить("РегистрСведений.ЗначенияСвойствОбъектов"		, Истина);
	СоотвНенужного.Вставить("РегистрСведений.ЗначенияСвойствОбъектовWEB"	, Истина);
	СоотвНенужного.Вставить("РегистрСведений.ВозможныеЗначенияСвойствWEB"	, Истина);
	СоотвНенужного.Вставить("РегистрСведений.ОчередьЗаменыНоменклатуры"		, Истина);

	Возврат СоотвНенужного;

КонецФункции

Функция ЗаполнитьТаблицуОбъектовНаСервере() Экспорт

	ТаблицаОбъектов = Новый ТаблицаЗначений;
	КолонкиТО = ТаблицаОбъектов.Колонки;
	КолонкиТО.Добавить("ТипОбъекта");
	КолонкиТО.Добавить("Номенклатура");
	КолонкиТО.Добавить("Характеристика");
	КолонкиТО.Добавить("Статус");

	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		ЗаполнитьРеквизитыОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
		ЗаполнитьТабличныеЧастиОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
	КонецЦикла;

	Для Каждого ОбъектМетаданных Из Метаданные.Справочники Цикл
		ЗаполнитьРеквизитыОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
		ЗаполнитьТабличныеЧастиОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
	КонецЦикла;

	Для Каждого ОбъектМетаданных Из Метаданные.БизнесПроцессы Цикл
		ЗаполнитьРеквизитыОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
		ЗаполнитьТабличныеЧастиОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
	КонецЦикла;

	Для Каждого ОбъектМетаданных Из Метаданные.Задачи Цикл
		ЗаполнитьРеквизитыОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
		ЗаполнитьТабличныеЧастиОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных);
	КонецЦикла;

	Для Каждого ОбъектМетаданных Из Метаданные.РегистрыСведений Цикл
		Если ОбъектМетаданных.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьРеквизитыРегистраСведений(ТаблицаОбъектов, ОбъектМетаданных);
	КонецЦикла;

	МассивУдаляемыхСтрок = Новый Массив;

	СоотвНенужного = ТаблицыНенужныеДляЗаполнения();

	Для Каждого СтрокаТО Из ТаблицаОбъектов Цикл
		Если СоотвНенужного.Получить(СтрокаТО.ТипОбъекта) = Истина Тогда
			МассивУдаляемыхСтрок.Добавить(СтрокаТО);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаУдаления Из МассивУдаляемыхСтрок Цикл
		ТаблицаОбъектов.Удалить(СтрокаУдаления);
	КонецЦикла;

	Возврат ТаблицаОбъектов;

КонецФункции

Процедура ЗаполнитьРеквизитыОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных)

	ТипНом = Тип("СправочникСсылка.Номенклатура");
	ТипХар = Тип("СправочникСсылка.ХарактеристикиНоменклатуры");

	ТипОбъекта = ОбъектМетаданных.ПолноеИмя();
	ИмяРеквНом = "";
	ИмяРеквХар = "";
	Статус = "";

	МассивНом = Новый Массив;
	МассивХар = Новый Массив;

	Для Каждого РеквизитОбъекта Из ОбъектМетаданных.Реквизиты Цикл

		Если РеквизитОбъекта.Тип.СодержитТип(ТипХар) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквХар = "" Тогда
				ИмяРеквХар = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор харки: " + ИмяРекв + ". "
			КонецЕсли;

			МассивХар.Добавить(ИмяРекв);

		ИначеЕсли РеквизитОбъекта.Тип.СодержитТип(ТипНом) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквНом = "" Тогда
				ИмяРеквНом = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор ном: " + ИмяРекв + ". "
			КонецЕсли;

			МассивНом.Добавить(ИмяРекв);

		КонецЕсли;

	КонецЦикла;

	Если ИмяРеквХар = "" ИЛИ ИмяРеквНом = "" Тогда
		Возврат;
	КонецЕсли;

	Если МассивНом.Количество() > 1
	   И МассивХар.Количество() > 1
	   И МассивНом.Количество() = МассивХар.Количество()
	Тогда

		СоотвХарНом = Новый Соответствие;

		ИДХ = 0;
		Лимит = МассивНом.Количество();

		Пока ИДХ < Лимит Цикл

			СтрНом = МассивНом[ИДХ];

			ПодСтрПоиска = Лев(СтрНом, 7);

			Для Каждого СтрХарки Из МассивХар Цикл
				Если Найти(СтрХарки, ПодСтрПоиска) Тогда
					СоотвХарНом.Вставить(СтрНом, СтрХарки);
					МассивХар.Удалить(МассивХар.Найти(СтрХарки));
					МассивНом.Удалить(ИДХ);
					ИДХ = ИДХ - 1;
					Лимит = Лимит - 1;
				КонецЕсли;
			КонецЦикла;

			ИДХ = ИДХ + 1;

		КонецЦикла;

		Если МассивНом.Количество() < 2 И МассивХар.Количество() < 2 Тогда
			Для ИДХ=0 По МассивНом.ВГраница() Цикл
				СоотвХарНом.Вставить(МассивНом[ИДХ], МассивХар[ИДХ]);
			КонецЦикла;
		Иначе
			СтрокаТО = ТаблицаОбъектов.Добавить();
			СтрокаТО.ТипОбъекта = ТипОбъекта;
			СтрокаТО.Номенклатура	= ?(МассивНом.Количество() > 1, МассивНом, ИмяРеквНом);
			СтрокаТО.Характеристика	= ?(МассивХар.Количество() > 1, МассивХар, ИмяРеквХар);
			СтрокаТО.Статус = Статус;
		КонецЕсли;

		Для Каждого КлючЗнач Из СоотвХарНом Цикл
			СтрокаТО = ТаблицаОбъектов.Добавить();
			СтрокаТО.ТипОбъекта = ТипОбъекта;
			СтрокаТО.Номенклатура = КлючЗнач.Ключ;
			СтрокаТО.Характеристика = КлючЗнач.Значение;
			СтрокаТО.Статус = Статус;
		КонецЦикла;

		Возврат;

	КонецЕсли;

	СтрокаТО = ТаблицаОбъектов.Добавить();
	СтрокаТО.ТипОбъекта = ТипОбъекта;
	СтрокаТО.Номенклатура	= ?(МассивНом.Количество() > 1, МассивНом, ИмяРеквНом);
	СтрокаТО.Характеристика	= ?(МассивХар.Количество() > 1, МассивХар, ИмяРеквХар);
	СтрокаТО.Статус = Статус;

КонецПроцедуры

Процедура ЗаполнитьТабличныеЧастиОбъектаМетаданных(ТаблицаОбъектов, ОбъектМетаданных)

	ТипНом = Тип("СправочникСсылка.Номенклатура");
	ТипХар = Тип("СправочникСсылка.ХарактеристикиНоменклатуры");

	Для Каждого ОбъектТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
		ЗаполнитьРеквизитыОбъектаМетаданных(ТаблицаОбъектов, ОбъектТЧ);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыРегистраСведений(ТаблицаОбъектов, ОбъектМетаданных)

	ТипНом = Тип("СправочникСсылка.Номенклатура");
	ТипХар = Тип("СправочникСсылка.ХарактеристикиНоменклатуры");

	ТипОбъекта = ОбъектМетаданных.ПолноеИмя();
	ИмяРеквНом = "";
	ИмяРеквХар = "";
	Статус = "";
	Заполнено = Ложь;

	МассивНом = Новый Массив;
	МассивХар = Новый Массив;

	Для Каждого РеквизитОбъекта Из ОбъектМетаданных.Измерения Цикл

		Если РеквизитОбъекта.Тип.СодержитТип(ТипХар) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквХар = "" Тогда
				ИмяРеквХар = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор харки: " + ИмяРекв + ". "
			КонецЕсли;

			МассивХар.Добавить(ИмяРекв);

		ИначеЕсли РеквизитОбъекта.Тип.СодержитТип(ТипНом) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквНом = "" Тогда
				ИмяРеквНом = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор ном: " + ИмяРекв + ". "
			КонецЕсли;

			МассивНом.Добавить(ИмяРекв);

		КонецЕсли;

	КонецЦикла;

	Если ИмяРеквХар <> "" И ИмяРеквНом <> "" Тогда
		Статус = "Измерение. " + Статус;
		Заполнено = Истина;
	КонецЕсли;

	//

	Для Каждого РеквизитОбъекта Из ОбъектМетаданных.Ресурсы Цикл

		Если РеквизитОбъекта.Тип.СодержитТип(ТипХар) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквХар = "" Тогда
				ИмяРеквХар = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор харки: " + ИмяРекв + ". "
			КонецЕсли;

			МассивХар.Добавить(ИмяРекв);

		ИначеЕсли РеквизитОбъекта.Тип.СодержитТип(ТипНом) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквНом = "" Тогда
				ИмяРеквНом = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор ном: " + ИмяРекв + ". "
			КонецЕсли;

			МассивНом.Добавить(ИмяРекв);

		КонецЕсли;

	КонецЦикла;

	Если ИмяРеквХар <> "" И ИмяРеквНом <> "" И НЕ Заполнено Тогда
		Статус = Статус + "Ресурс. ";
		Заполнено = Истина;
	КонецЕсли;

	//

	Для Каждого РеквизитОбъекта Из ОбъектМетаданных.Реквизиты Цикл

		Если РеквизитОбъекта.Тип.СодержитТип(ТипХар) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквХар = "" Тогда
				ИмяРеквХар = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор харки: " + ИмяРекв + ". "
			КонецЕсли;

			МассивХар.Добавить(ИмяРекв);

		ИначеЕсли РеквизитОбъекта.Тип.СодержитТип(ТипНом) Тогда

			ИмяРекв = РеквизитОбъекта.Имя;

			Если ИмяРеквНом = "" Тогда
				ИмяРеквНом = ИмяРекв;
			Иначе
				Статус = Статус + "Повтор ном: " + ИмяРекв + ". "
			КонецЕсли;

			МассивНом.Добавить(ИмяРекв);

		КонецЕсли;

	КонецЦикла;

	Если ИмяРеквХар = "" ИЛИ ИмяРеквНом = "" Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Заполнено Тогда
		Статус = Статус + "Реквизит. ";
		Заполнено = Истина;
	КонецЕсли;

	Если МассивНом.Количество() > 1
	   И МассивХар.Количество() > 1
	   И МассивНом.Количество() = МассивХар.Количество()
	Тогда

		СоотвХарНом = Новый Соответствие;

		ИДХ = 0;
		Лимит = МассивНом.Количество();

		Пока ИДХ < Лимит Цикл

			СтрНом = МассивНом[ИДХ];

			ПодСтрПоиска = Лев(СтрНом, 7);

			Для Каждого СтрХарки Из МассивХар Цикл
				Если Найти(СтрХарки, ПодСтрПоиска) Тогда
					СоотвХарНом.Вставить(СтрНом, СтрХарки);
					МассивХар.Удалить(МассивХар.Найти(СтрХарки));
					МассивНом.Удалить(ИДХ);
					ИДХ = ИДХ - 1;
					Лимит = Лимит - 1;
				КонецЕсли;
			КонецЦикла;

			ИДХ = ИДХ + 1;

		КонецЦикла;

		Если МассивНом.Количество() < 2 И МассивХар.Количество() < 2 Тогда
			Для ИДХ=0 По МассивНом.ВГраница() Цикл
				СоотвХарНом.Вставить(МассивНом[ИДХ], МассивХар[ИДХ]);
			КонецЦикла;
		Иначе
			СтрокаТО = ТаблицаОбъектов.Добавить();
			СтрокаТО.ТипОбъекта = ТипОбъекта;
			СтрокаТО.Номенклатура	= ?(МассивНом.Количество() > 1, МассивНом, ИмяРеквНом);
			СтрокаТО.Характеристика	= ?(МассивХар.Количество() > 1, МассивХар, ИмяРеквХар);
			СтрокаТО.Статус = Статус;
		КонецЕсли;

		Для Каждого КлючЗнач Из СоотвХарНом Цикл
			СтрокаТО = ТаблицаОбъектов.Добавить();
			СтрокаТО.ТипОбъекта = ТипОбъекта;
			СтрокаТО.Номенклатура = КлючЗнач.Ключ;
			СтрокаТО.Характеристика = КлючЗнач.Значение;
			СтрокаТО.Статус = Статус;
		КонецЦикла;

		Возврат;

	КонецЕсли;

	Если ТипОбъекта = "РегистрСведений.УслугиТоваров" Тогда
		МассивНом = Новый Массив;
		МассивНом.Добавить("Товар");
	КонецЕсли;

	СтрокаТО = ТаблицаОбъектов.Добавить();
	СтрокаТО.ТипОбъекта = ТипОбъекта;
	СтрокаТО.Номенклатура	= ?(МассивНом.Количество() > 1, МассивНом, ИмяРеквНом);
	СтрокаТО.Характеристика	= ?(МассивХар.Количество() > 1, МассивХар, ИмяРеквХар);
	СтрокаТО.Статус = Статус;

КонецПроцедуры


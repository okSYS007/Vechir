Функция СформироватьТекстЗапросаПоискСсылокХарактеристики(ТаблицаОбъектов) Экспорт

	ТекстЗапроса = "";

	ПроверкаДокумент		= "Документ.";
	ПроверкаСправочник		= "Справочник.";
	ПроверкаБизнесПроцесс	= "БизнесПроцесс.";
	ПроверкаЗадача			= "Задача.";
	ПроверкаРегистрСведений	= "РегистрСведений.";

	ДлинаПроверкаДокумент			= СтрДлина(ПроверкаДокумент);
	ДлинаПроверкаСправочник			= СтрДлина(ПроверкаСправочник);
	ДлинаПроверкаБизнесПроцесс		= СтрДлина(ПроверкаБизнесПроцесс);
	ДлинаПроверкаЗадача				= СтрДлина(ПроверкаЗадача);
	ДлинаПроверкаРегистрСведений	= СтрДлина(ПроверкаРегистрСведений);

	СтрокаОбъединить = Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС;

	Для Каждого СтрокаТО Из ТаблицаОбъектов Цикл

		ТипОбъекта = СтрокаТО.ТипОбъекта;

		ТипЭтоРегистр = (Лев(ТипОбъекта, ДлинаПроверкаРегистрСведений) = ПроверкаРегистрСведений);
		ТипЭтоДокумент = (Лев(ТипОбъекта, ДлинаПроверкаДокумент) = ПроверкаДокумент);
		ТипЭтоТЧ = ЭтоТЧ(ТипОбъекта);

		ИмяТаблицы = ?(
			ТипЭтоТЧ, СтрЗаменить(ТипОбъекта, ".ТабличнаяЧасть.", "."), ТипОбъекта
		);

		ИмяОбъекта = ?(
			ТипЭтоРегистр, СтрЗаменить(ТипОбъекта, ПроверкаРегистрСведений, "")
			, ?(
				ТипЭтоТЧ, СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипОбъекта, ".")[3]
				, СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипОбъекта, ".")[1]
			)
		);

		СтрокаЗапроса = "
		|ВЫБРАТЬ
		|	""" + ТипОбъекта + """ КАК ТипОбъекта,
		|	""" + ИмяОбъекта + """ КАК ИмяОбъекта,
		|	" + ?(ТипЭтоДокумент
			, ?(ТипЭтоТЧ,			"Ссылка.Дата", "Дата")
			, "ДАТАВРЕМЯ(1,1,1)") + " КАК Дата,
		|	" + ?(ТипЭтоРегистр,	"""" + ТипОбъекта + """", "ПРЕДСТАВЛЕНИЕ(Ссылка)") + " КАК ПредставлениеОбъекта,
		|	ЛОЖЬ КАК ПодчинениеРегистратору,
		|	" + ?(ТипЭтоРегистр,	"ИСТИНА", "ЛОЖЬ") + " КАК ЭтоРегистр,
		|	" + ?(ТипЭтоТЧ,			"ИСТИНА", "ЛОЖЬ") + " КАК ЭтоТЧ,
		|	""" + СтрокаТО.Номенклатура		+ """ КАК ПолеНоменклатура,
		|	""" + СтрокаТО.Характеристика	+ """ КАК ПолеХарактеристика,
		|	" + ?(ТипЭтоРегистр,	"NULL",			"Ссылка") + " КАК Ссылка,
		|	" + ?(ТипЭтоТЧ,			"НомерСтроки",	"NULL") + " КАК НомерСтроки
//		|	" + СтрокаТО.Номенклатура	+ " КАК Номенклатура,
//		|	" + СтрокаТО.Характеристика	+ " КАК Характеристика
		|ИЗ
		|	" + ИмяТаблицы + "
		|ГДЕ " + СтрокаТО.Номенклатура		+ " = &Номенклатура
		|  И " + СтрокаТО.Характеристика	+ " = &Характеристика
		|" + СтрокаОбъединить;

		ТекстЗапроса = ТекстЗапроса + СтрокаЗапроса;

	КонецЦикла;

	СтрокаЗапроса = "
		|ВЫБРАТЬ
		|	""РегистрНакопления.ТоварыВРезервеНаСкладах"" КАК ТипОбъекта,
		|	""ТоварыВРезервеНаСкладах"" КАК ИмяОбъекта,
		|	ТоварыВРезервеНаСкладах.Период КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(ТоварыВРезервеНаСкладах.Регистратор) КАК ПредставлениеОбъекта,
		|	ИСТИНА КАК ПодчинениеРегистратору,
		|	ЛОЖЬ КАК ЭтоРегистр,
		|	ЛОЖЬ КАК ЭтоТЧ,
		|	""Номенклатура"" КАК ПолеНоменклатура,
		|	""ХарактеристикаНоменклатуры"" КАК ПолеХарактеристика,
		|	ТоварыВРезервеНаСкладах.Регистратор КАК Ссылка,
		|	NULL КАК НомерСтроки
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах КАК ТоварыВРезервеНаСкладах
		|ГДЕ
		|	ТоварыВРезервеНаСкладах.Регистратор ССЫЛКА Документ.ЗакрытиеЗаказовПокупателей
		|	И ТоварыВРезервеНаСкладах.Номенклатура = &Номенклатура
		|	И ТоварыВРезервеНаСкладах.ХарактеристикаНоменклатуры = &Характеристика
	|";

	ТекстЗапроса = ТекстЗапроса + СтрокаЗапроса;

//	СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(ТекстЗапроса, СтрДлина(СтрокаОбъединить));

	Возврат ТекстЗапроса;

КонецФункции

Функция ЭтоТЧ(ТипОбъекта) Экспорт

	МассивПодстрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипОбъекта, ".");

	Если МассивПодстрок.Количество() < 4 Тогда
		Возврат Ложь;
	КонецЕсли;

	ЭлементМассива = МассивПодстрок[2];

	Возврат ЭлементМассива = "ТабличнаяЧасть";

КонецФункции

Функция ПолучитьОбъектыСсылокЗамены(ТекстЗапроса, Номенклатура, Характеристика) Экспорт

	Запрос = Новый Запрос(ТекстЗапроса);

	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",	Характеристика);

	РезультатЗапроса	= Запрос.Выполнить();
	ТаблицаРезультата	= РезультатЗапроса.Выгрузить();

	ТаблицаРезультата.Сортировать("Дата");

	Возврат ТаблицаРезультата;

КонецФункции

//////////////////////////////////////////////////////////////////////////////////////////////////////////

Функция ПолучитьТаблицуДляЗаменыНоменклатурыХарактеристики(СтараяНоменклатура, ИскомаяХарактеристика) Экспорт

	ТабОбж = ЗаполнитьТаблицуОбъектовНаСервере();
	ТекстЗапроса = СформироватьТекстЗапросаПоискСсылокХарактеристики(ТабОбж);
	ТаблицаРезультата = ПолучитьОбъектыСсылокЗамены(ТекстЗапроса, СтараяНоменклатура, ИскомаяХарактеристика);

	Возврат ТаблицаРезультата;

КонецФункции

Процедура ВыполнитьЗаменуНоменклатурыХарактеристики(
		ТаблицаЗамен, СтараяНоменклатура, ИскомаяХарактеристика, НоменклатураЗамены, УникИдФормы = Неопределено
) Экспорт

	УстановитьПривилегированныйРежим(Истина);
//	НачатьТранзакцию();

	Для Каждого СтрокаТЗ Из ТаблицаЗамен Цикл

		ПолеНоменклатура	= СтрокаТЗ.ПолеНоменклатура;
		ПолеХарактеристика	= СтрокаТЗ.ПолеХарактеристика;
		ИмяОбъекта			= СтрокаТЗ.ИмяОбъекта;

		Если СтрокаТЗ.ЭтоРегистр Тогда

			ТекстЗапроса = "ВЫБРАТЬ";

			НаборЗаписей = РегистрыСведений[ИмяОбъекта].СоздатьНаборЗаписей();

			МетаданныеРегистра = НаборЗаписей.Метаданные();

			Для Каждого МетаданныеИзмерения Из МетаданныеРегистра.Измерения Цикл
				СтрокаЗапроса = Символы.ПС + Символы.Таб + МетаданныеИзмерения.Имя + ",";
				ТекстЗапроса  = ТекстЗапроса + СтрокаЗапроса;
			КонецЦикла;

			СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(ТекстЗапроса, 1);

			СтрокаЗапроса = Символы.ПС + "ИЗ" + Символы.ПС;
			ТекстЗапроса  = ТекстЗапроса + СтрокаЗапроса;

			СтрокаЗапроса = Символы.Таб + СтрокаТЗ.ТипОбъекта + Символы.ПС;
			ТекстЗапроса  = ТекстЗапроса + СтрокаЗапроса;

			СтрокаЗапроса = "ГДЕ " + ПолеНоменклатура + " = &Номенклатура" + Символы.ПС;
			ТекстЗапроса  = ТекстЗапроса + СтрокаЗапроса;

			СтрокаЗапроса = "  И " + ПолеХарактеристика + " = &Характеристика" + Символы.ПС;
			ТекстЗапроса  = ТекстЗапроса + СтрокаЗапроса;

			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("Номенклатура",	СтараяНоменклатура);
			Запрос.УстановитьПараметр("Характеристика",	ИскомаяХарактеристика);

			Попытка

				РезультатЗапроса = Запрос.Выполнить();

				ВыборкаРезультата = РезультатЗапроса.Выбрать();

				Пока ВыборкаРезультата.Следующий() Цикл

					МенеджерЗаписи = РегистрыСведений[ИмяОбъекта].СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаРезультата);
					МенеджерЗаписи.Прочитать();

					Если МенеджерЗаписи.Выбран() Тогда
						МенеджерЗаписи[ПолеНоменклатура] = НоменклатураЗамены;
						МенеджерЗаписи.Записать();
					КонецЕсли;

				КонецЦикла;

			Исключение
				ТекстСообщения = "Не удалось выполнить замену в регистре: " + ИмяОбъекта + " причина: " + ОписаниеОшибки();
				РазработкаВебСервер.ВывестиСообщениеСервераНаВебКлиент(ТекстСообщения, УникИдФормы);
				Продолжить;
			КонецПопытки;

		ИначеЕсли СтрокаТЗ.ЭтоТЧ Тогда

			БылаЗамена = Ложь;

			ОбъектСсылки = СтрокаТЗ.Ссылка.ПолучитьОбъект();
			ОбъектТЧ = ОбъектСсылки[ИмяОбъекта];

			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить(ПолеНоменклатура,	 СтараяНоменклатура);
			СтруктураПоиска.Вставить(ПолеХарактеристика, ИскомаяХарактеристика);

			НайденныеСтроки = ОбъектТЧ.НайтиСтроки(СтруктураПоиска);

			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока[ПолеНоменклатура] = НоменклатураЗамены;
				БылаЗамена = Истина;
			КонецЦикла;

			Если БылаЗамена Тогда
				ПерезаписатьОбъектПриЗаменеНоменклатуры(СтрокаТЗ.Ссылка, ОбъектСсылки, УникИдФормы, НоменклатураЗамены);
			КонецЕсли;

		ИначеЕсли СтрокаТЗ.ПодчинениеРегистратору Тогда

			ОбъектСсылки = СтрокаТЗ.Ссылка.ПолучитьОбъект();
			ПерезаписатьОбъектПриЗаменеНоменклатуры(СтрокаТЗ.Ссылка, ОбъектСсылки, УникИдФормы, НоменклатураЗамены);

		Иначе

			ОбъектСсылки = СтрокаТЗ.Ссылка.ПолучитьОбъект();

			Если ОбъектСсылки[ПолеХарактеристика] = ИскомаяХарактеристика Тогда
				ОбъектСсылки[ПолеНоменклатура] = НоменклатураЗамены;
			КонецЕсли;

			ПерезаписатьОбъектПриЗаменеНоменклатуры(СтрокаТЗ.Ссылка, ОбъектСсылки, УникИдФормы, НоменклатураЗамены);

		КонецЕсли;

	КонецЦикла;

	ОбъектХарактеристики = ИскомаяХарактеристика.ПолучитьОбъект();

	Если ОбъектХарактеристики.Владелец <> НоменклатураЗамены Тогда
		ОбъектХарактеристики.Владелец = НоменклатураЗамены;
		ОбъектХарактеристики.Записать();
	КонецЕсли;

//	ЗафиксироватьТранзакцию();
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ПерезаписатьОбъектПриЗаменеНоменклатуры(Ссылка, ОбъектСсылки, УникИдФормы = Неопределено, НоменклатураЗамены = Неопределено)

//	УстановитьПривилегированныйРежим(Истина);

	ТипСсылки = ТипЗнч(Ссылка);

	ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипСсылки);

	Если ЗначениеЗаполнено(УникИдФормы) Тогда
		ОбъектСсылки.ДополнительныеСвойства.Вставить("УникИдФормы", УникИдФормы);
	КонецЕсли;

	ОбъектСсылки.ДополнительныеСвойства.Вставить("ЗаменаНоменклатуры", Истина);

	Если ЭтоДокумент
	   И ТипСсылки = Тип("ДокументСсылка.ЧекККМ")
	Тогда
		ОбъектСсылки.ДополнительныеСвойства.Вставить("НеКонтролировать", Истина);
	КонецЕсли;

	Если ЭтоДокумент
	   И ТипСсылки = Тип("ДокументСсылка.зетаБУКомплектация")
	   И ЗначениеЗаполнено(ОбъектСсылки.Автомобиль)
	   И ЗначениеЗаполнено(НоменклатураЗамены)
	   И НЕ РазработкаСервер.ПроверитьЕстьЛиМодельВПрименяемости(
	   		НоменклатураЗамены.ГруппаКроссов
	   		, ОбъектСсылки.Автомобиль.Модель)
	Тогда

		РазрешеноСозданиеПостояннойНоменклатуры = РазработкаСервер.ПолучитьБулевоеЗначениеПраваДляТекущегоПользователя(ПланыВидовХарактеристик.ПраваПользователей.РазрешитьСозданиеПостояннойНоменклатуры);

		РазработкаСервер.СоздатьЗаписьПрименяемостьМодели(
			НоменклатураЗамены.ГруппаКроссов
			, ОбъектСсылки.Автомобиль.Модель
			, НЕ РазрешеноСозданиеПостояннойНоменклатуры
		);

	КонецЕсли;

	Попытка
		Если ЭтоДокумент И ОбъектСсылки.Проведен Тогда
			ОбъектСсылки.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектСсылки.Записать();
		КонецЕсли;
	Исключение
		ТекстСообщения = "Не удалось выполнить замену в объекте: " + Ссылка + " причина: " + ОписаниеОшибки();
		РазработкаВебСервер.ВывестиСообщениеСервераНаВебКлиент(ТекстСообщения, УникИдФормы);
	КонецПопытки;

//	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

		нДок.Дата = ДатаДок;
		нДок.ВидОперации = Перечисления.ВидыОперацийЗаявкиНаРасходование.ОплатаПоставщику;
		нДок.Описание = НомерДок;
		нДок.НомерВходящегоДокумента = НомерДок;
		нДок.Комментарий = "Завантажено із medoc";

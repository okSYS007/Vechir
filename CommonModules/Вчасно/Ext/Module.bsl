Функция ПолучитьСтруктуруИзХМЛ(ТекстХМЛ) 
	
	ЧтениеХМЛ = Новый ЧтениеXML;
	ЧтениеХМЛ.УстановитьСтроку(ТекстХМЛ);
	
	СтруктураХМЛ = Новый Структура;
	
	РекурсивноПолучитьСтруктуруИзХМЛ(ЧтениеХМЛ, СтруктураХМЛ);
	
	ЧтениеХМЛ.Закрыть();
	
	Возврат СтруктураХМЛ;
	
КонецФункции

Процедура РекурсивноПолучитьСтруктуруИзХМЛ(ЧтениеХМЛ, ТекущийЭлемент) 
	
	СтруктураАтрибутов = Новый Структура;
	
	ТекущийЭлемент.Вставить("___Атрибуты_", СтруктураАтрибутов);
	
	Пока ЧтениеХМЛ.ПрочитатьАтрибут() Цикл
		СтруктураАтрибутов.Вставить(ЧтениеХМЛ.Имя, ЧтениеХМЛ.Значение);
	КонецЦикла;
	
	Пока ЧтениеХМЛ.Прочитать()
		И ЧтениеХМЛ.ТипУзла <> ТипУзлаXML.КонецЭлемента
		Цикл
		
		Если ЧтениеХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяЭлемента   = ЧтениеХМЛ.Имя;
			НовыйЭлемент  = Новый Структура;
			СтарыйЭлемент = ИзвлечьСвойствоИзСтруктуры(ТекущийЭлемент, ИмяЭлемента);
			
			Если СтарыйЭлемент = Неопределено Тогда
				ТекущийЭлемент.Вставить(ИмяЭлемента, НовыйЭлемент);
			ИначеЕсли ТипЗнч(СтарыйЭлемент) = Тип("Массив") Тогда
				СтарыйЭлемент.Добавить(НовыйЭлемент);
			Иначе
				МассивЭлементов = Новый Массив;
				МассивЭлементов.Добавить(СтарыйЭлемент);
				МассивЭлементов.Добавить(НовыйЭлемент);
				ТекущийЭлемент.Вставить(ИмяЭлемента, МассивЭлементов);
			КонецЕсли;
			
			РекурсивноПолучитьСтруктуруИзХМЛ(ЧтениеХМЛ, НовыйЭлемент);
			
		ИначеЕсли ЧтениеХМЛ.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ТекущийЭлемент.Вставить("___Текст_", ЧтениеХМЛ.Значение);
			
			//ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			//Возврат;
			
		КонецЕсли ;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИзвлечьСвойствоИзСтруктуры(ИсходнаяСтруктура, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено, ЗаполнитьПоУмолчаниюЕслиПусто = Ложь) 
	
	ЗначениеСвойства = ЗначениеПоУмолчанию;
	
	Если ИсходнаяСтруктура.Свойство(ИмяСвойства) Тогда
		ЗначениеСвойства = ИсходнаяСтруктура[ИмяСвойства];
	КонецЕсли;
	
	Если ЗаполнитьПоУмолчаниюЕслиПусто И НЕ ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		ЗначениеСвойства = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

Функция НайтиДокументПоНомеруИДате(Номер, Дата, Организация)
	
	Рез = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Дата));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка КАК Документ
	|ИЗ
	|	Документ.ЗаявкаНаРасходованиеСредств КАК Док
	|ГДЕ
	|	(Док.Описание ПОДОБНО &Номер
	|			ИЛИ Док.НомерВходящегоДокумента ПОДОБНО &Номер)
	|	И Док.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И Док.Организация = &Организация";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Рез = ВыборкаДетальныеЗаписи.Документ; 
	КонецЦикла;
	
	Возврат Рез;
	

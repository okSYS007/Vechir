Функция ОтправитьДокументыВчасно(ПечДокумент, Заголовок) Экспорт
	
	Если ПечДокумент = Неопределено тогда
		Возврат Истина;
	КонецЕсли;
	
	ИДСеанса = Строка(НомерСеансаИнформационнойБазы());
	
	ПВХ_ИДСеанса      = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ID Сеанса");
	ПВХ_ВремХранилище = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ВремХранилище");
	
	ТекОбъект = Неопределено;
	Выборка = РегистрыСведений.ЗначенияСвойствОбъектов.Выбрать(Новый Структура("Свойство",ПВХ_ИДСеанса));
    Пока Выборка.Следующий() Цикл
        Запись = Выборка.ПолучитьМенеджерЗаписи();
        // изменим
        Запись.Прочитать();
		Если Запись.Значение = ИДСеанса Тогда
			ТекОбъект = Запись.Объект;
	        // и тут же удалим
	        Запись.Удалить();
		КонецЕсли;
    КонецЦикла;	
	
	Если ТекОбъект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = РегистрыСведений.ЗначенияСвойствОбъектов.Выбрать(Новый Структура("Свойство",ПВХ_ВремХранилище));
	Если Выборка.Следующий() Тогда
        Запись = Выборка.ПолучитьМенеджерЗаписи();
        // изменим
        Запись.Прочитать();
		
		АдресХранилища = Запись.Значение;
        // и тут же удалим
        Запись.Удалить();
	Иначе
		Возврат Ложь;
    КонецЕсли;	
	
	Структура = ПолучитьИзВременногоХранилища("e1cib/tempstorage/"+АдресХранилища);
	Если ТипЗнч(Структура) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Структура.ТабличныйДокумент = ПечДокумент;
	ПоместитьВоВременноеХранилище(Структура,"e1cib/tempstorage/"+АдресХранилища);
	
	Возврат Истина;
	
КонецФункции

Функция Версия() Экспорт
	Возврат "1.0";
КонецФункции

Процедура ЗагрузитьСчетаИзВчасно() 
	

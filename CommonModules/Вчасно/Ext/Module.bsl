Процедура ЗагрузитьСчетаИзMedoc(Организация) 
	
	//Организация = Справочники.Организации.НайтиПоКоду("000000000", Истина);
	КодЯзыкаПечать  =  Локализация.ПолучитьЯзыкФормированияПечатныхФорм(УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"),  "РежимФормированияПечатныхФорм"));
	СведенияОПоставщике  =  УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Организация,  ТекущаяДата(), , , КодЯзыкаПечать);
	Если Организация.ЮрФизЛицо  =  Перечисления.ЮрФизЛицо.ЮрЛицо Тогда			
		Если ЗначениеЗаполнено(СведенияОПоставщике.КодПоЕДРПОУ) Тогда
			КодПоЕДРПОУ  =  СокрЛП(СведенияОПоставщике.КодПоЕДРПОУ);
		КонецЕсли;
	КонецЕсли;	
	ДанныеДляОбработки = Новый Структура;
	ДанныеДляОбработки.Вставить("edrpou", КодПоЕДРПОУ);	
	ДанныеДляОбработки.Вставить("ТекущаяЗадача", "GetOrgCode");
	НастройкиАПИ = Справочники.НастройкиПодключенияКAPI.НайтиПоНаименованию("medoc");
	Сервер = НастройкиАПИ.Адрес;
	Если Найти(Сервер, "https") > 0 Тогда
		Протокол = "https";
	Иначе 
		Протокол = "http";
	КонецЕсли;
	Сервер = СтрЗаменить(Сервер, Протокол, ""); 
	Сервер = СтрЗаменить(Сервер, "://", "");
	Порт = 63777;
	Если НастройкиАПИ.ДопСвойства.Количество() > 0 Тогда
		Порт = Число(НастройкиАПИ.ДопСвойства[0].ДопСвойство);
	КонецЕсли;
	
	ИдОрг = "781";
	ЗащищенноеСоединение = Ложь;
	Таймаут              = 7;
	
	Если (Протокол = "https" Или Протокол = "ftps") И ЗащищенноеСоединение = Неопределено Тогда
		ЗащищенноеСоединение = Истина;

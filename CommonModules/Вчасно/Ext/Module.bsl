Функция ПолучитьОригиналДокумента(ПространствоИмен, ИДВчасно, КаталогДляСохранения, СуффиксЗапроса="original", ЭтоТекст=Истина, ЗаявкаНаРасходованиеСредств) Экспорт
	
	Результат = Неопределено;
	
	Отказ = Ложь;
	
	Токен = Справочники.НастройкиПодключенияКAPI.НайтиПоНаименованию("Вчасно Токен").Пароль;
	Прокси = Неопределено;
	Хост						 = "edo.vchasno.ua";
	НТТРВчасно = Новый HTTPСоединение(Хост,,,,Прокси,60,Новый ЗащищенноеСоединениеOpenSSL());  	// #106 
	ПространствоИменИсходящих	 = "/api/v1/documents";
	ПространствоИменВходящих	 = "/api/v1/incoming-documents";
	ПространствоИменДокументов	 = "/api/v2/documents";
	ПространствоИменЗагрузки	 = "/api/v2/download-documents";
	//ПространствоИмен = ПространствоИменВходящих;
	//ПространствоИмен = СтрЗаменить(ПространствоИмен, "/v1/", "/v2/"); // теперь так...
	
	Текст = Новый ТекстовыйДокумент;
	
	ЗаголовокHTTP = Новый Соответствие(); 
	
	ЗаголовокHTTP.Вставить("Authorization", "Token " + СокрЛП(Токен));
	ЗаголовокHTTP.Вставить("Vendor"		  , "Mastakov");
	
	ПараметрыЗапросаСтатусов = "/"+ИДВчасно+"/"+СуффиксЗапроса;
	
	ЗапросHTTP = Новый HTTPЗапрос(ПространствоИмен+ПараметрыЗапросаСтатусов, ЗаголовокHTTP);
	
	//Если РежимОтладки Тогда
	//	Сообщить("Запрос файла по ссылке ["+ТекущаяДата()+"]: "+ПространствоИмен+ПараметрыЗапросаСтатусов); // отладка					
	//КонецЕсли;
	
	тмпОтвет = ПолучитьИмяВременногоФайла("xml");
	
	ОтветHTTP = НТТРВчасно.Получить(ЗапросHTTP, тмпОтвет);
	
	КодОтвета = ОтветHTTP.КодСостояния;
	
	ФайлОтвета = Новый Файл(тмпОтвет);
	
	Если ФайлОтвета.Существует() Тогда
		
		Текст.Прочитать(тмпОтвет);
		
		Если КодОтвета < 300 Тогда // корректный код возврата  	
		
			Если Текст.КоличествоСтрок() > 0 Тогда
				тИмяФайла = "";
				Если ОтветHTTP.Заголовки.Получить("content-disposition") <> Неопределено Тогда
					тИмяФайла = ОтветHTTP.Заголовки["content-disposition"];
					Поз = Найти(тИмяФайла, Символ(34));
					Если Поз > 0 Тогда
						тИмяФайла = Сред(тИмяФайла, Поз+1);
						Поз = Найти(тИмяФайла, Символ(34));
						Если Поз > 0 Тогда
							тИмяФайла = Лев(тИмяФайла, Поз-1);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Если тИмяФайла = "" Тогда
					тИмяФайла = тмпОтвет;
					Поз = Найти(тИмяФайла, "\");
					Пока Поз > 0 Цикл
						тИмяФайла = Сред(тИмяФайла, Поз+1);
						Поз = Найти(тИмяФайла, "\");
					КонецЦикла;
				КонецЕсли;
				
				тИмя = тИмяФайла;
				тИмяФайла = КаталогДляСохранения + тИмяФайла;
				
				Если ЭтоТекст Тогда
					Попытка
						//Текст.Записать(тИмяФайла, КодировкаТекста.ANSI , );
					Исключение
						//Сообщить("Неудачная попытка получения файла "+тИмяФайла+" : "+ОписаниеОшибки(), СтатусСообщения.Внимание);
					КонецПопытки;
				Иначе
					Попытка
						//ПереместитьФайл(тмпОтвет, тИмяФайла);
						
						ПрисоединенныйФайл = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();

						ПрисоединенныйФайл.ВидДанных = Перечисления.ВидыДополнительнойИнформацииОбъектов.Файл;
						ПрисоединенныйФайл.ИмяФайла = тИмя;
						ПрисоединенныйФайл.Наименование = тИмя;
						ПрисоединенныйФайл.Объект = ЗаявкаНаРасходованиеСредств;
						ДФайл = Новый ДвоичныеДанные(тмпОтвет);
						ПрисоединенныйФайл.Хранилище = Новый ХранилищеЗначения(ДФайл, Новый СжатиеДанных);
						Попытка
							ПрисоединенныйФайл.Записать();
						Исключение
						КонецПопытки;
						
					Исключение
						//Сообщить("Неудачная попытка получения файла "+тИмяФайла+" : "+ОписаниеОшибки(), СтатусСообщения.Внимание);
					КонецПопытки;
				КонецЕсли;
				// проверка
				_Файл = Новый Файл(тИмяФайла);
				Если _Файл.Существует() И _Файл.ЭтоФайл() Тогда
					Результат = тИмяФайла;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Результат) Тогда
					//Сообщить("Не найден полученный файл "+тИмяФайла, СтатусСообщения.Внимание);
				КонецЕсли;
				
			Иначе 
				//Сообщить("Получения пустой ответ по ИДВчасно: "+ИДВчасно, СтатусСообщения.Внимание);
			КонецЕсли;
		Иначе
			
			ТекстОтвета = Новый ТекстовыйДокумент();
			ТекстОтвета.Прочитать(тмпОтвет,КодировкаТекста.UTF8);
			Если ТекстОтвета.КоличествоСтрок() > 0 Тогда
				ОтветСервера = ТекстОтвета.ПолучитьТекст();	
			КонецЕсли;	
			
			_ЧтениеXML = Новый ЧтениеXML;
			
			Попытка
				_ЧтениеXML.УстановитьСтроку(ОтветСервера);
			Исключение
				ОбщегоНазначения.СообщитьОбОшибке("Неудачная попытка чтения ответа сервиса: "+ОписаниеОшибки(), Отказ);
			КонецПопытки;
			
			Если НЕ Отказ Тогда
			
				Поз = Найти(Лев(ОтветСервера, 5), "xml");
				Если Поз = 0 Тогда
					//ОбщегоНазначения.СообщитьОбОшибке("Неудачная попытка разбора ответа сервиса (Код состояния = "+КодОтвета+"): ", Отказ);
					//ОбщегоНазначения.СообщитьОбОшибке(ОтветСервера);
				Иначе
					//ОбработатьОписаниеОшибки(_ЧтениеXML, КодОтвета);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		ОбщегоНазначения.СообщитьОбОшибке("Не найден файл ответа сервиса: "+тмпОтвет);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьФайлДокументаНовый(url, ИмяПараметра=Неопределено, ЗаявкаНаРасходованиеСредств, Расширение, Заявка) 
	
	Токен = Справочники.НастройкиПодключенияКAPI.НайтиПоНаименованию("Вчасно Токен").Пароль;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Токен);

	//Ответ = "C:\VR\Vchasno\";
	Ответ = "";
	мСерверЕДО = "edo.vchasno.ua";
	тИДВчасно = url;
	ФайлСохранен = Ложь; 			
	Если Расширение = ".pdf" Тогда
		ФайлСохранен = HTTP("GET", "https", мСерверЕДО, , "/api/v2/documents/" + тИДВчасно + "/pdf/print", Заголовки, , , Ответ, "", Заявка);
	ИначеЕсли Расширение = ".xml" Тогда
		Запрос = Новый Соответствие;
		Запрос.Вставить("force", Истина);
		ФайлСохранен = HTTP("POST", "https", мСерверЕДО, , "/api/v2/documents/" + тИДВчасно + "/xml-to-pdf", Заголовки, "JSON", Запрос, Ответ, "", Заявка);
	КонецЕсли;		
	
	Если Не ФайлСохранен Тогда
		ФайлСохранен = HTTP("GET", "https", мСерверЕДО, , "/api/v2/documents/" + тИДВчасно + "/original", Заголовки, , , Ответ, "", Заявка);
	КонецЕсли;
				
КонецПроцедуры

Функция HTTP(Метод, Схема, Сервер, Порт = Неопределено, АдресРесурса, ЗаголовкиЗапроса = Неопределено, ТипЗапроса = Неопределено, Запрос = Неопределено, Ответ, ПолеСообщения = "", Заявка) Экспорт

	мСчетчикЗапросов = 1;	
	Результат = Истина;                       
	
	Если Порт = Неопределено Тогда
		Порт = ?(Схема = "http", 80, 443);
	КонецЕсли;
	
	Прокси = Неопределено;
	HTTPСоединение = Новый HTTPСоединение(Сервер, Порт, , , Прокси, , ?(Схема = "http", Неопределено, Новый ЗащищенноеСоединениеOpenSSL));
	URL = Метод + ": " + Схема + "://" + Сервер + ":" + Порт + АдресРесурса;
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, ?(ЗаголовкиЗапроса = Неопределено, Новый Соответствие, ЗаголовкиЗапроса));
	
	Если ТипЗапроса = "form-data" Тогда
		Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
		
		Файл = Новый Файл(Запрос);
		
		Поток = Новый ПотокВПамяти;
		ЗаписьДанных = Новый ЗаписьДанных(Поток, , , Символы.ВК + Символы.ПС, "");
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);
		ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""file""; filename=""" + Файл.Имя + """");
		ЗаписьДанных.ЗаписатьСтроку("Content-Type: application/pdf");
		ЗаписьДанных.ЗаписатьСтроку("");
		ЗаписьДанных.Записать(Новый ДвоичныеДанные(Запрос)); 
		ЗаписьДанных.ЗаписатьСтроку("");
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--");
		ЗаписьДанных.Закрыть();
		
		Данные = Поток.ЗакрытьИПолучитьДвоичныеДанные();	
		HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(Данные);
	ИначеЕсли ТипЗапроса = "Text" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/plain");
	ИначеЕсли ТипЗапроса = "JavaScript" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/javascript");
	ИначеЕсли ТипЗапроса = "JSON" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Запрос);
		
		ТелоЗапросаКакСтрока = ЗаписьJSON.Закрыть();
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаКакСтрока, , ИспользованиеByteOrderMark.НеИспользовать);		
	ИначеЕсли ТипЗапроса = "HTML" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/html");
	ИначеЕсли ТипЗапроса = "XML" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/xml");
	КонецЕсли;
	
	Попытка
		Если Метод = "GET" Тогда
			HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		ИначеЕсли Метод = "POST" Тогда
			HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		ИначеЕсли Метод = "PUT" Тогда
			HTTPОтвет = HTTPСоединение.Записать(HTTPЗапрос);
		ИначеЕсли Метод = "PATCH" Тогда
			HTTPОтвет = HTTPСоединение.Изменить(HTTPЗапрос);
		ИначеЕсли Метод = "DELETE" Тогда
			HTTPОтвет = HTTPСоединение.Удалить(HTTPЗапрос);
		ИначеЕсли Метод = "HEAD" Тогда
			HTTPОтвет = HTTPСоединение.ПолучитьЗаголовки(HTTPЗапрос);
		Иначе
			HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		КонецЕсли;
	Исключение
		Результат = Ложь;
		Ответ = ОписаниеОшибки();		
	КонецПопытки;
	
	Если Результат Тогда
		
		ЗаголовкиОтвета = Новый Соответствие;
		Для Каждого ЗаголовокОтвета Из HTTPОтвет.Заголовки Цикл
			ЗаголовкиОтвета.Вставить(НРег(ЗаголовокОтвета.Ключ), ЗаголовокОтвета.Значение);
		КонецЦикла;
		
		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 299 Тогда
			Если ЗаголовкиОтвета["content-disposition"] <> Неопределено И Найти(ЗаголовкиОтвета["content-disposition"], "Attachment") Тогда
				Ответ = Ответ + "-";
				
				ИмяФайла = ЗаголовкиОтвета["content-disposition"];
				ИмяФайла = СтрЗаменить(ИмяФайла, "Attachment; filename=", "");
				ИмяФайла = СтрЗаменить(ИмяФайла, """", "");
				ИмяФайла = Прав(ИмяФайла, 255 - СтрДлина(Ответ));
				
				Ответ = Ответ + ИмяФайла;
				
				//HTTPОтвет.ПолучитьТелоКакДвоичныеДанные().Записать(Ответ);
				
				Попытка
					ПрисоединенныйФайл = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
					ПрисоединенныйФайл.ВидДанных = Перечисления.ВидыДополнительнойИнформацииОбъектов.Файл;
					ПрисоединенныйФайл.ИмяФайла = ИмяФайла;
					ПрисоединенныйФайл.Наименование = ИмяФайла;
					ПрисоединенныйФайл.Объект = Заявка;
					ДФайл = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
					//ДФайл = Новый ДвоичныеДанные(тмпОтвет);
					ПрисоединенныйФайл.Хранилище = Новый ХранилищеЗначения(ДФайл, Новый СжатиеДанных);
					Попытка
						ПрисоединенныйФайл.Записать();
					Исключение
					КонецПопытки;
					
				Исключение
					//Сообщить("Неудачная попытка получения файла "+тИмяФайла+" : "+ОписаниеОшибки(), СтатусСообщения.Внимание);
				КонецПопытки;
				
			ИначеЕсли Найти(ЗаголовкиОтвета["content-type"], "application/json") Тогда
				ТелоОтветаКакСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
				Если ПустаяСтрока(ТелоОтветаКакСтрока) Тогда
					ТелоОтветаКакСтрока = "{}";
				КонецЕсли;
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(ТелоОтветаКакСтрока);
				
				Ответ = ПрочитатьJSON(ЧтениеJSON, Истина);
			КонецЕсли; 	
		ИначеЕсли HTTPОтвет.КодСостояния >= 300 И HTTPОтвет.КодСостояния < 399 Тогда
			Перенаправление = ЗаголовкиОтвета["location"];
			Разделитель = Найти(Перенаправление, "://");
			Схема = Лев(Перенаправление, Разделитель - 1);
			
			Перенаправление = Сред(Перенаправление, Разделитель + 3);
			Разделитель = Найти(Перенаправление, "/");
			АдресРесурса = Сред(Перенаправление, Разделитель);
			
			Перенаправление = Лев(Перенаправление, Разделитель - 1);
			Разделитель = Найти(Перенаправление, ":");
			Если Разделитель Тогда
				Сервер = Лев(Перенаправление, Разделитель - 1);
				Порт = +Сред(Перенаправление, Разделитель + 1);
			Иначе
				Сервер = Перенаправление;
				Порт = Неопределено;
			КонецЕсли;
			
			Возврат HTTP(Метод, Схема, Сервер, Порт, АдресРесурса, ЗаголовкиЗапроса, ТипЗапроса, Запрос, Ответ, ПолеСообщения, Заявка);		
		Иначе
			Результат = Ложь;
			
			Если Найти(ЗаголовкиОтвета["content-type"], "application/json") Тогда
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
				

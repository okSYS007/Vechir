Функция ПолучитьДатуИзСтроки(Стр)
	
	Результат = СокрЛП(Стр);
	
	Поз = Найти(Результат, ".");
	Если Поз>0 Тогда
		Результат = Лев(Результат, Поз-1);
	КонецЕсли;
	Поз = Найти(Результат, "+");
	Если Поз>0 Тогда
		Результат = Лев(Результат, Поз-1);
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "-", "");
	Результат = СтрЗаменить(Результат, ":", "");
	Результат = СтрЗаменить(Результат, "T", "");
	
	Попытка
		Результат = Дата(Результат);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Процедура ПолучитьФайлДокумента(url, ИмяПараметра=Неопределено, ЗаявкаНаРасходованиеСредств) 
	

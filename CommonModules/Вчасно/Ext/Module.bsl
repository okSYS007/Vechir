	//ЗаголовокHTTP.Вставить("content-type", "application/xml"); //???
	ЗаголовокHTTP.Вставить("Accept", "application/xml");
	
	ПараметрыЗапросаСтатусов = "?";
	
	//Для Каждого Эл Из СоответствиеСтрокСИД Цикл
	//	
	//	ПараметрыЗапросаСтатусов = ПараметрыЗапросаСтатусов + "ids="+Эл.Ключ+"&";
	//	          /api/v2/download-documents?ids=b170de83-1f29-45ba-b5c6-073d0507c848
	//КонецЦикла;
	ПараметрыЗапросаСтатусов = ПараметрыЗапросаСтатусов + "ids="+url+"&";
	
	ПараметрыЗапросаСтатусов = Лев(ПараметрыЗапросаСтатусов, СтрДлина(ПараметрыЗапросаСтатусов)-1);
	
	Отказ = Ложь;
	
	ЗапросHTTP = Новый HTTPЗапрос(ПространствоИмен+ПараметрыЗапросаСтатусов, ЗаголовокHTTP);
	
	//Если РежимОтладки Тогда
	//	Сообщить("Запрос ссылок по "+ИмяПараметра+" ["+ТекущаяДата()+"]: "+ПространствоИмен+ПараметрыЗапросаСтатусов); // отладка				
	//КонецЕсли;
	//Ответ от сервера получим в возвращаемом значении типа HTTPОтвет
	тмпОтвет = ПолучитьИмяВременногоФайла("txt");
	ОтветHTTP = НТТРВчасно.Получить(ЗапросHTTP, тмпОтвет);
	КодОтвета = ОтветHTTP.КодСостояния;
	Текст.Прочитать(тмпОтвет);
	
	ФайлОтвета = Новый Файл(тмпОтвет);
	Если ФайлОтвета.Существует() Тогда
		ТекстОтвета = Новый ТекстовыйДокумент();
		ТекстОтвета.Прочитать(тмпОтвет,КодировкаТекста.UTF8);
		Если ТекстОтвета.КоличествоСтрок() > 0 Тогда

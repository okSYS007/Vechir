	ДанныеДляОбработки.Вставить("Порт", Порт); 
	
	//orgId = ПереходНаМодульОбъектаСервер( ДанныеДляОбработки );
	orgId = ОтправкаЗапроса( ДанныеДляОбработки, "");
	ДанныеДляОбработки.Вставить("idOrg", orgId);  
	//НачПериода = ТекущаяДата();
	НачПериода = ТекущаяДата() - 60*60*24*20;
	КонПериода = ТекущаяДата();	
	ДанныеДляОбработки.ТекущаяЗадача = "GetPrimaryReestr";
	ДанныеДляОбработки.Вставить("dateFrom", Формат(НачПериода,"ДФ=yyyy/MM/dd"));  
	ДанныеДляОбработки.Вставить("dateEnd", Формат(КонПериода,"ДФ=yyyy/MM/dd"));  
	
	ТекРеестрВходящиеДок = ОтправкаЗапроса(ДанныеДляОбработки, "");
	
	ТЗЗаявки = Новый ТаблицаЗначений;
	ТЗЗаявки.Колонки.Добавить("Документ");
	ТЗЗаявки.Колонки.Добавить("Код");
	
	Для каждого ТекЗнач Из ТекРеестрВходящиеДок Цикл

		Если ТекЗнач.doc_type <> 10103 Тогда 
			Продолжить;
		КонецЕсли;
		
		НомерДок = СокрЛП(ТекЗнач.doc_num);
		ДатаДок = Дата(СокрЛП(ТекЗнач.doc_date));	
		Счет = НайтиДокументПоНомеруИДате(НомерДок, ДатаДок, Организация);
		Если ЗначениеЗаполнено(Счет) Тогда 
			Продолжить;
		КонецЕсли; 
		
		нДок = Документы.ЗаявкаНаРасходованиеСредств.СоздатьДокумент();

Функция СформироватьJSON(ДанныеДляОбработки)
	
	ЗаписьДанныхСообщения = Новый ЗаписьJSON;
	ЗаписьДанныхСообщения.УстановитьСтроку();
	//ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("");
	ЗаписьДанныхСообщения.ЗаписатьНачалоМассива();
	
	Для Каждого ТекВложение Из ДанныеДляОбработки Цикл 
		
		ЗаписьДанныхСообщения.ЗаписатьНачалоОбъекта(); 
		
		ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("TAB");
		ЗаписьДанныхСообщения.ЗаписатьЗначение(ТекВложение.TAB);
		ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("LINE");
		ЗаписьДанныхСообщения.ЗаписатьЗначение(ТекВложение.LINE);
		ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("NAME");
		ЗаписьДанныхСообщения.ЗаписатьЗначение(ТекВложение.NAME);
		ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("VALUE");
		ЗаписьДанныхСообщения.ЗаписатьЗначение(СокрЛП(ТекВложение.VALUE));
		
		ЗаписьДанныхСообщения.ЗаписатьКонецОбъекта();
	КонецЦикла;
	
	ЗаписьДанныхСообщения.ЗаписатьКонецМассива();
	Возврат	ЗаписьДанныхСообщения.Закрыть(); 
	
КонецФункции

Процедура ЭДО() Экспорт 
	
	ЗагрузитьСчетаИзВчасно();
	
	масОрганизации = Новый Массив;
	масОрганизации.Добавить(Справочники.Организации.НайтиПоКоду("000000000", Истина));
	масОрганизации.Добавить(Справочники.Организации.НайтиПоКоду("000000012", Истина));
	
	Для Каждого элемент Из масОрганизации Цикл 
		ЗагрузитьСчетаИзMedoc(элемент);
	КонецЦикла;

КонецПроцедуры	

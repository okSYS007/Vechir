		КонецЕсли;
		
		Курсор = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСсылкиНаФайлыВСтроках(url, _ЧтениеXML, ИмяПараметра, ЗаявкаНаРасходованиеСредств)

	Отказ = Ложь;	
	
	МассивСсылокДокумента = Новый Массив;
	
	НаборПараметровОтвета = Новый Структура("id, extension, archive_url, original_url, pdf_url, xml_to_pdf_url, status");
	
	ПостроительД = Новый ПостроительDOM;
	Содержимое	 = ПостроительД.Прочитать(_ЧтениеXML);
	УзелЗаголовка = Содержимое.ПервыйДочерний;
	Если УзелЗаголовка = Неопределено Тогда
		//ОбщегоНазначения.СообщитьОбОшибке("Не обнаружены узлы в ответе сервиса", Отказ);
	ИначеЕсли УзелЗаголовка.ИмяУзла <> "response" Тогда
		//ОбщегоНазначения.СообщитьОбОшибке("Не обнаружен узел заголовка ответа в ответе сервиса", Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УзелДокументов = Неопределено;
	
	КоличествоГотовых 	= 0;
	КоличествоВсего 	= 0;
	
	Для Каждого ДочернийУзел Из УзелЗаголовка.ДочерниеУзлы Цикл
		тИмяУзла = ДочернийУзел.ИмяУзла;
		Если тИмяУзла = "documents" Тогда
			УзелДокументов = ДочернийУзел;
		ИначеЕсли тИмяУзла = "ready" Тогда
			Если ЗначениеЗаполнено(ДочернийУзел.ТекстовоеСодержимое) Тогда
				КоличествоГотовых = Число(ДочернийУзел.ТекстовоеСодержимое);
			КонецЕсли;
		ИначеЕсли тИмяУзла = "total" Тогда
			Если ЗначениеЗаполнено(ДочернийУзел.ТекстовоеСодержимое) Тогда
				КоличествоВсего = Число(ДочернийУзел.ТекстовоеСодержимое);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если УзелДокументов = Неопределено Тогда
		//ОбщегоНазначения.СообщитьОбОшибке("Не обнаружены узлы в заголове ответа сервиса", Отказ);
	//ИначеЕсли КоличествоВсего = 0 ИЛИ КоличествоГотовых = 0 Тогда
	//	ОбщегоНазначения.СообщитьОбОшибке("Не обнаружено готовых ссылок", Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Узел из УзелДокументов.ДочерниеУзлы Цикл	
		Если Узел.ИмяУзла = "document" Тогда
			СтруктураСсылокДокумента = Новый Структура;
			ПараметрыДокумента = Узел.ДочерниеУзлы;
			Для Каждого ПараметрДокумента Из ПараметрыДокумента Цикл
				Если НаборПараметровОтвета.Свойство(ПараметрДокумента.ИмяУзла) Тогда
					СтруктураСсылокДокумента.Вставить(ПараметрДокумента.ИмяУзла, ПараметрДокумента.ТекстовоеСодержимое);
				Иначе 
					//ОбщегоНазначения.СообщитьОбОшибке("Получен неожиданный параметр: "+ПараметрДокумента.ИмяУзла);
				КонецЕсли;
			КонецЦикла;
			МассивСсылокДокумента.Добавить(СтруктураСсылокДокумента);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСсылокДокумента.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтоТекст = Истина;
	
	Если ИмяПараметра = "xml_to_pdf_url" Тогда
		СуффиксЗапроса = "xml-to-pdf";
		ИмяКолонки = "СсылкаНаПДФ";
		ЭтоТекст = Ложь;
	ИначеЕсли ИмяПараметра = "archive_url" Тогда
		СуффиксЗапроса = "archive";
		ИмяКолонки = "СсылкаНаАрхив";
		ЭтоТекст = Ложь;
	ИначеЕсли ИмяПараметра = "original_url" Тогда
		СуффиксЗапроса = "original";

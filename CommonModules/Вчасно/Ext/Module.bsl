		УправлениеДенежнымиСредствами.ЗаполнитьРеквизитыРасчетногоДокумента(нДок, глЗначениеПеременной("глТекущийПользователь"), мВалютаРегламентированногоУчета, нДок.РасшифровкаПлатежа);
		//ЦФО = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь,"ОсновноеПодразделение");
		нДок.ФормаОплаты = Перечисления.ВидыДенежныхСредств.Безналичные;
		нДок.Статус = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Черновик;
		Если ТекЗнач.partner_edrpou <> "" Тогда
			Контрагент = НайтиКонтрагентаПоКодуЕДРПОУ(ТекЗнач.partner_edrpou);
			Если Контрагент <> Неопределено Тогда
				нДок.Контрагент = Контрагент;	
			КонецЕсли;	
		КонецЕсли;
		Если нДок.РасшифровкаПлатежа.Количество() > 0 Тогда 
			нДок.РасшифровкаПлатежа[0].СуммаВзаиморасчетов = СуммаДокумента;
			нДок.РасшифровкаПлатежа[0].СуммаПлатежа = СуммаДокумента;
			нДок.РасшифровкаПлатежа[0].КратностьВзаиморасчетов = 1;
			нДок.РасшифровкаПлатежа[0].КурсВзаиморасчетов = 1;
		КонецЕсли;	
		
		Попытка
			нДок.Записать(РежимЗаписиДокумента.Запись,);
            нстр = ТЗЗаявки.Добавить();
			нстр.Документ = нДок.Ссылка;
			нстр.Код = СокрЛП(ТекЗнач.cardcode);
		Исключение
			ЗаписьЖурналаРегистрации( НСтр("ru = 'Документ не записан medoc';uk = 'Документ не записаний medoc'") );
		КонецПопытки;	
		
	КонецЦикла;
		
	ДанныеДляОбработки.ТекущаяЗадача = "PrintDocPDF";

	Для Каждого стр Из ТЗЗаявки Цикл
		
		ОтветСтруктура = ОтправкаЗапроса(ДанныеДляОбработки, СтрЗаменить(строка(стр.Код),Символы.НПП,""));
		

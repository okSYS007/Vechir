Процедура ОтчетОРозничныхПродажах_ОбработкаПроведения(Источник, Отказ, РежимПроведения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.Ссылка,
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Сумма,
		|	ВложенныйЗапрос.СуммаНДС,
		|	ВложенныйЗапрос1.СуммаОборотДт,
		|	ВложенныйЗапрос1.СуммаОборотКт,
		|	ВложенныйЗапрос1.КоличествоОборотКт,
		|	ВложенныйЗапрос.Количество,
		|	ВложенныйЗапрос.СтавкаНДС
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОтчетОРозничныхПродажахТовары.Ссылка КАК Ссылка,
		|		ОтчетОРозничныхПродажахТовары.Номенклатура КАК Номенклатура,
		|		СУММА(ОтчетОРозничныхПродажахТовары.Количество * ОтчетОРозничныхПродажахТовары.Коэффициент) КАК Количество,
		|		СУММА(ОтчетОРозничныхПродажахТовары.Сумма) КАК Сумма,
		|		СУММА(ОтчетОРозничныхПродажахТовары.СуммаНДС) КАК СуммаНДС,
		|		ОтчетОРозничныхПродажахТовары.СчетУчетаБУ КАК СчетУчетаБУ,
		|		ОтчетОРозничныхПродажахТовары.СтавкаНДС КАК СтавкаНДС
		|	ИЗ
		|		Документ.ОтчетОРозничныхПродажах.Товары КАК ОтчетОРозничныхПродажахТовары
		|	ГДЕ
		|		ОтчетОРозничныхПродажахТовары.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ОтчетОРозничныхПродажахТовары.Номенклатура,
		|		ОтчетОРозничныхПродажахТовары.Ссылка,
		|		ОтчетОРозничныхПродажахТовары.СчетУчетаБУ,
		|		ОтчетОРозничныхПродажахТовары.СтавкаНДС) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ХозрасчетныйОбороты.Счет КАК Счет,
		|			ХозрасчетныйОбороты.Субконто1 КАК Субконто1,
		|			СУММА(ХозрасчетныйОбороты.СуммаОборотДт) КАК СуммаОборотДт,
		|			СУММА(ХозрасчетныйОбороты.СуммаОборотКт) КАК СуммаОборотКт,
		|			ХозрасчетныйОбороты.КорСчет КАК КорСчет,
		|			ХозрасчетныйОбороты.КорСубконто1 КАК КорСубконто1,
		|			ХозрасчетныйОбороты.Регистратор КАК Регистратор,
		|			ХозрасчетныйОбороты.КоличествоОборотКт КАК КоличествоОборотКт
		|		ИЗ
		|			РегистрБухгалтерии.Хозрасчетный.Обороты(, , Регистратор, , , , , ) КАК ХозрасчетныйОбороты
		|		ГДЕ
		|			ХозрасчетныйОбороты.Регистратор = &Ссылка
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ХозрасчетныйОбороты.КорСчет,
		|			ХозрасчетныйОбороты.Счет,
		|			ХозрасчетныйОбороты.КорСубконто1,
		|			ХозрасчетныйОбороты.Субконто1,
		|			ХозрасчетныйОбороты.Регистратор,
		|			ХозрасчетныйОбороты.КоличествоОборотКт) КАК ВложенныйЗапрос1
		|		ПО ВложенныйЗапрос.Ссылка = ВложенныйЗапрос1.Регистратор
		|			И ВложенныйЗапрос.Номенклатура = ВложенныйЗапрос1.Субконто1
		|			И ВложенныйЗапрос.СчетУчетаБУ = ВложенныйЗапрос1.Счет";
	
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Движения = Источник.Движения;
	
	Контрагент = Источник.КассаККМ.Контрагент;

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Движение = Движения.ИНАГРО_РеализацияОрганизаций.Добавить();
		Движение.Период = Источник.Дата;
		Движение.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		Движение.Организация = Источник.Организация;
		Движение.Склад = Источник.Склад;
		Движение.СтавкаНДС = ВыборкаДетальныеЗаписи.СтавкаНДС;
		Движение.Контрагент = Контрагент;
		Движение.Количество = ВыборкаДетальныеЗаписи.КоличествоОборотКт;
		Движение.Стоимость = ВыборкаДетальныеЗаписи.Сумма;
		Движение.СуммаНДС = ВыборкаДетальныеЗаписи.СуммаНДС/ВыборкаДетальныеЗаписи.Количество*ВыборкаДетальныеЗаписи.КоличествоОборотКт;
		Движение.СебестоимостьСумма = ВыборкаДетальныеЗаписи.СуммаОборотКт;
		Движение.СебестоимостьЦена = ?(ВыборкаДетальныеЗаписи.КоличествоОборотКт = 0 Или ВыборкаДетальныеЗаписи.СуммаОборотКт = 0,0,ВыборкаДетальныеЗаписи.СуммаОборотКт/ВыборкаДетальныеЗаписи.КоличествоОборотКт);		
	КонецЦикла;

	
КонецПроцедуры	



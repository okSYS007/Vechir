Функция ПолучитьОстатокПоЗаявке(Заявка)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДенежныеСредстваКВыплатеОстатки.СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.ЗаявкиНаРасходованиеСредств.Остатки КАК ДенежныеСредстваКВыплатеОстатки
	               |ГДЕ
	               |	ДенежныеСредстваКВыплатеОстатки.ЗаявкаНаРасходование = &ЗаявкаНаРасходованиеДенежныхСредств";
	Запрос.УстановитьПараметр("ЗаявкаНаРасходованиеДенежныхСредств",Заявка);
	
	РезультатЗапрос = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапрос.Количество() Тогда 
		Возврат РезультатЗапрос[0].СуммаОстаток;
		
	КонецЕсли;
	Возврат 0;	
КонецФункции



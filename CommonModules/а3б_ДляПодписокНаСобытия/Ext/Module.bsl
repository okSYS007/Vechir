Процедура ВыборУчастка(ТекущаяСтрока, Элемент) Экспорт
	
	ТЗУчастки = РезультатЗапросаУчасткиИзДоговора(ТекущаяСтрока.ДоговорКонтрагента).Выгрузить();
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ТЗУчастки.ВыгрузитьКолонку("Участок"));
	
	ФормаВыбора = Справочники.ИНАГРО_Участки.ПолучитьФормуВыбора(,Элемент);
	ФормаВыбора.РежимВыбора = Истина;
	ФормаВыбора.НачальноеЗначениеВыбора = Элемент.Значение;
	ФормаВыбора.ЭлементыФормы.СправочникСписок.ИерархическийПросмотр = Ложь;
	
	ФормаВыбора.Отбор.Ссылка.Использование = Истина;
	ФормаВыбора.Отбор.Ссылка.ВидСравнения = ВидСравнения.ВСписке;
	ФормаВыбора.Отбор.Ссылка.Значение = Список;
	
	ФормаВыбора.Открыть();

		Выполнить(Источник.Метаданные().Имя+"_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);");
		
	КонецЕсли;
	
КонецПроцедуры


Процедура НалоговаяНакладная_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения)
	если ложь тогда  Источник = Документы.НалоговаяНакладная.СоздатьДокумент(); КонецЕсли;
	
	Если не ЗначениеЗаполнено(Источник.КтоВыписалНалоговуюНакладную) Тогда 
		отвЛ = ФормированиеПечатныхФорм.ОтветственныеЛица(Источник.Организация,Источник.Дата);
		Если ЗначениеЗаполнено(отвЛ.ГлавныйБухгалтер) Тогда 
			Источник.КтоВыписалНалоговуюНакладную = отвЛ.ГлавныйБухгалтер;
		иначе	
			Источник.КтоВыписалНалоговуюНакладную = отвЛ.Руководитель;
		КонецЕсли;	
		
	КонецЕсли;	
КонецПроцедуры	

Процедура анУстановитьСтатусОплаченоОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Попытка
		
		
		
		Если ТипЗнч(Источник) = тип("ДокументОбъект.ПлатежноеПоручениеИсходящее") Тогда 
			

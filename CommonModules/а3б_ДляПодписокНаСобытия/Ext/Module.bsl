функция ПолучитьКурсНацБанка(мВалюта,мДата,ИмяВходящегоФайла) 

	Соединение = Новый HTTPСоединение("bank.gov.ua",443,,,,,Новый ЗащищенноеСоединениеOpenSSL());

	ВалютаФормат = мВалюта.Наименование;
	ДатаФормат = Формат(мДата, "ДФ=yyyyMMdd"); 
	Запрос = Новый HTTPЗапрос("/NBUStatService/v1/statdirectory/exchange?valcode="+ВалютаФормат+"&date="+ДатаФормат+"&json"); 

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("User-Agent", "Mozilla/5.0 (X11; Linux i686; rv:2.0.1) Gecko/20100101 Firefox/4.0.1");
	Заголовки.Вставить("Cookie", "id=1");

	Запрос.Заголовки = Заголовки;
	
	
	Попытка
		Ответ = Соединение.Получить(Запрос,ИмяВходящегоФайла);
		Возврат Истина;
	Исключение
		
	КонецПопытки;

Конецфункции




		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Автомобиль) Тогда
			//УзелПланаОбмена = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(МобильныйДокумент.КодУзлаОбмена);

		Автомобиль = ПолучитьАвтоПоФизЛицу(ДокументОбъект.ФизЛицо);
		
		ДокументОбъект.Автомобиль = Автомобиль;
		//ДокументОбъект.ГосНомер = Автомобиль.ГосНомер;
		ДокументОбъект.Водитель = Автомобиль.Водитель;
		ЗаполнитьЗначенияСвойств(ДокументОбъект,Автомобиль);
		
		ДанныеМоб = МобильныйДокумент.Данные;
		ДанныеМаршрут = "";

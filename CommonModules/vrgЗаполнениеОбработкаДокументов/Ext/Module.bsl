Процедура ЗаполнитьИзменитьДокументТребованиеНакладнаяУТП(МобильныйДокумент, ДокументОбъект, УзелОбмена) Экспорт
	
	ДокументОбъект.Дата          = МобильныйДокумент.Дата;
	//+BalakoD 20230130
	ДокументОбъект.ДатаСоздания  = ТекущаяДата();
	//-BalakoD 20230130
	ДокументОбъект.ВидОперации   = Перечисления.ВидыОперацийТребованиеНакладная.Материалы;
	ДокументОбъект.Склад         = МобильныйДокумент.Склад;
	ДокументОбъект.Подразделение = МобильныйДокумент.Подразделение;
	ДокументОбъект.Организация   = МобильныйДокумент.Организация;
	ДокументОбъект.Ответственный = МобильныйДокумент.Ответственный;
	ДокументОбъект.Комментарий   = МобильныйДокумент.Комментарий;
	ДокументОбъект.Акция   = 	   МобильныйДокумент.Акция;
	//
	
	ДокументОбъект.СтатьяЗатрат      = МобильныйДокумент.СтатьиЗатрат;
	ДокументОбъект.НаправлениеЗатрат = МобильныйДокумент.НаправлениеЗатрат;
	ДокументОбъект.Абонент           = МобильныйДокумент.Абонент;
	ДокументОбъект.Договор           = МобильныйДокумент.Договор;
	
	ДокументОбъект.НомерОпоры        = МобильныйДокумент.НомерОпоры;
	ДокументОбъект.НомерБокса        = МобильныйДокумент.НомерБокса;
	
	ДокументОбъект.Район             = МобильныйДокумент.Район;	
	ДокументОбъект.НаселенныйПункт   = МобильныйДокумент.НаселенныйПункт;
	ДокументОбъект.Улица             = МобильныйДокумент.Улица;
	ДокументОбъект.Дом               = МобильныйДокумент.Дом;
	ДокументОбъект.Квартира          = МобильныйДокумент.Квартира;
	
	ДокументОбъект.БезналичныйРасчет = МобильныйДокумент.БезналичныйРасчет;
	ДокументОбъект.НомерТранзакцииAbills = МобильныйДокумент.НомерТранзакцииAbills;
	
	
	ДокументОбъект.ОтражатьВУправленческомУчете          = Истина;
	
	//Договор Договор строкой куда передать?
	
	
	ДокументОбъект.Материалы.Очистить();
	Для Каждого СтрокаТовары Из МобильныйДокумент.Товары Цикл
		Если СтрокаТовары.Количество <= 0 Тогда 
			Продолжить;
		Иначе 
			
			СтрокаТабличнойЧасти                   = ДокументОбъект.Материалы.Добавить();
			СтрокаТабличнойЧасти.Номенклатура      = СтрокаТовары.Номенклатура;
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
			СтрокаТабличнойЧасти.СерияНоменклатуры = СтрокаТовары.СерияНоменклатуры;
			СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = СтрокаТовары.ХарактеристикаНоменклатуры;
			СтрокаТабличнойЧасти.Количество        = СтрокаТовары.Количество;
			СтрокаТабличнойЧасти.ЕдиницаИзмерения  = СтрокаТовары.ЕдиницаИзмерения;
			СтрокаТабличнойЧасти.Коэффициент       = СтрокаТовары.Коэффициент;
			ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, Ложь);
			СтрокаТабличнойЧасти.Качество          = Справочники.Качество.Новый;
			СтрокаТабличнойЧасти.СпособСписанияОстаткаТоваров          = ПредопределенноеЗначение("Перечисление.СпособыСписанияОстаткаТоваров.СоСклада");
			
		КонецЕсли;
	КонецЦикла;
	
	//+NovashIV_21.04.2023
	ДокументОбъект.ОтражатьВБухгалтерскомУчете           = Ложь;
	//-NovashIV_21.04.2023
	
	//Дандали В. 21.10.2025 +
	Если ЗначениеЗаполнено(МобильныйДокумент.Заказ) Тогда
		МенеджерЗаписиСоответствия = РегистрыСведений.vrgСоответствияМобильныхДокументов.СоздатьМенеджерЗаписи();
		МенеджерЗаписиСоответствия.МобильныйДокумент = МобильныйДокумент.Заказ;
		МенеджерЗаписиСоответствия.Прочитать();
		Если МенеджерЗаписиСоответствия.Выбран() Тогда
			ДокументОбъект.ДокументОснование = МенеджерЗаписиСоответствия.ОсновнойДокумент;
		КонецЕсли;
	КонецЕсли;
	//Дандали В. 21.10.2025 -
	
	
КонецПроцедуры
//-NovashIV_24.01.2023

Процедура ЗаполнитьИзменитьДокументМаршрутныйЛистУТП(МобильныйДокумент, ДокументОбъект, УзелОбмена) Экспорт
	
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		
		
		ДанныеМоб = МобильныйДокумент.Данные;
		ДанныеМаршрут = "";
		ДанныеКилометраж = 0;
		ДанныеПрицеп = Ложь;
		ДанныеВыданно = 0;
		
		Для каждого СтрокиМоб  Из ДанныеМоб Цикл
			
			Если ДанныеМаршрут = "" Тогда
				
				ДанныеМаршрут = СтрокиМоб.Маршрут;	
			Иначе
				ДанныеМаршрут = ДанныеМаршрут+"-"+СтрокиМоб.Маршрут;
				
			КонецЕсли;
			ДанныеПрицеп = СтрокиМоб.Прицеп;
			ДанныеКилометраж = ДанныеКилометраж + СтрокиМоб.Километраж;
		    ДанныеВыданно = ДанныеВыданно + СтрокиМоб.ВыданоТоплива;
		КонецЦикла; 
		
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Период",НачалоДня(МобильныйДокумент.ДАта));
		//СтруктураПоиска.Вставить("Маршрут",ДанныеМаршрут);
		//СтруктураПоиска.Вставить("Километраж",ДанныеКилометраж);
		//
		
		ДанныеДок = ДокументОбъект.Данные;
		
		НайденныеСтроки = ДанныеДок.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() Тогда
			
			ДАнныеКММаршрут = ПолучитьДанныеКМЗаСегодня(МобильныйДокумент.Ответственный);
			//Километраж = НайденныеСтроки[0].Километраж +ДанныеКилометраж;
			//Маршрут = НайденныеСтроки[0].Маршрут +"-"+ДанныеМаршрут;
			НайденныеСтроки[0].Маршрут =  ДАнныеКММаршрут.Маршрут;
			НайденныеСтроки[0].Километраж = ДАнныеКММаршрут.Километраж;
			НайденныеСтроки[0].ВыданоТоплива = ДАнныеКММаршрут.ВыданоТоплива;
			НайденныеСтроки[0].Прицеп = ДАнныеКММаршрут.Прицеп;
			//Здесь нужно добавить расчет колоннок в тч
			// н ЛИВ

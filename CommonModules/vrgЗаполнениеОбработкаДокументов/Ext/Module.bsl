Процедура РасчитатьРасходАренду(СтрокаТабличнойЧасти, ДокАвтомобиль, ДокПериодРегистрации)

	ДанныеАвтомобиля = РегистрыСведений.СведенияОАвтомобилях.ПолучитьПоследнее(ДокПериодРегистрации, Новый Структура("Автомобиль", ДокАвтомобиль));
	ТарифАрендыАвто = ДанныеАвтомобиля.ТарифАренды;
	Прицеп = СтрокаТабличнойЧасти.Прицеп;
	КилометражУтвержденный = СтрокаТабличнойЧасти.КилометражУтвержденный;
	СезонТеплый = Истина;
	Месяц = Месяц(СтрокаТабличнойЧасти.Период);
	Если Месяц = 1 Или Месяц = 2 Или Месяц = 11 Или Месяц = 12 Тогда
		СезонТеплый = Ложь;
	КонецЕсли;	
	РасходТепло = ДокАвтомобиль.РасходТопливаЛитровНа100Км;
	РасходХолод = ДокАвтомобиль.РасходТопливаЛитровНа100КмЗимой;
	Расход = ?(СезонТеплый, РасходТепло, РасходХолод);	
	СтрокаТабличнойЧасти.РасходТопливаЛитров = ?(Прицеп, КилометражУтвержденный * Расход / 100 * 1.15, КилометражУтвержденный * Расход / 100);
	СтрокаТабличнойЧасти.СтоимостьАренды = ?(Прицеп, КилометражУтвержденный * ТарифАрендыАвто * 1.15, КилометражУтвержденный * ТарифАрендыАвто);
	СтрокаТабличнойЧасти.Удержание = ?(КилометражУтвержденный = 0, 0, ДанныеАвтомобиля.КилометражДляУдержания * ДанныеАвтомобиля.ТарифАренды);
	
КонецПроцедуры 


Функция ПолучитьСоответствиеИменМенеджеровМобильныхДокументов(ИмяКонфигурации) Экспорт
	
	СоответствиеМенеджеровДокументов = Новый Соответствие;
	
	Если ИмяКонфигурации = "УТП" Тогда
		СоответствиеМенеджеровДокументов.Вставить("vrgИнвентаризацияМобильная", "ИнвентаризацияТоваровНаСкладе");
		СоответствиеМенеджеровДокументов.Вставить("vrgПоступлениеМобильное", "ПоступлениеТоваровУслуг");
		СоответствиеМенеджеровДокументов.Вставить("vrgПриходныйОрдерМобильный", "ПриходныйОрдерНаТовары");
		СоответствиеМенеджеровДокументов.Вставить("vrgРасходныйОрдерМобильный", "РасходныйОрдерНаТовары");
		СоответствиеМенеджеровДокументов.Вставить("vrgРеализацияМобильная", "РеализацияТоваровУслуг");
		СоответствиеМенеджеровДокументов.Вставить("vrgВозвратМобильный", "ВозвратТоваровОтПокупателя");
		СоответствиеМенеджеровДокументов.Вставить("vrgВозвратПоставщикуМобильный", "ВозвратТоваровПоставщику");
		СоответствиеМенеджеровДокументов.Вставить("vrgСписаниеМобильное", "СписаниеТоваров");
		СоответствиеМенеджеровДокументов.Вставить("vrgОприходованиеМобильное", "ОприходованиеТоваров");
		СоответствиеМенеджеровДокументов.Вставить("vrgПеремещениеМобильное", "ПеремещениеТоваров");
		СоответствиеМенеджеровДокументов.Вставить("vrgЗаказПоставщикуМобильный", "ЗаказПоставщику");
		СоответствиеМенеджеровДокументов.Вставить("vrgЗаказКлиентаМобильный", "ЗаказПокупателя");
		//+NovashIV_24.01.2023
		СоответствиеМенеджеровДокументов.Вставить("vrgТребованияНакладнаяМобыльный", "ТребованиеНакладная");
		СоответствиеМенеджеровДокументов.Вставить("vrgМаршрутныйЛист", "МаршрутныйЛист");
		//-NovashIV_24.01.2023
	ИначеЕсли ИмяКонфигурации = "BASRetail" Тогда
		СоответствиеМенеджеровДокументов.Вставить("vrgИнвентаризацияМобильная", "ПересчетТоваров");
		СоответствиеМенеджеровДокументов.Вставить("vrgПоступлениеМобильное", "ПоступлениеТоваров");
		СоответствиеМенеджеровДокументов.Вставить("vrgЗаказПоставщикуМобильный", "ЗаказПоставщику");
	ИначеЕсли ИмяКонфигурации = "УТ23" Тогда
		СоответствиеМенеджеровДокументов.Вставить("vrgИнвентаризацияМобильная", "ИнвентаризацияТоваровНаСкладе");
		СоответствиеМенеджеровДокументов.Вставить("vrgПеремещениеМобильное", "ПеремещениеТоваров");
	КонецЕсли;
	
	Возврат СоответствиеМенеджеровДокументов;
	
КонецФункции

#Область УТП


Функция ПолучитьДокументМаршрутныйЛистЗаМесяц(ДокМоб) Экспорт 
	
	
	ДатаПоиска = НачалоМесяца(ТекущаяДата());
	
	Если ДатаПоиска <> НачалоМесяца(ДокМоб.Дата) Тогда
		
		Возврат Неопределено
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МаршрутныйЛист.Ссылка
		|ИЗ
		|	Документ.МаршрутныйЛист КАК МаршрутныйЛист
		|ГДЕ
		|	МаршрутныйЛист.Дата > &Дата
		|	И МаршрутныйЛист.Сотрудник = &Сотрудник";
	
	Запрос.УстановитьПараметр("Дата", ДатаПоиска);
	Запрос.УстановитьПараметр("Сотрудник", ДокМоб.Ответственный);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	//ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Для Каждого  Стр Из  РезультатЗапроса Цикл
		
			
		
		Если ДатаПоиска = НачалоМесяца(Стр.Ссылка.Дата)  Тогда
			
			Возврат Стр.Ссылка.ПолучитьОбъект();
			
		Иначе
			
			Продолжить;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	
	
	
	НовыйДокумент = Документы.МаршрутныйЛист.СоздатьДокумент();
	НовыйДокумент.ПериодРегистрации = НачалоМесяца(ДокМоб.Дата);
	Возврат НовыйДокумент

	
	
КонецФункции

Процедура ЗаполнитьИзменитьДокументИнвентаризацияТоваровНаСкладеУТП(МобильныйДокумент, ДокументОбъект, УзелОбмена) Экспорт
	Если НЕ МобильныйДокумент.СозданНаМобильномУстройстве Тогда
		Возврат;
	КонецЕсли;
		
	ДокументОбъект.Дата = МобильныйДокумент.Дата;
	//ДокументОбъект.Номер = МобильныйДокумент.Номер;
	ДокументОбъект.Склад = МобильныйДокумент.Склад;
	//УзелОбмена = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(МобильныйДокумент.КодУзлаОбмена);
	ДокументОбъект.Организация = МобильныйДокумент.Организация;
	ДокументОбъект.Ответственный = МобильныйДокумент.Ответственный;
	ДокументОбъект.Комментарий = МобильныйДокумент.Комментарий;
	//ДокументОбъект.УчитыватьСерии = Истина;
	
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаТовары Из МобильныйДокумент.Товары Цикл
		СтрокаТабличнойЧасти = ДокументОбъект.Товары.Добавить();
		СтрокаТабличнойЧасти.Номенклатура = СтрокаТовары.Номенклатура;
		ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		СтрокаТабличнойЧасти.СерияНоменклатуры = СтрокаТовары.СерияНоменклатуры;
		СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = СтрокаТовары.ХарактеристикаНоменклатуры;
		СтрокаТабличнойЧасти.Количество = СтрокаТовары.Количество;
		СтрокаТабличнойЧасти.КоличествоУчет = СтрокаТовары.КоличествоУчет;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтрокаТовары.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.Коэффициент      = СтрокаТовары.Коэффициент;
		СтрокаТабличнойЧасти.Примечание      = СтрокаТовары.Примечание;
		СтрокаТабличнойЧасти.Этикетка      = СтрокаТовары.Этикетка;
		СтрокаТабличнойЧасти.Цена             = 0;
		ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, Ложь);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		СтрокаТабличнойЧасти.Качество = Справочники.Качество.Новый;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИзменитьДокументПоступлениеТоваровУслугУТП(МобильныйДокумент, ДокументОбъект, УзелОбмена) Экспорт
	
	ДокументОбъект.Дата = МобильныйДокумент.Дата;
	ДокументОбъект.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
	ДокументОбъект.СкладОрдер = МобильныйДокумент.Склад;
	//УзелОбмена = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(МобильныйДокумент.КодУзлаОбмена);
	ДокументОбъект.Организация = МобильныйДокумент.Организация;
	Если ЗначениеЗаполнено(МобильныйДокумент.ЗаказПоставщику) Тогда
		ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ДокументОбъект, МобильныйДокумент.ЗаказПоставщику);
	Иначе
		ДокументОбъект.Контрагент = МобильныйДокумент.Контрагент;
		ЗаполнениеДокументов.ПриИзмененииЗначенияКонтрагента(ДокументОбъект, ДокументОбъект.мСтруктураПараметровДляПолученияДоговора);
		ДокументОбъект.ДоговорКонтрагента = МобильныйДокумент.ДоговорКонтрагента;
		СтруктураРеквизитовДокумента = Ценообразование.ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(ДокументОбъект);
		СпособЗаполненияЦен = Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатурыКонтрагентов;
		ЗаполнениеДокументов.ПриИзмененииЗначенияДоговора(ДокументОбъект, Неопределено, ДокументОбъект.мВалютаРегламентированногоУчета,
		СпособЗаполненияЦен, СтруктураРеквизитовДокумента, "Покупка", "Товары");
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
			ДокументОбъект.ВалютаДокумента = ДокументОбъект.ДоговорКонтрагента.ВалютаВзаиморасчетов;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
			ДокументОбъект.ВалютаДокумента = ДокументОбъект.мВалютаРегламентированногоУчета;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.ОтражатьВУправленческомУчете = Истина;
	ДокументОбъект.ОтражатьВБухгалтерскомУчете = Ложь;
	ДокументОбъект.Ответственный = МобильныйДокумент.Ответственный;
	ДокументОбъект.Комментарий = МобильныйДокумент.Комментарий;
	ДокументОбъект.Сделка = МобильныйДокумент.ЗаказПоставщику;
	
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаТовары Из МобильныйДокумент.Товары Цикл
		СтрокаТабличнойЧасти = ДокументОбъект.Товары.Добавить();
		СтрокаТабличнойЧасти.ЗаказПоставщику = МобильныйДокумент.ЗаказПоставщику;
		СтрокаТабличнойЧасти.Номенклатура = СтрокаТовары.Номенклатура;
		ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, "Приобретение");
		СтрокаТабличнойЧасти.СерияНоменклатуры = СтрокаТовары.СерияНоменклатуры;
		СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = СтрокаТовары.ХарактеристикаНоменклатуры;
		//МассивСтрок = МобильныйДокумент.ЗаказПоставщику.Товары.НайтиСтроки(Новый Структура("Номенклатура", НоваяСтрокаТовары.Номенклатура));
		//Если МассивСтрок.Количество() > 0 Тогда
		//	НоваяСтрокаТовары.Цена = МассивСтрок[0].Цена;
		//КонецЕсли;
		СтрокаТабличнойЧасти.Цена = СтрокаТовары.Цена;
		СтрокаТабличнойЧасти.Количество = СтрокаТовары.Количество;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтрокаТовары.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.Коэффициент      = СтрокаТовары.Коэффициент;
		ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, Ложь);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		ДокументОбъект.ЗаполнитьСчетаУчетаВСтрокеТабЧасти(СтрокаТабличнойЧасти, "Товары", ДокументОбъект.ОтражатьВБухгалтерскомУчете, ДокументОбъект.ОтражатьВБухгалтерскомУчете);
	КонецЦикла;
	
	//+NovashIV_21.04.2023
	ДокументОбъект.ОтражатьВБухгалтерскомУчете           = Ложь;
	//-NovashIV_21.04.2023
	
КонецПроцедуры

Процедура ЗаполнитьИзменитьДокументПриходныйОрдерНаТоварыУТП(МобильныйДокумент, ДокументОбъект, УзелОбмена) Экспорт
	
	ДокументОбъект.Дата = МобильныйДокумент.Дата;
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПриходныйОрдер.Перемещение;
	ДокументОбъект.Склад = МобильныйДокумент.Склад;
	//УзелОбмена = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(МобильныйДокумент.КодУзлаОбмена);
	ДокументОбъект.Организация = МобильныйДокумент.Организация;
	Если ЗначениеЗаполнено(МобильныйДокумент.ПеремещениеТоваров) Тогда
		ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ДокументОбъект, МобильныйДокумент.ПеремещениеТоваров);
	КонецЕсли;
	
	ДокументОбъект.Ответственный = МобильныйДокумент.Ответственный;
	ДокументОбъект.Комментарий = МобильныйДокумент.Комментарий;
	ДокументОбъект.ДокументПеремещения = МобильныйДокумент.ПеремещениеТоваров;
	
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаТовары Из МобильныйДокумент.Товары Цикл
		СтрокаТабличнойЧасти = ДокументОбъект.Товары.Добавить();
		СтрокаТабличнойЧасти.Номенклатура = СтрокаТовары.Номенклатура;
		ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		СтрокаТабличнойЧасти.СерияНоменклатуры = СтрокаТовары.СерияНоменклатуры;
		СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = СтрокаТовары.ХарактеристикаНоменклатуры;
		СтрокаТабличнойЧасти.Количество = СтрокаТовары.Количество;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
		СтрокаТабличнойЧасти.Коэффициент      = СтрокаТабличнойЧасти.ЕдиницаИзмерения.Коэффициент;
		ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, Ложь);
		СтрокаТабличнойЧасти.Качество = Справочники.Качество.Новый;
	КонецЦикла;
	
	//+NovashIV_21.04.2023
	ДокументОбъект.ОтражатьВБухгалтерскомУчете           = Ложь;
	//-NovashIV_21.04.2023
	
КонецПроцедуры


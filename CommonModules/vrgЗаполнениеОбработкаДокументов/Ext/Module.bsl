Процедура ЗаполнитьИзменитьДокументВозвратТоваровПоставщикуУТП(МобильныйДокумент, ДокументОбъект, УзелОбмена) Экспорт
	
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"), ДокументОбъект.мВалютаРегламентированногоУчета, "Покупка");
	ОбщегоНазначения.ЗаполнитьОбязательныеРеквизитыШапкиНовогоДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
	СчетаУчета = УправлениеВзаиморасчетами.ПолучитьСчетаРасчетовСКонтрагентом(ДокументОбъект.Организация, ДокументОбъект.Контрагент, ДокументОбъект.ДоговорКонтрагента);
	
	ДокументОбъект.СчетУчетаРасчетовСКонтрагентом 	= СчетаУчета.СчетРасчетов;
	Если ДокументОбъект.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Бартерный Тогда
		ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПриБартере;
	КонецЕсли;
	ДокументОбъект.СчетУчетаРасчетовПоАвансам		= ДокументОбъект.СчетУчетаРасчетовСКонтрагентом;
	ДокументОбъект.СчетУчетаРасчетовПоТаре        	= СчетаУчета.СчетУчетаТары;
	ДокументОбъект.СчетУчетаРасчетовПоТареПоАвансам = ДокументОбъект.СчетУчетаРасчетовПоТаре;
	
	ДокументОбъект.СчетУчетаНДС 				= СчетаУчета.СчетУчетаНДСПриобретений;
	ДокументОбъект.СчетУчетаНДСПодтвержденный  = СчетаУчета.СчетУчетаНДСПриобретенийПодтвержденный;
	
	СчетУчета = БухгалтерскийУчет.ПолучитьСчетУчетаПрочий(ДокументОбъект.Организация, Перечисления.ВидыПрочихСчетовУчета.СчетДоходовВозвратПоставщику);
	ДокументОбъект.СчетУчетаДоходовБУ 	= СчетУчета.СчетУчетаБУ;
	ДокументОбъект.СубконтоДоходов1 	= СчетУчета.Субконто1;
	ДокументОбъект.СубконтоДоходов2 	= СчетУчета.Субконто2;
	ДокументОбъект.СубконтоДоходов3 	= СчетУчета.Субконто3;
	
	СчетУчета = БухгалтерскийУчет.ПолучитьСчетУчетаПрочий(ДокументОбъект.Организация, Перечисления.ВидыПрочихСчетовУчета.СчетЗатратВозвратПоставщику);
	ДокументОбъект.СчетУчетаРасходовБУ 	= СчетУчета.СчетУчетаБУ;
	ДокументОбъект.СубконтоРасходов1 	= СчетУчета.Субконто1;
	ДокументОбъект.СубконтоРасходов2 	= СчетУчета.Субконто2;
	ДокументОбъект.СубконтоРасходов3 	= СчетУчета.Субконто3;
	
	ДокументОбъект.Дата = МобильныйДокумент.Дата;
	ДокументОбъект.Организация = МобильныйДокумент.Организация;
	ДокументОбъект.ОтражатьВУправленческомУчете = Истина;
	ДокументОбъект.Контрагент = МобильныйДокумент.Контрагент;
	ДокументОбъект.ДоговорКонтрагента = МобильныйДокумент.ДоговорКонтрагента;
	ДокументОбъект.Комментарий = МобильныйДокумент.Комментарий;
	ДокументОбъект.Склад = МобильныйДокумент.Склад;
	ДокументОбъект.Ответственный = МобильныйДокумент.Ответственный;
	//ДокументОбъект.ТипЦен = МобильныйДокумент.ТипЦен;
	
	СтруктураШапкиДокумента = Новый Структура("Контрагент, ТипЦен, ДоговорКонтрагента, ДатаДокумента, ВалютаДокумента, УчитыватьНДС, СуммаВключаетНДС",
	ДокументОбъект.Контрагент, ДокументОбъект.ТипЦен, ДокументОбъект.ДоговорКонтрагента, ДокументОбъект.Дата,
	ДокументОбъект.ВалютаДокумента, ДокументОбъект.УчитыватьНДС, ДокументОбъект.СуммаВключаетНДС);
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаИсходногоДокумента Из МобильныйДокумент.Товары Цикл
		
		СтрокаТабличнойЧасти = ДокументОбъект.Товары.Добавить();
		СтрокаТабличнойЧасти.Номенклатура = СтрокаИсходногоДокумента.Номенклатура;
		
		// Выполнить общие действия для всех документов при изменении номенклатуры.
		ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		
		// Заполняем реквизиты табличной части.
		ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, "Реализация");
		
		//ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПокупкиТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, СтруктураШапкиДокумента, ДокументОбъект.мВалютаРегламентированногоУчета);
		
		СтрокаТабличнойЧасти.Количество = СтрокаИсходногоДокумента.Количество;
		СтрокаТабличнойЧасти.Цена = СтрокаИсходногоДокумента.Цена;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтрокаИсходногоДокумента.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.Коэффициент      = СтрокаИсходногоДокумента.Коэффициент;
		//СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = СтрокаИсходногоДокумента.Скидка;
		
		// Рассчитать реквизиты табличной части.
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		
		// Рассчитать реквизиты табличной части.
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
		ДокументОбъект.ЗаполнитьСчетаУчетаВСтрокеТабЧасти(СтрокаТабличнойЧасти, "Оборудование", ДокументОбъект.ОтражатьВБухгалтерскомУчете, ДокументОбъект.ОтражатьВБухгалтерскомУчете);
		
	КонецЦикла;
	
	//+NovashIV_21.04.2023
	ДокументОбъект.ОтражатьВБухгалтерскомУчете           = Ложь;
	//-NovashIV_21.04.2023
	
КонецПроцедуры

Процедура ЗаполнитьИзменитьДокументСписаниеТоваровУТП(МобильныйДокумент, ДокументОбъект, УзелОбмена) Экспорт
	
	ДокументОбъект.Дата = МобильныйДокумент.Дата;
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийСписаниеТоваров.ТоварыПродукция;
	ДокументОбъект.Склад = МобильныйДокумент.Склад;
	УзелОбмена = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(МобильныйДокумент.КодУзлаОбмена);
	ДокументОбъект.СчетДт = УзелОбмена.СчетСписания;
	ДокументОбъект.Организация = МобильныйДокумент.Организация;
	ДокументОбъект.Ответственный = МобильныйДокумент.Ответственный;
	ДокументОбъект.Комментарий = МобильныйДокумент.Комментарий;
	
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаТовары Из МобильныйДокумент.Товары Цикл
		Если СтрокаТовары.Количество <= 0 Тогда 
			Продолжить;
		Иначе 
			
			СтрокаТабличнойЧасти = ДокументОбъект.Товары.Добавить();
			СтрокаТабличнойЧасти.Номенклатура = СтрокаТовары.Номенклатура;
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект);
			СтрокаТабличнойЧасти.СерияНоменклатуры = СтрокаТовары.СерияНоменклатуры;
			СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = СтрокаТовары.ХарактеристикаНоменклатуры;
			СтрокаТабличнойЧасти.Количество = СтрокаТовары.Количество;
			СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтрокаТовары.ЕдиницаИзмерения;
			СтрокаТабличнойЧасти.Коэффициент      = СтрокаТовары.Коэффициент;
			ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТабличнойЧасти, ДокументОбъект, Ложь);
			СтрокаТабличнойЧасти.Качество = Справочники.Качество.Новый;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//+NovashIV_21.04.2023
	ДокументОбъект.ОтражатьВБухгалтерскомУчете           = Ложь;
	//-NovashIV_21.04.2023
	
КонецПроцедуры


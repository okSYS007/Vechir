				ЧекККМ 					 = Документы.ЧекККМ.СоздатьДокумент();
				ЧекККМ.Дата 			 = ТекущаяДата();
				ЧекККМ.ВидОперации 		 = Перечисления.ВидыОперацийЧекККМ.Продажа;
				ЧекККМ.ДокументОснование = ЗаказПокупателя.Ссылка;
				ЧекККМ.ЗаказПокупателя = ЗаказПокупателя.Ссылка;
				ЧекККМ.КассаККМ = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(МобильныйДокумент.ОтветственныйЗаОплату,"ОсновнаяКассаККМ");
				ЧекККМ.Комментарий = "#Создан автоматически при загрузке из ТСД";
				ЧекККМ.Организация = ЧекККМ.КассаККМ.Владелец;
				ЧекККМ.Ответственный = МобильныйДокумент.ОтветственныйЗаОплату;
				ЧекККМ.Склад = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(МобильныйДокумент.ОтветственныйЗаОплату,"ОсновнойСклад");
				ЧекККМ.СуммаДокумента = ЗаказПокупателя.СуммаДокумента;
				
				оплаты = ЧекККМ.Оплата.Добавить();
				оплаты.ВидОплаты = Справочники.ВидыОплатЧекаККМ.Наличные;
				оплаты.Сумма = ЗаказПокупателя.СуммаДокумента;
				
				Для Каждого Строка из ЗаказПокупателя.товары цикл
					СтрокаЧека = ЧекККМ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЧека,Строка);
				КонецЦикла;
				
				
				Для Каждого Строка из ЗаказПокупателя.Услуги цикл
					СтрокаЧека = ЧекККМ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЧека,Строка);
				КонецЦикла;

				
				ЧекККМ.Записать();
				Попытка

				ЧекККМ.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
				КонецПопытки;
			Иначе
				ЧекККМ 					 = Документы.ЧекККМ.СоздатьДокумент();
				ЧекККМ.Дата 			 = ТекущаяДата();
				ЧекККМ.ВидОперации 		 = Перечисления.ВидыОперацийЧекККМ.Продажа;
				ЧекККМ.ДокументОснование = ЗаказПокупателя.Ссылка;
				ЧекККМ.ЗаказПокупателя 	 = ЗаказПокупателя.Ссылка;
				ЧекККМ.КассаККМ 		 = Справочники.КассыККМ.НайтиПоКоду("000000001",Истина,,);
				ЧекККМ.Комментарий 		 = "#Создан автоматически при загрузке из ТСД";
				ЧекККМ.Организация 		 = Справочники.Организации.НайтиПоНаименованию("ВЕЧІР ТЕЛЕКОМ ТОВ");
				ЧекККМ.Ответственный 	 = МобильныйДокумент.ОтветственныйЗаОплату;
				ЧекККМ.Склад 		     = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(МобильныйДокумент.ОтветственныйЗаОплату,"ОсновнойСклад");
				ЧекККМ.СуммаДокумента    = ЗаказПокупателя.СуммаДокумента;
				
				оплаты 				= ЧекККМ.Оплата.Добавить();
				оплаты.ВидОплаты 	= Справочники.ВидыОплатЧекаККМ.НайтиПоКоду("00002");
				оплаты.Сумма 		= ЗаказПокупателя.СуммаДокумента;
				
				Для Каждого Строка из ЗаказПокупателя.товары цикл
					СтрокаЧека = ЧекККМ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЧека,Строка);
				КонецЦикла;
				
				
				Для Каждого Строка из ЗаказПокупателя.Услуги цикл
					СтрокаЧека = ЧекККМ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЧека,Строка);
				КонецЦикла;
				
				ЧекККМ.Записать();
				
				Попытка
					ЧекККМ.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
				КонецПопытки;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

Функция	ПолучитьДоговорКонтрагента(Контрагент,Организация,ВидДоговора) Экспорт 
	
	ВозвращаемоеЗначение = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Владелец = &Контрагент
	               |	И ДоговорыКонтрагентов.Организация = &Организация
	               |	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора";
	Запрос.УстановитьПараметр("ВидДоговора",ВидДоговора);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		ВозвращаемоеЗначение = РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции

Функция УжеЕстьНалоговая(ДокОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	"""" КАК Поле1
		|ИЗ
		|	Документ.НалоговаяНакладная КАК НалоговаяНакладная
		|ГДЕ
		|	НЕ НалоговаяНакладная.ПометкаУдаления
		|	И НалоговаяНакладная.Проведен
		|	И НалоговаяНакладная.ДокументОснование = &Платежка";
	
	Запрос.УстановитьПараметр("Платежка", ДокОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции


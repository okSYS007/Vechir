
Процедура ПриЗаписиМобильногоДокументаПриЗаписи(Источник, Отказ) Экспорт
	
	//Если Источник.Номер = "00000000184" ИЛИ Источник.Номер = "КД000002012"  Тогда
	//	Возврат;
	//КонецЕсли;
	
	УзелОбмена = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(Источник.КодУзлаОбмена);
	Если УзелОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ИзменениеОрганизации") ИЛИ Источник.ДополнительныеСвойства.Свойство("СозданиеНового") ИЛИ Источник.ДополнительныеСвойства.Свойство("ИзменениеТоваров") Тогда 
		Возврат;
		
	КонецЕсли;
	ИмяКонфигурации = УзелОбмена.Конфигурация;
	Если ИмяКонфигурации="" Тогда 
		ИмяКонфигурации = "УТП";
	КонецЕсли;
	СоответствиеМенеджеровДокументов = ПолучитьСоответствиеИменМенеджеровМобильныхДокументов(ИмяКонфигурации);
	ИмяМенеджераДокумента = СоответствиеМенеджеровДокументов.Получить(Источник.Метаданные().Имя);
	Если НЕ ЗначениеЗаполнено(ИмяМенеджераДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	НеобходимоСделатьЗаписьСоответствия = Ложь;
	МенеджерЗаписиСоответствия = РегистрыСведений.vrgСоответствияМобильныхДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписиСоответствия.МобильныйДокумент = Источник.Ссылка;
	МенеджерЗаписиСоответствия.Прочитать();
	Если МенеджерЗаписиСоответствия.Выбран() Тогда
		ДокументОбъект = МенеджерЗаписиСоответствия.ОсновнойДокумент.ПолучитьОбъект();
		Если ДокументОбъект.Проведен Тогда
			Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.ЗаказПокупателя") Тогда 
			Если Источник.ПометкаУдаления <> ДокументОбъект.ПометкаУдаления Тогда
				ДокументОбъект.УстановитьПометкуУдаления(Источник.ПометкаУдаления);
			КонецЕсли;
		КонецЕсли;
	Иначе
		НеобходимоСделатьЗаписьСоответствия = Истина;
	КонецЕсли;
	
	 
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.vrgМаршрутныйЛист") Тогда
		
		ДокументОбъект = ПолучитьДокументМаршрутныйЛистЗаМесяц(Источник.Ссылка);
		Если ДокументОбъект = Неопределено Тогда
			
			Возврат
			
		КонецЕсли;
		
	Иначе
		
		Если ДокументОбъект = Неопределено Тогда
			ДокументОбъект = Документы[ИмяМенеджераДокумента].СоздатьДокумент();
			
			
		
		КонецЕсли;
		
	КонецЕсли;
	Если не ДокументОбъект.ПометкаУдаления Тогда	
		Выполнить("ЗаполнитьИзменитьДокумент" + ИмяМенеджераДокумента + ИмяКонфигурации + "(Источник, ДокументОбъект, УзелОбмена)");
		
		ЗаполнитьРеквизитыДокумента(ДокументОбъект);
		ВыполнитьЗаписьДокумента(ДокументОбъект, УзелОбмена,Источник);
		
		Если НеобходимоСделатьЗаписьСоответствия Тогда
			МенеджерЗаписиСоответствия.МобильныйДокумент = Источник.Ссылка;
			МенеджерЗаписиСоответствия.ОсновнойДокумент = ДокументОбъект.Ссылка;
			МенеджерЗаписиСоответствия.Записать(Истина);
		КонецЕсли;
		
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда 
			
			СформироватьДополнительныеДокументыПоЗаказуПокупателя(Источник,ДокументОбъект)
			
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВыполнитьЗаписьДокумента(ДокументОбъект, УзелОбмена,Источник)
	Если не ДокументОбъект.ПометкаУдаления тогда 
		
		Попытка			
			Если ТипЗнч(ДокументОбъект) = тип("ДокументОбъект.ЗаказПокупателя") и (ДокументОбъект.Проект = Справочники.Проекты.НайтиПоКоду("S00000085") или ДокументОбъект.Проект = Справочники.Проекты.НайтиПоКоду("S00000174"))   Тогда 				
				Если Источник.Оплачен Тогда 
					//ЗаписьЖурналаРегистрации("ДокументОбъект"+ДокументОбъект,УровеньЖурналаРегистрации.Ошибка,,,"");
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);					
				Иначе
					Если ДокументОбъект.Проведен Тогда
						// если документ проведен, записываем с отменой проведения
						ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					Иначе
						ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
					КонецЕсли;
				КонецЕсли;				
			Иначе				
				Если ДокументОбъект.Проведен Тогда
					// если документ проведен, записываем с отменой проведения
					ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Иначе
					ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			Сообщить(ОписаниеОшибки());
			ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки());
		КонецПопытки;
		
		
		
		Если ТипЗнч(ДокументОбъект) = тип("ДокументОбъект.ЗаказПокупателя")  Тогда 			
			Если Источник.Оплачен и (ДокументОбъект.Проект = Справочники.Проекты.НайтиПоКоду("S00000085") или  ДокументОбъект.Проект = Справочники.Проекты.НайтиПоКоду("S00000174"))  Тогда 
				//ЗаписьЖурналаРегистрации("ДокументОбъект"+ДокументОбъект,УровеньЖурналаРегистрации.Ошибка,,,"");
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);				
			КонецЕсли;			
		КонецЕсли;
		
		//Если ТипЗнч(ДокументОбъект) = тип("ДокументОбъект.ПеремещениеТоваров") Тогда
		//	Попытка
		//	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Исключение
		//	ЗаписьЖурналаРегистрации("ДокументОбъект"+ДокументОбъект,УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки(),"");
		//	КонецПопытки;
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры


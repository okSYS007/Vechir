Процедура ПанельСтраницПриСменеСтраницы(Элемент, ТекущаяСтраница, ЭлементыФормы, ДокументСписок, ПоВидДоговора = Ложь) экспорт
	
	//Если ПоПодразделениям Тогда
	Если ПоВидДоговора Тогда
		//по виду договора
		ДокументСписок.Отбор.Сбросить();
		Если не ЭлементыФормы.ПанельСтраниц.ТекущаяСтраница.имя = "КВсі" Тогда
			
			ТекСсылка = Перечисления.ВидыДоговоровКонтрагентов[Сред(ЭлементыФормы.ПанельСтраниц.ТекущаяСтраница.имя,2)];
			
			ДокументСписок.Отбор.ВидДоговора.ВидСравнения  = ВидСравнения.Равно;
			ДокументСписок.Отбор.ВидДоговора.Значение 	 = ТекСсылка;
			ДокументСписок.Отбор.ВидДоговора.Использование = Истина;
		КонецЕсли;
	Иначе 
		ТекСсылка = Справочники.НаправленияЗатрат.НайтиПоНаименованию(Сред(ЭлементыФормы.ПанельСтраниц.ТекущаяСтраница.имя,2));
		Если не ТекСсылка.Пустая() Тогда 
			ДокументСписок.Отбор.Сбросить();
			//
			//Запрос = Новый Запрос;
			//Запрос.Текст = 
			//	"ВЫБРАТЬ
			//	|	НаправленияЗатрат.Ссылка
			//	|ИЗ
			//	|	Справочник.НаправленияЗатрат КАК НаправленияЗатрат
			//	|ГДЕ
			//	|	НаправленияЗатрат.Ссылка = &Ссылка";
			//
			//Запрос.УстановитьПараметр("Ссылка", ТекСсылка);
			//РезультатЗапроса = Запрос.Выполнить();
			//спНаправленияЗатрат = Новый СписокЗначений;
			//спНаправленияЗатрат.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
			ДокументСписок.Отбор.НаправлениеЗатрат.ВидСравнения  = ВидСравнения.Равно;
			ДокументСписок.Отбор.НаправлениеЗатрат.Значение 	 = ТекСсылка;
			ДокументСписок.Отбор.НаправлениеЗатрат.Использование = Истина;
		Иначе
			ДокументСписок.Отбор.Сбросить();
		КонецЕсли;
	КонецЕсли;
	//иначе
	//	//по орг
	//	ТекСсылка = Справочники.Организации.НайтиПоКоду(Сред(ЭлементыФормы.ПанельСтраниц.ТекущаяСтраница.имя,2));
	//	Если не ТекСсылка.Пустая() Тогда 
	//		ДокументСписок.Отбор.Сбросить();
	//		ДокументСписок.Отбор.Найти("Организация").Установить(ТекСсылка);

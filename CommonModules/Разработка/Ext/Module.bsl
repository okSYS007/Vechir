						//СтрокаТЧ.СебестоимостьМаржа
						СтрокаТЧ.СебестоимостьМаржа =  СтрокаТЧ.СебестоимостьМаржа  + ТекМаржа;
					Иначе 
						СтрокаТЧ.СебестоимостьМаржа =  0;						
					КонецЕсли;
					
				КонецЦикла;
				
				Источник.ДополнительныеСвойства.Вставить("ЭтоПереЗапись", Истина);
				Источник.Записать(РежимЗаписиДокумента.Проведение,РежимПроведения);
				Источник.ДополнительныеСвойства.Вставить("ЭтоПереЗапись", Ложь);
			
			КонецЕсли;
			
		//КонецЕсли;

		//Проверим есть ли наименование если есть поступления от внутригруппы
		ЭтоВнутригруппа = РазработкаСервер.ЭтоВнутригруппа(Источник.Организация, Источник.Контрагент);
		Если НЕ (ЭтоВнутригруппа = Истина) Тогда 
			
			//тут наимнования по ПТИУ и По РТИУ
			
			для Каждого СтркоаНоменуклатурыПартии из ТаблицаПартийИНоменклатуры Цикл 
				
				ТекПартияСписания 	=  СтркоаНоменуклатурыПартии.Партия;

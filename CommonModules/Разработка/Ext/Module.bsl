КонецПроцедуры


Процедура vrВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	//Если есть Взаиморасчеты по 361, то наш клиент
	МетаданныеДокумента = Источник.Метаданные();
		
	МожетДелатьДвиженияПоВзаиморасчетам		= МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов);
	МожетДелатьДвиженияПоВзаиморасчетамVR	= МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.vrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов);
	
	Если не МожетДелатьДвиженияПоВзаиморасчетамVR 
		Или НЕ МожетДелатьДвиженияПоВзаиморасчетам Тогда 
		Возврат;
	КонецЕсли;
	
	
	СсылкаНАДокумент 	= Источник.Ссылка;
	ДатаРегистратора 	= СсылкаНАДокумент.Дата;
	
	ДатаНачалаЗаписиРегистраВзаиморасчетыVR  = Константы.ДатаНачалаЗаписиРегистраВзаиморасчетыVR.Получить();
	
	Если НЕ ЗначениеЗаполнено(ДатаНачалаЗаписиРегистраВзаиморасчетыVR) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ДатаРегистратора < ДатаНачалаЗаписиРегистраВзаиморасчетыVR Тогда 
		Возврат;
	КонецЕсли;
	
	
	ТаблицаПроводок = Источник.движения.Хозрасчетный;
	
	МассивСчетовВзаиморасчетов = Новый Массив;
	МассивСчетовВзаиморасчетов .Добавить(ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПокупателями);
	
	
	Организация = Неопределено;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Организация",МетаданныеДокумента) Тогда 
		Организация =  Источник.Организация;
	КонецЕсли;
	
	наборvrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов = РегистрыНакопления.vrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.СоздатьНаборЗаписей();	
	наборvrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Отбор.Регистратор.Установить(СсылкаНАДокумент);
	наборvrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Прочитать();
	наборvrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Очистить();
	
	ТаблицаvrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов = наборvrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.ВыгрузитьКолонки();
	
	//Если движение в ДТ 361, то нужно выбирать остатки если они отрицательные(оплаты)
	//Если движение в КТ 361, то нужно выбирать остатки если они положительные(отгрузки)
	
	//Цель Считать просрочку от Реализации,
	
	ТаблицаВзаиморасчетовСлужебная = ТаблицаvrВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.СкопироватьКолонки(); 
	
	Для Каждого СтрокаТЧ из ТаблицаПроводок Цикл 
		
		//Если в ДТ то+
		Если МассивСчетовВзаиморасчетов.Найти(СтрокаТЧ.СчетДт) <> Неопределено Тогда 
			
			Контрагент 										= СтрокаТЧ.СубконтоДт.Контрагенты;
			ДоговорКонтрагента 						= СтрокаТЧ.СубконтоДт.Договоры;
			ДокументРасчетовСКонтрагентом  	= СтрокаТЧ.СубконтоДт.ДокументыРасчетовСКонтрагентами;
			
			//Значит документ расчетов сам документ			
			
			НоваяСтрока = ТаблицаВзаиморасчетовСлужебная.Добавить();
			НоваяСтрока.Активность					= Истина;
			НоваяСтрока.Период						=  ДатаРегистратора;
			НоваяСтрока.Регистратор 				= СсылкаНАДокумент;
			
			НоваяСтрока.ВидДвижения 				= ВидДвиженияНакопления.Приход;
			
			НоваяСтрока.Организация				= Организация;
			НоваяСтрока.ДоговорКонтрагента	= ДоговорКонтрагента;
			
			НоваяСтрока.Сделка									  		= ДокументРасчетовСКонтрагентом;
			НоваяСтрока.ДокументРасчетовСКонтрагентом	= ДокументРасчетовСКонтрагентом;
			
			
			НоваяСтрока.ВидРасчетовСКонтрагентом			= Перечисления.ВидыРасчетовСКонтрагентами.ПоРеализации;
			НоваяСтрока.Контрагент                  					= Контрагент;
			
			НоваяСтрока.СуммаВзаиморасчетов					=СтрокаТЧ.Сумма;			
			
			// + IvanSidoruk 12.10.2020
			Если НоваяСтрока.СуммаВзаиморасчетов < 0 Тогда 
				НоваяСтрока.ВидДвижения = ВидДвиженияНакопления.Расход;

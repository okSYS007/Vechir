	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДАнные.Путь КАК Путь,
		|	ДАнные.Порядок КАК Порядок
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПутиСохраненияДокументов.Путь КАК Путь,
		|		1 КАК Порядок
		|	ИЗ
		|		РегистрСведений.ПутиСохраненияДокументов КАК ПутиСохраненияДокументов
		|	ГДЕ
		|		ПутиСохраненияДокументов.Пользователь = &Пользователь
		|		И ПутиСохраненияДокументов.ИмяМашины = &ИмяМашины
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Константы.ПапкаГдеСохранятьДоговора,
		|		2
		|	ИЗ
		|		Константы КАК Константы) КАК Данные
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекПуть = "";
	Если Выборка.Следующий() Тогда 
		ТекПуть = СокрЛП(Выборка.Путь);
	КонецЕсли;
	
	Возврат ТекПуть;
	

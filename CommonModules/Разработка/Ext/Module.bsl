					СтрокаТЧ.СебестоимостьХранение		= ТекСебестоимостьХранение;		
					СтрокаТЧ.СебестоимостьМаржа 			= ТекСебестоимостьМаржа;		
					// - IvanSidoruk 10.11.2020
					
					// + IvanSidoruk 14.12.2021					
					//ТекМаржа = СтрокаТЧ.Сумма-?(СуммаВключаетНДС,СтрокаТЧ.СуммаНДС,0) - СтрокаТЧ.Себестоимость;
					
					Если ЭтоВалютныйДокумент и ЗначениеЗаполнено(ВалютнаяСуммаПропорционирования)
						 Тогда 
						//Сумма Дохода будем размазывать по валютной сумме
						ТекСуммаДохода =СуммаДоходаВГРНВсегоДокумента *(СтрокаТЧ.Сумма/ВалютнаяСуммаПропорционирования);
						ТекСуммаДоходаГрн 	= ОбщегоНазначения.ОкруглитьСУчетомПогрешности(ТекСуммаДохода,2,ТкПогрешностьСуммыВалюты);
						ТекСуммаНДСГрн		= 0;
						
					Иначе 
						ТекСуммаДоходаГрн	= СтрокаТЧ.Сумма;
						ТекСуммаНДСГрн 	= ?(СуммаВключаетНДС,СтрокаТЧ.СуммаНДС,0) ;
						
						//ТекСуммаДоходаГрн	= МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ТекСуммаДоходаВВалютеДокумента,Источник.ВалютаДокумента,ВалютаРегл,Источник.КурсВзаиморасчетов,Источник.КратностьВзаиморасчетов,1,1);
						//ТекСуммаНДСГрн 		= МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ТекСуммаНДСВВалютеДокумента,Источник.ВалютаДокумента,ВалютаРегл,Источник.КурсВзаиморасчетов,Источник.КратностьВзаиморасчетов,1,1);
					КонецЕсли;
		
					ТекМаржа = ТекСуммаДоходаГрн-ТекСуммаНДСГрн- СтрокаТЧ.Себестоимость;
					// - IvanSidoruk 14.12.2021
					
					СтрокаТЧ.Доход  = ТекМаржа;
					

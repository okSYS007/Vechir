	Для Каждого СтрокаТаблицы из РезультатЗапроса Цикл
		Если СтрокаТаблицы.Паспорт <> Документы.АнализыЛаборатории.ПустаяСсылка()  Тогда
		СтрокаВозврата = СтрокаВозврата + "№ "+ОбщегоНазначения.ПолучитьНомерНаПечать(СтрокаТаблицы.Паспорт)+" від "+ФОрмат(СтрокаТаблицы.Паспорт.Дата,"ДФ=dd.MM.yyyy")+",";	
		КонецЕсли;
	КонецЦикла;
	
	Если Прав(СтрокаВозврата,1) = "," Тогда
		ДлинаСтроки = СтрДлина(СтрокаВозврата);
		СтрокаВозврата = Лев(СтрокаВозврата,ДлинаСтроки-1);
	КонецЕсли;
	
	
	Возврат СтрокаВозврата;

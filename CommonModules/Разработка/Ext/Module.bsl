функция НайтиНоменклатуруПоГруппеИТМ(Текст, ТекГруппаПродукции , ТекТорговаяМарка)
	  СписокНайденных = Новый СписокЗначений;
	ТекстУсловия = "";	
	Запрос = Новый Запрос;
	
	
	
	Запрос.Текст = "ВЫБРАТЬ Первые 50
	               |	Номенклатура.Ссылка КАК Ссылка,
	               |	Номенклатура.Представление КАК Представление
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ Истина
	               |";
	
	
	Если  ЗначениеЗаполнено(ТекГруппаПродукции) Тогда
		ТекстУсловия = " Номенклатура.ГруппаПродукцииЗаПредназначением = &ГруппаПродукцииЗаПредназначением "+?(ЗначениеЗаполнено(ТекТорговаяМарка)," И ","");
		Запрос.УстановитьПараметр("ГруппаПродукцииЗаПредназначением", ТекГруппаПродукции);
	КонецЕсли;
	Если  ЗначениеЗаполнено(ТекТорговаяМарка) Тогда 
		ТекстУсловия = ТекстУсловия +" Номенклатура.ТорговаяМаркиНоменклатуры = &ТорговаяМаркиНоменклатуры ";
		Запрос.УстановитьПараметр("ТорговаяМаркиНоменклатуры", ТекТорговаяМарка);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстУсловия) Тогда
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"Истина",ТекстУсловия);
	КонецЕсли;
	Результат = Запрос.Выполнить().Выбрать();
	
	ДлинаТекста = СтрДлина(СокрЛП(Текст));
	
	Пока Результат.Следующий() Цикл
		Если ВРег(Сред(Результат.Представление,1,ДлинаТекста)) = ВРег(СокрЛП(Текст)) Тогда
			СписокНайденных.Добавить(Результат.Ссылка,Результат.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокНайденных;


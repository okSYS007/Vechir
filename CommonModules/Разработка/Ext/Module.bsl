		//|	Номенклатура.КлассификацияЗаУровнемЭксплуатационныхСвойств
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выгрузить();
		СписокНаименований = "";
		СписокЗначенийРеквизитов = Новый СписокЗначений;
		СписокЗначенийРеквизитов.Добавить(?(ЗначениеЗаполнено(Выборка[0].ГруппаПродукцииЗаПредназначением), Выборка[0].ГруппаПродукцииЗаПредназначением, ""));
		СписокЗначенийРеквизитов.Добавить(?(ЗначениеЗаполнено(Выборка[0].ТорговаяМаркиНоменклатуры), Выборка[0].ТорговаяМаркиНоменклатуры, ""));
		СписокЗначенийРеквизитов.Добавить(?(ЗначениеЗаполнено(Выборка[0].КлассификацияЗаУровнемВязкости), Выборка[0].КлассификацияЗаУровнемВязкости, ""));
		// + IvanSidoruk 25.01.2021 
		//СписокЗначенийРеквизитов.Добавить(?(ЗначениеЗаполнено(Выборка[0].КлассификацияЗаУровнемЭксплуатационныхСвойств), Выборка[0].КлассификацияЗаУровнемЭксплуатационныхСвойств, ""));
		СписокЗначенийРеквизитов.Добавить("");
		// - IvanSidoruk 25.01.2021 
		
		Возврат СписокЗначенийРеквизитов;
	КонецЕсли;
	

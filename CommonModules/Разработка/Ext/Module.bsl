Функция ПолучитьРеквизитыТорговыеМаркиНоменклатуры(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТорговыеМаркиНоменклатуры.Наименование,
		|	ТорговыеМаркиНоменклатуры.ПродажаЛилиШТ,
		|	ТорговыеМаркиНоменклатуры.ПродажаКГилиШТ
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТорговыеМаркиНоменклатуры КАК ТорговыеМаркиНоменклатуры
		|		ПО Номенклатура.ТорговаяМаркиНоменклатуры = ТорговыеМаркиНоменклатуры.Ссылка
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	СписокРеквизитов = Новый СписокЗначений;
	СписокРеквизитов.Добавить(ТаблицаЗапроса[0].Наименование, "НаименованиеТорговойМарки");	
	СписокРеквизитов.Добавить(ТаблицаЗапроса[0].ПродажаЛилиШТ, "ПродажаЛилиШТ");	
	СписокРеквизитов.Добавить(ТаблицаЗапроса[0].ПродажаКГилиШТ, "ПродажаКГилиШТ");	
	Возврат СписокРеквизитов;

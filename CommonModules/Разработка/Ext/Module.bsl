Процедура ОткрытьВнешнююОбработкуОтчет(СсылкаОбработка,СтрукутраПарам = Неопределено) Экспорт 
	
	Если Не ЗначениеЗаполнено(СсылкаОбработка) Тогда 
		Возврат;
	КонецЕсли;	
	
	Если СсылкаОбработка.ВидОбработки = Перечисления.ВидыДополнительныхВнешнихОбработок.Отчет Тогда
		ТипОбработки = ".erf";
		МенеджерОбработок = ВнешниеОтчеты;
	ИначеЕсли СсылкаОбработка.ВидОбработки = Перечисления.ВидыДополнительныхВнешнихОбработок.Обработка Тогда
		ТипОбработки = ".epf";
		МенеджерОбработок = ВнешниеОбработки;
	Иначе
		Возврат;
	КонецЕсли;
	
	Попытка
		ПутьКФайлу = ПолучитьИмяВременногоФайла(ТипОбработки);
		
		СсылкаОбработка.ХранилищеВнешнейОбработки.Получить().Записать(ПутьКФайлу);
	
		Форма = МенеджерОбработок.ПолучитьФорму(ПутьКФайлу);
		
		//  + IvanSidoruk 14.01.2019
		Если ТипЗнч(СтрукутраПарам) = тип("Структура") Тогда 
			Для Каждого КлючСтр из СтрукутраПарам Цикл 
				Форма[КлючСтр.Ключ] = КлючСтр.Значение;				
			КонецЦикла;
		КонецЕсли;
		//  - IvanSidoruk 14.01.2019
		
		Если Форма <> Неопределено Тогда
			Форма.Открыть();
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);

	КонецПопытки;
	
	Попытка
		УдалитьФайлы(ПутьКФайлу); 
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры


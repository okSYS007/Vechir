Функция ЗагрузитьКурсыВалютПоПараметрам(Знач Валюты, Знач НачалоПериодаЗагрузки, Знач ОкончаниеПериодаЗагрузки, ПриЗагрузкеВозниклиОшибки = Ложь) Экспорт
	
	Перем HTTP;
	
	РегистрКурсыВалют = РегистрыСведений.КурсыВалют;
	ЗаписьКурсовВалют = РегистрКурсыВалют.СоздатьМенеджерЗаписи();

	Текст = Новый ТекстовыйДокумент();
	СостояниеЗагрузки = Новый Массив;

	СерверИсточник = "fin.1c.ua";

	Адрес1 = "1c/cb/";  // в интервале
	Адрес2 = "1c/";     // по 1 дате
	
	Если НачалоПериодаЗагрузки = ОкончаниеПериодаЗагрузки Тогда  // по 1 дате
		Адрес = Адрес2;
		ТМП   = "/"+Формат(Год(ОкончаниеПериодаЗагрузки),"ЧРГ=; ЧГ=0")+"/"+Формат(Месяц(ОкончаниеПериодаЗагрузки),"ЧЦ=2;ЧДЦ=0;ЧВН=")+"/"+Формат(День(ОкончаниеПериодаЗагрузки),"ЧЦ=2;ЧДЦ=0;ЧВН=");
	Иначе    // в интервале
		Адрес = Адрес1;
		ТМП   = "";
	КонецЕсли;

	ВремКаталог = КаталогВременныхФайлов() + "tempKurs";
	СоздатьКаталог(ВремКаталог);
	УдалитьФайлы(ВремКаталог,"*.*");
	ИмяФайла = "Curses.html";
	
	Для Каждого Валюта Из Валюты Цикл
		
		ТекВалюта 		= Валюта.Валюта;
		ТекВалютаКод	= Валюта.КодВалюты;
		Стр = "";
		
		ИмяВходящегоФайла = "" + ВремКаталог + "\" + ИмяФайла;
		СтрокаПараметраПолучения = Адрес + Прав(ТекВалютаКод,3) + ТМП + ".tsv";
		
		Если ЗапроситьФайлыССервера(СерверИсточник, СтрокаПараметраПолучения, ИмяВходящегоФайла, HTTP) <> Истина Тогда
			
			ПоясняющееСообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
													НСтр("ru='Невозможно получить файл данных с курсами валюты (%1 - %2).';uk='Неможливо отримати файл даних з курсами валюти (%1 - %2).'"),
													ТекВалютаКод,
													ТекВалюта) + Символы.ПС;
			СтатусОперации = Ложь;
			ПриЗагрузкеВозниклиОшибки = Истина;
			
		Иначе
			
			ВходящийФайл = Новый Файл(ИмяВходящегоФайла);
			
			Текст.Прочитать(ИмяВходящегоФайла,КодировкаТекста.ANSI);
			
			КолСтрок = Текст.КоличествоСтрок();
			
			Для Инд = 1 По КолСтрок Цикл
				
				Стр = Текст.ПолучитьСтроку(Инд);
				
				Если (Стр = "") ИЛИ (Найти(Стр,Символы.Таб) = 0) Тогда
					Продолжить;
				КонецЕсли;
				
				Если НачалоПериодаЗагрузки = ОкончаниеПериодаЗагрузки Тогда  
					ДатаКурса = ОкончаниеПериодаЗагрузки;
				Иначе 
					ДатаКурсаСтр = ВыделитьПодСтроку(Стр);
					ДатаКурса    = Дата(Лев(ДатаКурсаСтр,4),Сред(ДатаКурсаСтр,5,2),Сред(ДатаКурсаСтр,7,2));
				КонецЕсли;
				
				Кратность = Число(ВыделитьПодСтроку(Стр));
				Курс      = Число(ВыделитьПодСтроку(Стр));
				
				Если ДатаКурса > ОкончаниеПериодаЗагрузки Тогда
					Прервать;
				КонецЕсли;
				
				Если ДатаКурса < НачалоПериодаЗагрузки Тогда 
					Продолжить;
				КонецЕсли;
				
				ЗаписьКурсовВалют.Валюта 	= ТекВалюта;
				ЗаписьКурсовВалют.Период 	= ДатаКурса;
				ЗаписьКурсовВалют.Прочитать();
				ЗаписьКурсовВалют.Валюта		= ТекВалюта;
				ЗаписьКурсовВалют.Период		= ДатаКурса;
				ЗаписьКурсовВалют.Курс			= Курс;
				ЗаписьКурсовВалют.Кратность	= Кратность;
				ЗаписьКурсовВалют.Записать();
				
			КонецЦикла;
			
			ПоясняющееСообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
													НСтр("ru='Получен курс валюты (%1 - %2).';uk='Отримано курс валюти (%1 - %2).'"),
													ТекВалютаКод,
													ТекВалюта) + Символы.ПС;
			СтатусОперации = Истина;
			ПриЗагрузкеВозниклиОшибки = Ложь;
			
		КонецЕсли; 
		
		СостояниеЗагрузки.Добавить(Новый Структура("Валюта,СтатусОперации,Сообщение", ТекВалюта, СтатусОперации, ПоясняющееСообщение));
		
	КонецЦикла;
	
	УдалитьФайлы(ВремКаталог,"*.*");
	
	Возврат СостояниеЗагрузки;
	
КонецФункции

Функция ЗапроситьФайлыССервера(СерверИсточникПараметр, СтрокаПараметраПолученияПараметр, ИмяВходящегоФайлаПараметр, HTTP = Неопределено)
	
	Если ТипЗнч(HTTP) <> Тип("HTTPСоединение") Тогда
		HTTP = СоздатьСоединение(СерверИсточникПараметр);
	КонецЕсли; 
	
	Попытка
		HTTP.Получить(СтрокаПараметраПолученияПараметр, ИмяВходящегоФайлаПараметр);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ВыделитьПодСтроку(ИсходнаяСтрока)

	Перем ПодСтрока;
	
    Поз = Найти(ИсходнаяСтрока,Символы.Таб);
	Если Поз > 0 Тогда
		ПодСтрока = Лев(ИсходнаяСтрока,Поз-1);
		ИсходнаяСтрока = Сред(ИсходнаяСтрока,Поз+1);
	Иначе
		ПодСтрока = ИсходнаяСтрока;
		ИсходнаяСтрока = "";
	КонецЕсли;
	
	Возврат ПодСтрока;
 
КонецФункции

Функция СоздатьСоединение(СерверИсточник)

	Перем HTTP;
	
	HTTP = Новый HTTPСоединение(СерверИсточник);
	
	Возврат HTTP;
	
КонецФункции

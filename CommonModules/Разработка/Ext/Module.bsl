	               |	МаршрутыСогласованияСогласующиеЛица.Ссылка
	               |ИЗ
	               |	Справочник.МаршрутыСогласованияЗаказов.СогласующиеЛица КАК МаршрутыСогласованияСогласующиеЛица
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователейДляМаршрутаСогласованияЗаявок.СогласующиеЛица КАК ГруппыПользователейДляМаршрутаСогласованияЗаявокСогласующиеЛица
	               |		ПО МаршрутыСогласованияСогласующиеЛица.Пользователь = ГруппыПользователейДляМаршрутаСогласованияЗаявокСогласующиеЛица.Ссылка
	               |ГДЕ
	               |	ГруппыПользователейДляМаршрутаСогласованияЗаявокСогласующиеЛица.СогласующееЛицо = &ТекПользователь";
				   
	Запрос.УстановитьПараметр("ТекПользователь", ТекущийПользователь);
	ЭтапыТекущегоПользователя = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("МаршрутСогласования");
	СоответствиеСледующиеЭтапы = Новый Соответствие();
	ЕстьОшибки = Ложь;
	
	Если НЕ ЗначениеЗаполнено(НовоеСостояние)  Тогда
			//ИЛИ (Выборка.ПоследнийСогласующий = ТекущийПользователь
			//	И ТекущиеСостояние = НовоеСостояние) 
				
			Возврат Истина;
		КонецЕсли;
		Отказ = Ложь;
		
	Если НЕ ЗначениеЗаполнено(Выборка.Этап.Родитель) Тогда
		// - ПаламарчукН 16.10.2020
		
			НовыйЭтап = Выборка.Этап;
			
		Иначе
			
			//Определим новый этап - это может быть следующий этап (непосредственный родитель) 
			//	или один из вышестоящих этапов
			НовыйЭтап = Неопределено;
			
			//// + ПаламарчукН 16.10.2020
			Если  не ТекущиеСостояние = Перечисления.СостоянияЗаказов.Подготовлен Тогда 
					ОпределитьСледующийЭтапСогласования(Выборка.Этап,НовыйЭтап, Выборка.Этап.Родитель, ЭтапыТекущегоПользователя, СоответствиеСледующиеЭтапы);
			
					
			Иначе
			//// - ПаламарчукН 16.10.2020

				ОпределитьСледующийЭтапСогласования(Выборка.Этап,НовыйЭтап, Выборка.Этап, ЭтапыТекущегоПользователя, СоответствиеСледующиеЭтапы);
				
				Если НовыйЭтап = Неопределено Тогда 
					
					ОпределитьСледующийЭтапСогласованияВторогоУровня(Выборка.Этап,НовыйЭтап, Выборка.Этап, ЭтапыТекущегоПользователя, СоответствиеСледующиеЭтапы);
	
				КонецЕсли;
				
			КонецЕсли;
		
			//Если новый этап не удалось определить - сообщим об ошибке
			//	Такой ситуации возникать не должно.
			Если НовыйЭтап = Неопределено Тогда
				ТекстСообщения = НСтр("ru = 'Не удалось определить следующий этап согласования заявки &Заявка.
											|Состояние Заказа изменено не будет.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "&Заявка", Выборка.Заказ);
				
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ТекстПоля,, Отказ);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,,, Отказ);
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовыйЭтап) Тогда 
			Возврат Ложь;
		КонецЕсли;
		
		
		НовыйУровень = НовыйЭтап.Уровень() + 1;
		
		//Обработаем состояние Отказано
		Если НовоеСостояние = Перечисления.СостоянияЗаказов.Отклонен
			И Выборка.Заказ.Проведен Тогда
			
			Попытка
				//ЗаказОбъект = Выборка.Заказ.ПолучитьОбъект();
				//ЗаказОбъект.Заблокировать();
				//ЗаказОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
				ТекстСообщения = НСтр("ru = 'Не удалось отменить проведение документа &Заявка.
											|Состояние заказа изменено не будет.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "&Заявка", Выборка.Заказ);
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ТекстПоля,, Отказ);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , ,, Отказ);
			КонецПопытки;
		КонецЕсли;
		
				
		Если НовоеСостояние = Перечисления.СостоянияЗаказов.Возвращен Тогда
			НаборЗаписейСостояниеСогласования = РегистрыСведений.СостоянияСогласованияЗаказов.СоздатьНаборЗаписей();
			НаборЗаписейСостояниеСогласования.Отбор.Заказ.Установить(Выборка.Заказ);
			НаборЗаписейСостояниеСогласования.Прочитать();
			Если НаборЗаписейСостояниеСогласования.Количество() > 0 Тогда
				
			///Сделаем запись о возвращении этапа
				ПоследняяЗапись = НаборЗаписейСостояниеСогласования[НаборЗаписейСостояниеСогласования.Количество()-1];
				НоваяЗапись = НаборЗаписейСостояниеСогласования.Добавить();
				НоваяЗапись.Период       		= ТекущаяДата();
				НоваяЗапись.Активность   	= Истина;
				НоваяЗапись.ЗАказ       		= Выборка.ЗАказ;
				НоваяЗапись.Пользователь = ТекущийПользователь;
				НоваяЗапись.Состояние		= НовоеСостояние;
				НоваяЗапись.Уровень			= НовыйУровень;
				НоваяЗапись.Этап				= НовыйЭтап;
				НаборЗаписейСостояниеСогласования.Записать();
				
				
			///
				ТекущийПользователь = ТекущийПользователь;
				НовоеСостояние = Перечисления.СостоянияЗаказов.Подготовлен;
				НовыйЭтап	= ЭтапВозврата;	
				НовыйУровень =НовыйЭтап.Уровень();
				
			КонецЕсли;
		КонецЕсли;

		
		// Обработаем изменение состояния с Отказано на другое
		Если ТекущиеСостояние = Перечисления.СостоянияЗаказов.Отклонен 
			И НЕ Выборка.Заказ.Проведен Тогда
			
			Попытка
				//ЗаказОбъект = Выборка.Заказ.ПолучитьОбъект();
				//ЗаказОбъект.Заблокировать();
				//ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ТекстСообщения = НСтр("ru = 'Не удалось провести документ &Заявка.
											|Состояние заказа изменено не будет'");
											
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "&Заявка", Выборка.Заказ);
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ТекстПоля,, Отказ);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , ,, Отказ);
			КонецПопытки;
		КонецЕсли;
		
		Если Отказ Тогда
			ЕстьОшибки = Истина;
			Возврат ЕстьОшибки;
		КонецЕсли;
		
		//Изменим состояние заявки в регистре
		НаборЗаписейСостояниеСогласования = РегистрыСведений.СостоянияСогласованияЗаказов.СоздатьНаборЗаписей();
		НаборЗаписейСостояниеСогласования.Отбор.Заказ.Установить(Выборка.Заказ);
		НаборЗаписейСостояниеСогласования.Прочитать();
		
		//Проверим последнюю запись - если она относится к тому же пользователю и этапу, удалим ее
		Если НаборЗаписейСостояниеСогласования.Количество() > 0 Тогда
			ПоследняяЗапись = НаборЗаписейСостояниеСогласования[НаборЗаписейСостояниеСогласования.Количество()-1];
			Если ПоследняяЗапись.Пользователь = ТекущийПользователь
				И ПоследняяЗапись.Этап = НовыйЭтап Тогда
				
				НаборЗаписейСостояниеСогласования.Удалить(ПоследняяЗапись);
			КонецЕсли;
		КонецЕсли;

		Если Выборка.Состояние = Перечисления.СостоянияЗаказов.Согласован
			И НовыйУровень = 1 Тогда
			
			НовоеСостояние = Перечисления.СостоянияЗаказов.Утвержден;
		Иначе
			НовоеСостояние = НовоеСостояние;
		КонецЕсли; 
		
		НоваяЗапись = НаборЗаписейСостояниеСогласования.Добавить();
		НоваяЗапись.Период       		= ТекущаяДата()+5;
		НоваяЗапись.Активность   	= Истина;
		НоваяЗапись.ЗАказ       		= Выборка.ЗАказ;
		НоваяЗапись.Пользователь = ТекущийПользователь;
		НоваяЗапись.Состояние		= НовоеСостояние;
		НоваяЗапись.Уровень			= НовыйУровень;
		НоваяЗапись.Этап				= НовыйЭтап;
		
		НаборЗаписейСостояниеСогласования.Записать();
		
		//УспешноОбработанныеЗаявки.Добавить(СтрокаТабличнойЧасти);
		
		// NVV ++ Отправим на e-mail сообщение о Заявке инициатору
		//Если НовоеСостояние = Перечисления.СостоянияОбъектов.Утвержден Тогда 
		//	ОбщегоНазначенияДоработка.ДобавитьЗаписьДокументыОперативныйДляИнформирования(СтрокаТабличнойЧасти.Заявка, Перечисления.ВидыИнформированияПоДокументам.EMail);
		//КонецЕсли;
		// NVV --

	
	
	// Удалим из списка заявки по которым удалось изменить состояние
	//Для каждого ЭлКоллекции Из УспешноОбработанныеЗаявки Цикл
	//	ЗаявкиНаРасходованиеСредств.Удалить(ЭлКоллекции);
	//КонецЦикла; 
	
	Возврат НЕ ЕстьОшибки;

	
	
	
КонецФункции

Процедура ОпределитьСледующийЭтапСогласования(ПервыйЭтап , НовыйЭтап, ТекущийЭтап, ЭтапыТекущегоПользователя, СоответствиеСледующиеЭтапы)
	
	НовыйЭтап = СоответствиеСледующиеЭтапы.Получить(ТекущийЭтап);
	
	Если НовыйЭтап = Неопределено Тогда
		//++ Яковлев Р.А. 05.08.2021
		Если (ЭтапыТекущегоПользователя.Найти(ТекущийЭтап)<>Неопределено )   Тогда
			
			НовыйЭтап = ТекущийЭтап;
			СоответствиеСледующиеЭтапы.Вставить(ТекущийЭтап, НовыйЭтап);
			
		КонецЕсли;
		//-- Яковлев Р.А. 05.08.2021
		
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьСледующийЭтапСогласованияВторогоУровня(ПервыйЭтап , НовыйЭтап, ТекущийЭтап, ЭтапыТекущегоПользователя, СоответствиеСледующиеЭтапы)
	
	НовыйЭтап = СоответствиеСледующиеЭтапы.Получить(ТекущийЭтап);
	
	Если НовыйЭтап = Неопределено Тогда
		//++ Яковлев Р.А. 05.08.2021
		Если ЭтапыТекущегоПользователя.Найти(ТекущийЭтап)<>Неопределено   Тогда
			
			НовыйЭтап = ТекущийЭтап;
			СоответствиеСледующиеЭтапы.Вставить(ТекущийЭтап, НовыйЭтап);
			
		ИначеЕсли ЗначениеЗаполнено(ТекущийЭтап.Родитель) Тогда
			ОпределитьСледующийЭтапСогласования(ПервыйЭтап ,НовыйЭтап, ТекущийЭтап.Родитель, ЭтапыТекущегоПользователя, СоответствиеСледующиеЭтапы)
		КонецЕсли;
		//-- Яковлев Р.А. 05.08.2021
		
	
	КонецЕсли;
	
КонецПроцедуры

Функция РазрешеноИзменениеЗаявки(ДокументСсылка, ТекстСообщенияПользователю = "") Экспорт
	//Если НЕ Константы.ИспользоватьВизированиеЗаказов.Получить()  ИЛИ РольДоступна("ПолныеПрава") Тогда
	//	Возврат Истина;
	//КонецЕсли;
	ТекущийПользователь = глЗначениеПеременной("глТекущийПользователь");
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	//Получим маршруты согласования, в которых текущий пользователь назначен основным
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	МаршрутыСогласованияСогласующиеЛица.Ссылка КАК МаршрутСогласования
	               |ПОМЕСТИТЬ МаршрутыТекущегоПользователя
	               |ИЗ
	               |	Справочник.МаршрутыСогласованияЗаказов.СогласующиеЛица КАК МаршрутыСогласованияСогласующиеЛица
	               |ГДЕ
	               |	МаршрутыСогласованияСогласующиеЛица.Пользователь = &ТекПользователь
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	МаршрутыСогласованияСогласующиеЛица.Ссылка
	               |ИЗ
	               |	Справочник.МаршрутыСогласованияЗаказов.СогласующиеЛица КАК МаршрутыСогласованияСогласующиеЛица
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователейДляМаршрутаСогласованияЗаявок.СогласующиеЛица КАК ГруппыПользователейДляМаршрутаСогласованияЗаявокСогласующиеЛица
	               |		ПО МаршрутыСогласованияСогласующиеЛица.Пользователь = ГруппыПользователейДляМаршрутаСогласованияЗаявокСогласующиеЛица.Ссылка
	               |ГДЕ
	               |	ГруппыПользователейДляМаршрутаСогласованияЗаявокСогласующиеЛица.СогласующееЛицо = &ТекПользователь
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	СостоянияСогласования.Состояние,
	               |	СостоянияСогласования.Этап,
	               |	СостоянияСогласования.Пользователь,
	               |	СостоянияСогласования.Уровень,
	               |	ЕСТЬNULL(СогласующиеЛица.Пользователь, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК СледующийСогласующий,
	               |	ВЫБОР
	               |		КОГДА СостоянияСогласования.Этап В ИЕРАРХИИ
	               |					(ВЫБРАТЬ
	               |						МаршрутыТекущегоПользователя.МаршрутСогласования
	               |					ИЗ
	               |						МаршрутыТекущегоПользователя)
	               |				И НЕ СостоянияСогласования.Этап В
	               |						(ВЫБРАТЬ
	               |							МаршрутыТекущегоПользователя.МаршрутСогласования
	               |						ИЗ
	               |							МаршрутыТекущегоПользователя)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК НижестоящийЭтапСогласования,
	               |	ЕСТЬNULL(СогласующиеЛица.Ссылка, ЗНАЧЕНИЕ(Справочник.МаршрутыСогласованияЗаказов.ПустаяСсылка)) КАК СледующийЭтап,
	               |	ЕСТЬNULL(СогласующиеЛица.МожетРедактироватьЗаказ, ЛОЖЬ) КАК МожетРедактироватьЗаказ
	               |ИЗ
	               |	РегистрСведений.СостоянияСогласованияЗаказов.СрезПоследних(, Заказ = &ТекущийЗаказ) КАК СостоянияСогласования
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МаршрутыСогласованияЗаказовСогласующиеЛица.Ссылка КАК Ссылка,
	               |			МаршрутыСогласованияЗаказовСогласующиеЛица.НомерСтроки КАК НомерСтроки,
	               |			МаршрутыСогласованияЗаказовСогласующиеЛица.Пользователь КАК Пользователь,
	               |			МаршрутыСогласованияЗаказовСогласующиеЛица.Ссылка.МожетРедактироватьЗаказ КАК МожетРедактироватьЗаказ
	               |		ИЗ
	               |			Справочник.МаршрутыСогласованияЗаказов.СогласующиеЛица КАК МаршрутыСогласованияЗаказовСогласующиеЛица
	               |		ГДЕ
	               |			МаршрутыСогласованияЗаказовСогласующиеЛица.Пользователь = &ТекПользователь) КАК СогласующиеЛица
	               |		ПО (ВЫБОР
	               |				КОГДА СостоянияСогласования.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказов.Подготовлен)
	               |					ТОГДА СогласующиеЛица.Ссылка = СостоянияСогласования.Этап
	               |				КОГДА СостоянияСогласования.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказов.Утвержден)
	               |					ТОГДА СогласующиеЛица.Ссылка = СостоянияСогласования.Этап
	               |				ИНАЧЕ СогласующиеЛица.Ссылка = СостоянияСогласования.Этап.Родитель
	               |			КОНЕЦ)";
	Запрос.УстановитьПараметр("ТекПользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("ТекущийЗаказ", ДокументСсылка);
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	Выборка = РезультатыЗапросов[1].Выбрать();
	//Маршрут согласования заявки не определен
	Если НЕ Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
		
	Если  (Выборка.МожетРедактироватьЗаказ ИЛИ ТипЗнч(ДокументСсылка)= Тип("ДокументСсылка.ЗаявкаНаПроизводство"))  И (Выборка.Пользователь = ТекущийПользователь Или Выборка.СледующийСогласующий = ТекущийПользователь) Тогда
		Возврат Истина;
	КонецЕсли;
	//Заявка еще не начала проходить по маршруту согласования
	Если НЕ ЗначениеЗаполнено(Выборка.Состояние)  Тогда
		Возврат Истина;
	//Заявка уже согласована к оплате
	ИначеЕсли Выборка.Состояние = Перечисления.СостоянияЗаказов.Утвержден Тогда
		ТекстСообщенияПользователю = НСтр("ru = 'Утвержденный заказ не может быть изменена.'");
		Возврат Ложь;
	Иначе
		//Заявка проходит по маршруту согласования. 
		//	Возможность изменения зависит от пользователя, который пытается изменить заявку
		//Заявка в процессе согласования у текущего пользователя (в состоянии Отложен или Отклонен)
		Если ТипЗнч(ДокументСсылка)= Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Если Выборка.МожетРедактироватьЗаказ Тогда
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;

		// NVV ++ Добавим спр. группы пользователей
		ПользовательЭтапаСогласования = Выборка.Пользователь;
		Если ТипЗнч(ПользовательЭтапаСогласования) = Тип("СправочникСсылка.ГруппыПользователейДляМаршрутаСогласованияЗаявок") Тогда 
			Строки = ПользовательЭтапаСогласования.СогласующиеЛица.НайтиСтроки(Новый Структура("СогласующееЛицо", ТекущийПользователь));
			Если Строки.Количество() <> 0 Тогда
				ПользовательЭтапаСогласования = Строки[0].СогласующееЛицо;
			Иначе
				ПользовательЭтапаСогласования = Справочники.Пользователи.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли;	
		
		СледующийСогласующийЭтапаСогласования = Выборка.СледующийСогласующий;
		Если ТипЗнч(СледующийСогласующийЭтапаСогласования) = Тип("СправочникСсылка.ГруппыПользователейДляМаршрутаСогласованияЗаявок") Тогда 
			Строки = СледующийСогласующийЭтапаСогласования.СогласующиеЛица.НайтиСтроки(Новый Структура("СогласующееЛицо", ТекущийПользователь));
			Если Строки.Количество() <> 0 Тогда
				СледующийСогласующийЭтапаСогласования = Строки[0].СогласующееЛицо;
			Иначе
				СледующийСогласующийЭтапаСогласования = Справочники.Пользователи.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли;
		
		Если ПользовательЭтапаСогласования = ТекущийПользователь И 
			(Выборка.Состояние = Перечисления.СостоянияЗаказов.Отклонен ИЛИ
			Выборка.Состояние = Перечисления.СостоянияЗаказов.Отложен) Тогда
			Возврат Истина;
		//Заявка перешла на согласование текущему пользователю
		ИначеЕсли Выборка.Состояние = Перечисления.СостоянияЗаказов.Согласован И 
			(СледующийСогласующийЭтапаСогласования = ТекущийПользователь) Тогда
			Возврат Истина;
		//Заявка находится на согласовании у "нижестоящих" этапов согласования
		//ИначеЕсли Выборка.НижестоящийЭтапСогласования Тогда
		//	Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	ТекстСообщенияПользователю = НСтр("ru = 'Заказ в процессе согласования, не может быть изменена.'");
	Возврат Ложь;
КонецФункции

Функция ПолучитьНачалоМаршрута(Тип,Налив=Ложь) Экспорт
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиНачалоМаршрутовЗаказов.Маршрут
		|ИЗ
		|	РегистрСведений.НастройкиНачалоМаршрутовЗаказов КАК НастройкиНачалоМаршрутовЗаказов
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(НастройкиНачалоМаршрутовЗаказов.ТипДокумента) = &ТипДокумента И Налив = &Налив";
	
	Запрос.УстановитьПараметр("ТипДокумента", Тип);
	Запрос.УстановитьПараметр("Налив", Налив);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если  ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Маршрут; 
	КонецЕсли;
	
	Возврат Справочники.МаршрутыСогласованияЗаказов.ПустаяСсылка();

	
КонецФункции

Функция ПолучитьОстаткиПоСкладам(Дата, ТаблицаПоТоварам,Склад,Организация) Экспорт
	
	фТаблицаПоТоварам = ТаблицаПоТоварам.Скопировать(, "Номенклатура, ХарактеристикаНоменклатуры");



	фТаблицаПоТоварам.Свернуть("Номенклатура");
	СписокТоваров = Новый СписокЗначений;
	СписокТоваров.ЗагрузитьЗначения(фТаблицаПоТоварам.ВыгрузитьКолонку("Номенклатура"));

	
	СписокСкладов = Новый СписокЗначений;
	Если ЗначениеЗаполнено(Склад) Тогда
		Если ТипЗнч(Склад) = Тип("СправочникСсылка.ГруппыДоступностиСкладов")  Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СоставГруппДоступностиСкладов.Склад
			|ИЗ
			|	РегистрСведений.СоставГруппДоступностиСкладов КАК СоставГруппДоступностиСкладов
			|ГДЕ
			|	СоставГруппДоступностиСкладов.ГруппаДоступности = &ГруппаДоступности";
			
			Запрос.УстановитьПараметр("ГруппаДоступности", Склад);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СписокСкладов.Добавить(ВыборкаДетальныеЗаписи.Склад)
			КонецЦикла;
			
			
		Иначе
			СписокСкладов.Добавить(Склад);	
		КонецЕсли;
	КонецЕсли;
	
	
	
	
		СчетУчета = РазработкаСервер.ПолучитьСчетаУчетаНСП();
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МоментКон", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	//Подразделения = Новый Массив;
	//Если НЕ Подразделение.Пустая() Тогда
	//	Подразделения.Добавить(Подразделение);
	//	Подразделения.Добавить(Подразделение.Родитель);
	//КонецЕсли; 
	//ЗапросПоМатериалам.УстановитьПараметр("Подразделения", Подразделения);	
	//ЗапросПоМатериалам.УстановитьПараметр("Подразделение", Подразделение);	
	Запрос.УстановитьПараметр("Номенклатура",  СписокТоваров);
	Запрос.УстановитьПараметр("Счет", СчетУчета);
	Запрос.УстановитьПараметр("Склад", СписокСкладов);
		
	
	
	   
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет КАК СчетУчета,
	|	ХозрасчетныйОстатки.Субконто1 КАК Номенклатура,
	|	ХозрасчетныйОстатки.Субконто1.ЕдиницаХраненияОстатков КАК Ед,
	|	ХозрасчетныйОстатки.Субконто3 КАК Склад,
	|	ЕСТЬNULL(ХозрасчетныйОстатки.Субконто4.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	ХозрасчетныйОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&МоментКон,
	|			(Счет В(&Счет))
	|				И НЕ Счет.Забалансовый,
	|			,
	|			Организация = &Организация
	|				И Субконто3 В (&Склад)
	|				И Субконто1 В (&Номенклатура)) КАК ХозрасчетныйОстатки
	|ГДЕ
	|	ХозрасчетныйОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Номенклатура,
	|	Остатки.Ед КАК Ед,
	|	Остатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	Остатки КАК Остатки";
	
	
	Результат = Запрос.Выполнить();
	
	
	ТабОстатки = Результат.Выгрузить();
	Возврат ТабОстатки;
	
КонецФункции


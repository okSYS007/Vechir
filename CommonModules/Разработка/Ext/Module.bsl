//+ВладЧ
Процедура ЗарегистрироватьУдалитьбИзмененияДляТСД(МобДок,УдалятьИзменения = Ложь )
	 	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	vrgМобильныеСклад.Ссылка
		|ИЗ
		|	ПланОбмена.vrgМобильныеСклад КАК vrgМобильныеСклад
		|ГДЕ
		|	НЕ vrgМобильныеСклад.ЭтотУзел";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	МассивУзлов = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивУзлов.Добавить(ВыборкаДетальныеЗаписи.ссылка);
	КонецЦикла;
	Если Не УдалятьИзменения Тогда 
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов,МобДок);
	Иначе
		ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,МобДок);
	КонецЕсли;


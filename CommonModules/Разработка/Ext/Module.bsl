		КоличествоВидовСубконто = ВидыСубконто.Количество();
		
		Если ИндексСубконто <= КоличествоВидовСубконто Тогда 
			ВидСубконто = ВидыСубконто[ИндексСубконто-1].ВидСубконто;
			ЗначениеСубконто = Проводка["Субконто"+ВидСчета][ВидСубконто];			

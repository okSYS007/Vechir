Функция ЭтоНАлив(ТекХарактеристика,ТекНоменклатура) Экспорт 
	
	ЭтоНАлив = Ложь;
		 	
	
	Если ЗначениеЗаполнено(ТекХарактеристика) Тогда  
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Объект", ТекХарактеристика);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗначенияСвойствОбъектов.Объект,
			|	ЗначенияСвойствОбъектов.Объект КАК Объект1,
			|	ЗначенияСвойствОбъектов.Значение
			|ИЗ
			|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
			|ГДЕ
			|	ЗначенияСвойствОбъектов.Объект = &Объект";
		
		
		
		ТаблицаЗначейнийСвойств = Запрос.Выполнить().Выгрузить();
	

	
		Для Каждого  СтрокаЗначСвойств из ТаблицаЗначейнийСвойств Цикл 

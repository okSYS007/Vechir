Процедура VRПартииТоваровБухгалтерсикйУчетАльтернативныйОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	
	МетаданныеДокумента = Источник.Метаданные();
	//	
	МожетДелатьДвиженияПоХозрасчетный					= МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыБухгалтерии.Хозрасчетный);
	МожетДелатьДвиженияПоПартиямАльтернатиный	= МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный);
	
	Если не МожетДелатьДвиженияПоХозрасчетный
		Или НЕ МожетДелатьДвиженияПоПартиямАльтернатиный Тогда 
		Возврат;
	КонецЕсли;
	//
	//
	СсылкаНАДокумент 	= Источник.Ссылка;
	ДатаРегистратора 	= СсылкаНАДокумент.Дата;

	Если НЕ ИспользоватьАльтернативныйПартионныйУчет(ДатаРегистратора) Тогда 
		Возврат;
	КонецЕсли;
	//
	//
	//Там где есть контрагент - проверяемя
	//контрагент внутрении или Внешний
	//Внешний- Просто + с стоимостью по партии
	//Внутренний, нужно брать остаток по регистру, по номеклатуре счету и т.д


	ТаблицаПроводок = Источник.движения.Хозрасчетный;
	//
	//МассивСчетовВзаиморасчетов = Новый Массив;
	//МассивСчетовВзаиморасчетов .Добавить(ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПокупателями);
	//
	//
	Организация = Неопределено;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Организация",МетаданныеДокумента) Тогда 
		Организация =  Источник.Организация;
	КонецЕсли;
	
	ЕстьДокументВнтуригрупповой = Ложь;
	ДокументВнутригрупповой = Неопределено;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ДокументОснование", МетаданныеДокумента)
		и ЗначениеЗаполнено(Источник.ДокументОснование) Тогда 
		
		МетаданыеОснования = Источник.ДокументОснование.метаданные();
		
		Если ОбщегоНазначения.ЕстьРеквизитДокумента("Организация",МетаданыеОснования)
			и Организация <> Источник.ДокументОснование.Организация Тогда 
			
			ЕстьДокументВнтуригрупповой = Истина;	
			ДокументВнутригрупповой = Источник.ДокументОснование;
		КонецЕсли;
	КонецЕсли;
	
	//
	наборПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный = РегистрыНакопления.ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный.СоздатьНаборЗаписей();	
	наборПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный.Отбор.Регистратор.Установить(СсылкаНАДокумент);
	наборПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный.Прочитать();
	наборПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный.Очистить();
	//
	ТаблицаПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный = наборПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный.ВыгрузитьКолонки();
	ТаблицаПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный .Колонки.Добавить("КлючСтрокиСвязиСписания",Новый ОписаниеТипов("Строка"));
	//
	////Если движение в ДТ товарного учета и количетсов + Это приход
	////Если движение в КТ товарного учета и количетсов + Это Расход
	//
	
	//
	ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная = ТаблицаПартииТоваровНаСкладахБухгалтерскийУчетАльтернативный.СкопироватьКолонки(); 
	ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.Колонки.Добавить("КонтрагентВнутригруппа",Новый ОписаниеТипов("Булево"));
	//ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.Колонки.Добавить("КлючСтрокиСвязиСписания",Новый ОписаниеТипов("Строка"));
	МассивСчетовТоварногоУчета = РазработкаСервер.ПолучитьСчетаУчетаНСП();	
	
	Контрагент = Неопределено;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Контрагент",МетаданныеДокумента) Тогда 
		Контрагент =  Источник.Контрагент;
	КонецЕсли;
	
	
	МассивКонтрагентовВнутригруппа = ПолучитьКонтрагентовВнутригруппа();
	
	Для Каждого СтрокаТЧ из ТаблицаПроводок Цикл 
	//	
	//	//Если в ДТ то+
		КлючСтрокиСвязиСписания = "";
		ЕстьДТ = Ложь;
		Если МассивСчетовТоварногоУчета.Найти(СтрокаТЧ.СчетДт) <> Неопределено Тогда 
	//		
			//Контрагент может быть в проводках по Кт
			КонтрагентПроводок 		= СтрокаТЧ.СубконтоКт.Контрагенты;
			Если ЗначениеЗаполнено(КонтрагентПроводок) Тогда 
				Контрагент = КонтрагентПроводок; 	
			КонецЕсли;
			
			ЭтоКонтрагентВнутригруппа = ?(ЗначениеЗаполнено(Контрагент) и  МассивКонтрагентовВнутригруппа.Найти(Контрагент)<> Неопределено, Истина, Ложь);
			
			
			
			
			СчетУчета						= СтрокаТЧ.СчетДт; 
			Номенклатура 					= СтрокаТЧ.СубконтоДт.Номенклатура;
			Склад				 				= СтрокаТЧ.СубконтоДт.Склады;
			ПартияПроводок 				= СтрокаТЧ.СубконтоДт.Партии;
			НоменклатурнаяПозиция = СтрокаТЧ.СубконтоДт.НоменклатурныеПозиции;
			ХарактеристикаНоменклатуры = ?(ЗначениеЗаполнено(НоменклатурнаяПозиция),НоменклатурнаяПозиция.ХарактеристикаНоменклатуры, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
			
			Количество						= СтрокаТЧ.КоличествоДт;
			Сумма								= СтрокаТЧ.Сумма;
			
			НоваяСтрока = ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.Добавить();
			НоваяСтрока.Активность					= Истина;
			НоваяСтрока.Период						=  ДатаРегистратора;
			НоваяСтрока.Регистратор 				= СсылкаНАДокумент;
			
			НоваяСтрока.Номенклатура							= Номенклатура;
			НоваяСтрока.СчетУчета								= СчетУчета;
			НоваяСтрока.Склад										= Склад;
			НоваяСтрока.ХарактеристикаНоменклатуры= ХарактеристикаНоменклатуры;
			
			
			Множитель  = ?(Количество>=0,1,-1);
			
			НоваяСтрока.ДокументОприходования= ПартияПроводок;//???
			
			ТекВидДвижения = ?(Множитель = 1,ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
			
			НоваяСтрока.ВидДвижения 				= ТекВидДвижения;
			
			НоваяСтрока.Количество                	 	= Количество*Множитель;
			НоваяСтрока.Стоимость						=Сумма*Множитель;			
			
			НоваяСтрока.КонтрагентВнутригруппа		= ЭтоКонтрагентВнутригруппа;
			НоваяСтрока.Контрагент							= Контрагент;
			
			КлючСтрокиСвязиСписания 						=  СокрЛП(Новый УникальныйИдентификатор);			
			НоваяСтрока.КлючСтрокиСвязиСписания =   КлючСтрокиСвязиСписания;
			
			ЕстьДТ = Истина;
		КонецЕсли;
	//		
	//	// это минус
		ЕстьКТ = (МассивСчетовТоварногоУчета.Найти(СтрокаТЧ.СчетКт) <> Неопределено) ;
		Если ЕстьДТ и Не ЕстьКТ Тогда 
			КлючСтрокиСвязиСписания = "";			
			НоваяСтрока.КлючСтрокиСвязиСписания = КлючСтрокиСвязиСписания;
		ИначеЕсли  ЕстьКТ Тогда 
	//		
			//Контрагент может быть в проводках по Кт
			КонтрагентПроводок 		= СтрокаТЧ.СубконтоДт.Контрагенты;
			Если ЗначениеЗаполнено(КонтрагентПроводок) Тогда 
				Контрагент = КонтрагентПроводок; 	
			КонецЕсли;
			
			ЭтоКонтрагентВнутригруппа = ?(ЗначениеЗаполнено(Контрагент) и  МассивКонтрагентовВнутригруппа.Найти(Контрагент)<> Неопределено, Истина, Ложь);
	
			СчетУчета						= СтрокаТЧ.СчетКт; 
			Номенклатура 					= СтрокаТЧ.СубконтоКт.Номенклатура;
			Склад				 				= СтрокаТЧ.СубконтоКт.Склады;
			ПартияПроводок 				= СтрокаТЧ.СубконтоКт.Партии;
			НоменклатурнаяПозиция = СтрокаТЧ.СубконтоКт.НоменклатурныеПозиции;
			ХарактеристикаНоменклатуры = ?(ЗначениеЗаполнено(НоменклатурнаяПозиция),НоменклатурнаяПозиция.ХарактеристикаНоменклатуры, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
			
			Количество						= СтрокаТЧ.КоличествоКт;
			Сумма								= СтрокаТЧ.Сумма;
			
			НоваяСтрока = ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.Добавить();
			НоваяСтрока.Активность					= Истина;
			НоваяСтрока.Период						=  ДатаРегистратора;
			НоваяСтрока.Регистратор 				= СсылкаНАДокумент;
			
			НоваяСтрока.Номенклатура							= Номенклатура;
			НоваяСтрока.СчетУчета								= СчетУчета;
			НоваяСтрока.Склад										= Склад;
			НоваяСтрока.ХарактеристикаНоменклатуры= ХарактеристикаНоменклатуры;
			
			
			Множитель  = ?(Количество>=0,1,-1);
			
			НоваяСтрока.ДокументОприходования= ПартияПроводок;//???
			
			ТекВидДвижения = ?(Множитель = 1,ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
			
			НоваяСтрока.ВидДвижения 				= ТекВидДвижения;
			
			НоваяСтрока.Количество                	 	= Количество*Множитель;
			НоваяСтрока.Стоимость						=Сумма*Множитель;			
			
			НоваяСтрока.КонтрагентВнутригруппа  = ЭтоКонтрагентВнутригруппа;
			НоваяСтрока.Контрагент						  = Контрагент;
			
			НоваяСтрока.КлючСтрокиСвязиСписания =   КлючСтрокиСвязиСписания;
		КонецЕсли;
		
	КонецЦикла;
	//
	////Все что в минус будем выбирать по остаткам
	Если ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.Количество() > 0 Тогда 
		
		
		
		Запрос = Новый Запрос;		
		Запрос.УстановитьПараметр("ДатаОстатков"							, СсылкаНАДокумент.МоментВремени());		
		Запрос.УстановитьПараметр("Номенклатура"							, ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.ВыгрузитьКолонку("Номенклатура"));
		Запрос.УстановитьПараметр("СчетУчета"								, ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.ВыгрузитьКолонку("СчетУчета"));	
		Запрос.УстановитьПараметр("Склад"										, ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.ВыгрузитьКолонку("Склад"));	
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры"	, ПартииТоваровНаСкладахБухгалтерскийУчетАльтернативныйСлужебная.ВыгрузитьКолонку("ХарактеристикаНоменклатуры"));	
		Запрос.УстановитьПараметр("Приход", ВидДвиженияНакопления.Приход);
		Запрос.УстановитьПараметр("Расход", ВидДвиженияНакопления.Расход);
		Если ЕстьДокументВнтуригрупповой Тогда 
			Запрос.УстановитьПараметр("ДокументВнутригрупповой", ДокументВнутригрупповой);
		КонецЕсли;

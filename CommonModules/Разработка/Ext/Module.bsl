				ТекХарактеристика 	= СтркоаНоменуклатурыПартии.ХарактеристикаНоменклатуры;
				
				
				МассивТоваров = Новый Массив;
				МассивТоваров.Добавить(ТекНоменклатура);
				
				ТаблицаНаименований										= Разработка.ВернутьТаблицуНаименованийНоменклатурыКонтрагента(МассивТоваров, ТекПартияСписания.Контрагент, ТекПартияСписания.Дата,ТекПартияСписания.Организация);
				ТаблицаНаименованийПоКнтрагентуПродаж	= Разработка.ВернутьТаблицуНаименованийНоменклатурыКонтрагента(МассивТоваров, Источник.Контрагент, Источник.Дата);
				
				СтрокаДляЗаполнения 						= Разработка.ПолучитьНаименованиеНоменклатуры(ТекНоменклатура,ТекХарактеристика,ТаблицаНаименований);
				СтрокаДляЗаполненияПоКонтрагенту 	= Разработка.ПолучитьНаименованиеНоменклатуры(ТекНоменклатура,ТекХарактеристика,ТаблицаНаименованийПоКнтрагентуПродаж);
				
				Если СтрокаДляЗаполнения <>СтрокаДляЗаполненияПоКонтрагенту Тогда 
					ОбщегоНазначения.СообщитьОбОшибке("Внимание! Отлчичается наименование "+СтрокаДляЗаполненияПоКонтрагенту + " от поступившего наименования:"+СтрокаДляЗаполнения+ "("+ТекПартияСписания+")  перезаполните наименование для контрагента, если нужно!");
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	
	// + IvanSidoruk 11.11.2020
	
	//+ Шовкопляс 20200505
	Если НЕ Отказ Тогда
		Если ((НЕ Источник.ДополнительныеСвойства.Свойство("ЭтоПереЗапись")) ИЛИ  (Источник.ДополнительныеСвойства.Свойство("ЭтоПереЗапись")  и   Источник.ДополнительныеСвойства.ЭтоПереЗапись = Ложь )) Тогда 

Функция НайтиЕдиницыИзмеренияПоТексту(Текст, ТекНоменклатура,ТекХарактеристика)
	
	СписокНайденных = Новый СписокЗначений;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекНоменклатура", ТекНоменклатура);
	Запрос.УстановитьПараметр("ТекХарактеристика", ТекХарактеристика);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕдиницыИзмерения.Ссылка как Ссылка,
	               |	ЕдиницыИзмерения.Представление КАК Представление
	               |ИЗ
	               |	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	               |ГДЕ
	               |	ЕдиницыИзмерения.Владелец = &ТекНоменклатура
	               |	И ЕдиницыИзмерения.ХарактеристикаЕдиницыИзмерения = &ТекХарактеристика
				   |";
	Результат = Запрос.Выполнить().Выбрать();
	
	ДлинаТекста = СтрДлина(СокрЛП(Текст));
	
	Пока Результат.Следующий() Цикл
		Если ВРег(Сред(Результат.Представление,1,ДлинаТекста)) = ВРег(СокрЛП(Текст)) Тогда
			СписокНайденных.Добавить(Результат.Ссылка,Результат.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокНайденных;
	

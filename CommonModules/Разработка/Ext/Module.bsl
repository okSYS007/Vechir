			НоваяСтрока.ДоговорКонтрагента	= ДоговорКонтрагента;
			
			НоваяСтрока.Сделка									  		= ДокументРасчетовСКонтрагентом;
			НоваяСтрока.ДокументРасчетовСКонтрагентом	= ДокументРасчетовСКонтрагентом;
			
			
			НоваяСтрока.ВидРасчетовСКонтрагентом			= Перечисления.ВидыРасчетовСКонтрагентами.ПоРеализации;
			НоваяСтрока.Контрагент                  					= Контрагент;
			
			НоваяСтрока.СуммаВзаиморасчетов					=СтрокаТЧ.Сумма;			
			
			// + IvanSidoruk 12.10.2020
			Если НоваяСтрока.СуммаВзаиморасчетов < 0 Тогда 
				НоваяСтрока.ВидДвижения = ВидДвиженияНакопления.Приход;
				НоваяСтрока.СуммаВзаиморасчетов = -НоваяСтрока.СуммаВзаиморасчетов;
			КонецЕсли;
			// - IvanSidoruk 12.10.2020
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.ДокументРасчетовСКонтрагентом) Тогда 
				НоваяСтрока.ДокументРасчетовСКонтрагентом =  СсылкаНАДокумент;		
			КонецЕсли;
			
		КонецЕсли; 
		
		
		//Если 
		
	КонецЦикла;
	
	//Все что в минус будем выбирать по остаткам
	Если ТаблицаВзаиморасчетовСлужебная.Количество() > 0 Тогда 
		
		Запрос = Новый Запрос;
		// + IvanSidoruk 12.10.2020
		//Запрос.УстановитьПараметр("ДатаОстатков", ДатаРегистратора);
		Запрос.УстановитьПараметр("ДатаОстатков", СсылкаНАДокумент.МоментВремени());
		// - IvanSidoruk 12.10.2020
		Запрос.УстановитьПараметр("ДоговорКонтрагента", ТаблицаВзаиморасчетовСлужебная.ВыгрузитьКолонку("ДоговорКонтрагента"));
		Запрос.УстановитьПараметр("Контрагент", ТаблицаВзаиморасчетовСлужебная.ВыгрузитьКолонку("Контрагент"));
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Приход", ВидДвиженияНакопления.Приход);
		Запрос.УстановитьПараметр("Расход", ВидДвиженияНакопления.Расход);
		Запрос.Текст = 
			"ВЫБРАТЬ

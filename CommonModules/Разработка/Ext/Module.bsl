//+ВладЧ
Процедура СоздатьИзменитьЗаказПокупателяМобильный(Источник,Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если Источник.ДополнительныеСвойства.Свойство("Обновлен") Тогда
		Возврат;
	КонецЕсли;
	
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияСогласованияЗаказовСрезПоследних.Период,
		|	СостоянияСогласованияЗаказовСрезПоследних.Заказ,
		|	СостоянияСогласованияЗаказовСрезПоследних.Пользователь,
		|	СостоянияСогласованияЗаказовСрезПоследних.Состояние,
		|	СостоянияСогласованияЗаказовСрезПоследних.Уровень,
		|	СостоянияСогласованияЗаказовСрезПоследних.Этап
		|ИЗ
		|	РегистрСведений.СостоянияСогласованияЗаказов.СрезПоследних КАК СостоянияСогласованияЗаказовСрезПоследних
		|ГДЕ
		|	СостоянияСогласованияЗаказовСрезПоследних.Заказ = &Заказ
		| И СостоянияСогласованияЗаказовСрезПоследних.Этап <> ЗНАЧЕНИЕ(Справочник.МаршрутыСогласованияЗаказов.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Заказ", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ЭтапСогласования = РезультатЗапроса.Выбрать();
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	vrgСоответствияМобильныхДокументов.МобильныйДокумент
		|ИЗ
		|	РегистрСведений.vrgСоответствияМобильныхДокументов КАК vrgСоответствияМобильныхДокументов
		|ГДЕ
		|	vrgСоответствияМобильныхДокументов.ОсновнойДокумент = &ОсновнойДокумент";
	
	Запрос.УстановитьПараметр("ОсновнойДокумент", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		МобДокумент = ВыборкаДетальныеЗаписи.МобильныйДокумент.ПолучитьОбъект();
		//Редактировать существующий не нужно
		ЗарегистрироватьУдалитьбИзмененияДляТСД(МобДокумент.Ссылка);
		Возврат;
		НеобходимоСделатьЗаписьСоответствия = Ложь;
	Иначе
		МобДокумент = Документы.vrgЗаказКлиентаМобильный.СоздатьДокумент();
		НеобходимоСделатьЗаписьСоответствия = Истина;

	КонецЕсли;
	
	Если ЭтапСогласования.Следующий() Тогда
		Если ЭтапСогласования.Этап.Родитель = Справочники.МаршрутыСогласованияЗаказов.НайтиПоНаименованию("Склад") И Не ЭтапСогласования.Состояние = Перечисления.СостоянияЗаказов.Подготовлен  Тогда
			
	Если МобДокумент.ЭтоНовый() Тогда
		МобДокумент.СтатусЗаказа				= Перечисления.СтатусыСкладаЗаказаПокупателя.Ожидает;
	КонецЕсли;
	МобДокумент.Организация 				= Источник.Организация;
	МобДокумент.Контрагент 					= Источник.Контрагент;
	МобДокумент.Склад 						= Источник.СкладГруппа ;
	МобДокумент.Ответственный 				= Источник.Ответственный;
	Если Источник.Комментарии.Количество() Тогда
		Комментарий = Источник.Комментарии[Источник.Комментарии.Количество()-1].Комментарий;
	Иначе
		Комментарий = "";
	КонецЕсли;
	МобДокумент.Дата						= Источник.Дата;
	МобДокумент.Комментарий 				= Комментарий;
	МобДокумент.СозданНаМобильномУстройстве = Ложь;
	МобДокумент.ТипЦен 						= Источник.ТипЦен;
	МобДокумент.ДоговорКонтрагента 			= Источник.ДоговорКонтрагента;
	МобДокумент.СуммаДокумента 				= Источник.СуммаДокумента;
	МобДокумент.Товары.Очистить();
	Для Каждого СтрокаЗаказа из Источник.Товары Цикл
		НоваяСтрокаМоб = МобДокумент.Товары.Добавить();
		НоваяСтрокаМоб.Номенклатура					  =  СтрокаЗаказа.Номенклатура;
		НоваяСтрокаМоб.ХарактеристикаНоменклатуры     =  СтрокаЗаказа.ХарактеристикаНоменклатуры;
		НоваяСтрокаМоб.СерияНоменклатуры              =  СтрокаЗаказа.СерияНоменклатуры;
		НоваяСтрокаМоб.КоличествоЗаказ                =  СтрокаЗаказа.Количество;
		НоваяСтрокаМоб.Цена                           =  СтрокаЗаказа.Цена;
		НоваяСтрокаМоб.Сумма                          =  СтрокаЗаказа.Сумма;
		НоваяСтрокаМоб.ЕдиницаИзмерения               =  СтрокаЗаказа.ЕдиницаИзмерения;
		НоваяСтрокаМоб.Коэффициент                    =  СтрокаЗаказа.Коэффициент;
	КонецЦикла;
	
	Для Каждого СтрокаЗаказа из Источник.Услуги Цикл
		НоваяСтрокаМоб = МобДокумент.Товары.Добавить();
		НоваяСтрокаМоб.Номенклатура					  =  СтрокаЗаказа.Номенклатура;
		//НоваяСтрокаМоб.ХарактеристикаНоменклатуры     =  СтрокаЗаказа.ХарактеристикаНоменклатуры;
		//НоваяСтрокаМоб.СерияНоменклатуры              =  СтрокаЗаказа.СерияНоменклатуры;
		НоваяСтрокаМоб.КоличествоЗаказ                =  СтрокаЗаказа.Количество;
		НоваяСтрокаМоб.Цена                           =  СтрокаЗаказа.Цена;
		НоваяСтрокаМоб.Сумма                          =  СтрокаЗаказа.Сумма;
		НоваяСтрокаМоб.ЕдиницаИзмерения               =  СтрокаЗаказа.ЕдиницаИзмерения;
		//НоваяСтрокаМоб.Коэффициент                    =  СтрокаЗаказа.Коэффициент;
	КонецЦикла;

	МобДокумент.ДополнительныеСвойства.Вставить("ОбноаленВЦБ",Истина);
	МобДокумент.Записать(РежимЗаписиДокумента.Запись);
	ЗарегистрироватьУдалитьбИзмененияДляТСД(МобДокумент.Ссылка);
	Если НеобходимоСделатьЗаписьСоответствия Тогда
		МенеджерЗаписиСоответствия = РегистрыСведений.vrgСоответствияМобильныхДокументов.СоздатьМенеджерЗаписи();
		МенеджерЗаписиСоответствия.МобильныйДокумент = МобДокумент.Ссылка;
		МенеджерЗаписиСоответствия.ОсновнойДокумент = Источник.Ссылка;
		МенеджерЗаписиСоответствия.Записать();
	КонецЕсли;

	Иначе 
	    Если ЗначениеЗаполнено(МобДокумент.Ссылка) Тогда
			ЗарегистрироватьУдалитьбИзмененияДляТСД(МобДокумент.Ссылка, Истина)
		КонецЕсли;
	КонецЕсли;	
КонецЕсли;
			
КонецПроцедуры

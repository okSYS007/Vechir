	ДатаНачалаИспользованияАльтернативногоПартионногоУчета = Константы.ДатаНачалаИспользованияАльтернативногоПартионногоУчета.Получить();
	
	Использовать =  ?(ЗначениеЗаполнено(пДата) и ЗначениеЗаполнено(ДатаНачалаИспользованияАльтернативногоПартионногоУчета) и ДатаНачалаИспользованияАльтернативногоПартионногоУчета <= пДата, Истина, Ложь);
	
	Возврат Использовать;
	

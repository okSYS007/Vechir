Процедура ПереключитьОрганизации(ВыбраннаяОрганизация, ТекПользователь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Узнаем в какой группе пользователей находится текущий пользователь 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыПользователейПользователиГруппы.Ссылка КАК ГруппаПользователя
	|ИЗ
	|	Справочник.ГруппыПользователей.ПользователиГруппы КАК ГруппыПользователейПользователиГруппы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПравДоступаПользователей КАК НастройкиПравДоступаПользователей
	|		ПО ГруппыПользователейПользователиГруппы.Ссылка = НастройкиПравДоступаПользователей.Пользователь
	|			И (НастройкиПравДоступаПользователей.ВидОбъектаДоступа = ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовДоступа.Организации))
	|ГДЕ
	|	ГруппыПользователейПользователиГруппы.Пользователь = &ТекПользователь
	|	И НЕ НастройкиПравДоступаПользователей.ОбъектДоступа ЕСТЬ NULL ";
	
	Запрос.УстановитьПараметр("ТекПользователь", ТекПользователь);	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	//Удаляем пользователя с групп
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ГруппаПользователяОбъект = ВыборкаДетальныеЗаписи.ГруппаПользователя.ПолучитьОбъект();
		СтрокаТЧ = ГруппаПользователяОбъект.ПользователиГруппы.Найти(ТекПользователь);
		ГруппаПользователяОбъект.ПользователиГруппы.Удалить(СтрокаТЧ);
		ГруппаПользователяОбъект.Записать()
		
	КонецЦикла;
	
	//Получаем группы пользователей, в которые нужно добавить текущего пользователя
	МассивГрупп = Новый Массив;
	
	Если ВыбраннаяОрганизация = "Все организации" Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеГруппПользователяОрганизациям.ГруппаПользователя
		|ИЗ
		|	Справочник.Пользователи.А_ДоступныеОрганизации КАК ПользователиА_ДоступныеОрганизации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.А_СоответствиеГруппПользователяОрганизациям КАК А_СоответствиеГруппПользователяОрганизациям
		|		ПО ПользователиА_ДоступныеОрганизации.Организация = А_СоответствиеГруппПользователяОрганизациям.Организация
		|ГДЕ
		|	ПользователиА_ДоступныеОрганизации.Ссылка = &ТекПользователь";
		
		Запрос.УстановитьПараметр("ТекПользователь", ТекПользователь);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивГрупп.Добавить(ВыборкаДетальныеЗаписи.ГруппаПользователя)
		КонецЦикла;
		
	Иначе 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеГруппПользователяОрганизациям.ГруппаПользователя
		|ИЗ
		|	РегистрСведений.А_СоответствиеГруппПользователяОрганизациям КАК А_СоответствиеГруппПользователяОрганизациям
		|ГДЕ
		|	А_СоответствиеГруппПользователяОрганизациям.ПредставлениеОрганизации = &ПредставлениеОрганизации";
		
		Запрос.УстановитьПараметр("ПредставлениеОрганизации", ВыбраннаяОрганизация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивГрупп.Добавить(ВыборкаДетальныеЗаписи.ГруппаПользователя)
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ГруппаПользователя Из МассивГрупп Цикл
		
		ГруппаБУОбъект = ГруппаПользователя.ПолучитьОбъект();
		НоваяСтрока = ГруппаБУОбъект.ПользователиГруппы.Добавить();
		НоваяСтрока.Пользователь = ТекПользователь;
		ГруппаБУОбъект.Записать();
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьСписокОрганизаций(ТекПользователь) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивОрганизаций = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПользователиА_ДоступныеОрганизации.Организация
	|ИЗ
	|	Справочник.Пользователи.А_ДоступныеОрганизации КАК ПользователиА_ДоступныеОрганизации
	|ГДЕ
	|	ПользователиА_ДоступныеОрганизации.Ссылка = &ТекПользователь";
	
	Запрос.УстановитьПараметр("ТекПользователь", ТекПользователь);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	КолЗаписей = ВыборкаДетальныеЗаписи.Количество();	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивОрганизаций.Добавить(ВыборкаДетальныеЗаписи.Организация.Наименование);
	КонецЦикла;
	
	Если КолЗаписей > 1 Тогда 
		МассивОрганизаций.Добавить("Все организации")
	КонецЕсли;
	
	Возврат МассивОрганизаций;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

//
// Параметры СчетНаОплатуПокупателю - ДокументСсылка СчетНаОплатуПокупателю
//
Функция ПроверитьИспользованиеСчетаВДокументах(СчетНаОплатуПокупателю) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивИскомых = Новый Массив;
	МассивИскомых.Добавить(СчетНаОплатуПокупателю);

	МассивОбластьПоиска = Новый Массив;

	МассивВключаемые = Новый Массив;
	МассивВключаемые.Добавить(Метаданные.Документы.ПлатежноеПоручениеВходящее);
	МассивВключаемые.Добавить(Метаданные.Документы.НалоговаяНакладная);
	МассивВключаемые.Добавить(Метаданные.Документы.РеализацияТоваровУслуг);
	
	ТабЗнч = НайтиПоСсылкам(МассивИскомых, МассивОбластьПоиска, МассивВключаемые);
	
	ТекстСообщенияСсылокНаОбъект = "";
	
	Для Каждого СтрокаТЗ Из ТабЗнч Цикл
		
		Если СтрокаТЗ.Метаданные <> Метаданные.Документы.ПлатежноеПоручениеВходящее
			И СтрокаТЗ.Метаданные <> Метаданные.Документы.НалоговаяНакладная
			И СтрокаТЗ.Метаданные <> Метаданные.Документы.РеализацияТоваровУслуг Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не СтрокаТЗ.Данные.Проведен Тогда 
			Продолжить;
		КонецЕсли;
		
		ТекстСообщенияСсылокНаОбъект = ТекстСообщенияСсылокНаОбъект + Символы.ПС + СтрокаТЗ.Данные
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТекстСообщенияСсылокНаОбъект
	
КонецФункции 
 
// Функция определяет адрес электронной почты объекта
//
// Параметры
//  Объект - СправочникСсылка, для которого необходимо определить адрес электронной почты
//
Функция ПолучитьСтруктуруАдресаПолучателя(Объект,АдресДляПоиска=Неопределено) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Тип"   , Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтактнаяИнформация.Представление,
	               |	КонтактнаяИнформация.ЗначениеПоУмолчанию,
	               |	КонтактнаяИнформация.Вид
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Объект = &Объект
	               |	И КонтактнаяИнформация.Тип = &Тип";
	Если ЗначениеЗаполнено(АдресДляПоиска) Тогда
		Запрос.Текст = Запрос.Текст + " И КонтактнаяИнформация.Представление ПОДОБНО &Представление";
		Запрос.УстановитьПараметр("Представление", "%"+АдресДляПоиска+"%");
	КонецЕсли; 		   
	               
	
	Адрес = Новый Структура("Адрес,Вид","",Неопределено);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаЗапроса.Индексы.Добавить("ЗначениеПоУмолчанию");
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		СтрокаПоУмолчанию = ТаблицаЗапроса.Найти(Истина, "ЗначениеПоУмолчанию");
		Если СтрокаПоУмолчанию <> Неопределено Тогда
			Адрес.Вставить("Адрес",СтрокаПоУмолчанию.Представление);
			Адрес.Вставить("Вид",СтрокаПоУмолчанию.Вид);
		Иначе
			Адрес.Вставить("Адрес",ТаблицаЗапроса[0].Представление);
			Адрес.Вставить("Вид",ТаблицаЗапроса[0].Вид);
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Адрес;

КонецФункции


Функция ПолучитьСвойствоОбъекта(пОбъект,пИмяСвойства) Экспорт 

	лСвойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(пИмяСвойства);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Объект = &Объект
		|	И ЗначенияСвойствОбъектов.Свойство = &Свойство";

	Запрос.УстановитьПараметр("Объект", пОбъект);
	Запрос.УстановитьПараметр("Свойство", лСвойство);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Значение;
	КонецЦикла;

	Возврат Неопределено;


КонецФункции // ПолучитьСвойствоОбъекта()
 
Функция ПолучитьВсеСвойстваОбъекта(пОбъект) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Значение КАК Значение,
		|	ЗначенияСвойствОбъектов.Свойство
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Объект = &Объект";

	Запрос.УстановитьПараметр("Объект", пОбъект);

	Результат = Запрос.Выполнить().Выбрать();
	лСоот = Новый Соответствие;
	
	Пока Результат.Следующий() Цикл
		лСоот.Вставить(Результат.Свойство.Наименование,Результат.Значение);
	КонецЦикла; 

	Возврат лСоот;

КонецФункции // ПолучитьСвойствоОбъекта()

Процедура УстановитьСвойствоОбъекта(пОбъект,пИмяСвойства,пЗначение) Экспорт 

	пСвойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(пИмяСвойства);
	Если ЗначениеЗаполнено(пСвойство) И ЗначениеЗаполнено(пОбъект) Тогда
	
		НаборЗаписейЗначенияСвойств = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(пОбъект);
		НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(пСвойство);
		УстановитьПривилегированныйРежим(Истина);	
		Если ЗначениеЗаполнено(пЗначение) Тогда
		
			НаборЗаписейЗначенияСвойств.Прочитать();
			
			Если НаборЗаписейЗначенияСвойств.Количество()=1 Тогда
				Запись = НаборЗаписейЗначенияСвойств[0];
				Если Запись.Значение = пЗначение Тогда
					Возврат; // значение не изменилось
				КонецЕсли; 
			Иначе	
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
			КонецЕсли;	
				Запись.Объект   = пОбъект;
				Запись.Свойство = пСвойство;
				Запись.Значение = пЗначение;
		КонецЕсли;	
		
		Попытка
			НаборЗаписейЗначенияСвойств.Записать();
			УстановитьПривилегированныйРежим(Ложь);
		Исключение
			#Если Клиент Тогда
				Предупреждение(НСтр("ru='Не удалось записать значения свойств';uk='Не вдалося записати значення властивостей'") + Символы.ПС + ОписаниеОшибки());
			#КонецЕсли
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры // ПолучитьСвойствоОбъекта()

Функция ПолучитьОрганизациюПоСобственномуКонтрагенту(Знач пКонтрагент,Знач пБУ) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_ВнутренниеКонтрагенты.Организация
		|ИЗ
		|	РегистрСведений.А_ВнутренниеКонтрагенты КАК А_ВнутренниеКонтрагенты
		|ГДЕ
		|	А_ВнутренниеКонтрагенты.Контрагент = &Контрагент
		|	И А_ВнутренниеКонтрагенты.Организация.А_БухгалтерскийУчет = &БУ";
	
	Запрос.УстановитьПараметр("Контрагент", пКонтрагент);
	Запрос.УстановитьПараметр("БУ", пБУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(),Выборка.Организация,Неопределено);

КонецФункции // ПолучитьОрганизациюПоСобственномуКонтрагенту()
 

		|	РегистрСведений.СтатусОтправкиДокументовПоПочте КАК СтатусОтправкиДокументовПоПочте
		|ГДЕ
		|	СтатусОтправкиДокументовПоПочте.ДатаОтправки <= &ДатаТриМесяца";
	
	Запрос.УстановитьПараметр("ДатаТриМесяца", ТекущаяДата() - 24*60*60*90);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МенЗап = РегистрыСведений.СтатусОтправкиДокументовПоПочте.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенЗап, ВыборкаДетальныеЗаписи);
		МенЗап.Прочитать();
		МенЗап.Удалить();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура СоздатьЗадачу(Объект, Параметры = Неопределено) Экспорт
	
	ПользовательОтправкиПоПочте = Справочники.Пользователи.НайтиПоНаименованию("Почтовый пользователь", Истина);
	
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.ЗаказПокупателя") 
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
		
		ЗадачаОб 			= Задачи.ЗадачиПользователя.СоздатьЗадачу();
		ЗадачаОб.Дата 		= ТекущаяДата();
		ЗадачаОб.Объект		= Объект.Ссылка;
		ЗадачаОб.Оповещение = Истина;
		ЗадачаОб.СрокОповещения = ТекущаяДата();
		НужноСоздатьЗадачу 	= Ложь;
		
		Если Объект.БезналичныйРасчет Тогда
			
			НужноСоздатьЗадачу = Ложь;
			
			Менеджеры = Новый Массив;
			Менеджеры.Добавить(Справочники.Пользователи.НайтиПоНаименованию("Петро Давидюк", Истина));
			Менеджеры.Добавить(Справочники.Пользователи.НайтиПоНаименованию("Вовкотруб Мирослава", Истина));
			
			Для Каждого Менеджер из Менеджеры Цикл
				
				ЗадачаМенеджеру 				= Задачи.ЗадачиПользователя.СоздатьЗадачу();
				ЗадачаМенеджеру.Дата 			= ТекущаяДата();
				ЗадачаМенеджеру.Объект			= Объект.Ссылка;
				ЗадачаМенеджеру.Исполнитель		= Менеджер;
				ЗадачаМенеджеру.Оповещение 		= Истина;
				ЗадачаМенеджеру.СрокОповещения 	= ТекущаяДата();
				
				ЗадачаМенеджеру.Наименование 	= "Надійшло нове замовлення № " + Объект.Номер +". від " + Формат(Объект.Дата, "ДЛФ=Д");
				ЗадачаМенеджеру.Описание		= "Надійшло нове замовлення № " + Объект.Номер 
				+ ". від " + Формат(Объект.Дата, "ДЛФ=Д")
				+ ". oder id " + Объект.OrderID;
				
				ЗадачаМенеджеру.Записать();
				
			КонецЦикла;
			
			СписокПолучателей = Новый СписокЗначений;
			стрПараметры = Новый Структура;
			стрПараметры.Вставить("МассПользователей", Менеджеры);
			ЗаполнитьПоФизЛицу(СписокПолучателей, стрПараметры);
			
			СтрПисьма = Новый Структура;
			СтрПисьма.Вставить("ОтправленоФоном", Истина);
			СтрПисьма.Вставить("Тело", ЗадачаМенеджеру.Описание);
			СтрПисьма.Вставить("Тема", "Надійшло нове замовлення");
			СтрПисьма.Вставить("УчетнаяЗапись", Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Автоматична система відправки повідоплень"));
			СтрПисьма.Вставить("Кому", СписокПолучателей);			
			//
			//СтрПисьмо = УправлениеЭлектроннойПочтой.НаписатьПисьмо(ПользовательОтправкиПоПочте, СтрПисьма,,,,,,,Ложь); 
			//СтрПисьмо.Письмо.ОтправитьПисьмо(,ПользовательОтправкиПоПочте);
			
		КонецЕсли;
		
		Если НужноСоздатьЗадачу Тогда
			ЗадачаОб.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


Процедура ОбходнойЛистОтправитьПоПочте(Ссылка,РольИсполнителя) Экспорт
	
	Возврат;
	
		НеобходимоЦФО = Ложь;
		Если РольИсполнителя = Справочники.РолиИсполнителей.обКладовщик Тогда 
			НеобходимоЦФО = Истина;
		КонецЕсли;
	
	
	    ПользовательОтправкиПоПочте = Справочники.Пользователи.НайтиПоНаименованию("Почтовый пользователь", Истина);
		
		СписокПолучателей = Новый СписокЗначений;
		СписокПолучателей.ЗагрузитьЗначения(ПолучитьПользователейПоРолиИЦФО(РольИсполнителя,?(НеобходимоЦФО,Ссылка.Подразделение,Неопределено)));
		
		Если СписокПолучателей.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
				
		ТекстПисьма = "Обхідний лист на звільнення працівника " + Ссылка.Сотрудник +" № "+Ссылка.Номер +" потребує погодження";
				
		СтрПисьма = Новый Структура;
		СтрПисьма.Вставить("Тело", ТекстПисьма);
		СтрПисьма.Вставить("Тема", "Обхідний лист на звільнення працівника " + Ссылка.Сотрудник +" № "+Ссылка.Номер +" потребує погодження");
		СтрПисьма.Вставить("УчетнаяЗапись", Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Автоматична система відправки повідоплень"));
		СтрПисьма.Вставить("Кому", СписокПолучателей);
		
		Если СписокПолучателей.Количество() Тогда 
		СтрПисьмо = УправлениеЭлектроннойПочтой.НаписатьПисьмо(ПользовательОтправкиПоПочте, СтрПисьма,,,,,,,Ложь); 
		СтрПисьмо.Письмо.ОтправитьПисьмо(,ПользовательОтправкиПоПочте);
		КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьПользователейПоРолиИЦФО(РольИсполнителя,ЦФО)
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсполнителиЗадач.Исполнитель,
	               |	КонтактнаяИнформация.Представление
	               |ИЗ
	               |	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |		ПО ИсполнителиЗадач.Исполнитель = КонтактнаяИнформация.Объект
	               |			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.Служебныйадресэлектроннойпочтыпользователя))
	               |ГДЕ
	               |	ИсполнителиЗадач.РольИсполнителя = &РольИсполнителя
	               |	И ИсполнителиЗадач.ОсновнойОбъектАдресации = &ОсновнойОбъектАдресации
	               |	И (ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(100))) <> """"";
	Запрос.УстановитьПараметр("РольИсполнителя",РольИсполнителя);
	Запрос.УстановитьПараметр("ОсновнойОбъектАдресации",ЦФО);
	
	Возврат запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Представление");
	
КонецФункции

Процедура ОтправитьПисьмаРассылку() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусОтправкиДокументовПоПочте.ОбъектОтправки КАК Документ,
		|	СтатусОтправкиДокументовПоПочте.ДатаОтправки,
		|	СтатусОтправкиДокументовПоПочте.Статус
		|ИЗ
		|	РегистрСведений.СтатусОтправкиДокументовПоПочте КАК СтатусОтправкиДокументовПоПочте
		|ГДЕ
		|	СтатусОтправкиДокументовПоПочте.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправкиДокументовПоПочте.КОтправке)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		стрДанные = Новый Структура;
		
		Если ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ВводВЭксплуатациюОС") Тогда
			
			стрДанные.Вставить("Документ", "ВводВЭксплуатациюОС");
			стрДанные.Вставить("ВводВЭксплуатациюОС", ВыборкаДетальныеЗаписи.Документ);
			
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеСредств") Тогда
			
			стрДанные.Вставить("Документ", "Заявка");
			стрДанные.Вставить("Заявка", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			
			стрДанные.Вставить("Документ", "Перемещение");
			стрДанные.Вставить("Перемещение", ВыборкаДетальныеЗаписи.Документ);
			
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			
			стрДанные.Вставить("Документ", "Поступление");
			стрДанные.Вставить("Поступление", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
			
			стрДанные.Вставить("Документ", "Приходный");
			стрДанные.Вставить("Приходный", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.Сервис") Тогда
			
			стрДанные.Вставить("Документ", "Сервис");
			стрДанные.Вставить("Сервис", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ПередачаМалоценкиВЭксплуатацию") Тогда
			
			стрДанные.Вставить("Документ", "ПередачаМНМА");
			стрДанные.Вставить("ПередачаМНМА", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ТабельУчетаРабочегоВремениУправленческий") Тогда
			
			стрДанные.Вставить("Документ", "ТабельУПР");
			стрДанные.Вставить("ТабельУПР", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ЗадачаСсылка.ЗадачиПользователя") Тогда
			
			стрДанные.Вставить("Документ", "ЗадачаПользователя");
			стрДанные.Вставить("ЗадачаПользователя", ВыборкаДетальныеЗаписи.Документ);
			
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ЧекККМ") Тогда
			
			стрДанные.Вставить("Документ", "ЧекККМ");
			стрДанные.Вставить("ЧекККМ", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда
			
			стрДанные.Вставить("Документ", "ВозвратТоваровОтПокупателя");
			стрДанные.Вставить("ВозвратТоваровОтПокупателя", ВыборкаДетальныеЗаписи.Документ);
			
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Документ) = Тип("ДокументСсылка.ВозвратПоТребованииНакладной") Тогда
			
			стрДанные.Вставить("Документ", "ВозвратПоТребованииНакладной");
			стрДанные.Вставить("ВозвратПоТребованииНакладной", ВыборкаДетальныеЗаписи.Документ);
			
		КонецЕсли;
		
		А_ОбщегоНазначенияСервер.ОтправитьПоПочте(стрДанные);
		А_ОбщегоНазначенияСервер.УстановитьСтатусОтправкиПоПочте(ВыборкаДетальныеЗаписи.Документ, Перечисления.СтатусыОтправкиДокументовПоПочте.ОтправленПоПочте);
		
	КонецЦикла;	
	
	Если ДеньНедели(ТекущаяДата()) = 6 Тогда //по субботам чистим старые записи
		
		ОчиститьСтарыеЗаписи();
		
	КонецЕсли;

КонецПроцедуры


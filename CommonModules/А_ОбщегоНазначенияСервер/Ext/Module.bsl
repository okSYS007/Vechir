		ТабДок 	= Новый ТабличныйДокумент;
		Макет	= ПолучитьОбщийМакет("МакетРассылка");
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ТабДок.Вывести(ОбластьМакета);
				
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьДокументОснование");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ТабДок.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьПодразделение");

			|ИЗ
			|	Документ.ВозвратПоТребованииНакладной.МатериалыЗаказчика КАК ВозвратПоТребованииНакладнойМатериалыЗаказчика
			|ГДЕ
			|	ВозвратПоТребованииНакладнойМатериалыЗаказчика.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", Док);
			
			МатериалыЗаказчика = Запрос.Выполнить().Выбрать();
			
			ОбластьМакета = Макет.ПолучитьОбласть("ТоварыШапка");
			ТабДок.Вывести(ОбластьМакета);
			
			сч = 1;
			Пока МатериалыЗаказчика.Следующий() Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ТоварыСтрока");
				ОбластьМакета.Параметры.Заполнить(МатериалыЗаказчика);
				ОбластьМакета.Параметры.НомерПП = сч;
				ТабДок.Вывести(ОбластьМакета);
				сч = сч + 1;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПутьСохранения = КаталогВременныхФайлов() + НазваниеДока + "_" + Док.Номер + "_"+ СтрЗаменить(Формат(Док.Дата, "ДЛФ=Д"), ".", "_") + ".xls";
	ТабДок.Записать(ПутьСохранения, ТипФайлаТабличногоДокумента.XLS);
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьСохранения);
	Возврат ДвоичныеДанные;
		
КонецФункции


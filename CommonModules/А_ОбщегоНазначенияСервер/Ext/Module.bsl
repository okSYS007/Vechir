		|	ВозвратПоТребованииНакладной.Контрагент КАК Контрагент,
		|	ВозвратПоТребованииНакладной.Ответственный КАК Ответственный,
		|	ВозвратПоТребованииНакладной.Подразделение КАК Подразделение,
		|	ВозвратПоТребованииНакладной.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.ВозвратПоТребованииНакладной КАК ВозвратПоТребованииНакладной
		|ГДЕ
		|	ВозвратПоТребованииНакладной.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Док);
		
		Шапка = Запрос.Выполнить().Выбрать();
		Шапка.Следующий();
		
		ТабДок 	= Новый ТабличныйДокумент;
		Макет	= ПолучитьОбщийМакет("МакетРассылка");
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ТабДок.Вывести(ОбластьМакета);
				
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьДокументОснование");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ТабДок.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьПодразделение");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ТабДок.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьКонтрагент");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ТабДок.Вывести(ОбластьМакета);
				
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьОтветственный");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ТабДок.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьПробел");
		ТабДок.Вывести(ОбластьМакета);
		
		Если Док.Материалы.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВозвратПоТребованииНакладнойМатериалы.ЕдиницаИзмерения КАК ЕдИзм,
			|	ВозвратПоТребованииНакладнойМатериалы.Количество КАК Количество,
			|	ВозвратПоТребованииНакладнойМатериалы.Номенклатура КАК Товар,
			|	ВозвратПоТребованииНакладнойМатериалы.СерияНоменклатуры КАК Серия,
			|	ВозвратПоТребованииНакладнойМатериалы.Номенклатура.Артикул КАК Артикул
			|ИЗ
			|	Документ.ВозвратПоТребованииНакладной.Материалы КАК ВозвратПоТребованииНакладнойМатериалы
			|ГДЕ
			|	ВозвратПоТребованииНакладнойМатериалы.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", Док);
			
			Материалы = Запрос.Выполнить().Выбрать();
			
			ОбластьМакета = Макет.ПолучитьОбласть("ТоварыШапка");
			ТабДок.Вывести(ОбластьМакета);
			
			сч = 1;
			Пока Материалы.Следующий() Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ТоварыСтрока");
				ОбластьМакета.Параметры.Заполнить(Материалы);
				ОбластьМакета.Параметры.НомерПП = сч;
				ТабДок.Вывести(ОбластьМакета);
				сч = сч + 1;
			КонецЦикла;
			
		КонецЕсли;
		
		Если Док.МатериалыЗаказчика.Количество() > 0 Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("ОбластьПробел");
			ТабДок.Вывести(ОбластьМакета);

			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВозвратПоТребованииНакладнойМатериалыЗаказчика.Количество,
			|	ВозвратПоТребованииНакладнойМатериалыЗаказчика.Номенклатура КАК Товар,

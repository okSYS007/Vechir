			|	ВозвратТоваровОтПокупателяТовары.СерияНоменклатуры КАК Серия,
			|	ВозвратТоваровОтПокупателяТовары.Номенклатура.Артикул КАК Артикул
			|ИЗ
			|	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
			|ГДЕ
			|	ВозвратТоваровОтПокупателяТовары.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", Док);
			
			Товары = Запрос.Выполнить().Выбрать();
			
			ОбластьМакета = Макет.ПолучитьОбласть("ТоварыШапка");
			ТабДок.Вывести(ОбластьМакета);
			
			сч = 1;
			Пока Товары.Следующий() Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ТоварыСтрока");
				ОбластьМакета.Параметры.Заполнить(Товары);
				ОбластьМакета.Параметры.НомерПП = сч;
				ТабДок.Вывести(ОбластьМакета);
				сч = сч + 1;
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратПоТребованииНакладной") Тогда
		
		НазваниеДока = "Повернення за вимогою накладної";

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ

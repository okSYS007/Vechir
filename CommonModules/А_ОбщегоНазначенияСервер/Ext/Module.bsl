Функция ПолучитьСвязанныйДокумент(пИзначальныйДокумент) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СвязанныеВнутренниеДокументы.СвязанныйДокумент
		|ИЗ
		|	РегистрСведений.А_СвязанныеВнутренниеДокументы КАК А_СвязанныеВнутренниеДокументы
		|ГДЕ
		|	А_СвязанныеВнутренниеДокументы.ИзначальныйДокумент = &ИзначальныйДокумент";
	
	Запрос.УстановитьПараметр("ИзначальныйДокумент", пИзначальныйДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(),Выборка.СвязанныйДокумент,Неопределено);

КонецФункции // ПолучитьСвязанныйДокумент()

Процедура УстановитьСвязанныйДокумент(пИзначальныйДокумент,пСвязанныйДокумент) Экспорт 

	лРС = РегистрыСведений.А_СвязанныеВнутренниеДокументы.СоздатьМенеджерЗаписи();
	лРС.ИзначальныйДокумент = пИзначальныйДокумент;
	лРС.Прочитать();
	лРС.ИзначальныйДокумент = пИзначальныйДокумент;
	лРС.СвязанныйДокумент = пСвязанныйДокумент;
	лРС.Записать();

КонецПроцедуры
 
Функция ПолучитьИзначальныйДокументИзСвязанного(пДокумент) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СвязанныеВнутренниеДокументы.ИзначальныйДокумент
		|ИЗ
		|	РегистрСведений.А_СвязанныеВнутренниеДокументы КАК А_СвязанныеВнутренниеДокументы
		|ГДЕ
		|	А_СвязанныеВнутренниеДокументы.СвязанныйДокумент = &СвязанныйДокумент";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", пДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(),Выборка.ИзначальныйДокумент,Неопределено);


Функция СоздатьФайлЕксель(Док, ПутьСохранения = Неопределено)
	
	НазваниеДока = "";
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		НазваниеДока = "Прибутковий";
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходныйОрдерНаТовары.Номер КАК НомерДокумента,
		|	ПриходныйОрдерНаТовары.Дата КАК ДатаДокумента,
		|	ПриходныйОрдерНаТовары.Организация КАК Организация
		|ИЗ
		|	Документ.ПриходныйОрдерНаТовары КАК ПриходныйОрдерНаТовары
		|ГДЕ
		|	ПриходныйОрдерНаТовары.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Док);
		
		Шапка = Запрос.Выполнить().Выбрать();
		Шапка.Следующий();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходныйОрдерНаТоварыТовары.Номенклатура.Артикул КАК Артикул,
		|	ПриходныйОрдерНаТоварыТовары.Номенклатура КАК Товар,
		|	ПриходныйОрдерНаТоварыТовары.ЕдиницаИзмерения КАК ЕдИзм,
		|	ПриходныйОрдерНаТоварыТовары.СерияНоменклатуры КАК Серия,
		|	ПриходныйОрдерНаТоварыТовары.Количество КАК Количество
		|ИЗ
		|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
		|ГДЕ

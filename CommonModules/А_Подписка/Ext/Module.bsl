Функция ПолучитьПодразделениеСотрудника(Сотрудник)
	Подразделение = Справочники.Подразделения.ПустаяСсылка();
	
	МассФизЛиц = Новый Массив;
	МассФизЛиц.Добавить(Сотрудник);
	
	СоответствиеФизЛиц = Новый Соответствие;
		СоответствиеФизЛиц.Вставить(Сотрудник);
		Справочники.ФизическиеЛица.ЗаполнитьДанныеПоФизЛицу(МассФизЛиц, СоответствиеФизЛиц);
		Если ЗначениеЗаполнено(СоответствиеФизЛиц[Сотрудник]) Тогда
			Организация 	= СоответствиеФизЛиц[Сотрудник].Организация;
			Подразделение 	= СоответствиеФизЛиц[Сотрудник].Подразделение;
		КонецЕсли;

	Возврат Подразделение;
КонецФункции


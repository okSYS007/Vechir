Процедура А_ОбработкаУдаленияПроведенияДокументовОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат
	КонецЕсли;
	
	ТипИсточника = ТипЗнч(Источник);
	МетаданныеИсточника = Источник.Метаданные();
	
	ДанныеУУ = А_ОбщегоНазначения.ПолучитьСвязанныйДокументУУ(Источник.ссылка);
	Если Не ДанныеУУ.Заблокирован Тогда	
		Если ДанныеУУ.ДокументУУ <> Неопределено Тогда 
			Об = ДанныеУУ.ДокументУУ.ПолучитьОбъект();
			Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура А_ПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	ДанныеУУ = А_ОбщегоНазначения.ПолучитьСвязанныйДокументУУ(Источник.ссылка);
	
	Если Не ДанныеУУ.Заблокирован Тогда	
		Если ДанныеУУ.ДокументУУ <> Неопределено и ДанныеУУ.ДокументУУ.ПометкаУдаления<>Источник.ПометкаУдаления Тогда 
			Об = ДанныеУУ.ДокументУУ.ПолучитьОбъект();
			Об.ПометкаУдаления = Источник.ПометкаУдаления; 
			Об.Записать();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры



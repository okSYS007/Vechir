Процедура СформироватьДокументУУ(Источник, МетаданныеИсточника, ТипИсточника, Отказ, РежимПроведения) Экспорт 
	
	// А_Вячеслав(20.11.2018 не создаем УУ документ для зеркального ПТУ , созданного из РТУ
	Если МетаданныеИсточника.Имя = "ПоступлениеТоваровУслуг" Тогда
		Если Источник.ДополнительныеСвойства.Свойство("А_ЭтоЗеркальныйРТУДокумент") Тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(А_ОбщегоНазначенияСервер.ПолучитьИзначальныйДокументИзСвязанного(Источник.Ссылка)) Тогда
			Возврат;
		КонецЕсли; 
	ИначеЕсли МетаданныеИсточника.Имя = "РеализацияТоваровУслуг"  Тогда 
		
		Если Найти(Источник.Комментарий,"#Создано автоматический по документу в Ренг учете")<>0 Тогда 
			Возврат;	
		КонецЕсли;
		
		////Дандали В. 14.05.2025 +
		//Если Найти(Источник.Комментарий, "#Создано автоматический при проведении чека") <> 0 
		//	И ЗначениеЗаполнено(Источник.сделка) 
		//	И Источник.сделка.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("e818acc3-d3f3-11e5-84b2-005056875f16")) //ФОП ШЕВЧУК Оксана
		//	Тогда
		//	Возврат;
		//КонецЕсли;
		////Дандали В. 14.05.2025 -
		
		
	КонецЕсли;
	// А_Вячеслав) 
	ОбъектМетаданныхХозрасчетный = Метаданные.РегистрыБухгалтерии.Хозрасчетный;
	
	ЕстьПризнакОтражатьВУправленческомУчете = МетаданныеИсточника.Реквизиты.Найти("ОтражатьВУправленческомУчете") <> Неопределено;
	ЕстьПризнакОтражатьВУпрУчете = МетаданныеИсточника.Реквизиты.Найти("ОтражатьВУпрУчете") <> Неопределено;
	
	МассивДругихДокументов = Новый Массив;
	МассивДругихДокументов.Добавить(Метаданные.Документы.ПриемНаРаботуВОрганизацию);
	МассивДругихДокументов.Добавить(Метаданные.Документы.КадровоеПеремещениеОрганизаций);
	МассивДругихДокументов.Добавить(Метаданные.Документы.УвольнениеИзОрганизаций);
	МассивДругихДокументов.Добавить(Метаданные.Документы.ОперацияБух);
	МассивДругихДокументов.Добавить(Метаданные.Документы.КорректировкаЗаписейРегистров);
	МассивДругихДокументов.Добавить(Метаданные.Документы.РегистрацияВходящегоНалоговогоДокумента);
	МассивДругихДокументов.Добавить(Метаданные.Документы.НалоговаяНакладная);

	
	ЭтоДругойДокумент = МассивДругихДокументов.Найти(МетаданныеИсточника) <> Неопределено;	
	
	Если ((МетаданныеИсточника.Движения.Содержит(ОбъектМетаданныхХозрасчетный)	 
		//И ((ЕстьПризнакОтражатьВУправленческомУчете И Источник.ОтражатьВУправленческомУчете) Или (ЕстьПризнакОтражатьВУпрУчете И Источник.ОтражатьВУпрУчете)) 
		Или ЭтоДругойДокумент)
		И ?(ТипЗнч(Источник) = тип("ДокументОбъект.КорректировкаЗаписейРегистров"),Истина,Источник.Организация.А_БухгалтерскийУчет)) Тогда
		
		
		Если ТипЗнч(Источник) = тип("ДокументОбъект.КорректировкаЗаписейРегистров") Тогда 
			НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.регистратор.установить(Источник.ссылка);
			НаборЗаписей.Прочитать();
			ОрганизацияБУ = НаборЗаписей[0].Организация;
		Иначе
			ОрганизацияБУ = Источник.Организация;
		КонецЕсли;

		
		ДокументБУ = Источник.Ссылка;
		
		//Ищем соответствие УУ организацию
		ОрганизацияУУ = А_ОбщегоНазначения.ПолучитьОрганизациюУУ(ОрганизацияБУ);
		
		Если Не ЗначениеЗаполнено(ОрганизацияУУ) Тогда
			Сообщить("Не найдено соответствие организация УУ"); 
			Возврат
		КонецЕсли;
		
		
		Набор = РегистрыСведений.ГраницыЗапретаИзмененияДанных.СоздатьНаборЗаписей();
        Набор.Отбор.Организация.Установить(ОрганизацияУУ);
		Набор.Прочитать();
		
		Если Не Набор.Количество() = 0 Тогда 
			Для Каждого Строка из Набор Цикл 
				//Если ЗначениеЗаполнено(Строка.ГраницаЗапретаИзменений) И Строка.ГраницаЗапретаИзменений > Источник.Дата Тогда 
				//	Сообщить("Для организации УУ редактирование данных этого периода запрещено. Изменения не могут быть записаны...");
				//	Возврат;
				//КонецЕсли;
			КонецЦикла;
		КонецЕсли;
				
		
		//Ищем существующий документ
		ДанныеУУ = А_ОбщегоНазначения.ПолучитьСвязанныйДокументУУ(ДокументБУ);
		
		Если ЭтоДругойДокумент Тогда
			
			//Если ДанныеУУ.ДокументУУ = Неопределено Тогда 
			//
			//	#Если Клиент Тогда
			//		Если Вопрос("Продублировать данный документ по упр. учету?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да  Тогда 
			//			Возврат
			//		КонецЕсли;			
			//	#Иначе
			//		Возврат
			//	#КонецЕсли
			//	
			//КонецЕсли; 
			
		КонецЕсли;
		
		Если ДанныеУУ.ДокументУУ = Неопределено 
			или не ЗначениеЗаполнено(ДанныеУУ.ДокументУУ) Тогда 
			
			ДокументОбъектУУ             = Источник.Скопировать();
			Если не ТипЗнч(Источник) = тип("ДокументОбъект.КорректировкаЗаписейРегистров") Тогда 
				ДокументОбъектУУ.Организация = ОрганизацияУУ;
			КонецЕсли;
			ДокументОбъектУУ.Дата        = Источник.Дата;
			
			Если  МетаданныеИсточника.Имя = "АктОбОказанииПроизводственныхУслуг"
				Или МетаданныеИсточника.Имя = "ВозвратТоваровПоставщикуИзНТТ"
				Или МетаданныеИсточника.Имя = "КомплектацияНоменклатуры"
				Или МетаданныеИсточника.Имя = "КорректировкаДолгаПоВозвратнойТаре"
				Или МетаданныеИсточника.Имя = "КорректировкаКачестваТоваров"
				Или МетаданныеИсточника.Имя = "КорректировкаСерийИХарактеристикТоваров"
				Или МетаданныеИсточника.Имя = "ОтчетКомитентуОПродажах"
				Или МетаданныеИсточника.Имя = "ПереоценкаТоваровВРознице"
				Или МетаданныеИсточника.Имя = "ПоступлениеДопРасходов"
				Или МетаданныеИсточника.Имя = "ПоступлениеТоваровУслугВНТТ" Тогда
				
				ДокументОбъектУУ.мУчетнаяПолитикаБУ = ОбщегоНазначения.ПолучитьПараметрыУчетнойПолитики(ДокументОбъектУУ.Дата, Ложь, ДокументОбъектУУ.Организация, "Бух", Ложь);
				ДокументОбъектУУ.мУчетнаяПолитикаНУ = ОбщегоНазначения.ПолучитьПараметрыУчетнойПолитики(ДокументОбъектУУ.Дата, Ложь, ДокументОбъектУУ.Организация, "Нал", Ложь)
				
			КонецЕсли;
			
		Иначе 
			
			//Проверка на блокировку документа. Если не заблокирован - перезаполянем
			Если Не ДанныеУУ.Заблокирован Тогда 
				
				ДокументОбъектУУ = ДанныеУУ.ДокументУУ.ПолучитьОбъект();
				
				Попытка
					ЗаполнитьЗначенияСвойств(ДокументОбъектУУ, Источник,, "Номер,Организация,Проведен");
				Исключение
					ЗаполнитьЗначенияСвойств(ДокументОбъектУУ, Источник,, "Номер,Проведен");
				КонецПопытки;
				
				Для Каждого ТабЧасть Из Источник.Метаданные().ТабличныеЧасти Цикл
					ДокументОбъектУУ[ТабЧасть.Имя].Загрузить(Источник[ТабЧасть.Имя].Выгрузить());
				КонецЦикла;
				
			Иначе
				
				Возврат
				
			КонецЕсли;
			
		КонецЕсли;
		МетаданныеДокумента          = ДокументОбъектУУ.Метаданные();

		Если ЭтоДругойДокумент Тогда 
						Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОтражатьВУпрУчете",МетаданныеДокумента) Тогда 
				ДокументОбъектУУ.ОтражатьВУпрУчете	= ПроцедурыУправленияПерсоналом.ЗначениеУчетнойПолитикиПоПерсоналуОрганизации(глЗначениеПеременной("глУчетнаяПолитикаПоПерсоналуОрганизации"), ОрганизацияУУ, "ОтражатьВУпрУчете");
			КонецЕсли;
			
			Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОтражатьВРеглУчете",МетаданныеДокумента) Тогда 
				ДокументОбъектУУ.ОтражатьВРеглУчете	= ПроцедурыУправленияПерсоналом.ЗначениеУчетнойПолитикиПоПерсоналуОрганизации(глЗначениеПеременной("глУчетнаяПолитикаПоПерсоналуОрганизации"), ОрганизацияУУ, "ОтражатьВРеглУчете");
			КонецЕсли;
			
			Если МетаданныеИсточника = Метаданные.Документы.УвольнениеИзОрганизаций Тогда 
				
				Для Каждого СтрокаТЧ Из ДокументОбъектУУ.РаботникиОрганизации Цикл
					СтрокаТЧ.УвольнятьВУпрУчете = Истина
				КонецЦикла; 
				
			КонецЕсли;
				
		КонецЕсли;
		
		//Заполнение счетов учета
		А_ОбщегоНазначения.ЗаполнитьСчетаУчета(ДокументОбъектУУ, Источник, МетаданныеИсточника);
		
		//Заполнение связанные реквизиты
		А_ОбщегоНазначения.ЗаполнитьСвязанныеРеквизиты(ДокументОбъектУУ, Источник, МетаданныеИсточника);
		
		//Выполнение трансляции документов
		А_ОбщегоНазначения.ВыполнитьТрансляциюДокументов(ДокументОбъектУУ, Источник, МетаданныеИсточника);
		
		//Для механизма учета НДС перезаполним счета с РС "Счета учена расчета с контрагентами"
		А_ОбщегоНазначения.ПерезаполнитьСчетаУчетаНДСПоРегиструУчета(МетаданныеИсточника, ДокументОбъектУУ);		
		
		Попытка
			Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОтражатьВУправленческомУчете",МетаданныеДокумента) Тогда
				ДокументОбъектУУ.ОтражатьВУправленческомУчете = Ложь;
			КонецЕсли;
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;

		Если ТипЗнч(ДокументОбъектУУ) = тип("ДокументОбъект.ОперацияБух")
			или ТипЗнч(ДокументОбъектУУ) = тип("ДокументОбъект.КорректировкаЗаписейРегистров") Тогда 
			
			Для Каждого ЗаписьОперации из ДокументОбъектУУ.Движения.Хозрасчетный цикл
				ЗаписьОперации.Период = ДокументОбъектУУ.Дата;
			КонецЦикла;
			
		КонецЕсли;
		
		
		Если ТипЗнч(Источник) = тип("ДокументОбъект.ПриходныйКассовыйОрдер") или   
			ТипЗнч(Источник)  = тип("ДокументСсылка.ПриходныйКассовыйОрдер") или
			ТипЗнч(Источник)  = тип("ДокументОбъект.РасходныйКассовыйОрдер") или
			ТипЗнч(Источник)  = тип("ДокументСсылка.РасходныйКассовыйОрдер")  Тогда 
			
			Если ЗначениеЗаполнено(Источник.КассаУпр) Тогда 
				ДокументОбъектУУ.Касса = Источник.КассаУпр;
				ДокументОбъектУУ.ОтражатьВУправленческомУчете = Истина
			КонецЕсли;
			
		КонецЕсли;
			
			
		
		
		Попытка
			ДокументОбъектУУ.Записать(РежимЗаписиДокумента.Запись) ;
			Если не ТипЗнч(ДокументОбъектУУ) = тип("ДокументОбъект.ОперацияБух")
				и не ТипЗнч(ДокументОбъектУУ) = тип("ДокументОбъект.КорректировкаЗаписейРегистров") Тогда 
				ДокументОбъектУУ.обменДанными.Загрузка = истина;
				ДокументОбъектУУ.Проведен = истина;
				ДокументОбъектУУ.Записать() ;
			КонецЕсли;
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
		Попытка
			Если ТипЗнч(Источник) = тип("ДокументОбъект.ПриходныйКассовыйОрдер") или   
				ТипЗнч(Источник)  = тип("ДокументСсылка.ПриходныйКассовыйОрдер") или
				ТипЗнч(Источник)  = тип("ДокументОбъект.РасходныйКассовыйОрдер") или
				ТипЗнч(Источник)  = тип("ДокументСсылка.РасходныйКассовыйОрдер")  Тогда 
				Если Источник.ВидОперации = Перечисления.ВидыОперацийРКО.ВыплатаЗаработнойПлатыПоВедомостям Тогда
					ДокументОбъектУУ.обменДанными.Загрузка = Истина;
				ДокументОбъектУУ.Проведен = истина;
				ДокументОбъектУУ.Записать() ;
					Иначе
				ДокументОбъектУУ.обменДанными.Загрузка = Ложь;
				ДокументОбъектУУ.Проведен = истина;
				ДокументОбъектУУ.Записать(РежимЗаписиДокумента.Проведение) ;
				КонецЕсли;
			КонецЕсли;
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;

		
		
		// Копируем проводки 1 в 1
		
		
		НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.регистратор.установить(Источник.Ссылка);
		НаборЗаписей.Прочитать();
		
		
		Если НаборЗаписей.Количество() Тогда 
			НаборЗаписейПриемник = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
			НаборЗаписейПриемник.Отбор.регистратор.установить(ДокументОбъектУУ.ссылка);
			НаборЗаписейПриемник.Прочитать();
			НаборЗаписейПриемник.Очистить();
			
			НаборЗаписейПриемник.Загрузить(НаборЗаписей.Выгрузить());
			НаборЗаписейПриемник.Отбор.регистратор.установить(ДокументОбъектУУ.ссылка);
			Для Каждого Запись из НаборЗаписейПриемник цикл
				Запись.Период      = Источник.дата; 
				Запись.Регистратор = ДокументОбъектУУ.ссылка; 
				Запись.Организация = ОрганизацияУУ;	
				
				
				Если ТипЗнч(Источник) = тип("ДокументОбъект.ПриходныйКассовыйОрдер") или   
					ТипЗнч(Источник)  = тип("ДокументСсылка.ПриходныйКассовыйОрдер") или
					ТипЗнч(Источник)  = тип("ДокументОбъект.РасходныйКассовыйОрдер") или
					ТипЗнч(Источник)  = тип("ДокументСсылка.РасходныйКассовыйОрдер")  Тогда 
					
					Если ЗначениеЗаполнено(Источник.КассаУпр) Тогда 
						
						Если Запись.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("301") Тогда 
							
							ОбщегоНазначения.УстановитьСубконто(Запись.СчетДт, Запись.СубконтоДт, "ОбособленныеПодразделенияБезОбразованияЮрЛица", Источник.КассаУпр.ОбособленноеПодразделение);	
							
						КонецЕсли;
						
						Если Запись.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("301") Тогда 
							
							ОбщегоНазначения.УстановитьСубконто(Запись.СчетКт, Запись.СубконтоКт, "ОбособленныеПодразделенияБезОбразованияЮрЛица", Источник.КассаУпр.ОбособленноеПодразделение);
							
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
				
				
				Если ТипЗнч(Источник) = тип("ДокументОбъект.НачислениеЗарплатыРаботникамОрганизаций") или   
					ТипЗнч(Источник)  = тип("ДокументСсылка.НачислениеЗарплатыРаботникамОрганизаций")   Тогда 
					
				 
						
					Если Запись.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("661") 
						или Запись.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("663") 
						или Запись.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("903") Тогда 
							
							ПрдразделениеСотрудника = ПолучитьПодразделениеСотрудника(Запись.СубконтоДт.РаботникиОрганизаций);

							
							ОбщегоНазначения.УстановитьСубконто(Запись.СчетДт, Запись.СубконтоДт, "вчПодразделения", ПрдразделениеСотрудника);	
							ОбщегоНазначения.УстановитьСубконто(Запись.СчетДт, Запись.СубконтоДт, "Проекты", ?(ЗначениеЗаполнено(ПрдразделениеСотрудника),ПрдразделениеСотрудника.Проект,Справочники.Проекты.ПустаяСсылка()));	
						
						КонецЕсли;
						
						Если Запись.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("661")
							или Запись.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("663")
							или Запись.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("903") Тогда 
							
							
							ПрдразделениеСотрудника = ПолучитьПодразделениеСотрудника(Запись.СубконтоКт.РаботникиОрганизаций);

							
							ОбщегоНазначения.УстановитьСубконто(Запись.СчетКт, Запись.СубконтоКт, "вчПодразделения", ПрдразделениеСотрудника);
							ОбщегоНазначения.УстановитьСубконто(Запись.СчетКт, Запись.СубконтоКт, "Проекты", ?(ЗначениеЗаполнено(ПрдразделениеСотрудника),ПрдразделениеСотрудника.Проект,Справочники.Проекты.ПустаяСсылка()));
							
						КонецЕсли;
						
					
				КонецЕсли;

				
			КонецЦикла;
			
			
			
			
			
			НаборЗаписейПриемник.Записать();
		КонецЕсли;
		
		
		Если ДанныеУУ.ДокументУУ = Неопределено
			или не ЗначениеЗаполнено(ДанныеУУ.ДокументУУ) Тогда
			
			ДокументУУ = ДокументОбъектУУ.Ссылка;
			
			//Добавляем документы в соответсвие
			А_ОбщегоНазначения.ЗаписатьСоответствиеДокументов_БУ_УУ(ДокументБУ, ДокументУУ, Ложь)
			
		КонецЕсли;
		
		Если ТипЗнч(Источник) = тип("ДокументОбъект.ПриходныйКассовыйОрдер") или   
					ТипЗнч(Источник)  = тип("ДокументСсылка.ПриходныйКассовыйОрдер") или
					ТипЗнч(Источник)  = тип("ДокументОбъект.РасходныйКассовыйОрдер") или
					ТипЗнч(Источник)  = тип("ДокументСсылка.РасходныйКассовыйОрдер") или  
					
					ТипЗнч(Источник)  = тип("ДокументОбъект.ПлатежноеПоручениеВходящее") или   
					ТипЗнч(Источник)  = тип("ДокументСсылка.ПлатежноеПоручениеВходящее") или
					ТипЗнч(Источник)  = тип("ДокументОбъект.ПлатежноеПоручениеИсходящее") или
					ТипЗнч(Источник)  = тип("ДокументСсылка.ПлатежноеПоручениеИсходящее")   Тогда
					ЗаполнитьАналитику(Источник);			
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник) = тип("ДокументОбъект.УпрРасходныйКассовыйОрдер")
		или ТипЗнч(Источник) = тип("ДокументОбъект.УпрПриходныйКассовыйОрдер") Тогда 
		ЗаполнитьАналитику(Источник);
	КонецЕсли;
	
КонецПроцедуры


Процедура ЗаполнитьСубконтоПартия(Источник, МетаданныеИсточника, Партия)
	
	Если Не Источник.Организация.А_УправленческийУчет Тогда
		Возврат
	КонецЕсли;
	
	МассивНужныхСчетов = Новый Массив;
	МассивНужныхСчетов.Добавить(ПланыСчетов.Хозрасчетный.НалоговыеОбязательства);
	МассивНужныхСчетов.Добавить(ПланыСчетов.Хозрасчетный.НалоговыеОбязательстваНеподтвержденные);
	МассивНужныхСчетов.Добавить(ПланыСчетов.Хозрасчетный.НалоговыйКредит);
	МассивНужныхСчетов.Добавить(ПланыСчетов.Хозрасчетный.НалоговыйКредитНеподтвержденный);
	
	Для Каждого СтрокаХозрасчетный Из Источник.Движения.Хозрасчетный Цикл
			
		Если МассивНужныхСчетов.Найти(СтрокаХозрасчетный.СчетДт) <> Неопределено Тогда
			ОбщегоНазначения.УстановитьСубконто(СтрокаХозрасчетный.СчетДт, СтрокаХозрасчетный.СубконтоДт, "Партии", Партия);
		КонецЕсли;
		
		Если МассивНужныхСчетов.Найти(СтрокаХозрасчетный.СчетКт) <> Неопределено Тогда
			ОбщегоНазначения.УстановитьСубконто(СтрокаХозрасчетный.СчетКт, СтрокаХозрасчетный.СубконтоКт, "Партии", Партия);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРежимТрансляции(Организация, дата)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	А_НастройкиРежимовТрансляцииСрезПоследних.Режим
	               |ИЗ
	               |	РегистрСведений.А_НастройкиРежимовТрансляции.СрезПоследних(&Период, Организация = &Организация) КАК А_НастройкиРежимовТрансляцииСрезПоследних";
	Запрос.УстановитьПараметр("Период",Дата);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Возврат РезультатЗапроса[0].Режим;
	КонецЕсли;
	
	Возврат Перечисления.А_РежимыТрансляции.Отложенный;
КонецФункции


Процедура ЗаполнитьАналитику(ДокВходящий)
	Попытка
	ДокументВходящий = ДокВходящий.ссылка;
	Если ЗначениеЗаполнено(А_ОбщегоНазначения.ПолучитьСвязанныйДокументУУ(ДокументВходящий).ДокументУУ) Тогда 
				Документ = А_ОбщегоНазначения.ПолучитьСвязанныйДокументУУ(ДокументВходящий).ДокументУУ;
			Иначе
				Документ = ДокументВходящий;
			КонецЕсли;
			
			//Источник = Строка.Документ.ПолучитьОбъект();
			
			НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.регистратор.Установить(Документ);			
			НаборЗаписей.Прочитать();
			Индекс = 0;
			Для Каждого Запись из НаборЗаписей Цикл
				
				
				Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("Подразделение",Документ.Метаданные(),"РасшифровкаПлатежа") Тогда 
					Попытка
						Если ЗначениеЗаполнено(Документ.РасшифровкаПлатежа[Индекс].Подразделение) Тогда 
							Запись.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.вчПодразделения]  = Документ.РасшифровкаПлатежа[Индекс].Подразделение;	
							Запись.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.вчПодразделения]  = Документ.РасшифровкаПлатежа[Индекс].Подразделение;
						Иначе
							Если ОбщегоНазначения.ЕстьРеквизитДокумента("Подразделение",Документ.Метаданные()) Тогда
								Если ЗначениеЗаполнено(Документ.Подразделение) Тогда
									
									Запись.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.вчПодразделения]  = Документ.Подразделение;	
									Запись.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.вчПодразделения]  = Документ.Подразделение;
								КонецЕсли;
							КонецЕсли;
							
						КонецЕсли;
					Исключение

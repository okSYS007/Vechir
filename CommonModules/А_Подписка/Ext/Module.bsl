Процедура ОбработкаПроведенияДокументов(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда
		Возврат
	КонецЕсли;
	Попытка
	Если Источник.Дата>Константы.А_ДатаНачалаТрансляции.Получить() Тогда 
		Режим = ПолучитьРежимТрансляции(Источник.Организация, Источник.дата);
		
		Если Режим = Перечисления.А_РежимыТрансляции.OnLine Тогда 
			
			ТипИсточника = ТипЗнч(Источник);
			МетаданныеИсточника = Источник.Метаданные();
			Если Источник.ОтражатьВБухгалтерскомУчете Тогда 
				СформироватьДокументУУ(Источник, МетаданныеИсточника, ТипИсточника, Отказ, РежимПроведения);
				МенеджерЗаписи = РегистрыСведений.А_ОчередьТрансляции.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Активность = Истина;
				МенеджерЗаписи.Объект = Источник.Ссылка;
				МенеджерЗаписи.Организация = Источник.Организация;
				МенеджерЗаписи.ПоставленоВОчередь = ТекущаяДата();
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли;
		ИначеЕсли Режим = Перечисления.А_РежимыТрансляции.Отложенный Тогда 
			
					
			
		КонецЕсли;
		
		Если ТипЗнч(Источник) = тип("ДокументОбъект.УпрРасходныйКассовыйОрдер") 
			или ТипЗнч(Источник) = тип("ДокументОбъект.УпрПриходныйКассовыйОрдер") Тогда 
			
			МенеджерЗаписи = РегистрыСведений.А_ОчередьТрансляции.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Активность = Истина;
			МенеджерЗаписи.Объект = Источник.Ссылка;
			МенеджерЗаписи.Организация = Источник.Организация;
			МенеджерЗаписи.ПоставленоВОчередь = ТекущаяДата();
			МенеджерЗаписи.Записать(Истина);
			
		КонецЕсли;
		
	КонецЕсли;
Исключение
	КонецПопытки;
КонецПроцедуры

Процедура ОбработкаПроведенияПоступлениеТоваровУслуг(Источник, МетаданныеИсточника)
	
	ЗаполнитьСубконтоПартия(Источник, МетаданныеИсточника, Источник.Ссылка);
	
	// А_Вячеслав(18.01.2019 перепроведем корректировки документа
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_КорректировкаСтоимости.Ссылка
		|ИЗ
		|	Документ.А_КорректировкаСтоимости КАК А_КорректировкаСтоимости
		|ГДЕ
		|	А_КорректировкаСтоимости.ДокументОснование = &ТекДокумент
		|	И А_КорректировкаСтоимости.Проведен";
	
	Запрос.УстановитьПараметр("ТекДокумент",Источник.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		оОбъект = Выборка.Ссылка.ПолучитьОбъект();
		оОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла; 
	// А_Вячеслав)
	
КонецПроцедуры


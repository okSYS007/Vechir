Функция ОбъединитьТаблицыЗначений(Таблица1, Таблица2) Экспорт

	ИмяТаблицы1 = "Таблица1";
	ИмяТаблицы2 = "Таблица2";

	КолонкиТаблицы = Таблица1.Колонки;

	МассивПолей1 = Новый Массив;
	МассивПолей2 = Новый Массив;

	Для Каждого КолонкаТаблицы Из КолонкиТаблицы Цикл

		ИмяКолонки = КолонкаТаблицы.Имя;

		СтрокаПоля1 = Символы.Таб + ИмяТаблицы1 + "." + ИмяКолонки;
		СтрокаПоля2 = Символы.Таб + ИмяТаблицы2 + "." + ИмяКолонки;

		МассивПолей1.Добавить(СтрокаПоля1);
		МассивПолей2.Добавить(СтрокаПоля2);

	КонецЦикла;

	РазделительПолей = "," + Символы.ПС;

	ВыбранныеПоля1 = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивПолей1, РазделительПолей);
	ВыбранныеПоля2 = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивПолей2, РазделительПолей);

	МассивПодЗапроса1 = Новый Массив;
	МассивПодЗапроса1.Добавить("ВЫБРАТЬ");
	МассивПодЗапроса1.Добавить(ВыбранныеПоля1);
	МассивПодЗапроса1.Добавить("ПОМЕСТИТЬ " + ИмяТаблицы1);
	МассивПодЗапроса1.Добавить(" ИЗ &" + ИмяТаблицы1);
	МассивПодЗапроса1.Добавить("КАК " + ИмяТаблицы1);
	МассивПодЗапроса1.Добавить(";");

	МассивПодЗапроса2 = Новый Массив;
	МассивПодЗапроса2.Добавить("ВЫБРАТЬ");
	МассивПодЗапроса2.Добавить(ВыбранныеПоля2);
	МассивПодЗапроса2.Добавить("ПОМЕСТИТЬ " + ИмяТаблицы2);
	МассивПодЗапроса2.Добавить(" ИЗ &" + ИмяТаблицы2);
	МассивПодЗапроса2.Добавить("КАК " + ИмяТаблицы2);
	МассивПодЗапроса2.Добавить(";");

	МассивОбъединения1 = Новый Массив;
	МассивОбъединения1.Добавить("ВЫБРАТЬ");
	МассивОбъединения1.Добавить(ВыбранныеПоля1);
	МассивОбъединения1.Добавить(" ИЗ " + ИмяТаблицы1);

	МассивОбъединения2 = Новый Массив;
	МассивОбъединения2.Добавить("ВЫБРАТЬ");
	МассивОбъединения2.Добавить(ВыбранныеПоля2);
	МассивОбъединения2.Добавить(" ИЗ " + ИмяТаблицы2);

	Разделитель = Символы.ПС;

	ПодЗапрос1 = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивПодЗапроса1, Разделитель);
	ПодЗапрос2 = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивПодЗапроса2, Разделитель);
	Объединение1 = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивОбъединения1, Разделитель);
	Объединение2 = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивОбъединения2, Разделитель);

	МассивЗапроса = Новый Массив;

	МассивЗапроса.Добавить(ПодЗапрос1);
	МассивЗапроса.Добавить("");
	МассивЗапроса.Добавить(ПодЗапрос2);
	МассивЗапроса.Добавить("");

	МассивЗапроса.Добавить(Объединение1);
	МассивЗапроса.Добавить("");
	МассивЗапроса.Добавить("ОБЪЕДИНИТЬ");
	МассивЗапроса.Добавить(Объединение2);
	МассивЗапроса.Добавить("");

	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивЗапроса, Разделитель);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр(ИмяТаблицы1, Таблица1);
	Запрос.УстановитьПараметр(ИмяТаблицы2, Таблица2);
	РезультатЗапроса  = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	Возврат ТаблицаРезультата;


//	ВыхИмя=ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	Если Ответ.КодСостояния<>200 Тогда
		Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Мас = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Мас = Неопределено Тогда
		Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Набор_spИнформацияПоКомпаниям = РегистрыСведений.spИнформацияПоКомпаниям.СоздатьНаборЗаписей();
	Набор_spИнформацияПоКомпаниям.Отбор.Компания.Установить(Компания);
	Набор_spИнформацияПоКомпаниям.Прочитать();
	

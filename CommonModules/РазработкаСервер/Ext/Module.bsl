#Область РаботаСоСтроками
Функция УдалитьНеЦифрыИзСтроки(Знач СтрокаОбработки) Экспорт
	
	Если ТипЗнч(СтрокаОбработки) <> Тип("Строка") Тогда
		СтрокаОбработки = Строка( СтрокаОбработки);
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаОбработки) Тогда
		Возврат "";
	КонецЕсли; 
	
	РезультирующаяСтрока = "";
	Для Сч = 1 По СтрДлина(СтрокаОбработки) Цикл
		ТекСимвол =  Сред(СтрокаОбработки, Сч, 1);
		КодСимвола = КодСимвола(ТекСимвол);
		Если КодСимвола >= 48 И КодСимвола <= 57 Тогда
			РезультирующаяСтрока = РезультирующаяСтрока + ТекСимвол;
		КонецЕсли; 
	КонецЦикла; 

	Возврат РезультирующаяСтрока;
	
КонецФункции

Функция ЗашифроватьСтроку(ВходящаяСтрока,Кодировка) Экспорт 
	
	КодировкаФайла = Кодировка;
    
    Если Кодировка = "ANSI" Тогда
        КодировкаФайла = КодировкаТекста.ANSI;
        
    ИначеЕсли Кодировка = "OEM" Тогда
        КодировкаФайла = КодировкаТекста.OEM;
        
    ИначеЕсли Кодировка = "UTF8" Тогда
        КодировкаФайла = КодировкаТекста.UTF8;
        
    ИначеЕсли Кодировка = "UTF16" Тогда
        КодировкаФайла = КодировкаТекста.UTF16;
        
    ИначеЕсли Кодировка = "Системная" Тогда
        КодировкаФайла = КодировкаТекста.Системная;
    
    КонецЕсли;
    ВременныйФайл = ПолучитьИмяВременногоФайла();
    
    Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаФайла);
    Запись.ЗаписатьСтроку(ВходящаяСтрока,"");
    Запись.Закрыть();
    
    ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
    СтрокаРезультат = Base64Строка(ДвДанные);
    
    УдалитьФайлы(ВременныйФайл);
	
	Возврат СтрокаРезультат;
	
КонецФункции


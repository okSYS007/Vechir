Процедура ИнформацияКомпанииПоID(Аккаунт, Компания) Экспорт
	
	//https://api.sendpulse.com/campaigns/{id}
	Соед = Подключение();
	
	Ключ = ПолучитьКлюч(Соед, Аккаунт);


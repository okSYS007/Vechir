	Рез1 = СтрЗаменить(Рез1,"}","Ъ");	
	Рез1 = СтрЗаменить(Рез1,"""","Э");
	Рез1 = СтрЗаменить(Рез1,">","Ю");
	Рез1 = СтрЗаменить(Рез1,"Z","Я");

	СтрДлинна = СтрДлина(ИсходнаяСтрока);
	
	//сравним символы с исходной строкой и построим новую
	СтрокаРЕзультат = "";
	Для Сч = 1 по СтрДлинна Цикл 
		СимволИсходный = Сред(ИсходнаяСтрока,Сч,1);
		Символ0 = Сред(Рез,Сч,1);

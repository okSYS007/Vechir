Функция ПолучитьДатуИзФорматаДжСОН(Знач СтрокаДаты, Знач УбратьДолиСекунды = Ложь, Знач УчестьЧасовойПояс = Истина) Экспорт

	ЗначениеДаты = Дата(1,1,1);

	ОчищеннаяСтрока = СокрЛП(СтрокаДаты);

	МассивПодСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОчищеннаяСтрока, "+");

	Если МассивПодСтрок.Количество() < 1 Тогда
		Возврат ЗначениеДаты;
	КонецЕсли;

	ОчищеннаяСтрока = МассивПодСтрок[0];

	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, " ",			"");
	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, Символы.НПП,	"");
	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, Символы.ПС,	"");
	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, Символы.Таб,	"");
	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, Символы.Таб,	"");

	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, "T",			"");
	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, "Z",			"");

	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, ",",			"");
	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, "-",			"");
	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, ":",			"");

	Если УбратьДолиСекунды Тогда
		ИДХ = СтроковыеФункцииКлиентСервер.НайтиСимволСКонца(ОчищеннаяСтрока, ".");
		ИДХ = ИДХ - 1;
		ОчищеннаяСтрока = Сред(ОчищеннаяСтрока, 1, ИДХ);
	КонецЕсли;

	ОчищеннаяСтрока = СтрЗаменить(ОчищеннаяСтрока, ".",			"");

	Попытка
		ЗначениеДаты = Дата(ОчищеннаяСтрока);
	Исключение
		Возврат ЗначениеДаты;
	КонецПопытки;

	Если УчестьЧасовойПояс И МассивПодСтрок.Количество() > 1 Тогда

		СтрокаЧасовогоПояса = МассивПодСтрок[1];

		СтрокаЧасовогоПояса = СтрЗаменить(СтрокаЧасовогоПояса, " ",			"");
		СтрокаЧасовогоПояса = СтрЗаменить(СтрокаЧасовогоПояса, Символы.НПП,	"");
		СтрокаЧасовогоПояса = СтрЗаменить(СтрокаЧасовогоПояса, Символы.ПС,	"");
		СтрокаЧасовогоПояса = СтрЗаменить(СтрокаЧасовогоПояса, Символы.Таб,	"");
		СтрокаЧасовогоПояса = СтрЗаменить(СтрокаЧасовогоПояса, Символы.Таб,	"");

		МассивПодСтрокЧП = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаЧасовогоПояса, ":");

		ВсегоПодСтрок = МассивПодСтрокЧП.Количество();

		Часов = 0;
		Минут = 0;

		Если ВсегоПодСтрок = 2 Тогда

			Попытка
				Часов = Число(МассивПодСтрокЧП[0]);
			Исключение
			КонецПопытки;

			Попытка
				Минут = Число(МассивПодСтрокЧП[1]);
			Исключение
			КонецПопытки;

		ИначеЕсли ВсегоПодСтрок = 1 Тогда

			Попытка
				Часов = Число(МассивПодСтрокЧП[0]);
			Исключение
			КонецПопытки;

		КонецЕсли;

		Если Часов > 0 ИЛИ Минут > 0 Тогда
			Часов = Часов - ЧасовойПоясПоУмолчанию();
			КорректировкаСекунд = Часов * 3600 + Минут * 60;
			ЗначениеДаты = ЗначениеДаты - КорректировкаСекунд;
		КонецЕсли;

	КонецЕсли;

	Возврат ЗначениеДаты;

КонецФункции

Функция ПолучитьТелоДжСОНИзСтруктуры(СтруктураДанных, УниверсальнаяДата = Ложь) Экспорт


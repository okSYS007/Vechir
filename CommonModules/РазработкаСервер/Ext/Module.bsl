КонецФункции

Функция ПолучитьАккаунтПоКнтрагенту(Контрагент) Экспорт 	
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СайтПользователиКонтрагенты.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.СайтПользователиКонтрагенты КАК СайтПользователиКонтрагенты
		|ГДЕ		
		|	СайтПользователиКонтрагенты.Контрагент = &Контрагент 
		|	И 	СайтПользователиКонтрагенты.Пользователь <> Значение(Справочник.Контрагенты.ПустаяСсылка)
		|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Пользователь;
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьСуммуДолгаПоАккаунту(Аккаунт,МассивКонтрагентовАккаунта = Неопределено) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", МассивКонтрагентовАккаунта);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ВзаиморасчетыСКонтрагентамиОстатки.СуммаУпрОстаток) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&ТекущаяДата, Контрагент В (&Контрагент)) КАК ВзаиморасчетыСКонтрагентамиОстатки
		|";
	
	СуммаДолга = 0;
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	Если ТаблицаОстатков.Количество() > 0 Тогда 
		СуммаДолга = ТаблицаОстатков.Итог("СуммаОстаток");	
	КонецЕсли;
	
	Возврат  СуммаДолга;
	
КонецФункции

Процедура ЗаписатьВходящиеСобытияДляОбработки(СсылкаНАОбъект, Аккаунт, ДатаЗаписи = Неопределено) Экспорт 
	
	Если Не ЗначениеЗаполнено(СсылкаНАОбъект) Тогда 
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ВходящиеСобытияДляОбработки.СоздатьНаборЗаписей();	
	НаборЗаписей.Отбор.Объект.Установить(СсылкаНАОбъект);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда 
		Запись = НаборЗаписей.Добавить();
		Запись.Активность	= Истина;
		Запись.Объект		= СсылкаНАОбъект;
		Запись.Период		= ?(ЗначениеЗаполнено(ДатаЗаписи),ДатаЗаписи,ТекущаяДата());
		Запись.Аккаунт		= Аккаунт;
		Попытка
			НаборЗаписей.Записать(Истина);
		Исключение
			ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать регистр ВходящиеСобытияДляОбработки!" + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры


Процедура ПриЗаписиОбъекта_ИсторииКонтактовСАккаунтомПриЗаписи(Источник, Отказ) Экспорт

	Если Константы.ФормироватьИсториюКонтактовСАккаунтами.Получить() <> Истина Тогда 
		Возврат;
	КонецЕсли;
	
	
	МетаданныеДокумента = Источник.Метаданные();
	
	ИмяДока = МетаданныеДокумента.Имя;
	
	СсылкаНАОбъект = Источник.Ссылка;
	
	
	
			
	//зафиксируем историю контактов
	Если ИмяДока = "ЭлектронноеПисьмо" Тогда 
		
		СтатусыИсходящих = Новый Массив;
		СтатусыИсходящих.Добавить(Перечисления.СтатусыПисем.Исходящее);
		СтатусыИсходящих.Добавить(Перечисления.СтатусыПисем.Отправленное);
		СтатусыИсходящих.Добавить(Перечисления.СтатусыПисем.Сохраненное);
		
		Запрос = Новый Запрос;		
		Запрос.УстановитьПараметр("ПустаяСтрока"	,"");
		Запрос.УстановитьПараметр("СтатусыИсходящих",СтатусыИсходящих);	
		Запрос.УстановитьПараметр("СсылкаНАОбъект"	,СсылкаНАОбъект);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	данные.Ссылка КАК Письмо,
			|	данные.СтатусПисьма,
			|	данные.ПочтаПолучатель,
			|	данные.ПочтаОтправитель,
			|	данные.ПочтаАккаунта
			|ИЗ
			|	(ВЫБРАТЬ
			|		ЭлектронноеПисьмоКомуТЧ.Ссылка КАК Ссылка,
			|		ЭлектронноеПисьмоКомуТЧ.Ссылка.СтатусПисьма КАК СтатусПисьма,
			|		ЭлектронноеПисьмоКомуТЧ.АдресЭлектроннойПочты КАК ПочтаПолучатель,
			|		ЭлектронноеПисьмоКомуТЧ.Ссылка.ОтправительАдресЭлектроннойПочты КАК ПочтаОтправитель,
			|		ЭлектронноеПисьмоКомуТЧ.АдресЭлектроннойПочты КАК ПочтаАккаунта
			|	ИЗ
			|		Документ.ЭлектронноеПисьмо.КомуТЧ КАК ЭлектронноеПисьмоКомуТЧ
			|	ГДЕ
			|		ЭлектронноеПисьмоКомуТЧ.Ссылка = &СсылкаНАОбъект
			|		И ЭлектронноеПисьмоКомуТЧ.Ссылка.СтатусПисьма В(&СтатусыИсходящих)
			|		И ЭлектронноеПисьмоКомуТЧ.АдресЭлектроннойПочты <> &ПустаяСтрока
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ЭлектронноеПисьмо.Ссылка,
			|		ЭлектронноеПисьмо.СтатусПисьма,
			|		ВЫРАЗИТЬ(ЭлектронноеПисьмо.Кому КАК СТРОКА(250)),
			|		ЭлектронноеПисьмо.ОтправительАдресЭлектроннойПочты,
			|		ЭлектронноеПисьмо.ОтправительАдресЭлектроннойПочты
			|	ИЗ
			|		Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
			|	ГДЕ
			|		ЭлектронноеПисьмо.Ссылка = &СсылкаНАОбъект
			|		И НЕ ЭлектронноеПисьмо.СтатусПисьма В (&СтатусыИсходящих)) КАК данные
			|";

		РезультатЗапроса = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		МассивАккаунтов = Новый Массив;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ТекПисьмо = ВыборкаДетальныеЗаписи.Письмо;
			ТекДата   = ТекПисьмо.Дата;
			ТекСтатусПисьма   = ТекПисьмо.СтатусПисьма;
			
			Направление = Перечисления.НаправленияКонтактовАккаунта.Исход;
			Если СтатусыИсходящих.Найти(ТекСтатусПисьма) = Неопределено Тогда 
				Направление = Перечисления.НаправленияКонтактовАккаунта.Вход;	
			КонецЕсли;
			
			ПочтаАккаунта =ВыборкаДетальныеЗаписи.ПочтаАккаунта;
			
			//Заполняем поля поиска
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Код"				,ПочтаАккаунта);
			СтруктураПоиска.Вставить("ЭлектроннаяПочта"	,ПочтаАккаунта);
			СтруктураПоиска.Вставить("КонтактныйТелефон",ПочтаАккаунта);
			
			Аккаунт = НайтиСоздатьАккаунт(СтруктураПоиска,,,Истина);
							
			НаборЗапиписей = РегистрыСведений.ИсторияКонтактовСАккаунтом.СоздатьНаборЗаписей();
			НаборЗапиписей.Отбор.Объект.Установить(ТекПисьмо);
			НаборЗапиписей.Отбор.Аккаунт.Установить(Аккаунт);
			
			ЗАпись = НаборЗапиписей.Добавить();
			ЗАпись.Активность 		= Истина;
			ЗАпись.Аккаунт	  		= Аккаунт;
			ЗАпись.Объект	  		= ТекПисьмо;
			ЗАпись.Период	  		= ТекДата;
			ЗАпись.Направление	  	= Направление;
			
			
			Попытка
				НаборЗапиписей.Записать(Истина);	
			Исключение			
				ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать историю по "+ ТекПисьмо+ "! Причина:"+ОписаниеОшибки());	
			КонецПопытки;		
			
			//зафиксируем таблицу для обработки менеждером
			Если Направление = Перечисления.НаправленияКонтактовАккаунта.Вход Тогда 
				ЗаписатьВходящиеСобытияДляОбработки(СсылкаНАОбъект, Аккаунт,ТекДата); 
			КонецЕсли;
		КонецЦикла;
			
	
	ИначеЕсли ИмяДока = "Событие" Тогда 
			
		ТипыКИ = Новый Массив;
		ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Телефон);
		ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СсылкаНАОбъект"	,СсылкаНАОбъект);
		Запрос.УстановитьПараметр("ВидСобытия"		, Перечисления.ВидыСобытий.ТелефонныйЗвонок);
		Запрос.УстановитьПараметр("ТипыКИ"				, ТипыКИ);		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Событие.Ссылка КАК Ссылка,
			|	Событие.ТипСобытия КАК ТипСобытия,
			|	Событие.АдресЭлектроннойПочты,
			|	Событие.Контрагент,
			|	Событие.КонтактноеЛицо
			|ПОМЕСТИТЬ ТАблицаСобытий
			|ИЗ
			|	Документ.Событие КАК Событие
			|ГДЕ
			|	Событие.ВидСобытия В(&ВидСобытия)
			|	И Событие.Ссылка  = &СсылкаНАОбъект
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	КонтактнаяИнформация.Объект,
			|	КонтактнаяИнформация.Представление,
			|	КонтактнаяИнформация.Тип
			|ИЗ
			|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.Тип В (&ТипыКИ)
			|	И (ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(100))) <> """"
			|	И КонтактнаяИнформация.Объект В
			|			(ВЫБРАТЬ
			|				ТАблицаСобытий.Контрагент
			|			ИЗ
			|				ТАблицаСобытий КАК ТАблицаСобытий
			|		
			|			ОБЪЕДИНИТЬ ВСЕ
			|		
			|			ВЫБРАТЬ
			|				ТАблицаСобытий.КонтактноеЛицо
			|			ИЗ
			|				ТАблицаСобытий КАК ТАблицаСобытий)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТАблицаСобытий.Ссылка,
			|	ТАблицаСобытий.ТипСобытия КАК ТипСобытия,
			|	ТАблицаСобытий.АдресЭлектроннойПочты,
			|	ТАблицаСобытий.Контрагент,
			|	ТАблицаСобытий.КонтактноеЛицо
			|ИЗ
			|	ТАблицаСобытий КАК ТАблицаСобытий";
		
		
		МассивРезульаттов = Запрос.ВыполнитьПакет();
		
		ТаблСобытий		 = МассивРезульаттов[2].Выгрузить();
		КИКонтрагентов	 = МассивРезульаттов[1].Выгрузить();
				
		для Каждого ВыборкаДетальныеЗаписи из ТаблСобытий Цикл 
								
			
			Объект = ВыборкаДетальныеЗаписи.Ссылка;
			ТипСобытия = ВыборкаДетальныеЗаписи.ТипСобытия;
			ТекДата = Объект.Дата;
			
			АдресЭлектроннойПочты = СокрЛП(Объект.АдресЭлектроннойПочты);
			
			Направление = Перечисления.НаправленияКонтактовАккаунта.Исход;
			Если ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Входящее Тогда 
				Направление = Перечисления.НаправленияКонтактовАккаунта.Вход;	
			КонецЕсли;
			
			//КонтактноеЛицо
			//Контрагент
			// сделать поиск аккаунат по все Ки контрагента!!!
			ТекТаблицаКИ = КИКонтрагентов.СкопироватьКолонки();
			
			Контрагент = ВыборкаДетальныеЗаписи.Контрагент;
			Если ЗначениеЗаполнено(Контрагент) Тогда 
				СтруктураОтбора = Новый Структура;			
				СтруктураОтбора.Вставить("Объект",Контрагент);
				
				ТекТаблицаКИПоКнотрагенту = КИКонтрагентов.Скопировать(СтруктураОтбора);
				
				ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ТекТаблицаКИПоКнотрагенту, ТекТаблицаКИ);
				
			КонецЕсли;
			
			КонтактноеЛицо = ВыборкаДетальныеЗаписи.КонтактноеЛицо;
			Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда 
				СтруктураОтбора = Новый Структура;			
				СтруктураОтбора.Вставить("Объект",КонтактноеЛицо);
				
				ТекТаблицаКИПоКнотрагенту = КИКонтрагентов.Скопировать(СтруктураОтбора);
				
				ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ТекТаблицаКИПоКнотрагенту, ТекТаблицаКИ);
				
			КонецЕсли;
			
			МассивКИ = ТекТаблицаКИ.ВыгрузитьКолонку("Представление");
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Код"				,АдресЭлектроннойПочты);
			СтруктураПоиска.Вставить("ЭлектроннаяПочта"	,АдресЭлектроннойПочты);
			СтруктураПоиска.Вставить("КонтактныйТелефон",АдресЭлектроннойПочты);	
			
			Аккаунт = НайтиСоздатьАккаунт(СтруктураПоиска,Контрагент,МассивКИ,Истина);
			
			Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
				Продолжить;	
			КонецЕсли;
					
			НаборЗапиписей = РегистрыСведений.ИсторияКонтактовСАккаунтом.СоздатьНаборЗаписей();
			НаборЗапиписей.Отбор.Объект.Установить(Объект);
			НаборЗапиписей.Отбор.Аккаунт.Установить(Аккаунт);
			
			ЗАпись = НаборЗапиписей.Добавить();
			ЗАпись.Активность = Истина;
			ЗАпись.Аккаунт	  = Аккаунт;
			ЗАпись.Объект	  = Объект;
			ЗАпись.Период	  = ТекДата;
			ЗАпись.Направление= Направление;
			
			Попытка
				НаборЗапиписей.Записать(Истина);	
			Исключение			
				ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать историю по "+ Объект+ "! Причина:"+ОписаниеОшибки());	
			КонецПопытки;	
		КонецЦикла;

	//
	ИначеЕсли ИмяДока = "МИКО_стЗаписьИсторииЗвонков" Тогда 
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("СсылкаНАОбъект"	,СсылкаНАОбъект);
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МИКО_стЗаписьИсторииЗвонков.Ссылка,
			|	МИКО_стЗаписьИсторииЗвонков.Src,
			|	МИКО_стЗаписьИсторииЗвонков.Dst,
			|	МИКО_стЗаписьИсторииЗвонков.recordingfile,
			|	МИКО_стЗаписьИсторииЗвонков.Направление,
			|	МИКО_стЗаписьИсторииЗвонков.Дата
			|ИЗ
			|	Документ.МИКО_стЗаписьИсторииЗвонков КАК МИКО_стЗаписьИсторииЗвонков
			|ГДЕ			
			|	МИКО_стЗаписьИсторииЗвонков.Ссылка  = &СсылкаНАОбъект
			|";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ТекДата 	= ВыборкаДетальныеЗаписи.Дата;
			Ссылка 		= ВыборкаДетальныеЗаписи.Ссылка;
			Направление = ВыборкаДетальныеЗаписи.Направление;
			Src			= СокрЛП(ВыборкаДетальныеЗаписи.Src);
			Dst			= СокрЛП(ВыборкаДетальныеЗаписи.Dst);
			
			НаборЗапиписей = РегистрыСведений.ИсторияКонтактовСАккаунтом.СоздатьНаборЗаписей();
			НаборЗапиписей.Отбор.Объект.Установить(Ссылка);
			НаборЗапиписей.Очистить();
			
			Если Направление = Перечисления.МИКО_стВидыТелефонныхЗвонков.Исходящий Тогда 
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Код"				,Dst);
				СтруктураПоиска.Вставить("ЭлектроннаяПочта"	,Dst);
				СтруктураПоиска.Вставить("КонтактныйТелефон",Dst);	
				
				Аккаунт = НайтиСоздатьАккаунт(СтруктураПоиска,,,Истина);
			//		
				Если ЗначениеЗаполнено(Аккаунт) Тогда 
					ЗАпись = НаборЗапиписей.Добавить();
					ЗАпись.Активность = Истина;
					ЗАпись.Аккаунт	  = Аккаунт;
					ЗАпись.Объект	  = Ссылка;
					ЗАпись.Период	  = ТекДата;
					ЗАпись.Направление= Перечисления.НаправленияКонтактовАккаунта.Исход;
				КонецЕсли;
				//
					
				
			ИначеЕсли Направление = Перечисления.МИКО_стВидыТелефонныхЗвонков.Входящий Тогда 
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Код"				,Src);
				СтруктураПоиска.Вставить("ЭлектроннаяПочта"	,Src);
				СтруктураПоиска.Вставить("КонтактныйТелефон",Src);	
				
				Аккаунт = НайтиСоздатьАккаунт(СтруктураПоиска,,,Истина);
			//		
				Если ЗначениеЗаполнено(Аккаунт) Тогда 
					ЗАпись = НаборЗапиписей.Добавить();
					ЗАпись.Активность = Истина;
					ЗАпись.Аккаунт	  = Аккаунт;
					ЗАпись.Объект	  = Ссылка;
					ЗАпись.Период	  = ТекДата;
					ЗАпись.Направление= Перечисления.НаправленияКонтактовАккаунта.Вход;
				КонецЕсли;
						
			Иначе 
				
				СтруктураПоиска.Вставить("Код"				,Dst);
				СтруктураПоиска.Вставить("ЭлектроннаяПочта"	,Dst);
				СтруктураПоиска.Вставить("КонтактныйТелефон",Dst);	
				
				Аккаунт = НайтиСоздатьАккаунт(СтруктураПоиска,,,Истина);
			//		
				Если ЗначениеЗаполнено(Аккаунт) Тогда 
					ЗАпись = НаборЗапиписей.Добавить();
					ЗАпись.Активность = Истина;
					ЗАпись.Аккаунт	  = Аккаунт;
					ЗАпись.Объект	  = Ссылка;
					ЗАпись.Период	  = ТекДата;	
					ЗАпись.Направление= Перечисления.НаправленияКонтактовАккаунта.Внутр;
				КонецЕсли;
				
				СтруктураПоиска.Вставить("Код"				,Src);
				СтруктураПоиска.Вставить("ЭлектроннаяПочта"	,Src);
				СтруктураПоиска.Вставить("КонтактныйТелефон",Src);	
				
				Аккаунт = НайтиСоздатьАккаунт(СтруктураПоиска,,,Истина);
			//		
				Если ЗначениеЗаполнено(Аккаунт) Тогда 
					ЗАпись = НаборЗапиписей.Добавить();
					ЗАпись.Активность = Истина;
					ЗАпись.Аккаунт	  = Аккаунт;
					ЗАпись.Объект	  = Ссылка;
					ЗАпись.Период	  = ТекДата;	
					ЗАпись.Направление= Перечисления.НаправленияКонтактовАккаунта.Внутр;
				КонецЕсли;
				
			КонецЕсли;
			
			Если НаборЗапиписей.Количество() > 0 Тогда 
				Попытка
					НаборЗапиписей.Записать(Истина);	
				Исключение			
					ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать историю по "+ Ссылка+ "! Причина:"+ОписаниеОшибки());	
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли  ИмяДока = "СайтПользователиЗапросыИСообщения" Тогда 	 		
		
			Аккаунт = Источник.Пользователь; 
							
			НаборЗапиписей = РегистрыСведений.ИсторияКонтактовСАккаунтом.СоздатьНаборЗаписей();
			НаборЗапиписей.Отбор.Объект.Установить(СсылкаНАОбъект);
			НаборЗапиписей.Отбор.Аккаунт.Установить(Аккаунт);
			
			ЗАпись = НаборЗапиписей.Добавить();
			ЗАпись.Активность 		= Истина;
			ЗАпись.Аккаунт	  		= Аккаунт;
			ЗАпись.Объект	  		= СсылкаНАОбъект;
			ЗАпись.Период	  		= ?(ЗначениеЗаполнено(Источник.Дата),Источник.Дата, ТекущаяДата());
			ЗАпись.Направление	  	= Перечисления.НаправленияКонтактовАккаунта.Вход;
			
			Попытка
				НаборЗапиписей.Записать(Истина);	
			Исключение			
				ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать историю по "+ ТекПисьмо+ "! Причина:"+ОписаниеОшибки());	
			КонецПопытки;		
			
			//зафиксируем таблицу для обработки менеждером			
			ЗаписатьВходящиеСобытияДляОбработки(СсылкаНАОбъект, Аккаунт,Источник.Дата); 
			
	
	КонецЕсли;
	
	
КонецПроцедуры


Функция НайтиСоздатьАккаунт(СтрукутраПоиска, Контрагент = Неопределено,МассивКИВходящий = Неопределено, СоздаватьНовыйСпр = Ложь, ДопРеквизиты = Неопределено) Экспорт 
	
	
	МассивКИ = Новый Массив;
	Если ТипЗнч(МассивКИВходящий) = Тип("Массив") Тогда 
		Для Каждого ТекСтркоаКИ Из МассивКИВходящий Цикл  
			//ТекСтрока = СокрЛП(ТекСтркоаКИ);
			ТекСтрока	= ПолучитьСтрокуКИБезЛишнихСимволов(ТекСтркоаКИ);
			ТекСтрока	=  ПревестиСтрокуКИКФормату(ТекСтрока);
			Если ЗначениеЗаполнено(ТекСтрока) Тогда 
				МассивКИ.Добавить(ТекСтрока);	
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	
	Если СтрукутраПоиска.Количество()  = 0
		и Не ЗначениеЗаполнено(Контрагент)
			Тогда 
		Возврат Справочники.СайтПользователи.ПустаяСсылка();		
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Контрагент) Тогда 
		
		ТипыКИ = Новый Массив;
		ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Телефон);
		ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТипыКИ",ТипыКИ);		
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВЫРАЗИТь(КонтактнаяИнформация.Представление КАК СТРОКА(100)) КАК КИ
			|ИЗ
			|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.Объект = &Контрагент
			|	И 	КонтактнаяИнформация.Тип В (&ТипыКИ)
			|";				
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаТЧ Из РезультатЗапроса Цикл 
			ТекСтрока 	= ПолучитьСтрокуКИБезЛишнихСимволов(СтрокаТЧ.КИ); 					
			ТекСтрока	= ПревестиСтрокуКИКФормату(ТекСтрока);
			Если ЗначениеЗаполнено(ТекСтрока) Тогда 
				МассивКИ.Добавить(ТекСтрока);	
			КонецЕсли;			
		КонецЦикла;		
	КонецЕсли;
	
	
	Запрос =  Новый Запрос;
	
	ТекстЗапроса = "";
	ТекстУсловия = "";
	Сч= 0;
		
	Запрос.УстановитьПараметр("Контрагент",Контрагент);		
	Запрос.УстановитьПараметр("МассивКИ",МассивКИ);		

	
	//СайтПользователи.Код = &Код
	Для Каждого ТекПоказатель из СтрукутраПоиска Цикл 
		Имя 		= ТекПоказатель.Ключ;
		Значение	= ПолучитьСтрокуКИБезЛишнихСимволов(ТекПоказатель.Значение);
		Значение	= ПревестиСтрокуКИКФормату(Значение);
		
		Если не ЗначениеЗаполнено(Значение) Тогда 
			Продолжить;
		КонецЕсли;
		
		ИмяПараметраЗапроса = "Парам"+Сч; 
		
		Запрос.УстановитьПараметр(ИмяПараметраЗапроса,Значение);		
		
		ТекУсловие  = "Спр."+Имя +" = &"+ИмяПараметраЗапроса;
		
		ТекстУсловия = ТекстУсловия + " ИЛИ "  + ТекУсловие;   
		
		Сч = Сч + 1;
	КонецЦикла;
	
	//Если не ЗначениеЗаполнено(ТекстУсловия) Тогда 
	//	Возврат Справочники.СайтПользователи.ПустаяСсылка();		
	//КонецЕсли;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(100))
	|	ПОМЕСТИТЬ ТАблциаКонтрагетовКИ
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(100)) В (&МассивКИ)
	|	И КонтактнаяИнформация.Объект Ссылка Справочник.Контрагенты	
	|;
	|
	|ВЫБРАТЬ
	|	СайтПользователиКонтрагенты.Пользователь КАК Аккаунт	
	|ИЗ
	|	РегистрСведений.СайтПользователиКонтрагенты КАК СайтПользователиКонтрагенты
	|ГДЕ
	|	(СайтПользователиКонтрагенты.Контрагент = &Контрагент ИЛИ СайтПользователиКонтрагенты.Контрагент В(ВЫБРАТЬ ТАблциаКонтрагетовКИ.Объект ИЗ ТАблциаКонтрагетовКИ КАК ТАблциаКонтрагетовКИ))
	|	И СайтПользователиКонтрагенты.Пользователь <> Значение(Справочник.СайтПользователи.ПустаяСсылка)
	|	И СайтПользователиКонтрагенты.Контрагент <> Значение(Справочник.Контрагенты.ПустаяСсылка)	
	|;
	|
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Аккаунт
	|ИЗ
	|	Справочник.СайтПользователи КАК Спр
	|ГДЕ
	|	Спр.Код В(&МассивКИ) ИЛИ Спр.ЭлектроннаяПочта В(&МассивКИ) ИЛИ Спр.КонтактныйТелефон В(&МассивКИ) 
	|	"+ТекстУсловия+"
	|
	| ОБЪЕДИНИТЬ 
	|ВЫБРАТЬ                   
	|	СайтПользователиКИ.Ссылка КАК Аккаунт
	|ИЗ
	|	Справочник.СайтПользователи.КИ КАК СайтПользователиКИ
	|ГДЕ
	|	СайтПользователиКИ.ЗначениеКИ В(&МассивКИ) 
	|
	|";
		
	Запрос.Текст = ТекстЗапроса;
	
	МассивРезультатов				= Запрос.ВыполнитьПакет();	
	ТаблицаАккаунтовПоКонтрагентам	= МассивРезультатов[1].Выгрузить();
	ТаблицаАккаунтов 				= МассивРезультатов[2].Выгрузить();	
	
	ТекАккаунт = Неопределено;
	
	Если ТаблицаАккаунтов.Количество() > 0 Тогда 
		ТекАккаунт  = ТаблицаАккаунтов[0].Аккаунт;
		//Сообщить(ТекАккаунт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент)
		и ТаблицаАккаунтовПоКонтрагентам.Количество() >0 Тогда 
		ТекАккаунт  = ТаблицаАккаунтовПоКонтрагентам[0].Аккаунт;	
		//Сообщить(ТекАккаунт);
	КонецЕсли;	
	
	
	//дополним ки, на всякий 
	//Если ЕстьКИВМассиве =  Ложь
		
	ЕстьКИВМассиве = (ТипЗнч(МассивКИ) = Тип("Массив") и МассивКИ.Количество() >0);
	//создавить будем если есть 
	
	Если СтрукутраПоиска.Количество() = 0
		//и нЕ ЗначениеЗаполнено(Контрагент) 
			и НЕ ЕстьКИВМассиве Тогда 
		Возврат Справочники.СайтПользователи.ПустаяСсылка();
	КонецЕсли;
	
	Если СоздаватьНовыйСпр
		и не ЗначениеЗаполнено(ТекАккаунт) Тогда 
		
		МассивСвойств = Новый Массив;
		МассивСвойств.Добавить("Код");
		МассивСвойств.Добавить("Наименование");
		
		МетаданныеСпр = Метаданные.Справочники.СайтПользователи;
		
		ТекАккаунтОбъект = Справочники.СайтПользователи.СоздатьЭлемент();
		
		Для Каждого ТекПоказатель из СтрукутраПоиска Цикл 
			Имя 		= ТекПоказатель.Ключ;
			Значение	= ПолучитьСтрокуКИБезЛишнихСимволов(ТекПоказатель.Значение);
			Значение	= ПревестиСтрокуКИКФормату(Значение);
			
			Если НЕ ЗначениеЗаполнено(Значение) Тогда 
				Продолжить;
			КонецЕсли;
			
					
			
			Если ОбщегоНазначения.ЕстьРеквизитДокумента(Имя,МетаданныеСпр)
				ИЛИ МассивСвойств.Найти(Имя) <> Неопределено Тогда  				
				
				ТекАккаунтОбъект[Имя] = Значение;	
				
			КонецЕсли;
			
		КонецЦикла;	
		
		
		Если ТипЗнч(ДопРеквизиты) = Тип("Структура") Тогда 
			Для Каждого ТекПоказатель из ДопРеквизиты Цикл 
				
				Имя 		= ТекПоказатель.Ключ;
				Значение	= ПолучитьСтрокуКИБезЛишнихСимволов(ТекПоказатель.Значение);
				Значение	= ПревестиСтрокуКИКФормату(Значение);
				
				Если НЕ ЗначениеЗаполнено(Значение) Тогда 
					Продолжить;
				КонецЕсли;
				
				Если ОбщегоНазначения.ЕстьРеквизитДокумента(Имя,МетаданныеСпр)
					ИЛИ МассивСвойств.Найти(Имя) <> Неопределено Тогда  				
					
					ТекАккаунтОбъект[Имя] = Значение;	
					
				КонецЕсли;
			
		КонецЦикла;	
	
		КонецЕсли;
		
		Если ЕстьКИВМассиве Тогда 
			ТекСтрока = МассивКИ[0];				
			Если НЕ ЗначениеЗаполнено(ТекАккаунтОбъект.Код) Тогда 
				ТекАккаунтОбъект.Код = ТекСтрока;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекАккаунтОбъект.Наименование) Тогда 
				ТекАккаунтОбъект.Наименование = ТекСтрока;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекАккаунтОбъект.КонтактныйТелефон) Тогда 
				ТекАккаунтОбъект.КонтактныйТелефон = ТекСтрока;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекАккаунтОбъект.ЭлектроннаяПочта) Тогда 
				ТекАккаунтОбъект.ЭлектроннаяПочта = ТекСтрока;
			КонецЕсли;
			
			//Нужно заполнить Табличную часть
			Для Каждого ТекСтрокаКИ из МассивКИ Цикл  
				ТекЗначениеКИ	= ПолучитьСтрокуКИБезЛишнихСимволов(ТекСтрокаКИ); 
				ТекЗначениеКИ	= ПревестиСтрокуКИКФормату(ТекЗначениеКИ);
				Если Не ЗначениеЗаполнено(ТекЗначениеКИ) Тогда 
					Продолжить;
				КонецЕсли;
				
				//Если есть @ -это почта
				//Если есть 5-ть цифр это телефон
				
				ЭтоТелефон = ЭтоТелефон(ТекЗначениеКИ);				
				
				ЭтоПочта   = ЭтоЕмайл(ТекЗначениеКИ);
				Если НЕ ЭтоТелефон
					и не ЭтоПочта Тогда 
					Продолжить;
				КонецЕсли;
								
				КИ = ТекАккаунтОбъект.КИ;
				СтрокаКИ = КИ.Найти(ТекЗначениеКИ,"ЗначениеКИ");
				Если СтрокаКИ = Неопределено Тогда 
					НоваяСтрокаКИ = КИ.Добавить();
					НоваяСтрокаКИ.ЗначениеКИ = ТекЗначениеКИ;
					НоваяСтрокаКИ.Тип = ?(ЭтоТелефон,Перечисления.ТипыКонтактнойИнформации.Телефон,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		
		Попытка
			ТекАккаунтОбъект.Комментарий = "Сформирован автоматически!";
			ТекАккаунтОбъект.Записать();
			ТекАккаунт = ТекАккаунтОбъект.Ссылка;
		Исключение
			ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать Аккаунт(" +ТекАккаунтОбъект.Код +" "+ТекАккаунтОбъект.Наименование + ")! Причина:"+ ОписаниеОшибки());

		КонецПопытки;
		
		//
		
	КонецЕсли;
	
	
	Возврат ТекАккаунт;
КонецФункции

Функция ЭтоТелефон(ТекЗначениеКИ)
	
	СтрокаЧисел = "0123456789";
	
	ДлиннаСтроки = СтрДлина(ТекЗначениеКИ);
	
	КоличествоЦифр = 0;
	
	Для сч = 1 по ДлиннаСтроки Цикл 
		ТекСимвол = Сред(ТекЗначениеКИ,сч-1,1); 
		
		Если Найти(СтрокаЧисел,ТекСимвол) > 0 Тогда 
			КоличествоЦифр = КоличествоЦифр + 1;	
		КонецЕсли;		
	КонецЦикла;
	
	
	Возврат (КоличествоЦифр >= 8);
	
КонецФункции


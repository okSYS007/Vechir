#Область ЗагрузкаТаблицыЗначенийИзФайлов
Функция ЗагрузитьТаблицуЗначенийИзФайлаЦСВ(ПутьФайлаЦСВ, КодировкаЦСВ = Неопределено, РазделительЦСВ = ";") Экспорт

	ЗагружаемыйФайл = Новый ТекстовыйДокумент;

	КодировкаТекстаЦСВ = Неопределено;

	Если ТипЗнч(КодировкаЦСВ) = Тип("КодировкаТекста") Тогда
		 КодировкаТекстаЦСВ = КодировкаЦСВ;
	ИначеЕсли КодировкаЦСВ = "ANSI"      Тогда
		 КодировкаТекстаЦСВ = КодировкаТекста.ANSI;
	ИначеЕсли КодировкаЦСВ = "OEM"       Тогда
		 КодировкаТекстаЦСВ = КодировкаТекста.OEM;
	ИначеЕсли КодировкаЦСВ = "UTF8"      Тогда
		 КодировкаТекстаЦСВ = КодировкаТекста.UTF8;
	ИначеЕсли КодировкаЦСВ = "UTF16"     Тогда
		 КодировкаТекстаЦСВ = КодировкаТекста.UTF16;
	ИначеЕсли КодировкаЦСВ = "Системная" Тогда
		 КодировкаТекстаЦСВ = КодировкаТекста.Системная;
	КонецЕсли;

	Если КодировкаТекстаЦСВ = Неопределено Тогда
		ЗагружаемыйФайл.Прочитать(ПутьФайлаЦСВ);
	Иначе
		ЗагружаемыйФайл.Прочитать(ПутьФайлаЦСВ, КодировкаТекстаЦСВ);
	КонецЕсли;

	Поля = ЗаполнитьШапку(ЗагружаемыйФайл, РазделительЦСВ);
	МассивСтрок = ЗаполнитьСтроки(Поля, ЗагружаемыйФайл, РазделительЦСВ);
	ТабЗначений = ЗаполнитьТаблицу(Поля, МассивСтрок);

	Возврат ТабЗначений;

КонецФункции

Функция ЗаполнитьШапку(ЗагружаемыйФайл, Знач Разделитель)

	БезымяннаяКолонка = "Столбец";

	Поля = Новый Массив;

	Шапка = ЗагружаемыйФайл.ПолучитьСтроку(1);
	РазбитаяШапка = РазложитьСтрокуВМассивПодстрок(Шапка, Разделитель);
	Колонок = РазбитаяШапка.Количество()-1;

	Для Номер=0 По Колонок Цикл
		ИмяКолонки = ПолучитьИмяКолонки(РазбитаяШапка[Номер], Поля);
		Если ПустаяСтрока(ИмяКолонки) Тогда
			ИмяКолонки = БезымяннаяКолонка + Номер;
		КонецЕсли;
		Поля.Добавить(ИмяКолонки);
	КонецЦикла;

	Возврат Поля;

КонецФункции

Функция ЗаполнитьСтроки(Поля, ЗагружаемыйФайл, Знач Разделитель)

	БезымяннаяКолонка = "Столбец";
	ВсегоСтрок = ЗагружаемыйФайл.КоличествоСтрок();

	МассивСтрок = Новый Массив;

	МногострочнаяСтрока = Ложь;
	НоваяСтрока = Неопределено;
	ИндексСтолбца = -1;

	Для НомерСтроки=2 по ВсегоСтрок Цикл

		Строка = ЗагружаемыйФайл.ПолучитьСтроку(НомерСтроки);
		МассивКол = РазложитьСтрокуВМассивПодстрок(Строка, Разделитель);

		Предел = МассивКол.Количество();
		КолвоКолонок = Поля.Количество();

		Если Предел > КолвоКолонок Тогда
			Для Номер=КолвоКолонок По Предел Цикл
				ИмяКолонки = БезымяннаяКолонка + Номер;
				Поля.Добавить(ИмяКолонки);
			КонецЦикла;
		КонецЕсли;

		Если НЕ МногострочнаяСтрока Тогда
			ИндексСтолбца = -1;
			НоваяСтрока = Новый Структура;
			МассивСтрок.Добавить(НоваяСтрока);
		КонецЕсли;

		Для НомерСтолбца=1 по Предел Цикл

			ТекущееЗначение	= МассивКол[НомерСтолбца-1];

			НачалоСтроки = СтрДлина(ТекущееЗначение) > 0 И  Лев(ТекущееЗначение, 1) = """";
			КонецСтроки  = СтрДлина(ТекущееЗначение) > 1 И Прав(ТекущееЗначение, 1) = """";

			Если МногострочнаяСтрока Тогда

				ТекущееПоле = Поля[ИндексСтолбца];

				НоваяСтрока[ТекущееПоле]
					= НоваяСтрока[ТекущееПоле]
					+ ?(НомерСтолбца=1, Символы.ПС, Разделитель)
					+ ТекущееЗначение
				;

				Если КонецСтроки Тогда
					МногострочнаяСтрока = Ложь;
				КонецЕсли;

				Продолжить;

			КонецЕсли;

			Если НачалоСтроки И НЕ КонецСтроки Тогда
				МногострочнаяСтрока = Истина;
			КонецЕсли;

			ИндексСтолбца	= ИндексСтолбца + 1;
			ТекущееПоле		= Поля[ИндексСтолбца];
			НоваяСтрока.Вставить(ТекущееПоле, ТекущееЗначение);

		КонецЦикла;

	КонецЦикла;

	Возврат МассивСтрок;

КонецФункции

Функция ЗаполнитьТаблицу(Поля, МассивСтрок)

	ТабЗначений = Новый ТаблицаЗначений;

	Если ТипЗнч(Поля) = Тип("Соответствие") Тогда
		Для Каждого Поле Из Поля Цикл
			ТабЗначений.Колонки.Добавить(Поле.Ключ);
		КонецЦикла;
	Иначе
		Для Каждого Поле Из Поля Цикл
			ТабЗначений.Колонки.Добавить(Поле);
		КонецЦикла;
	КонецЕсли;

	ВсегоЗаписей = МассивСтрок.Количество();

	Для Каждого Строчка Из МассивСтрок Цикл
		СтрокаТЗ = ТабЗначений.Добавить();
		Для Каждого Элемент Из Строчка Цикл
			СтрокаТЗ[Элемент.Ключ] = Элемент.Значение;
		КонецЦикла;
	КонецЦикла;

	Возврат ТабЗначений;

КонецФункции

Функция ПолучитьИмяКолонки(ИмяСтолбца, Поля)

	ИмяКолонки = СтрЗаменить(ИмяСтолбца, " ", "_");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "(", "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, ")", "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "-", "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "/", "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "\", "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "%", "Процент");
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "№", "Номер");

	Попытка
		Результ = Число(Лев(ИмяКолонки, 1));
		ИмяКолонки = "_" + ИмяКолонки;
	Исключение
	КонецПопытки;

	ИДХ = 0;
	УникальноеИмяКолонки = ИмяКолонки;
	Пока Поля.Найти(УникальноеИмяКолонки) <> Неопределено Цикл
		ИДХ = ИДХ + 1;
		УникальноеИмяКолонки = ИмяКолонки + ИДХ;
	КонецЦикла;
	ИмяКолонки = УникальноеИмяКолонки;

	Возврат ИмяКолонки;

КонецФункции

Функция РазложитьСтрокуВМассивПодстрок(
	Знач Строка,
	Знач Разделитель = ",",
    Знач ПропускатьПустыеСтроки = Неопределено
)

    Результат = Новый Массив;

    // для обеспечения обратной совместимости
    Если ПропускатьПустыеСтроки = Неопределено Тогда
        ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
        Если ПустаяСтрока(Строка) Тогда 
            Если Разделитель = " " Тогда
                Результат.Добавить("");
            КонецЕсли;
            Возврат Результат;
        КонецЕсли;
    КонецЕсли;
    //

    Позиция = Найти(Строка, Разделитель);
    Пока Позиция > 0 Цикл
        Подстрока = Лев(Строка, Позиция - 1);
        Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
            Результат.Добавить(Подстрока);
        КонецЕсли;
        Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
        Позиция = Найти(Строка, Разделитель);
    КонецЦикла;
 
    Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
        Результат.Добавить(Строка);
    КонецЕсли;

    Возврат Результат;

КонецФункции
#КонецОбласти

Процедура ПроставитьИндексыЧередующейсяПодсветки(ТаблицаДанных, Знач ИмяКолонки = Неопределено, ВариантовПодсветки = 2, ЗамещатьОтрицательные = Ложь, ЗамещатьИзбыточные = Ложь) Экспорт

	ВсегоСтрок = ТаблицаДанных.Количество();

	Если ВсегоСтрок < 1 Тогда
		Возврат;
	КонецЕсли;

	ЛимитСтрок = ВсегоСтрок - 1;

	ИмяКолонки = ?(ИмяКолонки = Неопределено, "ИдПодсветки", ИмяКолонки);

	Для ИДХ=0 По ЛимитСтрок Цикл

		СтрокаТД = ТаблицаДанных[ИДХ];
		ТекИд = СтрокаТД[ИмяКолонки];

		Если (НЕ ЗамещатьОтрицательные И (ТекИд < 0))
		 ИЛИ (НЕ ЗамещатьИзбыточные И (ТекИд >= ВариантовПодсветки))
		Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТД[ИмяКолонки] = ИДХ % ВариантовПодсветки;

	КонецЦикла;

КонецПроцедуры

Функция СфСоотвВебЦветовНаименованиям() Экспорт

	СоотвВебЦветов = Новый Соответствие;

	Для Каждого ВебЦвет Из СоотвВебЦветов Цикл
		СоотвВебЦветов.Вставить(Строка(ВебЦвет), ВебЦвет);
	КонецЦикла;

	Возврат СоотвВебЦветов;

КонецФункции

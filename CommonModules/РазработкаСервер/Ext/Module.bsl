Функция ДобавитьЗаписьВРегистрСтататистикаПоАдресам(ТЗ)
	
	Для Каждого СтрокаТЗ из ТЗ цикл
				
				МассивДляЗаписи = новый Массив;
				МассивДляЗаписи.Добавить(СтрокаТЗ.Статистика);
				
				Запись        = Новый ЗаписьJSON;
				Запись.УстановитьСтроку();
				ЗаписатьJSON(Запись,МассивДляЗаписи);
				Статистика = Запись.Закрыть();

				
				
				
				Набор_spСтатистикаАдресовПоКомпании = РегистрыСведений.spСтатистикаАдресовПоКомпании.СоздатьНаборЗаписей();
				Набор_spСтатистикаАдресовПоКомпании.Отбор.ЭлектронныйАдрес.Установить(СтрокаТЗ.ЭлектронныйАдрес);
				Набор_spСтатистикаАдресовПоКомпании.Прочитать();
				
				Если Набор_spСтатистикаАдресовПоКомпании.Количество() = 0 Тогда
					Запись_spСтатистикаАдресовПоКомпании                    = Набор_spСтатистикаАдресовПоКомпании.Добавить();	
					Запись_spСтатистикаАдресовПоКомпании.ЭлектронныйАдрес	= СтрокаТЗ.ЭлектронныйАдрес;
					Запись_spСтатистикаАдресовПоКомпании.Статистика         = Статистика;
				Иначе 
					Запись_spСтатистикаАдресовПоКомпании = Набор_spСтатистикаАдресовПоКомпании[0];
					СтатистикаВРегистре                  = Запись_spСтатистикаАдресовПоКомпании.Статистика;
					
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(СтатистикаВРегистре);
					ДанныеСтатистикиВРегистре = ПрочитатьJSON(Чтение);
					Чтение.Закрыть();				
					
					Для Каждого СтрокаДанныхВРегистре Из ДанныеСтатистикиВРегистре Цикл 
						Если СтрокаДанныхВРегистре.IDКампании <> СтрокаТЗ.IDКампании Тогда  
							
							МассивДляЗаписи.Добавить(СтрокаДанныхВРегистре);
						Иначе
							
						КонецЕсли;
					КонецЦикла;
					
					Запись            = Новый ЗаписьJSON;
					Запись.УстановитьСтроку();
					ЗаписатьJSON(Запись,МассивДляЗаписи);
					Статистика = Запись.Закрыть();
					Набор_spСтатистикаАдресовПоКомпании[0].Статистика = Статистика;
				
			КонецЕсли;
			ЗапросКИ = Новый Запрос;
			ЗапросКИ.Текст = "ВЫБРАТЬ
			|	КонтактнаяИнформация.Ссылка
			|ИЗ
			|	Справочник.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.ВидЛогина = 2
			|	И КонтактнаяИнформация.Наименование = &Наименование";
			ЗапросКИ.УстановитьПараметр("Наименование",СтрокаТЗ.ЭлектронныйАдрес);
			РезультатЗапросаКИ = ЗапросКИ.Выполнить().Выбрать();

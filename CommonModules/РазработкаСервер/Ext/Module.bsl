Функция ПолучитьМассивПрименяемостиМодели(ГруппаКроссов, Временная = NULL) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрименяемостьМодели.Модель
		|ИЗ
		|	РегистрСведений.ПрименяемостьМодели КАК ПрименяемостьМодели
		|ГДЕ
		|	ПрименяемостьМодели.ГруппаКроссов = &ГруппаКроссов
		|И
		|	ВЫБОР
		|		КОГДА &Временная IS NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ Временная = &Временная
		|	КОНЕЦ
		|";

	Запрос.УстановитьПараметр("ГруппаКроссов", ГруппаКроссов);
	Запрос.УстановитьПараметр("Временная", Временная);

	РезультатЗапроса = Запрос.Выполнить();

	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	МассивРезультата = ТаблицаРезультата.ВыгрузитьКолонку("Модель");

	Возврат МассивРезультата;

КонецФункции


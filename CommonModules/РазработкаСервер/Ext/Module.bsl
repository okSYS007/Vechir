Функция ПолучитьИмяЗначенияПеречисления(Знач ЗначениеПеречисления) Экспорт
	ИмяПеречисления = ПолучитьИмяПеречисления(ЗначениеПеречисления);
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);
	ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
	Возврат ИмяЗначенияПеречисления;
КонецФункции

Функция СоответствиеИмяЗначениеПеречисления(ИмяПеречисления) Экспорт

	СоотвИмяЗначениеПеречисления = Новый Соответствие;

	ДанныеВыбора = ДанныеВыбораПеречисления(ИмяПеречисления);

	Для Каждого ЭлементСписка Из ДанныеВыбора Цикл

		ЗначениеПеречисления = ЭлементСписка.Значение.Значение;
		ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);
		ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;

		СоотвИмяЗначениеПеречисления.Вставить(ИмяЗначенияПеречисления, ЗначениеПеречисления);

	КонецЦикла;

	Возврат СоотвИмяЗначениеПеречисления;


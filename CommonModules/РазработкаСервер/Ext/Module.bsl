Функция СократитьСлово(Знач Слово, Знач НомерКластера = 1, Знач ДобавитьСимволСокр = Ложь, Знач СимволСокр = ".") Экспорт

	СоотвГласныхРедуцированных = Новый Соответствие;

	МассивНейотированных	= ПолучитьМассивГласныхНейотированныхБукв();
	МассивЙотированных		= ПолучитьМассивГласныхЙотированныхБукв();
	МассивРедуцированных	= ПолучитьМассивРедуцированныхБукв();

	Для Каждого Буква Из МассивНейотированных Цикл
		СоотвГласныхРедуцированных.Вставить(Буква, Истина);
	КонецЦикла;

	Для Каждого Буква Из МассивЙотированных Цикл
		СоотвГласныхРедуцированных.Вставить(Буква, Истина);
	КонецЦикла;

	Для Каждого Буква Из МассивРедуцированных Цикл
		СоотвГласныхРедуцированных.Вставить(Буква, Истина);
	КонецЦикла;

	СловоСокр = "";

	ДлинаСлова = СтрДлина(Слово);

	ТекКластер		= 1;
	ПредГласная		= Ложь;

	Для ИДХ=1 По ДлинаСлова Цикл

		ТекСимвол = Сред(Слово, ИДХ, 1);

		ТекГласная = СоотвГласныхРедуцированных.Получить(ТекСимвол);

		Если ТекГласная Тогда
			Если НЕ ПредГласная Тогда

				ТекКластер = ТекКластер + 1;

				Если ТекКластер >= НомерКластера Тогда
					Прервать;
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;

		ПредГласная = ТекГласная;

		СловоСокр = СловоСокр + ТекСимвол;

	КонецЦикла;

	Если ДобавитьСимволСокр И (СловоСокр <> Слово) Тогда
		СловоСокр = СловоСокр + СимволСокр;
	КонецЕсли;

	Возврат СловоСокр;

КонецФункции

Функция ОдносимвольныйКодИзЧисла(Знач ИсхЧисло) Экспорт

	Если ТипЗнч(ИсхЧисло) <> Тип("Число") Тогда
		ВызватьИсключение "Допустимо преобразовать только число.";
	КонецЕсли;

	Если ИсхЧисло < 0 Тогда
		ВызватьИсключение "Нельзя преобразовать отрицательное число.";
	КонецЕсли;

	Если ИсхЧисло < 10 Тогда
		Возврат Строка(ИсхЧисло);
	КонецЕсли;

	Усечение = ИсхЧисло - 10;

	КодЛатА = КодСимвола("A");
	КодЛатЯ = КодСимвола("Z");

	КодРезульт = КодЛатА + Усечение;

	Если КодРезульт <= КодЛатЯ Тогда
		Результат = Символ(КодРезульт);
		Возврат Результат;
	КонецЕсли;

	РазностьКодов = КодЛатЯ - КодЛатА + 1;

	Усечение = Усечение - РазностьКодов;

	КодКирА = КодСимвола("а");
	КодКирЯ = КодСимвола("я");

	КодРезульт = КодКирА + Усечение;

	Если КодРезульт <= КодКирЯ Тогда
		Результат = Символ(КодРезульт);
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение "Число к преобразованию слишком большое.";

КонецФункции


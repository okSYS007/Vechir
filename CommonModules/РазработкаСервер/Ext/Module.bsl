Функция ЭлектронныеАдресаАккаунта(Аккаунт,Компания=Неопределено)
	Если ЗначениеЗаполнено(Компания) Тогда 
		Если ЗначениеЗаполнено(Компания.АдреснаяКнига) Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	spАдресныеКнигиПолучатели.Адрес КАК ЭлектронныйАдрес
			|ИЗ
			|	Справочник.spАдресныеКниги.Получатели КАК spАдресныеКнигиПолучатели
			|ГДЕ
			|	НЕ spАдресныеКнигиПолучатели.Ссылка.ПометкаУдаления
			|	И spАдресныеКнигиПолучатели.Ссылка.Аккаунт = &Аккаунт
			|	И spАдресныеКнигиПолучатели.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	spАдресныеКнигиПолучатели.Адрес";
			Запрос.УстановитьПараметр("Аккаунт",Аккаунт);
			Запрос.УстановитьПараметр("Ссылка" ,Компания.АдреснаяКнига);
			Возврат Запрос.Выполнить().Выгрузить();
			
		КонецЕсли;	
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	spАдресныеКнигиПолучатели.Адрес КАК ЭлектронныйАдрес
	|ИЗ
	|	Справочник.spАдресныеКниги.Получатели КАК spАдресныеКнигиПолучатели
	|ГДЕ
	|	НЕ spАдресныеКнигиПолучатели.Ссылка.ПометкаУдаления
	|	И spАдресныеКнигиПолучатели.Ссылка.Аккаунт = &Аккаунт
	|
	|СГРУППИРОВАТЬ ПО
	|	spАдресныеКнигиПолучатели.Адрес";
	Запрос.УстановитьПараметр("Аккаунт", Аккаунт);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьМассивКомпанийАккаунта(Аккаунт)
			
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	spКомпании.Ссылка КАК Компания
	|ИЗ
	|	Справочник.spКомпании КАК spКомпании
	|ГДЕ
	|	spКомпании.Аккаунт = &Аккаунт
	|	И НЕ spКомпании.ПометкаУдаления
	|	И spКомпании.send_date >= &send_date
	|	И spКомпании.СтатусСтрока ПОДОБНО &СтатусСтрока
	|	И spКомпании.АдреснаяКнига <> &АдреснаяКнига";
	Запрос.УстановитьПараметр("Аккаунт", Аккаунт);
	Запрос.УстановитьПараметр("send_date", ТекущаяДата()-360*60*60*24);
	Запрос.УстановитьПараметр("send_date", ТекущаяДата()-180*60*60*24);
	Запрос.УстановитьПараметр("СтатусСтрока","Отправлено");
	Запрос.УстановитьПараметр("АдреснаяКнига",Справочники.spАдресныеКниги.ПустаяСсылка());

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Компания");
	
		
	

	СоотвРусЛат.Вставить("Ь", "J");
	СоотвРусЛат.Вставить("ь", "j");

	СоотвРусЛат.Вставить("Э", "E");
	СоотвРусЛат.Вставить("э", "e");

	СоотвРусЛат.Вставить("Ю", "Yu");
	СоотвРусЛат.Вставить("ю", "yu");

	СоотвРусЛат.Вставить("Я", "Ya");
	СоотвРусЛат.Вставить("я", "ya");

	МассивСимволов = Новый Массив;

	ДлинаСтроки = СтрДлина(ВходнаяСтрока);

	Для ИДХ=1 По ДлинаСтроки Цикл

		ТекСимвол = Сред(ВходнаяСтрока, ИДХ, 1);

		Замена = СоотвРусЛат.Получить(ТекСимвол);

		Если Замена = Неопределено Тогда
			Замена = ТекСимвол;
		КонецЕсли;

		МассивСимволов.Добавить(Замена);


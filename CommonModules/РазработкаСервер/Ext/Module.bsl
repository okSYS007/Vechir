Функция ПолучитьСтрокуКИБезЛишнихСимволов(ВходящаяСтркоа) Экспорт 
	
	ТекСтрокаЗначение = СокрЛП(ВходящаяСтркоа);
	ТекСтрокаЗначение = СтрЗаменить(ТекСтрокаЗначение,"+","");
	ТекСтрокаЗначение = СтрЗаменить(ТекСтрокаЗначение,"(","");
	ТекСтрокаЗначение = СтрЗаменить(ТекСтрокаЗначение,")","");	
	ТекСтрокаЗначение = СтрЗаменить(ТекСтрокаЗначение," ","");	
	ТекСтрокаЗначение = СтрЗаменить(ТекСтрокаЗначение,Символы.НПП,"");	
	
	Возврат ТекСтрокаЗначение;
	
КонецФункции

Функция ПревестиСтрокуКИКФормату(Знач ТекЗначениеКИ, Тип = 0, ИгнорироватьТип = Ложь) Экспорт 
	
	ЭтоТелефон = (ЭтоТелефон(ТекЗначениеКИ) и ((ЗначениеЗаполнено(Тип) и Тип = Перечисления.ТипыКонтактнойИнформации.Телефон) ИЛИ ИгнорироватьТип = Истина) );
	Если ЭтоТелефон =  Истина Тогда 
		
		ТекЗначениеКИ = СтрЗаменить(ТекЗначениеКИ,"+","");
		
		ЛевыйСивол = Лев(ТекЗначениеКИ,1);	
		
		
		//пропускаем телефонны начинающиеся на 3
		Если ЛевыйСивол = "3" Тогда 
			ТекЗначениеКИ = ТекЗначениеКИ;		
		ИначеЕсли  ЛевыйСивол <> "7" Тогда 
			ТекЗначениеКИ = "7"+ТекЗначениеКИ;	
		КонецЕсли;		
		
		ТекЗначениеКИ = "+"+ТекЗначениеКИ;
		
	КонецЕсли;

	Возврат ТекЗначениеКИ;
	
КонецФункции

// + ДДГ
Функция ОчиститьНомерТелефона(Знач СтрокаНомера) Экспорт

	Очищенный = СтрокаНомера;

	Очищенный = СтрЗаменить(Очищенный, " ", "");
	Очищенный = СтрЗаменить(Очищенный, Символы.НПП, "");
	Очищенный = СтрЗаменить(Очищенный, Символы.Таб, "");
	Очищенный = СтрЗаменить(Очищенный, "(", "");
	Очищенный = СтрЗаменить(Очищенный, ")", "");
	Очищенный = СтрЗаменить(Очищенный, "-", "");
	Очищенный = СтрЗаменить(Очищенный, "+", "");

	Возврат Очищенный;

КонецФункции

Функция ОптимизироватьПробелы(Знач ВходнаяСтрока, УбратьЛП = Ложь, ЗаменитьТаб = Ложь, ЗаменитьНПП = Ложь, ЗаменитьПС = Ложь) Экспорт

	Очищенный = ВходнаяСтрока;

	Если УбратьЛП Тогда
		Очищенный = СокрЛП(Очищенный);
	КонецЕсли;

	Если ЗаменитьТаб Тогда
		Очищенный = СтрЗаменить(Очищенный, Символы.Таб, " ");
	КонецЕсли;

	Если ЗаменитьНПП Тогда
		Очищенный = СтрЗаменить(Очищенный, Символы.НПП, " ");
	КонецЕсли;

	Если ЗаменитьПС Тогда
		Очищенный = СтрЗаменить(Очищенный, Символы.ПС, " ");
		Очищенный = СтрЗаменить(Очищенный, Символы.ВК, " ");
	КонецЕсли;

	ДлинаСтроки = СтрДлина(Очищенный);

	Пока Истина Цикл

		ОчищенныйОтПробелов = СтрЗаменить(Очищенный, "  ", " ");

		ДлинаОчищенного = СтрДлина(ОчищенныйОтПробелов);

		Если ДлинаСтроки = ДлинаОчищенного Тогда
			Прервать;
		КонецЕсли;

		Очищенный   = ОчищенныйОтПробелов;
		ДлинаСтроки = ДлинаОчищенного;

	КонецЦикла;

	Возврат Очищенный;

КонецФункции

Функция ЭтоСимволРусскогоАлфавита(Знач Символ) Экспорт

	КодТекСимв	= КодСимвола(Символ);

	ЛимитПервойБуквы		= КодСимвола("А") - 1;
	ЛимитПоследнейБуквы		= КодСимвола("я") + 1;

	КодБуквыЁ_ЗАГЛ	= КодСимвола("Ё");
	КодБуквыЁ_строч	= КодСимвола("ё");

	Результат
		= (КодТекСимв > ЛимитПервойБуквы
			И КодТекСимв < ЛимитПоследнейБуквы)
		ИЛИ КодТекСимв = КодБуквыЁ_ЗАГЛ
		ИЛИ КодТекСимв = КодБуквыЁ_строч
	;

	Возврат Результат;

КонецФункции

Функция ЭтоСловоИзБуквРусскогоАлфавита(Знач ВходнаяСтрока) Экспорт

	Результат = Ложь;

	ДлинаСтроки = СтрДлина(ВходнаяСтрока);

	Если ДлинаСтроки < 1 Тогда
		Возврат Результат;
	КонецЕсли;

	ЛимитПервойБуквы		= КодСимвола("А") - 1;
	ЛимитПоследнейБуквы		= КодСимвола("я") + 1;

	КодБуквыЁ_ЗАГЛ	= КодСимвола("Ё");
	КодБуквыЁ_строч	= КодСимвола("ё");

	Для ИДХ = 1 По ДлинаСтроки Цикл

		ТекСимв		= Сред(ВходнаяСтрока, ИДХ, 1);
		КодТекСимв	= КодСимвола(ТекСимв);

		Результат
			= (КодТекСимв > ЛимитПервойБуквы
				И КодТекСимв < ЛимитПоследнейБуквы)
			ИЛИ КодТекСимв = КодБуквыЁ_ЗАГЛ
			ИЛИ КодТекСимв = КодБуквыЁ_строч
		;

		Если НЕ Результат Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// возвращает 0 если нельзя преобразовать
Функция ПреобразоватьСтрокуВЧисло(Знач ВходнаяСтрока, Очищать = Ложь, МаксДлинаЧисла = 0, МаксДлинаСтроки = 0) Экспорт

	Результат = 0;

	Очищенный = ВходнаяСтрока;

	//

	Если МаксДлинаСтроки > 0 Тогда

		ДлинаСтроки = СтрДлина(Очищенный);

		Если ДлинаСтроки > МаксДлинаСтроки Тогда
			Возврат Результат;
		КонецЕсли;

	КонецЕсли;

	//

	Если Очищать Тогда
		Очищенный = СтрЗаменить(Очищенный, " ", "");
		Очищенный = СтрЗаменить(Очищенный, Символы.НПП, "");
		Очищенный = СтрЗаменить(Очищенный, Символы.Таб, "");
	КонецЕсли;

	//

	Если МаксДлинаЧисла > 0 Тогда

		ДлинаСтроки = СтрДлина(Очищенный);

		Если ДлинаСтроки > МаксДлинаЧисла Тогда
			Возврат Результат;
		КонецЕсли;

	КонецЕсли;

	//

	Попытка
		Результат = Число(Очищенный);
	Исключение
	КонецПопытки;

	//

	Возврат Результат;

КонецФункции

// возвращает форматированную строку
Функция ВыделитьПодстрокуСтроки(
	  Представление
	, СтрокаВыделения
	, ШрифтПодсветки = Неопределено
	, ЦветПодсветки  = Неопределено
	, ТолькоПервоеВхождение = Ложь
) Экспорт

	МассивРезультата = Новый Массив;

	НРегПредставление	= НРег(Представление);
	НРегВыделения		= НРег(СтрокаВыделения);

	ДлинаПредставления	= СтрДлина(НРегПредставление);
	ДлинаВыделения		= СтрДлина(НРегВыделения);

		Если ШрифтПодсветки = Неопределено Тогда
			ШрифтПодсветки = Новый Шрифт(, , Истина);
		КонецЕсли;

		Если ЦветПодсветки = Неопределено Тогда
			ЦветПодсветки = Новый Цвет(230, 20, 20);
		КонецЕсли;

	Пока Истина Цикл

		Позиция = Найти(НРегПредставление, НРегВыделения);

		Если Позиция < 1 Тогда

			МассивРезультата.Добавить(Новый ФорматированнаяСтрока(Представление));

			Прервать;

		ИначеЕсли Позиция = 1 Тогда	// выделение в начале строки

			Если ДлинаПредставления = ДлинаВыделения Тогда

				МассивРезультата.Добавить(Новый ФорматированнаяСтрока(Представление, ШрифтПодсветки, ЦветПодсветки));

				Прервать;

			Иначе

				ВыделеннаяЧасть	= Лев(Представление, ДлинаВыделения);
				Выделение		= Новый ФорматированнаяСтрока(ВыделеннаяЧасть, ШрифтПодсветки, ЦветПодсветки);

				ОстальнаяЧасть	= Прав(Представление, ДлинаПредставления - ДлинаВыделения);
				Остальное		= Новый ФорматированнаяСтрока(ОстальнаяЧасть);

				МассивРезультата.Добавить(Выделение);
//				МассивРезультата.Добавить(Остальное);

				Представление		= Остальное;

			КонецЕсли;

		ИначеЕсли (Позиция + ДлинаВыделения) > ДлинаПредставления Тогда	// выделение в конце строки

			ВыделеннаяЧасть	= Прав(Представление, ДлинаВыделения);
			Выделение		= Новый ФорматированнаяСтрока(ВыделеннаяЧасть, ШрифтПодсветки, ЦветПодсветки);

			ОстальнаяЧасть	= Лев(Представление, ДлинаПредставления - ДлинаВыделения);
			Остальное		= Новый ФорматированнаяСтрока(ОстальнаяЧасть);

			МассивРезультата.Добавить(Остальное);
			МассивРезультата.Добавить(Выделение);

			Прервать;

		Иначе 	// выделение в середине строки

			ВыделеннаяЧасть		= Сред(Представление, Позиция, ДлинаВыделения);
			Выделение			= Новый ФорматированнаяСтрока(ВыделеннаяЧасть, ШрифтПодсветки, ЦветПодсветки);

			ЧастьДоВыделения	= Лев(Представление, Позиция - 1);
			ДоВыделения			= Новый ФорматированнаяСтрока(ЧастьДоВыделения);

			ЧастьПослеВыделения	= Прав(Представление, ДлинаПредставления - Позиция - ДлинаВыделения + 1);
			ПослеВыделения		= Новый ФорматированнаяСтрока(ЧастьПослеВыделения);

			МассивРезультата.Добавить(ДоВыделения);
			МассивРезультата.Добавить(Выделение);
//			МассивРезультата.Добавить(ПослеВыделения);

			Представление		= ПослеВыделения;

		КонецЕсли;

		Если ТолькоПервоеВхождение Тогда
			МассивРезультата.Добавить(Представление);
			Прервать;
		КонецЕсли;

		НРегПредставление	= НРег(Представление);
		ДлинаПредставления	= СтрДлина(НРегПредставление);

	КонецЦикла;

	Результат = Новый ФорматированнаяСтрока(МассивРезультата);

	Возврат Результат;

КонецФункции

Функция ДополнитьКонечнымСлэшем(ВходнаяСтрока, ВиндовыйСлэш = Истина) Экспорт

	СтрокаРезультат = ВходнаяСтрока;

	СимволСлэша = ?(ВиндовыйСлэш, "\", "/");

	ДлинаСтроки = СтрДлина(СтрокаРезультат);

	Если ДлинаСтроки < 1 Тогда
		Возврат СтрокаРезультат;
	КонецЕсли;

	ПоследнийСимвол = Прав(СтрокаРезультат, 1);

	Если ПоследнийСимвол = "\" ИЛИ ПоследнийСимвол = "/" Тогда
		Возврат СтрокаРезультат;
	КонецЕсли;

	СтрокаРезультат = СтрокаРезультат + СимволСлэша;

	Возврат СтрокаРезультат;

КонецФункции

Функция Между(Значение, НаименьшееЗначение, НаибольшееЗначение) Экспорт
	Возврат Значение >= НаименьшееЗначение И Значение <= НаибольшееЗначение;
КонецФункции

Функция ИзвлечьИзСтрокиТолькоБуквыЦифры(
	  Знач ВходнаяСтрока
	, Знач ТолькоЛатиница	= Ложь
	, Знач РазрешитьПробелы	= Ложь
	, Знач РазрешитьДефисы	= Ложь
) Экспорт

	Если Не ЗначениеЗаполнено(ВходнаяСтрока) Тогда
		Возврат "";
	КонецЕсли;

	КодПервойЦифры		= КодСимвола("0");
	КодПоследнейЦифры	= КодСимвола("9");

	КодПервойБуквыЛатЗАГЛ		= КодСимвола("A");
	КодПоследнейБуквыЛатЗАГЛ	= КодСимвола("Z");

	КодПервойБуквыЛатСтроч		= КодСимвола("a");
	КодПоследнейБуквыЛатСтроч	= КодСимвола("z");

	КодПервойБуквыКирЗАГЛ		= КодСимвола("А");
	КодПоследнейБуквыКирЗАГЛ	= КодСимвола("Я");

	КодПервойБуквыКирСтроч		= КодСимвола("а");
	КодПоследнейБуквыКирСтроч	= КодСимвола("я");

	КодБуквыЁ_ЗАГЛ	= КодСимвола("Ё");
	КодБуквыЁ_строч	= КодСимвола("ё");

	КодПробела = КодСимвола(" ");
	КодДефиса  = КодСимвола("-");

	СтрокаРезультат = "";

	ВходнаяСтрока = СокрЛП(ВходнаяСтрока);

	ДлинаСтроки = СтрДлина(ВходнаяСтрока);

	Для ИДХ=1 По ДлинаСтроки Цикл

		ТекСимв		= Сред(ВходнаяСтрока, ИДХ, 1);
		КодТекСимв	= КодСимвола(ТекСимв);

		Если Между(КодТекСимв, КодПервойЦифры,			КодПоследнейЦифры)
		 ИЛИ Между(КодТекСимв, КодПервойБуквыЛатЗАГЛ,	КодПоследнейБуквыЛатЗАГЛ)
		 ИЛИ Между(КодТекСимв, КодПервойБуквыЛатСтроч,	КодПоследнейБуквыЛатСтроч)
		 ИЛИ (НЕ ТолькоЛатиница И (
			     Между(КодТекСимв, КодПервойБуквыКирЗАГЛ,	КодПоследнейБуквыКирЗАГЛ)
			 ИЛИ Между(КодТекСимв, КодПервойБуквыКирСтроч,	КодПоследнейБуквыКирСтроч)
			 ИЛИ КодТекСимв = КодБуквыЁ_ЗАГЛ
			 ИЛИ КодТекСимв = КодБуквыЁ_строч
		 ))
		 ИЛИ (РазрешитьПробелы И КодТекСимв = КодПробела)
		 ИЛИ (РазрешитьДефисы  И КодТекСимв = КодДефиса)
		Тогда
			СтрокаРезультат = СтрокаРезультат + ТекСимв;
		КонецЕсли;

	КонецЦикла;

	Возврат СтрокаРезультат;

КонецФункции

Функция ЭтаСтрокаСостоитИзБуквИлиЦифр(Знач ВходнаяСтрока, Знач ТолькоЛатиница = Ложь, Знач ДаЕслиПустая = Истина) Экспорт

	Если Не ЗначениеЗаполнено(ВходнаяСтрока) Тогда
		Возврат ДаЕслиПустая;
	КонецЕсли;

	КодПервойЦифры		= КодСимвола("0");
	КодПоследнейЦифры	= КодСимвола("9");

	КодПервойБуквыЛатЗАГЛ		= КодСимвола("A");
	КодПоследнейБуквыЛатЗАГЛ	= КодСимвола("Z");

	КодПервойБуквыЛатСтроч		= КодСимвола("a");
	КодПоследнейБуквыЛатСтроч	= КодСимвола("z");

	КодПервойБуквыКирЗАГЛ		= КодСимвола("А");
	КодПоследнейБуквыКирЗАГЛ	= КодСимвола("Я");

	КодПервойБуквыКирСтроч		= КодСимвола("а");
	КодПоследнейБуквыКирСтроч	= КодСимвола("я");

	КодБуквыЁ_ЗАГЛ	= КодСимвола("Ё");
	КодБуквыЁ_строч	= КодСимвола("ё");

	ДлинаСтроки = СтрДлина(ВходнаяСтрока);

	Результат = Истина;

	Для ИДХ=1 По ДлинаСтроки Цикл

		ТекСимв		= Сред(ВходнаяСтрока, ИДХ, 1);
		КодТекСимв	= КодСимвола(ТекСимв);

		Результат = Результат И (
		     Между(КодТекСимв, КодПервойЦифры,			КодПоследнейЦифры)
		 ИЛИ Между(КодТекСимв, КодПервойБуквыЛатЗАГЛ,	КодПоследнейБуквыЛатЗАГЛ)
		 ИЛИ Между(КодТекСимв, КодПервойБуквыЛатСтроч,	КодПоследнейБуквыЛатСтроч)
		 ИЛИ (НЕ ТолькоЛатиница И (
			     Между(КодТекСимв, КодПервойБуквыКирЗАГЛ,	КодПоследнейБуквыКирЗАГЛ)
			 ИЛИ Между(КодТекСимв, КодПервойБуквыКирСтроч,	КодПоследнейБуквыКирСтроч)
			 ИЛИ КодТекСимв = КодБуквыЁ_ЗАГЛ
			 ИЛИ КодТекСимв = КодБуквыЁ_строч
			))
		);

		Если НЕ Результат Тогда
			Возврат Результат;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьПолноеИмя(Знач Фамилия, Знач Имя, Знач Отчество) Экспорт

	ПолноеИмя = "";

	ФамилияОчищенная	= СокрЛП(Фамилия);
	ИмяОчищенное		= СокрЛП(Имя);
	ОтчествоОчищенное	= СокрЛП(Отчество);

	ПолноеИмя
		= ?(ЗначениеЗаполнено(ФамилияОчищенная),	ФамилияОчищенная	+ " ", "")
		+ ?(ЗначениеЗаполнено(ИмяОчищенное),		ИмяОчищенное		+ " ", "")
		+ ?(ЗначениеЗаполнено(ОтчествоОчищенное),	ОтчествоОчищенное		 , "")
	;

	ПолноеИмя = СокрЛП(ПолноеИмя);

	Возврат ПолноеИмя;


Функция НайтиАдреснуюКнигуSendPulse(ИдКниги, Аккаунт = Неопределено, ОтборПометкиУдаления = Истина, ПометкаУдаления = Ложь) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	spАдресныеКниги.Ссылка
	|ИЗ
	|	Справочник.spАдресныеКниги КАК spАдресныеКниги
	|ГДЕ
	|	ИдКниги = &ИдКниги
	|	И ВЫБОР
	|		КОГДА &ПоискПоАккаунту
	|		ТОГДА spАдресныеКниги.Аккаунт = &Аккаунт
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ОтборПометкиУдаления
	|		ТОГДА spАдресныеКниги.ПометкаУдаления = &ПометкаУдаления
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|");

	Запрос.УстановитьПараметр("Аккаунт",				Аккаунт);
	Запрос.УстановитьПараметр("ПоискПоАккаунту",		ЗначениеЗаполнено(Аккаунт));
	Запрос.УстановитьПараметр("ИдКниги",				ИдКниги);
	Запрос.УстановитьПараметр("ОтборПометкиУдаления",	ОтборПометкиУдаления);
	Запрос.УстановитьПараметр("ПометкаУдаления",		ПометкаУдаления);

	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиАдреснуюКнигуИзКэша(
	КэшированнаяТаблица, ИдКниги
	, Аккаунт = Неопределено, ОтборПометкиУдаления = Истина, ПометкаУдаления = Ложь
) Экспорт

	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("ID", ИдКниги);
	Если ЗначениеЗаполнено(Аккаунт) Тогда
		ПараметрыПоиска.Вставить("Аккаунт", Аккаунт);
	КонецЕсли;
	Если ОтборПометкиУдаления Тогда
		ПараметрыПоиска.Вставить("ПометкаУдаления", ПометкаУдаления);
	КонецЕсли;

	НайденныеСтроки = КэшированнаяТаблица.НайтиСтроки(ПараметрыПоиска);

	Если НайденныеСтроки.Количество() Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
		Возврат НайденнаяСтрока.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция КэшироватьАдресныеКнигиSendPulse(Аккаунт = Неопределено, ОтборПометкиУдаления = Истина, ПометкаУдаления = Ложь) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	spАдресныеКниги.Ссылка,
	|	spАдресныеКниги.ID,
	|	spАдресныеКниги.Аккаунт,
	|	spАдресныеКниги.ПометкаУдаления
	|ИЗ
	|	Справочник.spАдресныеКниги КАК spАдресныеКниги
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ПоискПоАккаунту
	|		ТОГДА spАдресныеКниги.Аккаунт = &Аккаунт
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ОтборПометкиУдаления
	|		ТОГДА spАдресныеКниги.ПометкаУдаления = &ПометкаУдаления
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|");

	Запрос.УстановитьПараметр("Аккаунт",				Аккаунт);
	Запрос.УстановитьПараметр("ПоискПоАккаунту",		ЗначениеЗаполнено(Аккаунт));
	Запрос.УстановитьПараметр("ОтборПометкиУдаления",	ОтборПометкиУдаления);
	Запрос.УстановитьПараметр("ПометкаУдаления",		ПометкаУдаления);

	Результат	= Запрос.Выполнить();
	ТаблицаРезультата = Результат.Выгрузить();

	Возврат ТаблицаРезультата;

КонецФункции

// выгружает из сервиса в 1С все адресные книги (их id, name, список email)
Процедура ЗагрузитьВсеАдресныеКниги(Аккаунт = Неопределено, Обновлять = Ложь) Экспорт
	// если указан аккаунт, загружаем только для данного аккаунта
	Если ЗначениеЗаполнено(Аккаунт) Тогда
		ЗагрузитьspАдресныеКниги(Аккаунт, Обновлять);
	Иначе
	// иначе загружаем для всех аккаунтов
		ВыборкаАккаунтов = Справочники.spАккаунты.Выбрать();
		Пока ВыборкаАккаунтов.Следующий() Цикл
			Аккаунт = ВыборкаАккаунтов.Ссылка;
			ЗагрузитьspАдресныеКниги(Аккаунт, Обновлять);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ЗагрузитьspАдресныеКниги(Аккаунт, Обновлять = Ложь) Экспорт 

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ЗагрузитьspАдресныеКниги)");
		Возврат;
	КонецЕсли;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, Аккаунт);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	Запрос = Новый HTTPЗапрос("/addressbooks?access_token="+Сокрлп(Ключ),Заголовки);
		
//	ВыхИмя=ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Результат = Неопределено Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	ТаблицаАдресныхКниг = КэшироватьАдресныеКнигиSendPulse(Аккаунт);

	Для Каждого Соотв Из Результат Цикл

		ИдКниги				= СокрЛП(Соотв["id"]);
		ИмяКниги			= СокрЛП(Соотв["name"]);
		СтрокаДатаСоздания	= СокрЛП(Соотв["creationdate"]);
		ДатаСоздания		= ПолучитьДатуИзФорматаДжСОН(СтрокаДатаСоздания);

		ТекСпр = НайтиАдреснуюКнигуИзКэша(ТаблицаАдресныхКниг, ИдКниги, Аккаунт);

		Если НЕ ЗначениеЗаполнено(ТекСпр) Тогда 

			СпрОбъект = Справочники.spАдресныеКниги.СоздатьЭлемент();
			СпрОбъект.ID 			= ИдКниги;
			СпрОбъект.Наименование  = ИмяКниги;
			СпрОбъект.Аккаунт 		= Аккаунт;
			СпрОбъект.ДатаСоздания 	= ДатаСоздания;

			Попытка
				СпрОбъект.Записать();
				ТекСпр = СпрОбъект.Ссылка;
			Исключение
				ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать книгу: ID("+ИдКниги+"), name("+ИмяКниги+")! Причина:"+ОписаниеОшибки());
				Возврат;
			КонецПопытки;

		ИначеЕсли Обновлять Тогда

			СпрОбъект = ТекСпр.ПолучитьОбъект();
			СпрОбъект.Наименование  = ИмяКниги;
			СпрОбъект.ДатаСоздания 	= ДатаСоздания;
			СпрОбъект.Записать();

		КонецЕсли;

		ЗаполнитьАдреснуюКнигуПолучателиБезПроверок(ТекСпр, Аккаунт);

	КонецЦикла;	
КонецПроцедуры

// выгружает из сервиса в 1С набор email для указанной адресной книги (через id)
Процедура ЗаполнитьАдреснуюКнигуПолучатели(АдреснаяКнига, Аккаунт = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда
		Аккаунт = АдреснаяКнига.Аккаунт;
		Если Не ЗначениеЗаполнено(Аккаунт) Тогда
			Сообщить("Перед выполнением нужно выбрать аккаунт! (ЗаполнитьАдреснуюКнигуПолучатели)");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если АдреснаяКнига.ПометкаУдаления Тогда
		Сообщить("Книга помечена на удаление!");
		Возврат;
	КонецЕсли;

	ЗаполнитьАдреснуюКнигуПолучателиБезПроверок(АдреснаяКнига, Аккаунт);

КонецПроцедуры

Процедура ЗаполнитьАдреснуюКнигуПолучателиБезПроверок(АдреснаяКнига, Аккаунт) Экспорт

	ИдКниги = АдреснаяКнига.ID;
	ид = СтрЗаменить(ИдКниги, Символы.НПП, "");

	МассивСтрАдресов = Новый Массив;

	ДатаНачала = Дата(1,1,1);

	Для Инд=1 По 1000 Цикл   //цикл нужен, т.к. метод за 1 раз отдает не более 100 адресов

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		Смещение = (Инд-1) * 100;
		СмещениеСтрокой = УбратьПробелыИзСтроки(Смещение);

		//https://api.sendpulse.com/addressbooks/{id}/emails
		//Запрос=Новый HTTPЗапрос("/addressbooks/" + ид + "/emails", Заголовки);
		Запрос=Новый HTTPЗапрос("/addressbooks/" + ид + "/emails?access_token="+Сокрлп(Ключ)+"&limit=100&offset="+СмещениеСтрокой,Заголовки);

//		ВыхИмя=ПолучитьИмяВременногоФайла("txt");

		Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

		Если Ответ.КодСостояния<>200 Тогда
			 Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
			Возврат;
		КонецЕсли;

		Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

		Если Результат = Неопределено
		 ИЛИ Результат.Количество() = 0
		Тогда //кончились адреса
			Прервать;
		КонецЕсли;

		Для Каждого СтрРезультат Из Результат Цикл 
			email			= СтрРезультат.Получить("email");
			status			= СтрРезультат.Получить("status");
			status_explain	= СтрРезультат.Получить("status_explain");

			СтрАдреса = Новый Структура;
			СтрАдреса.Вставить("email",				email);
			СтрАдреса.Вставить("status",			status);
			СтрАдреса.Вставить("status_explain",	status_explain);

			МассивСтрАдресов.Добавить(СтрАдреса);
		КонецЦикла;

	КонецЦикла;

	СпрОбъект = АдреснаяКнига.ПолучитьОбъект();
	
	ПолучателиТЧ = СпрОбъект.Получатели;

	СоотвВсехАдресов = Новый Соответствие;

	Для Каждого СтрАдреса Из МассивСтрАдресов Цикл 

		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Адрес", СтрАдреса.email);

		НайденныеСтроки = ПолучателиТЧ.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТЧ = НайденныеСтроки[0];
		Иначе
			СтрокаТЧ = ПолучателиТЧ.Добавить();
			СтрокаТЧ.Адрес			= СтрАдреса.email;
//			СтрокаТЧ.ДатаДобавления	= ТекущаяДатаСеанса();
		КонецЕсли;

		СтрокаТЧ.Статус				= СтрАдреса.status;
		СтрокаТЧ.СтатусПояснение	= ПолучитьОписаниеСтатусаЕмейл(СтрАдреса.status);
		//СтрокаТЧ.СтатусПояснение	= СтрАдреса.status_explain;

		//Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ДатаДобавления) Тогда

		//	ДетальнаяИнформация		= ПолучитьДетальнуюИнформациюЕмейла(Аккаунт, СтрАдреса.email, Ключ, Соед);
		//	ДетальнаяИнформация		= ?(ДетальнаяИнформация = Неопределено, Новый Массив, ДетальнаяИнформация);

		//	Для Каждого record Из ДетальнаяИнформация Цикл

		//		ИдКнигиЗаписи = record.Получить("list_id");
		//		ИдКнигиЗаписи = СтрЗаменить(ИдКнигиЗаписи, Символы.НПП, "");

		//		Если ИдКнигиЗаписи = ид Тогда
		//			СтрокаТЧ.ДатаДобавления = ПолучитьДатуИзФорматаДжСОН(record.Получить("add_date"));
		//		КонецЕсли;

		//	КонецЦикла;

		//КонецЕсли;

		СоотвВсехАдресов.Вставить(СтрАдреса.email, Истина);

	КонецЦикла;

	ВсегоПолучателейТЧ = ПолучателиТЧ.Количество();
	ИДХ = 0;

	Пока ИДХ < ВсегоПолучателейТЧ Цикл

		ТекСтрока = ПолучателиТЧ[ИДХ];

		Если СоотвВсехАдресов.Получить(ТекСтрока.Адрес) = Неопределено Тогда
			ПолучателиТЧ.Удалить(ТекСтрока);
			ВсегоПолучателейТЧ = ВсегоПолучателейТЧ - 1;
		Иначе
			ИДХ = ИДХ + 1;
		КонецЕсли;

	КонецЦикла;

	Попытка
		СпрОбъект.Записать();
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке(
			"Не удалось заполнить адресную книгу: ID(" + ИдКниги
			+ "), name(" + АдреснаяКнига.Наименование
			+ ")! Причина:" + ОписаниеОшибки()
		);
	КонецПопытки;

КонецПроцедуры

// + 50637 ДДГ 03 мар 2022
Процедура ЗаполнитьДетальнуюИнформациюЕмейлов(Аккаунт) Экспорт

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ЗаполнитьДетальнуюИнформациюЕмейлов)");
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Аккаунт", Аккаунт);

	СоотвКниг	= Новый Соответствие;

	ВыборкаКниг	= Справочники.spАдресныеКниги.Выбрать(,, Отбор);

	Пока ВыборкаКниг.Следующий() Цикл

		СтруктураКниги	= Новый Структура;
		МассивАдресов	= Новый Массив;

		СтруктураКниги.Вставить("Книга",	ВыборкаКниг.Ссылка);
		СтруктураКниги.Вставить("Адреса",	МассивАдресов);

		СоотвКниг.Вставить(ВыборкаКниг.ID, СтруктураКниги);

	КонецЦикла;

	//

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	spАдресныеКнигиПолучатели.Адрес
		|ИЗ
		|	Справочник.spАдресныеКниги.Получатели КАК spАдресныеКнигиПолучатели
		|ГДЕ
		|	spАдресныеКнигиПолучатели.Ссылка.Аккаунт = &Аккаунт
		|	И НЕ spАдресныеКнигиПолучатели.Ссылка.ПометкаУдаления
		|	И spАдресныеКнигиПолучатели.Ссылка.ID <> """"
		|	И spАдресныеКнигиПолучатели.ДатаДобавления = ДАТАВРЕМЯ(1,1,1)";

	Запрос.УстановитьПараметр("Аккаунт", Аккаунт);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	ДатаНачала = Дата(1,1,1);

	Пока Выборка.Следующий() Цикл

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
//			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		Емейл = Выборка.Адрес;

		ДетальнаяИнформация		= ПолучитьДетальнуюИнформациюЕмейла(Аккаунт, Емейл, Ключ, Соед);
		ДетальнаяИнформация		= ?(ДетальнаяИнформация = Неопределено, Новый Массив, ДетальнаяИнформация);

		Для Каждого record Из ДетальнаяИнформация Цикл

			ИдКнигиЗаписи = Строка(record.Получить("list_id"));

			СтруктураКниги = СоотвКниг.Получить(ИдКнигиЗаписи);

			Если СтруктураКниги = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			СтруктураАдреса = Новый Структура;
			СтруктураАдреса.Вставить("Емейл", Емейл);
			СтруктураАдреса.Вставить("ДатаДобавления",
				ПолучитьДатуИзФорматаДжСОН(record.Получить("add_date")));

			СтруктураКниги.Адреса.Добавить(СтруктураАдреса);

		КонецЦикла;

	КонецЦикла;

	//

	Для Каждого КлючЗначение Из СоотвКниг Цикл

		СтруктураКниги	= КлючЗначение.Значение;
		АдресаКниги		= СтруктураКниги.Адреса;

		Если АдресаКниги.Количество() < 1 Тогда
			Продолжить;
		КонецЕсли;

		ОбъектКниги	= СтруктураКниги.Книга.ПолучитьОбъект();
		Получатели	= ОбъектКниги.Получатели;
		Записывать	= Ложь;

		Для Каждого АдресКниги Из АдресаКниги Цикл

			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Адрес",	АдресКниги.Емейл);
			НайденныеСтроки = Получатели.НайтиСтроки(СтруктураПоиска);

			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ДатаДобавления) Тогда
					НайденнаяСтрока.ДатаДобавления = АдресКниги.ДатаДобавления;
					Записывать = Истина;
					Продолжить;
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;

		Если Записывать Тогда
			ОбъектКниги.Записать();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьДетальнуюИнформациюЕмейла(Аккаунт, Емейл, Ключ = Неопределено, Соед = Неопределено) Экспорт

	Соед		= ?(Соед = Неопределено, Подключение(), Соед);
	Ключ		= ?(Ключ = Неопределено, ПолучитьКлюч(Соед, Аккаунт), Ключ);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	//https://api.sendpulse.com/emails/{email}/details
	//Запрос=Новый HTTPЗапрос("/addressbooks/" + ид + "/emails", Заголовки);
	Запрос = Новый HTTPЗапрос("/emails/" + Емейл + "/details?access_token="+Сокрлп(Ключ), Заголовки);

	Спать(1);

	Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	ТелоОтвета	= Ответ.ПолучитьТелоКакСтроку();

	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("Код ответа=" + Ответ.КодСостояния + " " + ТелоОтвета);
		Возврат Неопределено;
	КонецЕсли;

	ДанныеДжСОН	= ПолучитьДанныеДжСОН(ТелоОтвета);

	Сообщить("Дополнительные данные адреса " + Емейл + " получены успешно.");

	Возврат ДанныеДжСОН;

КонецФункции

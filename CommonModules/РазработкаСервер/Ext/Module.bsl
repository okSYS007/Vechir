Функция ПолучитьДанныеДоступа(Назначение, ИспользоватьКэш = Истина, ОбновитьКэш = Истина) Экспорт

	Если ИспользоватьКэш Тогда

		СтруктураДанных = НайтиДанныеДоступаИзКэша(Назначение);

		Если ЗначениеЗаполнено(СтруктураДанных) Тогда
			Возврат СтруктураДанных;
		КонецЕсли;

	КонецЕсли;

	МенеджерРегистра = РегистрыСведений.Доступы.СоздатьМенеджерЗаписи();
	МенеджерРегистра.Назначение = Назначение;
	МенеджерРегистра.Прочитать();

	Если НЕ МенеджерРегистра.Выбран() Тогда
		Сообщить("В регистре Доступы отсутствуют данные для " + Назначение);
	КонецЕсли;

	Если ИспользоватьКэш ИЛИ ОбновитьКэш Тогда
		ЗакэшироватьДанныеДоступа(Назначение, МенеджерРегистра);
	КонецЕсли;

	Возврат МенеджерРегистра;

КонецФункции

Функция ПолучитьПротоколАдрес(Назначение, Протокол = "", ДобавитьЛогинПарольФТП = Ложь) Экспорт

	МенеджерРегистра = ПолучитьДанныеДоступа(Назначение);

	Если МенеджерРегистра.Адрес = Неопределено Тогда
		Сообщить("В регистре Доступы отсутствуют данные для " + Назначение);
		Возврат Неопределено;
	КонецЕсли;

	СтрокаАдреса 	= МенеджерРегистра.Адрес;
	СтрокаЛогина 	= "";

	Если ЗначениеЗаполнено(Протокол) Тогда
		// пропускаем
	ИначеЕсли МенеджерРегистра.Порт = "443" Тогда
		Протокол = "https://";
	ИначеЕсли МенеджерРегистра.Порт = "21" Тогда
		Протокол = "ftp://";
	Иначе
		Протокол = "http://";
	КонецЕсли;

	Если Протокол = "ftp://"
	   И ДобавитьЛогинПарольФТП
	   И ЗначениеЗаполнено(МенеджерРегистра.Логин)
	Тогда

		СтрокаЛогина = МенеджерРегистра.Логин;

		Если ЗначениеЗаполнено(МенеджерРегистра.Пароль) Тогда
			СтрокаЛогина = СтрокаЛогина + ":" + МенеджерРегистра.Пароль;
		КонецЕсли;


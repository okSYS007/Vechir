Процедура ВыполнитьВерификациюКонтакта(Аккаунт, ЗначениеКИ) Экспорт 
	
	
	Если НЕ ЗначениеЗаполнено(Аккаунт) Тогда 
		Возврат;
	КонецЕсли;
	
	ТекАккаунтОбект = Аккаунт.ПолучитьОбъект();
	ТаблКи = ТекАккаунтОбект.КИ;
	
	СтрокаКИ = ТаблКи.Найти(ЗначениеКИ,"ЗначениеКИ");
	Если СтрокаКИ <> Неопределено Тогда 
		СтрокаКИ.Верифицирован = Истина;
	КонецЕсли;
	
	Попытка
		ТекАккаунтОбект.Записать();
	Исключение
		Сообщить("Ошибка записи Аккаунта"+ТекАккаунтОбект.Ссылка + "!");
	КонецПопытки;
	

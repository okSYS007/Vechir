Функция БезопасноПолучитьЧерезЦепочкуРеквизитов(Знач Ссылка, Знач ПоследовательностьИменРеквизитов) Экспорт

	Результат = Неопределено;

	Если ТипЗнч(ПоследовательностьИменРеквизитов) <> Тип("Массив") Тогда
		ПоследовательностьИменРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоследовательностьИменРеквизитов, ".");
	КонецЕсли;

	Для Каждого ИмяРеквизита Из ПоследовательностьИменРеквизитов Цикл

		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Результат;
		КонецЕсли;

		Ссылка = Ссылка[ИмяРеквизита];

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьБулевоеЗначениеПраваДляТекущегоПользователя(Право) Экспорт

	ЗначениеПрава = Ложь;

	СписокПрав = УправлениеПользователями.ПолучитьЗначениеПраваДляТекущегоПользователя(
		Право, Ложь
	);

	Если СписокПрав.Количество() < 1 Тогда
		Возврат ЗначениеПрава;
	КонецЕсли;

	Для Каждого ЭлементСписка Из СписокПрав Цикл

		ЗначениеПрава = ЗначениеПрава ИЛИ ЭлементСписка.Значение;

		Если ЗначениеПрава Тогда
			Возврат ЗначениеПрава;
		КонецЕсли;

	КонецЦикла;

	Возврат ЗначениеПрава;

КонецФункции

Функция ПолучитьЗначениеПраваДляПользователя(Пользователь, Право) Экспорт

	ЗначениеПрава = Неопределено;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияДополнительныхПравПользователя.Значение
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхПравПользователя
	|КАК
	|	ЗначенияДополнительныхПравПользователя
	|
	|ГДЕ ЗначенияДополнительныхПравПользователя.Пользователь = &Пользователь
	|  И ЗначенияДополнительныхПравПользователя.Право = &Право";

	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Право", Право);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРезультата = РезультатЗапроса.Выбрать();
	
	Если ВыборкаРезультата.Следующий() Тогда
		ЗначениеПрава = ВыборкаРезультата.Значение;
	КонецЕсли;

	Возврат ЗначениеПрава;

КонецФункции

Функция ДоступнаАдресацияЗадачРольПользователя(Исполнитель, Роль = null, Подразделение = null) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Адресация.Исполнитель,
		|	Адресация.Роль,
		|	Адресация.Подразделение
		|ИЗ
		|	РегистрСведений.Адресация КАК Адресация
		|
		|ГДЕ Адресация.Исполнитель = &Исполнитель
		|  И ВЫБОР
		|		КОГДА &Роль IS NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ Адресация.Роль = &Роль
		|	КОНЕЦ
		|  И ВЫБОР
		|		КОГДА &Подразделение IS NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ Адресация.Подразделение = &Подразделение
		|	КОНЕЦ
		|";

	Запрос.УстановитьПараметр("Исполнитель",	Исполнитель);
	Запрос.УстановитьПараметр("Роль",			Роль);
	Запрос.УстановитьПараметр("Подразделение",	Подразделение);

	РезультатЗапроса = Запрос.Выполнить();

	РольНазначена = НЕ РезультатЗапроса.Пустой();

	Возврат РольНазначена;

КонецФункции

Функция ПолучитьОрганизацииПодразделения(Подразделение) Экспорт

	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Организации.Ссылка
	               |ИЗ
	               |	Справочник.Организации
				   |КАК
				   |	Организации
				   |
	               |ГДЕ Организации.Подразделение = &Подразделение
				   |  И НЕ Организации.ПометкаУдаления
				   |";
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	
	МассивРезультатов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Возврат МассивРезультатов;

КонецФункции

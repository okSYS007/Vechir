// выгружает чёрный список из 1С в SendPulse
Функция ВыгрузитьЧерныйСписок(Аккаунт = Неопределено, МассивАдресов = Неопределено) Экспорт 

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ВыгрузитьЧерныйСписок)");
		Возврат Ложь;
	КонецЕсли;

	// если ничего не задано, то выгрузится всё, чего ещё нет на сервисе
	Если НЕ ЗначениеЗаполнено(МассивАдресов) Тогда

		ВсеАдреса = ПолучитьЧерныйСписокSendPulse(Аккаунт);

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	spЧерныйСписок.Адрес КАК Адрес
			|ИЗ
			|	РегистрСведений.spЧерныйСписок КАК spЧерныйСписок
			|ГДЕ
			|	spЧерныйСписок.Аккаунт = &Аккаунт
			| И spЧерныйСписок.Адрес НЕ В (&Адреса)";
		Запрос.УстановитьПараметр("Аккаунт",		Аккаунт);
		Запрос.УстановитьПараметр("Адреса",			ВсеАдреса);

		РезультатЗапроса = Запрос.Выполнить();

		Если РезультатЗапроса.Пустой() Тогда
			Сообщить("Нет невыгруженных адресов.");
			Возврат Ложь;
		КонецЕсли;

		МассивАдресов = Новый Массив;

		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивАдресов.Добавить(ВыборкаДетальныеЗаписи.Адрес);
		КонецЦикла;

	КонецЕсли;

	СтрокаСЗАпятыми ="";
	Для Каждого Адрес Из МассивАдресов Цикл

		ТекАдрес = СокрЛП(Адрес);
		ТекАдрес = НРег(ТекАдрес);

		Если ЗначениеЗаполнено(ТекАдрес) Тогда 
			СтрокаСЗАпятыми = СтрокаСЗАпятыми + ?(ЗначениеЗаполнено(СтрокаСЗАпятыми),",","") + ТекАдрес;						
		КонецЕсли;		

	КонецЦикла;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, Аккаунт);
	Заголовки	= ПолучитьЗаголовкиSendPulseJSON(Ключ);

	СтрокаСЗАпятыми64 = ЗашифроватьСтроку(СтрокаСЗАпятыми,"ANSI");
	ТелоДжСОН = "{""emails"":""" + СтрокаСЗАпятыми64 + """}";

	Запрос=Новый HTTPЗапрос("/blacklist", Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТелоДжСОН, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);

	Если Ответ.КодСостояния<>200 Тогда
	
	КонецЕсли;

	Мас = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Результат = Ложь;

	Если Мас <> Неопределено Тогда
		Результат = Мас.Получить("result");
	КонецЕсли;

	Если Результат = Истина Тогда 
		Сообщить("Успешно выгружено на SendPulse.");
	Иначе
		ОбщегоНазначения.СообщитьОбОшибке("Ошибка обновления черного списка!");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// удаляет емейлы из чёрного списка SendPulse
Функция УдалитьАдресИзЧерногоСписка(Аккаунт = Неопределено, МассивАдресов)  Экспорт 

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (УдалитьАдресИзЧерногоСписка)");
		Успех = Ложь;
		Возврат Успех;
	КонецЕсли;


	СтрокаАдреса = "";
	Сч = 0;
	Для Каждого ТекАдрес из МассивАдресов Цикл 
		Если ЗначениеЗаполнено(ТекАдрес) Тогда 
			Сч = Сч +1;
			СтрокаАдреса = СтрокаАдреса  +?(ЗначениеЗаполнено(СтрокаАдреса),",","")+ТекАдрес; 
		КонецЕсли;		
	КонецЦикла;
	
	Если Сч = 0 Тогда
		Успех = Ложь;
		Возврат Успех;
	КонецЕсли;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, Аккаунт);
	Заголовки	= ПолучитьЗаголовкиSendPulseJSON(Ключ);

	СтрокаСЗАпятыми64 = ЗашифроватьСтроку(СтрокаАдреса,"ANSI");
	ТелоДжСОН = "{""emails"":""" + СтрокаСЗАпятыми64 + """}";

	Запрос=Новый HTTPЗапрос("/blacklist", Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТелоДжСОН, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = ПолучитьОтветНаЗапросДЭЛИТ(Соед, Запрос);

	ТекСообщение = Ответ.ПолучитьТелоКакСтроку(); 

	Если Ответ.КодСостояния <> 200 Тогда 
		Успех = Ложь;
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+ТекСообщение);
	Иначе 
		Успех = Истина;		
		Сообщить("Успешно удалено из SendPulse.");
	КонецЕсли;

	Возврат Успех;

КонецФункции


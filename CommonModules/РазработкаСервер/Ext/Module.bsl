Функция РазницаПрименяемостиМодели(ГруппаКроссов, ТаблицаПрименяемости) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"
		|ВЫБРАТЬ
		|	ПрименяемостьМодели.ГруппаКроссов,
		|	ПрименяемостьМодели.Модель,
		|	ПрименяемостьМодели.Временная
		|ПОМЕСТИТЬ
		|	ПрименяемостьМодели
		|ИЗ
		|	РегистрСведений.ПрименяемостьМодели
		|КАК
		|	ПрименяемостьМодели
		|
		|ГДЕ ПрименяемостьМодели.ГруппаКроссов = &ГруппаКроссов
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаПрименяемости.ГруппаКроссов,
		|	ТаблицаПрименяемости.Модель,
		|	ТаблицаПрименяемости.Временная
		|ПОМЕСТИТЬ
		|	ТаблицаПрименяемости
		|ИЗ
		|	&ТаблицаПрименяемости
		|КАК
		|	ТаблицаПрименяемости
		|
		|ГДЕ ТаблицаПрименяемости.ГруппаКроссов = &ГруппаКроссов
		|;
		|
		|ВЫБРАТЬ
		|	ISNULL(ПрименяемостьМодели.ГруппаКроссов, ТаблицаПрименяемости.ГруппаКроссов) КАК ГруппаКроссов,
		|	ISNULL(ПрименяемостьМодели.Модель, ТаблицаПрименяемости.Модель) КАК Модель,
		|	ТаблицаПрименяемости.Временная,
		|	ПрименяемостьМодели.ГруппаКроссов IS NULL КАК НетВРегистре,
		|	ТаблицаПрименяемости.ГруппаКроссов IS NULL КАК НетВТаблице,
		|	(ПрименяемостьМодели.Временная = ИСТИНА) И (ТаблицаПрименяемости.Временная = ЛОЖЬ) КАК Подтвердить
		|ИЗ
		|	ТаблицаПрименяемости
		|
		|ПОЛНОЕ СОЕДИНЕНИЕ ПрименяемостьМодели
		| ПО ПрименяемостьМодели.ГруппаКроссов = ТаблицаПрименяемости.ГруппаКроссов
		|  И ПрименяемостьМодели.Модель = ТаблицаПрименяемости.Модель
		|
		|";

	Запрос.УстановитьПараметр("ГруппаКроссов",			ГруппаКроссов);
	Запрос.УстановитьПараметр("ТаблицаПрименяемости",	ТаблицаПрименяемости);

	РезультатЗапроса = Запрос.Выполнить();

	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	Возврат ТаблицаРезультата;

КонецФункции


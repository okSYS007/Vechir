Процедура ОбработатьОчередьФР() Экспорт
	
	ОбработкаСсылка = Константы.ОбработкаОбработкаОчереди.Получить();
	Если ЗначениеЗаполнено(ОбработкаСсылка) Тогда 
		ИмяФайла = ПолучитьИмяВременногоФайла(".epf");
		ДвоичныеДанные = ОбработкаСсылка.ХранилищеВнешнейОбработки.Получить();
		ДвоичныеДанные.Записать(ИмяФайла);
		
		ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла,Ложь);
		ВнешняяОбработка.Дата  = ТекущаяДата();

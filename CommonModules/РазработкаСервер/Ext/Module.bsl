	АдресCDN = ПолучитьПротоколАдрес(НастройкаАдресCDN);

	Если ЗначениеЗаполнено(АдресCDN) Тогда

		ДанныеДоступа = ПолучитьДанныеДоступа(КаталогКартинок);
		АдресКартинок = ДанныеДоступа.Адрес;

		Если ЗначениеЗаполнено(АдресКартинок) Тогда

			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат АдресCDN + АдресКартинок + ПолучитьАдресКартинкиНаCDN(Ссылка);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	ЗаглушкаНетФото		= ПолучитьПротоколАдрес("ЗаглушкаНетФото");
	Возврат ЗаглушкаНетФото;


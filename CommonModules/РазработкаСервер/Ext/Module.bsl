#Область RESTAPI
Функция ВыполнитьВебЗапросПолучитьОтвет(
	  АдресСайта, Защищенное = Ложь
	, Метод, ЗаголовкиЗапроса = Неопределено, ТипЗапроса, ТелоЗапроса = Неопределено
	, ЧислоПопыток = 5, ДлительностьСна = 5, ПовторЕслиНе200 = Ложь
) Экспорт

	Соединение = УстановитьСоединениеССайтом(АдресСайта, Защищенное);

	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЗаголовкиЗапроса = Неопределено Тогда
		ЗаголовкиЗапроса = Новый Соответствие;
	КонецЕсли;

	ЗапросАПИ = Новый HTTPЗапрос(Метод, ЗаголовкиЗапроса);
	ЗапросАПИ.УстановитьТелоИзСтроки(ТелоЗапроса);

	ОтветАПИ = РазработкаСервер.ПолучитьОтветНаЗапрос(Соединение, ЗапросАПИ, ТипЗапроса, ЧислоПопыток, ДлительностьСна, ПовторЕслиНе200);

	Возврат ОтветАПИ;

КонецФункции

Функция ПолучитьОтветНаЗапрос(Соединение, Запрос, ТипЗапроса, ЧислоПопыток = 5, ДлительностьСна = 5, ПовторЕслиНе200 = Ложь) Экспорт

	Ответ = Новый HTTPСервисОтвет(500);
	Ответ.УстановитьТелоИзСтроки("Не удалось выполнить запрос.");

	ТипЗапроса = ВРЕГ(ТипЗапроса);

	Для НомерПопытки=1 По ЧислоПопыток Цикл
		Попытка

			Если ТипЗапроса = "POST" Тогда
				Ответ = Соединение.ОтправитьДляОбработки(Запрос);
			ИначеЕсли ТипЗапроса = "GET" Тогда
				Ответ = Соединение.Получить(Запрос);
			ИначеЕсли ТипЗапроса = "DELETE" Тогда
				Ответ = Соединение.Удалить(Запрос);
			КонецЕсли;

			Если ПовторЕслиНе200 И Ответ.КодСостояни <> 200 Тогда
				ВызватьИсключение("Ответ != 200");
			КонецЕсли;

			Прервать;

		Исключение
			Если НомерПопытки < ЧислоПопыток Тогда
				Спать(ДлительностьСна);
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Возврат Ответ;

КонецФункции

Функция ПолучитьОтветНаЗапросПОСТ(Соединение, Запрос, ЧислоПопыток = 5, ДлительностьСна = 5, ПовторЕслиНе200 = Ложь) Экспорт
	Возврат ПолучитьОтветНаЗапрос(Соединение, Запрос, "POST", ЧислоПопыток, ДлительностьСна, ПовторЕслиНе200);
КонецФункции


				СпрОбъект = Справочники.spСтатусыАдресовКомпании.СоздатьЭлемент();
				СпрОбъект.Код = Код;
				СпрОбъект.Наименование = Пояснение;
				СпрОбъект.Записать();
				Статус = СпрОбъект.Ссылка;
			КонецЕсли;
			
			Набор_spИнформацияПоКомпаниямСтатусыАдресов = РегистрыСведений.spИнформацияПоКомпаниямСтатусыАдресов.СоздатьНаборЗаписей();
			Набор_spИнформацияПоКомпаниямСтатусыАдресов.Отбор.Компания.Установить(Компания);
			Набор_spИнформацияПоКомпаниямСтатусыАдресов.Отбор.Статус.Установить(Статус);
			Набор_spИнформацияПоКомпаниямСтатусыАдресов.Прочитать();
			
			Если Набор_spИнформацияПоКомпаниямСтатусыАдресов.Количество() = 0 Тогда
				Запись_spИнформацияПоКомпаниямСтатусыАдресов = Набор_spИнформацияПоКомпаниямСтатусыАдресов.Добавить();	
				Запись_spИнформацияПоКомпаниямСтатусыАдресов.Активность	= Истина;
			Иначе 
				Запись_spИнформацияПоКомпаниямСтатусыАдресов = Набор_spИнформацияПоКомпаниямСтатусыАдресов[0];
			КонецЕсли;
			
			Запись_spИнформацияПоКомпаниямСтатусыАдресов.Компания	= Компания;
			Запись_spИнформацияПоКомпаниямСтатусыАдресов.Статус	= Статус;
			Запись_spИнформацияПоКомпаниямСтатусыАдресов.Пояснение	= Пояснение;
			Запись_spИнформацияПоКомпаниямСтатусыАдресов.Количество	= Количество;
			
			Попытка
				Набор_spИнформацияПоКомпаниямСтатусыАдресов.Записать(Истина);
			Исключение
			КонецПопытки;
			
		КонецЦикла;		
	КонецЕсли;


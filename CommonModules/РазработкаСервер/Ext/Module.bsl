Функция ПроверитьЕстьЛиМодельВПрименяемости(ГруппаКроссов, Модель) Экспорт
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПрименяемостьМодели.Модель
	               |ИЗ
	               |	РегистрСведений.ПрименяемостьМодели КАК ПрименяемостьМодели
	               |ГДЕ
	               |	ПрименяемостьМодели.Модель = &Модель
	               |	И ПрименяемостьМодели.ГруппаКроссов = &ГруппаКроссов";
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ГруппаКроссов", ГруппаКроссов);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

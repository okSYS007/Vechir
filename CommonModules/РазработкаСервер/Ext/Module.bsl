	Отбор = Новый Структура;
	Отбор.Вставить("Аккаунт", Аккаунт);
	
	ВыборкаКампаний  = Справочники.spКомпании.Выбрать(,,Отбор);
	
	//Ограничение - 4 рассылки в час!

	ДатаНачала = Дата(1,1,1);

	Пока ВыборкаКампаний.Следующий() Цикл 

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		ТекИд			=	ВыборкаКампаний.ID;
		ТекИд			=	УбратьПробелыИзСтроки(ТекИд);
		ИмяКампании		=	СокрЛП(ВыборкаКампаний.Наименование);
		
		Если ЗначениеЗаполнено(ТекИд) Тогда 
			Продолжить;	
		КонецЕсли;
		
		Если ВыборкаКампаний.ПометкаУдаления Тогда 
			Продолжить;
		КонецЕсли;
			 
		
		Если НЕ ЗначениеЗаполнено(ИмяКампании) Тогда 
			Продолжить;
		КонецЕсли;
		//
		ДатаОтправки = ВыборкаКампаний.send_date;	
		
		sender_name = СокрЛП(ВыборкаКампаний.Оправитель.Наименование);
		sender_email= СокрЛП(ВыборкаКампаний.Оправитель.email);
		subject     = ВыборкаКампаний.subject;
		body		= "";
		template_id = УбратьПробелыИзСтроки(ВыборкаКампаний.Шаблон.real_id);
		list_id     = УбратьПробелыИзСтроки(ВыборкаКампаний.АдреснаяКнига.ID);
		send_date   = Формат(ДатаОтправки,"ЧЦ=; ДФ=гггг-ММ-дд")+" "+Формат(ДатаОтправки,"ДФ=ЧЧ:мм:сс");
		name        = ИмяКампании;
		
		
		//
		Запрос=Новый HTTPЗапрос("/campaigns?"+"name="+name+"&sender_name="+sender_name+"&sender_email="+sender_email+""
		+"&subject="+subject+"&body="+body+"&template_id="+template_id+"&list_id="+list_id+"&send_date="+send_date
		,Заголовки);
		
		Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&name="+name+"&sender_name="+sender_name+"&sender_email="+sender_email+""
		+"&subject="+subject+"&body="+body+"&template_id="+template_id+"&list_id="+list_id+"&send_date="+send_date);
		
		
		//Запрос.УстановитьТелоИзСтроки("name="+name);
		//		
		Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);

		Если Ответ.КодСостояния<>200 Тогда			
			Сообщить(Ответ.ПолучитьТелоКакСтроку());
		  	Возврат
		КонецЕсли;

		Мас = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

		Если Мас = Неопределено Тогда
			Сообщить(Ответ.ПолучитьТелоКакСтроку());
			Возврат;
		КонецЕсли;

		ТекИД 			 =  СокрЛП(Мас.Получить("id"));
		СообщениеООшибке =  СокрЛП(Мас.Получить("message"));
		status		     =  СокрЛП(Мас.Получить("status"));
		tariff_email_qty =  Мас.Получить("tariff_email_qty");
		overdraft_price	 =  Мас.Получить("overdraft_price");
		paid_email_qty   =  Мас.Получить("paid_email_qty");
		ovedraft_currency=  Мас.Получить("ovedraft_currency");
		count			 =  Мас.Получить("count");

		//
		Если ЗначениеЗаполнено(ТекИД) Тогда

			ТекКомания = ВыборкаКампаний.Ссылка;
			ТекКоманияОбъект = ТекКомания.ПолучитьОбъект();
			ЗаполнитьСтатусыКампании(ТекКоманияОбъект, Мас);
			//Руслан 20.05.2021 12:45:21{
			Адреса = ТекКоманияОбъект.АдреснаяКнига.Получатели.Выгрузить();
			СписокАдресов = Адреса.ВыгрузитьКолонку("Адрес");
			

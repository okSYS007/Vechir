Функция ПолучитьПроксиWSНаСервере() Экспорт

	Адрес 		 = Константы.АдресWS.Получить();
	Пользователь = Константы.ПользовательWS.Получить();
	Пароль 		 = Константы.ПарольWS.Получить();

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Сообщить("Не заполнен адрес подключения к стационарной базе.");
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Адрес = Адрес + "/ws/mobile.1cws?wsdl";
		Определения = Новый WSОпределения(Адрес,Пользователь,Пароль);

		Прокси = Новый WSПрокси(Определения, "http://www.1c.ru/SB/MobileExchange", "MobileExchange", "MobileExchangeSoap");
		Прокси.Пользователь = Пользователь;
		Прокси.Пароль = Пароль;
	Исключение
		Сообщить("Не удалось установить WS-соединение со стационарной базой.
		|Проверьте параметры покдлючения.");
		Возврат Неопределено;
	КонецПопытки;

	Возврат Прокси;

КонецФункции


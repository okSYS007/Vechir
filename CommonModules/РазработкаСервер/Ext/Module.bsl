// получить стоимость рассылки по адресной книге
Функция ПолучитьСтоимостьКампании(АдреснаяКнига) Экспорт

	Если НЕ ЗначениеЗаполнено(АдреснаяКнига) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдКниги = УбратьПробелыИзСтроки(АдреснаяКнига.ID);

	Если НЕ ЗначениеЗаполнено(ИдКниги) Тогда 
		Возврат Неопределено;
	КонецЕсли;

	Аккаунт = АдреснаяКнига.Аккаунт;

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("У выбранной книги не заполнен аккаунт! (ПолучитьСтоимостьКампании)");
		Возврат Неопределено;
	КонецЕсли;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, Аккаунт);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	Запрос = Новый HTTPЗапрос("/addressbooks/" + Сокрлп(ИдКниги) + "/cost/" + "?access_token="+Сокрлп(Ключ), Заголовки);

//	ВыхИмя = ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат Неопределено;
	КонецЕсли;

	Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Результат = Неопределено Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат Неопределено;
	КонецЕсли;

	СтруктураОтвета = Новый Структура;

	// + 003590 ДДГ 22 окт 2020
	Для Каждого Соотв Из Результат Цикл
		СтруктураОтвета.Вставить(Соотв.Ключ, Соотв.Значение);
	КонецЦикла;
	// - 003590 ДДГ 22 окт 2020

	Возврат СтруктураОтвета;

КонецФункции


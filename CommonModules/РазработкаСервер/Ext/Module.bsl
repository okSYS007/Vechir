Функция ПолучитьКлюч(Соед, Аккаунт = Неопределено) Экспорт 
	
	Если Аккаунт = Неопределено Тогда 
		Сообщить("Не установлено значение Аккаунт : ПолучитьКлюч");
		Возврат "";		
	КонецЕсли;
	
	Ключ = "";
	Заголовки=Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/x-www-form-urlencoded");
	
	Запрос=Новый HTTPЗапрос("/oauth/access_token",Заголовки);
	//Запрос.УстановитьТелоИзСтроки("grant_type=client_credentials&client_id="+Сокрлп(ПолучитьID())+"&client_secret="+Сокрлп(ПолучитьSecret()),,ИспользованиеByteOrderMark.НеИспользовать);
 	Запрос.УстановитьТелоИзСтроки("grant_type=client_credentials&client_id="+Аккаунт.client_id+"&client_secret="+Аккаунт.client_secret,,ИспользованиеByteOrderMark.НеИспользовать);

//	ВыхИмя=ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);

	СтрОтвет= Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния<>200 Тогда
		 Сообщить("Код ответа="+Ответ.КодСостояния+" "+СтрОтвет);
		Возврат Ключ;
	КонецЕсли;

	Чтение=Новый  ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрОтвет);
	Мас=ПрочитатьJSON(Чтение,Истина);
	
	Ключ=Мас["access_token"];  //ключ годен 1 час
		
	Возврат Ключ;
	
КонецФункции

Функция ПолучитьЗаголовокАвторизации(Соед) 
	
	Соед = Подключение();
	
	Ключ = ПолучитьКлюч(Соед);
	
	Заголовки=Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/x-www-form-urlencoded");
	Заголовки.Вставить("Authorization","Bearer "+Сокрлп(Ключ));
	
	Возврат Заголовки;
	

Процедура АктуализироватьНамиенованиеПоСсылкам(СсылкаНаНаименованиеНоменклатуры, Знач ТекНаименование = "") Экспорт 
	
	
	
	Если Не ЗначениеЗаполнено(СсылкаНаНаименованиеНоменклатуры)  Тогда 
		Возврат;		
	КонецЕсли;
	
	
	Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда 
		ТекНаименование = СсылкаНаНаименованиеНоменклатуры.Наименование;
	КонецЕсли;
	
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("НаименованиеНоменклатуры",СсылкаНаНаименованиеНоменклатуры);	
	Запрос.УстановитьПараметр("Наименование",ТекНаименование);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.НаименованиеНоменклатуры = &НаименованиеНоменклатуры
	               |	И Номенклатура.Наименование <> &Наименование
	               |	И НЕ Номенклатура.ЭтоГруппа
				   |";
	
	
	ВЫборка = Запрос.Выполнить().Выбрать();
	
	Пока ВЫборка.Следующий() цикл
		
		Об = ВЫборка.ССылка.ПолучитьОбъект();
		Об.Наименование			= ТекНаименование;
		об.НаименованиеПолное	= ТекНаименование;
		Попытка
			Об.Записать();
		Исключение
			ОбщегоНазначения.СообщитьОбОшибке("Не удалось изменить наименование номенклатуры!" + об.Артикул + "! Причина:"+ОписаниеОшибки());
		КонецПопытки;
		//Сообщить("Изменено наименование номенклатуры "+об.Артикул + " "+об.бренд);
	КонецЦикла;
	
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", ТекНаименование);
	Запрос.УстановитьПараметр("НаименованиеНоменклатуры", СсылкаНаНаименованиеНоменклатуры);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СайтГруппыКроссов.Ссылка
		|ИЗ
		|	Справочник.СайтГруппыКроссов КАК СайтГруппыКроссов
		|ГДЕ
		|	СайтГруппыКроссов.НаименованиеНоменклатуры = &НаименованиеНоменклатуры
		|	И СайтГруппыКроссов.Наименование <> &Наименование";
	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
	КонецЦикла;
	
КонецПроцедуры


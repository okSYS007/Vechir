// проверяет доступность картинки-предпросмотра на сервисе, возвращает булевое значение
Функция ДоступенВнешнийВидШаблона(ВебАдрес) Экспорт

	Если НЕ ЗначениеЗаполнено(ВебАдрес) Тогда
		Возврат Ложь;
	КонецЕсли;

	Домен = "login.sendpulse.com";
	Хост = "https://" + Домен + "/";

	ВебАдресКартинки = СтрЗаменить(ВебАдрес, Хост, "");

	Соед	= Новый HTTPСоединение(Домен);
	Запрос	= Новый HTTPЗапрос(ВебАдресКартинки);
	Ответ	= ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьОбОшибке(
			 "Возможно, шаблон был удалён из сервиса. Код ответа = "
			+ Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку()
		);
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;


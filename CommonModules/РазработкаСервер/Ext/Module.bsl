Функция УстановитьСоединениеССайтом(
	  АдресСервера
	, Защищенное		= Ложь
	, Порт				= Неопределено
	, Пользователь		= Неопределено
	, Пароль			= Неопределено
	, ЧислоПопыток		= 5
	, ДлительностьСна	= 5
	, ТаймАут			= Неопределено
) Экспорт

	Соединение = Неопределено;

	Для НомерПопытки=1 По ЧислоПопыток Цикл
		Попытка

			Соединение = Новый HTTPСоединение(
				АдресСервера, Порт, Пользователь, Пароль, , ТаймАут
				, ?(Защищенное ИЛИ Порт = 443, Новый ЗащищенноеСоединениеOpenSSL, Неопределено)
			);

			Прервать;

		Исключение
			Спать(ДлительностьСна);
		КонецПопытки;
	КонецЦикла;

	Возврат Соединение;


			|ПОМЕСТИТЬ КИ
			|ИЗ
			|	Справочник.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.ВидЛогина = 2
			|	И КонтактнаяИнформация.Наименование В(&СписокАдресов)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Адреса.Адрес,
			|	Адреса.Статус,
			|	Адреса.СтатусПояснение,
			|	КИ.Ссылка КАК КонтактнаяИнформация
			|ИЗ
			|	Адреса КАК Адреса
			|		ЛЕВОЕ СОЕДИНЕНИЕ КИ КАК КИ
			|		ПО Адреса.Адрес = КИ.Наименование";
			ЗапросКИ.УстановитьПараметр("СписокАдресов",СписокАдресов);
			РезультатЗапросаКИ = ЗапросКИ.Выполнить().Выгрузить();
			
			
			ТекКоманияОбъект.Адреса.Загрузить(РезультатЗапросаКИ);//}Руслан 20.05.2021 12:47:44
			
			Попытка
				ТекКоманияОбъект.Записать();
				ЗаписатьСтатистикуКампании(ТекКомания, Мас);
			Исключение				
			КонецПопытки;
		Иначе 
			ОбщегоНазначения.СообщитьОбОшибке("Ошибка при выгрузке кампании "+ИмяКампании + "! Причина:"+ СообщениеООшибке);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьКомапанию(Аккаунт, Кампания) Экспорт 

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ВыгрузитьКомапании)");
		Возврат;
	КонецЕсли;

	ТекИд			=	Кампания.ID;
	ТекИд			=	УбратьПробелыИзСтроки(ТекИд);
	ИмяКампании		=	СокрЛП(Кампания.Наименование);

	Если ЗначениеЗаполнено(ТекИд) ИЛИ Кампания.ПометкаУдаления ИЛИ НЕ ЗначениеЗаполнено(ИмяКампании) Тогда 
		Возврат;	
	КонецЕсли;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, Аккаунт);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	//
	ДатаОтправки = Кампания.send_date;	

	sender_name = СокрЛП(Кампания.Оправитель.Наименование);
	sender_email= СокрЛП(Кампания.Оправитель.email);
	subject     = Кампания.subject;
	body		= "";
	template_id = УбратьПробелыИзСтроки(Кампания.Шаблон.real_id);
	list_id     = УбратьПробелыИзСтроки(Кампания.АдреснаяКнига.ID);
	send_date   = Формат(ДатаОтправки,"ЧЦ=; ДФ=гггг-ММ-дд")+" "+Формат(ДатаОтправки,"ДФ=ЧЧ:мм:сс");
	name        = ИмяКампании;

	Запрос=Новый HTTPЗапрос("/campaigns?"+"name="+name+"&sender_name="+sender_name+"&sender_email="+sender_email+""
	+"&subject="+subject+"&body="+body+"&template_id="+template_id+"&list_id="+list_id+"&send_date="+send_date
	,Заголовки);

	Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&name="+name+"&sender_name="+sender_name+"&sender_email="+sender_email+""
	+"&subject="+subject+"&body="+body+"&template_id="+template_id+"&list_id="+list_id+"&send_date="+send_date);

	Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда			
		Сообщить(Ответ.ПолучитьТелоКакСтроку());
	  	Возврат;
	КонецЕсли;

	Мас = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Мас = Неопределено Тогда
		Сообщить(Ответ.ПолучитьТелоКакСтроку());
	  	Возврат;
	КонецЕсли;

	ТекИД 			 =  СокрЛП(Мас.Получить("id"));
	СообщениеООшибке =  СокрЛП(Мас.Получить("message"));
	status		     =  СокрЛП(Мас.Получить("status"));
	tariff_email_qty =  Мас.Получить("tariff_email_qty");
	overdraft_price	 =  Мас.Получить("overdraft_price");
	paid_email_qty   =  Мас.Получить("paid_email_qty");
	ovedraft_currency=  Мас.Получить("ovedraft_currency");
	count			 =  Мас.Получить("count");

	//
	Если ЗначениеЗаполнено(ТекИД) Тогда 

		ТекКоманияОбъект = Кампания.Ссылка.ПолучитьОбъект();			

		ТекКоманияОбъект.ID = ТекИД;

		ЗаполнитьСтатусыКампании(ТекКоманияОбъект, Мас);

		Попытка
			ТекКоманияОбъект.Записать();
		Исключение
		КонецПопытки;

	Иначе 
		ОбщегоНазначения.СообщитьОбОшибке("Ошибка при выгрузке кампании "+ИмяКампании + "! Причина:"+ СообщениеООшибке);
	КонецЕсли;					
	
КонецПроцедуры

Процедура ОтменитьКампанию(Аккаунт, Кампания) Экспорт

	// + 003590 ДДГ 22 окт 2020
	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ОтменитьКампанию)");
		Возврат;
	КонецЕсли;

	ТекИд			=	Кампания.ID;
	ТекИд			=	УбратьПробелыИзСтроки(ТекИд);

	Если Не ЗначениеЗаполнено(ТекИд) Тогда
		Сообщить("ID не заполнен!");
		Возврат;
	КонецЕсли;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, Аккаунт);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	Запрос = Новый HTTPЗапрос("/campaigns/"+ТекИд, Заголовки);
	Ответ = ПолучитьОтветНаЗапросДЭЛИТ(Соед, Запрос);
	СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();

	Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
	// - 003590 ДДГ 22 окт 2020


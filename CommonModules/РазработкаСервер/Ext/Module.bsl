		Возврат;
	КонецЕсли;
	
	Если МассивАдресов.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
		
	Соед = Подключение();
	
	Ключ = ПолучитьКлюч(Соед, Аккаунт);
	
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON,МассивАдресов); 
	СтрокаJSONАдреса = ЗаписьJSON.Закрыть();
	
	Запрос=Новый HTTPЗапрос("/emails/campaigns?emails="+СтрокаJSONАдреса,Заголовки);
	Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&emails="+СтрокаJSONАдреса);

//	ВременныйФайл = ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Результат = Неопределено Тогда
		Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Для Каждого ЭлАдрес Из Результат Цикл 
		ЭлАдресСтрока = ЭлАдрес.Ключ;
		sent = ЭлАдрес.Значение.Получить("sent");
		link = ЭлАдрес.Значение.Получить("link");
		blacklist = ЭлАдрес.Значение.Получить("blacklist");
		open = ЭлАдрес.Значение.Получить("open");
		adressbooks = ЭлАдрес.Значение.Получить("adressbooks");
		КоличествоАдресныхКниг = adressbooks.Количество();
		//Для Каждого АдресныеКниги Из adressbooks Цикл 
		//	АдресныеКнигаИмя = АдресныеКниги.Получить("name");
		//	АдресныеКнигаId = АдресныеКниги.Получить("id");
		//КонецЦикла;	
		
		Набор_spСтатистикаАдресовПоКомпаниям = РегистрыСведений.spСтатистикаАдресовПоВсемКомпаниям.СоздатьНаборЗаписей();
		Набор_spСтатистикаАдресовПоКомпаниям.Отбор.ЭлектронныйАдрес.Установить(ЭлАдресСтрока);
		Набор_spСтатистикаАдресовПоКомпаниям.Прочитать();
		
		Если Набор_spСтатистикаАдресовПоКомпаниям.Количество() = 0 Тогда
			Запись_spСтатистикаАдресовПоКомпаниям = Набор_spСтатистикаАдресовПоКомпаниям.Добавить();	
			Запись_spСтатистикаАдресовПоКомпаниям.ЭлектронныйАдрес	= ЭлАдресСтрока;
		Иначе 
			Запись_spСтатистикаАдресовПоКомпаниям = Набор_spСтатистикаАдресовПоКомпаниям[0];
		КонецЕсли;
		
		Запись_spСтатистикаАдресовПоКомпаниям.sent = sent;
		Запись_spСтатистикаАдресовПоКомпаниям.link = link;
		Запись_spСтатистикаАдресовПоКомпаниям.blacklist = blacklist;
		Запись_spСтатистикаАдресовПоКомпаниям.open = open;
		Запись_spСтатистикаАдресовПоКомпаниям.КоличествоАдресныхКниг = КоличествоАдресныхКниг;		
		
		Попытка
			Набор_spСтатистикаАдресовПоКомпаниям.Записать(Истина);
		Исключение
		КонецПопытки;
		
	КонецЦикла;


#Область УтилитыПеречисления
Функция ДанныеВыбораПеречисления(Знач ИмяПеречисления) Экспорт

	СтруктураДанных	= Новый Структура;
	ОтборДанных		= Новый Структура;
	СтрокаПоиска	= Неопределено;
	СтруктураДанных.Вставить("Отбор", ОтборДанных);
	СтруктураДанных.Вставить("СтрокаПоиска", СтрокаПоиска);
	ДанныеВыбора	= Перечисления[ИмяПеречисления].ПолучитьДанныеВыбора(СтруктураДанных);

	Возврат ДанныеВыбора;

КонецФункции

Функция ЗаполнитьСоотвЗначениеПеречисленияКод(Знач ИмяПеречисления, Знач СоотвЗначениеКод = Неопределено, Знач ИДХ = 0) Экспорт

	СоотвЗначениеКод = ?(СоотвЗначениеКод = Неопределено, Новый Соответствие, СоотвЗначениеКод);

	ДанныеВыбора = РазработкаСервер.ДанныеВыбораПеречисления(ИмяПеречисления);

	ПустоеЗначение = Перечисления[ИмяПеречисления].ПустаяСсылка();
	СтруктураЗначения = Новый Структура;
	СтруктураЗначения.Вставить("Значение", ПустоеЗначение);
	ДанныеВыбора.Вставить(0, СтруктураЗначения, "");

	Для Каждого ЭлементСписка Из ДанныеВыбора Цикл

		ЗначениеПеречисления = ЭлементСписка.Значение.Значение;

		Код1С = РазработкаСервер.ОдносимвольныйКодИзЧисла(ИДХ);
		СоотвЗначениеКод.Вставить(ЗначениеПеречисления, Код1С);

		ИДХ = ИДХ + 1;

	КонецЦикла;

	Возврат СоотвЗначениеКод;

КонецФункции


Функция НайтиЗначениеПеременнойКэша(Имя) Экспорт

	ПолученноеЗначение = Неопределено;

	Кэш = ПараметрыСеанса.ОбщиеЗначения.Получить();

	Если Кэш = Неопределено Тогда
		Возврат ПолученноеЗначение;
	КонецЕсли;

	Кэш.Свойство(Имя, ПолученноеЗначение);

	Возврат ПолученноеЗначение;

КонецФункции

Процедура ЗакэшироватьЗначениеПеременной(Имя, Значение, ОбновлятьВоВсехКэшах = Ложь, Принудительно = Ложь) Экспорт
	Кэш = ПараметрыСеанса.ОбщиеЗначения.Получить();	
	ОбщегоНазначения.УстановитьЗначениеПеременной(Имя, Кэш, Значение, ОбновлятьВоВсехКэшах, Принудительно);
	ПараметрыСеанса.ОбщиеЗначения = Новый ХранилищеЗначения(Кэш);	
КонецПроцедуры

Функция НайтиДанныеДоступаИзКэша(Назначение) Экспорт

	НайденноеЗначение = Неопределено;

	ИмяКэша = "КэшРегистраДоступы";
	КэшРегистра = НайтиЗначениеПеременнойКэша(ИмяКэша);

	Если КэшРегистра = Неопределено Тогда
		ЗакэшироватьЗначениеПеременной(ИмяКэша, Новый Структура, , Истина);
		Возврат НайденноеЗначение;
	КонецЕсли;

	КэшРегистра.Свойство(Назначение, НайденноеЗначение);

	Возврат НайденноеЗначение;

КонецФункции

Процедура ЗакэшироватьДанныеДоступа(Назначение, МенеджерРегистра) Экспорт

	СтруктураДанных = Новый Структура("Назначение,Адрес,Логин,Пароль,Порт,Токен,Метод");

	ЗаполнитьЗначенияСвойств(СтруктураДанных, МенеджерРегистра);

	ИмяКэша = "КэшРегистраДоступы";
	КэшРегистра = НайтиЗначениеПеременнойКэша(ИмяКэша);

	Если КэшРегистра = Неопределено Тогда
		КэшРегистра = Новый Структура;
	КонецЕсли;

	КэшРегистра.Вставить(Назначение, СтруктураДанных);

	ЗакэшироватьЗначениеПеременной(ИмяКэша, КэшРегистра, , Истина);

КонецПроцедуры

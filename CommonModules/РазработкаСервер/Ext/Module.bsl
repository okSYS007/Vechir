Функция ПолучитьМассивКонтрагентовАккаунта_Новый(Аккаунт) Экспорт 	
	
	Если НЕ ЗначениеЗаполнено(Аккаунт) Тогда 
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Аккаунт", Аккаунт);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации КАК Контрагент,
		|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.ИНН КАК ИНН,
		|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.КПП КАК КПП,
		|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.Наименование КАК Наименование,
		|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.НаименованиеПолное КАК НаименованиеПолное,
		|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.Код КАК Код,
		|	ВЫБОР
		|		КОГДА АллокацииАккаунтовСрезПоследних.Подтверждено
		|			ТОГДА """"
		|		ИНАЧЕ ""Подтвердить""
		|	КОНЕЦ КАК Подтверждение,
		|	АллокацииАккаунтовСрезПоследних.Регистратор,
		|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.ЮрФизЛицо КАК ТипКонтрагента
		|ИЗ
		|	РегистрСведений.АллокацииАккаунтов.СрезПоследних(
		|			,
		|			НЕ ОбъектАллокации.ПометкаУдаления
		|				И ВидАллокации = ЗНАЧЕНИЕ(Перечисление.ВидыАллокаций.Контрагенты)) КАК АллокацииАккаунтовСрезПоследних
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &Аккаунт ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ АллокацииАккаунтовСрезПоследних.Аккаунт = &Аккаунт
		|		КОНЕЦ";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	
	Возврат Таблица.ВыгрузитьКолонку("Контрагент");
	
КонецФункции


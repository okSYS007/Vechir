Процедура ОбновитьСтатистику(Аккаунт = Неопределено) Экспорт 

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ОбновитьСтатистику)");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	// + 003590 ДДГ 22 окт 2020
	Запрос.УстановитьПараметр("Аккаунт", Аккаунт);
	// - 003590 ДДГ 22 окт 2020
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	spКомпании.ID КАК ID,
		|	spКомпании.Ссылка
		|ИЗ
		|	Справочник.spКомпании КАК spКомпании
		|ГДЕ
		|	spКомпании.ID <> &ПустаяСтрока
		| И spКомпании.Аккаунт = &Аккаунт
		|";

	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	ДатаНачала = Дата(1,1,1);

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		КомпанияСсылка = ВыборкаДетальныеЗаписи.Ссылка; 
		
		идКомпании = ВыборкаДетальныеЗаписи.ID;
		идКомпании = УбратьПробелыИзСтроки(идКомпании);
		Если Не ЗначениеЗаполнено(идКомпании) Тогда 
			Продолжить;
		КонецЕсли;
		
		//
		//campaigns/{id}
		//"?access_token="+Сокрлп(Ключ)
		Запрос=Новый HTTPЗапрос("/campaigns/"+идКомпании ,Заголовки);
		Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&id="+идКомпании);
		
//		ВыхИмя=ПолучитьИмяВременногоФайла("txt");

		Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

		Если Ответ.КодСостояния <> 200 Тогда
			Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
			Возврат;
		КонецЕсли;

		Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

		Если Результат = Неопределено Тогда
			Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
			Возврат;
		КонецЕсли;

		ТекКомпания = ВыборкаДетальныеЗаписи.Ссылка;
		ТекКомпанияОбъект = ТекКомпания.ПолучитьОбъект();
		ЗаполнитьИнформациюПоКампании(ТекКомпанияОбъект, Результат);

		Попытка
			ТекКомпанияОбъект.Записать();
			ЗаписатьСтатистикуКампании(ТекКомпания, Результат);
		Исключение
			ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать "+ВыборкаДетальныеЗаписи.Ссылка+ "!");
		КонецПопытки;
		
		//Для Каждого Соотв Из Мас Цикл
		//КонецЦикла
		
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьСтатистикуКампании(Кампания) Экспорт 

	аккаунтКампании = Кампания.Аккаунт;

	Если Не ЗначениеЗаполнено(аккаунтКампании) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ОбновитьСтатистикуКампании)");
		Возврат;
	КонецЕсли;

	идКампании = Кампания.ID;
	идКампании = УбратьПробелыИзСтроки(идКампании);

	Если ПустаяСтрока(идКампании) Тогда
		Сообщить("Невозможно обновить статистику кампании, которая не была выгружена на сервис (пустой id).");
		Возврат;
	КонецЕсли;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, аккаунтКампании);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	//
	//campaigns/{id}
	//"?access_token="+Сокрлп(Ключ)
	Запрос=Новый HTTPЗапрос("/campaigns/"+идКампании ,Заголовки);
	Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&id="+идКампании);
	
//	ВыхИмя=ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Свойства = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Свойства = Неопределено Тогда
		Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	ТекКомпанияОбъект = Кампания.ПолучитьОбъект();

	ЗаполнитьИнформациюПоКампании(ТекКомпанияОбъект, Свойства);

	Попытка
		ТекКомпанияОбъект.Записать();
		ЗаписатьСтатистикуКампании(Кампания, Свойства);
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать " + Кампания + "!");
	КонецПопытки;

	//Для Каждого Соотв Из Мас Цикл
	//КонецЦикла
	
КонецПроцедуры

Процедура ЗаписатьСтатистикуКампании(КампанияСсылка, Свойства) Экспорт

	statistics	= Свойства.Получить("statistics");
	general		= statistics.Получить("general");

	Если general = Неопределено Тогда
		general = statistics;
	КонецЕсли;

	Если general <> Неопределено Тогда 			
		Для Каждого СтрокаСтатистики из general Цикл 
			Пояснение 	= СокрЛП(СтрокаСтатистики.Получить("explain"));
			Количество	= СтрокаСтатистики.Получить("count");
			Код 		= СтрокаСтатистики.Получить("code");
			
			Если ЗначениеЗаполнено(Пояснение) Тогда 
				
				Набор = РегистрыСведений.СтатистикаПоКомпаниям.СоздатьНаборЗаписей();
				Набор.Отбор.Компания.Установить(КампанияСсылка);
				Набор.Отбор.Пояснение.Установить(Пояснение);
				
				Набор.Прочитать();
				
				Если Набор.Количество() = 0 Тогда 
					Запись = Набор.Добавить();
					Запись.Активность	= Истина;
					Запись.Компания		= КампанияСсылка;
					Запись.Пояснение	= Пояснение;
				Иначе 
					Запись = Набор[0];
				КонецЕсли;
				
				Если Запись.Количество <> Количество 
					или Запись.Код <> Код Тогда 
					
					Запись.Количество	= Количество;
					Запись.Код			= Код;
					
					Попытка
						Набор.Записать();
						КампанияОбъект = КампанияСсылка.ПолучитьОбъект();
						КампанияОбъект.ДатаОбновленияСтатистики = ТекущаяДатаСеанса();
						КампанияОбъект.Записать();
					Исключение							
					КонецПопытки;
					
				КонецЕсли;
				
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСтатусыКампании(КампанияОбъект, Свойства)

	ID					= Строка(Свойства.Получить("id"));
	status				= Свойства.Получить("status");
	all_email_qty		= Свойства.Получить("all_email_qty");
	tariff_email_qty	= Свойства.Получить("tariff_email_qty");
	overdraft_currency	= Свойства.Получить("overdraft_currency");
	paid_email_qty		= Свойства.Получить("paid_email_qty");
	overdraft_price		= Свойства.Получить("overdraft_price");

	КампанияОбъект.ID 					= ID;
	КампанияОбъект.status 				= status;
	КампанияОбъект.all_email_qty 		= all_email_qty;
	КампанияОбъект.tariff_email_qty		= tariff_email_qty;
	КампанияОбъект.paid_email_qty		= paid_email_qty;
	КампанияОбъект.overdraft_price 		= overdraft_price;
	КампанияОбъект.overdraft_currency 	= overdraft_currency;

	КампанияОбъект.СтатусСтрока			= ПолучитьОписаниеСтатуса(status);

КонецПроцедуры

Процедура ЗаполнитьИнформациюПоКампании(КампанияОбъект, Свойства)

	ЗаполнитьСтатусыКампании(КампанияОбъект, Свойства);

	name				= Свойства.Получить("name");
	КампанияОбъект.Наименование			= name;

	send_date			= Свойства.Получить("send_date");
	Если ЗначениеЗаполнено(send_date) Тогда
		КампанияОбъект.send_date = ПреобразоватьДатуSendPulse(send_date);
	КонецЕсли;

	message				= Свойства.Получить("message");

	Если ТипЗнч(message) = Тип("Соответствие") Тогда 
		subject 	= message.Получить("subject");
		attachments = message.Получить("attachments");
		list_id 	= Строка(message.Получить("list_id"));
		sender_email = message.Получить("sender_email"); 
		
		Оправитель		= Справочники.spОтправители.НайтиПоРеквизиту("email",sender_email);
		//Шаблон			= Справочники.spШаблоны.НайтиПоРеквизиту("real_id",list_id);
		АдреснаяКнига	= Справочники.spАдресныеКниги.НайтиПоРеквизиту("ID",list_id);

		КампанияОбъект.Оправитель 		= Оправитель;
		КампанияОбъект.subject 			= subject;
		КампанияОбъект.attachments		= attachments;						
		КампанияОбъект.АдреснаяКнига	= АдреснаяКнига;

	КонецЕсли;

КонецПроцедуры

Функция ПреобразоватьДатуSendPulse(send_date) Экспорт
	// + 003590 ДДГ 22 окт 2020

	ПреобразованнаяДата = СтрЗаменить(send_date,"-","");
	ПреобразованнаяДата = СтрЗаменить(ПреобразованнаяДата,":","");
	ПреобразованнаяДата = СтрЗаменить(ПреобразованнаяДата," ","");

	// дата возвращается по гринвичу, добавляем 3 часа для Москвы
	ПреобразованнаяДата = Дата(ПреобразованнаяДата) + 3*3600;
	Возврат ПреобразованнаяДата;

	// - 003590 ДДГ 22 окт 2020

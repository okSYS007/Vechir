Функция СкопироватьКоллекциюРекурсивно(ИсходнаяКоллекция) Экспорт

	СоотвДопустимыеТипы = Новый Соответствие;
	// только эти типы копируются рекурсивно
	СоотвДопустимыеТипы.Вставить(Тип("Структура")	, Новый Структура);
	СоотвДопустимыеТипы.Вставить(Тип("Соответствие"), Новый Соответствие);
	СоотвДопустимыеТипы.Вставить(Тип("Массив")		, Новый Массив);

	ТипКоллекции = ТипЗнч(ИсходнаяКоллекция);

	КопияКоллекции = СоотвДопустимыеТипы.Получить(ТипКоллекции);

	Если КопияКоллекции = Неопределено Тогда
		ВызватьИсключение "Не могу сделать рекурсивную копию для этого типа: " + ТипКоллекции;
	КонецЕсли;

	//

	Если ТипКоллекции = Тип("Массив") Тогда

		Для Каждого Значение Из ИсходнаяКоллекция Цикл

			КопияЗначения = Значение;

			Проверка = СоотвДопустимыеТипы.Получить(ТипЗнч(Значение));

			Если Проверка <> Неопределено Тогда
				КопияЗначения = СкопироватьКоллекциюРекурсивно(Значение);
			КонецЕсли;

			КопияКоллекции.Добавить(КопияЗначения);

		КонецЦикла;

		Возврат КопияКоллекции;

	КонецЕсли;

	//

	Для Каждого КлючЗначение Из ИсходнаяКоллекция Цикл

		Ключ		= КлючЗначение.Ключ;
		Значение	= КлючЗначение.Значение;

		КопияКлюча		= Ключ;
		КопияЗначения	= Значение;

		//

		Проверка = СоотвДопустимыеТипы.Получить(ТипЗнч(Ключ));

		Если Проверка <> Неопределено Тогда
			КопияКлюча = СкопироватьКоллекциюРекурсивно(Ключ);
		КонецЕсли;

		//

		Проверка = СоотвДопустимыеТипы.Получить(ТипЗнч(Значение));

		Если Проверка <> Неопределено Тогда
			КопияЗначения = СкопироватьКоллекциюРекурсивно(Значение);
		КонецЕсли;

		//

		КопияКоллекции.Вставить(КопияКлюча, КопияЗначения);

	КонецЦикла;

	Возврат КопияКоллекции;

КонецФункции


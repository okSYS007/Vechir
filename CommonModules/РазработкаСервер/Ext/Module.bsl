// загружает чёрный список из SendPulse
Функция ПолучитьЧерныйСписокSendPulse(Аккаунт) Экспорт

	МассивАдресов = Новый Массив;

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ПолучитьЧерныйСписокSendPulse)");
		Возврат МассивАдресов;
	КонецЕсли;

	ДатаНачала = Дата(1,1,1);

	Для Инд=1 По 1000 Цикл   //цикл нужен, т.к. метод за 1 раз отдает не более 100 адресов

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		Смещение=(Инд-1)*100;
		СмещениеСтрокой = УбратьПробелыИзСтроки(Смещение);

		Запрос=Новый HTTPЗапрос("/blacklist/?access_token="+Сокрлп(Ключ)+"&limit=100&offset="+СмещениеСтрокой,Заголовки);

//		ВыхИмя=ПолучитьИмяВременногоФайла("txt");

		Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

		Если Ответ.КодСостояния<>200 Тогда
			ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
			Возврат МассивАдресов;
		КонецЕсли;

		Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

		Если Результат = Неопределено
		 ИЛИ Результат.Количество() = 0
		Тогда //кончились адреса
			Прервать;
		КонецЕсли;

		Для Каждого Соотв Из Результат Цикл
			ТекСтрока = СокрЛП(Соотв);
			
			//Добавим в базу
			Если ЗначениеЗаполнено(ТекСтрока) Тогда 
				МассивАдресов.Добавить(ТекСтрока);
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Возврат МассивАдресов;

КонецФункции

// записывает загруженный чёрный список из SendPulse в 1С
Процедура ЗагрузитьЧерныйСписок(Аккаунт = Неопределено) Экспорт 

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ЗагрузитьЧерныйСписок)");
		Возврат;
	КонецЕсли;

	МассивАдресов = ПолучитьЧерныйСписокSendPulse(Аккаунт);

	Для Каждого Адрес Из МассивАдресов Цикл

		Запись = РегистрыСведений.spЧерныйСписок.СоздатьМенеджерЗаписи();
		Запись.Адрес 		= Адрес; 
		Запись.Аккаунт		= Аккаунт;
		Запись.Прочитать();

		Если НЕ Запись.Выбран() Тогда
			Запись.Адрес 		= Адрес; 
			Запись.Аккаунт		= Аккаунт;
			Запись.ВведеноАвтоматически = Истина;
			Попытка
				Запись.Записать(Истина);
			Исключение
				
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;


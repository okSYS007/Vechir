Процедура УдалитьПустыеЗначенияИзМассива(ИсходныйМассив) Экспорт

	ИДХ = ИсходныйМассив.Количество();

	Пока ИДХ > 0 Цикл

		ИДХ = ИДХ - 1;

		Если НЕ ЗначениеЗаполнено(ИсходныйМассив[ИДХ]) Тогда
			ИсходныйМассив.Удалить(ИДХ);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция МинЗначениеКромеПустого(МассивЗначений) Экспорт

	Результ = NULL;

	ВсегоЭлементов = МассивЗначений.Количество();

	Если ВсегоЭлементов < 1 Тогда
		Возврат Результ;
	ИначеЕсли ВсегоЭлементов = 1 Тогда
		Результ = МассивЗначений[0];
		Возврат Результ;
	КонецЕсли;

	Для Каждого Элемент Из МассивЗначений Цикл

		Если НЕ ЗначениеЗаполнено(Элемент) Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Результ) Тогда
			Результ = Элемент;
			Продолжить;
		КонецЕсли;

		Результ = Мин(Результ, Элемент);

	КонецЦикла;

	Возврат Результ;

КонецФункции

Функция Максимум(МассивЗначений) Экспорт

	ЗначениеМаксимума = Неопределено;

	Если МассивЗначений.Количество() < 1 Тогда
		Возврат ЗначениеМаксимума;
	КонецЕсли;

	ЗначениеМаксимума = МассивЗначений[0];

	Для Каждого Значение Из МассивЗначений Цикл
		ЗначениеМаксимума = Макс(ЗначениеМаксимума, Значение);
	КонецЦикла;

	Возврат ЗначениеМаксимума;

КонецФункции


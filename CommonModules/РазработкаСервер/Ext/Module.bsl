Функция ЗаполнениеКонтрагентаПоСтруктуреДанныхПоИНН(Объект, СтруктураДанныхПоИНН) Экспорт

	Попытка
		СтруктураДляЗаполнения = Новый Структура;
		СтруктураДляЗаполнения.Вставить("ФормаСобственностиЮрЛицаРоссия", СтруктураДанныхПоИНН.suggestions[0].data.opf.short);
		СтруктураДляЗаполнения.Вставить("Наименование", СтруктураДанныхПоИНН.suggestions[0].data.name.full);

		Если СтрДлина(Объект.ИНН) = 10 Тогда
			СтруктураДляЗаполнения.Вставить("КПП",	СтруктураДанныхПоИНН.suggestions[0].data.kpp);
			СтруктураДляЗаполнения.Вставить("ОКПО",	СтруктураДанныхПоИНН.suggestions[0].data.okpo);
		КонецЕсли;
		СтруктураДляЗаполнения.Вставить("ЮридическийАдрес", СтруктураДанныхПоИНН.suggestions[0].data.address.unrestricted_value);

		Если Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда

			Если Строка(Объект.ФормаСобственностиЮрЛицаРоссия) <> СтруктураДляЗаполнения.ФормаСобственностиЮрЛицаРоссия Тогда
				Попытка
					Объект.ФормаСобственностиЮрЛицаРоссия = Справочники.ВариантыЮрЛиц[СтруктураДляЗаполнения.ФормаСобственностиЮрЛицаРоссия];	
				Исключение
					Сообщить("Не найдено соответствие Формы собственности по данным ИНН, укажите вручную");
				КонецПопытки;
			КонецЕсли;

			Если Объект.КодПоОКПО <> СтруктураДляЗаполнения.ОКПО Тогда
				Объект.КодПоОКПО = СтруктураДляЗаполнения.ОКПО;
			КонецЕсли;
			Если Объект.КПП <> СтруктураДляЗаполнения.КПП Тогда
				Объект.КПП = СтруктураДляЗаполнения.КПП;
			КонецЕсли;

		КонецЕсли;
		
		Если Объект.Наименование <> СтруктураДляЗаполнения.Наименование Тогда
			Объект.Наименование = СтруктураДляЗаполнения.Наименование;
		КонецЕсли;
		
		Объект.ЮридическийАдрес = СтруктураДляЗаполнения.ЮридическийАдрес;

	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;	


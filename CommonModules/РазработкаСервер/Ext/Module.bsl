#Область Кампании
Процедура ЗагрузитьКомпании(Аккаунт = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ЗагрузитьКомпании)");
		Возврат;
	КонецЕсли;

	ДатаНачала = ТекущаяДатаСеанса();

	Соед = РазработкаСервер.Подключение();
	
	Ключ = ПолучитьКлюч(Соед, Аккаунт);		

	Заголовки=Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Content-Type","application/json");
	Заголовки.Вставить("charset","UTF-8");  	
	Заголовки.Вставить("Authorization","Bearer "+Сокрлп(Ключ));

	//Запрос=Новый HTTPЗапрос("/templates/ru?owner=me?access_token="+Сокрлп(Ключ),Заголовки);
	//Запрос=Новый HTTPЗапрос("/campaigns?access_token="+Сокрлп(Ключ),Заголовки);
	Запрос=Новый HTTPЗапрос("/campaigns", Заголовки);

//	ВыхИмя=ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	Если Ответ.КодСостояния<>200 Тогда
		Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Результат = Неопределено Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат;
	КонецЕсли;

	Заголовки = ПолучитьЗаголовкиSendPulse(Ключ);

	Для Каждого Соотв Из Результат Цикл

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		Текid			= СокрЛП(Соотв.Получить("id"));
		name			= Соотв.Получить("name");

		Если ЗначениеЗаполнено(Текid) Тогда

			ТекСпр = Справочники.spКомпании.НайтиПоРеквизиту("ID",Текid);
			Если ЗначениеЗаполнено(ТекСпр) Тогда 
				ТекСпрОбъект = ТекСпр.ПолучитьОбъект(); 									
			Иначе 
				ТекСпрОбъект = Справочники.spКомпании.СоздатьЭлемент();
			КонецЕсли;

			идКампании = Текid;
			идКампании = УбратьПробелыИзСтроки(идКампании);

			Запрос=Новый HTTPЗапрос("/campaigns/"+идКампании ,Заголовки);
			Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&id="+идКампании);
			
//			ВыхИмя=ПолучитьИмяВременногоФайла("txt");

			Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

			Если Ответ.КодСостояния<>200 Тогда
				Сообщить("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
				Продолжить;
			КонецЕсли;

			Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

			Если Результат = Неопределено Тогда
				ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
				Продолжить;
			КонецЕсли;

			ЗаполнитьИнформациюПоКампании(ТекСпрОбъект, Результат);
			ТекСпрОбъект.Аккаунт = Аккаунт;

			Попытка
				ТекСпрОбъект.Записать();
				ЗаписатьСтатистикуКампании(ТекСпрОбъект.Ссылка, Результат);
			Исключение
				ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать Кампании ("+name+" "+Текid+") ");
			КонецПопытки;			
			

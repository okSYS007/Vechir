Функция ПолучитьМаксКлючСоответствия(ИсходноеСоответствие) Экспорт

	Выбрано = Неопределено;

	ВсегоКлючей = ИсходноеСоответствие.Количество();

	Если ВсегоКлючей = 0 Тогда
		Возврат Выбрано;
	КонецЕсли;

	Для Каждого КлючЗначение Из ИсходноеСоответствие Цикл
		Выбрано = КлючЗначение.Ключ;
		Прервать;
	КонецЦикла;

	Для Каждого КлючЗначение Из ИсходноеСоответствие Цикл

		Ключ = КлючЗначение.Ключ;

		Если Ключ > Выбрано Тогда
			Выбрано = Ключ;
		КонецЕсли;

	КонецЦикла;

	Возврат Выбрано;

КонецФункции


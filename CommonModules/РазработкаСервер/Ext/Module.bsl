	СоотвРусЛат.Вставить("Х", "H");
	СоотвРусЛат.Вставить("х", "h");

	СоотвРусЛат.Вставить("Ц", "C");
	СоотвРусЛат.Вставить("ц", "c");

	СоотвРусЛат.Вставить("Ч", "Ch");
	СоотвРусЛат.Вставить("ч", "ch");

	СоотвРусЛат.Вставить("Ш", "Sh");
	СоотвРусЛат.Вставить("ш", "sh");

	СоотвРусЛат.Вставить("Щ", "Shy");

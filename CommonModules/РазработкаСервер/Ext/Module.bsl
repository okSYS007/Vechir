Функция ПолучитьСтруктуруИзХМЛ(ТекстХМЛ) Экспорт

	ЧтениеХМЛ = Новый ЧтениеXML;
	ЧтениеХМЛ.УстановитьСтроку(ТекстХМЛ);

	СтруктураХМЛ = Новый Структура;

	РекурсивноПолучитьСтруктуруИзХМЛ(ЧтениеХМЛ, СтруктураХМЛ);

	ЧтениеХМЛ.Закрыть();

	Возврат СтруктураХМЛ;

КонецФункции

Процедура РекурсивноПолучитьСтруктуруИзХМЛ(ЧтениеХМЛ, ТекущийЭлемент) Экспорт

	СтруктураАтрибутов = Новый Структура;

	ТекущийЭлемент.Вставить("___Атрибуты_", СтруктураАтрибутов);

	Пока ЧтениеХМЛ.ПрочитатьАтрибут() Цикл
		СтруктураАтрибутов.Вставить(ЧтениеХМЛ.Имя, ЧтениеХМЛ.Значение);
	КонецЦикла;

	Пока ЧтениеХМЛ.Прочитать()
	   И ЧтениеХМЛ.ТипУзла <> ТипУзлаXML.КонецЭлемента
	Цикл

		Если ЧтениеХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			ИмяЭлемента   = ЧтениеХМЛ.Имя;
			НовыйЭлемент  = Новый Структура;
			СтарыйЭлемент = ИзвлечьСвойствоИзСтруктуры(ТекущийЭлемент, ИмяЭлемента);

			Если СтарыйЭлемент = Неопределено Тогда
				ТекущийЭлемент.Вставить(ИмяЭлемента, НовыйЭлемент);
			ИначеЕсли ТипЗнч(СтарыйЭлемент) = Тип("Массив") Тогда
				СтарыйЭлемент.Добавить(НовыйЭлемент);
			Иначе
				МассивЭлементов = Новый Массив;
				МассивЭлементов.Добавить(СтарыйЭлемент);
				МассивЭлементов.Добавить(НовыйЭлемент);
				ТекущийЭлемент.Вставить(ИмяЭлемента, МассивЭлементов);
			КонецЕсли;

			РекурсивноПолучитьСтруктуруИзХМЛ(ЧтениеХМЛ, НовыйЭлемент);

		ИначеЕсли ЧтениеХМЛ.ТипУзла = ТипУзлаXML.Текст Тогда

			ТекущийЭлемент.Вставить("___Текст_", ЧтениеХМЛ.Значение);

//		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

//			Возврат;

		КонецЕсли ;

	КонецЦикла;

КонецПроцедуры

Функция ИзвлечьТекстЗначенияКлючаСтруктурыХМЛ(ЭлементСтруктурыХМЛ, ИмяКлюча) Экспорт

	ЗначениеКлюча = Неопределено;

	СтруктураКлюча = ИзвлечьСвойствоИзСтруктуры(ЭлементСтруктурыХМЛ, ИмяКлюча);

	Если ТипЗнч(СтруктураКлюча) <> Тип("Структура") Тогда
		Возврат ЗначениеКлюча;
	КонецЕсли;

	ЗначениеКлюча = ИзвлечьСвойствоИзСтруктуры(СтруктураКлюча, "___Текст_");

	Возврат ЗначениеКлюча;

КонецФункции

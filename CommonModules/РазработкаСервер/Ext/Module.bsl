
#Область Аккаунты
Функция ПолучитьТаблицуАккаунтовПоПоиску(СтрокаПоиска) Экспорт 	
	
	ТекСтрокаПоиска = "%"+СтрокаПоиска+"%";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекСтрокаПоиска", ТекСтрокаПоиска);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Акк.Аккаунт
		|ИЗ
		|	(ВЫБРАТЬ
		|		СайтПользователи.Ссылка КАК Аккаунт
		|	ИЗ
		|		Справочник.СайтПользователи КАК СайтПользователи
		|	ГДЕ
		|		(СайтПользователи.Код ПОДОБНО &ТекСтрокаПоиска
		|				ИЛИ СайтПользователи.Наименование ПОДОБНО &ТекСтрокаПоиска
		|				ИЛИ СайтПользователи.ЭлектроннаяПочта ПОДОБНО &ТекСтрокаПоиска
		|				ИЛИ СайтПользователи.КонтактныйТелефон ПОДОБНО &ТекСтрокаПоиска
		|				ИЛИ СайтПользователи.Имя ПОДОБНО &ТекСтрокаПоиска
		|				ИЛИ СайтПользователи.Фамилия ПОДОБНО &ТекСтрокаПоиска)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КИ.Ссылка
		|	ИЗ
		|		Справочник.СайтПользователи.КИ КАК КИ
		|	ГДЕ
		|		КИ.ЗначениеКИ ПОДОБНО &ТекСтрокаПоиска) КАК Акк";
	ТаблАккаунтов = Запрос.Выполнить().Выгрузить();	
	
	Возврат ТаблАккаунтов;
	
КонецФункции


Функция ПолучитьМассивКонтрагентовАккаунта(Аккаунт) Экспорт 	
	
	Если НЕ ЗначениеЗаполнено(Аккаунт) Тогда 
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Аккаунт", Аккаунт);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СайтПользователиКонтрагенты.Контрагент КАК Контрагент
		|ИЗ
		|	РегистрСведений.СайтПользователиКонтрагенты КАК СайтПользователиКонтрагенты
		|ГДЕ
		|	СайтПользователиКонтрагенты.Пользователь = &Аккаунт
		|	И СайтПользователиКонтрагенты.Контрагент <> Значение(Справочник.Контрагенты.ПустаяСсылка)
		|";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	
	Возврат Таблица.ВыгрузитьКолонку("Контрагент");
	
КонецФункции


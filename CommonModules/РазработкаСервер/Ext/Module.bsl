#Область УтилитыДатаВремя
Функция ПолучитьСоотвЧислуДняНедели() Экспорт

	СоотвЧислуДняНедели = Новый Соответствие;

	СоотвЧислуДняНедели.Вставить(1, Перечисления.ДниНедели.Понедельник);
	СоотвЧислуДняНедели.Вставить(2, Перечисления.ДниНедели.Вторник);
	СоотвЧислуДняНедели.Вставить(3, Перечисления.ДниНедели.Среда);
	СоотвЧислуДняНедели.Вставить(4, Перечисления.ДниНедели.Четверг);
	СоотвЧислуДняНедели.Вставить(5, Перечисления.ДниНедели.Пятница);
	СоотвЧислуДняНедели.Вставить(6, Перечисления.ДниНедели.Суббота);
	СоотвЧислуДняНедели.Вставить(7, Перечисления.ДниНедели.Воскресенье);

	Возврат СоотвЧислуДняНедели;

КонецФункции

Функция МесяцИзЧисла(Знач МесяцЧислом) Экспорт

	МесяцСтрокой = "";

	Если ТипЗнч(МесяцЧислом) <> Тип("Число")
	 ИЛИ НЕ Между(МесяцЧислом, 1, 12)
	Тогда
		Возврат МесяцСтрокой;
	КонецЕсли;

	МесяцДатой = Дата(1998, МесяцЧислом, 19);

	МесяцСтрокой = Формат(МесяцДатой, "ДФ=MMMM");

	Возврат МесяцСтрокой;

КонецФункции

Функция Время(Знач ДатаВремя) Экспорт
	Возврат Дата(1,1,1) + (ДатаВремя - НачалоДня(ДатаВремя));
КонецФункции

Функция ДатаИзЮниксТайм(Знач ЮниксТайм, Знач ЧасовойПояс = 0) Экспорт

	Ризалт = Неопределено;

	ЭпохаЮникс = Дата(1970,1,1);

	Если ТипЗнч(ЮниксТайм) <> Тип("Число") Тогда

		СтрокаЮниксТайм = Строка(ЮниксТайм);

		Попытка
			ЮниксТайм = Число(СтрокаЮниксТайм);
		Исключение
			Возврат Ризалт;
		КонецПопытки;

	КонецЕсли;

	Ризалт = ЭпохаЮникс + ЮниксТайм + ЧасовойПояс * Часов();

	Возврат Ризалт;


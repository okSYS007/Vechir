		Запись_spИнформацияПоКомпаниям.Компания	= Компания;
	Иначе 
		Запись_spИнформацияПоКомпаниям = Набор_spИнформацияПоКомпаниям[0];
	КонецЕсли;
		
	Запись_spИнформацияПоКомпаниям.status				= Мас.Получить("status");
	Запись_spИнформацияПоКомпаниям.all_email_qty		= Мас.Получить("all_email_qty");
	Запись_spИнформацияПоКомпаниям.tariff_email_qty		= Мас.Получить("tariff_email_qty");
	Запись_spИнформацияПоКомпаниям.overdraft_currency	= Мас.Получить("overdraft_currency");
	Запись_spИнформацияПоКомпаниям.send_date			= Мас.Получить("send_date");
	Запись_spИнформацияПоКомпаниям.paid_email_qty		= Мас.Получить("paid_email_qty");
	Запись_spИнформацияПоКомпаниям.permalink			= Мас.Получить("permalink");
	Запись_spИнформацияПоКомпаниям.name					= Мас.Получить("name");
	Запись_spИнформацияПоКомпаниям.overdraft_price		= Мас.Получить("overdraft_price");
	
	statistics = Мас.Получить("statistics");
	message	   = Мас.Получить("message");
		
	Если ТипЗнч(message) = Тип("Соответствие") Тогда 
		Запись_spИнформацияПоКомпаниям.sender_name  = message.Получить("sender_name");
		Запись_spИнформацияПоКомпаниям.subject 	    = message.Получить("subject");
		Запись_spИнформацияПоКомпаниям.body 		= Новый ХранилищеЗначения(message.Получить("body"), Новый СжатиеДанных(9));
		Запись_spИнформацияПоКомпаниям.sender_email = message.Получить("sender_email");
		Запись_spИнформацияПоКомпаниям.list_id 	    = message.Получить("list_id");

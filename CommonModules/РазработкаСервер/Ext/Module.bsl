Функция ПолучитьВыборкуМассиваСсылок(МассивСсылок, Знач ИмяТаблицы) Экспорт

	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Справочник.Номенклатура
	|ГДЕ
	|	Ссылка В (&МассивСсылок)
	|";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.Номенклатура", ИмяТаблицы);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаРезультата = РезультатЗапроса.Выбрать();

	Возврат ВыборкаРезультата;


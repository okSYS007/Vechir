Функция БезопасноЗаписатьПровестиДокумент(ДокументОбъект, Знач Провести = Ложь, Знач Оперативно = Ложь) Экспорт

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Ошибка"		, Ложь);
	СтруктураВозврата.Вставить("ТекстОшибки", "");
	СтруктураВозврата.Вставить("Ссылка"		, Неопределено);
	СтруктураВозврата.Вставить("Записан"	, Ложь);
	СтруктураВозврата.Вставить("Проведен"	, Ложь);

	Попытка

		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		СтруктураВозврата.Вставить("Ссылка" , ДокументОбъект.Ссылка);
		СтруктураВозврата.Вставить("Записан", Истина);

		Если Провести Тогда

			Попытка
				РежимПроведения = ?(Оперативно, РежимПроведенияДокумента.Оперативный, РежимПроведенияДокумента.Неоперативный);
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);
				СтруктураВозврата.Вставить("Проведен", Истина);
			Исключение
				СтруктураВозврата.Вставить("Ошибка"		, Истина);
				СтруктураВозврата.Вставить("ТекстОшибки", ОписаниеОшибки());
			КонецПопытки;

		КонецЕсли;

	Исключение
		СтруктураВозврата.Вставить("Ошибка"		, Истина);
		СтруктураВозврата.Вставить("ТекстОшибки", ОписаниеОшибки());
	КонецПопытки;

	Возврат СтруктураВозврата;

КонецФункции

Функция АвтоПодборАвтомобиля(СтрокаПоиска, МаксимумРезультатов = 20, СтруктураОтборов = Неопределено) Экспорт

	ТекстСоединения = "";

	Если СтруктураОтборов = Неопределено Тогда
		СтруктураОтборов = Новый Структура;
	КонецЕсли;

	Подразделение  = РазработкаСервер.ИзвлечьСвойствоИзСтруктуры(СтруктураОтборов, "Подразделение", NULL, Истина);
	Статусы = РазработкаСервер.ИзвлечьСвойствоИзСтруктуры(СтруктураОтборов, "Статусы", NULL, Истина);

	МассивОтборов = Новый Массив;

	Если ЗначениеЗаполнено(Подразделение) Тогда
		СтрокаОтбора = "	И Автомобили.Подразделение = &Подразделение";
		МассивОтборов.Добавить(СтрокаОтбора);
	КонецЕсли;

	Если ЗначениеЗаполнено(Статусы) Тогда

		СтрокаОтбора = "	И ВыкупАвтомобиляСрезПоследних.Статус В (&Статусы)";
		МассивОтборов.Добавить(СтрокаОтбора);

		ТекстСоединения = "
		|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыкупЗетаБУАвтомобиля.СрезПоследних
		|КАК ВыкупАвтомобиляСрезПоследних
		| ПО Автомобили.Ссылка = ВыкупАвтомобиляСрезПоследних.Автомобиль
		|";

	КонецЕсли;

	ТекстОтборы = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивОтборов, Символы.ПС);

	НачалоСтроки	= СтрокаПоиска + "%";
	ПодстрокаПоиска	= "%" + НачалоСтроки;

	СписокВыбора = Новый СписокЗначений;

	Запрос = Новый Запрос;

	ТекстЗапроса = "
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	Автомобили.Ссылка,
		|	Автомобили.Наименование,
		|	Автомобили.Код,
		|	Автомобили.VIN
		|ПОМЕСТИТЬ КодПоНачалуСтроки
		|ИЗ
		|	Справочник.ЗетаБУАвтомобили КАК Автомобили
		|//&ТекстСоединения
		|ГДЕ
		|	НЕ Автомобили.ПометкаУдаления
		|	И Автомобили.Код ПОДОБНО &ПодстрокаПоиска
		|	И &Отборы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Автомобили.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	Автомобили.Ссылка,
		|	Автомобили.Наименование,
		|	Автомобили.Код,
		|	Автомобили.VIN
		|ПОМЕСТИТЬ VINПоНачалуСтроки
		|ИЗ
		|	Справочник.ЗетаБУАвтомобили КАК Автомобили
		|//&ТекстСоединения
		|ГДЕ
		|	ИСТИНА В
		|			(ВЫБРАТЬ
		|				КОЛИЧЕСТВО(КодПоНачалуСтроки.Наименование) < &МаксимумРезультатов
		|			ИЗ
		|				КодПоНачалуСтроки)
		|	И НЕ Автомобили.Код В
		|				(ВЫБРАТЬ
		|					КодПоНачалуСтроки.Код
		|				ИЗ
		|					КодПоНачалуСтроки)
		|	И НЕ Автомобили.ПометкаУдаления
		|	И Автомобили.VIN ПОДОБНО &НачалоСтроки
		|	И &Отборы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Автомобили.VIN
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КодПоНачалуСтроки.Ссылка,
		|	КодПоНачалуСтроки.Наименование,
		|	КодПоНачалуСтроки.Код,
		|	КодПоНачалуСтроки.VIN
		|ПОМЕСТИТЬ
		|	ВыбранныеПоКоду
		|ИЗ
		|	КодПоНачалуСтроки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	VINПоНачалуСтроки.Ссылка,
		|	VINПоНачалуСтроки.Наименование,
		|	VINПоНачалуСтроки.Код,
		|	VINПоНачалуСтроки.VIN
		|ИЗ
		|	VINПоНачалуСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	Автомобили.Ссылка,
		|	Автомобили.Наименование,
		|	Автомобили.Код,
		|	Автомобили.VIN
		|ПОМЕСТИТЬ VINПоПодстроке
		|ИЗ
		|	Справочник.ЗетаБУАвтомобили КАК Автомобили
		|//&ТекстСоединения
		|ГДЕ
		|	ИСТИНА В
		|			(ВЫБРАТЬ
		|				КОЛИЧЕСТВО(ВыбранныеПоКоду.Наименование) < &МаксимумРезультатов
		|			ИЗ
		|				ВыбранныеПоКоду)
		|	И НЕ Автомобили.Код В
		|				(ВЫБРАТЬ
		|					ВыбранныеПоКоду.Код
		|				ИЗ
		|					ВыбранныеПоКоду)
		|	И НЕ Автомобили.ПометкаУдаления
		|	И Автомобили.VIN ПОДОБНО &ПодстрокаПоиска
		|	И &Отборы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Автомобили.VIN
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыбранныеПоКоду.Ссылка,
		|	ВыбранныеПоКоду.Наименование,
		|	ВыбранныеПоКоду.Код,
		|	ВыбранныеПоКоду.VIN
		|ПОМЕСТИТЬ
		|	ВыбранныеПоVIN
		|ИЗ
		|	ВыбранныеПоКоду
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	VINПоПодстроке.Ссылка,
		|	VINПоПодстроке.Наименование,
		|	VINПоПодстроке.Код,
		|	VINПоПодстроке.VIN
		|ИЗ
		|	VINПоПодстроке
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	Автомобили.Ссылка,
		|	Автомобили.Наименование,
		|	Автомобили.Код,
		|	Автомобили.VIN
		|ПОМЕСТИТЬ НаименованияПоНачалуСтроки
		|ИЗ
		|	Справочник.ЗетаБУАвтомобили КАК Автомобили
		|//&ТекстСоединения
		|ГДЕ
		|	ИСТИНА В
		|			(ВЫБРАТЬ
		|				КОЛИЧЕСТВО(ВыбранныеПоVIN.Наименование) < &МаксимумРезультатов
		|			ИЗ
		|				ВыбранныеПоVIN)
		|	И НЕ Автомобили.Код В
		|				(ВЫБРАТЬ
		|					ВыбранныеПоVIN.Код
		|				ИЗ
		|					ВыбранныеПоVIN)
		|	И НЕ Автомобили.ПометкаУдаления
		|	И Автомобили.Наименование ПОДОБНО &НачалоСтроки
		|	И &Отборы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Автомобили.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыбранныеПоVIN.Ссылка,
		|	ВыбранныеПоVIN.Наименование,
		|	ВыбранныеПоVIN.Код,
		|	ВыбранныеПоVIN.VIN
		|ПОМЕСТИТЬ
		|	Выбранные
		|ИЗ
		|	ВыбранныеПоVIN
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НаименованияПоНачалуСтроки.Ссылка,
		|	НаименованияПоНачалуСтроки.Наименование,
		|	НаименованияПоНачалуСтроки.Код,
		|	НаименованияПоНачалуСтроки.VIN
		|ИЗ
		|	НаименованияПоНачалуСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	Автомобили.Ссылка,
		|	Автомобили.Наименование,
		|	Автомобили.Код,
		|	Автомобили.VIN
		|ПОМЕСТИТЬ НаименованияПоПодстроке
		|ИЗ
		|	Справочник.ЗетаБУАвтомобили КАК Автомобили
		|//&ТекстСоединения
		|ГДЕ
		|	ИСТИНА В
		|			(ВЫБРАТЬ
		|				КОЛИЧЕСТВО(Выбранные.Наименование) < &МаксимумРезультатов
		|			ИЗ
		|				Выбранные)
		|	И НЕ Автомобили.Код В
		|				(ВЫБРАТЬ
		|					Выбранные.Код
		|				ИЗ
		|					Выбранные)
		|	И НЕ Автомобили.ПометкаУдаления
		|	И Автомобили.Наименование ПОДОБНО &ПодстрокаПоиска
		|	И &Отборы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Автомобили.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Выбранные.Ссылка,
		|	Выбранные.Наименование,
		|	Выбранные.Код,
		|	Выбранные.VIN
		|ИЗ
		|	Выбранные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НаименованияПоПодстроке.Ссылка,
		|	НаименованияПоПодстроке.Наименование,
		|	НаименованияПоПодстроке.Код,
		|	НаименованияПоПодстроке.VIN
		|ИЗ
		|	НаименованияПоПодстроке
		|";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ ПЕРВЫЕ 0"		, "ВЫБРАТЬ ПЕРВЫЕ " + МаксимумРезультатов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "	И &Отборы"			, ТекстОтборы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//&ТекстСоединения"	, ТекстСоединения);

	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("НачалоСтроки",			НачалоСтроки);
	Запрос.УстановитьПараметр("ПодстрокаПоиска",		ПодстрокаПоиска);
	Запрос.УстановитьПараметр("МаксимумРезультатов",	МаксимумРезультатов);

	Для Каждого КлючЗначение Из СтруктураОтборов Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ,	КлючЗначение.Значение);
	КонецЦикла;

	РезультатЗапроса	= Запрос.Выполнить();

	ТаблицаРезультата	= РезультатЗапроса.Выгрузить();

	ВсегоСтрок			= ТаблицаРезультата.Количество();
	ПоследнийИндекс		= ?(ВсегоСтрок > МаксимумРезультатов, МаксимумРезультатов, ВсегоСтрок) - 1;

	Для ИДХ=0 По ПоследнийИндекс Цикл

		СтрокаТР = ТаблицаРезультата[ИДХ];

//		СсылкаЗначения = СтрокаТР.Ссылка;

		Представление = "(" + СтрокаТР.Код + ") " + СтрокаТР.Наименование + " " + СтрокаТР.VIN;

		СтруктураЗначения = Новый Структура;
		СтруктураЗначения.Вставить("Значение",			СтрокаТР.Ссылка);
		СтруктураЗначения.Вставить("Представление",		Представление);
		СтруктураЗначения.Вставить("ПометкаУдаления",	Ложь);

		ФорматированноеПредставление = РазработкаСервер.ВыделитьПодстрокуСтроки(Представление, СтрокаПоиска);

		СписокВыбора.Добавить(СтруктураЗначения, ФорматированноеПредставление);

	КонецЦикла;

	Возврат СписокВыбора;

КонецФункции

#Область Номенклатура
Функция АвтоПодборАртикула(
	  СтрокаПоиска
	, МаксимумРезультатов = 20
) Экспорт

	НачалоСтроки	= СтрокаПоиска + "%";
	ПодстрокаПоиска	= "%" + НачалоСтроки;

	СписокВыбора = Новый СписокЗначений;

	Запрос = Новый Запрос;

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 0
		|	Номенклатура.Артикул
		|ПОМЕСТИТЬ НаименованияПоНачалуСтроки
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И Номенклатура.Артикул ПОДОБНО &НачалоСтроки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Артикул
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	Номенклатура.Артикул
		|ПОМЕСТИТЬ НаименованияПоПодстроке
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	ИСТИНА В
		|			(ВЫБРАТЬ
		|				КОЛИЧЕСТВО(НаименованияПоНачалуСтроки.Артикул) < &МаксимумРезультатов
		|			ИЗ
		|				НаименованияПоНачалуСтроки)
		|	И НЕ Номенклатура.Артикул В
		|				(ВЫБРАТЬ
		|					НаименованияПоНачалуСтроки.Артикул
		|				ИЗ
		|					НаименованияПоНачалуСтроки)
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И Номенклатура.Артикул ПОДОБНО &ПодстрокаПоиска
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Артикул
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НаименованияПоНачалуСтроки.Артикул
		|ИЗ
		|	НаименованияПоНачалуСтроки КАК НаименованияПоНачалуСтроки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НаименованияПоПодстроке.Артикул
		|ИЗ
		|	НаименованияПоПодстроке КАК НаименованияПоПодстроке";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ ПЕРВЫЕ 0", "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ " + МаксимумРезультатов);

	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("НачалоСтроки",				НачалоСтроки);
	Запрос.УстановитьПараметр("ПодстрокаПоиска",			ПодстрокаПоиска);
	Запрос.УстановитьПараметр("МаксимумРезультатов",		МаксимумРезультатов);

	РезультатЗапроса	= Запрос.Выполнить();

	ТаблицаРезультата	= РезультатЗапроса.Выгрузить();

	ВсегоСтрок			= ТаблицаРезультата.Количество();
	ПоследнийИндекс		= ?(ВсегоСтрок > МаксимумРезультатов, МаксимумРезультатов, ВсегоСтрок) - 1;

	Для ИДХ=0 По ПоследнийИндекс Цикл

		СтрокаТР = ТаблицаРезультата[ИДХ];

//		СсылкаЗначения = СтрокаТР.Ссылка;

		Представление = СтрокаТР.Артикул;

		СтруктураЗначения = Новый Структура;
		СтруктураЗначения.Вставить("Значение",			Представление);
		СтруктураЗначения.Вставить("ПометкаУдаления",	Ложь);

		ФорматированноеПредставление = РазработкаСервер.ВыделитьПодстрокуСтроки(Представление, СтрокаПоиска);

		СписокВыбора.Добавить(СтруктураЗначения, ФорматированноеПредставление);

	КонецЦикла;

	Возврат СписокВыбора;

КонецФункции

Функция НоменклатураЕстьВБазе(Артикул, Бренд, НоменклатураСсылка = null) Экспорт

	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(&Бренд) = ТИП(Справочник.СайтБренды)
	|		ТОГДА Номенклатура.Бренд = &Бренд
	|		ИНАЧЕ Номенклатура.БрендРучной = &Бренд
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &Номенклатура IS NULL
	|		ТОГДА ИСТИНА
	|		ИНАЧЕ Номенклатура.Ссылка <> &Номенклатура
	|	КОНЕЦ
	|";
	Запрос.УстановитьПараметр("Артикул",		Артикул);
	Запрос.УстановитьПараметр("Бренд",			Бренд);
	Запрос.УстановитьПараметр("Номенклатура",	НоменклатураСсылка);

	Результат = Запрос.Выполнить();

	Возврат НЕ Результат.Пустой();

КонецФункции

// возвращает номенклатуру, если есть только одна номенклатура с таким артикулом
// , игнорируя помеченные на удаление и временные
Функция ПолучитьНоменклатуруПоАртикулу(Артикул) Экспорт

	НайденнаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();

	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Возврат НайденнаяНоменклатура;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура
		|КАК
		|	Номенклатура
		|
		|ГДЕ Артикул = &Артикул
		|  И НЕ Номенклатура.ПометкаУдаления
		|  И НЕ Номенклатура.Временная
		|  И НЕ Номенклатура.НаименованиеВременное
		|";

	Запрос.УстановитьПараметр("Артикул", Артикул);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Количество() = 1 И ВыборкаДетальныеЗаписи.Следующий() Тогда
		НайденнаяНоменклатура = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;

	Возврат НайденнаяНоменклатура;

КонецФункции

Функция НайтиНоменклатуру(
	  Артикул
	, Наименование = NULL
	, Бренд = NULL
	, КодНоменклатуры = NULL
	, ИсключеннаяНоменклатура = NULL
	, ДопустимаНеуникальность = Ложь
) Экспорт

	НайденнаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();

	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Возврат НайденнаяНоменклатура;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура
		|КАК
		|	Номенклатура
		|
		|ГДЕ Артикул = &Артикул
		|  И ВЫБОР
		|		КОГДА &Наименование IS NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ Номенклатура.Наименование = &Наименование
		|	КОНЕЦ
		|  И ВЫБОР
		|		КОГДА &Бренд IS NULL
		|			ТОГДА ИСТИНА
		|		КОГДА ТИПЗНАЧЕНИЯ(&Бренд) = ТИП(Справочник.СайтБренды)
		|			ТОГДА Номенклатура.Бренд = &Бренд
		|		ИНАЧЕ
		|			Номенклатура.Бренд.Наименование = &Бренд
		|	КОНЕЦ
		|  И ВЫБОР
		|		КОГДА &КодНоменклатуры IS NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ Номенклатура.Код = &КодНоменклатуры
		|	КОНЕЦ
		|  И ВЫБОР
		|		КОГДА &ИсключеннаяНоменклатура IS NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ Номенклатура.Ссылка <> &ИсключеннаяНоменклатура
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|  Номенклатура.ПометкаУдаления ВОЗР,
		|  Номенклатура.Временная ВОЗР,
		|  Номенклатура.НаименованиеВременное ВОЗР
		|";

	Запрос.УстановитьПараметр("Артикул"					, Артикул);
	Запрос.УстановитьПараметр("Наименование"			, Наименование);
	Запрос.УстановитьПараметр("Бренд"					, Бренд);
	Запрос.УстановитьПараметр("КодНоменклатуры"			, КодНоменклатуры);
	Запрос.УстановитьПараметр("ИсключеннаяНоменклатура"	, ИсключеннаяНоменклатура);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	ВсегоРезультатов = ВыборкаДетальныеЗаписи.Количество();

	Если ВыборкаДетальныеЗаписи.Следующий()
	   И (ВсегоРезультатов = 1 ИЛИ ДопустимаНеуникальность)
	Тогда
		НайденнаяНоменклатура = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;

	Возврат НайденнаяНоменклатура;


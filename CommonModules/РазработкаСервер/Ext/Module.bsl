			Продолжить;
		КонецЕсли;

		ЗагрузкаРезультат =  Результат.Получить("result");
		Ошибка = Результат.Получить("message"); 

		Если ЗагрузкаРезультат <> Истина  Тогда 
			ОбщегоНазначения.СообщитьОбОшибке("Ошибка ("+email + "  "+Наименование+")"+Ошибка);

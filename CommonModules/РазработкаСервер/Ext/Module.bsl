// удалить АдреснуюКнигу из sendPulse
Процедура УдалитьАдреснуюКнигуSendPulse(АдреснаяКнига, Ключ = Неопределено, Соед = Неопределено) Экспорт

	Аккаунт		= АдреснаяКнига.Аккаунт;
	ТекИд		= УбратьПробелыИзСтроки(АдреснаяКнига.ID);
	ИмяКниги	= СокрЛП(АдреснаяКнига.Наименование);

	Соед		= ?(Соед = Неопределено, Подключение(), Соед);
	Ключ		= ?(Ключ = Неопределено, ПолучитьКлюч(Соед, Аккаунт), Ключ);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	Запрос		= Новый HTTPЗапрос("/addressbooks/"+ТекИд,Заголовки);
	Ответ		= ПолучитьОтветНаЗапросДЭЛИТ(Соед, Запрос);

	СтрокаОтвета	= Ответ.ПолучитьТелоКакСтроку();

	Мас	= ПолучитьДанныеДжСОН(СтрокаОтвета);

	Если Мас = Неопределено Тогда
		Сообщить("Ошибка удаления книги: " + ТекИд + ", код ответа=" + Ответ.КодСостояния + " " + СтрокаОтвета);
		Возврат;
	КонецЕсли;

	Если Ответ.КодСостояния = 400 Тогда
		Результ	= Мас.Получить("error_code");
		Если Результ = 213 Тогда	// книга не найдена
			ОчиститьИД(АдреснаяКнига);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("Ошибка удаления книги: " + ТекИд + ", код ответа=" + Ответ.КодСостояния + " " + СтрокаОтвета);
	Иначе
		Результ	= Мас.Получить("result");
		Если Результ Тогда
			ОчиститьИД(АдреснаяКнига);
		Иначе
			ОбщегоНазначения.СообщитьОбОшибке("статус удаления книги " + ТекИд + ": " + СтрокаОтвета);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// создаёт адресные книги, которые есть в 1С, но нет на сервисе (через bookName), удаляет помеченые на удаление, выгружает емейлы
Процедура ВыгрузитьВсеАдресныеКниги(Аккаунт = Неопределено) Экспорт
	// если указан аккаунт, выгружаем только для данного аккаунта
	Если ЗначениеЗаполнено(Аккаунт) Тогда
		ВыгрузитьspАдресныеКниги(Аккаунт);
	Иначе
	// иначе выгружаем для всех аккаунтов
		ВыборкаАккаунтов = Справочники.spАккаунты.Выбрать();
		Пока ВыборкаАккаунтов.Следующий() Цикл
			Аккаунт = ВыборкаАккаунтов.Ссылка;
			ВыгрузитьspАдресныеКниги(Аккаунт);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузитьspАдресныеКниги(Аккаунт, ПередаватьВсе = Ложь) Экспорт 

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда 
		Сообщить("Перед выполнением нужно выбрать аккаунт! (ВыгрузитьspАдресныеКниги)");
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Аккаунт", Аккаунт);

	ВыборкаКниг  = Справочники.spАдресныеКниги.Выбрать(,, Отбор);

	ДатаНачала = Дата(1,1,1);

	Пока ВыборкаКниг.Следующий() Цикл 

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		ТекИд		= УбратьПробелыИзСтроки(ВыборкаКниг.ID);
		ИмяКниги	= СокрЛП(ВыборкаКниг.Наименование);

		// + 003590 ДДГ 22 окт 2020

		// если есть id
		Если ЗначениеЗаполнено(ТекИд) Тогда 
			Если ВыборкаКниг.ПометкаУдаления Тогда
				УдалитьАдреснуюКнигуSendPulse(ВыборкаКниг, Ключ, Соед);
				Продолжить;
			КонецЕсли;

			ВыгрузитьПолучателейАдреснойКниги(ВыборкаКниг.Ссылка, ПередаватьВсе, Ключ, Соед);
			Продолжить;

		КонецЕсли;

		// если нет id
		Если ВыборкаКниг.ПометкаУдаления Тогда 
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ИмяКниги) Тогда
			Сообщить("Наименование книги не должно быть пустым!");
			Продолжить;
		КонецЕсли;
		// - 003590 ДДГ 22 окт 2020

		Запрос=Новый HTTPЗапрос("/addressbooks?"+"bookName="+ИмяКниги,Заголовки);
		Запрос.УстановитьТелоИзСтроки("bookName="+ИмяКниги);
				
		Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);

		Если Ответ.КодСостояния<>200 Тогда
			
		КонецЕсли;

		СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();

		Результат = ПолучитьДанныеДжСОН(СтрокаОтвета);

		Если Результат = Неопределено Тогда
			ОбщегоНазначения.СообщитьОбОшибке("Ошибка при создании " + ИмяКниги + "! Причина:"+ СтрокаОтвета);
			Продолжить;
		КонецЕсли;

		ТекИД = Результат.Получить("id");
		
		СообщениеОбОшибке = Результат.Получить("message");
		
		Если ЗначениеЗаполнено(ТекИД) Тогда 
			ТекКнигаОбъект = ВыборкаКниг.Ссылка.ПолучитьОбъект();			
			ТекКнигаОбъект.ID = ТекИД;
			Попытка
				ТекКнигаОбъект.Записать();
				// + 003590 ДДГ 22 окт 2020
				ВыгрузитьПолучателейАдреснойКниги(ТекКнигаОбъект.Ссылка, ПередаватьВсе);
				// - 003590 ДДГ 22 окт 2020
			Исключение
			КонецПопытки;
		Иначе 
			ОбщегоНазначения.СообщитьОбОшибке("Ошибка при создании " + ИмяКниги + "! Причина:"+ СообщениеОбОшибке);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// перезаполняет емейлы адресной книги на сервисе из 1С (через id)
Процедура ВыгрузитьПолучателейАдреснойКниги(СсылкаНаКнигу, ПередаватьВсе = Ложь, Ключ = Неопределено, Соед = Неопределено) Экспорт 

	Если не ЗначениеЗаполнено(СсылкаНаКнигу) ИЛИ СсылкаНаКнигу.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	ИдКниги  = УбратьПробелыИзСтроки(СсылкаНаКнигу.ID);

	// + 003590 ДДГ 22 окт 2020
	Если Не ЗначениеЗаполнено(ИдКниги) Тогда
		//ОбщегоНазначения.СообщитьОбОшибке("У "+СсылкаНаКнигу +" нет ID выгрузка невозможна!");
		ИдКниги = ЗагрузитьАдреснуюКнигуНаSendPulse(СсылкаНаКнигу, Ключ, Соед);
		Если ИдКниги = -1 Тогда
			Возврат;
		Иначе
			ИдКниги = УбратьПробелыИзСтроки(ИдКниги);
		КонецЕсли;
	КонецЕсли;

	//СвойстваКниги = ВыгрузитьСвойстваАдреснойКниги(СсылкаНаКнигу);

	//Если СвойстваКниги = Неопределено Тогда
	//	ОбщегоНазначения.СообщитьОбОшибке("Книга " + СсылкаНаКнигу + " не найдена на сервисе!");
	//КонецЕсли;
	// - 003590 ДДГ 22 окт 2020

	Аккаунт		= СсылкаНаКнигу.Аккаунт;

	//соберем массив почт на сервисе
	ТекМассивПочтБыло = Новый  Массив;

	ДатаНачала = Дата(1,1,1);

	Для Инд=1 По 1000 Цикл   //цикл нужен, т.к. метод за 1 раз отдает не более 100 адресов

		Если ТекущаяДатаСеанса() - ДатаНачала > 3500 Тогда
			ДатаНачала	= ТекущаяДатаСеанса();
			Соед		= Подключение();
			Ключ		= ПолучитьКлюч(Соед, Аккаунт);
			Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);
		КонецЕсли;

		//ВыхИмя = ПолучитьИмяВременногоФайла("txt");
		//ОбработкаПрерыванияПользователя();
		Смещение = (Инд-1)*100;
		СмещениеСтрокой = УбратьПробелыИзСтроки(Смещение);
		Запрос = Новый HTTPЗапрос("/addressbooks/"+Сокрлп(ИдКниги)+"/emails?access_token="+Сокрлп(Ключ)+"&limit=100&offset="+СмещениеСтрокой,Заголовки);

		Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

		Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

		Если Результат = Неопределено
		 ИЛИ Результат.Количество()=0
		Тогда //кончились адреса
			Прервать;
		КонецЕсли;

		Если Ответ.КодСостояния <> 200 тогда
			СтрокаОшибкиОтвета = ПолучитьОшибкуОтветаSendPulse(Результат, Ответ.КодСостояния);
			Сообщить("Ошибка выгрузки емейлов из адресной книги: " + ИдКниги + СтрокаОшибкиОтвета);
			Возврат;
		КонецЕсли;

		Для Каждого Соотв Из Результат Цикл
			Почта 	= СокрЛП(Соотв["email"]);
			Если ЗначениеЗаполнено(Почта) Тогда 
				ТекМассивПочтБыло.Добавить(Почта);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// формирует массив почт хранящихся в 1С, но отсутствующих на сервисе
	Мас=Новый Массив;

	Для Каждого СтрокаПолучателя из СсылкаНаКнигу.Получатели Цикл 
		текПочта = СокрЛП(СтрокаПолучателя.Адрес); 
		текПочта = НРег(текПочта);

		// добавляет в Мас емейлы, которые есть в книге, но нет на сервисе
		Структ=Новый Структура;
		Структ.Вставить("email",текПочта);
		//Структ.Вставить("variables",Новый Структура("имя","Вася"));

		Если ЗначениеЗаполнено(текПочта) Тогда 
			ТекЭлемент = ТекМассивПочтБыло.Найти(текПочта);

			// убирает из ТекМассивПочтБыло емейлы, которые есть в книге
			Если ТекЭлемент <> Неопределено Тогда
				ТекМассивПочтБыло.Удалить(ТекЭлемент);
			КонецЕсли;

			// если ПередаватьВсе тогда
				// добавляем емейл в Мас
			// иначе
				// добавляет емейл в Мас если его нет на сервисе
			Если ПередаватьВсе ИЛИ ТекЭлемент = Неопределено Тогда
				Мас.Добавить(Структ);
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// отправляет на сервис список емейлов из 1С
	Если Мас.Количество() > 0 Тогда
		Запись=Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись,Мас); 
		Стр=Запись.Закрыть();

		Запрос=Новый HTTPЗапрос("/addressbooks/"+Сокрлп(ИдКниги)+"/emails",Заголовки);
		Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&emails="+Стр);

		Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());

	КонецЕсли;

	///елси добавлены -ок, то удаляемя лишние( приоритет 1С)
	Если Ответ.КодСостояния = 200 Тогда 

		// удаление емейлов, не найденных в базе 1С
		СтрокаУдаления ="";
		для Каждого ТекУдаления из ТекМассивПочтБыло Цикл 
			Адрес = СокрЛП(ТекУдаления);
			СтрокаУдаления = ""+СтрокаУдаления+?(ЗначениеЗаполнено(СтрокаУдаления),",","") + """"+Адрес+"""";
		КонецЦикла;

		Если ТекМассивПочтБыло.Количество() > 0 Тогда 

			Запрос=Новый HTTPЗапрос("/addressbooks/"+Сокрлп(ИдКниги)+"/emails",Заголовки);
			Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&emails=["+СтрокаУдаления+"]");
			Ответ = ПолучитьОтветНаЗапросДЭЛИТ(Соед, Запрос);
			ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());

		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// возвращает свойства адресной книги из сервиса (через ид)
Функция ВыгрузитьСвойстваАдреснойКниги(СсылкаНаКнигу) Экспорт

	Если не ЗначениеЗаполнено(СсылкаНаКнигу) ИЛИ СсылкаНаКнигу.ПометкаУдаления Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдКниги  = УбратьПробелыИзСтроки(СсылкаНаКнигу.ID);

	Если Не ЗначениеЗаполнено(ИдКниги) Тогда 
		Возврат Неопределено;
	КонецЕсли;

	Аккаунт		= СсылкаНаКнигу.Аккаунт;

	Соед		= Подключение();
	Ключ		= ПолучитьКлюч(Соед, Аккаунт);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	Запрос = Новый HTTPЗапрос("/addressbooks/" + Сокрлп(ИдКниги) + "?access_token="+Сокрлп(Ключ),Заголовки);

//	ВыхИмя = ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросГЕТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат Неопределено;
	КонецЕсли;

	Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Результат = Неопределено Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат Неопределено;
	КонецЕсли;

	СвойстваКниги = Новый Структура;

	// + 003590 ДДГ 22 окт 2020
	Для Каждого Соотв Из Результат Цикл
		СвойстваКниги.Вставить("ИмяКниги",					СокрЛП(Соотв["name"]));
		СвойстваКниги.Вставить("ИдКниги",					СокрЛП(Соотв["id"]));
		СвойстваКниги.Вставить("ОбщееКолвоАдресов",			Соотв["all_email_qty"]);
		СвойстваКниги.Вставить("КолвоАктивныхАдресов",		Соотв["active_email_qty"]);
		СвойстваКниги.Вставить("КолвоНеактивныхАдресов",	Соотв["inactive_email_qty"]);
		СвойстваКниги.Вставить("ДатаСоздания",				ПолучитьДатуИзСтрокиДжСОН((Соотв["creationdate"])));
		СвойстваКниги.Вставить("Статус",					Соотв["status"]);
		СвойстваКниги.Вставить("ОписаниеСтатуса",			Соотв["status_explain"]);
	КонецЦикла;	
	// - 003590 ДДГ 22 окт 2020

	Возврат СвойстваКниги;

КонецФункции

// создаёт новую адресную книгу на сервисе и получает её ид, либо -1 если не была создана
Функция ЗагрузитьАдреснуюКнигуНаSendPulse(СсылкаНаКнигу, Ключ = Неопределено, Соед = Неопределено) Экспорт

	Если не ЗначениеЗаполнено(СсылкаНаКнигу) Тогда
		Возврат -1;
	КонецЕсли;

	ИмяКниги = СокрЛП(СсылкаНаКнигу.Наименование);

	Если ПустаяСтрока(ИмяКниги) Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Наименование адресной книги не заполнено, книга создана не будет!");
		Возврат -1;
	КонецЕсли;

	Если СсылкаНаКнигу.ПометкаУдаления Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Адресная книга помечена на удаление, книга выгружена не будет!");
		Возврат -1;
	КонецЕсли;

	Аккаунт		= СсылкаНаКнигу.Аккаунт;

	Соед		= ?(Соед = Неопределено, Подключение(), Соед);
	Ключ		= ?(Ключ = Неопределено, ПолучитьКлюч(Соед, Аккаунт), Ключ);
	Заголовки	= ПолучитьЗаголовкиSendPulse(Ключ);

	Запрос = Новый HTTPЗапрос("/addressbooks", Заголовки);
	Запрос.УстановитьТелоИзСтроки("access_token="+Сокрлп(Ключ)+"&bookName="+ИмяКниги);

//	ВыхИмя = ПолучитьИмяВременногоФайла("txt");

	Ответ = ПолучитьОтветНаЗапросПОСТ(Соед, Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат -1;
	КонецЕсли;

	Результат = ПолучитьДанныеДжСОН(Ответ.ПолучитьТелоКакСтроку());

	Если Результат = Неопределено Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Код ответа="+Ответ.КодСостояния+" "+Ответ.ПолучитьТелоКакСтроку());
		Возврат -1;
	КонецЕсли;

	ИдКниги = СокрЛП(Результат["id"]);

	АдреснаяКнига = СсылкаНаКнигу.ПолучитьОбъект();
	АдреснаяКнига.ID = ИдКниги;
	АдреснаяКнига.Записать();

	Возврат ИдКниги;

КонецФункции

// получить все емейлы, привязанные к аккаунтом
Функция ПолучитьВыборкуВсехЕмейловАккаунтов(Регион = null) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АллокацииАккаунтов.ОбъектАллокации.Логин КАК Адрес
	|ИЗ
	|	РегистрСведений.АллокацииАккаунтов КАК АллокацииАккаунтов
	|ГДЕ
	|	АллокацииАккаунтов.ВидАллокации = ЗНАЧЕНИЕ(Перечисление.ВидыАллокаций.ПользователиСайтов)
	| И	НЕ АллокацииАккаунтов.Аккаунт.ПометкаУдаления
	| И	НЕ АллокацииАккаунтов.ОбъектАллокации.ПометкаУдаления
	| И	АллокацииАккаунтов.ОбъектАллокации.ВидЛогина = 2
	| И ВЫБОР
	| 	КОГДА &Регион IS NULL
	| 	ТОГДА ИСТИНА
	| 	ИНАЧЕ АллокацииАккаунтов.Аккаунт.Регион = &Регион
	| КОНЕЦ
	|";

	Если НЕ ЗначениеЗаполнено(Регион) Тогда
		Регион = null;
	КонецЕсли;

	Запрос.УстановитьПараметр("Регион", Регион);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Возврат Выборка;
КонецФункции

// + 51085 ДДГ 28 мар 2022
Функция ПолучитьВыборкуЕмейловДляДополненияАдреснойКнигиПоАккаунту(АдреснаяКнига = null, Регион = null) Экспорт

	Запрос = Новый Запрос;

	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	spАдресныеКнигиПолучатели.Адрес
	|ПОМЕСТИТЬ
	|	ПолучателиКниги
	|ИЗ
	|	Справочник.spАдресныеКниги.Получатели
	|КАК
	|	spАдресныеКнигиПолучатели
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &АдреснаяКнига IS NULL
	|		ТОГДА ИСТИНА
	|		ИНАЧЕ spАдресныеКнигиПолучатели.Ссылка = &АдреснаяКнига
	|	КОНЕЦ
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АллокацииАккаунтов.ОбъектАллокации.Логин КАК Адрес
	|ПОМЕСТИТЬ
	|	АдресаАккаунтов
	|ИЗ
	|	РегистрСведений.АллокацииАккаунтов.СрезПоследних(
	|		 , ВидАллокации = ЗНАЧЕНИЕ(Перечисление.ВидыАллокаций.ПользователиСайтов)
	|		 И НЕ Аккаунт.ПометкаУдаления
	|		 И НЕ ОбъектАллокации.ПометкаУдаления
	|		 И ОбъектАллокации.ВидЛогина = 2
	|		 И ВЫБОР
	|		 	КОГДА &Регион IS NULL
	|		 	ТОГДА ИСТИНА
	|		 	ИНАЧЕ Аккаунт.Регион = &Регион
	|		 КОНЕЦ
	|	) КАК АллокацииАккаунтов
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АдресаАккаунтов.Адрес,
	|	ИСТИНА КАК Добавить
	|ИЗ
	|	АдресаАккаунтов
	|ГДЕ
	|	АдресаАккаунтов.Адрес НЕ В (ВЫБРАТЬ Адрес ИЗ ПолучателиКниги)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПолучателиКниги.Адрес,
	|	ЛОЖЬ КАК Добавить
	|ИЗ
	|	ПолучателиКниги
	|ГДЕ
	|	ПолучателиКниги.Адрес НЕ В (ВЫБРАТЬ Адрес ИЗ АдресаАккаунтов)
	|
	|";

	Запрос.УстановитьПараметр("АдреснаяКнига",	АдреснаяКнига);
	Запрос.УстановитьПараметр("Регион",			Регион);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаРезультата = РезультатЗапроса.Выбрать();

	Возврат ВыборкаРезультата;

КонецФункции

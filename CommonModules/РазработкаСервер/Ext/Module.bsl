	, ПутьФайла
	, ЧислоПопыток	= 5
	, СпатьСекунд	= 5
) Экспорт

	ЗапросФайла = Новый HTTPЗапрос(ПутьФайла);

	Для ИДХ=1 ПО ЧислоПопыток Цикл
		Попытка

			ОтветСайта = СоединениеСайт.Получить(ЗапросФайла);

			Если ОтветСайта.КодСостояния = 200 Тогда

				ДанныеФайла =  ОтветСайта.ПолучитьТелоКакДвоичныеДанные();

				Возврат ДанныеФайла;

			КонецЕсли;

		Исключение
			Спать(СпатьСекунд);
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура Спать(Секунд) Экспорт

	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;

	КомандаWindows = "Timeout /T " + Формат(Секунд, "ЧГ=0"); // + " /NoBreak";
	WshShell = Новый COMОбъект("WScript.Shell"); 
	WshShell.Run(КомандаWindows, 0, -1);


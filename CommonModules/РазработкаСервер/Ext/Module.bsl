	Для Каждого КлючЗначение Из ИсходноеСоответствие Цикл
		Выбрано = КлючЗначение.Ключ;
		Прервать;
	КонецЦикла;

	Для Каждого КлючЗначение Из ИсходноеСоответствие Цикл

		Ключ = КлючЗначение.Ключ;

		Если Ключ < Выбрано Тогда
			Выбрано = Ключ;
		КонецЕсли;

	КонецЦикла;

	Возврат Выбрано;

КонецФункции

Функция ЭтоСоответствиеИлиСтруктураИлиМассив(ВходныеДанные) Экспорт
	Возврат ТипЗнч(ВходныеДанные) = Тип("Соответствие")
		ИЛИ ТипЗнч(ВходныеДанные) = Тип("Структура")
		ИЛИ ТипЗнч(ВходныеДанные) = Тип("Массив")
	;
КонецФункции

Функция СтрокаИзСоответствия(ИсходноеСоответствие) Экспорт

	СтрокаСоответствия = "";

	Для Каждого КлючЗначение Из ИсходноеСоответствие Цикл

		Ключ		= КлючЗначение.Ключ;
		Значение	= КлючЗначение.Значение;

		ТипЗначения = ТипЗнч(Значение);

		Если ТипЗначения = Тип("Соответствие")
		 ИЛИ ТипЗначения = Тип("Структура")
		Тогда
			СтрокаЗначения
				= Символы.ПС
				+ СтрокаИзСоответствия(Значение)
				+ Символы.ПС
			;
		Иначе
			СтрокаЗначения = Строка(Значение);
		КонецЕсли;

		СтрокаКлючЗначение = Строка(Ключ) + ": " + СтрокаЗначения + Символы.ПС;

		СтрокаСоответствия = СтрокаСоответствия + СтрокаКлючЗначение;

	КонецЦикла;

	Возврат СтрокаСоответствия;

КонецФункции

Функция ПолучитьПустуюСтруктуруСтрокиТаблицыЗначений(ИсходнаяТаблица) Экспорт

	ПустаяСтруктура = Новый Структура;

	КолонкиТаблицы = ИсходнаяТаблица.Колонки;

	Для Каждого Колонка Из КолонкиТаблицы Цикл
		ПустаяСтруктура.Вставить(Колонка.Имя, Неопределено);
	КонецЦикла;

	Возврат ПустаяСтруктура;

КонецФункции

Функция МассивСтруктурИзТаблицыЗначений(ИсходнаяТаблица, МассивКолонок = Неопределено) Экспорт

	МассивСтруктур = Новый Массив;

	Если МассивКолонок = Неопределено Тогда
		МассивКолонок = ПолучитьМассивКолонокТаблицыЗначений(ИсходнаяТаблица);
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ИсходнаяТаблица Цикл

		СтруктураСтроки = Новый Структура;

		МассивСтруктур.Добавить(СтруктураСтроки);

		Для Каждого ИмяКолонки Из МассивКолонок Цикл
			СтруктураСтроки.Вставить(ИмяКолонки, СтрокаТаблицы[ИмяКолонки]);
		КонецЦикла;

	КонецЦикла;

	Возврат МассивСтруктур;

КонецФункции

Функция СравнитьОбъектСоСтруктурой(ОбъектДанных, СтруктураСравнения) Экспорт

	Совпадают = Истина;

	Для Каждого КлючЗначение Из СтруктураСравнения Цикл

		Ключ		= КлючЗначение.Ключ;
		Значение	= КлючЗначение.Значение;

		Если ОбъектДанных[Ключ] <> Значение Тогда
			Совпадают = Ложь;
			Возврат Совпадают;
		КонецЕсли;

	КонецЦикла;

	Возврат Совпадают;

КонецФункции

Функция СравнитьПрименитьЗначенияПолейОбъекта(ПроверяемыйОбъект, СтруктураИлиСоответствие) Экспорт

	Совпадают = Истина;

	Для Каждого КлючЗначение Из СтруктураИлиСоответствие Цикл

		ИмяПоля			= КлючЗначение.Ключ;
		ЗначениеПоля	= КлючЗначение.Значение;

		Если ПроверяемыйОбъект[ИмяПоля] <> ЗначениеПоля Тогда
			ПроверяемыйОбъект[ИмяПоля] = ЗначениеПоля;
			Совпадают = Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Совпадают;

КонецФункции

Функция ПустаяСтруктураРегистраСведений(ИмяРегистра) Экспорт

	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();

	СтруктураПолей = Новый Структура;

	Измерения = Метаданные.РегистрыСведений[ИмяРегистра].Измерения;

	Для Каждого Измерение Из Измерения Цикл
		ИмяПоля = Измерение.Имя;
		ПустоеЗначение = МенеджерЗаписи[ИмяПоля];
		СтруктураПолей.Вставить(ИмяПоля, ПустоеЗначение);
	КонецЦикла;

	Ресурсы = Метаданные.РегистрыСведений[ИмяРегистра].Ресурсы;

	Для Каждого Ресурс Из Ресурсы Цикл
		ИмяПоля = Ресурс.Имя;
		ПустоеЗначение = МенеджерЗаписи[ИмяПоля];
		СтруктураПолей.Вставить(ИмяПоля, ПустоеЗначение);
	КонецЦикла;

	Реквизиты = Метаданные.РегистрыСведений[ИмяРегистра].Реквизиты;

	Для Каждого Реквизит Из Реквизиты Цикл
		ИмяПоля = Реквизит.Имя;
		ПустоеЗначение = МенеджерЗаписи[ИмяПоля];
		СтруктураПолей.Вставить(ИмяПоля, ПустоеЗначение);
	КонецЦикла;

	Возврат СтруктураПолей;

КонецФункции

Функция СфСтруктуруВозврата(СтатусОшибки, ТекстОшибки) Экспорт

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СтатусОшибки", СтатусОшибки);
	СтруктураВозврата.Вставить("ТекстОшибки" , ТекстОшибки);

	Возврат СтруктураВозврата;

КонецФункции

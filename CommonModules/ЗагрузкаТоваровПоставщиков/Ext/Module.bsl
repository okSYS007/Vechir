Функция im_Поставщики_Yugcontract_ПолучитьТокен()
	
	Токен = "";
	Url = "vstore.net.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки = Новый Соответствие;
	HTTPЗапрос = Новый HTTPЗапрос("index.php?route=api/yug/token", Заголовки);
	token = ПланыОбмена.Website.НайтиПоНаименованию("vstore.net.ua", Истина).Токен;
	
	ВремГраница = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	ТелоЗапроса = Новый ТекстовыйДокумент();
	ТелоЗапроса.РазделительСтрок = Символы.CR + Символы.LF;
	
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
	ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""token"";");
	ТелоЗапроса.ДобавитьСтроку("");
	ТелоЗапроса.ДобавитьСтроку(token);
	
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница + "--");
	
	ТелоЗапросаСтрока = ТелоЗапроса.ПолучитьТекст();
	
	HTTPЗапрос.Заголовки["Content-Type"] = "multipart/form-data; boundary=" + ВремГраница;
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаСтрока, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	// Отправляем
	Попытка
		Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			//Возврат Токен;
		КонецЕсли; 
		
		ЧтениеJSON = Новый ЧтениеJSON;                    
		ЧтениеJSON.УстановитьСтроку(мОтвет);
		Результат = ПрочитатьJSON(ЧтениеJSON);
		
		Если Результат.Свойство("status") И Результат.status = "ok" И ТипЗнч(Результат.content) = Тип("Структура") Тогда
			Токен = Результат.content.authToken;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Токен;
	
КонецФункции

Функция im_Поставщики_Yugcontract_ПолучитьКатегориДляТоваров(Поставщик)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Категории.Категория
	|ИЗ
	|	Справочник.im_ПоставщикиИнтернетМагазина.КатегорииПоставщиков КАК Категории
	|ГДЕ
	|	НЕ Категории.Категория В
	|				(ВЫБРАТЬ
	|					im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Категория.Родитель
	|				ИЗ
	|					Справочник.im_ПоставщикиИнтернетМагазина.КатегорииПоставщиков КАК im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков
	|				ГДЕ
	|					im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Ссылка = &Поставщик)
	|	И Категории.Использовать = ИСТИНА
	|	И Категории.Категория.Поставщик = &Поставщик
	|
	|СГРУППИРОВАТЬ ПО
	|	Категории.Категория";
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 0 Тогда 
		Возврат РезультатЗапроса.ВыгрузитьКолонку("Категория"); 
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции


			КатегорияСправочник.Записать();
		Иначе
			КатегорияСправочник					= СсылкаНаКатегорию.ПолучитьОбъект();
			КатегорияСправочник.ID				= ИдКатегории;
			КатегорияСправочник.Наименование	= НаименованиеКатегории;
			КатегорияСправочник.Родитель		= КорневаяПапка;
			КатегорияСправочник.Поставщик		= Справочники.im_ПоставщикиИнтернетМагазина.Renklod;
			КатегорияСправочник.Записать();

		КонецЕсли;

	КонецЦикла;
	
	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Наименование");
	Товары.Колонки.Добавить("Артикул");
	Товары.Колонки.Добавить("ID");
	Товары.Колонки.Добавить("Бренд");
	Товары.Колонки.Добавить("Категория");
	Товары.Колонки.Добавить("URL");
	Товары.Колонки.Добавить("ДилерскаяЦена");
	Товары.Колонки.Добавить("РРЦ");
	Товары.Колонки.Добавить("ПромоЦена");
	Товары.Колонки.Добавить("Количество");
	Товары.Колонки.Добавить("Модель");
	Товары.Колонки.Добавить("АкционнаяЦена");
	Товары.Колонки.Добавить("ДатаНачалаАкции");
	Товары.Колонки.Добавить("ДатаОкончанияАкции");
	Товары.Колонки.Добавить("Штрихкод");
	Товары.Колонки.Добавить("Картинки");	
	Товары.Колонки.Добавить("Картинка");
	
	Для Каждого Товар Из XDTO.shop.offers.offer Цикл
		нстр = Товары.Добавить();
		нстр.Количество = 0;
		масКартинки = Новый Массив;
		нстр.Картинки = масКартинки;
		Для Каждого стр Из Товар.Свойства() Цикл
			Если стр.Имя = "id" Тогда
				нстр.ID = Товар.id;
			КонецЕсли;
			Если стр.Имя = "available" Тогда
				Если Товар.available = "" ИЛИ Товар.available = "0" Тогда
					нстр.Количество = 0;
				ИначеЕсли Товар.available = ">10" Тогда	
					нстр.Количество = 10;
				иначе	
					нстр.Количество = Товар.available;
				КонецЕсли;	
			КонецЕсли;
			Если стр.Имя = "categoryId" Тогда
				нстр.Категория = im_Поставщики_Renklod_ПолучитьКатегориюИнтернетМагазина(Товар.categoryID, Справочники.im_ПоставщикиИнтернетМагазина.Renklod);
			КонецЕсли;
			Если стр.Имя = "vendorCode" Тогда
				нстр.Артикул = Товар.vendorCode;
			КонецЕсли;
			Если стр.Имя = "name" Тогда
				нстр.Наименование = Товар.name;
				нстр.Модель = Товар.name;
			КонецЕсли;
			Если стр.Имя = "vendor" Тогда
				нстр.Бренд = Товар.vendor;
			КонецЕсли;
			Если стр.Имя = "price" Тогда
				нстр.РРЦ = Товар.price.Последовательность().ПолучитьТекст(0);
			КонецЕсли;
			Если стр.Имя = "picture" Тогда
				Если ТипЗнч(Товар.picture) = Тип("СписокXDTO") Тогда
					Для Каждого стрКартинок Из Товар.picture Цикл

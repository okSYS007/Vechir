Процедура im_Поставщики_ERC_ПолучитьКартинки(Токен, НомерСтраницы, Страниц, Артикул, Картинки)
	
	Url = "api.erc.ua";
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки = Новый Соответствие;
	//Заголовки.Вставить("Content-Type", "application/json"); 
	Заголовки.Вставить("X-AUTH-TOKEN", Токен); 
		
	HTTPЗапрос = Новый HTTPЗапрос("/v1/ware/images/sku/"+Артикул+"?page="+Строка(НомерСтраницы), Заголовки);
	Попытка
		Ответ 	= Соединение.Получить(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат;
		КонецЕсли; 
		
		ЧтениеJSON = Новый ЧтениеJSON;                    
		ЧтениеJSON.УстановитьСтроку(мОтвет);
		Результат = ПрочитатьJSON(ЧтениеJSON,Истина);

		Если ТипЗнч(Результат) = Тип("Соответствие") Тогда 
			
			pagination = Результат.Получить("pagination");
			Если pagination <> Неопределено Тогда 
				
				Тотал = pagination.Получить("total");
				ЛимитНаСтранице = pagination.Получить("limit");
				Если ЛимитНаСтранице > 0 Тогда
					
					Если Тотал / ЛимитНаСтранице = Цел(Тотал / ЛимитНаСтранице) Тогда
						Страниц = Тотал / ЛимитНаСтранице;
					Иначе
					    Страниц = Цел(Тотал / ЛимитНаСтранице) + 1;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			content = Результат.Получить("content");
			Если content <> Неопределено И ТипЗнч(content) = Тип("Массив")  Тогда 
				Для Каждого стр Из content Цикл
					Картинки.Добавить(стр.Получить("src"));
				КонецЦикла;
			КонецЕсли;							
			
		КонецЕсли;	
		
		Если НомерСтраницы < Страниц Тогда
			НомерСтраницы = НомерСтраницы + 1;
			im_Поставщики_ERC_ПолучитьКартинки(Токен, НомерСтраницы, Страниц, Артикул, Картинки);
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры	

Функция im_Поставщики_ERC_ПолучитьТокен()
	
	Токен = "";
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("ERC");
	Логин  = СтрПодключение.Логин;
	Пароль = СтрПодключение.Пароль;
	Url = "api.erc.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки = Новый Соответствие;
	HTTPЗапрос = Новый HTTPЗапрос("/v1/auth", Заголовки);
	Username = Логин;
	Password = Пароль;
		
	ВремГраница = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	ТелоЗапроса = Новый ТекстовыйДокумент();
	ТелоЗапроса.РазделительСтрок = Символы.CR + Символы.LF;
	
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
	ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""username"";");
	ТелоЗапроса.ДобавитьСтроку("");
	ТелоЗапроса.ДобавитьСтроку(Username);

	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница);
	ТелоЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""password"";");
	ТелоЗапроса.ДобавитьСтроку("");
	ТелоЗапроса.ДобавитьСтроку(Password);
		
	ТелоЗапроса.ДобавитьСтроку("--" + ВремГраница + "--");

	ТелоЗапросаСтрока = ТелоЗапроса.ПолучитьТекст();
	
	HTTPЗапрос.Заголовки["Content-Type"] = "multipart/form-data; boundary=" + ВремГраница;
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаСтрока, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

    // Отправляем
	Попытка
		Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			//Возврат Токен;
		КонецЕсли; 
		
		ЧтениеJSON = Новый ЧтениеJSON;                    
		ЧтениеJSON.УстановитьСтроку(мОтвет);
		Результат = ПрочитатьJSON(ЧтениеJSON);
		
		Если Результат.Свойство("token") Тогда
			Токен = Результат.token;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Токен;
	
КонецФункции	

Процедура im_Поставщики_ПроверкаНепришедшихТоваров(Поставщик)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	         |	im_НоменклатураПоставщиков.Ссылка
	         |ИЗ
	         |	Справочник.im_НоменклатураПоставщиков КАК im_НоменклатураПоставщиков
	         |ГДЕ
	         |	im_НоменклатураПоставщиков.Поставщик = &Поставщик
	         |	И im_НоменклатураПоставщиков.ДатаОбновления < &ДатаОбновления";
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("ДатаОбновления", ТекущаяДата()-24*60*60);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			
	Для Каждого Строка из РезультатЗапроса Цикл 
		
		НоменклатураПоставщикаОб 				= Строка.Ссылка.ПолучитьОбъект();
		НоменклатураПоставщикаОб.Количество 	= 0;
		НоменклатураПоставщикаОб.ДатаОбновления = ТекущаяДата();
		Попытка
			НоменклатураПоставщикаОб.Записать();
		Исключение
		КонецПопытки;

	КонецЦикла;
	

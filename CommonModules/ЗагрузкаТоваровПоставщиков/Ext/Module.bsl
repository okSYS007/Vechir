Процедура im_Поставщики_Deps_ЗагрузитьНоменклатуру(СоотвествиеЗАгруженных, Токен, ИдКатегории, ЛимитСтарт = Неопределено, Лимит = Неопределено,ТаблицаЦен,ТаблицаОстатков)
	
	Url = "deps.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json"); 
	Заголовки.Вставить("Authorization","Bearer "+Токен); 
	
	HTTPЗапрос = Новый HTTPЗапрос("/index.php?option=com_jshopping&controller=addon_api&section=product&task=search&limit="+ СтрЗаменить(Строка(Лимит),Символы.НПП,"") +"&limitstart="+ СтрЗаменить(Строка(ЛимитСтарт),Символы.НПП,"") +"&args[categories][]="+СтрЗаменить(Строка(ИдКатегории),Символы.НПП,""),Заголовки);
	
	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат;
	КонецЕсли; 
	
	ЧтениеJSON = Новый ЧтениеJSON;                    
	ЧтениеJSON.УстановитьСтроку(мОтвет);
	Результат = ПрочитатьJSON(ЧтениеJSON,Истина);
	
	СоотвествиеКатегорий = Результат.Получить("result");
	
	Пагинация = СоотвествиеКатегорий.Получить("pagination");
	
	Тотал = Число(Пагинация.Получить("total"));	
	Лимит = Тотал;
	Пока Тотал >= 0 Цикл
		
		Url = "deps.ua";	
		Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type","application/json"); 
		Заголовки.Вставить("Authorization","Bearer "+Токен); 
		
		HTTPЗапрос = Новый HTTPЗапрос("/index.php?option=com_jshopping&controller=addon_api&section=product&task=search&limit="+ СтрЗаменить(Строка(Лимит),Символы.НПП,"") +"&limitstart="+ СтрЗаменить(Строка(ЛимитСтарт),Символы.НПП,"") +"&args[categories][]="+СтрЗаменить(Строка(ИдКатегории),Символы.НПП,""),Заголовки);
		
		Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат;
		КонецЕсли; 
		
		ЧтениеJSON = Новый ЧтениеJSON;                    
		ЧтениеJSON.УстановитьСтроку(мОтвет);
		Результат = ПрочитатьJSON(ЧтениеJSON,Истина);
		
		СоотвествиеКатегорий = Результат.Получить("result");
		Пагинация = СоотвествиеКатегорий.Получить("pagination");
		
		МассивПродуктов = СоотвествиеКатегорий.Получить("products");
		
		Сч = 0;
		МассивМодификаций = Новый Массив;
		
		Для Каждого Товар из МассивПродуктов Цикл
			МассивМодификаций.Очистить();
			Если Товар.Получить("hasAttributes") Тогда 
				
				Url = "deps.ua";	
				Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
				
				Заголовки = Новый Соответствие;
				Заголовки.Вставить("Content-Type","application/json"); 
				Заголовки.Вставить("Authorization","Bearer "+Токен); 
				
				HTTPЗапрос = Новый HTTPЗапрос("/index.php?option=com_jshopping&controller=addon_api&section=product&task=item&args[id]="+СтрЗаменить(Строка(Товар.Получить("product_id")), Символы.НПП, ""),Заголовки);
				
				Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
				мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
				
				Если Ответ.КодСостояния <> 200 Тогда
					Возврат;
				КонецЕсли; 
				
				ЧтениеJSON = Новый ЧтениеJSON;                    
				ЧтениеJSON.УстановитьСтроку(мОтвет);
				Результат = ПрочитатьJSON(ЧтениеJSON,Истина);
				
				СоответствиеМодификация = Результат.Получить("result").Получить("product").Получить("product_attribute_datas").Получить("attributeValues");
				
				
				Для Каждого ЭлементСоответствия из СоответствиеМодификация  цикл
					МассивМодификаций = ЭлементСоответствия.Значение;
					Прервать;
				КонецЦикла;;
			КонецЕсли;
			
			ИдНоменклатуры = Товар.Получить("product_id");			
			
			ИдКатегории = СтрЗаменить(Строка(Товар.Получить("category_id")), Символы.НПП, "");
			ИдТовара = СтрЗаменить(Строка(Товар.Получить("product_id")), Символы.НПП, "");
			Артикул = Товар.Получить("manufacturer_code");
			
			НастройкиКатегории = Справочники.im_ПоставщикиИнтернетМагазина.Deps.КатегорииПоставщиков.НайтиСтроки(новый Структура("Категория", im_Поставщики_Deps_ПолучитьКатегориюИнтернетМагазина(ИдКатегории, Справочники.im_ПоставщикиИнтернетМагазина.Deps)));
			
			Если ЗначениеЗаполнено(НастройкиКатегории) Тогда 
				
				Если НастройкиКатегории[0].использовать Тогда 
					
					Попытка
						
						Если МассивМодификаций.количество() Тогда 
							
							Для Каждого Модификация из МассивМодификаций Цикл 
								ИдТовара  = СтрЗаменить(Строка(Товар.Получить("product_id")), Символы.НПП, "")+"_"+СтрЗаменить(Модификация.Получить("val_id"),Символы.НПП,"");
								НоменклатурыПоставщика = im_Поставщики_Deps_ПолучитьТоварИнтернетМагазина(ИдТовара, Справочники.im_ПоставщикиИнтернетМагазина.Deps);	
								
								Если НоменклатурыПоставщика.Пустая() Тогда
									НоменклатурыПоставщика = im_Поставщики_Deps_СоздатьОбновитьТовар(ИдТовара, Товар, Неопределено, Артикул,Модификация);
								Иначе						
									im_Поставщики_Deps_СоздатьОбновитьТовар(ИдТовара, Товар, НоменклатурыПоставщика, Артикул,Модификация);
								КонецЕсли;
								
								СтрокаЦен = ТаблицаЦен.Добавить();
								СтрокаЦен.Номенклатура = НоменклатурыПоставщика.ссылка;
								СтрокаЦен.ЦенаРРЦ      = ?(ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура) = 0, НоменклатурыПоставщика.РРЦ, ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура));
								СтрокаЦен.Фиксированная      = ?(ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура) = 0, Ложь, Истина);
								СтрокаЦен.ЦенаДиллер   = НоменклатурыПоставщика.ДилерскаяЦена;
								СтрокаЦен.ЦенаПромо    = НоменклатурыПоставщика.ПромоЦена;
								Если СтрокаЦен.ЦенаДиллер>=СтрокаЦен.ЦенаРРЦ Тогда 
									//СтрокаЦен.ЦенаРРЦ = Окр(СтрокаЦен.ЦенаДиллер+СтрокаЦен.ЦенаДиллер/100*5,0,РежимОкругления.Окр15как20);
								КонецЕсли;
								
								СтрокаОстатков = ТаблицаОстатков.Добавить();
								СтрокаОстатков.Номенклатура = НоменклатурыПоставщика.ссылка;
								СтрокаОстатков.Остаток      = НоменклатурыПоставщика.Количество;
								
								
								
							КонецЦикла;
							
						Иначе
							
							НоменклатурыПоставщика = im_Поставщики_Deps_ПолучитьТоварИнтернетМагазина(ИдТовара, Справочники.im_ПоставщикиИнтернетМагазина.Deps);
							
							Если НоменклатурыПоставщика.Пустая() Тогда
								НоменклатурыПоставщика = im_Поставщики_Deps_СоздатьОбновитьТовар(ИдТовара, Товар, Неопределено, Артикул);
							Иначе						
								im_Поставщики_Deps_СоздатьОбновитьТовар(ИдТовара, Товар, НоменклатурыПоставщика, Артикул);
							КонецЕсли;
							
							СтрокаЦен = ТаблицаЦен.Добавить();
							СтрокаЦен.Номенклатура = НоменклатурыПоставщика.ссылка;
							СтрокаЦен.ЦенаРРЦ      = ?(ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура) = 0, НоменклатурыПоставщика.РРЦ, ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура));
							СтрокаЦен.Фиксированная      = ?(ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура) = 0, Ложь, Истина);
							СтрокаЦен.ЦенаДиллер   = НоменклатурыПоставщика.ДилерскаяЦена;
							СтрокаЦен.ЦенаПромо    = НоменклатурыПоставщика.ПромоЦена;
							
							СтрокаОстатков = ТаблицаОстатков.Добавить();
							СтрокаОстатков.Номенклатура = НоменклатурыПоставщика.ссылка;
							СтрокаОстатков.Остаток      = НоменклатурыПоставщика.Количество;
						КонецЕсли;
					Исключение
						Сообщить(ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Тотал = Тотал - Лимит;
		ЛимитСтарт = ЛимитСтарт + Лимит;
		
	КонецЦикла;
	
КонецПроцедуры

функция im_Поставщики_Deps_СделатьЗапросПокатегориям(Токен, ТекущиеКолвоЭлементов = Неопределено, лимитСтарт = Неопределено, Ид)
	

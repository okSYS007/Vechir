Функция im_Поставщики_Ecoflow_СоздатьОбновитьТоварEcoflow(ID, Товар, ТоварССылка, Артикул)
	
	Если Товар.name.Свойство("___Текст_") Тогда
		
		Если ЗначениеЗаполнено(ТоварССылка) Тогда 
			ОбНоменклатура = ТоварССылка.ПолучитьОбъект();
		Иначе
			ОбНоменклатура                   = Справочники.im_НоменклатураПоставщиков.СоздатьЭлемент();	
		КонецЕсли;
		
		ОбНоменклатура.ID                = Товар.___Атрибуты_.id;
		ОбНоменклатура.Артикул           = Артикул;
		ОбНоменклатура.Наименование      = Товар.name.___Текст_;
		ОбНоменклатура.Категория         = im_Поставщики_Ecoflow_ПолучитьКатегориюИнтернетМагазина(Товар.categoryId.___Текст_, Справочники.im_ПоставщикиИнтернетМагазина.Ecoflow);
		ОбНоменклатура.Поставщик         = Справочники.im_ПоставщикиИнтернетМагазина.Ecoflow;
		//ОбНоменклатура.Бренд             = ?(Товар.brand.Свойство("___Текст_"),Товар.brand.___Текст_,"");
		ОбНоменклатура.Родитель          = im_Поставщики_Ecoflow_ПолучитьГруппуКатегориюИнтернетМагазина(Товар.categoryId.___Текст_, Справочники.im_ПоставщикиИнтернетМагазина.Ecoflow, Истина);
		ОбНоменклатура.URL	             = Товар.url.___Текст_;
		
		Если Товар.param.Количество() > 0  Тогда	
			Для Каждого Элемент Из Товар.param Цикл 
				Если Элемент.___Атрибуты_.name = "Наявність" Тогда
					Если Элемент.___Текст_ = "В наявності" Тогда
						ОбНоменклатура.Количество = 100;
					Иначе	
						ОбНоменклатура.Количество = 0;
					КонецЕсли;
					Прервать;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;		
		
		Если Товар.picture.количество() Тогда 
			ОбНоменклатура.Изображениия.Очистить();
			Для каждого Картинка из Товар.picture Цикл 
				ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
				ОбКартинка.URL = Картинка.___Текст_;
			КонецЦикла;
		КонецЕсли;
		//ОбНоменклатура.Количество        = ?(Товар.stock.___Текст_ = "no",0,100);
		ОбНоменклатура.РРЦ               = Товар.price.___Текст_;
// н ЛИВ
	//Если ОбНоменклатура.РРЦ <> Цел(ОбНоменклатура.РРЦ) Тогда
	//	ОбНоменклатура.РРЦ               = Окр(ОбНоменклатура.РРЦ + 0.5 , 0,0);
	//КонецЕсли;
// к ЛИВ
		ОбНоменклатура.Модель            = Товар.vendorCode.___Текст_;
		ОбНоменклатура.ДатаОбновления    = ТекущаяДата();
		
		ОбНоменклатура.Записать();
		
		Возврат ОбНоменклатура;
		
	КонецЕсли;
	
	Возврат Справочники.im_НоменклатураПоставщиков.ПустаяСсылка();
	
КонецФункции



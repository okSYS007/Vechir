			СтрокаТовары = ДокументОбъект.Товары.Добавить();
			СтрокаТовары.Номенклатура = стр.Номенклатура;
			СтрокаТовары.ТипЦен = ТипЦенНоменклатуры;
			СтрокаТовары.ИндексСтрокиТаблицыЦен = ИндексСтрокиТаблицыЦен;
			СтрокаТовары.Цена = стр.Цена;
			СтрокаТовары.Валюта = ТипЦенНоменклатуры.ВалютаЦены;
			СтрокаТовары.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
			СтрокаТовары.ПроцентСкидкиНаценки = ТипЦенНоменклатуры.ПроцентСкидкиНаценки;
			СтрокаТовары.СпособРасчетаЦены = ТипЦенНоменклатуры.СпособРасчетаЦены;
			
		КонецЦикла;
		
	КонецЦикла;
	ДокументОбъект.Комментарий = "Цені РРЦ deps";
	//ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	
	ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Дилерская цена", Истина);
	Если Не ЗначениеЗаполнено(ТипЦены) Тогда
		Возврат;
	КонецЕсли;
	ЦеныНоменклатуры = Новый Массив;
	ЦеныНоменклатуры.Добавить(ТипЦены);
	ИндексСтрокиТаблицыЦен = 0;
	
	ДокументОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДата();
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
	НовСтрТипЦен 		= ДокументОбъект.ТипыЦен.Добавить();
	НовСтрТипЦен.ТипЦен = ТипЦены;
	ИндексСтрокиТаблицыЦен = 0;
	
	Для Каждого стр Из ТаблицаЦенОстатков Цикл
		
		Для Каждого ТипЦенНоменклатуры Из ЦеныНоменклатуры Цикл
			
			Если  Число(стр.ЦенаДилер) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТовары = ДокументОбъект.Товары.Добавить();
			СтрокаТовары.Номенклатура = стр.Номенклатура;
			СтрокаТовары.ТипЦен = ТипЦенНоменклатуры;
			СтрокаТовары.ИндексСтрокиТаблицыЦен = ИндексСтрокиТаблицыЦен;
			СтрокаТовары.Цена = стр.ЦенаДилер;
			СтрокаТовары.Валюта = ТипЦенНоменклатуры.ВалютаЦены;
			СтрокаТовары.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
			СтрокаТовары.ПроцентСкидкиНаценки = ТипЦенНоменклатуры.ПроцентСкидкиНаценки;
			СтрокаТовары.СпособРасчетаЦены = ТипЦенНоменклатуры.СпособРасчетаЦены;
			
		КонецЦикла;
		
	КонецЦикла;
	ДокументОбъект.Комментарий = "Цені дилерская deps";
	//ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	
	Для Каждого СтрТовар из ТаблицаЦенОстатков  ЦИКЛ 
		Если СтрТовар.Количество > 0 Тогда
			Запись = РегистрыСведений.ТоварыНаСкладахПоставщиков.СоздатьМенеджерЗаписи();
			Запись.Период = ТекущаяДата();
			Запись.Номенклатура =  СтрТовар.Номенклатура;
			ЗАпись.Количество = СтрТовар.Количество;
			Запись.Записать();
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры


Процедура ЗагрузитьНоменклатуру(СоотвествиеЗАгруженных,Токен,ИдКатегории,лимитСтарт= Неопределено,Лимит = Неопределено)
	
	
	
	
	
	РезультатНомен = СделатьЗапросПокатегориям(Токен,Лимит,лимитСтарт,ИдКатегории);
	СоотвествиеКатегорий = РезультатНомен.Получить("result");	
	Пагинация = СоотвествиеКатегорий.Получить("pagination");
	
	
	
	Тотал = Число(Пагинация.Получить("total"));	
	ЛимитСтарт = Число(Пагинация.Получить("limitstart"));
	Если Тотал >= (Лимит+ЛимитСтарт) Тогда
		ЗагрузитьНоменклатуру(Токен,ИдКатегории,Лимит+ЛимитСтарт,Лимит);
	КонецЕсли;
	
	
	
	
	
	МассивПродуктов = СоотвествиеКатегорий.Получить("products");
	
	Для Каждого СтрНомен из МассивПродуктов Цикл
		
		
		ИдНоменклатуры = СтрНомен.Получить("product_id");
		
		УжеЗагруженна = СоотвествиеЗАгруженных.Получить(СтрЗаменить(Строка(ИдНоменклатуры)," ",""));
		Если УжеЗагруженна <> Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		
		Url = "deps.ua";	
		Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type","application/json"); 
		Заголовки.Вставить("Authorization","Bearer "+Токен); 
		
		HTTPЗапрос = Новый HTTPЗапрос("/index.php?option=com_jshopping&controller=addon_api&section=product&task=item&args[id]="+СтрЗаменить(Строка(ИдНоменклатуры),Символы.НПП,""),Заголовки);
		
		Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат;
		КонецЕсли; 
		
		ЧтениеJSON = Новый ЧтениеJSON;                    
		ЧтениеJSON.УстановитьСтроку(мОтвет);
		Результат = ПрочитатьJSON(ЧтениеJSON,Истина);
		
		
		Если  Результат.Получить("status") = "ok"   Тогда
			//ЗаписатьДанныеВРегистрСведений(Токен,"product","item","",мОтвет);	
		КонецЕсли; 
		ИнфоНомен = Результат.Получить("result");
		
		СтруктураНоменклатуры = ИнфоНомен.Получить("product");
		
		
		
		
		СпрСсылкаНоменклатуры = Справочники.Номенклатура.НайтиПоРеквизиту("DepsId",СтрЗаменить(Строка(ИдНоменклатуры)," ",""));
		
		
		Если СпрСсылкаНоменклатуры.Пустая() Тогда
			
			ОбНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
			ОбНоменклатура.DepsId = СтрЗаменить(Строка(ИдНоменклатуры)," ","");
			ОбНоменклатура.Наименование = СтруктураНоменклатуры.Получить("name_uk-UA");
			ОбНоменклатура.Наименование_ru = СтруктураНоменклатуры.Получить("name_ru-UA");
			ОбНоменклатура.Наименование_en =    "";
			ОбНоменклатура.БазоваяЕдиницаИзмерения =  Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("шт.");
			ОбНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар");
			ОбНоменклатура.Родитель = Справочники.Номенклатура.НайтиПоРеквизиту("DepsIdCategory",СтрЗаменить(Строка(СтрНомен.Получить("category_id")),Символы.НПП,""));	
			ОбНоменклатура.ДополнительноеОписаниеНоменклатуры  =СтруктураНоменклатуры.Получить("full_description_uk-UA");
			ОбНоменклатура.ДополнительноеОписаниеНоменклатуры_ru =  СтруктураНоменклатуры.Получить("full_description_ru-UA");
			ОбНоменклатура.ДополнительноеОписаниеНоменклатуры_en = СтруктураНоменклатуры.Получить("full_description_en-GB");
			
			ОбНоменклатура.Записать();
			
			НовЕдиница 				= Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			НовЕдиница.Наименование = "шт";
			НовЕдиница.Владелец 	= ОбНоменклатура.Ссылка;
			НовЕдиница.Коэффициент  = 1;
			НовЕдиница.ЕдиницаПоКлассификатору = ОбНоменклатура.БазоваяЕдиницаИзмерения;
			НовЕдиница.Записать();
			
			ОбНоменклатура.ЕдиницаДляОтчетов 		= НовЕдиница.Ссылка;
			ОбНоменклатура.ЕдиницаХраненияОстатков 	= НовЕдиница.Ссылка;
			
			
			ОбНоменклатура.Записать();
			
			
		Иначе
			Продолжить;				
		КонецЕсли;
		
		ДопСвойства = Обработки.ЗначенияСвойствОбъекта.Создать();
		ДопСвойства.ОбъектОтбораЗначений = ОбНоменклатура.Ссылка;
		ДопСвойства.ПрочитатьЗаполнитьСвойстваИЗначения();
		
		ЗначениеСвойствОбъектов = СтрНомен.Получить("extra_field");
		Для Каждого Свств из ЗначениеСвойствОбъектов Цикл 
			
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Свойство", ПолучитьСвойствоНоменклатуры(Свств.Значение.Получить("name"))); 
			СтрПоиска.Вставить("ПометкаУдаления", Ложь);
			
			НайденныеСтроки = ДопСвойства.СвойстваИЗначения.НайтиСтроки(СтрПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(Свств.Значение.Получить("value"),,,НайденныеСтроки[0].Свойство);
				Если Значение.Пустая() Тогда
					ЗначениеСвойств = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
					ЗначениеСвойств.Наименование =  Свств.Значение.Получить("value");
					ЗначениеСвойств.Наименование_en =  Свств.Значение.Получить("value");
					ЗначениеСвойств.Наименование_ru =  Свств.Значение.Получить("value");
					ЗначениеСвойств.Владелец =  НайденныеСтроки[0].Свойство;
					ЗначениеСвойств.Записать();
					
				Иначе
					ЗначениеСвойств = Значение;
					
				КонецЕсли;
				НайденныеСтроки[0].Значение = ЗначениеСвойств.Ссылка;	
				
			Иначе
				
				НовСвойство 					= ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
				НовСвойство.Наименование 		= Свств.Значение.Получить("name");
				НовСвойство.Наименование_en 	= Свств.Значение.Получить("name");
				НовСвойство.Наименование_ru 	= Свств.Значение.Получить("name");
				НовСвойство.НазначениеСвойства 	= ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_Номенклатура;
				//НовСвойство.ТипЗначения			= ;;
				НовСвойство.Записать();
				
				СтрПоиска = Новый Структура;
				СтрПоиска.Вставить("Свойство", ПолучитьСвойствоНоменклатуры(Свств.Значение.Получить("name")));
				СтрПоиска.Вставить("ПометкаУдаления", Ложь);
				
				ДопСвойства.ПрочитатьЗаполнитьСвойстваИЗначения();
				
				НайденныеСтроки = ДопСвойства.СвойстваИЗначения.НайтиСтроки(СтрПоиска);
				
				Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(Свств.Значение.Получить("name"),,,НайденныеСтроки[0].Свойство);
				Если Значение.Пустая() Тогда
					ЗначениеСвойств = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
					ЗначениеСвойств.Наименование =  Свств.Значение.Получить("value");
					ЗначениеСвойств.Наименование_en =  Свств.Значение.Получить("value");
					ЗначениеСвойств.Наименование_ru =  Свств.Значение.Получить("value");
					ЗначениеСвойств.Владелец =  НовСвойство.Ссылка;
					ЗначениеСвойств.Записать();
					
				Иначе
					ЗначениеСвойств = Значение;
				КонецЕсли;
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					НайденныеСтроки[0].Значение = ЗначениеСвойств;	
				КонецЕсли;
				
			КонецЕсли;
			
			
		КонецЦикла;
		
		ДопСвойства.ЗаписатьЗначенияСвойств();
		Url = "deps.ua";	
		Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type","application/json"); 
		Картинки = ИнфоНомен.Получить("images");
		
		Если Картинки.Количество() Тогда
			ИмяФайла = Картинки[0].Получить("image_thumb");
			HTTPЗапрос = Новый HTTPЗапрос("/components/com_jshopping/files/img_products/"+ИмяФайла,Заголовки);
			
			Ответ 	= Соединение.Получить(HTTPЗапрос);	
			//мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
			Фото =  Ответ.ПолучитьТелоКакДвоичныеДанные() ;
			
			
			Если Ответ.КодСостояния <> 200 Тогда
				Возврат;
			КонецЕсли; 
			ХранилищеДопИнфо = ПолучитьКартинку(ОбНоменклатура.Ссылка,""+ СтрЗаменить(ИмяФайла,".jpg","") + "Загружен с сайта депс");
			Если ХранилищеДопИнфо <> Неопределено Тогда 
				ОбНоменклатура.ОсновноеИзображение = ХранилищеДопИнфо;
				ОбНоменклатура.Записать();	
			Иначе
				НовыйОбъект = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
				НовыйОбъект.ВидДанных = Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение;
				
				
				
				НовыйОбъект.Хранилище = Новый ХранилищеЗначения(Новый Картинка(Фото), Новый СжатиеДанных);
				НовыйОбъект.Объект = ОбНоменклатура.Ссылка;
				НовыйОбъект.ИмяФайла = ""+ СтрЗаменить(ИмяФайла,".jpg","") + "Загружен с сайта депс";
				НовыйОбъект.Записать();
				ОбНоменклатура.ОсновноеИзображение = НовыйОбъект.Ссылка;
				ОбНоменклатура.Записать();
				
			КонецЕсли;
		КонецЕсли;
		
		
		СоотвествиеЗАгруженных.Вставить(СтрЗаменить(Строка(ИдНоменклатуры)," ",""));
	КонецЦикла;
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
КонецПроцедуры


Процедура ЗагрузкаТоваровВиатек(Параметр) Экспорт
	ЗагрузкаКаталогаВиатек("product_info_uk");
КонецПроцедуры

Процедура ЗагрузкаКаталогаВиатек(Каталог) Экспорт
	
	Url = "viatec.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки  = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json"); 
	HTTPЗапрос = Новый HTTPЗапрос("/files/"+Каталог+".xml",Заголовки);
	Ответ 	   = Соединение.Получить(HTTPЗапрос);
	Структура  = ПолучитьСтруктуруИзХМЛ(Ответ.ПолучитьТелоКакСтроку());
	//----------------------------------------------------------------------------------------------------------------------//
	Товары = Структура.sitedata.products.product;
	Сч = 0;
	
	ТаблицаЦен = новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.im_НоменклатураПоставщиков"));
	ТаблицаЦен.Колонки.Добавить("ЦенаРРЦ", Новый ОписаниеТипов("Число"));
	ТаблицаЦен.Колонки.Добавить("ЦенаДиллер", Новый ОписаниеТипов("Число"));
	ТаблицаЦен.Колонки.Добавить("ЦенаПромо", Новый ОписаниеТипов("Число"));
	ТаблицаЦен.Колонки.Добавить("Фиксированная", Новый ОписаниеТипов("Булево"));
	
	ТаблицаОстатков = новый ТаблицаЗначений;
	ТаблицаОстатков.Колонки.Добавить("Номенклатура");
	ТаблицаОстатков.Колонки.Добавить("Остаток");
	
	Для каждого  Товар Из Товары Цикл
		
		НастройкиКатегории = Справочники.im_ПоставщикиИнтернетМагазина.VIATEC.КатегорииПоставщиков.НайтиСтроки(новый Структура("Категория", ПолучитьКатегориюИнтернетМагазина(Товар.category_id.___Текст_,Справочники.im_ПоставщикиИнтернетМагазина.VIATEC)));
		
		Если ЗначениеЗаполнено(НастройкиКатегории) Тогда 
			
			
			Если НастройкиКатегории[0].использовать Тогда 
				
				Попытка
					НоменклатурыПоставщика = ПолучитьНоменклатуруИнтернетМагазина(Товар.id.___Текст_,Справочники.im_ПоставщикиИнтернетМагазина.VIATEC,Ложь);
					
					Если НоменклатурыПоставщика.Пустая() Тогда
						НоменклатурыПоставщика = СоздатьОбновитьТоварViatec(Товар.id.___Текст_,Товар,Неопределено);
					Иначе						
						СоздатьОбновитьТоварViatec(Товар.id.___Текст_,Товар,НоменклатурыПоставщика);
					КонецЕсли;
					Если НоменклатурыПоставщика.Количество >0 и ЗначениеЗаполнено(НоменклатурыПоставщика.Номенклатура) Тогда 
						СтрокаЦен = ТаблицаЦен.Добавить();
						СтрокаЦен.Номенклатура = НоменклатурыПоставщика.ссылка;
						СтрокаЦен.ЦенаРРЦ      = ?(ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура)=0,НоменклатурыПоставщика.РРЦ,ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура));
						СтрокаЦен.Фиксированная      = ?(ЦенаФиксированная(СтрокаЦен.Номенклатура.Номенклатура) = 0, Ложь, Истина);
						СтрокаЦен.ЦенаДиллер   = НоменклатурыПоставщика.ДилерскаяЦена;
						СтрокаЦен.ЦенаПромо    = НоменклатурыПоставщика.ПромоЦена;
						Если СтрокаЦен.ЦенаДиллер>=СтрокаЦен.ЦенаРРЦ Тогда 
							//СтрокаЦен.ЦенаРРЦ = Окр(СтрокаЦен.ЦенаДиллер+СтрокаЦен.ЦенаДиллер/100*5,0,РежимОкругления.Окр15как20);
						КонецЕсли;

					КонецЕсли;
					СтрокаОстатков = ТаблицаОстатков.Добавить();
					СтрокаОстатков.Номенклатура = НоменклатурыПоставщика.ссылка;
					СтрокаОстатков.Остаток      = НоменклатурыПоставщика.Количество;
					
					
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	
	СоздатьУстановкуЦен(ТаблицаЦен,Справочники.im_ПоставщикиИнтернетМагазина.VIATEC);
	ОбновитьОстатки(ТаблицаОстатков,Справочники.im_ПоставщикиИнтернетМагазина.VIATEC);
// н ЛИВ
	im_Поставщики_ПроверкаНепришедшихТоваров(Справочники.im_ПоставщикиИнтернетМагазина.VIATEC);	
// к ЛИВ
	
КонецПроцедуры

Функция НужноУстанавливатьЦену(НоменклатураПоставщика,ТекущийДокумент)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Цена,
	|	НАЧАЛОПЕРИОДА(ЦеныНоменклатурыСрезПоследних.Регистратор.Дата, ДЕНЬ) КАК ДатаУстановки
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ТипЦен.Код = ""000000005""
	|				И Номенклатура = &Номенклатура и Регистратор <> &Регистратор) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("Номенклатура",НоменклатураПоставщика.Номенклатура);
	Запрос.УстановитьПараметр("Регистратор",ТекущийДокумент);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Цена = РезультатЗапроса[0].цена;
		Дата = РезультатЗапроса[0].ДатаУстановки;
		
		Если Дата <> началоДня(ТекущаяДата()) Тогда 
			
			Возврат Истина;
			
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура СоздатьУстановкуЦен(ТаблицаЦен,Поставщик)
	
	ТипЦенРРЦ           = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Интернет-магазин");
	
	ДокументУставнокаЦен = НайтиДокументУстановкиЦен(НачалоДня(ТекущаяДата()),ТипЦенРРЦ,Поставщик);
	
	Если ЗначениеЗаполнено(НайтиДокументУстановкиЦен(НачалоДня(ТекущаяДата()),ТипЦенРРЦ,Поставщик)) Тогда 
		ДокументОбъект = ДокументУставнокаЦен.ПолучитьОбъект();
		ДокументОбъект.Товары.Очистить();
	Иначе
		
		ДокументОбъект      = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДата();
		ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
		
		НовСтрТипЦен 		= ДокументОбъект.ТипыЦен.Добавить();
		НовСтрТипЦен.ТипЦен = ТипЦенРРЦ;
		
	КонецЕсли;	
	ИндексСтрокиТаблицыЦен = 0;
	
// н ЛИВ
	ТЗЦеныМин = ОбработатьЦеныВыбратьМинимальную(ТаблицаЦен);
// к ЛИВ
	
	Для Каждого Строка из ТаблицаЦен Цикл 
		
		Если  (Число(Строка.ЦенаРРЦ) = 0 или Не ЗначениеЗаполнено(Строка.Номенклатура.Номенклатура))   Тогда
			Продолжить;
		КонецЕсли;
		НайденныеСтроки = ДокументОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура",Строка.Номенклатура.Номенклатура));
		Если не НайденныеСтроки.количество() Тогда 
			СтрокаТовары = ДокументОбъект.Товары.Добавить();
			СтрокаТовары.Номенклатура           = Строка.Номенклатура.Номенклатура;
			СтрокаТовары.ТипЦен                 = ТипЦенРРЦ;
			СтрокаТовары.ИндексСтрокиТаблицыЦен = ИндексСтрокиТаблицыЦен;
// н ЛИВ			
			//СтрокаТовары.Цена                   = Окр(Строка.ЦенаРРЦ+0.5,0,РежимОкругления.Окр15как20)-1;
			Если Строка.Фиксированная Тогда
				
				СтрокаТовары.Цена                   = Окр(Строка.ЦенаРРЦ+0.5,0,РежимОкругления.Окр15как20)-1;
				
			Иначе
				
				НайденнаяСтрока = ТЗЦеныМин.Найти(Строка.Номенклатура.Номенклатура, "Номенклатура");		
			    Если НайденнаяСтрока <> Неопределено Тогда
					//СтрокаТовары.Цена                   = НайденнаяСтрока.ЦенаМин;
					СтрокаТовары.Цена                   = Окр(НайденнаяСтрока.ЦенаМин+0.5,0,РежимОкругления.Окр15как20)-1;	
				Иначе	
					СтрокаТовары.Цена                   = Окр(Строка.ЦенаРРЦ+0.5,0,РежимОкругления.Окр15как20)-1;	
				КонецЕсли;
			
			КонецЕсли;
// к ЛИВ			
			СтрокаТовары.Валюта                 = ТипЦенРРЦ.ВалютаЦены;
			СтрокаТовары.ЕдиницаИзмерения       = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
			СтрокаТовары.ПроцентСкидкиНаценки   = ТипЦенРРЦ.ПроцентСкидкиНаценки;
			СтрокаТовары.СпособРасчетаЦены      = ТипЦенРРЦ.СпособРасчетаЦены;
		КонецЕсли;
	КонецЦикла;
	ДокументОбъект.Товары.Свернуть("Номенклатура,ТипЦен,ИндексСтрокиТаблицыЦен,Цена,Валюта,ЕдиницаИзмерения,ПроцентСкидкиНаценки,СпособРасчетаЦены");
	ДокументОбъект.Комментарий = "#Встановлення ціни "+ ТипЦенРРЦ +" "+Поставщик +"";
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	КонецПопытки;
	
	ТипЦенДилер         = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000008");
	ДокументУставнокаЦен = НайтиДокументУстановкиЦен(НачалоДня(ТекущаяДата()),ТипЦенДилер,Поставщик);
	Если ЗначениеЗаполнено(ДокументУставнокаЦен) Тогда 
		ДокументОбъект = ДокументУставнокаЦен.ПолучитьОбъект();
		ДокументОбъект.Товары.Очистить();
		
	Иначе
		
		ДокументОбъект      = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		ДокументОбъект.Дата = НачалоДня(ТекущаяДата());
		НовСтрТипЦен 		= ДокументОбъект.ТипыЦен.Добавить();
		НовСтрТипЦен.ТипЦен = ТипЦенДилер;
		ИндексСтрокиТаблицыЦен = 0;
		
	КонецЕсли;	
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
	
	
	Для Каждого Строка из ТаблицаЦен Цикл 
		
		Если  Число(Строка.ЦенаДиллер) = 0 или Не ЗначениеЗаполнено(Строка.Номенклатура.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовары = ДокументОбъект.Товары.Добавить();
		СтрокаТовары.Номенклатура           = Строка.Номенклатура.Номенклатура;
		СтрокаТовары.ТипЦен                 = ТипЦенДилер;
		СтрокаТовары.ИндексСтрокиТаблицыЦен = ИндексСтрокиТаблицыЦен;
		СтрокаТовары.Цена                   = Строка.ЦенаДиллер;
		СтрокаТовары.Валюта                 = ТипЦенДилер.ВалютаЦены;
		СтрокаТовары.ЕдиницаИзмерения       = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
		СтрокаТовары.ПроцентСкидкиНаценки   = ТипЦенДилер.ПроцентСкидкиНаценки;
		СтрокаТовары.СпособРасчетаЦены      = ТипЦенДилер.СпособРасчетаЦены;
	КонецЦикла;
	ДокументОбъект.Товары.Свернуть("Номенклатура,ТипЦен,ИндексСтрокиТаблицыЦен,Цена,Валюта,ЕдиницаИзмерения,ПроцентСкидкиНаценки,СпособРасчетаЦены");
	ДокументОбъект.Комментарий = "#Встановлення ціни " +  ТипЦенДилер+ " " +Поставщик +"";
	Если ДокументОбъект.Товары.Количество() Тогда 
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// н ЛИВ
Функция ОбработатьЦеныВыбратьМинимальную(ТаблицаЦен)

	ОтборНоменклатураПоставщиков = ТаблицаЦен.ВыгрузитьКолонку("Номенклатура");
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	im_НоменклатураПоставщиков.Номенклатура
	               |ИЗ
	               |	Справочник.im_НоменклатураПоставщиков КАК im_НоменклатураПоставщиков
	               |ГДЕ
	               |	im_НоменклатураПоставщиков.Ссылка В (&ОтборНоменклатураПоставщиков)";
	
	Запрос.УстановитьПараметр("ОтборНоменклатураПоставщиков", ОтборНоменклатураПоставщиков);
	
	НоменклатураОтбор = запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");

	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	im_НоменклатураПоставщиков.Ссылка
	               |ПОМЕСТИТЬ Ном
	               |ИЗ
	               |	Справочник.im_НоменклатураПоставщиков КАК im_НоменклатураПоставщиков
	               |ГДЕ
	               |	im_НоменклатураПоставщиков.Номенклатура В(&НоменклатураОтбор)
	               |	И im_НоменклатураПоставщиков.ПометкаУдаления = ЛОЖЬ
	               |	И im_НоменклатураПоставщиков.ДатаОбновления > &ДатаОбновления
	               |	И im_НоменклатураПоставщиков.РРЦ <> 0
	               |	И im_НоменклатураПоставщиков.Количество <> 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	im_НоменклатураПоставщиков.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Ном.Ссылка.Номенклатура КАК Номенклатура,
	               |	МИНИМУМ(Ном.Ссылка.РРЦ) КАК ЦенаМин
	               |ИЗ
	               |	Ном КАК Ном
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Ном.Ссылка.Номенклатура";
	
	Запрос.УстановитьПараметр("НоменклатураОтбор", НоменклатураОтбор);
	Запрос.УстановитьПараметр("ДатаОбновления", ТекущаяДата() - 60*60*24*1);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();

	Возврат РезультатЗапроса;
	
КонецФункции

// к ЛИВ

Процедура ОбновитьОстатки(ТаблицаОстатков,Поставщик)
	
	Для Каждого СтрТовар из ТаблицаОстатков  ЦИКЛ 
		Если ЗначениеЗаполнено(СтрТовар.Номенклатура.Номенклатура) Тогда 
			Запись              = РегистрыСведений.ТоварыНаСкладахПоставщиков.СоздатьМенеджерЗаписи();
			Запись.Период       = ТекущаяДата();
			Запись.Номенклатура = СтрТовар.Номенклатура.Номенклатура;
			ЗАпись.Количество   = СтрТовар.Остаток;
			Запись.Записать();
			
			//ПланыОбмена.ЗарегистрироватьИзменения(ПланыОбмена.ОбменССайтомТоварами.НайтиПоКоду("T2"),СтрТовар.Номенклатура.Номенклатура);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьОстатокТовара(Номенклатура)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТоварыНаСкладахПоставщиковСрезПоследних.Количество
	|ИЗ
	|	РегистрСведений.ТоварыНаСкладахПоставщиков.СрезПоследних(, Номенклатура = &Номенклатура) КАК ТоварыНаСкладахПоставщиковСрезПоследних";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		
		Возврат	РезультатЗапроса[0].Количество;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
КонецФункции

Функция ЦенаФиксированная(Номенклатура)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ТипЦен.Код = ""000000010""
	|				И Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Возврат РезультатЗапроса[0].Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция НайтиДокументУстановкиЦен(Дата,ТипЦен,Поставщик)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	УстановкаЦенНоменклатуры.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	УстановкаЦенНоменклатуры.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И УстановкаЦенНоменклатуры.ТипыЦен.ТипЦен = &ТипЦен
	|	И УстановкаЦенНоменклатуры.Комментарий ПОДОБНО &Комментарий";
	Запрос.УстановитьПараметр("НачалоПериода",Дата);
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	Запрос.УстановитьПараметр("ТипЦен",ТипЦен);
	Запрос.УстановитьПараметр("Комментарий","#Встановлення ціни " +  ТипЦен+ " " +Поставщик +"");
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Возврат РезультатЗапроса[0].ссылка;
	Иначе
		Возврат Документы.УстановкаЦенНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьКатегорииViatec(структура,каталог)
	Категории = Структура.sitedata.categories.category;
	Сч = 0;
	
	Для каждого  Категория Из Категории Цикл
		//сч = сч+1;
		//Если сч > 10 Тогда 
		//	Продолжить;	
		//КонецЕсли;
		//
		
		
		//СвойстваКатегории = Категория.Свойства();
		
		Если Не Категория.Свойство("parent_Id")  Тогда
			КорневаяПапка = Справочники.Номенклатура.НайтиПоНаименованию(Каталог);	
			
		Иначе
			КорневаяПапка = Справочники.Номенклатура.НайтиПоРеквизиту("ViaTekIdCategory",""+Каталог+"_"+Категория.parent_id.___Текст_)	
			
		КонецЕсли;
		
		ИдКатегории = ""+Каталог+"_"+Категория.id.___Текст_;
		НаименованиеКатегории = Категория.title.___Текст_;
		СсылкаНаКатегорию = Справочники.Номенклатура.НайтиПоРеквизиту("ViaTekIdCategory",ИдКатегории);
		Если СсылкаНаКатегорию.Пустая() Тогда
			ОбКатегории = Справочники.Номенклатура.СоздатьГруппу();
			ОбКатегории.ViaTekIdCategory = ИдКатегории;
			ОбКатегории.Наименование   = НаименованиеКатегории;
			//ОбКатегории.НаименованиеПолное   = НаименованиеКатегории;
			ОбКатегории.Наименование_ru   = НаименованиеКатегории;
			ОбКатегории.Наименование_en   = НаименованиеКатегории;
			ОбКатегории.Родитель		  = КорневаяПапка;
			ОбКатегории.Записать();
			
		Иначе
			
			Если  СсылкаНаКатегорию.Родитель <> КорневаяПапка Тогда
				
				ОбКатегории = СсылкаНаКатегорию.ПолучитьОбъект();
				ОбКатегории.Родитель = КорневаяПапка;
				ОбКатегории.Записать();
				
			КонецЕсли;
		КонецЕсли;
		
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСвойстаТовараViatec(ОбНоменклатура,товар,ТаблицаОстатков)
	ДопСвойства = Обработки.ЗначенияСвойствОбъекта.Создать();
	ДопСвойства.ОбъектОтбораЗначений = ОбНоменклатура.Ссылка;
	ДопСвойства.ПрочитатьЗаполнитьСвойстваИЗначения();
	
	Если Товар.properties.Свойство("property") Тогда
		
		ЗначениеСвойствОбъектов = Товар.properties.property; 
		
		Если  ТипЗнч(ЗначениеСвойствОбъектов) = Тип("Структура") Тогда
			
			ЗначениеСвойствОбъектов = Новый Массив; 
			ЗначениеСвойствОбъектов.Добавить(Товар.properties.property);
			
		КонецЕсли;	
		Для Каждого Свств из ЗначениеСвойствОбъектов Цикл 
			
			Если Свств.name.___Текст_ = "Штрихкод" Тогда
				
				
				
				ТекЗапись = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
				
				ТекЗапись.Владелец         = ОбНоменклатура.Ссылка;
				ТекЗапись.ЕдиницаИзмерения = ОбНоменклатура.ЕдиницаХраненияОстатков;
				ТекЗапись.ТипШтрихкода     = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
				ТекЗапись.Качество         = Справочники.Качество.Новый;
				ТекЗапись.Штрихкод         = Свств.value.___Текст_;
				
				Попытка
					ТекЗапись.Записать();
				Исключение
				КонецПопытки;
				
				Продолжить;	
				
			ИначеЕсли Свств.name.___Текст_ = "Наявність" Тогда
				НоваяСтрока = ТаблицаОстатков.Добавить();
				НоваяСтрока.Номенклатура = ОбНоменклатура.Ссылка;
				Если Свств.name.___Текст_ = "В наявності" Тогда
					
					НоваяСтрока.Остаток =50;
					
				Иначе
					НоваяСтрока.Остаток =0;
				КонецЕсли;
				
				
				
			КонецЕсли;
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Свойство", ПолучитьСвойствоНоменклатуры(Свств.name.___Текст_)); 
			СтрПоиска.Вставить("ПометкаУдаления", Ложь);
			
			НайденныеСтроки = ДопСвойства.СвойстваИЗначения.НайтиСтроки(СтрПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(Свств.value.___Текст_,,,НайденныеСтроки[0].Свойство);
				Если Значение.Пустая() Тогда
					ЗначениеСвойств = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
					ЗначениеСвойств.Наименование =  Свств.value.___Текст_;
					ЗначениеСвойств.Наименование_en = Свств.value.___Текст_;
					ЗначениеСвойств.Наименование_ru =  Свств.value.___Текст_;
					ЗначениеСвойств.Владелец =  НайденныеСтроки[0].Свойство;
					ЗначениеСвойств.Записать();
					
				Иначе
					ЗначениеСвойств = Значение;
					
				КонецЕсли;
				НайденныеСтроки[0].Значение = ЗначениеСвойств.Ссылка;	
				
			Иначе
				
				НовСвойство 					= ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
				НовСвойство.Наименование 		= Свств.name.___Текст_;
				НовСвойство.Наименование_en 	= Свств.name.___Текст_;
				НовСвойство.Наименование_ru 	= Свств.name.___Текст_;
				НовСвойство.НазначениеСвойства 	= ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_Номенклатура;
				//НовСвойство.ТипЗначения			= ;;
				НовСвойство.Записать();
				
				СтрПоиска = Новый Структура;
				СтрПоиска.Вставить("Свойство", ПолучитьСвойствоНоменклатуры(Свств.name.___Текст_));
				СтрПоиска.Вставить("ПометкаУдаления", Ложь);
				
				ДопСвойства.ПрочитатьЗаполнитьСвойстваИЗначения();
				
				НайденныеСтроки = ДопСвойства.СвойстваИЗначения.НайтиСтроки(СтрПоиска);
				Попытка
					Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(Свств.name.___Текст_,,,НайденныеСтроки[0].Свойство);
					
					Если Значение.Пустая() Тогда
						ЗначениеСвойств = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
						ЗначениеСвойств.Наименование =  Свств.value.___Текст_;
						ЗначениеСвойств.Наименование_en =  Свств.value.___Текст_;
						ЗначениеСвойств.Наименование_ru =  Свств.value.___Текст_;
						ЗначениеСвойств.Владелец =  НовСвойство.Ссылка;
						ЗначениеСвойств.Записать();
						
					Иначе
						ЗначениеСвойств = Значение;
					КонецЕсли;
					
					Если НайденныеСтроки.Количество() > 0 Тогда
						НайденныеСтроки[0].Значение = ЗначениеСвойств;	
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			
		КонецЦикла;
		
		ДопСвойства.ЗаписатьЗначенияСвойств();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКартинкиТовараViatec(ОбНоменклатура,Товар)
	КартинкиСписок =  Товар.image; 
	Если Товар.Свойство("image") Тогда
		Если ТипЗнч(КартинкиСписок) = тип("Структура") Тогда
			
			КартинкиСписок = Новый массив;
			КартинкиСписок.Добавить(Товар.image.___Текст_);
			
			
		КонецЕсли;
		
		ЭтоПерваяКартика = Истина;
		
		Для Каждого Картинка из КартинкиСписок  Цикл
			
			ДлинаУрл = СтрДлина(Картинка);	
			ГлавнаяЧастьУрл = Найти(Картинка,"/content");
			
			ВторичнаяЧастьУрл = Стрзаменить(Картинка,"https://viatec.ua/","");
			
			
			Url = "viatec.ua";	
			Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
			
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("Content-Type","application/json"); 
			
			
			
			ИмяФайла = Товар.model.___Текст_;
			HTTPЗапрос = Новый HTTPЗапрос(ВторичнаяЧастьУрл,Заголовки);
			
			Ответ 	= Соединение.Получить(HTTPЗапрос);	
			//мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
			Фото =  Ответ.ПолучитьТелоКакДвоичныеДанные() ;
			
			
			Если Ответ.КодСостояния <> 200 Тогда
				Возврат;
			КонецЕсли; 
			ХранилищеДопИнфо = ПолучитьКартинку(ОбНоменклатура.Ссылка,""+ИмяФайла + "Загружен с сайта ViaTek");
			Если ХранилищеДопИнфо <> Неопределено Тогда 
				//	ОбНоменклатура.ОсновноеИзображение = ХранилищеДопИнфо;
				//	ОбНоменклатура.Записать();	
			Иначе
				НовыйОбъект = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
				НовыйОбъект.ВидДанных = Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение;
				
				
				
				НовыйОбъект.Хранилище = Новый ХранилищеЗначения(Новый Картинка(Фото), Новый СжатиеДанных);
				НовыйОбъект.Объект = ОбНоменклатура.Ссылка;
				НовыйОбъект.ИмяФайла = ""+ИмяФайла + "Загружен с сайта ViaTek";
				НовыйОбъект.Записать(); 
				Если ЭтоПерваяКартика Тогда
					ОбНоменклатура.ОсновноеИзображение = НовыйОбъект.Ссылка;
					ОбНоменклатура.Записать();
					ЭтоПерваяКартика= Ложь;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьОбновитьТоварViatec(ID,Товар,ТоварССылка)
	
	Если ЗначениеЗаполнено(ТоварССылка) Тогда 
		ОбНоменклатура = ТоварССылка.ПолучитьОбъект();
	Иначе
		ОбНоменклатура                   = Справочники.im_НоменклатураПоставщиков.СоздатьЭлемент();	
	КонецЕсли;
	
	ОбНоменклатура.ID                = ID;
	ОбНоменклатура.Артикул           = Товар.code.___Текст_;
	ОбНоменклатура.Наименование      = Товар.title.___Текст_+" "+Товар.model.___Текст_;
	ОбНоменклатура.Категория         = ПолучитьКатегориюИнтернетМагазина(Товар.category_id.___Текст_,Справочники.im_ПоставщикиИнтернетМагазина.VIATEC);
	ОбНоменклатура.Поставщик         = Справочники.im_ПоставщикиИнтернетМагазина.VIATEC;
	ОбНоменклатура.Бренд             = ?(Товар.brand.Свойство("___Текст_"),Товар.brand.___Текст_,"");
	ОбНоменклатура.Родитель          = ПолучитьНоменклатуруИнтернетМагазина(Товар.category_id.___Текст_,Справочники.im_ПоставщикиИнтернетМагазина.VIATEC,Истина);
	ОбНоменклатура.URL	             = Товар.url.___Текст_;
	ОбНоменклатура.Количество        = ?(Товар.stock.___Текст_ = "no",0,100);
	ОбНоменклатура.РРЦ               = Товар.price_uah.___Текст_;
// н ЛИВ
	//Если ОбНоменклатура.РРЦ <> Цел(ОбНоменклатура.РРЦ) Тогда
	//	ОбНоменклатура.РРЦ               = Окр(ОбНоменклатура.РРЦ + 0.5 , 0,0);
	//КонецЕсли;
// к ЛИВ
	ОбНоменклатура.Модель            = Товар.model.___Текст_;
	ОбНоменклатура.ДатаОбновления    = ТекущаяДата();
	
	Попытка
		ОбНоменклатура.Изображениия.Очистить();
		СтрокаКартинки= ОбНоменклатура.Изображениия.Добавить();
		СтрокаКартинки.URL = Товар.image.___Текст_;
	Исключение
	КонецПопытки;
	
	ОбНоменклатура.Записать();
	
	Возврат ОбНоменклатура; 
КонецФункции

Процедура СоздатьУстановкуЦенViatec(ТаблицаЦенОстатков)
	
	ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("РРЦ", Истина);
	Если Не ЗначениеЗаполнено(ТипЦены) Тогда
		Возврат;
	КонецЕсли;
	ЦеныНоменклатуры = Новый Массив;
	ЦеныНоменклатуры.Добавить(ТипЦены);
	ИндексСтрокиТаблицыЦен = 0;
	
	ДокументОбъект      = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДата();
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
	НовСтрТипЦен 		= ДокументОбъект.ТипыЦен.Добавить();
	НовСтрТипЦен.ТипЦен = ТипЦены;
	ИндексСтрокиТаблицыЦен = 0;
	
	Для Каждого стр Из ТаблицаЦенОстатков Цикл
		
		Для Каждого ТипЦенНоменклатуры Из ЦеныНоменклатуры Цикл
			
			Если  Число(стр.Цена) = 0 или стр.ЦенаУстановлена Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТовары = ДокументОбъект.Товары.Добавить();
			СтрокаТовары.Номенклатура           = стр.Номенклатура;
			СтрокаТовары.ТипЦен                 = ТипЦенНоменклатуры;
			СтрокаТовары.ИндексСтрокиТаблицыЦен = ИндексСтрокиТаблицыЦен;
			СтрокаТовары.Цена                   = стр.Цена;
			СтрокаТовары.Валюта                 = ТипЦенНоменклатуры.ВалютаЦены;
			СтрокаТовары.ЕдиницаИзмерения       = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
			СтрокаТовары.ПроцентСкидкиНаценки   = ТипЦенНоменклатуры.ПроцентСкидкиНаценки;
			СтрокаТовары.СпособРасчетаЦены      = ТипЦенНоменклатуры.СпособРасчетаЦены;
			
		КонецЦикла;
		
	КонецЦикла; 
	
	
	ДокументОбъект.Комментарий = "Цены РРЦ Viatec";
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузкаТоваровМТИ(Параметр) Экспорт
	Url = "products.mti.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	HTTPЗапрос = Новый HTTPЗапрос("/api/?action=getCatalog&key=Sqceh4xB9PvL",Заголовки);
	Ответ 	= Соединение.Получить(HTTPЗапрос);	
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат;
	КонецЕсли; 
	
	Структура = ПолучитьСтруктуруИзХМЛ(Ответ.ПолучитьТелоКакСтроку());
	Категории = Структура.root.categorieslist.category;
	ТЗКатегории = Новый ТаблицаЗначений;
	ТЗКатегории.Колонки.Добавить("categoryID");

// н Категории
	КатегорииОтборЗагрузка = im_Поставщики_МТИ_ПолучитьКатегориДляТоваровСКодом(Справочники.im_ПоставщикиИнтернетМагазина.МТИ);
// к Категории
	
	Для каждого  Категория Из Категории Цикл
		//
		ИдКатегории = Категория.___Атрибуты_.id;
		НаименованиеКатегории = Категория.___Текст_;

		Если Категория.___Атрибуты_.Свойство("parentid") Тогда
			ИдРодитель = Категория.___Атрибуты_.parentid;
		Иначе
			ИдРодитель = "";
		КонецЕсли;
		
// н Категории
		Если КатегорииОтборЗагрузка.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		НайтиКатегорию = КатегорииОтборЗагрузка.Найти(ИдКатегории, "КатегорияIDКатегории");
		Если НайтиКатегорию = Неопределено Тогда
			Продолжить;
		КонецЕсли;
// к Категории
		
		Если Не ЗначениеЗаполнено(ИдРодитель) ИЛИ ИдРодитель = "0" Тогда
			//КорневаяПапка = Справочники.im_НоменклатураПоставщиков.НайтиПоНаименованию("МТИ");	
			КорневаяПапка = im_Поставщики_МТИ_ПолучитьГруппуКатегориюИнтернетМагазина("МТИ_Api", Справочники.im_ПоставщикиИнтернетМагазина.МТИ, Истина); 
		Иначе
			КорневаяПапка = im_Поставщики_МТИ_ПолучитьГруппуКатегориюИнтернетМагазина(ИдРодитель, Справочники.im_ПоставщикиИнтернетМагазина.МТИ, Истина);	
		КонецЕсли;

		СсылкаНаКатегорию     = im_Поставщики_МТИ_ПолучитьГруппуКатегориюИнтернетМагазина(ИдКатегории, Справочники.im_ПоставщикиИнтернетМагазина.МТИ, Истина);
		
		Если Не ЗначениеЗаполнено(СсылкаНаКатегорию) Тогда
			КатегорияСправочник = Справочники.im_НоменклатураПоставщиков.СоздатьГруппу();
			КатегорияСправочник.ID = ИдКатегории;
			КатегорияСправочник.Наименование = НаименованиеКатегории;
			КатегорияСправочник.Родитель     = КорневаяПапка;
			КатегорияСправочник.Поставщик    = Справочники.im_ПоставщикиИнтернетМагазина.МТИ;
			КатегорияСправочник.Записать();
		Иначе
			КатегорияСправочник					= СсылкаНаКатегорию.ПолучитьОбъект();
			КатегорияСправочник.ID				= ИдКатегории;
			КатегорияСправочник.Наименование	= НаименованиеКатегории;
			КатегорияСправочник.Родитель		= КорневаяПапка;
			КатегорияСправочник.Поставщик		= Справочники.im_ПоставщикиИнтернетМагазина.МТИ;
			КатегорияСправочник.Записать();

		КонецЕсли;

		Если ЗначениеЗаполнено(ИдКатегории) Тогда
			НовСтр 				= ТЗКатегории.Добавить();
			НовСтр.categoryID 	= ИдКатегории;

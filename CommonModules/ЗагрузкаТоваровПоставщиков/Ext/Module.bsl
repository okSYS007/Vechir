Функция im_Поставщики_ERC_СоздатьОбновитьТоварERC(ID, Товар, ТоварССылка, Токен)
	
	Если ЗначениеЗаполнено(ТоварССылка) Тогда 
		ОбНоменклатура = ТоварССылка.ПолучитьОбъект();
	Иначе
		ОбНоменклатура                   = Справочники.im_НоменклатураПоставщиков.СоздатьЭлемент();	
		
		// Картинки
		Картинки = Новый Массив;
		Артикул = Товар.Артикул;
		Страниц = 1;
	    НомерСтраницы = 1;
		
		Если ЗначениеЗаполнено(Токен) Тогда 
		      im_Поставщики_ERC_ПолучитьКартинки(Токен, НомерСтраницы, Страниц, Артикул, Картинки);
		КонецЕсли;
		
		ОбНоменклатура.Изображениия.Очистить();
		Если Картинки.Количество() > 0 Тогда
			Для каждого Картинка из Картинки Цикл 
				ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
				ОбКартинка.URL = Картинка;
			КонецЦикла;

Функция ПолучитьВсеКатегории(Поставщик)
	//
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	im_КатегорииПоставщиковИнтернетМагазина.Родитель
	               |ПОМЕСТИТЬ ПерваяТаблица
	               |ИЗ
	               |	Справочник.im_КатегорииПоставщиковИнтернетМагазина КАК im_КатегорииПоставщиковИнтернетМагазина
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	im_КатегорииПоставщиковИнтернетМагазина.Ссылка КАК Категория,
	               |	im_КатегорииПоставщиковИнтернетМагазина.IDКатегории КАК categoryID
	               |ПОМЕСТИТЬ Таблица2
	               |ИЗ
	               |	Справочник.im_КатегорииПоставщиковИнтернетМагазина КАК im_КатегорииПоставщиковИнтернетМагазина
	               |ГДЕ
	               |	НЕ im_КатегорииПоставщиковИнтернетМагазина.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ПерваяТаблица.Родитель
	               |				ИЗ
	               |					ПерваяТаблица КАК ПерваяТаблица)
	               |	И im_КатегорииПоставщиковИнтернетМагазина.Поставщик = &Поставщик
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Категория КАК Категория,
	               |	im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Категория.IDКатегории КАК categoryID
	               |ИЗ
	               |	Справочник.im_ПоставщикиИнтернетМагазина.КатегорииПоставщиков КАК im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков
	               |ГДЕ
	               |	im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Ссылка.Ссылка = &Поставщик
	               |	И im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Использовать
	               |	И im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Категория В
	               |			(ВЫБРАТЬ
	               |				Таблица2.Категория
	               |			ИЗ
	               |				Таблица2 КАК Таблица2)";
	
	
	//Запрос = новый запрос;

					КонецЦикла;	
				Иначе
					нстр.Картинки.Добавить(Товар.picture);
				КонецЕсли;
			КонецЕсли;
			Если стр.Имя = "wholesalePrice" Тогда
				нстр.ДилерскаяЦена = Товар.wholesalePrice.Последовательность().ПолучитьТекст(0)
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
	Сч = 0;
	ТаблицаЦен = новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.im_НоменклатураПоставщиков"));

Функция im_Поставщики_DCLINK_ПолучитьИдентификаторСесии()
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("Cerebro");
	
	Url    = СтрПодключение.Адрес;
	Логин  = СтрПодключение.Логин;
	Пароль = СтрПодключение.Пароль;
	
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Пароль);
	
	Пароль     = СтрЗаменить(Строка(Хеш.ХешСумма), " ", ""); 
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	стрАунтефикация = Новый Структура; 
	стрАунтефикация.Вставить("login", Логин);
	стрАунтефикация.Вставить("password", Пароль);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();  
	ЗаписатьJSON(ЗаписьJSON, стрАунтефикация);            
	стрJSON = ЗаписьJSON.Закрыть();
	
	ВремКаталог = КаталогВременныхФайлов();
	
	ФайлОтправки = Новый ЗаписьТекста(ВремКаталог + "test.txt", КодировкаТекста.ANSI);
	ФайлОтправки.Записать(стрJSON);
	ФайлОтправки.Закрыть();
	
	//Размер файла
	имяФайлаОтправки = ВремКаталог + "test.txt"; // файл с отсылаемыми для обработки данными
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	HTTPЗапрос = Новый HTTPЗапрос("/auth", Заголовки);
	
	HTTPЗапрос.УстановитьИмяФайлаТела(имяФайлаОтправки);
	
	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(мОтвет);
	
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, "не удалось прочитать JSON");
		ЧтениеJSON.Закрыть();
		Возврат "";
	КонецПопытки;
	ЧтениеJSON.Закрыть();
	
	Если Ответ.КодСостояния = 200 Тогда
		ИдентификаторСессии = СтруктураОтвета.result;
	Иначе
		ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
	КонецЕсли;
	
	Возврат ИдентификаторСессии;
КонецФункции// к ЛИВ

Процедура ЗагрузкаТоваровRenklod(Параметр) Экспорт
		
	Url = "b2b.renklod.com.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки = Новый Соответствие;
	HTTPЗапрос = Новый HTTPЗапрос("/uk/inner/cabinet/download/B9QRYN81XDZGSYCF",Заголовки);
	Ответ 	= Соединение.Получить(HTTPЗапрос);	
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат;
	КонецЕсли; 
	
	//Файл = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Попытка
		Файл = Ответ.ПолучитьТелоКакДвоичныеДанные();
		КаталогДляРаспаковки = КаталогВременныхФайлов();
	    ИмяФайла = "Renklod.zip";
		ПолноеИмяФайла = КаталогДляРаспаковки + ИмяФайла;
		Файл.Записать(ПолноеИмяФайла);
	Исключение
		Возврат;
	КонецПопытки;	
	
	
	ФайлХМЛ = im_Поставщики_Renklod_РаспаковатьZipФайл(ПолноеИмяФайла);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлХМЛ);
	XDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	ТЗКатегории = Новый ТаблицаЗначений;
	ТЗКатегории.Колонки.Добавить("categoryID");
	ТЗКатегории.Колонки.Добавить("parentId");
	ТЗКатегории.Колонки.Добавить("name");

	Для Каждого Категория Из XDTO.shop.categories.category Цикл
		нстр = ТЗКатегории.Добавить();
		Для Каждого стр Из Категория.Свойства() Цикл
		    Если стр.Имя = "id" Тогда
				нстр.categoryID = Категория.id;
			КонецЕсли;
		    Если стр.Имя = "parentId" Тогда
				нстр.parentId = Категория.parentId;
			КонецЕсли;
			нстр.name = Категория.Последовательность().ПолучитьТекст(0);
		КонецЦикла;
	КонецЦикла;	
	
// н Категории
	КатегорииОтборЗагрузка = im_Поставщики_Renklod_ПолучитьКатегориДляТоваровСКодом(Справочники.im_ПоставщикиИнтернетМагазина.Renklod);
// к Категории
	
	Для каждого  Категория Из ТЗКатегории Цикл
		
		ИдКатегории = Категория.categoryID;
		НаименованиеКатегории = Категория.name;

		Если ЗначениеЗаполнено(Категория.parentid) Тогда
			ИдРодитель = Категория.parentid;
		Иначе
			ИдРодитель = "";
		КонецЕсли;
		
// н Категории
		Если КатегорииОтборЗагрузка.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		НайтиКатегорию = КатегорииОтборЗагрузка.Найти(ИдКатегории, "КатегорияIDКатегории");
		Если НайтиКатегорию = Неопределено Тогда
			Продолжить;
		КонецЕсли;
// к Категории
		
		Если Не ЗначениеЗаполнено(ИдРодитель) Тогда
			//КорневаяПапка = Справочники.im_НоменклатураПоставщиков.НайтиПоНаименованию("Renklod");	
			КорневаяПапка = im_Поставщики_Renklod_ПолучитьГруппуКатегориюИнтернетМагазина("Renklod_Api", Справочники.im_ПоставщикиИнтернетМагазина.Renklod, Истина); 
		Иначе
			КорневаяПапка = im_Поставщики_Renklod_ПолучитьГруппуКатегориюИнтернетМагазина(ИдРодитель, Справочники.im_ПоставщикиИнтернетМагазина.Renklod, Истина);	

Функция im_Поставщики_DCLINK_СоздатьОбновитьТовар(ID, Товар, ТоварССылка, Артикул, ИдентификаторСессии,ТаблицаПоставщиков, БезНал)
	
	Если ЗначениеЗаполнено(ТоварССылка) Тогда 
		ОбНоменклатура = ТоварССылка.ПолучитьОбъект();
	Иначе
		ОбНоменклатура                   = Справочники.im_НоменклатураПоставщиков.СоздатьЭлемент();	
	КонецЕсли;
	
	ОбНоменклатура.ID                = ID;
	ОбНоменклатура.Артикул           = Артикул;
	ОбНоменклатура.Наименование      = Товар.name;
	ОбНоменклатура.Категория         = im_Поставщики_DCLINK_ПолучитьКатегориюИнтернетМагазина(Товар.categoryId, Справочники.im_ПоставщикиИнтернетМагазина.DCLINK);
	ОбНоменклатура.Поставщик         = Справочники.im_ПоставщикиИнтернетМагазина.DCLINK;
	//ОбНоменклатура.Бренд           = "";
	ОбНоменклатура.Родитель          = im_Поставщики_DCLINK_ПолучитьГруппуКатегориюИнтернетМагазина(СтрЗаменить(Товар.categoryId,Символы.НПП,""), Справочники.im_ПоставщикиИнтернетМагазина.DCLINK, Истина);
	ОбНоменклатура.Категория         = im_Поставщики_DCLINK_ПолучитьКатегориюИнтернетМагазина(СтрЗаменить(Товар.categoryId,Символы.НПП,""), Справочники.im_ПоставщикиИнтернетМагазина.DCLINK);
	ОбНоменклатура.РРЦ               = Товар.retail_price_uah;
// н ЛИВ
	//Если ОбНоменклатура.РРЦ <> Цел(ОбНоменклатура.РРЦ) Тогда
	//	ОбНоменклатура.РРЦ               = Окр(ОбНоменклатура.РРЦ + 0.5 , 0,0);
	//КонецЕсли;
// к ЛИВ
	ОбНоменклатура.ДилерскаяЦена     = Товар.price_uah;
	ОбНоменклатура.Модель            = Артикул;
	ОбНоменклатура.ДатаОбновления    = ТекущаяДата();
	ОбНоменклатура.Количество        = ?(Товар.available.Количество()>0,100,0);
	
	Если Не БезНал Тогда
		ОбНоменклатура.Количество = 0;
	КонецЕсли;
	
	МассивБрендов = ТаблицаПоставщиков.НайтиСтроки(Новый структура("vendorID", Товар.vendorid));
	
	Если МассивБрендов.Количество() Тогда 
		ОбНоменклатура.Бренд         = МассивБрендов[0].name;
	Иначе
		ОбНоменклатура.Бренд         = "";
	КонецЕсли;
	
	//ОбНоменклатура.Бренд             = ТаблицаПоставщиков.НайтиСтроки(Новый структура("vendorID", Товар.vendorid));
	ОбНоменклатура.Изображениия.Очистить();
	Картинки = ПолучитьКартинкиТовараDCLINK(ID,ИдентификаторСессии);
	
	Для Каждого Строка из Картинки цикл  
		Если Строка.full_image <> "" Тогда  
			СтрокаКартинка = ОбНоменклатура.Изображениия.Добавить();
			СтрокаКартинка.URL = Строка.full_image;
		КонецЕсли;
	КонецЦикла;
	ОбНоменклатура.Записать();
	
	Возврат ОбНоменклатура;
	
КонецФункции


Функция im_Поставщики_DCLINK_GetBnPrices()
	
	Url = "api.dclink.com.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки = Новый Соответствие;
	HTTPЗапрос = Новый HTTPЗапрос("/api/GetBnPrices", Заголовки);
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("Cerebro");
	
	Username  = СтрПодключение.Логин;
	Password = СтрПодключение.Пароль;
	firm = "east";
	
	ТелоЗапросаСтрока = 
	"login=" + Username + 
	"&password=" + Password +
	"&firm=" + firm;
	
	HTTPЗапрос.Заголовки["Content-Type"] = "application/x-www-form-urlencoded";
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаСтрока, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	// Отправляем
	Товары_BnPrice = Новый ТаблицаЗначений;	
	Товары_BnPrice.Колонки.Добавить("Код");
	
	Попытка
		Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("Нет ответа при соединении с DCLink BnPrice", ,,,,);
		Иначе
			Структура  = ПолучитьСтруктуруИзХМЛ(Ответ.ПолучитьТелоКакСтроку());
			
			Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство("Pricelist") И ТипЗнч(Структура.Pricelist) = Тип("Структура") Тогда 
				
				Если Структура.Pricelist.Свойство("Product") И ТипЗнч(Структура.Pricelist.Product) = Тип("Массив") Тогда 
					
					Для Каждого стр Из Структура.Pricelist.Product Цикл	
						
						Если стр.Свойство("ItemCode") И ТипЗнч(стр.ItemCode) = Тип("Структура") И стр.ItemCode.Свойство("___Текст_") Тогда 
							
							КодТовара = стр.ItemCode.___Текст_;
							нстр = Товары_BnPrice.Добавить();
							нстр.Код = КодТовара;
							
						КонецЕсли;	
					КонецЦикла;	
					
				КонецЕсли;	
				
			КонецЕсли; 
		КонецЕсли; 
		
		Товары_BnPrice.Свернуть("Код");

	Исключение
	КонецПопытки;
	

Функция im_Поставщики_Yugcontract_СоздатьОбновитьТоварYugcontract(ID, Товар, ТоварССылка)
	
	Если ЗначениеЗаполнено(ТоварССылка) Тогда 
		ОбНоменклатура = ТоварССылка.ПолучитьОбъект();
	Иначе
		ОбНоменклатура                   = Справочники.im_НоменклатураПоставщиков.СоздатьЭлемент();	
	КонецЕсли;
	
	ОбНоменклатура.ID                = Товар.ID;
	ОбНоменклатура.Артикул           = Товар.Артикул;
	ОбНоменклатура.Наименование      = Товар.Наименование;
	ОбНоменклатура.Категория         = Товар.Категория;
	ОбНоменклатура.Поставщик         = Справочники.im_ПоставщикиИнтернетМагазина.Yugcontract;
	ОбНоменклатура.Бренд             = Товар.Бренд;
	ОбНоменклатура.Родитель          = im_Поставщики_Yugcontract_ПолучитьГруппуКатегориюИнтернетМагазина(Товар.Категория.IDКатегории, Справочники.im_ПоставщикиИнтернетМагазина.Yugcontract, Истина);
	ОбНоменклатура.URL	             = "";
	
	Если ЗначениеЗаполнено(Товар.Картинка) Или Товар.Картинки.Количество() > 0 Тогда
		ОбНоменклатура.Изображениия.Очистить();
		Если ЗначениеЗаполнено(Товар.Картинка) Тогда
			ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
			ОбКартинка.URL = Товар.Картинка;
		КонецЕсли;
		Если Товар.Картинки.Количество() > 0 Тогда
			Для Каждого стр Из Товар.Картинки Цикл 
				ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
				ОбКартинка.URL = стр;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ОбНоменклатура.Количество        = Товар.Количество;
	ОбНоменклатура.ДилерскаяЦена     = Товар.ДилерскаяЦена;
	ОбНоменклатура.РРЦ               = Товар.РРЦ;
// н ЛИВ
	//Если ОбНоменклатура.РРЦ <> Цел(ОбНоменклатура.РРЦ) Тогда
	//	ОбНоменклатура.РРЦ               = Окр(ОбНоменклатура.РРЦ + 0.5 , 0,0);
	//КонецЕсли;
// к ЛИВ
	ОбНоменклатура.Модель            = Товар.Артикул;
	ОбНоменклатура.ДатаОбновления    = ТекущаяДата();
	
	ОбНоменклатура.Записать();
	
	Возврат ОбНоменклатура;
	
КонецФункции


функция im_Поставщики_Deps_ПолучитьКатегории(Токен)
	
	Url = "deps.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json"); 
	Заголовки.Вставить("Authorization","Bearer "+Токен); 
	
	HTTPЗапрос = Новый HTTPЗапрос("/index.php?option=com_jshopping&controller=addon_api&section=category&task=tree", Заголовки);
	
	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтветНомен 	= Ответ.ПолучитьТелоКакСтроку();
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Новый Массив;	
	КонецЕсли; 
	
	ЧтениеJSON = Новый ЧтениеJSON;                    
	ЧтениеJSON.УстановитьСтроку(мОтветНомен);
	РезультатКатегории = Новый ТаблицаЗначений;
	РезультатКатегории.Колонки.Добавить("id");
	РезультатКатегории.Колонки.Добавить("name");
	РезультатКатегории.Колонки.Добавить("parent_id");
	ЗначениеУзла = "";
	Пока ЧтениеJSON.Прочитать() Цикл
		
		ТипЗначения = ЧтениеJSON.ТипТекущегоЗначения;
		
		Если ТипЗначения = ТипЗначенияJSON.НачалоОбъекта Тогда
			
			Если ЗначениеЗаполнено(ЗначениеУзла)  //возвращает не правильный json. тут должен быть массив, а возвращает как новый объект { }
				И ЗначениеУзла <> "available" 
				И ЗначениеУзла <> "result" 
				И ЗначениеУзла <> "stocks_expected" 
				Тогда
			КонецЕсли;
			
		ИначеЕсли ТипЗначения = ТипЗначенияJSON.НачалоМассива Тогда
		ИначеЕсли ТипЗначения = ТипЗначенияJSON.ИмяСвойства
			ИЛИ ТипЗначения = ТипЗначенияJSON.Строка
			ИЛИ ТипЗначения = ТипЗначенияJSON.Число
			ИЛИ ТипЗначения = ТипЗначенияJSON.Булево
			ИЛИ ТипЗначения = ТипЗначенияJSON.Null Тогда
			
			Значение = ЧтениеJSON.ТекущееЗначение;
			
			Если ЗначениеУзла = "id" Тогда
				НовСтр = РезультатКатегории.Добавить();
				НовСтр.id = СтрЗаменить(Строка(Значение), Символы.НПП, "");
			ИначеЕсли ЗначениеУзла = "name" Тогда
				НовСтр.name = Значение;
			ИначеЕсли ЗначениеУзла = "parent_id" Тогда
				НовСтр.parent_id = СтрЗаменить(Строка(Значение), Символы.НПП, "");
			КонецЕсли;
			
			ЗначениеУзла = ЧтениеJSON.ТекущееЗначение;
			
		КонецЕсли;			
		
	КонецЦикла;
	
	ЧтениеJSON.Закрыть();
	
	Возврат  РезультатКатегории;
	
КонецФункции

Функция im_Поставщики_Deps_СоздатьОбновитьТовар(ID, Товар, ТоварССылка, Артикул,Модификация = Неопределено)
	
	Если ЗначениеЗаполнено(ТоварССылка) Тогда 
		ОбНоменклатура = ТоварССылка.ПолучитьОбъект();
	Иначе
		ОбНоменклатура                   = Справочники.im_НоменклатураПоставщиков.СоздатьЭлемент();	
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Модификация) Тогда 
		ОбНоменклатура.ID                = ID;
		ОбНоменклатура.Артикул           = Модификация.Получить("ean");
		ОбНоменклатура.Наименование      = Модификация.Получить("value_name");
		ОбНоменклатура.Категория         = im_Поставщики_Deps_ПолучитьКатегориюИнтернетМагазина(СтрЗаменить(Строка(Товар.Получить("category_id")), Символы.НПП, ""), Справочники.im_ПоставщикиИнтернетМагазина.Deps);
		ОбНоменклатура.Поставщик         = Справочники.im_ПоставщикиИнтернетМагазина.Deps;
		ОбНоменклатура.Бренд             = Товар.Получить("manufacturer").Получить("name");
		ОбНоменклатура.Родитель          = im_Поставщики_Deps_ПолучитьГруппуКатегориюИнтернетМагазина(СтрЗаменить(Строка(Товар.Получить("category_id")), Символы.НПП, ""), Справочники.im_ПоставщикиИнтернетМагазина.Deps, Истина);
		ОбНоменклатура.URL	             = Товар.Получить("manufacturer").Получить("manufacturer_url");       
		ОбНоменклатура.Количество        = ?(Модификация.Получить("custom_status")="В наявності",100,?(Модификация.Получить("custom_status")="Закінчується",50,0));
		ОбНоменклатура.РРЦ               = Модификация.Получить("retail_price");
// н ЛИВ
	//Если ОбНоменклатура.РРЦ <> Цел(ОбНоменклатура.РРЦ) Тогда
	//	ОбНоменклатура.РРЦ               = Окр(ОбНоменклатура.РРЦ + 0.5 , 0,0);
	//КонецЕсли;
// к ЛИВ
		ОбНоменклатура.ДилерскаяЦена     = Модификация.Получить("price");
		//ОбНоменклатура.ПромоЦена         = "";
		ОбНоменклатура.Модель            = Артикул;
		ОбНоменклатура.ДатаОбновления    = ТекущаяДата();
		
		Если Товар.Получить("image")<>"" Тогда 
			ОбНоменклатура.Изображениия.Очистить();
			
			ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
			ОбКартинка.URL = СтрЗаменить(Товар.Получить("image"),"thumb_","full_");
			
		КонецЕсли;
		
	Иначе
		ОбНоменклатура.ID                = ID;
		ОбНоменклатура.Артикул           = Товар.Получить("product_ean");
		ОбНоменклатура.Наименование      = Товар.Получить("name");
		ОбНоменклатура.Категория         = im_Поставщики_Deps_ПолучитьКатегориюИнтернетМагазина(СтрЗаменить(Строка(Товар.Получить("category_id")), Символы.НПП, ""), Справочники.im_ПоставщикиИнтернетМагазина.Deps);
		ОбНоменклатура.Поставщик         = Справочники.im_ПоставщикиИнтернетМагазина.Deps;
		ОбНоменклатура.Бренд             = Товар.Получить("manufacturer").Получить("name");
		ОбНоменклатура.Родитель          = im_Поставщики_Deps_ПолучитьГруппуКатегориюИнтернетМагазина(СтрЗаменить(Строка(Товар.Получить("category_id")), Символы.НПП, ""), Справочники.im_ПоставщикиИнтернетМагазина.Deps, Истина);
		ОбНоменклатура.URL	             = Товар.Получить("manufacturer").Получить("manufacturer_url");       
		ОбНоменклатура.Количество        = ?(Товар.Получить("product_quantity")="В наявності",100,?(Товар.Получить("product_quantity")="Закінчується",50,0));
		ОбНоменклатура.РРЦ               = Товар.Получить("retail_price");
// н ЛИВ
	//Если ОбНоменклатура.РРЦ <> Цел(ОбНоменклатура.РРЦ) Тогда
	//	ОбНоменклатура.РРЦ               = Окр(ОбНоменклатура.РРЦ + 0.5 , 0,0);
	//КонецЕсли;
// к ЛИВ
		ОбНоменклатура.ДилерскаяЦена     = Товар.Получить("product_price");
		//ОбНоменклатура.ПромоЦена         = "";
		ОбНоменклатура.Модель            = Артикул;
		ОбНоменклатура.ДатаОбновления    = ТекущаяДата();
		
		Если Товар.Получить("image")<>"" Тогда 
			ОбНоменклатура.Изображениия.Очистить();
			
			ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
			ОбКартинка.URL = СтрЗаменить(Товар.Получить("image"),"thumb_","full_");
			
		КонецЕсли;
	КонецЕсли;
	ОбНоменклатура.Записать();
	
	Возврат ОбНоменклатура;
	
КонецФункции


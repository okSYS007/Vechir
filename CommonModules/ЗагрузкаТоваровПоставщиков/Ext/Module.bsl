Функция ПолучитьТокен()
	
	Токен = "";
	Период = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеЗагрузкиDeps.Token,
	|	ДанныеЗагрузкиDeps.section,
	|	ДанныеЗагрузкиDeps.task,
	|	ДанныеЗагрузкиDeps.ДатаОтправкиЗапроса КАК Период,
	|	ДанныеЗагрузкиDeps.ТелоЗапроса,
	|	ДанныеЗагрузкиDeps.ТелоОтвета
	|ИЗ
	|	РегистрСведений.ДанныеЗагрузкиDeps КАК ДанныеЗагрузкиDeps
	|ГДЕ
	|	ДанныеЗагрузкиDeps.section = &section
	|	И ДанныеЗагрузкиDeps.task = &task
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("task","open");
	Запрос.УстановитьПараметр("section","connection");
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Токен = ВыборкаДетальныеЗаписи.Token;
		Период = ВыборкаДетальныеЗаписи.Период;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Токен) И ЗначениеЗаполнено(Период) Тогда
		
		Если (ТекущаяДата()-(60*60))< Период Тогда
			
			Возврат Токен;
			
		КонецЕсли;
	КонецЕсли; 
	
	
	Url = "deps.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json"); 
	Заголовки.Вставить("Authorization","Basic YS5rb3JuaXRza2FAdmVjaGlyLnVhOjEyMzQ1Njc4OTA="); 
	
	HTTPЗапрос = Новый HTTPЗапрос("/index.php?option=com_jshopping&controller=addon_api&section=connection&task=open",Заголовки);
	
	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Токен;
	КонецЕсли; 
	
	ЧтениеJSON = Новый ЧтениеJSON;                    
	ЧтениеJSON.УстановитьСтроку(мОтвет);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	
	Токен = Результат.result;
	Если ЗначениеЗаполнено(Токен) И Результат.status = "ok"  Тогда
		
		ЗаписатьДанныеВРегистрСведений(Токен,"connection","open","",мОтвет);	
	КонецЕсли;
	Возврат Токен
	
	
	
	
	
	
	

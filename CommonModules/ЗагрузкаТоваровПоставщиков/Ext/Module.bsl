Функция im_Поставщики_ERC_ПолучитьГруппуКатегориюИнтернетМагазина(IDКатегории, Поставщик, ЭтоГруппа)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	im_НоменклатураПоставщиков.Ссылка
	               |ИЗ
	               |	Справочник.im_НоменклатураПоставщиков КАК im_НоменклатураПоставщиков
	               |ГДЕ
	               |	im_НоменклатураПоставщиков.Поставщик = &Поставщик
	               |	И im_НоменклатураПоставщиков.ID = &IDКатегории
	               |	И im_НоменклатураПоставщиков.ЭтоГруппа = &ЭтоГруппа";
	Запрос.УстановитьПараметр("IDКатегории",IDКатегории);
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	Запрос.УстановитьПараметр("ЭтоГруппа",ЭтоГруппа);
	
	результатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если результатЗапроса.Количество() Тогда 
		Возврат результатЗапроса[0].ссылка; 
	КонецЕсли;
	
	Возврат Справочники.im_КатегорииПоставщиковИнтернетМагазина.ПустаяСсылка();
	

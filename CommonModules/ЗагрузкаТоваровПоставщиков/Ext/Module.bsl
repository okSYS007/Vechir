Функция im_Поставщики_Renklod_СоздатьОбновитьТоварRenklod(ID, Товар, ТоварССылка)
	
	Если ЗначениеЗаполнено(ТоварССылка) Тогда 
		ОбНоменклатура = ТоварССылка.ПолучитьОбъект();
	Иначе
		ОбНоменклатура                   = Справочники.im_НоменклатураПоставщиков.СоздатьЭлемент();	
	КонецЕсли;
	
	ОбНоменклатура.ID                = Товар.ID;
	ОбНоменклатура.Артикул           = Товар.Артикул;
	ОбНоменклатура.Наименование      = Товар.Наименование;
	ОбНоменклатура.Категория         = Товар.Категория;
	ОбНоменклатура.Поставщик         = Справочники.im_ПоставщикиИнтернетМагазина.Renklod;
	ОбНоменклатура.Бренд             = Товар.Бренд;
	ОбНоменклатура.Родитель          = im_Поставщики_Renklod_ПолучитьГруппуКатегориюИнтернетМагазина(Товар.Категория.IDКатегории, Справочники.im_ПоставщикиИнтернетМагазина.Renklod, Истина);
	ОбНоменклатура.URL	             = "";
	
	//Если ЗначениеЗаполнено(Товар.Картинка) Тогда
	//	ОбНоменклатура.Изображениия.Очистить();
	//	ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
	//	ОбКартинка.URL = Товар.Картинка;
	//КонецЕсли;
	
	ОбНоменклатура.Изображениия.Очистить();
	Если Товар.Картинки.Количество() > 0 Тогда
		Для каждого Картинка из Товар.Картинки Цикл 
			ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
			ОбКартинка.URL = Картинка;
		КонецЦикла;
	//Иначе
	//	Если ЗначениеЗаполнено(Товар.Картинка) Тогда
	//		ОбКартинка = ОбНоменклатура.Изображениия.Добавить();
	//		ОбКартинка.URL = Товар.Картинка;
	//	КонецЕсли;		
	КонецЕсли;
	
	ОбНоменклатура.Количество        = Товар.Количество;
	ОбНоменклатура.ДилерскаяЦена     = Товар.ДилерскаяЦена;
	ОбНоменклатура.РРЦ               = Товар.РРЦ;
// н ЛИВ
	//Если ОбНоменклатура.РРЦ <> Цел(ОбНоменклатура.РРЦ) Тогда
	//	ОбНоменклатура.РРЦ               = Окр(ОбНоменклатура.РРЦ + 0.5 , 0,0);
	//КонецЕсли;
// к ЛИВ
	ОбНоменклатура.Модель            = Товар.Модель;
	ОбНоменклатура.ДатаОбновления    = ТекущаяДата();
	
	ОбНоменклатура.Записать();
	
	Возврат ОбНоменклатура;
	
КонецФункции


Функция im_Поставщики_Renklod_РаспаковатьZipФайл(ИмяФайлаДляРаспаковки)
	
	КаталогДляРаспаковки = КаталогВременныхФайлов();
	
	ИмяРаспакованногоФайла = "";
	
	Попытка
		
		//Архиватор = Новый ЧтениеZipФайла(ИмяФайлаДляРаспаковки, ПарольДляРаспаковкиФайлаОбмена);
		Архиватор = Новый ЧтениеZipФайла(ИмяФайлаДляРаспаковки, "");
		
		Если Архиватор.Элементы.Количество() > 0 Тогда
			
			Архиватор.Извлечь(Архиватор.Элементы[0], КаталогДляРаспаковки, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
			ИмяРаспакованногоФайла = im_Поставщики_Renklod_ПолучитьИмяФайлаОбмена(КаталогДляРаспаковки, Архиватор.Элементы[0].Имя);
			
		Иначе
			
			ИмяРаспакованногоФайла = "";	
			
		КонецЕсли;

		Архиватор.Закрыть();
	
	Исключение
		
		Возврат "";
							
	КонецПопытки;
	
	Возврат ИмяРаспакованногоФайла;
		
КонецФункции

Функция im_Поставщики_Renklod_ПолучитьИмяФайлаОбмена(ИмяКаталога, ИмяФайла) 

	Если Не ПустаяСтрока(ИмяФайла) Тогда
		
		Возврат ИмяКаталога + ?(Прав(ИмяКаталога, 1) = "\", "", "\") + ИмяФайла;	
		
	Иначе
		
		Возврат ИмяКаталога;
		
	КонецЕсли;

КонецФункции

Функция im_Поставщики_Renklod_ПолучитьКатегориДляТоваровСКодом(Поставщик)

	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Категории.Категория,
	               |	Категории.Категория.IDКатегории
	               |ИЗ
	               |	Справочник.im_ПоставщикиИнтернетМагазина.КатегорииПоставщиков КАК Категории
	               |ГДЕ
	               |	НЕ Категории.Категория В
	               |				(ВЫБРАТЬ
	               |					im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Категория.Родитель
	               |				ИЗ
	               |					Справочник.im_ПоставщикиИнтернетМагазина.КатегорииПоставщиков КАК im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков
	               |				ГДЕ
	               |					im_ПоставщикиИнтернетМагазинаКатегорииПоставщиков.Ссылка = &Поставщик)
	               |	И Категории.Использовать = ИСТИНА
	               |	И Категории.Категория.Поставщик = &Поставщик
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Категории.Категория";
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 0 Тогда 
		Возврат РезультатЗапроса; 
	КонецЕсли;
	
	Возврат Новый ТаблицаЗначений;

КонецФункции




Процедура ЗагрузкаТоваровERC(Параметр) Экспорт
	Url = "connect.erc.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json"); 
	HTTPЗапрос = Новый HTTPЗапрос("/connectservice/api/SpecPrice/GetCategories",Заголовки);
	ТекстОтправки = "{""Email"":""vs@vechir.ua"", ""Pass"": ""44700"", ""lang"": ""ua-uk""}";
	HTTPЗапрос.УстановитьТелоИзСтроки(ТекстОтправки);
	Ответ 	= Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);;	
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат;
	КонецЕсли; 
	

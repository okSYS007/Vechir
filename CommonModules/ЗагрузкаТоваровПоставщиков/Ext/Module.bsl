Функция ЛевБезопасно(СтрокаЗначение, Длина)
	
	СтрокаЗначение = Строка(СтрокаЗначение);
	
	Если СтрДлина(СтрокаЗначение) <= Длина Тогда
		Возврат СтрокаЗначение;
	КонецЕсли;
	
	Возврат Лев(СтрокаЗначение, Длина);
	
КонецФункции

Функция ПолучитьСвойствоJSON(JSON, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	
	Если JSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗначениеСвойства = ЗначениеПоУмолчанию;
	
	Если ТипЗнч(JSON) = Тип("Структура") Тогда
		
		Если JSON.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
			Возврат ЗначениеСвойства;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(JSON) = Тип("Соответствие") Тогда
		
		Если JSON.Получить(ИмяСвойства) <> Неопределено Тогда
			Возврат JSON.Получить(ИмяСвойства);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция КодироватьURL(Строка)

	//Результат = "";

	//Для каждого Символ Из Строка Цикл
	//    Если Символ = " " Тогда
	//        Результат = Результат + "%20";
	//    ИначеЕсли Символ = "+" Тогда
	//        Результат = Результат + "%2B";
	//    Иначе
	//        Результат = Результат + Символ;
	//    КонецЕсли;
	//КонецЦикла;

	//Возврат Результат;
    Если Строка = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Результат = "";

    Для Индекс = 1 По СтрДлина(Строка) Цикл
        
        Символ = Сред(Строка, Индекс, 1);
        
        Если Символ = " " Тогда
            Результат = Результат + "%20";
        ИначеЕсли Символ = "+" Тогда
            Результат = Результат + "%2B";
        Иначе
            Результат = Результат + Символ;
        КонецЕсли;

    КонецЦикла;

    Возврат Результат;
	
КонецФункции


Функция im_Поставщики_МТИ_ПолучитьЦеныИОстатки()
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	СтрокаДата = Строка(текущаядата());
	СтрокаДляОбработки = СтрокаДата + "PRICE502679F5A8B4EE-37E0-41FC-A139-0BF1AC7EE185";
	//Хеширование.Добавить("14.02.2025 11:36:45PRICE502679F5A8B4EE-37E0-41FC-A139-0BF1AC7EE185");
	Хеширование.Добавить(СтрокаДляОбработки);
	Хеш = Хеширование.ХешСумма;
	Хеш64 = Base64Строка(Хеш);	
	Url = "api.mti.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-type", "application/xml"); 
	HTTPЗапрос = Новый HTTPЗапрос("",Заголовки);
	ТекстОтправки = "<?xml version=""1.0"" encoding=""UTF-8""?><request><type>PRICE</type><time>"+СтрокаДата+"</time><company>502679</company><signature>"+Хеш64+"</signature><params><store_id>W600</store_id></params> </request>";
	HTTPЗапрос.УстановитьТелоИзСтроки(ТекстОтправки);
	Ответ 	= Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
	СтрокаТекст = Ответ.ПолучитьТелоКакСтроку();
	Структура = ПолучитьСтруктуруИзХМЛ(СтрокаТекст);	
	//Структура1 = Ответ.ПолучитьТелоКакСтроку();	
	ТЗТоварыЦены = Новый ТаблицаЗначений;
	ТЗТоварыЦены.Колонки.Добавить("idsupplier");
	ТЗТоварыЦены.Колонки.Добавить("Наименование");
	ТЗТоварыЦены.Колонки.Добавить("ДилерскаяЦена");
	ТЗТоварыЦены.Колонки.Добавить("Количество");
	ТЗТоварыЦены.Колонки.Добавить("РРЦ");
	ТЗТоварыЦены.Колонки.Добавить("ПромоЦена");
	ТЗТоварыЦены.Колонки.Добавить("АкционнаяЦена");
	ТЗТоварыЦены.Колонки.Добавить("Штрихкод");
		
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство("response") И Структура.response.Свойство("result") И Структура.response.result.Свойство("productgroup") И ТипЗнч(Структура.response.result.productgroup) = Тип("Массив") Тогда 
		Для Каждого стрСтруктуры Из Структура.response.result.productgroup Цикл
			Если стрСтруктуры.Свойство("products") И стрСтруктуры.products.Свойство("product") И ТипЗнч(стрСтруктуры.products.product) = Тип("Массив") Тогда
				Для Каждого стр Из стрСтруктуры.products.product Цикл
					Id = "";
					Если стр.Свойство("idsupplier") Тогда
						Если стр.idsupplier.Свойство("___Текст_") Тогда 
							Id = стр.idsupplier.___Текст_;
						КонецЕсли;
					КонецЕсли;
					Если Id = "" Тогда
						Продолжить;
					КонецЕсли;	
					нстр = ТЗТоварыЦены.Добавить();
					нстр.idsupplier = Id;
					нстр.Количество = 0;
					Если стр.Свойство("rrp") Тогда
						Если стр.rrp.Свойство("___Текст_") Тогда 
							нстр.РРЦ = стр.rrp.___Текст_;
						КонецЕсли;
					КонецЕсли;
					Если стр.Свойство("price_uah_fdp") Тогда
						Если стр.price_uah_fdp.Свойство("___Текст_") Тогда 
							нстр.ДилерскаяЦена = стр.price_uah_fdp.___Текст_;
						КонецЕсли;
					КонецЕсли;
					//Если стр.Свойство("barcode") Тогда
					//	Если стр.barcode.Свойство("___Текст_") Тогда 
					//		нстр.Штрихкод = стр.barcode.___Текст_;
					//	КонецЕсли;
					//КонецЕсли;
					Если стр.Свойство("prodname") Тогда
						Если стр.prodname.Свойство("___Текст_") Тогда 
							нстр.Наименование = стр.prodname.___Текст_;
						КонецЕсли;
					КонецЕсли;
					Если стр.Свойство("store") Тогда
						Если стр.store.Свойство("___Текст_") Тогда 
							Если стр.store.___Текст_ = "50 і більше" Тогда
								нстр.Количество = 50;
							ИначеЕсли стр.store.___Текст_ = "50 и более" Тогда
								нстр.Количество = 50;
							ИначеЕсли стр.store.___Текст_ = "10 і більше" Тогда
								нстр.Количество = 10;
							ИначеЕсли стр.store.___Текст_ = "10 и более" Тогда
								нстр.Количество = 10;
							ИначеЕсли стр.store.___Текст_ = "0" 
								ИЛИ стр.store.___Текст_ = "1" 
								ИЛИ стр.store.___Текст_ = "2" 
								ИЛИ стр.store.___Текст_ = "3" 
								ИЛИ стр.store.___Текст_ = "4" 
								ИЛИ стр.store.___Текст_ = "5" 
								ИЛИ стр.store.___Текст_ = "6" 
								ИЛИ стр.store.___Текст_ = "7" 
								ИЛИ стр.store.___Текст_ = "8" 
								ИЛИ стр.store.___Текст_ = "9" Тогда
								нстр.Количество = Число(стр.store.___Текст_);
							ИначеЕсли стр.store.___Текст_ = "-" Тогда
								нстр.Количество = 0;
							ИначеЕсли стр.store.___Текст_ = "" Тогда
								нстр.Количество = 0;
							Иначе
								нстр.Количество = 0;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					// price_uah
					// rrp
					// rrp_control
					// price_usd
					// price_uah_fdp
					// price_uah_order
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Возврат ТЗТоварыЦены;
		
КонецФункции

Функция im_Поставщики_МТИ_ПолучитьКатегориюИнтернетМагазина(IDКатегории, Поставщик)
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	im_КатегорииПоставщиковИнтернетМагазина.Ссылка
	|ИЗ
	|	Справочник.im_КатегорииПоставщиковИнтернетМагазина КАК im_КатегорииПоставщиковИнтернетМагазина
	|ГДЕ
	|	im_КатегорииПоставщиковИнтернетМагазина.Поставщик = &Поставщик
	|	И im_КатегорииПоставщиковИнтернетМагазина.IDКатегории = &IDКатегории";
	Запрос.УстановитьПараметр("IDКатегории",IDКатегории);
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	
	результатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если результатЗапроса.Количество() Тогда 
		Возврат результатЗапроса[0].ссылка; 
	КонецЕсли;
	
	Возврат Справочники.im_КатегорииПоставщиковИнтернетМагазина.ПустаяСсылка();
	
КонецФункции


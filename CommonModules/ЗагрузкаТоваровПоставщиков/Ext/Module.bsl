Процедура ЗагрузитьЦеныDeps() Экспорт
	Токен = ПолучитьТокен();
	
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		
		///////////////////Получим группі номенклатурі
		
		//ЗагрузитьКатегории(Токен);
		Возврат;
		
		
	КонецЕсли;
	
	ТаблицаЦенОстатков = Новый ТаблицаЗначений;
	ТаблицаЦенОстатков.Колонки.Добавить("Номенклатура");
	ТаблицаЦенОстатков.Колонки.Добавить("Количество");
	ТаблицаЦенОстатков.Колонки.Добавить("Цена");
	ТаблицаЦенОстатков.Колонки.Добавить("ЦенаДилер");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	Номенклатура.DepsId
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И НЕ Номенклатура.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("Ссылка",Справочники.Номенклатура.НайтиПоНаименованию("Deps"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ИдНоменклатуры = ВыборкаДетальныеЗаписи.DepsId;
		Url = "deps.ua";	
		Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type","application/json"); 
		Заголовки.Вставить("Authorization","Bearer "+Токен); 
		
		HTTPЗапрос = Новый HTTPЗапрос("/index.php?option=com_jshopping&controller=addon_api&section=product&task=item&args[id]="+СтрЗаменить(Строка(ИдНоменклатуры),символы.НПП,""),Заголовки);
		
		Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат;
		КонецЕсли; 
		
		ЧтениеJSON = Новый ЧтениеJSON;                    
		ЧтениеJSON.УстановитьСтроку(мОтвет);
		Результат = ПрочитатьJSON(ЧтениеJSON,Истина);
		
		
		Если  Результат.Получить("status") = "ok"   Тогда
			//ЗаписатьДанныеВРегистрСведений(Токен,"product","item","",мОтвет);	
		КонецЕсли; 
		ИнфоНомен = Результат.Получить("result");
		
		СтруктураНоменклатуры = ИнфоНомен.Получить("product");
		
		Остаток = СтруктураНоменклатуры.Получить("product_quantity");
		Если Остаток =Неопределено Тогда
			Остаток =0;
		КонецЕсли;
		Цена    = СтруктураНоменклатуры.Получить("retail_price");
		ЦенаДилер = СтруктураНоменклатуры.Получить("product_price");
		НоваяСтрока = ТаблицаЦенОстатков.Добавить();
		НоваяСтрока.Номенклатура = ВыборкаДетальныеЗаписи.Ссылка;
		НоваяСтрока.Цена = Число(Цена);
		НоваяСтрока.Количество = Число(Остаток);
		НоваяСтрока.ЦенаДилер = Число(ЦенаДилер);
		
	КонецЦикла;
	
	ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("РРЦ", Истина);
	Если Не ЗначениеЗаполнено(ТипЦены) Тогда
		Возврат;
	КонецЕсли;
	ЦеныНоменклатуры = Новый Массив;
	ЦеныНоменклатуры.Добавить(ТипЦены);
	ИндексСтрокиТаблицыЦен = 0;
	

Функция  ПолучитьКартинкиТовараDCLINK(IDТовара,IDСессии)
	
	Url = "cerebro.dclink.ua";	
	Соединение = Новый HTTPСоединение(Url,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	
	ВремКаталог = КаталогВременныхФайлов();
	имяФайлаОтправки = ВремКаталог + "test.txt";
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	HTTPЗапрос = Новый HTTPЗапрос("/product_pictures/"+IDТовара+"/"+ IDСессии, Заголовки);
	
	HTTPЗапрос.УстановитьИмяФайлаТела(имяФайлаОтправки);
	
	Ответ 	= Соединение.Получить(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(мОтвет);
	im_Поставщики_DCLINK_Таймаут();
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Сообщить("Ошибка");
	КонецПопытки;
	ЧтениеJSON.Закрыть();
	
	Попытка
		МассивКартинок = СтруктураОтвета.result;
		Возврат СтруктураОтвета.result;
		
	Исключение
		Возврат новый Массив;
	КонецПопытки;
	
	
	
КонецФункции

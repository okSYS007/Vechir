// Функция ВидОбъектаПоСсылке возвращает имя вида объектов метаданных
// по ссылке на объект.
//
// Не обрабатываются точки маршрутов бизнес-процессов.
//
// Параметры:
//  Ссылка       - ссылка на объект, - элемент справочника, документ, ...
//
// Возвращаемое значение:
//  Строка       - имя вида объектов метаданных, например, "Справочник", "Документ" ...
// 
Функция ВидОбъектаПоСсылке(Ссылка) Экспорт
	
	Возврат ВидОбъектаПоТипу(ТипЗнч(Ссылка));
	
КонецФункции 

// Функция возвращает имя вида объектов метаданных по типу объекта.
//
// Не обрабатываются точки маршрутов бизнес-процессов.
//
// Параметры:
//  Тип       - Тип прикладного объекта, определенный в конфигурации
//
// Возвращаемое значение:
//  Строка       - имя вида объектов метаданных, например, "Справочник", "Документ" ...
// 
Функция ВидОбъектаПоТипу(Тип) Экспорт
	Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "Справочник";
	
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "Документ";
	
	ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "БизнесПроцесс";
	
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "ПланВидовХарактеристик";
	
	ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "ПланСчетов";
	
	ИначеЕсли ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "ПланВидовРасчета";
	
	ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "Задача";
	
	ИначеЕсли ПланыОбмена.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "ПланОбмена";
	
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "Перечисление";
	
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

Функция МенеджерОбъектаПоСсылке(Ссылка) Экспорт
	Тип = ТипЗнч(Ссылка);
	Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат Справочники[Ссылка.Метаданные().Имя];
		
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат Документы[Ссылка.Метаданные().Имя];
	
	ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат БизнесПроцессы[Ссылка.Метаданные().Имя];
	
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат ПланыВидовХарактеристик[Ссылка.Метаданные().Имя];
	
	ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат ПланыСчетов[Ссылка.Метаданные().Имя];
	
	ИначеЕсли ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат ПланыВидовРасчета[Ссылка.Метаданные().Имя];
	
	ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат Задачи[Ссылка.Метаданные().Имя];
	
	ИначеЕсли ПланыОбмена.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат ПланыОбмена[Ссылка.Метаданные().Имя];
	
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат Перечисления[Ссылка.Метаданные().Имя];
	
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 


Функция ПолучитьОбъектПоНаименованиюИГУИД(Наименование,НаименованиеПолное,Стр) Экспорт 
	Если СокрЛП(Наименование) = "Справочник" тогда
		Возврат Справочники[СокрЛП(НаименованиеПолное)].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр)));
	ИначеЕсли СокрЛП(Наименование) = "Документ" тогда
		Возврат Документы[СокрЛП(НаименованиеПолное)].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр)));
	ИначеЕсли СокрЛП(Наименование) = "Задача" тогда
		Возврат Задачи[СокрЛП(НаименованиеПолное)].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр)));
	ИначеЕсли СокрЛП(Наименование) = "БизнесПроцесс" тогда
		Возврат БизнесПроцессы[СокрЛП(НаименованиеПолное)].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр)));
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции	

Функция ПолучитьДатуОбъектаПоНаименованиюИГУИД(Наименование,НаименованиеПолное,Стр) Экспорт 
	Если СокрЛП(Наименование) = "Справочник" тогда
		Возврат Неопределено;
	ИначеЕсли СокрЛП(Наименование) = "Документ" тогда
		Возврат Документы[СокрЛП(НаименованиеПолное)].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр))).Дата;
	ИначеЕсли СокрЛП(Наименование) = "Задача" тогда
		Возврат Задачи[СокрЛП(НаименованиеПолное)].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр))).Дата;
	ИначеЕсли СокрЛП(Наименование) = "БизнесПроцесс" тогда
		Возврат БизнесПроцессы[СокрЛП(НаименованиеПолное)].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр))).Дата;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции	

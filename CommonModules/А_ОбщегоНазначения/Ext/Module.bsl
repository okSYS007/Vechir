	Для каждого Субконто Из ПроводкаИсходная.СчетКт.ВидыСубконто  Цикл
		
		ОбщегоНазначения.УстановитьСубконтоПоВидуСубконто(ПроводкаНовая.СчетКт,
	   					  ПроводкаНовая.СубконтоКт,
						  Субконто.ВидСубконто, 
						  ПроводкаИсходная.СубконтоКт[Субконто.ВидСубконто]);
		
	
	КонецЦикла;
	
КонецПроцедуры

// А_Заверуха 14/07/16 **** It4b 2016***** 
Процедура  КорректировкаСумм(ТабДвижений, Знач Дата, лСсылкаНаРегистратор) Экспорт 
	
	// А_Карпчук ( 24.09.2018
	// добавлен параметр лСсылкаНаРегистратор
	// А_Карпчук )
	
	ТабХозрасчетный = ТабДвижений.Скопировать();
	
	
	ТабХозрасчетный.Свернуть("СчетКТ, СубконтоКт1, СубконтоКт2, СубконтоКт3", "Сумма");
	ТабХозрасчетный.Колонки.Добавить("Разница");
	
	МассивНоменклатуры = Новый Массив;
	МассивСкладов = Новый Массив;
	МассивПартий = Новый Массив;
	
	Для каждого СтрокаДвиж из ТабДвижений Цикл 
		Если СтрокаДвиж.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2812") 
			ИЛИ СтрокаДвиж.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2813") 
			ИЛИ СтрокаДвиж.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2814") 
			ИЛИ СтрокаДвиж.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2815") Тогда 
			
			Если СтрокаДвиж.ВидСубконтоКт1 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура Тогда 
				МассивНоменклатуры.Добавить(СтрокаДвиж.СубконтоКт1);
			ИначеЕсли СтрокаДвиж.ВидСубконтоКт2 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура Тогда 
				МассивНоменклатуры.Добавить(СтрокаДвиж.СубконтоКт2);
			ИначеЕсли СтрокаДвиж.ВидСубконтоКт3 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура Тогда 
				МассивНоменклатуры.Добавить(СтрокаДвиж.СубконтоКт3);
			КонецЕсли;	
			
			Если СтрокаДвиж.ВидСубконтоКт1 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии Тогда 
				МассивПартий.Добавить(СтрокаДвиж.СубконтоКт1);
			ИначеЕсли СтрокаДвиж.ВидСубконтоКт2 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии Тогда 
				МассивПартий.Добавить(СтрокаДвиж.СубконтоКт2);
			ИначеЕсли СтрокаДвиж.ВидСубконтоКт3 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии Тогда 
				МассивПартий.Добавить(СтрокаДвиж.СубконтоКт3);
			КонецЕсли;	
			
			Если СтрокаДвиж.ВидСубконтоКт1 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады Тогда 
				МассивСкладов.Добавить(СтрокаДвиж.СубконтоКт1);
			ИначеЕсли СтрокаДвиж.ВидСубконтоКт2 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады Тогда 
				МассивСкладов.Добавить(СтрокаДвиж.СубконтоКт2);
			ИначеЕсли СтрокаДвиж.ВидСубконтоКт3 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады Тогда 
				МассивСкладов.Добавить(СтрокаДвиж.СубконтоКт3);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	// А_Карпчук ( 24.09.2018 - если есть несколько реализаций по одной партии в одну секунду, то к дате добавим еще одну секунду
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ Разрешенные
	|	ХозрасчетныйОстатки.Регистратор,
	|	ХозрасчетныйОстатки.Регистратор.Дата
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&Дата,
	|			&Дата,
	|			Регистратор,
	|			Счет В (&МассивСчетов),
	|			&МассивСубконто,
	|			Субконто1 В (&Субконто1)
	|				И Субконто2 В (&Субконто2)
	|				И Субконто3 В (&Субконто3),
	|			,
	|			) КАК ХозрасчетныйОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОстатки.Регистратор,
	|	ХозрасчетныйОстатки.Регистратор.Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Ссылка,
	|	&Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Регистратор,
	|	ВТ_Документы.РегистраторДата
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Документы.Регистратор,
	|	ВТ_Документы.РегистраторДата";
	
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2812"));
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2813"));
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2814"));
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2815"));
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады);
	Запрос.УстановитьПараметр("МассивСубконто",МассивСубконто);
	
	Запрос.УстановитьПараметр("Субконто1", МассивНоменклатуры);
	Запрос.УстановитьПараметр("Субконто2", МассивПартий);
	Запрос.УстановитьПараметр("Субконто3", МассивСкладов);
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ссылка", лСсылкаНаРегистратор);
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Ном = 1; КоличествоВсегоДокументов = ВыборкаДетальныеЗаписи.Количество();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Ном = КоличествоВсегоДокументов Тогда 
			Если ВыборкаДетальныеЗаписи.Регистратор = лСсылкаНаРегистратор Тогда
				Дата = Дата + 1;
				Прервать;
			КонецЕсли;
		Иначе
			Если ВыборкаДетальныеЗаписи.Регистратор = лСсылкаНаРегистратор Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Ном = Ном + 1;
	КонецЦикла;
	// А_Карпчук )
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет КАК Счет,
	|	СУММА(ХозрасчетныйОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	ХозрасчетныйОстатки.Субконто1,
	|	ХозрасчетныйОстатки.Субконто2,
	|	ХозрасчетныйОстатки.Субконто3
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Дата,
	|			Счет В (&МассивСчетов),
	|			&МассивСубконто,
	|			Субконто1 В (&Субконто1)
	|				И Субконто2 В (&Субконто2)
	|				И Субконто3 В (&Субконто3)) КАК ХозрасчетныйОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОстатки.Счет,
	|	ХозрасчетныйОстатки.Субконто1,
	|	ХозрасчетныйОстатки.Субконто2,
	|	ХозрасчетныйОстатки.Субконто3";
	
	Запрос.УстановитьПараметр("МассивСубконто",МассивСубконто);
	
	Запрос.УстановитьПараметр("Субконто1", МассивНоменклатуры);
	Запрос.УстановитьПараметр("Субконто2", МассивПартий);
	Запрос.УстановитьПараметр("Субконто3", МассивСкладов);
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Массив =  ТабХозрасчетный.НайтиСтроки(Новый Структура("СчетКТ, СубконтоКт1, СубконтоКт2, СубконтоКт3",
		ВыборкаДетальныеЗаписи.Счет, ВыборкаДетальныеЗаписи.Субконто2, ВыборкаДетальныеЗаписи.Субконто1,ВыборкаДетальныеЗаписи.Субконто3));
		Если Не Массив.Количество() = 0 Тогда 
			Для Каждого Строка Из Массив Цикл 
				Разница = Строка.Сумма - ВыборкаДетальныеЗаписи.СуммаОстаток;
				РазницаПроверка = ?(Разница>0,Разница,-Разница);
				
				Если РазницаПроверка <= 0.1 И Не Разница = 0 Тогда 
					Строка.Разница = Разница;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаХоз из ТабХозрасчетный Цикл 
		Если Не СтрокаХоз.Разница = 0 И Не СтрокаХоз.Разница = Неопределено Тогда 
			Массив = ТабДвижений.НайтиСтроки(Новый Структура("СчетКТ, СубконтоКт1, СубконтоКт2, СубконтоКт3",
			СтрокаХоз.СчетКТ, СтрокаХоз.СубконтоКТ1, СтрокаХоз.СубконтоКТ2,СтрокаХоз.СубконтоКТ3));
			
			Если Не Массив.Количество() = 0 Тогда 
				Массив[0].Сумма = Массив[0].Сумма - СтрокаХоз.Разница;													 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
		

КонецПроцедуры

// Процедура выполняет заполнение табличной части по перемещению товаров.
// Заполним табличные части по документу основанию (Перемещению товаров);
//
// Параметры:
//  ПоступлениеДопРасходов - документ Поступление доп. расходов
//  Перемещение - ссылка на документ основание (Перемещение товаров).
//  ТабЧастьТовары - табличная часть документа Поступления доп. расходов
//  ИзПроведения - заполнение может происходить с внешней обработки заполнения ТЧ или с обработки проведения
//
Процедура ЗаполнитьПоступлениеДопРасходовПоПеремещению(ПоступлениеДопРасходов = Неопределено, Перемещение, ТабЧастьТовары, ИзПроведения = Ложь) Экспорт // +++ А_ИТ4Б Ересько 2016-08-08 {} 
	
	Если ИзПроведения И (Не ЗначениеЗаполнено(Перемещение)
		Или ТипЗнч(Перемещение) <> Тип("ДокументСсылка.ПеремещениеТоваров")
		Или ТабЧастьТовары.Количество() = 0) Тогда 
		
		Возврат
		
	КонецЕсли;
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Перемещение", Перемещение);
	Запрос.УстановитьПараметр("СчетТоваров", ПланыСчетов.Хозрасчетный.НайтиПоКоду("2811"));

	Запрос.Текст ="ВЫБРАТЬ
	              |	ХозрасчетныйДвиженияССубконто.СубконтоДт1 КАК Номенклатура,
	              |	ХозрасчетныйДвиженияССубконто.СубконтоДт2 КАК ПТУ,
	              |	ХозрасчетныйДвиженияССубконто.Сумма,
	              |	ХозрасчетныйДвиженияССубконто.КоличествоДт КАК Количество,
	              |	ХозрасчетныйДвиженияССубконто.СубконтоДт1.ЕдиницаХраненияОстатков КАК ЕдиницаИзмерения,
	              |	ХозрасчетныйДвиженияССубконто.СчетДт КАК СчетУчетаБУ,
	              |	ХозрасчетныйДвиженияССубконто.НалоговоеНазначениеДт КАК НалоговоеНазначение
	              |ИЗ
	              |	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(
	              |			,
	              |			,
	              |			СчетДт = &СчетТоваров
	              |				И СчетКт = &СчетТоваров,
	              |			,
	              |			) КАК ХозрасчетныйДвиженияССубконто
	              |ГДЕ
	              |	ХозрасчетныйДвиженияССубконто.Регистратор = &Перемещение";

	РезультатЗапроса = Запрос.Выполнить();

	ТаблицаРезультатЗапроса = РезультатЗапроса.Выгрузить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если ИзПроведения Тогда
			
		ПоступлениеДопРасходов.А_Тариф = ?(ТабЧастьТовары[0].А_Тариф = 0, ПоступлениеДопРасходов.А_Тариф, ТабЧастьТовары[0].А_Тариф);
		СуммаДопРасходов = ТабЧастьТовары.Итог("Сумма");
		ВсегоКоличество =  ТаблицаРезультатЗапроса.Итог("Количество");
		ТабЧастьТовары.Очистить();			
		
	КонецЕсли;

	Пока Выборка.Следующий() Цикл
		
		СтрокаТабличнойЧасти = ТабЧастьТовары.Добавить();
			
		СтрокаТабличнойЧасти.Номенклатура               = Выборка.Номенклатура;
		СтрокаТабличнойЧасти.Количество                 = Выборка.Количество;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения           = Выборка.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.Коэффициент                = СтрокаТабличнойЧасти.ЕдиницаИзмерения.Коэффициент;
		СтрокаТабличнойЧасти.ДокументПартии             = Выборка.ПТУ;	    
		СтрокаТабличнойЧасти.СуммаТовара 				= Выборка.Сумма;
		СтрокаТабличнойЧасти.СчетУчетаБУ  				= Выборка.СчетУчетаБУ;
		СтрокаТабличнойЧасти.НалоговоеНазначение 		= Выборка.НалоговоеНазначение;
		СтрокаТабличнойЧасти.А_Склад 					= Перемещение.СкладПолучатель;

		Если ИзПроведения Тогда
		
			Если ПоступлениеДопРасходов.А_Тариф = 0 Тогда 
					
				СтрокаТабличнойЧасти.Сумма 		= СтрокаТабличнойЧасти.Количество / ВсегоКоличество * СуммаДопРасходов;
				СтрокаТабличнойЧасти.СуммаНДС   = СтрокаТабличнойЧасти.Сумма / 6;	
					
			Иначе 
				
				СтрокаТабличнойЧасти.Сумма 		= СтрокаТабличнойЧасти.Количество * ПоступлениеДопРасходов.А_Тариф;
				СтрокаТабличнойЧасти.СуммаНДС   = СтрокаТабличнойЧасти.Сумма / 6;
				
			КонецЕсли;
			
		КонецЕсли;
										   
	КонецЦикла;
	
КонецПроцедуры
 


// А_Заверуха 23/08/16 **** It4b 2016***** 
Процедура А_ЗаблокироватьДокументы(Период) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеДокуметов_БУ_УУ.ДокументБУ,
		|	А_СоответствиеДокуметов_БУ_УУ.ДокументУУ
		|ИЗ
		|	РегистрСведений.А_СоответствиеДокуметов_БУ_УУ КАК А_СоответствиеДокуметов_БУ_УУ
		|ГДЕ
		|	А_СоответствиеДокуметов_БУ_УУ.ДокументУУ.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|	И А_СоответствиеДокуметов_БУ_УУ.Заблокирован = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Период));
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Период));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.А_СоответствиеДокуметов_БУ_УУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументБУ.Установить(ВыборкаДетальныеЗаписи.ДокументБУ);
		НаборЗаписей.Отбор.ДокументУУ.Установить(ВыборкаДетальныеЗаписи.ДокументУУ);
		НаборЗаписей.Прочитать();
		
		Для Каждого Строка Из НаборЗаписей Цикл
			Строка.Заблокирован = Истина;
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЦикла;
	
	
	
КонецПроцедуры


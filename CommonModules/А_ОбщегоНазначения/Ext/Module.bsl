Процедура ПерезаполнитьСчетаУчетаНДСПоРегиструУчета(МетаданныеДокумента, ДокументОбъектУУ) Экспорт 
	
	Если МетаданныеДокумента.Имя = "Приложение2КНалоговойНакладной"
		//Или МетаданныеДокумента.Имя = "ПоступлениеТоваровУслуг"
		Или МетаданныеДокумента.Имя = "НалоговаяНакладная"
		// А_Заверуха 29/07/16 **** It4b 2016***** 
		//Или МетаданныеДокумента.Имя = "РеализацияТоваровУслуг" 
		// А_Заверуха
		Тогда 
		
		Если МетаданныеДокумента.Имя = "Приложение2КНалоговойНакладной" Тогда 
			ИмяСчета = "СчетУчетаНДСПриобретенийПодтвержденный"
		ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеТоваровУслуг" Тогда 
			ИмяСчета =  "СчетУчетаНДСПриобретений"
		ИначеЕсли МетаданныеДокумента.Имя = "НалоговаяНакладная" Тогда 
			ИмяСчета = "СчетУчетаНДСПриобретенийПодтвержденный"
		ИначеЕсли МетаданныеДокумента.Имя = "РеализацияТоваровУслуг" Тогда
			ИмяСчета = "СчетУчетаНДСПродаж"
		КонецЕсли;
		
		Для Каждого СтрокаТоваров Из ДокументОбъектУУ.Товары Цикл
			//А_ОбщегоНазначения.ЗаполнитьСчетУчетаНДСВТабЧасте(СтрокаТоваров, ДокументОбъектУУ.Организация, ДокументОбъектУУ.Контрагент, ДокументОбъектУУ.ДоговорКонтрагента, ИмяСчета);
		КонецЦикла;
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеДопРасходов" Тогда
		
		СчетаУчета = УправлениеВзаиморасчетами.ПолучитьСчетаРасчетовСКонтрагентом(ДокументОбъектУУ.Организация, ДокументОбъектУУ.Контрагент, ДокументОбъектУУ.ДоговорКонтрагента);
		// А_Заверуха 29/07/16 **** It4b 2016***** 
		//ДокументОбъектУУ.СчетУчетаНДС 				= СчетаУчета.СчетУчетаНДСПриобретений;
		//ДокументОбъектУУ.СчетУчетаНДСПодтвержденный  = СчетаУчета.СчетУчетаНДСПриобретенийПодтвержденный;
		
		Если ДокументОбъектУУ.СчетУчетаНДС = ПланыСчетов.Хозрасчетный.ПустаяСсылка() Тогда 
			ДокументОбъектУУ.СчетУчетаНДС 				= СчетаУчета.СчетУчетаНДСПриобретений;

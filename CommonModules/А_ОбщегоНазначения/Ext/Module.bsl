// Функция добавляет колонку в табличное поле.
//
// Параметры
//  КолонкиТабличногоПоля - Коллекция колонок табличного поля - Коллекция колонок, в которую добавляем колонку.
//
//  ИндексКолонки - Число - Индекс добавляемой колонки, если не задан тогда колонка добавляется в конец табличного поля.
//
//  ЭлементУправления - Тип - Тип элемента управления.
//
//  СтруктураПараметровКолонки - Структура - Структура с параметрами колонки. Ключи структуры должны совпадать с названиями параметров.
//
//  СтруктураПараметровЭлементаУпраления - Структура - Структура с параметрами элемента упраления колонки. Ключи структуры должны совпадать с названиями параметров.
//
//  СтруктураДействийЭлементаУпраления - Структура - Структура с действиями элемента управления колонки. Ключи структуры должны совпадать с названиями действий, значения должны иметь тип Действия.
//
// Возвращаемое значение:
//   Колонка табличного поля - Добавленная колонка.
//
Функция ДобавитьКолонкуВТабличноеПоле(КолонкиТабличногоПоля, ИндексКолонки = Неопределено, ЭлементУправления = Неопределено, СтруктураПараметровКолонки = Неопределено, СтруктураПараметровЭлементаУпраления = Неопределено, СтруктураДействийЭлементаУпраления = Неопределено) Экспорт 	
	Если ИндексКолонки <> Неопределено Тогда
		
		Колонка = КолонкиТабличногоПоля.Вставить(ИндексКолонки);
		
	Иначе
		
		Колонка = КолонкиТабличногоПоля.Добавить();
		
	КонецЕсли;	
	
	Если ЭлементУправления <> Неопределено Тогда
		
		Колонка.УстановитьЭлементУправления(ЭлементУправления);
		
	КонецЕсли;	
	
	Если СтруктураПараметровКолонки <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(Колонка, СтруктураПараметровКолонки);
		
	КонецЕсли;	
	
	Если СтруктураПараметровЭлементаУпраления <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(Колонка.ЭлементУправления, СтруктураПараметровЭлементаУпраления);
		
	КонецЕсли;	
	
	Если СтруктураДействийЭлементаУпраления <> Неопределено Тогда
		
		Для Каждого КлючИЗначение Из СтруктураДействийЭлементаУпраления Цикл
			
			Колонка.ЭлементУправления.УстановитьДействие(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
		КонецЦикла; 
		
	КонецЕсли; 
	
	Возврат Колонка;
	
КонецФункции

// Процедура добавляет на форму новый элемент.
//
// Параметры
//  ЭлементыФормы - Коллекция элементов формы - Коллекция элементов формы, в которую добавляем новый элемент.
//
//  Тип - Тип - Тип добавляемого элемента.
//
//  Имя - Строка - Имя добавляемого элемента.
//
//  Видимость - Булево - Видимость добавляемого элемента.
//
//  ПоместитьНа - Панель - Панель на форме, на которую добавляем элемент. Если не задан, тогда добавляется непосредственно на форму.
//
//  СтруктураСвойств - Структура - Структура со свойствами элемента. Ключи структуры должны совпадать с названиями свойств.
//
//  СтруктураПривязок - Структура - Структура с привязками элемента. Ключи структуры должны совпадать с названиями границ элемента, значения - структура вида:
//									Ключи структуры дожны иметь следующие наименования: "Элемент, Граница, Элемент2, Граница2", значения - элементы и их границы.
//
//  СтруктураДействий - Структура - Структура с действиями элемента. Ключи структуры должны совпадать с названиями действий, значения должны иметь тип Действия.
//
// Возвращаемое значение:
//   Элемент формы - Добавленный элемент формы.
//
Функция ДобавитьЭлементФормы(ЭлементыФормы, Тип, Имя, Видимость = Истина, ПоместитьНа = Неопределено, СтруктураСвойств = Неопределено, СтруктураПривязок = Неопределено, СтруктураДействий = Неопределено) Экспорт 
	
	ЭлементФормы = ЭлементыФормы.Добавить(Тип, Имя, Видимость, ПоместитьНа);
	
	Если СтруктураСвойств <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ЭлементФормы, СтруктураСвойств);
		
	КонецЕсли;
	
	Если СтруктураПривязок <> Неопределено Тогда
		
		Для Каждого КлючИЗначение Из СтруктураПривязок Цикл
			
			ЭлементФормы.УстановитьПривязку(ГраницаЭлементаУправления[КлючИЗначение.Ключ], КлючИЗначение.Значение.Элемент, КлючИЗначение.Значение.Граница, КлючИЗначение.Значение.Элемент2, КлючИЗначение.Значение.Граница2);
		
		КонецЦикла; 
		
	КонецЕсли; 

	Если СтруктураДействий <> Неопределено Тогда
		
		Для Каждого КлючИЗначение Из СтруктураДействий Цикл
			
			ЭлементФормы.УстановитьДействие(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
		КонецЦикла; 
		
	КонецЕсли; 
	
	Возврат ЭлементФормы;
	
КонецФункции // ДобавитьЭлементФормы()

#КонецЕсли


Процедура СоздатьСвязанныйСРеализациейДокументПоступления(Источник,СвязанныйДоговор) Экспорт 
	
	// А_Карпчук ( 16.07.2019 - отключаем данный механизм пока
	Возврат;
	// А_Карпчук )
	
	// А_Карпчук ( 31.01.2019
	Если Источник.Дата < Дата(2018,12,01,0,0,0) Тогда
		Возврат;
	КонецЕсли;
	// А_Карпчук )

	Сообщение = Новый СообщениеПользователю;
	
	УпрОрганизация = Источник.Организация.А_УправленческийУчет;
	
	лПТУ = А_ОбщегоНазначенияСервер.ПолучитьСвязанныйДокумент(Источник.Ссылка);
	НовыйДокумент = НЕ ЗначениеЗаполнено(лПТУ);
	Если НовыйДокумент Тогда
		ПТУ_Объект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	Иначе	
		Если ДокументЗаблокирован(лПТУ) Тогда
			Сообщение.Текст = "Документ "+лПТУ+" заблокирован! не перезаполняем.";
			Сообщение.Сообщить(); 
			Возврат;
		КонецЕсли;
		ПТУ_Объект = лПТУ.ПолучитьОбъект();
	КонецЕсли;	
	
	если ложь тогда ПТУ_Объект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент() конецесли;
	
	Если Не НовыйДокумент Тогда
		Если ПТУ_Объект.ПометкаУдаления Тогда 
			ПТУ_Объект.УстановитьПометкуУдаления(Ложь)
		КонецЕсли;
	КонецЕсли;
	
	//Создание и заполнение док. ПТУ
	//ПТУ_Объект.Заполнить(пДокументОснование);
	ЗаполнитьЗначенияСвойств(ПТУ_Объект,Источник,,"Номер,Ссылка");
	
	// А_Вячеслав(03.05.2018 
	ПТУ_Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;		
	ПТУ_Объект.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
	//ПТУ_Объект.Дата = Источник.Дата;
	//ПТУ_Объект.СуммаВключаетНДС = Ложь;
	ПТУ_Объект.ТекущаяТемпература = Источник.ТекущаяТемпература;
	ПТУ_Объект.СкладОрдер = Источник.Склад;
		
	//ПТУ_Объект.А_АвтоНалив = ВидНалива = Перечисления.А_ВидыНалива.АвтоНалив;
	//ПТУ_Объект.А_ЖДНалив = ВидНалива = Перечисления.А_ВидыНалива.ЖДНалив;
	ПТУ_Объект.ДоговорКонтрагента = СвязанныйДоговор;
	ПТУ_Объект.Организация = СвязанныйДоговор.Организация;
	ПТУ_Объект.Контрагент = СвязанныйДоговор.Владелец;
	
	// Выполняем общие действия для всех документов при изменении Контрагент.
	ЗаполнениеДокументов.ПриИзмененииЗначенияКонтрагента(ПТУ_Объект);
	
	ПТУ_Объект.А_ПоставкаТовараВГрн = Истина; // А_Вячеслав(09.01.2019 нужна для акциза
	ПТУ_Объект.ДоговорКонтрагента = СвязанныйДоговор;
	
	//Действия при изменении договора
	СпособЗаполненияЦен = Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатурыКонтрагентов;
	СтруктураРеквизитовДокумента = Ценообразование.ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(ПТУ_Объект);
	мТекущаяВалютаВзаиморасчетов = ПТУ_Объект.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	ЗаполнениеДокументов.ПриИзмененииЗначенияДоговора(ПТУ_Объект, мТекущаяВалютаВзаиморасчетов, ПТУ_Объект.мВалютаРегламентированногоУчета, СпособЗаполненияЦен, СтруктураРеквизитовДокумента, "Покупка", "Товары");
	
	ПТУ_Объект.Сделка = А_ОбщегоНазначенияСервер.ПолучитьСвязанныйДокумент(Источник.Сделка);
	
	//Заполнение счетов шапки
	СчетаУчета = УправлениеВзаиморасчетами.ПолучитьСчетаРасчетовСКонтрагентом(ПТУ_Объект.Организация, ПТУ_Объект.Контрагент, ПТУ_Объект.ДоговорКонтрагента);
	
	ПТУ_Объект.СчетУчетаРасчетовСКонтрагентом 		= СчетаУчета.СчетРасчетов;
	ПТУ_Объект.СчетУчетаРасчетовПоАвансам     		= СчетаУчета.СчетАвансов;					
	ПТУ_Объект.СчетУчетаРасчетовПоТаре        		= СчетаУчета.СчетУчетаТары;
	ПТУ_Объект.СчетУчетаРасчетовПоТареПоАвансам 	= СчетаУчета.СчетАвансовПоТаре;			
	ПТУ_Объект.СчетУчетаНДС 						= СчетаУчета.СчетУчетаНДСПриобретений;
	ПТУ_Объект.СчетУчетаНДСПодтвержденный  			= СчетаУчета.СчетУчетаНДСПриобретенийПодтвержденный;
	
	ПТУ_Объект.Товары.Очистить();
	ПТУ_Объект.ВозвратнаяТара.Очистить();
	ПТУ_Объект.Услуги.Очистить();
	
	Счет2811 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2811");
	Счет2812 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2812");
	Счет2813 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2813");
	
	партияРТУ = Неопределено;
	ТоварыПартииРТУ = Неопределено;
	лСуммаАкциз = 0;
	лСуммаПошлина = 0;
	
	Для каждого Движ Из Источник.Движения.Хозрасчетный Цикл
		
		Если Движ.СчетКТ = Счет2811 Тогда
			партияРТУ = Движ.СубконтоКт.Партии;
			// А_Карпчук ( 04.04.2019
			//ТоварыПартииРТУ = партияРТУ.товары.выгрузить();
			Если партияРТУ.Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
				ТоварыПартииРТУ = партияРТУ.товары.выгрузить();
			ИначеЕсли партияРТУ.Метаданные().ТабличныеЧасти.Найти("Продукция") <> Неопределено Тогда
				ТоварыПартииРТУ = партияРТУ.Продукция.выгрузить();
			КонецЕсли;
			// А_Карпчук )
		ИначеЕсли Движ.СчетКТ = Счет2812 Тогда
			лСуммаАкциз = лСуммаАкциз + Движ.Сумма;
		ИначеЕсли Движ.СчетКТ = Счет2813 Тогда
			лСуммаПошлина = лСуммаПошлина + Движ.Сумма;
		КонецЕсли;
		
	КонецЦикла; 
	
	Для каждого Строка Из Источник.Товары Цикл
	
		нс = ПТУ_Объект.Товары.добавить();
		ЗаполнитьЗначенияСвойств(нс,Строка);
		
		//При изменении номенклатуры
		// Заполняем реквизиты табличной части.
		ОбработкаТабличныхЧастей.ЗаполнитьСодержаниеТабЧасти(нс, ПТУ_Объект);

		// Рассчитываем реквизиты табличной части.
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(нс, ПТУ_Объект);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(нс, ПТУ_Объект);
		//Заполнение счета учета НДС
		нс.А_СчетУчетаНДС = ПланыСчетов.Хозрасчетный.НайтиПоКоду("6412");
		
		Если ТоварыПартииРТУ <> Неопределено Тогда
			НацйдСтроки = ТоварыПартииРТУ.найтиСтроки(Новый Структура("Номенклатура",Строка.Номенклатура));
			Если НацйдСтроки.количество()>0 Тогда
				// А_Карпчук ( 04.04.2019
				//нс.А_Сертификат = НацйдСтроки[0].А_Сертификат;
				Если ТоварыПартииРТУ.Колонки.Найти("А_Сертификат") <> Неопределено Тогда
					нс.А_Сертификат = НацйдСтроки[0].А_Сертификат;
				КонецЕсли;
				// А_Карпчук )
				нс.БазоваяПлотность = НацйдСтроки[0].БазоваяПлотность;
				нс.КоэффициентЛитров = НацйдСтроки[0].КоэффициентЛитров;
		    КонецЕсли;
		КонецЕсли; 
		
		нс.А_СуммаАкциза = лСуммаАкциз;
		нс.А_СуммаПошлины = лСуммаПошлина;
	
	КонецЦикла;
	
	Для каждого Строка Из Источник.Услуги Цикл
	
		СтрокаУслуг = ПТУ_Объект.Услуги.добавить();
		ЗаполнитьЗначенияСвойств(СтрокаУслуг,Строка);
		
		//Установка типов субконто
		Для Сч = 1 По СтрокаУслуг.СчетЗатрат.ВидыСубконто.Количество() Цикл
			
			ТипСубк = СтрокаУслуг.СчетЗатрат.ВидыСубконто[Сч - 1].ВидСубконто.ТипЗначения; 
			СтрокаУслуг["Субконто" + Сч] = ТипСубк.ПривестиЗначение(СтрокаУслуг["Субконто" + Сч]);
			
		КонецЦикла;
		
		//Заполнение НалоговоеНазначение
		СчетаУчета = БухгалтерскийУчет.ПолучитьСчетаУчетаНоменклатуры(ПТУ_Объект.Организация, СтрокаУслуг.Номенклатура, Неопределено);
		СтрокаУслуг.НалоговоеНазначение = СчетаУчета.НалоговоеНазначение;
		
		//Заполнение счета учета НДС
		СтрокаУслуг.А_СчетУчетаНДС = ПланыСчетов.Хозрасчетный.НайтиПоКоду("6412");
	КонецЦикла;
		
	Попытка
		ПТУ_Объект.ДополнительныеСвойства.Вставить("А_ЭтоЗеркальныйРТУДокумент",Истина);
		ПТУ_Объект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		Сообщить(ОписаниеОшибки());
		ПТУ_Объект.Записать(РежимЗаписиДокумента.Запись)
	КонецПопытки;
		
	А_ОбщегоНазначенияСервер.УстановитьСвязанныйДокумент(Источник.Ссылка,ПТУ_Объект.Ссылка);
		
	Сообщить("Создан внутренний документ: """ + ПТУ_Объект.Ссылка + """.");
	
	//По скольку у нас работает механизм трансляции БУ в УУ, в данный момент уже создано РТУ по УУ и ПТУ по УУ
	// Нужно внести эти документы в связь по РС А_СвязьДокументовПоНаливу
	Если ПТУ_Объект.Проведен И УпрОрганизация Тогда 
		
		
		РТУ_БУ = ПолучитьСвязанныйДокументБУ(Источник.Ссылка);
		ПТУ_БУ = А_ОбщегоНазначенияСервер.ПолучитьСвязанныйДокумент(РТУ_БУ.ДокументБУ);
		
		Если ЗначениеЗаполнено(ПТУ_БУ) Тогда 
			
			лРС = РегистрыСведений.А_СоответствиеДокуметов_БУ_УУ.СоздатьНаборЗаписей();
			лРС.Отбор.ДокументУУ.Установить(ПТУ_Объект.Ссылка);
			лРС.Прочитать();
			лРС.Очистить();
			лРС.Записать();
			лРС.Отбор.ДокументУУ.Установить(ПТУ_Объект.Ссылка);
			лРС.Отбор.ДокументБУ.Установить(ПТУ_БУ);
			лРС.Прочитать();
			нс = лРС.Добавить();
			нс.ДокументБУ = ПТУ_БУ;
			нс.ДокументУУ = ПТУ_Объект.Ссылка;
			нс.Заблокирован = Ложь;
			лРС.Записать();
			//ЗаписатьСоответствиеДокументов_БУ_УУ(ПТУ_БУ,ПТУ_Объект.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

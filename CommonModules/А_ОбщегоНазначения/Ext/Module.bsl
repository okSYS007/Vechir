					ТекХарактеристикиСебест				 	= ?(ЗначениеЗаполнено(ТекНоменклатурныеПозицииСебстом),ТекНоменклатурныеПозицииСебстом.ХарактеристикаНоменклатуры,Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
				
				 	//Добавим себестоимость в сущестующие строки себестоимости
					СтруктураПоискаСебестоимостиПродаж = Новый Структура;
					СтруктураПоискаСебестоимостиПродаж.Вставить("Номенклатура",НоваяПроводка.СубконтоКт.Номенклатура);
					СтруктураПоискаСебестоимостиПродаж.Вставить("ДокументОприходования",НоваяПроводка.СубконтоКт.Партии);
					СтруктураПоискаСебестоимостиПродаж.Вставить("ХарактеристикаНоменклатуры",ТекХарактеристикиСебест);
					
					
					МассивСтрокПродажиСебестоимости = ТаблицаПродажиСебестоимостьИсходная.найтиСтроки(СтруктураПоискаСебестоимостиПродаж);
					
					СтавкаНДС = ?(НоваяПроводка.НалоговоеНазначениеКт = Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_Облагаемая, Перечисления.СтавкиНДС.НДС20,Перечисления.СтавкиНДС.НДС0);
					
					ТекСуммаНДССебест = УчетНДС.РассчитатьСуммуНДС(НоваяПроводка.Сумма,
						                                       Истина, Ложь,
						                                       УчетНДС.ПолучитьСтавкуНДС(СтавкаНДС));
					
					
					Если МассивСтрокПродажиСебестоимости.Количество() = 0 Тогда 
						
												
						НоваяСтрокаПродажиСебестоимость  = ТаблицаПродажиСебестоимостьИсходная.Добавить();
						НоваяСтрокаПродажиСебестоимость.Период = ПроводкаХозрасчетного.Период;
						НоваяСтрокаПродажиСебестоимость.Активность = Истина;
						НоваяСтрокаПродажиСебестоимость.Регистратор = СтруктураШапкиДокумента.Ссылка;
						НоваяСтрокаПродажиСебестоимость.Номенклатура  = НоваяПроводка.СубконтоКт.Номенклатура;
						НоваяСтрокаПродажиСебестоимость.ХарактеристикаНоменклатуры = 
						НоваяСтрокаПродажиСебестоимость.ДокументОприходования 		= НоваяПроводка.СубконтоКт.Партии;
						НоваяСтрокаПродажиСебестоимость.Количество 		 					= НоваяПроводка.КоличествоКт;
						НоваяСтрокаПродажиСебестоимость.Стоимость 		 					= НоваяПроводка.Сумма;					
						НоваяСтрокаПродажиСебестоимость.НДС										= ТекСуммаНДССебест; 
						
						//Рекви
						НоваяСтрокаПродажиСебестоимость.Проект						= ТекПроектСебестоимость;
						НоваяСтрокаПродажиСебестоимость.Подразделение 			= ТекПодразделениеСебестоимость;
						НоваяСтрокаПродажиСебестоимость.ЗаказПокупателя 		= ТекСделкаСебестоимость;
						
															   
					Иначе 
						
						Если МассивСтрокПродажиСебестоимости.Количество() = 1 Тогда 
						    ИсходнаяСтрока = МассивСтрокПродажиСебестоимости[0];
							
						    ИсходнаяСтрока.Стоимость = ИсходнаяСтрока.Стоимость  + НоваяПроводка.Сумма; 
							ИсходнаяСтрока.НДС			= ИсходнаяСтрока.НДС 			+ ТекСуммаНДССебест; 						
						Иначе 
							//распределим стоимость по количеству
							ИтоговоеКоличество  = 0;
							
							Для Каждого СтркоаТЧСебестоимостиПродаж из МассивСтрокПродажиСебестоимости Цикл 
								ИтоговоеКоличество = ИтоговоеКоличество  + СтркоаТЧСебестоимостиПродаж.Количество;
							КонецЦикла;
							
							ТекПогрешностьСебестПродаж = 0;
							ТекСоотвествиеПогрешностейСебесПродаж = Новый Соответствие;
							ТекПогрешностьСебестПродажНДС = 0;
							ТекСоотвествиеПогрешностейСебесПродажНДС = Новый Соответствие;
							Для Каждого СтркоаТЧСебестоимостиПродаж из МассивСтрокПродажиСебестоимости Цикл 
								
								//ИсходнаяСтрока = МассивСтрокПродажиСебестоимости[0];
								Если ЗначениеЗаполнено(ИтоговоеКоличество) Тогда 								
									К =СтркоаТЧСебестоимостиПродаж.Количество/ИтоговоеКоличество; 
								Иначе 
									К = 1/ МассивСтрокПродажиСебестоимости.Количество();
								КонецЕсли;
								ТекСуммаРаспред = (НоваяПроводка.Сумма) *(К);
								ТекСуммаРаспред = ОбщегоНазначения.ОкруглитьСУчетомПогрешности(ТекСуммаРаспред,2,ТекПогрешностьСебестПродаж ,ТекСоотвествиеПогрешностейСебесПродаж);
								
								ТекСуммаРаспредНДС = (ТекСуммаНДССебест) *(К);
								ТекСуммаРаспредНДС = ОбщегоНазначения.ОкруглитьСУчетомПогрешности(ТекСуммаРаспредНДС,2,ТекПогрешностьСебестПродаж ,ТекСоотвествиеПогрешностейСебесПродаж);
								
								//СтркоаТЧСебестоимостиПродаж.Стоимость 	= ИсходнаяСтрока.Стоимость  + ТекСуммаРаспред; 
								//СтркоаТЧСебестоимостиПродаж.НДС			= ИсходнаяСтрока.НДС 		+ ТекСуммаРаспредНДС; 						
								
								СтркоаТЧСебестоимостиПродаж.Стоимость 	= СтркоаТЧСебестоимостиПродаж.Стоимость  + ТекСуммаРаспред; 
								СтркоаТЧСебестоимостиПродаж.НДС			= СтркоаТЧСебестоимостиПродаж.НДС 		+ ТекСуммаРаспредНДС; 						
								
								
							КонецЦикла;
								
							
						КонецЕсли;
					КонецЕсли;
			КонецЕсли;
			// - IvanSidoruk 18.08.2020
			
		КонецЦикла;
			
	КонецЦикла;	
	
	// коррекция погрешности округления
	Для каждого Строка Из тзОстатки2811 Цикл
		Если Строка.Количество = Строка.КоличествоНакоплено И Строка.Сумма <> Строка.СуммаНакоплено Тогда
			Для каждого Движение Из Движения.Хозрасчетный Цикл
				Если Движение.СчетКт = Строка.Счет И Движение.СубконтоКт.Партии = Строка.Партия И Движение.СубконтоКт.Номенклатура = Строка.Номенклатура 
					 И Движение.СубконтоКт.Склады = Строка.Склад Тогда
					Движение.Сумма = Движение.Сумма + (Строка.Сумма - Строка.СуммаНакоплено);
					Прервать;
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли; 
	КонецЦикла; 
	
	
	Если ПисатьПродажиСебестоимостьПоПроводкам = Истина  И   ПишетПродажиСебестоимость = Истина Тогда 
		Движения.ПродажиСебестоимость.Загрузить(ТаблицаПродажиСебестоимостьИсходная);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоАкцизуПошлинеХранениюТранспортуСтараяВерсия(СтруктураШапкиДокумента, Движения) Экспорт 
	
	// А_Заверуха 12/07/16 **** It4b 2016***** 
	//Если Не СтруктураШапкиДокумента.Организация.А_УправленческийУчет Тогда
	//	Возврат
	//КонецЕсли;
	// А_Заверуха
	
	КоличествоПроводок = Движения.Хозрасчетный.Количество();
	
	Для Сч = 0 По КоличествоПроводок - 1 Цикл
		
		ПроводкаХозрасчетного = Движения.Хозрасчетный[Сч];
		
		Если ПроводкаХозрасчетного.СчетКт <> ПланыСчетов.Хозрасчетный.НайтиПоКоду("2811") Тогда
			Продолжить
		КонецЕсли;
		
		//Получение данных по акцизу, пошлине, хранению и транспорту
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ХозрасчетныйОстатки.Субконто1 КАК Номенклатура,
			|	ХозрасчетныйОстатки.Субконто2 КАК Партия,
			|	ХозрасчетныйОстатки.Субконто3 КАК Склад,
			|	ХозрасчетныйОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ Вт_ОстаткиКоличество
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Остатки(
			|			&Период,
			|			Счет = &Счет_2811,
			|			&МассивСубконто,
			|			Субконто1 = &СубконтоДт1
			|				И Субконто2 = &СубконтоДт2
			|				И Субконто3 = &СубконтоДт3) КАК ХозрасчетныйОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ХозрасчетныйОстатки.Счет,
			|	ХозрасчетныйОстатки.Субконто1 КАК Номенклатура,
			|	ХозрасчетныйОстатки.Субконто2 КАК Партия,
			|	ХозрасчетныйОстатки.Субконто3 КАК Склад,
			|	ХозрасчетныйОстатки.СуммаОстаток КАК Сумма
			|ПОМЕСТИТЬ Вт_ОстаткиСумма
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетов),
			|			&МассивСубконто,
			|			Субконто1 = &СубконтоДт1
			|				И Субконто2 = &СубконтоДт2
			|				И Субконто3 = &СубконтоДт3) КАК ХозрасчетныйОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Вт_ОстаткиСумма.Счет,
			|	Вт_ОстаткиСумма.Номенклатура,
			|	Вт_ОстаткиСумма.Партия,
			|	Вт_ОстаткиСумма.Склад,
			|	Вт_ОстаткиСумма.Сумма,
			|	ЕСТЬNULL(Вт_ОстаткиКоличество.Количество, 0) КАК Количество
			|ИЗ
			|	Вт_ОстаткиСумма КАК Вт_ОстаткиСумма
			|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ОстаткиКоличество КАК Вт_ОстаткиКоличество
			|		ПО Вт_ОстаткиСумма.Номенклатура = Вт_ОстаткиКоличество.Номенклатура
			|			И Вт_ОстаткиСумма.Партия = Вт_ОстаткиКоличество.Партия
			|			И Вт_ОстаткиСумма.Склад = Вт_ОстаткиКоличество.Склад";
			
			
		Запрос.УстановитьПараметр("СубконтоДт1", ПроводкаХозрасчетного.СубконтоКт.Номенклатура);
		Запрос.УстановитьПараметр("СубконтоДт2", ПроводкаХозрасчетного.СубконтоКт.Партии);
		Запрос.УстановитьПараметр("СубконтоДт3", ПроводкаХозрасчетного.СубконтоКт.Склады);		
		Запрос.УстановитьПараметр("Счет_2811", ПланыСчетов.Хозрасчетный.НайтиПоКоду("2811"));
		Запрос.УстановитьПараметр("Период", Новый Граница (ПроводкаХозрасчетного.Период, ВидГраницы.Включая));
		
		МассивСчетов = Новый Массив;
		МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2812"));
		МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2813"));
		МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2814"));
		МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("2815"));
		Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
		
		// А_Заверуха 12/07/16 **** It4b 2016***** 
		МассивСубконто = Новый Массив;
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии);
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады);
		Запрос.УстановитьПараметр("МассивСубконто", МассивСубконто);
		// А_Заверуха
		
		РезультатЗапроса = Запрос.Выполнить();
		//ВнешниеОбработки.Создать("I:\EZ\Запросник2_0.epf").ОтладитьЗапрос(Запрос);
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.Сумма = 0  Или ВыборкаДетальныеЗаписи.Количество = 0 Тогда 
				Продолжить
			КонецЕсли;
			
			НоваяПроводка = Движения.Хозрасчетный.Добавить();		
		
			// Заполним все свойства (кроме субконто):
			ЗаполнитьЗначенияСвойств(НоваяПроводка, ПроводкаХозрасчетного);
			
			Если СтруктураШапкиДокумента.ВидДокумента = "ПеремещениеТоваров" Тогда 
				НоваяПроводка.СчетДт = ВыборкаДетальныеЗаписи.Счет;
			КонецЕсли; 
			
			// Субконто ДТ
			Для каждого Субконто Из ПроводкаХозрасчетного.СчетДт.ВидыСубконто  Цикл
				
				ОбщегоНазначения.УстановитьСубконтоПоВидуСубконто(НоваяПроводка.СчетДт,
			   					  НоваяПроводка.СубконтоДт,
								  Субконто.ВидСубконто, 
								  ПроводкаХозрасчетного.СубконтоДт[Субконто.ВидСубконто]);
				
			
			КонецЦикла;

			// Субконто КТ
			Для каждого Субконто Из ПроводкаХозрасчетного.СчетКт.ВидыСубконто  Цикл
				
				ОбщегоНазначения.УстановитьСубконтоПоВидуСубконто(НоваяПроводка.СчетКт,
			   					  НоваяПроводка.СубконтоКт,
								  Субконто.ВидСубконто, 
								  ПроводкаХозрасчетного.СубконтоКт[Субконто.ВидСубконто]);
				
			
			КонецЦикла;
							  
			НоваяПроводка.СчетКт = ВыборкаДетальныеЗаписи.Счет;
			
			НоваяПроводка.Сумма = ВыборкаДетальныеЗаписи.Сумма / ВыборкаДетальныеЗаписи.Количество * ПроводкаХозрасчетного.КоличествоКт;
			
						
			// А_Заверуха 12/07/16 **** It4b 2016***** 
			НоваяПроводка.КоличествоКт = 0;
			// А_Заверуха
			
			НоваяПроводка.КоличествоДт = 0;
			
			Если ВыборкаДетальныеЗаписи.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2812") Тогда 
				НоваяПроводка.Содержание = "Списание акциза"
			ИначеЕсли ВыборкаДетальныеЗаписи.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2813") Тогда 
				НоваяПроводка.Содержание = "Списание пошлины"
			ИначеЕсли ВыборкаДетальныеЗаписи.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2814") Тогда 
				НоваяПроводка.Содержание = "Списание хранения"
			ИначеЕсли ВыборкаДетальныеЗаписи.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("2815") Тогда 
				НоваяПроводка.Содержание = "Списание транспорта"
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЦикла;	
	
КонецПроцедуры

Процедура УстановитьВремяДокументов(МетаданныеДокумента, ДокументОбъект, РежимЗаписи, РежимПроведения) Экспорт 	// +++ А_ИТ4Б Ересько 2016-08-05 {} 
	
	//Время устанавливаем только при первом проведении документа
	Если Не (РежимЗаписи = РежимЗаписиДокумента.Проведение И Не ДокументОбъект.Проведен) Тогда 
		// А_Вячеслав(08.01.2019 
		Если НЕ ДокументОбъект.ДополнительныеСвойства.Свойство("А_ЭтоЗеркальныйРТУДокумент") 
			И НЕ МетаданныеДокумента.Имя = "ПоступлениеТоваровУслуг"  // А_Карпчук ( 21.01.2019 - в ПТУ всегда устанавливаем время)
			И НЕ МетаданныеДокумента.Имя = "ПоступлениеДопРасходов"  // А_Карпчук ( 29.01.2019 - в Пост. доп.расх всегда устанавливаем время)
			Тогда
			Возврат;
		КонецЕсли;
		// А_Вячеслав) 
	КонецЕсли;
	
	//Для того чтобы установить произвольное время проведения - нужно установить Неопреративное проведение
	РежимПроведения = РежимПроведенияДокумента.Неоперативный;
	
	// + IvanSidoruk 22.01.2019
	ИмяДока = МетаданныеДокумента.Имя; 
	// - IvanSidoruk 22.01.2019
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеВремениДокументам.Время
		|ИЗ
		|	РегистрСведений.А_СоответствиеВремениДокументам КАК А_СоответствиеВремениДокументам
		|ГДЕ
		|	А_СоответствиеВремениДокументам.ВидДокумента = &ВидДокумента";
	
	Запрос.УстановитьПараметр("ВидДокумента", ИмяДока);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда 
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	 	ВыборкаДетальныеЗаписи.Следующий();
		
		ДатаДокументаСУчетомЧасов = Дата(Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy") + " " + Прав(ВыборкаДетальныеЗаписи.Время, 8));
		
		//Добавление секунды пока нужно только для док. ПоступлениеТоваровУслуг 
		Если ИмяДока = "ПоступлениеТоваровУслуг" 			
			Или  ИмяДока = "ОтчетОРозничныхПродажах" 
			Или  ИмяДока = "ОтчетПроизводстваЗаСмену" 
			Или  ИмяДока = "ПеремещениеТоваров" 
			Или  ИмяДока = "ВозвратТоваровОтПокупателя"
			Или  ИмяДока = "ВозвратТоваровПоставщику"
			Или  ИмяДока = "ВводВЭксплуатациюОС"
			Или  ИмяДока = "КомплектацияНоменклатуры"
			Или  ИмяДока = "ОприходованиеТоваров"
			Или  ИмяДока = "СписаниеТоваров"
			Или  ИмяДока = "ТребованиеНакладная"

			Тогда 
		
		
			//Поиск последнего документа проведенного в данном часе
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	МАКСИМУМ(ОбрабатываемыйДокумент.Дата) КАК Дата
				|ИЗ
				|	Документ." + МетаданныеДокумента.Имя + " КАК ОбрабатываемыйДокумент
				|ГДЕ
				|	НАЧАЛОПЕРИОДА(ОбрабатываемыйДокумент.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
				|	И ЧАС(ОбрабатываемыйДокумент.Дата) = ЧАС(&Дата)
				|	И ОбрабатываемыйДокумент.Ссылка <> &ТекДокумент
				|
				|ИМЕЮЩИЕ
				|	НЕ МАКСИМУМ(ОбрабатываемыйДокумент.Дата) ЕСТЬ NULL ";
			
			// А_Вячеслав(21.01.2019 если документ с услугами
			 Если ИмяДока = "ПоступлениеТоваровУслуг" и ДокументОбъект.Услуги.Количество()>0 И ДокументОбъект.Товары.Количество()=0 Тогда
				ДатаДокументаСУчетомЧасов = Дата(Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy") + " 19:00:00");
			КонецЕсли;
			// А_Вячеслав) 
			Запрос.УстановитьПараметр("Дата", ДатаДокументаСУчетомЧасов);
			Запрос.УстановитьПараметр("ТекДокумент", ДокументОбъект.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда 
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				ВыборкаДетальныеЗаписи.Следующий();
				
				// А_Вячеслав(21.01.2019 
				//ДатаДокументаСУчетомЧасов = ВыборкаДетальныеЗаписи.Дата + 1;
				ДатаДокументаСУчетомЧасов = ВыборкаДетальныеЗаписи.Дата + 2;
				// А_Вячеслав) 
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДокументОбъект.Дата = ДатаДокументаСУчетомЧасов
		
	КонецЕсли;	
	
КонецПроцедуры 

// Служебная функция - заполняет ПроводкаНовая теми же данными, что содержатся в проводке ПроводкаИсходная
//
Процедура СкопироватьПроводкуРегистраБухгалтерии(ПроводкаНовая, ПроводкаИсходная) Экспорт	// +++ А_ИТ4Б Ересько 2017-07-14 {}

	// Заполним все свойства (кроме субконто):
	ЗаполнитьЗначенияСвойств(ПроводкаНовая, ПроводкаИсходная);
	
	// Субконто ДТ
	Для каждого Субконто Из ПроводкаИсходная.СчетДт.ВидыСубконто  Цикл
		
		ОбщегоНазначения.УстановитьСубконтоПоВидуСубконто(ПроводкаНовая.СчетДт,
	   					  ПроводкаНовая.СубконтоДт,
						  Субконто.ВидСубконто, 
						  ПроводкаИсходная.СубконтоДт[Субконто.ВидСубконто]);
		
	

	//		Строка.Заявка 		= Заявка;
	//		строка.Накладная 	= Накладная;
	//	КонецЦикла;
	//КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		возврат;
	КонецЕсли; 
	
	лЗапись = РегистрыСведений.А_НаличиеДокументов.СоздатьМенеджерЗаписи();

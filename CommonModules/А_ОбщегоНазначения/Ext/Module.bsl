Функция ПолучитьДополнительныеДанныеДокумента(Документ) Экспорт
	
	Если Документ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	стрВозврата = Новый Структура;
	стрВозврата.Вставить("Оригинал", Ложь);
	стрВозврата.Вставить("Медок", Ложь);
	стрВозврата.Вставить("Вчасно", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеДанныеДокументов.Оригинал,
		|	ДополнительныеДанныеДокументов.Медок,
		|	ДополнительныеДанныеДокументов.Вчасно
		|ИЗ
		|	РегистрСведений.ДополнительныеДанныеДокументов КАК ДополнительныеДанныеДокументов
		|ГДЕ
		|	ДополнительныеДанныеДокументов.Документ = &Документ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(стрВозврата, ВыборкаДетальныеЗаписи);			
	КонецЦикла;
	
	Возврат стрВозврата;
	
КонецФункции

Процедура ЗаписатьДополнительныеДанныеДокумента(Документ, Данные) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;
	
	МенЗап = РегистрыСведений.ДополнительныеДанныеДокументов.СоздатьМенеджерЗаписи();
	МенЗап.Документ = Документ;
	ЗаполнитьЗначенияСвойств(МенЗап, Данные);
	МенЗап.Записать();
	
КонецПроцедуры


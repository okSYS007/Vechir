Процедура ПриОткрытии_Пользователи(МетаданныеОбъекта, ФормаОбъекта)
	
	ЭлементыФормы = ФормаОбъекта.ЭлементыФормы;
	
	Если РольДоступна("ПолныеПрава") Тогда 
	
		//Довавим страницу "Доступные организации"
		СтраницаДоступныеОрганизации = ЭлементыФормы.ПанельПользователей.Страницы.Добавить("А_ДоступныеОрганизации", "Доступные организации");
			
		ТекущаяСтраницаПанели = ЭлементыФормы.ПанельПользователей.ТекущаяСтраница;
		ЭлементыФормы.ПанельПользователей.ТекущаяСтраница = СтраницаДоступныеОрганизации;
		
		//Добавление ТЧ "Доступные организации" и панели к ней
		Если Истина Тогда
			
			// Добавление ТЧ "Доступные организации"
			СтруктураСвойств = Новый Структура();
			СтруктураСвойств.Вставить("Высота", 281); 
			СтруктураСвойств.Вставить("Ширина", 552);
			СтруктураСвойств.Вставить("Верх", 24);
			СтруктураСвойств.Вставить("Лево", 6);
			СтруктураСвойств.Вставить("Данные", "А_ДоступныеОрганизации");
			СтруктураСвойств.Вставить("ИзменяетДанные", Истина);
			СтруктураСвойств.Вставить("ТолькоПросмотр", Ложь);
			
			СтруктураПривязок 			= Новый Структура();
			ТекущиеЗначенияПривязки 	= Новый Структура();
			
			ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ПанельПользователей);	
			ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Право);
			
			СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
			ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
			СтруктураПривязок.Вставить("Право", СтруктураЗначенияПривязки);
			
			ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ПанельПользователей);	
			ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Низ);
			
			СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
			ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
			СтруктураПривязок.Вставить("Низ", СтруктураЗначенияПривязки);
			
			ЭлементСписокДоступныхОрганизаций = ДобавитьЭлементФормы(ЭлементыФормы, Тип("ТабличноеПоле"), "А_ДоступныеОрганизации", , ЭлементыФормы.ПанельПользователей, СтруктураСвойств, СтруктураПривязок);
			ЭлементСписокДоступныхОрганизаций.СоздатьКолонки();
		
			// Добавление комендную панель ТЧ "Доступные организации"
			СтруктураСвойств = Новый Структура();
			СтруктураСвойств.Вставить("Высота", 15); 
			СтруктураСвойств.Вставить("Ширина", 552);
			СтруктураСвойств.Вставить("Верх", 0);
			СтруктураСвойств.Вставить("Лево", 6);
			СтруктураСвойств.Вставить("ИсточникДействий", ЭлементСписокДоступныхОрганизаций);
			СтруктураСвойств.Вставить("ИзменяетДанные", Истина);
			СтруктураСвойств.Вставить("ТолькоПросмотр", Ложь);
			СтруктураСвойств.Вставить("Автозаполнение", Истина);
			
			СтруктураПривязок 			= Новый Структура();
			ТекущиеЗначенияПривязки 	= Новый Структура();
			
			ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ПанельПользователей);	
			ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Право);
			
			СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
			ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
			СтруктураПривязок.Вставить("Право", СтруктураЗначенияПривязки);
			
			ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ПанельПользователей);	
			ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Верх);
			
			СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
			ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
			СтруктураПривязок.Вставить("Низ", СтруктураЗначенияПривязки);
			
			ЭлементКонтактнаяПанельСписокДоступныхОрганизаций = ДобавитьЭлементФормы(ЭлементыФормы, Тип("КоманднаяПанель"), "А_КоманднаяПанельСписокДоступныхОрганизаций", , ЭлементыФормы.ПанельПользователей, СтруктураСвойств);//, СтруктураПривязок);
			
		КонецЕсли;
		
		ЭлементыФормы.ПанельПользователей.ТекущаяСтраница = ТекущаяСтраницаПанели;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКнопкуБлокировкиДокументаУУ(МетаданныеОбъекта, ФормаОбъекта)
	
	//Для справочников кнопку не добавляем
	Если ОбщегоНазначения.ПринадлежностьКлассуМетаданных("Справочники", МетаданныеОбъекта)
		Или ОбщегоНазначения.ПринадлежностьКлассуМетаданных("ПланыВидовХарактеристик", МетаданныеОбъекта) Тогда 
		Возврат
	КонецЕсли;
	
	ОбъектМетаданныхХозрасчетный = Метаданные.РегистрыБухгалтерии.Хозрасчетный;
	
	ЕстьПризнакОтражатьВУправленческомУчете = МетаданныеОбъекта.Реквизиты.Найти("ОтражатьВУправленческомУчете") <> Неопределено;
	ЕстьПризнакОтражатьВУпрУчете = МетаданныеОбъекта.Реквизиты.Найти("ОтражатьВУпрУчете") <> Неопределено;
	
	МассивДругихДокументов = Новый Массив;
	МассивДругихДокументов.Добавить(Метаданные.Документы.ПриемНаРаботуВОрганизацию);
	МассивДругихДокументов.Добавить(Метаданные.Документы.КадровоеПеремещениеОрганизаций);
	МассивДругихДокументов.Добавить(Метаданные.Документы.УвольнениеИзОрганизаций);
	
	ЭтоДругойДокумент = МассивДругихДокументов.Найти(МетаданныеОбъекта) <> Неопределено;	
	
	Если ((МетаданныеОбъекта.Движения.Содержит(ОбъектМетаданныхХозрасчетный)	 
		И ((ЕстьПризнакОтражатьВУправленческомУчете И ФормаОбъекта.ОтражатьВУправленческомУчете) Или (ЕстьПризнакОтражатьВУпрУчете И ФормаОбъекта.ОтражатьВУпрУчете)) Или ЭтоДругойДокумент)
		И ФормаОбъекта.Организация.А_УправленческийУчет) Тогда
		
		ДокументУУ = ФормаОбъекта.Ссылка;
		
		//Проверка блокировки документа
		//Если документа нет в РС, тогда такой документ блокировать не нужно
		ДанныеБУ = ПолучитьСвязанныйДокументБУ(ДокументУУ);
		
		Если ДанныеБУ.ДокументБУ = Неопределено Тогда 
			Возврат
		КонецЕсли;
		
		Если ДанныеБУ.Заблокирован Тогда 
			ТекстЗаголовка = "Разблокировать";
			ТекстПодсказки = "Разблокировать документ!"
		Иначе 
			ТекстЗаголовка = "Заблокировать";
			ТекстПодсказки = "Заблокировать документ!"
		КонецЕсли;
		
		ЭлементыФормы = ФормаОбъекта.ЭлементыФормы;
		КоманднаяПанель = ЭлементыФормы.ДействияФормы;
		
		ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель;
		КоманднаяПанель.Кнопки.Добавить("А_Разделитель", ТипКнопки);
		
		НовоеДействие = Новый Действие("ОсновныеДействияФормыПечатьПоУмолчанию");
		ТипКнопки = ТипКнопкиКоманднойПанели.Действие;
		БлокировкаДокумента = КоманднаяПанель.Кнопки.Добавить("А_БлокировкаДокумента", ТипКнопки, ТекстЗаголовка, НовоеДействие);
		БлокировкаДокумента.Подсказка = ТекстПодсказки;
		БлокировкаДокумента.Пояснение = ТекстПодсказки;
		
	КонецЕсли;
	
КонецПроцедуры 

Процедура ДобавитьКнопкуБлокировкиДокументаБУ(МетаданныеОбъекта, ФормаОбъекта)
	
	//Для справочников кнопку не добавляем
	Если ОбщегоНазначения.ПринадлежностьКлассуМетаданных("Справочники", МетаданныеОбъекта)
		Или ОбщегоНазначения.ПринадлежностьКлассуМетаданных("ПланыВидовХарактеристик", МетаданныеОбъекта) Тогда 
		Возврат
	КонецЕсли;
	
	ОбъектМетаданныхХозрасчетный = Метаданные.РегистрыБухгалтерии.Хозрасчетный;
	
	ЕстьПризнакОтражатьВБухгалтерскомУчете = МетаданныеОбъекта.Реквизиты.Найти("ОтражатьВБухгалтерскомУчете") <> Неопределено;
	ЕстьПризнакОтражатьВРеглУчете = МетаданныеОбъекта.Реквизиты.Найти("ОтражатьВРеглУчете") <> Неопределено;
	
	МассивДругихДокументов = Новый Массив;
	МассивДругихДокументов.Добавить(Метаданные.Документы.ПриемНаРаботуВОрганизацию);
	МассивДругихДокументов.Добавить(Метаданные.Документы.КадровоеПеремещениеОрганизаций);
	МассивДругихДокументов.Добавить(Метаданные.Документы.УвольнениеИзОрганизаций);
	
	ЭтоДругойДокумент = МассивДругихДокументов.Найти(МетаданныеОбъекта) <> Неопределено;	
	
	Если ((МетаданныеОбъекта.Движения.Содержит(ОбъектМетаданныхХозрасчетный)	 
		И ((ЕстьПризнакОтражатьВБухгалтерскомУчете И ФормаОбъекта.ОтражатьВБухгалтерскомУчете) Или (ЕстьПризнакОтражатьВРеглУчете И ФормаОбъекта.ОтражатьВРеглУчете)) Или ЭтоДругойДокумент)
		И ФормаОбъекта.Организация.А_БухгалтерскийУчет) Тогда
		
		ДокументБУ = ФормаОбъекта.Ссылка;
		
		//Проверка блокировки документа
		//Если документа нет в РС, тогда такой документ блокировать не нужно
		ДанныеУУ = ПолучитьСвязанныйДокументУУ(ДокументБУ);
		
		Если ДанныеУУ.ДокументУУ = Неопределено Тогда 
			Возврат
		КонецЕсли;
		
		// А_Вячеслав(29.08.2017 кнопка нужна пока только в ПТУ по наливу
		Если МетаданныеОбъекта = Метаданные.Документы.ПоступлениеТоваровУслуг Тогда
			Если РегистрыСведений.А_СвязьДокументовПоНаливу.ПолучитьРТУ(ФормаОбъекта.Ссылка) = Неопределено Тогда
				Возврат;
			КонецЕсли;	
		Иначе
			Возврат;
		КонецЕсли;
		// А_Вячеслав)
		
		Если ДанныеУУ.ЗаблокированБУ Тогда 
			ТекстЗаголовка = "Разблокировать";
			ТекстПодсказки = "Разблокировать документ!"
		Иначе 
			ТекстЗаголовка = "Заблокировать";
			ТекстПодсказки = "Заблокировать документ!"
		КонецЕсли;
		
		ЭлементыФормы = ФормаОбъекта.ЭлементыФормы;
		КоманднаяПанель = ЭлементыФормы.ДействияФормы;
		
		ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель;
		КоманднаяПанель.Кнопки.Добавить("А_Разделитель", ТипКнопки);
		
		НовоеДействие = Новый Действие("ОсновныеДействияФормыПечатьПоУмолчанию");
		ТипКнопки = ТипКнопкиКоманднойПанели.Действие;
		БлокировкаДокумента = КоманднаяПанель.Кнопки.Добавить("А_БлокировкаДокумента", ТипКнопки, ТекстЗаголовка, НовоеДействие);
		БлокировкаДокумента.Подсказка = ТекстПодсказки;
		БлокировкаДокумента.Пояснение = ТекстПодсказки;
		
	КонецЕсли;
	
КонецПроцедуры 


Процедура ПриОткрытии_ПеремещениеТоваров(МетаданныеОбъекта, ФормаОбъекта)
	
	ЭлементыФормы = ФормаОбъекта.ЭлементыФормы;
	
	ТекущаяСтраницаПанели = ЭлементыФормы.ОсновнаяПанель.ТекущаяСтраница;
	ЭлементыФормы.ОсновнаяПанель.ТекущаяСтраница = ЭлементыФормы.ОсновнаяПанель.Страницы.Дополнительно;
	
	//Добавление поля "Вид взаиморасчетов"
	Если Истина Тогда 
		
		// Добавление надписи "Вид взаиморасчетов"
		СтруктураСвойств = Новый Структура();
		СтруктураСвойств.Вставить("Высота", 19); 
		СтруктураСвойств.Вставить("Ширина", 87); 
		СтруктураСвойств.Вставить("Верх", 50);
		СтруктураСвойств.Вставить("Лево", 10);
		СтруктураСвойств.Вставить("Заголовок", "Вид взаиморасчетов");
		
		СтруктураПривязок 			= Новый Структура();
		ТекущиеЗначенияПривязки 	= Новый Структура();
		
		//Левая и правая границы
		ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ОсновнаяПанель);	
		ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Лево);
		
		СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
		ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
		СтруктураПривязок.Вставить("Лево", СтруктураЗначенияПривязки);
		СтруктураПривязок.Вставить("Право", СтруктураЗначенияПривязки);
		
		//Верхняя и нижняя границы
		ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ОсновнаяПанель);	
		ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Верх);
						
		СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
		ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
		СтруктураПривязок.Вставить("Верх", СтруктураЗначенияПривязки);
		СтруктураПривязок.Вставить("Низ", СтруктураЗначенияПривязки);
		
		ЭлементНадписьВидВзаиморасчетов = ДобавитьЭлементФормы(ЭлементыФормы, Тип("Надпись"), "НадписьА_ВидВзаиморасчетов", , ЭлементыФормы.ОсновнаяПанель, СтруктураСвойств, СтруктураПривязок);
		
		// Добавление поля "Вид взаиморасчетов"
		СтруктураСвойств = Новый Структура();
		СтруктураСвойств.Вставить("Высота", 19); 
		СтруктураСвойств.Вставить("Ширина", 208); 
		СтруктураСвойств.Вставить("Верх", 50);
		СтруктураСвойств.Вставить("Лево", 99);
		СтруктураСвойств.Вставить("Заголовок", "Вид взаиморасчетов");
		СтруктураСвойств.Вставить("Данные", "А_ВидВзаиморасчетов");
		СтруктураСвойств.Вставить("ИзменяетДанные", Истина);
		СтруктураСвойств.Вставить("ТолькоПросмотр", Ложь);
		СтруктураСвойств.Вставить("КнопкаОткрытия", Истина);
		
		СтруктураПривязок 			= Новый Структура();
		ТекущиеЗначенияПривязки 	= Новый Структура();
		
		//Левая граница
		ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ОсновнаяПанель);	
		ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Лево);
		
		СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
		ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
		СтруктураПривязок.Вставить("Лево", СтруктураЗначенияПривязки);
		
		//Верхняя и нижняя границы
		ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ОсновнаяПанель);	
		ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Верх);
						
		СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
		ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
		СтруктураПривязок.Вставить("Верх", СтруктураЗначенияПривязки);
		СтруктураПривязок.Вставить("Низ", СтруктураЗначенияПривязки);
		
		//Правая граница
		ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.ОсновнаяПанель);	
		ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Лево);
		ТекущиеЗначенияПривязки.Вставить("Элемент2", ЭлементыФормы.ОсновнаяПанель);	
		ТекущиеЗначенияПривязки.Вставить("Граница2", ГраницаЭлементаУправления.Право);
						
		СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
		ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
		СтруктураПривязок.Вставить("Право", СтруктураЗначенияПривязки);
		
		ЭлементПолеВидВзаиморасчетов = ДобавитьЭлементФормы(ЭлементыФормы, Тип("ПолеВвода"), "А_ВидВзаиморасчетов", , ЭлементыФормы.ОсновнаяПанель, СтруктураСвойств, СтруктураПривязок);
		
	КонецЕсли;	
	
	ЭлементыФормы.ОсновнаяПанель.ТекущаяСтраница = ТекущаяСтраницаПанели;
	// А_Вячеслав(03.05.2018 
	ЭлементыФормы.ДействияФормы.Кнопки.Подменю3.Кнопки.Вставить(2, "СвязанныеДокументыПоНаливу", ТипКнопкиКоманднойПанели.Действие, "Связанные документы по наливу", Новый Действие("ДействияФормыСвязанныеДокументыПоНаливу"))	// +++ А_ИТ4Б Ересько 2017-07-17 {Механизм для налива} 
	// А_Вячеслав) 
	
КонецПроцедуры


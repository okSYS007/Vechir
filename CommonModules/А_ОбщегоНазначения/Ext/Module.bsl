	//НаборЗаписей = РегистрыСведений.А_НаличиеДокументов.СоздатьНаборЗаписей();
	//НаборЗаписей.Отбор.ДокументСсылка.Установить(Документ);
	//НаборЗаписей.Прочитать();
	//
	//Если НаборЗаписей.Количество() = 0 Тогда 
	//	НоваяЗапись = НаборЗаписей.Добавить();
	//	НоваяЗапись.ДокументСсылка 	= Документ;
	//	НоваяЗапись.Доверенность 	= Доверенность;
	//	НоваяЗапись.Заявка 			= Заявка;
	//	НоваяЗапись.Накладная 		= Накладная;
	//Иначе 

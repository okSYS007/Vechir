Процедура А_ПолучитьНаличиеДокументов(Документ, Накладная, Доверенность, Заявка,ТТН)Экспорт
	
	НаборЗаписей = РегистрыСведений.А_НаличиеДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументСсылка.Установить(Документ);

// Получаем связаную организацию УУ по организации УУ
// Параметры:
// ОрганизацияБУ - справочник ссылка Организация
Функция ПолучитьОрганизациюУУ(ОрганизацияБУ) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеОрганизаций_БУ_УУ.ОрганизацияУУ КАК ОрганизацияУУ
		|ИЗ
		|	РегистрСведений.А_СоответствиеОрганизаций_БУ_УУ КАК А_СоответствиеОрганизаций_БУ_УУ
		|ГДЕ
		|	А_СоответствиеОрганизаций_БУ_УУ.ОрганизацияБУ = &ОрганизацияБУ";
	
	Запрос.УстановитьПараметр("ОрганизацияБУ", ОрганизацияБУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		
		Возврат Справочники.Организации.ПустаяСсылка()
		
	Иначе 
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Возврат ВыборкаДетальныеЗаписи.ОрганизацияУУ
		
	КонецЕсли;
	
КонецФункции

// Получаем связанный документ УУ по документу БУ
// Параметры:
// ДокументБУ - документ ссылка
Функция ПолучитьСвязанныйДокументУУ(ДокументБУ) Экспорт 
	
	Результат = Новый Структура("ДокументУУ,Заблокирован,ЗаблокированБУ", Неопределено, Ложь, Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеДокуметов_БУ_УУ.ДокументУУ КАК ДокументУУ,
		|	А_СоответствиеДокуметов_БУ_УУ.ЗаблокированБУ КАК ЗаблокированБУ,
		|	А_СоответствиеДокуметов_БУ_УУ.Заблокирован КАК Заблокирован
		|ИЗ
		|	РегистрСведений.А_СоответствиеДокуметов_БУ_УУ КАК А_СоответствиеДокуметов_БУ_УУ
		|ГДЕ
		|	А_СоответствиеДокуметов_БУ_УУ.ДокументБУ = &ДокументБУ";
	
	Запрос.УстановитьПараметр("ДокументБУ", ДокументБУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		
		Возврат Результат
		
	Иначе 
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Результат.ДокументУУ     = ВыборкаДетальныеЗаписи.ДокументУУ;
		Результат.Заблокирован   = ВыборкаДетальныеЗаписи.Заблокирован;		
		Результат.ЗаблокированБУ = ВыборкаДетальныеЗаписи.ЗаблокированБУ;
		
		Возврат Результат
		
	КонецЕсли;
	
КонецФункции

// Получаем связанный документ БУ по документу УУ
// Параметры:
// ДокументУУ - документ ссылка
Функция ПолучитьСвязанныйДокументБУ(ДокументУУ) Экспорт 
	
	// А_Вячеслав(29.08.2017 
	//Результат = Новый Структура("ДокументБУ,Заблокирован", Неопределено, Ложь);
	Результат = Новый Структура("ДокументБУ,Заблокирован,ЗаблокированБУ", Неопределено, Ложь, Ложь);
	// А_Вячеслав) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеДокуметов_БУ_УУ.ДокументБУ КАК ДокументБУ,
		// А_Вячеслав(29.08.2017 
		|	А_СоответствиеДокуметов_БУ_УУ.Заблокирован КАК Заблокирован,
		|	А_СоответствиеДокуметов_БУ_УУ.ЗаблокированБУ КАК ЗаблокированБУ
		// А_Вячеслав) 
		|ИЗ
		|	РегистрСведений.А_СоответствиеДокуметов_БУ_УУ КАК А_СоответствиеДокуметов_БУ_УУ
		|ГДЕ
		|	А_СоответствиеДокуметов_БУ_УУ.ДокументУУ = &ДокументУУ";
	
	Запрос.УстановитьПараметр("ДокументУУ", ДокументУУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		
		Возврат Результат
		
	Иначе 
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Результат.ДокументБУ = ВыборкаДетальныеЗаписи.ДокументБУ;
		Результат.Заблокирован = ВыборкаДетальныеЗаписи.Заблокирован;		
		// А_Вячеслав(29.08.2017 
		Результат.ЗаблокированБУ = ВыборкаДетальныеЗаписи.ЗаблокированБУ;
		// А_Вячеслав) 
		
		Возврат Результат
		
	КонецЕсли;
	
КонецФункции

// Записываем соответствие документов БУ и УУ
// Параметры:
// ДокументБУ - документ ссылка
// ДокументУУ - документ ссылка
// Заблокирован - Булево
Процедура ЗаписатьСоответствиеДокументов_БУ_УУ(ДокументБУ, ДокументУУ, Заблокирован = Ложь) Экспорт 
	
	МенеджерЗаписи = РегистрыСведений.А_СоответствиеДокуметов_БУ_УУ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументБУ = ДокументБУ;
	МенеджерЗаписи.ДокументУУ = ДокументУУ;
	МенеджерЗаписи.Заблокирован = Заблокирован;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Записываем соответствие документов БУ и УУ
// Параметры:
// ДокументБУ - документ ссылка
// ДокументУУ - документ ссылка
// Заблокирован - Булево
Процедура ЗаписатьСоответствиеЗначенийРеквизитов_БУ_УУ(ЗначениеРеквизитаБУ, ЗначениеРеквизитаУУ) Экспорт 
	
	МенеджерЗаписи = РегистрыСведений.А_СоответствиеЗначенийРеквизитов_БУ_УУ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ОбъектБУ = ЗначениеРеквизитаБУ;
	МенеджерЗаписи.ОбъектУУ = ЗначениеРеквизитаУУ;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Изменение признака блокировки документа
// Параметры:
// ДокументУУ - документ ссылка
// Заблокирован - Булево
Процедура ОбработатьБлокировкуДокумента(пДокумент, Заблокирован) Экспорт 
	// А_Вячеслав(29.08.2017 
	МенеджерЗаписи = РегистрыСведений.А_СоответствиеДокуметов_БУ_УУ.СоздатьМенеджерЗаписи();
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Организация", пДокумент.Метаданные()) Тогда
		
		ЭтоУУ = пДокумент.Организация.А_УправленческийУчет;
		
		Если ЭтоУУ Тогда
			лДокументБУ = ПолучитьСвязанныйДокументБУ(пДокумент).ДокументБУ;
			лДокументУУ = пДокумент;
		Иначе	
			лДокументУУ = ПолучитьСвязанныйДокументУУ(пДокумент).ДокументУУ;
			лДокументБУ = пДокумент;
		КонецЕсли;	
	
		
		МенеджерЗаписи.ДокументУУ = лДокументУУ;
		МенеджерЗаписи.ДокументБУ = лДокументБУ;
		МенеджерЗаписи.Прочитать();
		Если ЭтоУУ Тогда
			МенеджерЗаписи.Заблокирован = Заблокирован;
		Иначе
			МенеджерЗаписи.ЗаблокированБУ = Заблокирован;
		КонецЕсли;	
		МенеджерЗаписи.Записать();
		Возврат;
		
	Иначе // фиг знает кому это надо, но оставим старый механизм
		
		ДокументБУ = ПолучитьСвязанныйДокументБУ(пДокумент).ДокументБУ;
		
		МенеджерЗаписи.ДокументУУ = пДокумент;
		МенеджерЗаписи.ДокументБУ = ДокументБУ;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Заблокирован = Заблокирован;
		МенеджерЗаписи.Записать();
	КонецЕсли;	
	// А_Вячеслав) 
	
КонецПроцедуры

// определяет заблокирован ли документ
Функция ДокументЗаблокирован(пДокумент) Экспорт 
	
	МенеджерЗаписи = РегистрыСведений.А_СоответствиеДокуметов_БУ_УУ.СоздатьМенеджерЗаписи();
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Организация", пДокумент.Метаданные()) Тогда
		
		ЭтоУУ = пДокумент.Организация.А_УправленческийУчет;
		
		Если ЭтоУУ Тогда
			лДокументБУ = ПолучитьСвязанныйДокументБУ(пДокумент).ДокументБУ;
			лДокументУУ = пДокумент;
		Иначе	
			лДокументУУ = ПолучитьСвязанныйДокументУУ(пДокумент).ДокументУУ;
			лДокументБУ = пДокумент;
		КонецЕсли;	
		
		МенеджерЗаписи.ДокументУУ = лДокументУУ;
		МенеджерЗаписи.ДокументБУ = лДокументБУ;
		МенеджерЗаписи.Прочитать();
		Если ЭтоУУ Тогда
			Возврат МенеджерЗаписи.Заблокирован;
		Иначе
			Возврат МенеджерЗаписи.ЗаблокированБУ;
		КонецЕсли;	
		
	Иначе // фиг знает кому это надо, но оставим старый механизм
		ДокументБУ = ПолучитьСвязанныйДокументБУ(пДокумент).ДокументБУ;
	
		МенеджерЗаписи.ДокументУУ = пДокумент;
		МенеджерЗаписи.ДокументБУ = ДокументБУ;
		МенеджерЗаписи.Прочитать();
		Возврат МенеджерЗаписи.Заблокирован;
		
	КонецЕсли;

КонецФункции // ДокументЗаблокирован()
 

// Заполнение счетов по соответствиям с регистра
// Параметры:
// ДокументОбъектУУ - документ объект
// ДокументОбъектБУ - документ объект
Процедура ЗаполнитьСчетаУчета(ДокументОбъектУУ, ДокументОбъектБУ, МетаданныеДокумента) Экспорт 
	
	//Получение таблицы соответствия счетов
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_СоответствиеСчетов_БУ_УУ.ИмяТабЧасти,
		|	А_СоответствиеСчетов_БУ_УУ.ИмяРеквизита,
		|	А_СоответствиеСчетов_БУ_УУ.СчетБУ,
		|	А_СоответствиеСчетов_БУ_УУ.СчетУУ
		|ИЗ
		|	РегистрСведений.А_СоответствиеСчетов_БУ_УУ КАК А_СоответствиеСчетов_БУ_УУ
		|ГДЕ
		|	А_СоответствиеСчетов_БУ_УУ.ВидДокумента = &ВидДокумента";
	
	Запрос.УстановитьПараметр("ВидДокумента", МетаданныеДокумента.Имя);
	
	ТаблицаСоответствияСчетов = Запрос.Выполнить().Выгрузить();
	
	//Обработка счетов шапки
	СтрокиСПустойТабЧастью = ТаблицаСоответствияСчетов.НайтиСтроки(Новый Структура("ИмяТабЧасти", ""));	
	ТаблицаРеквизитовШапки = ТаблицаСоответствияСчетов.Скопировать(СтрокиСПустойТабЧастью, "ИмяТабЧасти,ИмяРеквизита");
	ТаблицаРеквизитовШапки.Свернуть("ИмяТабЧасти,ИмяРеквизита");
	
	Для Каждого СтрокаРеквизита Из ТаблицаРеквизитовШапки Цикл		
		ОбработатьПоискЗаполнениеСчета(СтрокаРеквизита, ТаблицаСоответствияСчетов, ДокументОбъектБУ, ДокументОбъектУУ)		
	КонецЦикла;
	
	//Обработка счетов табличной части
	ТаблицаИменТабЧастей = ТаблицаСоответствияСчетов.Скопировать(, "ИмяТабЧасти");
	ТаблицаИменТабЧастей.Свернуть("ИмяТабЧасти");
	
	Для Каждого СтрокаТабЧасть Из ТаблицаИменТабЧастей Цикл
		
		//Табличную часть с пустым именем пропускаем
		Если Не ЗначениеЗаполнено(СтрокаТабЧасть.ИмяТабЧасти) Тогда 
			Продолжить
		КонецЕсли;		
		
		//Выбираем реквизиты текущей табличной части
		СтрокиТекущейТабЧасти = ТаблицаСоответствияСчетов.НайтиСтроки(Новый Структура("ИмяТабЧасти", СтрокаТабЧасть.ИмяТабЧасти));	
		ТаблицаИменРеквизитовТабЧасти = ТаблицаСоответствияСчетов.Скопировать(СтрокиТекущейТабЧасти, "ИмяТабЧасти,ИмяРеквизита");
		ТаблицаИменРеквизитовТабЧасти.Свернуть("ИмяТабЧасти,ИмяРеквизита");
		
		//Обходим строки табличной части
		Для Каждого СтрокаТЧ_УУ Из ДокументОбъектУУ[СтрокаТабЧасть.ИмяТабЧасти] Цикл
			
			СтрокаТЧ_БУ = ДокументОбъектБУ[СтрокаТабЧасть.ИмяТабЧасти][СтрокаТЧ_УУ.НомерСтроки - 1];
			
			//Обходим нужные реквизиты табличной части
			Для Каждого СтрокаРеквизита Из ТаблицаИменРеквизитовТабЧасти Цикл				
				ОбработатьПоискЗаполнениеСчета(СтрокаРеквизита, ТаблицаСоответствияСчетов, СтрокаТЧ_БУ, СтрокаТЧ_УУ);				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Поиск соответствия счетов БУ и УУ, и подстановка их в документ УУ
// Параметры
// СтрокаРеквизита - строка таблицы значений, в которой хранится имя реквизита и табличной части, которые в данный момент обрабатываются
// ТаблицаСоответствияСчетов - таблица значений соответствий счетов БУ и УУ
// ОбрабатываемыйОбъектБУ - обрабатываемый объект (либо сам документ объект, либо строка табличной части)
// ОбрабатываемыйОбъектУУ - обрабатываемый объект (либо сам документ объект, либо строка табличной части)
Процедура ОбработатьПоискЗаполнениеСчета(СтрокаРеквизита, ТаблицаСоответствияСчетов, ОбрабатываемыйОбъектБУ, ОбрабатываемыйОбъектУУ)
	
	СчетБУ = ОбрабатываемыйОбъектБУ[СтрокаРеквизита.ИмяРеквизита];
	
	Если Не ЗначениеЗаполнено(СчетБУ) Тогда 
		Возврат
	КонецЕсли;
			
	//Ищем по совпадению счета БУ
	СтруктураПоиска = Новый Структура("ИмяТабЧасти,ИмяРеквизита,СчетБУ", СтрокаРеквизита.ИмяТабЧасти, СтрокаРеквизита.ИмяРеквизита, СчетБУ);
	МассивНайденныхСтрок = ТаблицаСоответствияСчетов.НайтиСтроки(СтруктураПоиска);
	
	Если МассивНайденныхСтрок.Количество() <> 0 Тогда 
		
		ОбрабатываемыйОбъектУУ[СтрокаРеквизита.ИмяРеквизита] = МассивНайденныхСтрок[0].СчетУУ
		
	Иначе
		
		//Ищем по пустом счету БУ
		СтруктураПоиска = Новый Структура("ИмяТабЧасти,ИмяРеквизита,СчетБУ", СтрокаРеквизита.ИмяТабЧасти, СтрокаРеквизита.ИмяРеквизита, ПланыСчетов.Хозрасчетный.ПустаяСсылка());
		МассивНайденныхСтрок = ТаблицаСоответствияСчетов.НайтиСтроки(СтруктураПоиска);
		
		Если МассивНайденныхСтрок.Количество() <> 0 Тогда				
			ОбрабатываемыйОбъектУУ[СтрокаРеквизита.ИмяРеквизита] = МассивНайденныхСтрок[0].СчетУУ
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Заполнение, создание транслирующихся реквизитов документов БУ и УУ
// ДокументОбъектУУ - документ объект
// ДокументОбъектБУ - документ объект
// МетаданныеДокумента - метаданные документа
Процедура ЗаполнитьСвязанныеРеквизиты(ДокументОбъектУУ, ДокументОбъектБУ, МетаданныеДокумента) Экспорт 
	
	//Заполнение вида взаиморасчетов
	ЕстьРеквизитВидВзаиморасчетов = МетаданныеДокумента.Реквизиты.Найти("А_ВидВзаиморасчетов") <> Неопределено;
	
	Если ЕстьРеквизитВидВзаиморасчетов Тогда 
		ДокументОбъектУУ.А_ВидВзаиморасчетов = ПолучитьЗначениеПоУмолчанию("ВидВзаиморасчетовДляУУ")
	КонецЕсли; 
	
	//Получение транслирующихся реквизитов
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	А_НастройкиТрансляцииРеквизитов.ИмяТабЧасти,
		|	А_НастройкиТрансляцииРеквизитов.ИмяРеквизита
		|ИЗ
		|	РегистрСведений.А_НастройкиТрансляцииРеквизитов КАК А_НастройкиТрансляцииРеквизитов
		|ГДЕ
		|	А_НастройкиТрансляцииРеквизитов.ВидДокумента = &ВидДокумента";
	
	Запрос.УстановитьПараметр("ВидДокумента", МетаданныеДокумента.Имя);
	
	ТаблицаТранслирующихсяРеквизитов = Запрос.Выполнить().Выгрузить();
	
	//Обработка реквизитов шапки
	СтрокиСПустойТабЧастью = ТаблицаТранслирующихсяРеквизитов.НайтиСтроки(Новый Структура("ИмяТабЧасти", ""));	
	ТаблицаРеквизитовШапки = ТаблицаТранслирующихсяРеквизитов.Скопировать(СтрокиСПустойТабЧастью, "ИмяТабЧасти,ИмяРеквизита");
	ТаблицаРеквизитовШапки.Свернуть("ИмяТабЧасти,ИмяРеквизита");
	
	Для Каждого СтрокаРеквизита Из ТаблицаРеквизитовШапки Цикл		
		ОбработатьПоискЗаполнениеРеквизита(СтрокаРеквизита, ДокументОбъектБУ, ДокументОбъектУУ)		
	КонецЦикла;
	
	//Обработка реквизитов табличной части
	ТаблицаИменТабЧастей = ТаблицаТранслирующихсяРеквизитов.Скопировать(, "ИмяТабЧасти");
	ТаблицаИменТабЧастей.Свернуть("ИмяТабЧасти");
	
	Для Каждого СтрокаТабЧасть Из ТаблицаИменТабЧастей Цикл
		
		//Табличную часть с пустым именем пропускаем
		Если Не ЗначениеЗаполнено(СтрокаТабЧасть.ИмяТабЧасти) Тогда 
			Продолжить
		КонецЕсли;		
		
		//Выбираем реквизиты текущей табличной части
		СтрокиТекущейТабЧасти = ТаблицаТранслирующихсяРеквизитов.НайтиСтроки(Новый Структура("ИмяТабЧасти", СтрокаТабЧасть.ИмяТабЧасти));	
		ТаблицаИменРеквизитовТабЧасти = ТаблицаТранслирующихсяРеквизитов.Скопировать(СтрокиТекущейТабЧасти, "ИмяТабЧасти,ИмяРеквизита");
		ТаблицаИменРеквизитовТабЧасти.Свернуть("ИмяТабЧасти,ИмяРеквизита");
		
		//Обходим строки табличной части
		Для Каждого СтрокаТЧ_УУ Из ДокументОбъектУУ[СтрокаТабЧасть.ИмяТабЧасти] Цикл
			
			//Обходим нужные реквизиты табличной части
			Для Каждого СтрокаРеквизита Из ТаблицаИменРеквизитовТабЧасти Цикл
				
				СтрокаТЧ_БУ = ДокументОбъектБУ[СтрокаТабЧасть.ИмяТабЧасти][СтрокаТЧ_УУ.НомерСтроки - 1];
				ОбработатьПоискЗаполнениеРеквизита(СтрокаРеквизита, СтрокаТЧ_БУ, СтрокаТЧ_УУ)
				
			КонецЦикла; 
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Поиск соответствия счетов БУ и УУ, и подстановка их в документ УУ
// Параметры
// СтрокаРеквизита - строка таблицы значений, в которой хранится имя реквизита и табличной части, которые в данный момент обрабатываются
// ОбрабатываемыйОбъектБУ - обрабатываемый объект (либо сам документ объект, либо строка табличной части)
// ОбрабатываемыйОбъектУУ - обрабатываемый объект (либо сам документ объект, либо строка табличной части)
Процедура ОбработатьПоискЗаполнениеРеквизита(СтрокаРеквизита, ОбрабатываемыйОбъектБУ, ОбрабатываемыйОбъектУУ)
	
	ЗначениеРеквизитаБУ = ОбрабатываемыйОбъектБУ[СтрокаРеквизита.ИмяРеквизита];
	
	//Если реквизит не заполнен, тогда пропускаем
	Если Не ЗначениеЗаполнено(ЗначениеРеквизитаБУ) Тогда 
		Возврат
	КонецЕсли;
	
	МетаданныеОбъекта = ЗначениеРеквизитаБУ.Метаданные();
	
	//Если данные реквизита не соответствуют нужным, тогда пропускаем
	Если МетаданныеОбъекта <> Метаданные.Справочники.ДоговорыКонтрагентов
		И МетаданныеОбъекта <> Метаданные.Справочники.БанковскиеСчета
		И МетаданныеОбъекта <> Метаданные.Справочники.СотрудникиОрганизаций
		И МетаданныеОбъекта <> Метаданные.Справочники.ПодразделенияОрганизаций 
		//И МетаданныеОбъекта <> Метаданные.Справочники.Валюты	// +++ А_ИТ4Б Ересько 2016-07-27 {Закомментировал} 
		Тогда
		
		Возврат
		
	КонецЕсли;
	
	// +++ А_ИТ4Б Ересько 2016-07-27 {Закомментировал} (Начало
	//Если  МетаданныеОбъекта = Метаданные.Справочники.Валюты Тогда
	//	Если ЗначениеРеквизитаБУ <> глЗначениеПеременной("ВалютаРегламентированногоУчета") тогда		
	//		ОбрабатываемыйОбъектУУ[СтрокаРеквизита.ИмяРеквизита] =  НайтиВалютуУУ(ОбрабатываемыйОбъектУУ.Организация,ПолучитьЗначениеПоУмолчанию("ВидВзаиморасчетовДляУУВалюта"),ЗначениеРеквизитаБУ);		
	//	КонецЕсли;
	//	Возврат
	//КонецЕсли;
	// +++ А_ИТ4Б Ересько 2016-07-27 Конец) 	
	
	//Поиск соответствия объектов БУ и УУ
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	А_СоответствиеЗначенийРеквизитов_БУ_УУ.ОбъектУУ
	|ИЗ
	|	РегистрСведений.А_СоответствиеЗначенийРеквизитов_БУ_УУ КАК А_СоответствиеЗначенийРеквизитов_БУ_УУ
	|ГДЕ
	|	А_СоответствиеЗначенийРеквизитов_БУ_УУ.ОбъектБУ = &ОбъектБУ";
	
	Запрос.УстановитьПараметр("ОбъектБУ", ЗначениеРеквизитаБУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		
		//Если не нашли - создаем		
		НовыйЭлемент = ЗначениеРеквизитаБУ.Скопировать();
		
		//Физлицо затирается в процедуре ПриКопировании
		Если МетаданныеОбъекта = Метаданные.Справочники.СотрудникиОрганизаций Тогда
			НовыйЭлемент.Физлицо = ЗначениеРеквизитаБУ.Физлицо;
			НовыйЭлемент.Наименование = ЗначениеРеквизитаБУ.Наименование + " УУ";
		КонецЕсли;
		
		Для Каждого РеквизитОбъекта Из МетаданныеОбъекта.Реквизиты Цикл
			
			Если РеквизитОбъекта.Тип.СодержитТип(Тип("СправочникСсылка.Организации"))
				И ТипЗнч(ЗначениеРеквизитаБУ[РеквизитОбъекта.Имя]) = Тип("СправочникСсылка.Организации") Тогда					
				НовыйЭлемент[РеквизитОбъекта.Имя] = ПолучитьОрганизациюУУ(ЗначениеРеквизитаБУ[РеквизитОбъекта.Имя])					
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого РеквизитОбъекта Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			
			Если РеквизитОбъекта.Тип.СодержитТип(Тип("СправочникСсылка.Организации")) 
				И ТипЗнч(ЗначениеРеквизитаБУ[РеквизитОбъекта.Имя]) = Тип("СправочникСсылка.Организации") Тогда					
				НовыйЭлемент[РеквизитОбъекта.Имя] = ПолучитьОрганизациюУУ(ЗначениеРеквизитаБУ[РеквизитОбъекта.Имя])					
			КонецЕсли;
			
		КонецЦикла;
		
		Если МетаданныеОбъекта = Метаданные.Справочники.ДоговорыКонтрагентов Тогда 
			НовыйЭлемент.ВидВзаиморасчетов = ПолучитьЗначениеПоУмолчанию("ВидВзаиморасчетовДляУУ");
			// +++ А_ИТ4Б Ересько 2016-07-27 {Закомментировал} (Начало 
			//Попытка
			//	Если ЗначениеРеквизитаБУ.ВалютаВзаиморасчетов <> глЗначениеПеременной("ВалютаРегламентированногоУчета") тогда	
			//		НовыйЭлемент.ВалютаВзаиморасчетов = НайтиВалютуУУ(НовыйЭлемент.Организация,ПолучитьЗначениеПоУмолчанию("ВидВзаиморасчетовДляУУВалюта"),ЗначениеРеквизитаБУ.ВалютаВзаиморасчетов);
			//		НовыйЭлемент.ВидВзаиморасчетов = ПолучитьЗначениеПоУмолчанию("ВидВзаиморасчетовДляУУВалюта");
			//	КонецЕсли;
			//Исключение
			//КонецПопытки;
			// +++ А_ИТ4Б Ересько 2016-07-27 Конец)
			НовыйЭлемент.СхемаНалоговогоУчета = ПолучитьЗначениеПоУмолчанию("СхемаНалоговогоУчетаПоОтгрузке");
		КонецЕсли;
		
		// +++ А_ИТ4Б Ересько 2016-07-27 {Закомментировал} (Начало
		Если МетаданныеОбъекта = Метаданные.Справочники.БанковскиеСчета Тогда
		//	Попытка
		//		Если ЗначениеРеквизитаБУ.ВалютаДенежныхСредств <> глЗначениеПеременной("ВалютаРегламентированногоУчета") тогда	
		//			НовыйЭлемент.ВалютаДенежныхСредств= НайтиВалютуУУ(ОбрабатываемыйОбъектУУ.Организация,ПолучитьЗначениеПоУмолчанию("ВидВзаиморасчетовДляУУВалюта"),ЗначениеРеквизитаБУ.ВалютаДенежныхСредств);
		//		КонецЕсли;
		//	Исключение
		//	КонецПопытки;
			// А_Вячеслав(21.11.2018 
			НовыйЭлемент.Родитель = Неопределено;
			// А_Вячеслав) 
		
		КонецЕсли;
		// +++ А_ИТ4Б Ересько 2016-07-27 Конец)
		
		Если МетаданныеОбъекта = Метаданные.Справочники.ПодразделенияОрганизаций Тогда 
			
			Если ЗначениеЗаполнено(ЗначениеРеквизитаБУ.Родитель) Тогда 
				
				СтрокаРеквизитаВладелец = Новый Структура("ИмяРеквизита", "Родитель");
				
				ОбработатьПоискЗаполнениеРеквизита(СтрокаРеквизитаВладелец, ЗначениеРеквизитаБУ, НовыйЭлемент)
				
			КонецЕсли;
			
		КонецЕсли;
		
		НовыйЭлемент.Записать();
		ЗначениеРеквизитаУУ = НовыйЭлемент.Ссылка; 
		
		ЗаписатьСоответствиеЗначенийРеквизитов_БУ_УУ(ЗначениеРеквизитаБУ, ЗначениеРеквизитаУУ);
		
		ОбрабатываемыйОбъектУУ[СтрокаРеквизита.ИмяРеквизита] = ЗначениеРеквизитаУУ
		
	Иначе			
		
		//Если нашли подставляем
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();		
		ВыборкаДетальныеЗаписи.Следующий();
		
		ОбрабатываемыйОбъектУУ[СтрокаРеквизита.ИмяРеквизита] = ВыборкаДетальныеЗаписи.ОбъектУУ			
		
	КонецЕсли;
	
КонецПроцедуры 

// Поиск реквизитов с типом Документ
//Возвращаем массив таких реквизитов
// ДокументОбъектУУ - документ объект
// ДокументОбъектБУ - документ объект
// МетаданныеДокумента - метаданные документа
Процедура ВыполнитьТрансляциюДокументов(ДокументОбъектУУ, ДокументОбъектБУ, МетаданныеДокумента) Экспорт
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСДокументами(МетаданныеДокумента.Реквизиты);
	
	Для Каждого РеквизитДокумента Из МассивРеквизитов Цикл
		
		Если ЗначениеЗаполнено(ДокументОбъектУУ[РеквизитДокумента]) Тогда 
		
			СтруктураДанных = ПолучитьСвязанныйДокументУУ(ДокументОбъектУУ[РеквизитДокумента]);
				
			Если СтруктураДанных.ДокументУУ <> Неопределено Тогда					
				ДокументОбъектУУ[РеквизитДокумента] = СтруктураДанных.ДокументУУ					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	МассивРеквизитов = ПолучитьМассивРеквизитовСДокументами(МетаданныеДокумента.СтандартныеРеквизиты);
	
	Для Каждого РеквизитДокумента Из МассивРеквизитов Цикл
		
		Если ЗначениеЗаполнено(ДокументОбъектУУ[РеквизитДокумента]) Тогда 
		
			СтруктураДанных = ПолучитьСвязанныйДокументУУ(ДокументОбъектУУ[РеквизитДокумента]);
				
			Если СтруктураДанных.ДокументУУ <> Неопределено Тогда					
				ДокументОбъектУУ[РеквизитДокумента] = СтруктураДанных.ДокументУУ					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого ТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
		МассивРеквизитов = ПолучитьМассивРеквизитовСДокументами(ТЧ.Реквизиты);
		
		Для Каждого СтрокаТЧ Из ДокументОбъектУУ[ТЧ.Имя] Цикл
			
			Для Каждого РеквизитДокумента Из МассивРеквизитов Цикл
				
				Если ЗначениеЗаполнено(СтрокаТЧ[РеквизитДокумента]) Тогда 
					
					СтруктураДанных = ПолучитьСвязанныйДокументУУ(СтрокаТЧ[РеквизитДокумента]);
					
					Если СтруктураДанных.ДокументУУ <> Неопределено Тогда					
						СтрокаТЧ[РеквизитДокумента] = СтруктураДанных.ДокументУУ					
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМассивРеквизитовСДокументами(ОбъектСРеквизитами)
	
	МассивРеквизитов = Новый Массив;
	
	Для Каждого РеквизитОбъекта Из ОбъектСРеквизитами Цикл
		
		Если РеквизитОбъекта.Имя = "Ссылка" Тогда 
			Продолжить
		КонецЕсли;
		
		ЭтоДокумент = Ложь;
			
		ТипыРеквизита = РеквизитОбъекта.Тип.Типы();
		
		Если ТипыРеквизита.Количество() > 1 Тогда 
			
			Для Каждого СтрокаМассиваТип Из ТипыРеквизита Цикл
				
				ТипРеквизита = Метаданные.НайтиПоТипу(СтрокаМассиваТип);
				
				Если ТипРеквизита = Неопределено Тогда 
					Продолжить;
				КонецЕсли;
				
				ПолноеИмяТипа = ТипРеквизита.ПолноеИмя();
				ТипОбъект = Лев(ПолноеИмяТипа, Найти(ПолноеИмяТипа,".") - 1);
				
				Если ТипОбъект = "Документ" Тогда 
					ЭтоДокумент = Истина;
					Прервать
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе 
			
			ТипРеквизита = Метаданные.НайтиПоТипу(ТипыРеквизита[0]);
			
			Если ТипРеквизита = Неопределено Тогда 
				Продолжить
			КонецЕсли;
			
			ПолноеИмяТипа = ТипРеквизита.ПолноеИмя();
			ТипОбъект = Лев(ПолноеИмяТипа, Найти(ПолноеИмяТипа,".") - 1);
			
			Если ТипОбъект = "Документ" Тогда 
				ЭтоДокумент = Истина
			КонецЕсли;
			
		КонецЕсли;
		 
		Если ЭтоДокумент Тогда			
			МассивРеквизитов.Добавить(РеквизитОбъекта.Имя)			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРеквизитов;
	
КонецФункции


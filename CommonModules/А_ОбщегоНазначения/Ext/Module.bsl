// Процедура срабатывает при открытии форм документов и справочников. Позволяет выполнить 
//определенные действия не ломая текст стандартных модулей форм.
//
Процедура ПриОткрытииФормыДокументаСправочника(МетаданныеОбъекта, ФормаОбъекта) Экспорт  
	
	Если МетаданныеОбъекта.Имя = "Организации" Тогда		
		ПриОткрытии_Организации(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "Пользователи" Тогда		
		ПриОткрытии_Пользователи(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "ПеремещениеТоваров" Тогда
		ПриОткрытии_ПеремещениеТоваров(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "СписаниеТоваров" Тогда
		ПриОткрытии_СписаниеТоваров(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "ОприходованиеТоваров" Тогда
		ПриОткрытии_ОприходованиеТоваров(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "НачислениеЗарплатыРаботникамОрганизаций" Тогда
		ПриОткрытии_НачислениеЗарплатыРаботникамОрганизаций(МетаданныеОбъекта, ФормаОбъекта)	
	ИначеЕсли МетаданныеОбъекта.Имя = "ЗарплатаКВыплатеОрганизаций" Тогда
		ПриОткрытии_ЗарплатаКВыплатеОрганизаций(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "ПоступлениеТоваровУслуг" Тогда
		ПриОткрытии_ПоступлениеТоваровУслуг(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "РеализацияТоваровУслуг" Тогда
		ПриОткрытии_РеализацияТоваровУслуг(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "НалоговаяНакладная" Тогда
		ПриОткрытии_НалоговаяНакладная(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "Приложение2КНалоговойНакладной" Тогда
		ПриОткрытии_Приложение2КНалоговойНакладной(МетаданныеОбъекта, ФормаОбъекта)
	ИначеЕсли МетаданныеОбъекта.Имя = "ПоступлениеДопРасходов" Тогда
		ПриОткрытии_ПоступлениеДопРасходов(МетаданныеОбъекта, ФормаОбъекта)
	КонецЕсли;
	
	ДобавитьКнопкуБлокировкиДокументаУУ(МетаданныеОбъекта, ФормаОбъекта);
	// А_Вячеслав(29.08.2017 
	ДобавитьКнопкуБлокировкиДокументаБУ(МетаданныеОбъекта, ФормаОбъекта);
	// А_Вячеслав) 
	
КонецПроцедуры

Процедура ПриОткрытии_Организации(МетаданныеОбъекта, ФормаОбъекта) 

	ЭлементыФормы = ФормаОбъекта.ЭлементыФормы;
	
	//Добавление флага УУ
	Если Истина Тогда 
		
		// Добавление флага "УУ"
		СтруктураСвойств = Новый Структура();
		СтруктураСвойств.Вставить("Высота", 19); 
		СтруктураСвойств.Вставить("Ширина", 35); 
		СтруктураСвойств.Вставить("Верх", 56);
		СтруктураСвойств.Вставить("Лево", 327);
		СтруктураСвойств.Вставить("Заголовок", "УУ");
		СтруктураСвойств.Вставить("Данные", "А_УправленческийУчет");
		СтруктураСвойств.Вставить("ИзменяетДанные", Истина);
		СтруктураСвойств.Вставить("ТолькоПросмотр", Ложь);
		
		СтруктураПривязок 			= Новый Структура();
		ТекущиеЗначенияПривязки 	= Новый Структура();
		
		//Левая граница
		ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.Префикс);	
		ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Право);
		
		СтруктураЗначенияПривязки 	= Новый Структура("Элемент, Граница, Элемент2, Граница2");
		ЗаполнитьЗначенияСвойств(СтруктураЗначенияПривязки, ТекущиеЗначенияПривязки);
		СтруктураПривязок.Вставить("Лево", СтруктураЗначенияПривязки);
		
		//Правая граница
		ТекущиеЗначенияПривязки.Вставить("Элемент", ЭлементыФормы.Префикс);	
		ТекущиеЗначенияПривязки.Вставить("Граница", ГраницаЭлементаУправления.Лево);
						

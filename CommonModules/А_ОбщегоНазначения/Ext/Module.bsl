Функция ПолучитьЗначениеПоУмолчанию(ИмяЗначения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияПоУмолчанию.ЗначениеПоУмолчанию
	               |ИЗ
	               |	РегистрСведений.А_ЗначенияПоУмолчанию КАК ЗначенияПоУмолчанию
	               |ГДЕ
	               |	ЗначенияПоУмолчанию.ИмяЗначения = &ИмяЗначения";
	
	Запрос.УстановитьПараметр("ИмяЗначения", ИмяЗначения);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ЗначениеПоУмолчанию;
	

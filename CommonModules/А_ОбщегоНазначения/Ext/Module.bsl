Функция ПолучитьЗначениеПоУмолчаниюСУстановкой(пИмяЗначения,пЗначениеПоУмолчанию = Неопределено) Экспорт

	Если ПустаяСтрока(пИмяЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	лЗначение = А_ОбщегоНазначения.ПолучитьЗначениеПоУмолчанию(пИмяЗначения);
	Если лЗначение = Неопределено И НЕ пЗначениеПоУмолчанию = Неопределено Тогда
		Попытка
			лЗначение = пЗначениеПоУмолчанию;
			А_ОбщегоНазначения.УстановитьЗначениеПоУмолчанию(пИмяЗначения,пЗначениеПоУмолчанию);	
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Установлено значение по умолчанию: "+пИмяЗначения+" = "+пЗначениеПоУмолчанию;
			Сообщение.Сообщить(); 
		Исключение
		    Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Произошла ошибка при установке значения по умолчанию: "+пИмяЗначения;
			Сообщение.Сообщить(); 
		КонецПопытки; 
	КонецЕсли;	
	Возврат лЗначение;

КонецФункции // ()
 

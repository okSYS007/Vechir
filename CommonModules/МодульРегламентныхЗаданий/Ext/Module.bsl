Процедура ВыполнитьОбменССайтом() Экспорт

	УзелОбмена = Константы.УзелОбменаССайтом.Получить();
	Если НЕ ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	МассивНеНайденных = Новый Массив;
	
	Выборка = ПланыОбмена.ВыбратьИзменения(УзелОбмена, 1);
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Получить();
		
		Если ТипЗнч(Объект) = Тип("СправочникОбъект.ХранилищеДополнительнойИнформации") Тогда
			
			Номенклатура = Объект.Объект;
			Если НЕ МассивНеНайденных.Найти(Номенклатура) = Неопределено Тогда
				Продолжить;			
			КонецЕсли; 
			
			Картинка = Объект.Ссылка;
			Выгружена = ОбменССайтом.ВыгрузитьИзображениеНаСайт(УзелОбмена, Картинка);			
			Если Выгружена Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Картинка);			
			Иначе
				МассивНеНайденных.Добавить(Номенклатура);
			КонецЕсли;		
			
		ИначеЕсли ТипЗнч(Объект) = Тип("СправочникОбъект.Номенклатура") Тогда 	
			
			Номенклатура = Объект.Ссылка;
			Выгружена = ОбменССайтом.ВыгрузитьБрендНоменклатуы(УзелОбмена, Номенклатура);
			Если Выгружена Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Номенклатура);		
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.УстановкаЦенНоменклатуры") Тогда 	
			
			УстановкаЦен = Объект.Ссылка;
			Выгружена = ОбменССайтом.ВыгрузитьУстановкуЦен(УзелОбмена, УстановкаЦен);
			Если Выгружена Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, УстановкаЦен);		
			КонецЕсли;	
			
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры


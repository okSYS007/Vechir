Процедура ЗаполнитьТоварыССайта(ИдентификаторСессии) 
	
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("Cerebro");
	Url = СтрПодключение.Адрес;
	
	Соединение = Новый HTTPСоединение(Url,443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	
	ТЗТоварыИзБазы = ПолучитьТоварыИзБазы1с();
	
	ТЗССайта = Новый ТаблицаЗначений;
	
	сч = 0;
	
	Для Каждого НовСтр из ТЗТоварыИзБазы Цикл
		сч = сч+1;
		
		Таймаут();
		
		HTTPЗапрос = Новый HTTPЗапрос("/product/" + НовСтр.productID + "/" + ИдентификаторСессии, Заголовки);
		
		Ответ 	= Соединение.Получить(HTTPЗапрос);	
		мОтвет 	= Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("Cerebro", УровеньЖурналаРегистрации.Ошибка,,, мОтвет);
			НовСтр.Ответ = 1; 
			Продолжить;
		КонецЕсли;
		
		ЗначениеУзла = "";
		МаксимальныйОстаток = "";
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(мОтвет); //сделал именно так, т.к. возвращают не читаемую структуру json. например stocks: [253].
		МаксимальныйОстаток = "";
		
		Пока ЧтениеJSON.Прочитать() Цикл
			
			ТипЗначения = ЧтениеJSON.ТипТекущегоЗначения;
			
			Если ТипЗначения = ТипЗначенияJSON.НачалоОбъекта Тогда
				
				Если ЗначениеЗаполнено(ЗначениеУзла)  //возвращает не правильный json. тут должен быть массив, а возвращает как новый объект { }
					И ЗначениеУзла <> "available" 
					И ЗначениеУзла <> "result" 
					И ЗначениеУзла <> "stocks_expected" 
					Тогда
					//НовСтр = ТЗТовары.Добавить();
				КонецЕсли;
				
			ИначеЕсли ТипЗначения = ТипЗначенияJSON.НачалоМассива Тогда
			ИначеЕсли ТипЗначения = ТипЗначенияJSON.ИмяСвойства
				ИЛИ ТипЗначения = ТипЗначенияJSON.Строка
				ИЛИ ТипЗначения = ТипЗначенияJSON.Число
				ИЛИ ТипЗначения = ТипЗначенияJSON.Булево
				ИЛИ ТипЗначения = ТипЗначенияJSON.Null Тогда
				
				Значение = ЧтениеJSON.ТекущееЗначение;
				
				Если  ТипЗначения = ТипЗначенияJSON.Строка И ЗначениеЗаполнено(Значение) И СтрЗаменить(Значение, "*", "") = "" Тогда
					
					Если МаксимальныйОстаток < Значение Тогда
						МаксимальныйОстаток = Значение;
					КонецЕсли;
					
					Если СтрДлина(МаксимальныйОстаток) > 2 Тогда 
						НовСтр.Количество = 100;
					ИначеЕсли СтрДлина(МаксимальныйОстаток) > 1 Тогда 
						НовСтр.Количество = 10;
					ИначеЕсли СтрДлина(МаксимальныйОстаток) > 0 Тогда 
						НовСтр.Количество = 1;
					КонецЕсли; 
					
				КонецЕсли;
				
				Если ЗначениеУзла = "retail_price_uah" Тогда
					//Число = Число(Значение);
					Если не ЗначениеЗаполнено(Значение) Тогда 
							НовСтр.price_uah = 0;
					Иначе
						НовСтр.price_uah = Значение;

					КонецЕсли;;
					
					НовСтр.price_uah = Значение;
				КонецЕсли;
				
				Если ЗначениеУзла = "price_uah" Тогда
					
					Если не ЗначениеЗаполнено(Значение) Тогда 
						
						НовСтр.dealer_price_uah = 0;
					Иначе
						НовСтр.dealer_price_uah = Значение;

					КонецЕсли;;
					
				КонецЕсли;
				
				ЗначениеУзла = ЧтениеJSON.ТекущееЗначение;                                                           
				
			КонецЕсли;			
		КонецЦикла;
		Если сч = 100 Тогда 
			
			
			СоздатьУстановкуЦен(ТЗТоварыИзБазы);
			
			сч = 0;
		КонецЕсли;
		
		ЧтениеJSON.Закрыть();
	КонецЦикла;	
	
	ДобавитьЗаписиПоОстаткам(ТЗТоварыИзБазы);
	СоздатьУстановкуЦен(ТЗТоварыИзБазы);
	
КонецПроцедуры


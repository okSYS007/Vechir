		Возврат;
	КонецЕсли;
	
	Токен = ПланыОбмена.Website.НайтиПоНаименованию("vstore.net.ua").Токен;
	
	Если ЗначениеЗаполнено(стрПодключения.Логин)
		ИЛИ ЗначениеЗаполнено(стрПодключения.Пароль) Тогда
		Соединение = Новый HTTPСоединение(стрПодключения.Адрес,,стрПодключения.Логин,стрПодключения.Пароль,,,Новый ЗащищенноеСоединениеOpenSSL());
	Иначе
		Соединение = Новый HTTPСоединение(стрПодключения.Адрес,,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Запрос = Новый HTTPЗапрос("/index.php?route=api/order_1c&token=" + Токен, Заголовки);
	
	Ответ = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния = 200 Тогда
		ЧтениеJSON 	= Новый ЧтениеJSON;
		стрJSON 	= Ответ.ПолучитьТелоКакСтроку();
		ЧтениеJSON.УстановитьСтроку(стрJSON);
		Попытка
			СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			ЗаписьЖурналаРегистрации("Заказы API",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось прочитать JSON");
			ЧтениеJSON.Закрыть();
			Возврат;
		КонецПопытки;
		ЧтениеJSON.Закрыть();
	Иначе
		ЗаписьЖурналаРегистрации("Заказы API", УровеньЖурналаРегистрации.Ошибка,,,"Код состояния " + Ответ.КодСостояния);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(СтруктураJSON) <> Тип("Массив") Тогда
		ЗаписьЖурналаРегистрации("Заказы API", УровеньЖурналаРегистрации.Ошибка,,,"Структура JSON не массив");
		Возврат;
	КонецЕсли;
	
	Соединение.Удалить(Запрос);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СвойстваОбъектов.Ссылка КАК Свойство
	|ИЗ
	|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
	|ГДЕ
	|	СвойстваОбъектов.НазначениеСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Документ_ЗаказПокупателя)
	|	И СвойстваОбъектов.Наименование = ""Способ оплаты""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СвойствоОплаты = ?(РезультатЗапроса.Пустой(), Неопределено, РезультатЗапроса.Выгрузить()[0].Свойство);
	
	СоответствиеСтатусов = Новый Соответствие;
	СоответствиеСтатусов.Вставить("Нове", Перечисления.СтатусыЗаказаИМ.НовыйЗаказ);
	СоответствиеСтатусов.Вставить("Новий (оплачений)", Перечисления.СтатусыЗаказаИМ.НовоеОплачено);
	
	Для Каждого СтрДанные из СтруктураJSON Цикл
		
		Заказ = НайтиЗаказПоOrderID(СтрДанные.order.order_id);
		Если Заказ = Неопределено Тогда
			ЗаказОб = Документы.ЗаказПокупателя.СоздатьДокумент();
		Иначе
			ЗаказОб = Заказ.ПолучитьОбъект();	
			
			Если ЗаказОб.Проведен Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаказОб.OrderID				= СтрДанные.order.order_id;
		ЗаказОб.Дата 				= СериализаторXDTO.XMLЗначение(Тип("Дата"),СтрДанные.order.order_date);
		ЗаказОб.ВалютаДокумента 	= Справочники.Валюты.НайтиПоНаименованию("грн");
		ЗаказОб.ВидОперации 		= Перечисления.ВидыОперацийЗаказПокупателя.ПродажаКомиссия;
		ЗаказОб.Проект 				= Справочники.Проекты.НайтиПоКоду("S00000085");
		ЗаказОб.Подразделение 		= Справочники.Подразделения.НайтиПоКоду("000000242");//Интернет магазин
		//ЗаказОб.Комментарий 		= "№ " + СтрДанные.order.order_id + " vstore.net.ua: "+ СтрДанные.order.order_id + Символы.ПС
		//+?(ЗначениеЗаполнено(СтрДанные.order.customer.phone),"Тел.: " + СтрДанные.order.customer.phone, "") + Символы.ПС
		//+?(ЗначениеЗаполнено(СтрДанные.order.customer.name),"Имя: "+ СтрДанные.order.customer.name, "") + Символы.ПС
		//+"Адрес: "+ СтрДанные.order.customer.address.country + ", " + СтрДанные.order.customer.address.city + ", " + СтрДанные.order.customer.address.street + Символы.ПС
		//+"Метод платежа: " + СтрДанные.order.payment.payment_id + Символы.ПС
		//+"Разом: " + СтрДанные.order.payment.amount + Символы.ПС
		//+"Комментарий: " + СтрДанные.order.comment;
		
		ЗаказОб.Комментарий = "vstore.net.ua:" + "№ " + СтрДанные.order.order_id + " " + СтрДанные.order.comment;
		ЗаказОб.ДатаОплаты 		= СериализаторXDTO.XMLЗначение(Тип("Дата"),СтрДанные.order.payment.paid_at);
		ЗаказОб.Ответственный 	= глЗначениеПеременной("глТекущийПользователь");
		ЗаказОб.КурсВзаиморасчетов = 1;
		ЗаказОб.КратностьВзаиморасчетов = 1;
				
		Если СтрДанные.order.payment.payment_id  = "Безготівковий розрахунок" Тогда
			ЗаказОб.БезналичныйРасчет = Истина;
		КонецЕсли;
		
		Если СоответствиеСтатусов[СтрДанные.order.payment.status] <> Неопределено Тогда
			ЗаказОб.СтатусИМ = СоответствиеСтатусов[СтрДанные.order.payment.status];	
		КонецЕсли;
		
		ПривестиТелефонКНужномуФормату(СтрДанные.order.customer);
		
		Контрагент					= ПолучитьСоздатьКонтрагента(СтрДанные.order.customer);
		Организация 				= ПолучитьОрганизацию(СтрДанные.order.payment, СтрДанные.order.delivery, Контрагент);
		Договор                 	= ПолучитьСоздатьДоговорКонтрагента(Организация, Контрагент, ЗаказОб.ВалютаДокумента);
		
		ЗаказОб.Организация			= Организация;
		ЗаказОб.Контрагент 			= Контрагент;
		ЗаказОб.ДоговорКонтрагента	= Договор; 
		ЗаказОб.ППКСтрокой 			= СтрДанные.order.customer.uid;
		
		ЗаказОб.СпособОплаты 		= СтрДанные.order.payment.payment_id;
		ЗаказОб.СпособДоставки		= СтрДанные.order.delivery.method;
		
		ЗаказОб.НомерСЗаказа		= СтрДанные.order.customer.phone;
		
// н ЛИВ           
		//Дандали В. 22.12.2025 +
		СтрПлательщикНаименование 	= СтрЗаменить(СтрДанные.order.payment.cashless_payment_data.phisical_name, "&quot;", """");
		СтрПлательщикКонтакт		= СтрЗаменить(СтрДанные.order.customer.name, "&quot;", """");
		//Дандали В. 22.12.2025 -
		
		ЗаказОб.ПлательщикНаименование 	= СтрПлательщикНаименование;
		ЗаказОб.ПлательщикКодЕДРПОУ		= Строка(СтрДанные.order.payment.cashless_payment_data.edrpou_code);
		ЗаказОб.ПлательщикКонтакт		= СтрПлательщикКонтакт;
// к ЛИВ		
		
		ИдентифицироватьНоменклатуру(СтрДанные.order.items, ЗаказОб);
		
		Если ЗаказОб.Товары.Количество() + ЗаказОб.Услуги.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации("Заказы API", УровеньЖурналаРегистрации.Ошибка,,,"Не заполнены табличные части товары и услуги "+ СтрДанные.order.order_id);
			Продолжить;	
		КонецЕсли;
		
		Если ЗаказОб.БезналичныйРасчет Тогда
			
			ЗаказОб.УчитыватьНДС 		= Истина;
			ЗаказОб.СуммаВключаетНДС 	= Истина;
			ЗаказОб.АвторасчетНДС		= Истина;
			
			Для Каждого стрТовар из ЗаказОб.Товары Цикл
				стрТовар.ставкаНДС = Перечисления.СтавкиНДС.НДС20;
			КонецЦикла;
			
		КонецЕсли;
		
		ЗаказОб.Записать(РежимЗаписиДокумента.Запись);
		ЗаказОб = ЗаказОб.Ссылка.ПолучитьОбъект();
		Попытка
			ЗаказОб.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить(ОписаниеОшибки());
			ЗаписьЖурналаРегистрации("Заказы API", УровеньЖурналаРегистрации.Ошибка,,,"Не удалось провести документ "+ СтрДанные.order.order_id);
		КонецПопытки;
		
		Если ЗаказОб.СтатусИМ = Перечисления.СтатусыЗаказаИМ.НовоеОплачено Тогда
			СоздатьЧек(ЗаказОб.Ссылка);	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПривестиТелефонКНужномуФормату(ДанныеКонтрагента)
	
	ИсходнаяСтрока = ДанныеКонтрагента.phone;
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, "(", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, ")", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, "-", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, " ", "");
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, Символы.НПП, "");
	
	ДлинаИсходнойСтроки = СтрДлина(ИсходнаяСтрока);
	Цифры = "0123456789+";
	ЧислоСтрокой = ""; 
	
	МожноРедактировать = Истина;
	Для НомерСимвола = 1 по ДлинаИсходнойСтроки Цикл
		//Считываем очередной символ из исходной строки
		СимволИсходнойСтроки = Сред(ИсходнаяСтрока,НомерСимвола,1);   
				
		Если Найти(Цифры, СимволИсходнойСтроки) <> 0 Тогда
			//Собираем число из цифр в строку
			ЧислоСтрокой = ЧислоСтрокой + СимволИсходнойСтроки; 
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если ЧислоСтрокой <> "" 
		И МожноРедактировать Тогда
		
		ЧислоСтрокой = СтрЗаменить(ЧислоСтрокой, "+", "");
		Если Лев(ЧислоСтрокой, 1) = "3" Тогда
			ЧислоСтрокой = Сред(ЧислоСтрокой, 2, СтрДлина(ЧислоСтрокой)); 	
		КонецЕсли;
		Если Лев(ЧислоСтрокой, 1) = "8" Тогда
			ЧислоСтрокой = Сред(ЧислоСтрокой, 2, СтрДлина(ЧислоСтрокой)); 	
		КонецЕсли;
		
		Если СтрДлина(ЧислоСтрокой) < 10 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеКонтрагента.phone = ЧислоСтрокой;
	
КонецПроцедуры

Функция НайтиЗаказПоOrderID(OrderID) 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПокупателя.Ссылка КАК Заказ
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.OrderID = &OrderID";
	
	Запрос.УстановитьПараметр("OrderID", OrderID);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Заказ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьОрганизацию(Оплата, Доставка, Контрагент)
	
	ОрганизацияВЕЧЕР 	= Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")); //Вечир ТОВ					
	
	Если Доставка.method = "Доставка у відділення Нової пошти"
		И Оплата.payment_id = "Оплата при отримані готівкою" Тогда 
		
		Возврат ОрганизацияВЕЧЕР;
		
	КонецЕсли;
	
	Менеджер 			    = РегистрыСведений.СпособыДоставкиОрганизации.СоздатьМенеджерЗаписи();
	Менеджер.СпособДоставки = Оплата.payment_id;
	Менеджер.Прочитать();
	
	Если ЗначениеЗаполнено(Менеджер.Организация)
		и ЗначениеЗаполнено(Контрагент) Тогда 
		
		Возврат Менеджер.Организация;
	КонецЕсли;
	
	Возврат ОрганизацияВЕЧЕР
	
КонецФункции

Функция ПолучитьСоздатьКонтрагента(ДанныеКонтрагента)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", ДанныеКонтрагента.name);
	Запрос.УстановитьПараметр("НомерТелефона", ДанныеКонтрагента.phone);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	(Контрагенты.Наименование = &Наименование
	|			И Контрагенты.НомерТелефона = &НомерТелефона)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КонтрагентСсылка = Выборка.Контрагент;
	Иначе
		КонтрагентСсылка = СоздатьКонтрагента(ДанныеКонтрагента);
	КонецЕсли;
		
	Возврат КонтрагентСсылка;
	
КонецФункции

Функция СоздатьКонтрагента(СтруктураДанныхКонтрагента)
	
	НовыйКонтрагент 					= Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Родитель 			= Справочники.Контрагенты.НайтиПоНаименованию("Абоненти");
	НовыйКонтрагент.Наименование 		= СтруктураДанныхКонтрагента.name;	
	НовыйКонтрагент.НаименованиеПолное 	= СтруктураДанныхКонтрагента.name;
	НовыйКонтрагент.Покупатель 			= Истина;
	НовыйКонтрагент.НомерТелефона		= СтруктураДанныхКонтрагента.phone;
	Попытка
		НовыйКонтрагент.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;	
	
	КонтрагентСсылка = НовыйКонтрагент.Ссылка;
	
	//Адрес
	НаборКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборКИ.отбор.Объект.Установить(КонтрагентСсылка);
	НаборКИ.отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Адрес);
	НаборКИ.отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
	
	СтрокаКи 		= НаборКИ.Добавить();
	СтрокаКи.Объект = КонтрагентСсылка;
	СтрокаКи.Тип 	= Перечисления.ТипыКонтактнойИнформации.Адрес;
	СтрокаКи.Вид 	= Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
	
	СтрокаКи.Представление = "Україна , "+ СтруктураДанныхКонтрагента.address.city + ", " + СтруктураДанныхКонтрагента.address.street;
	
	Попытка
		НаборКИ.Записать();
	Исключение
	КонецПопытки;
	
	//Телефон
	НаборКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборКИ.отбор.Объект.Установить(КонтрагентСсылка);
	НаборКИ.отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Телефон);
	НаборКИ.отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	
	СтрокаКи 			= НаборКИ.Добавить();
	СтрокаКи.Объект 	= КонтрагентСсылка;
	СтрокаКи.Тип 		= Перечисления.ТипыКонтактнойИнформации.Телефон;
	СтрокаКи.Вид 		= Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
	
	СтрокаКи.Представление = СтруктураДанныхКонтрагента.phone;
	
	НаборКИ.Записать();
	
	Попытка
		НаборКИ.Записать();
	Исключение
	КонецПопытки;
	
	//email
	НаборКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборКИ.отбор.Объект.Установить(КонтрагентСсылка);
	НаборКИ.отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	НаборКИ.отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами);
	
	СтрокаКи 			= НаборКИ.Добавить();
	СтрокаКи.Объект 	= КонтрагентСсылка;
	СтрокаКи.Тип 		= Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	СтрокаКи.Вид 		= Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами;
	
	СтрокаКи.Представление = СтруктураДанныхКонтрагента.email;
	
	НаборКИ.Записать();
	
	Попытка
		НаборКИ.Записать();
	Исключение
	КонецПопытки;
	
	Возврат НовыйКонтрагент.Ссылка;
	
КонецФункции	

Функция ПолучитьСоздатьДоговорКонтрагента(Организация, Контрагент, Валюта)
	
	Если НЕ ЗначениеЗаполнено(Организация) 
		ИЛИ НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ищем договр по контрагенту, организации и валюте
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	               |	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Организация = &Организация
	               |	И ДоговорыКонтрагентов.ВедениеВзаиморасчетов = ЗНАЧЕНИЕ(Перечисление.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам)
	               |	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	               |	И ДоговорыКонтрагентов.Владелец = &Владелец";
				   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Владелец", Контрагент);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекущийДоговор = Неопределено;
	
	ВалютаВзаиморасчетов = Валюта;
		
	Если НЕ ЗначениеЗаполнено(ВалютаВзаиморасчетов) Тогда
		ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаУправленческогоУчета");
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		ТекущийДоговор = Выборка.Ссылка;
		Если Выборка.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
    	
	Если НЕ ЗначениеЗаполнено(ТекущийДоговор) Тогда
		
		ТекущийДоговор = СоздатьДоговорПоПараметрам(Контрагент, Организация, ВалютаВзаиморасчетов);
		
		Если Не ЗначениеЗаполнено(ТекущийДоговор) Тогда
			Возврат Ложь;
		КонецЕсли;	
				
	КонецЕсли;
	
	Попытка
		
		КонтрагентОбъект = Контрагент.ПолучитьОбъект();
		КонтрагентОбъект.ОсновнойДоговорКонтрагента = ТекущийДоговор;
		КонтрагентОбъект.Записать();
		
	Исключение
	КонецПопытки;		
		
	Возврат ТекущийДоговор;
	
КонецФункции

Функция СоздатьДоговорПоПараметрам(Контрагент, Организация, ВалютаВзаиморасчетов)
	
	НайденныйДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();

#Область ТоварыАпи

Процедура ОбменТоварамиАпи() Экспорт
	
	СтрДанныеДляОтправки = СобратьДанныеДляОтправки();
	Если СтрДанныеДляОтправки.products.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассВозврата = Новый Массив;
	СтрВозврата = Новый Структура;
	СтрВозврата.Вставить("token", ПланыОбмена.Website.НайтиПоНаименованию("vstore.net.ua").Токен);
	СтрВозврата.Вставить("products", СтрДанныеДляОтправки.products);
	
	МассВозврата.Добавить(СтрВозврата);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассВозврата);
	СтрJSON = ЗаписьJSON.Закрыть();
	
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("vstore.net.ua");
	Url = СтрПодключение.Адрес;
	//Url = "clone.vstore.net.ua";	
	Соединение = Новый HTTPСоединение(Url,,"admin","password",,,Новый ЗащищенноеСоединениеOpenSSL());
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	HTTPЗапрос = Новый HTTPЗапрос("index.php?route=api/products/add1c", Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	ИндексНайденнойСтроки = Найти(мОтвет, "[");
	НужнаяСтрокаJSON = Сред(мОтвет, ИндексНайденнойСтроки, СтрДлина(мОтвет));
	НужнаяСтрокаJSON = СтрЗаменить(НужнаяСтрокаJSON, "[", "");
	НужнаяСтрокаJSON = СтрЗаменить(НужнаяСтрокаJSON, "]", "");
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(НужнаяСтрокаJSON);
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Сообщить("Не удалось прочитать JSON");
		Возврат;
	КонецПопытки;
	ЧтениеJSON.Закрыть();
	
	Успешно = Ложь;

	Если ТипЗнч(СтруктураОтвета) = Тип("Структура")
		И СтруктураОтвета.свойство("success")
		И СтруктураОтвета.success 
		И Ответ.КодСостояния = 200 Тогда  
		Успешно = Истина;
	КонецЕсли;
	
	Если Успешно Тогда
		УзелОбменаТоварами = Константы.УзелОбменаССайтомАпи.Получить();
		Если НЕ ЗначениеЗаполнено(УзелОбменаТоварами) Тогда
			Возврат;
		КонецЕсли;
		Для Каждого СтрокаТовары из СтрДанныеДляОтправки.ОбъектыНаРегистрации Цикл 
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаТоварами,СтрокаТовары);
		КонецЦикла;
		
		Сообщить("Товари вивантаженно");
	КонецЕсли;
	
КонецПроцедуры

Функция СобратьДанныеДляОтправки()
	
	стрВозврата = Новый Структура;
	стрВозврата.Вставить("products", Новый Массив);
	стрВозврата.Вставить("ОбъектыНаРегистрации");
	
	СтруктураИзменений = Новый Структура("Товары,Заказы,Картинки,НомерСообщенияТовары,НомерСообщенияЗаказы", 
		Новый Массив(), Новый Массив(), Новый Массив());
	
	УзелОбменаТоварами = Константы.УзелОбменаССайтомАпи.Получить();
	Если НЕ ЗначениеЗаполнено(УзелОбменаТоварами) Тогда
		Возврат стрВозврата;
	КонецЕсли;
		
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
		
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелОбменаТоварами);
	
	СтруктураИзменений.НомерСообщенияТовары = ЗаписьСообщения.НомерСообщения;
	
	МассОтбора = Новый Массив;
	МассОтбора.Добавить(Метаданные.Справочники.Номенклатура);
	Выборка = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения, МассОтбора); 
	Пока Выборка.Следующий() Цикл
		Данные = Выборка.Получить();
		
		Если ТипЗнч(Данные.Ссылка) <> Тип("СправочникСсылка.Номенклатура") Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураИзменений.Товары.Добавить(Данные.Ссылка);
	КонецЦикла;
	
	Если СтруктураИзменений.Товары.Количество() = 0 Тогда
		Возврат стрВозврата;
	КонецЕсли;
	
	// Все объекты, которые потом надо снять с регистрации после успешной отправки
	стрВозврата.ОбъектыНаРегистрации = СтруктураИзменений.Товары;
	
	// Загружаем отборы из типовой настройки обмена с сайтом
	ТЗНастроекОтбора = ПолучитьОтборыТиповойВыгрузкиТоваровНаСайт();
	
	МассивНоменклатурыДляПолнойВыгрузки = Новый Массив;
	МассивНоменклатурыДляСкрытия = Новый Массив;
	
	Для Каждого СсылкаНоменклатуры Из СтруктураИзменений.Товары Цикл
		
		Если НоменклатураПроходитОтборыТиповойВыгрузкиНаСайт(СсылкаНоменклатуры, ТЗНастроекОтбора) Тогда
			
			МассивНоменклатурыДляПолнойВыгрузки.Добавить(СсылкаНоменклатуры);
			
		Иначе
			
			// Товар изменился, но по отбору уже не должен быть на сайте.
			// Отправим его как скрытый.
			МассивНоменклатурыДляСкрытия.Добавить(СсылкаНоменклатуры);
			
		КонецЕсли;
		
	КонецЦикла;
	
	МассТоваров = Новый Массив;
	
	// Сначала добавляем товары, которые надо скрыть на сайте
	Для Каждого НоменклатураКСкрытию Из МассивНоменклатурыДляСкрытия Цикл
		
		МассТоваров.Добавить(
		СформироватьСтруктуруСкрытияНоменклатурыДляАпи(НоменклатураКСкрытию)
		);
		
	КонецЦикла;
	
	// Если товаров для полной выгрузки нет — возвращаем только скрытие
	Если МассивНоменклатурыДляПолнойВыгрузки.Количество() = 0 Тогда
		
		стрВозврата.products = МассТоваров;
		Возврат стрВозврата;
		
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Товары.НоменклатураСсылка КАК НоменклатураСсылка,
		|	Товары.НоменклатураСсылка.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.НоменклатураСсылка.ЕдиницаХраненияОстатков КАК ЕдиницаДляШтрихКода,
		|	Товары.НоменклатураСсылка.ВидНоменклатуры.Наименование КАК ВидНоменклатуры,
		|	Товары.НоменклатураСсылка.ВидНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры,
		|	МАКСИМУМ(РегистрШтрихКоды.Штрихкод) КАК ШтрихКод,
		|	Товары.ХарактеристикаСсылка КАК ХарактеристикаСсылка,
		|	ЗначенияСвойствХарактеристик.Свойство КАК ХарактеристикаСвойство,
		|	ЗначенияСвойствХарактеристик.Значение КАК ХарактеристикаЗначениеСвойства,
		|	ЗначенияСвойствОбъектов.Значение КАК СвойствоНоменклатурыЗначение,
		|	ЗначенияСвойствОбъектов.Свойство КАК СвойствоНоменклатуры
		|ИЗ
		|	(ВЫБРАТЬ
		|		Номенклатура.Ссылка КАК НоменклатураСсылка,
		|		Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаДляШтрихКода,
		|		ХарактеристикиНоменклатуры.Наименование КАК ХарактеристикаНаименование,
		|		ВЫБОР
		|			КОГДА ХарактеристикиНоменклатуры.Ссылка ЕСТЬ NULL
		|				ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|			ИНАЧЕ ХарактеристикиНоменклатуры.Ссылка
		|		КОНЕЦ КАК ХарактеристикаСсылка
		|	ИЗ
		|		Справочник.Номенклатура КАК Номенклатура
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|			ПО Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
		|	ГДЕ
		|		Номенклатура.ЭтоГруппа = ЛОЖЬ
		|	{ГДЕ
		|		Номенклатура.Ссылка.* КАК Номенклатура}) КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствХарактеристик
		|		ПО (ЗначенияСвойствХарактеристик.Объект = Товары.ХарактеристикаСсылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК РегистрШтрихКоды
		|		ПО Товары.НоменклатураСсылка = РегистрШтрихКоды.Владелец
		|			И Товары.ХарактеристикаСсылка = РегистрШтрихКоды.ХарактеристикаНоменклатуры
		|			И Товары.ЕдиницаДляШтрихКода = РегистрШтрихКоды.ЕдиницаИзмерения
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗначенияСвойствОбъектов.Объект КАК Объект,
		|			ЗначенияСвойствОбъектов.Свойство КАК Свойство,
		|			ЗначенияСвойствОбъектов.Значение КАК Значение
		|		ИЗ
		|			РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|		ГДЕ
		|			ЗначенияСвойствОбъектов.Свойство.НазначениеСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_Номенклатура)
		|		{ГДЕ
		|			ЗначенияСвойствОбъектов.Свойство КАК Свойство}) КАК ЗначенияСвойствОбъектов
		|		ПО Товары.НоменклатураСсылка = ЗначенияСвойствОбъектов.Объект
		|ГДЕ
		|	Товары.НоменклатураСсылка В(&МассивИзмененийНоменклатуры)
		|
		|СГРУППИРОВАТЬ ПО
		|	Товары.НоменклатураСсылка,
		|	Товары.ХарактеристикаСсылка,
		|	ЗначенияСвойствХарактеристик.Свойство,
		|	ЗначенияСвойствХарактеристик.Значение,
		|	ЗначенияСвойствОбъектов.Свойство,
		|	ЗначенияСвойствОбъектов.Значение,
		|	Товары.НоменклатураСсылка.БазоваяЕдиницаИзмерения,
		|	Товары.НоменклатураСсылка.ЕдиницаХраненияОстатков,
		|	Товары.НоменклатураСсылка.ВидНоменклатуры.Наименование,
		|	Товары.НоменклатураСсылка.ВидНоменклатуры.ТипНоменклатуры
		|ИТОГИ
		|	МАКСИМУМ(ЕдиницаИзмерения),
		|	МАКСИМУМ(ЕдиницаДляШтрихКода),
		|	МАКСИМУМ(ВидНоменклатуры),
		|	МАКСИМУМ(ТипНоменклатуры),
		|	МАКСИМУМ(ШтрихКод),
		|	МАКСИМУМ(ХарактеристикаЗначениеСвойства),
		|	МАКСИМУМ(СвойствоНоменклатурыЗначение)
		|ПО
		|	НоменклатураСсылка,
		|	ХарактеристикаСсылка,
		|	ХарактеристикаСвойство,
		|	СвойствоНоменклатуры
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	//Сергей ИМ просил убрать признак по виду номенклатуры 30.04.2026
	//МассивДопустимыхТиповНоменклатуры = Новый Массив;
	//МассивДопустимыхТиповНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Товар);
	
	Запрос.УстановитьПараметр("ДатаОтчета", ТекущаяДата());
	//Запрос.УстановитьПараметр("МассивДопустимыхТиповНоменклатуры", МассивДопустимыхТиповНоменклатуры);
	Запрос.УстановитьПараметр("МассивИзмененийНоменклатуры", МассивНоменклатурыДляПолнойВыгрузки);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНоменклатураСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассПроверяемыхТипов = Новый Массив;
	МассПроверяемыхТипов.Добавить(Тип("Строка"));
	МассПроверяемыхТипов.Добавить(Тип("Число"));
	МассПроверяемыхТипов.Добавить(Тип("Дата"));
	
	мКоэффициентПересчетаВесаТоваровВГраммыДляОбменаССайтом = Константы.КоэффициентПересчетаВесаТоваровВГраммыДляОбменаССайтом.Получить();
	Если НЕ ЗначениеЗаполнено(мКоэффициентПересчетаВесаТоваровВГраммыДляОбменаССайтом) Тогда
		мКоэффициентПересчетаВесаТоваровВГраммыДляОбменаССайтом = 1;
	КонецЕсли;
	
	Пока ВыборкаНоменклатураСсылка.Следующий() Цикл
		
		Номенклатура = ВыборкаНоменклатураСсылка.НоменклатураСсылка;
		
		СтрДанныхНоменклатуры = Новый Структура;
		СтрДанныхНоменклатуры.Вставить("ID", Строка(Номенклатура.УникальныйИдентификатор()));
		МассДанныхНоменклатуры = Новый Массив;
		
		СтрДанные = Новый Структура;
		//СтрДанные.Вставить("ID", Строка(Номенклатура.УникальныйИдентификатор()));
		СтрДанные.Вставить("Barcode", Строка(ВыборкаНоменклатураСсылка.Штрихкод));
		СтрДанные.Вставить("Article", Номенклатура.Артикул);
		СтрДанные.Вставить("Name", Номенклатура.Наименование);
		СтрДанные.Вставить("Not_available",  Номенклатура.НеПоказыватьНаСайте);
		СтрДанные.Вставить("Base_unit_name", Номенклатура.ЕдиницаХраненияОстатков.Наименование);
		СтрДанные.Вставить("Base_unit_code", Номенклатура.ЕдиницаХраненияОстатков.Код);
		СтрДанные.Вставить("Group", ?(ЗначениеЗаполнено(Номенклатура.Родитель), Строка(Номенклатура.Родитель.УникальныйИдентификатор()), ""));
		СтрДанные.Вставить("Description", Номенклатура.ДополнительноеОписаниеНоменклатуры);
		СтрДанные.Вставить("Properties", Новый Массив);
		СтрДанные.Вставить("VAT", ПолучитьПоСтавкеНДСЗначениеДляВыгрузки(Номенклатура.СтавкаНДС));
		СтрДанные.Вставить("Product_form", ВыборкаНоменклатураСсылка.ВидНоменклатуры);
		СтрДанные.Вставить("Product_type", Строка(ВыборкаНоменклатураСсылка.ТипНоменклатуры));
		СтрДанные.Вставить("Product_full_name", Номенклатура.НаименованиеПолное);
		СтрДанные.Вставить("Product_name_ru", Номенклатура.Наименование_ru);
		СтрДанные.Вставить("Product_name_en", Номенклатура.Наименование_en);
		СтрДанные.Вставить("Product_Description_ua", Номенклатура.ДополнительноеОписаниеНоменклатуры);
		СтрДанные.Вставить("Product_Description_ru", Номенклатура.ДополнительноеОписаниеНоменклатуры_ru);
		СтрДанные.Вставить("Product_Description_en", Номенклатура.ДополнительноеОписаниеНоменклатуры_en);
		СтрДанные.Вставить("Weight");
		
		Если ЗначениеЗаполнено(Номенклатура.ЕдиницаХраненияОстатков) Тогда
			// передадим вес товара
			СтрДанные.Weight = мКоэффициентПересчетаВесаТоваровВГраммыДляОбменаССайтом * Номенклатура.ЕдиницаХраненияОстатков.Вес;
		КонецЕсли;	
		
		ВыборкаХарактеристикаСсылка = ВыборкаНоменклатураСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаХарактеристикаСсылка.Следующий() Цикл
			
			СписокЗначенийСвойств 	= Новый СписокЗначений;
			МассСвойств 			= Новый Массив;
			
			ВыборкаХарактеристикаСвойство = ВыборкаХарактеристикаСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
			Пока ВыборкаХарактеристикаСвойство.Следующий() Цикл
				// Вставити обробку вибірки ВыборкаХарактеристикаСвойство
	
				ВыборкаСвойствоНоменклатуры = ВыборкаХарактеристикаСвойство.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
				Пока ВыборкаСвойствоНоменклатуры.Следующий() Цикл
					
					Если ЗначениеЗаполнено(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатуры)
						И СписокЗначенийСвойств.НайтиПоЗначению(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатуры) = Неопределено Тогда
						
						СписокЗначенийСвойств.Добавить(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатуры, Строка(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатурыЗначение));
						
						СтрСвойстваНоменклатуры = Новый Структура;
						
						Если МассПроверяемыхТипов.Найти(ТипЗнч(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатурыЗначение)) = Неопределено Тогда
							СтрСвойстваНоменклатуры.Вставить("Prop_id", Строка(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатурыЗначение.УникальныйИдентификатор()));
						Иначе
							СтрСвойстваНоменклатуры.Вставить("Prop_id", "");
						КонецЕсли;
						
						Если МассПроверяемыхТипов.Найти(ТипЗнч(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатуры)) = Неопределено Тогда
							СтрСвойстваНоменклатуры.Вставить("Prop_value_id", Строка(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатуры.УникальныйИдентификатор()));
						Иначе
							СтрСвойстваНоменклатуры.Вставить("Prop_value_id", "String");
						КонецЕсли;
						
						СтрСвойстваНоменклатуры.Вставить("Prop_value", Строка(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатуры));
						СтрСвойстваНоменклатуры.Вставить("Prop_name",  Строка(ВыборкаСвойствоНоменклатуры.СвойствоНоменклатурыЗначение));
						
						МассСвойств.Добавить(СтрСвойстваНоменклатуры);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
			СтрДанные.Properties = МассСвойств;
			
		КонецЦикла;
		
		МассДанныхНоменклатуры.Добавить(СтрДанные);
		СтрДанныхНоменклатуры.Вставить("Product",МассДанныхНоменклатуры); 
		
		МассТоваров.Добавить(СтрДанныхНоменклатуры);
		
	КонецЦикла;

	стрВозврата.products = МассТоваров;
	
	Возврат стрВозврата;
	
КонецФункции

Функция ПолучитьПоСтавкеНДСЗначениеДляВыгрузки(СтавкаНДС)
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		ЗначениеНалога = "Без НДС";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда		
		ЗначениеНалога = "0";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда				
		ЗначениеНалога = "20";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НеНДС Тогда						
		ЗначениеНалога = "Не НДС";
	Иначе
		ЗначениеНалога = "";	
	КонецЕсли;
	
	Возврат ЗначениеНалога;
	
КонецФункции

Процедура ЗарегистрироватьНаВыгрузкуАпи(Номенклатура) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Если Номенклатура.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	УзелОбмена = Константы.УзелОбменаССайтомАпи.Получить();
	Если НЕ ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Номенклатура);
	
КонецПроцедуры

Функция НоменклатураВГруппеНаВыгрузку(Номенклатура, ГруппыНоменклатуры)
	
	пРодитель = Номенклатура.Родитель;
	Пока ЗначениеЗаполнено(пРодитель.Родитель) Цикл
        пРодитель = пРодитель.Родитель;
		Если ГруппыНоменклатуры.НайтиПоЗначению(пРодитель) <> Неопределено Тогда
			Возврат Истина;	
		КонецЕсли;
    КонецЦикла;

    Возврат Ложь;	
	
КонецФункции

Функция ПолучитьОтборыТиповойВыгрузкиТоваровНаСайт() Экспорт
	
	НастройкаОбмена = Справочники.НастройкиОбменаССайтом.НайтиПоКоду("001"); // Товары
	
	Если НЕ ЗначениеЗаполнено(НастройкаОбмена) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат НастройкаОбмена.СохраненныеНастройкиПостроителя.Получить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция НоменклатураПроходитОтборыТиповойВыгрузкиНаСайт(Номенклатура, ТЗНастроекОтбора) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Номенклатура.ЭтоГруппа Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Жесткое правило для API:
	// если товар помечен "Не показывать на сайте" — не выгружаем полностью,
	// а отправляем как скрытый.
	Если Номенклатура.НеПоказыватьНаСайте Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТЗНастроекОтбора = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	СтрОтбор = Новый Структура;
	СтрОтбор.Вставить("Использование", Истина);
	
	НайденныеСтроки = ТЗНастроекОтбора.НайтиСтроки(СтрОтбор);
	
	Для Каждого СтрНастройка Из НайденныеСтроки Цикл
		
		ПутьКДанным = СокрЛП(СтрНастройка.ПутьКДанным);
		
		// Тип цен, остатки, склады и прочие настройки здесь не проверяем.
		// Здесь проверяем только условия по самой номенклатуре.
		Если НЕ ЭтоПутьКДаннымНоменклатурыДляОтбора(ПутьКДанным) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеОбъекта = ПолучитьЗначениеНоменклатурыПоПутиКДанным(Номенклатура, ПутьКДанным);
		
		Если НЕ ЗначениеПроходитУсловиеОтбораСайта(
			ЗначениеОбъекта,
			СтрНастройка.ВидСравнения,
			СтрНастройка.Значение
		) Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоПутьКДаннымНоменклатурыДляОтбора(ПутьКДанным)
	
	Если ПутьКДанным = "Номенклатура" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Лев(ПутьКДанным, СтрДлина("Номенклатура.")) = "Номенклатура.";
	
КонецФункции

Функция ПолучитьЗначениеНоменклатурыПоПутиКДанным(Номенклатура, ПутьКДанным)
	
	Если ПутьКДанным = "Номенклатура" Тогда
		Возврат Номенклатура;
	КонецЕсли;
	
	ИмяПоля = Сред(ПутьКДанным, СтрДлина("Номенклатура.") + 1);
	
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Минимальная защита, чтобы в динамический запрос не попал мусор
	Если Найти(ИмяПоля, ";") > 0
		ИЛИ Найти(ИмяПоля, "|") > 0
		ИЛИ Найти(ИмяПоля, "(") > 0
		ИЛИ Найти(ИмяПоля, ")") > 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура." + ИмяПоля + " КАК Значение
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗначениеПроходитУсловиеОтбораСайта(ЗначениеОбъекта, ТипСравнения, ЗначениеОтбора)
	
	ПредставлениеТипа = НРег(Строка(ТипСравнения));
	
	// Не заполнено / Не заповнено
	Если Найти(ПредставлениеТипа, "не заполн") > 0
		ИЛИ Найти(ПредставлениеТипа, "не заповн") > 0 Тогда
		
		Возврат НЕ ЗначениеЗаполнено(ЗначениеОбъекта);
		
	КонецЕсли;
	
	// Заполнено / Заповнено
	Если Найти(ПредставлениеТипа, "заполн") > 0
		ИЛИ Найти(ПредставлениеТипа, "заповн") > 0 Тогда
		
		Возврат ЗначениеЗаполнено(ЗначениеОбъекта);
		
	КонецЕсли;
	
	// Не в группе из списка
	Если Найти(ПредставлениеТипа, "не") > 0
		И Найти(ПредставлениеТипа, "груп") > 0
		И Найти(ПредставлениеТипа, "спис") > 0 Тогда
		
		Возврат НЕ ЗначениеВИерархииИзСпискаДляОтбораСайта(ЗначениеОбъекта, ЗначениеОтбора);
		
	КонецЕсли;
	
	// В группе из списка
	Если Найти(ПредставлениеТипа, "груп") > 0
		И Найти(ПредставлениеТипа, "спис") > 0 Тогда
		
		Возврат ЗначениеВИерархииИзСпискаДляОтбораСайта(ЗначениеОбъекта, ЗначениеОтбора);
		
	КонецЕсли;
	
	// Не в группе
	Если Найти(ПредставлениеТипа, "не") > 0
		И Найти(ПредставлениеТипа, "груп") > 0 Тогда
		
		Возврат НЕ ЗначениеВИерархииДляОтбораСайта(ЗначениеОбъекта, ЗначениеОтбора);
		
	КонецЕсли;
	
	// В группе
	Если Найти(ПредставлениеТипа, "груп") > 0 Тогда
		
		Возврат ЗначениеВИерархииДляОтбораСайта(ЗначениеОбъекта, ЗначениеОтбора);
		
	КонецЕсли;
	
	// Не в списке
	Если Найти(ПредставлениеТипа, "не") > 0
		И Найти(ПредставлениеТипа, "спис") > 0 Тогда
		
		Возврат НЕ ЗначениеЕстьВСпискеДляОтбораСайта(ЗначениеОбъекта, ЗначениеОтбора);
		
	КонецЕсли;
	
	// В списке
	Если Найти(ПредставлениеТипа, "спис") > 0 Тогда
		
		Возврат ЗначениеЕстьВСпискеДляОтбораСайта(ЗначениеОбъекта, ЗначениеОтбора);
		
	КонецЕсли;
	
	// Не равно / Не дорівнює
	Если Найти(ПредставлениеТипа, "не") > 0
		И (Найти(ПредставлениеТипа, "рав") > 0
			ИЛИ Найти(ПредставлениеТипа, "дорів") > 0) Тогда
		
		Возврат ЗначениеОбъекта <> ЗначениеОтбора;
		
	КонецЕсли;
	
	// Равно / Дорівнює
	Если Найти(ПредставлениеТипа, "рав") > 0
		ИЛИ Найти(ПредставлениеТипа, "дорів") > 0 Тогда
		
		Возврат ЗначениеОбъекта = ЗначениеОтбора;
		
	КонецЕсли;
	
	// Если тип сравнения не поддержали — лучше не выгружать лишнее
	Возврат Ложь;
	
КонецФункции

Функция ЗначениеЕстьВСпискеДляОтбораСайта(ЗначениеОбъекта, ЗначениеОтбора)
	
	МассивЗначений = ПолучитьМассивИзЗначенияОтбораСайта(ЗначениеОтбора);
	
	Для Каждого ТекущееЗначение Из МассивЗначений Цикл
		
		Если ЗначениеОбъекта = ТекущееЗначение Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗначениеВИерархииИзСпискаДляОтбораСайта(ПроверяемоеЗначение, ЗначениеОтбора)
	
	МассивЗначений = ПолучитьМассивИзЗначенияОтбораСайта(ЗначениеОтбора);
	
	Для Каждого Группа Из МассивЗначений Цикл
		
		Если ЗначениеВИерархииДляОтбораСайта(ПроверяемоеЗначение, Группа) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗначениеВИерархииДляОтбораСайта(ПроверяемоеЗначение, Группа)
	
	Если НЕ ЗначениеЗаполнено(ПроверяемоеЗначение)
		ИЛИ НЕ ЗначениеЗаполнено(Группа) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ПроверяемоеЗначение = Группа Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		ТекущийРодитель = ПроверяемоеЗначение.Родитель;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Пока ЗначениеЗаполнено(ТекущийРодитель) Цикл
		
		Если ТекущийРодитель = Группа Тогда
			Возврат Истина;
		КонецЕсли;
		
		ТекущийРодитель = ТекущийРодитель.Родитель;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьМассивИзЗначенияОтбораСайта(ЗначениеОтбора)
	
	МассивЗначений = Новый Массив;
	
	Если ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") Тогда
		
		Для Каждого ЭлементСписка Из ЗначениеОтбора Цикл
			МассивЗначений.Добавить(ЭлементСписка.Значение);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ЗначениеОтбора) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из ЗначениеОтбора Цикл
			МассивЗначений.Добавить(ЭлементМассива);
		КонецЦикла;
		
	Иначе
		
		МассивЗначений.Добавить(ЗначениеОтбора);
		
	КонецЕсли;
	
	Возврат МассивЗначений;
	
КонецФункции

Функция СформироватьСтруктуруСкрытияНоменклатурыДляАпи(Номенклатура) Экспорт
	
	СтрДанныхНоменклатуры = Новый Структура;
	СтрДанныхНоменклатуры.Вставить("ID", Строка(Номенклатура.УникальныйИдентификатор()));
	
	МассДанныхНоменклатуры = Новый Массив;
	
	СтрДанные = Новый Структура;
	СтрДанные.Вставить("Barcode", "");
	СтрДанные.Вставить("Article", Номенклатура.Артикул);
	СтрДанные.Вставить("Name", Номенклатура.Наименование);
	СтрДанные.Вставить("Not_available", Истина);
	
	Если ЗначениеЗаполнено(Номенклатура.ЕдиницаХраненияОстатков) Тогда
		
		СтрДанные.Вставить("Base_unit_name", Номенклатура.ЕдиницаХраненияОстатков.Наименование);
		СтрДанные.Вставить("Base_unit_code", Номенклатура.ЕдиницаХраненияОстатков.Код);
		
	Иначе
		
		СтрДанные.Вставить("Base_unit_name", "");
		СтрДанные.Вставить("Base_unit_code", "");
		
	КонецЕсли;
	
	СтрДанные.Вставить("Group", ?(ЗначениеЗаполнено(Номенклатура.Родитель), Строка(Номенклатура.Родитель.УникальныйИдентификатор()), ""));
	СтрДанные.Вставить("Description", "");
	СтрДанные.Вставить("Properties", Новый Массив);
	СтрДанные.Вставить("VAT", ПолучитьПоСтавкеНДСЗначениеДляВыгрузки(Номенклатура.СтавкаНДС));
	СтрДанные.Вставить("Product_form", "");
	СтрДанные.Вставить("Product_type", "");
	СтрДанные.Вставить("Product_full_name", Номенклатура.НаименованиеПолное);
	СтрДанные.Вставить("Product_name_ru", Номенклатура.Наименование_ru);
	СтрДанные.Вставить("Product_name_en", Номенклатура.Наименование_en);
	СтрДанные.Вставить("Product_Description_ua", "");
	СтрДанные.Вставить("Product_Description_ru", "");
	СтрДанные.Вставить("Product_Description_en", "");
	СтрДанные.Вставить("Weight", 0);
	
	МассДанныхНоменклатуры.Добавить(СтрДанные);
	
	СтрДанныхНоменклатуры.Вставить("Product", МассДанныхНоменклатуры);
	
	Возврат СтрДанныхНоменклатуры;
	
КонецФункции

#КонецОбласти

#Область ЗаказыАпи

Процедура ОбменЗаказамиАпи() Экспорт
	
	СтрДанныеДляОтправки = СобратьДанныеДляОтправкиЗаказы();
	Если СтрДанныеДляОтправки.Заказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("vstore.net.ua");
	Url = СтрПодключение.Адрес;
	Соединение = Новый HTTPСоединение(Url,,"admin","password",,,Новый ЗащищенноеСоединениеOpenSSL());
	
	УзелОбменаЗаказами = Константы.УзелОбменаССайтомЗаказыАпи.Получить();
	Если НЕ ЗначениеЗаполнено(УзелОбменаЗаказами) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтруктураЗаказа Из СтрДанныеДляОтправки.Заказы Цикл
		
		СтруктураТела = Новый Структура;
		СтруктураТела.Вставить("token", ПолучитьТокенДляОбменаЗаказамиАпи());
		СтруктураТела.Вставить("order_id", СтруктураЗаказа.order_id);
		СтруктураТела.Вставить("products", СтруктураЗаказа.products);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураТела);
		СтрJSON = ЗаписьJSON.Закрыть();
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type","application/json");
		HTTPЗапрос = Новый HTTPЗапрос("index.php?route=api/order/update", Заголовки);
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		Попытка
			Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
			мОтвет 	= Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Исключение
			ЗаписьЖурналаРегистрации("ОбменЗаказамиАпи", УровеньЖурналаРегистрации.Ошибка,,, 
				"Ошибка отправки заказа " + СтруктураЗаказа.order_id + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
		Если ЗаказАпиУспешноПередан(Ответ, мОтвет) Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаЗаказами, СтруктураЗаказа.Ссылка);
		Иначе
			ЗаписьЖурналаРегистрации("ОбменЗаказамиАпи", УровеньЖурналаРегистрации.Ошибка,,, 
				"Сайт не подтвердил обновление заказа " + СтруктураЗаказа.order_id 
				+ ". Код HTTP: " + Строка(Ответ.КодСостояния)
				+ ". Ответ: " + мОтвет
				+ ". Тело запроса: " + СтрJSON);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СобратьДанныеДляОтправкиЗаказы()
	
	стрВозврата = Новый Структура;
	стрВозврата.Вставить("Заказы", Новый Массив);
	стрВозврата.Вставить("ОбъектыНаРегистрации", Новый Массив);
	
	СтруктураИзменений = Новый Структура("Заказы,НомерСообщенияЗаказы", Новый Массив());
	
	УзелОбменаЗаказами = Константы.УзелОбменаССайтомЗаказыАпи.Получить();
	Если НЕ ЗначениеЗаполнено(УзелОбменаЗаказами) Тогда
		Возврат стрВозврата;
	КонецЕсли;
		
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
		
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелОбменаЗаказами);
	
	СтруктураИзменений.НомерСообщенияЗаказы = ЗаписьСообщения.НомерСообщения;
	
	МассОтбора = Новый Массив;
	МассОтбора.Добавить(Метаданные.Документы.ЗаказПокупателя);
	Выборка = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения, МассОтбора); 
	Пока Выборка.Следующий() Цикл
		Данные = Выборка.Получить();
		
		Если ЗначениеЗаполнено(Данные.Ссылка.OrderID) Тогда
			СтруктураИзменений.Заказы.Добавить(Данные.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если СтруктураИзменений.Заказы.Количество() = 0 Тогда
		Возврат стрВозврата;
	КонецЕсли;
	
	стрВозврата.ОбъектыНаРегистрации = СтруктураИзменений.Заказы;
	
	Для Каждого Заказ Из СтруктураИзменений.Заказы Цикл
		
		СтруктураЗаказа = СформироватьСтруктуруЗаказаДляОбновленияНаСайте(Заказ);
		Если СтруктураЗаказа.products.Количество() > 0 Тогда
			стрВозврата.Заказы.Добавить(СтруктураЗаказа);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат стрВозврата;
	
КонецФункции

Функция СформироватьСтруктуруЗаказаДляОбновленияНаСайте(Заказ)
	
	СтруктураЗаказа = Новый Структура;
	СтруктураЗаказа.Вставить("Ссылка", Заказ);
	СтруктураЗаказа.Вставить("order_id", Строка(Заказ.OrderID));
	СтруктураЗаказа.Вставить("products", Новый Массив);
	
	Для Каждого СтрокаТовара Из Заказ.Товары Цикл
		ДобавитьСтрокуЗаказаВProducts(СтруктураЗаказа.products, СтрокаТовара.Номенклатура, СтрокаТовара.Количество, СтрокаТовара.Цена);
	КонецЦикла;
	
	Для Каждого СтрокаУслуги Из Заказ.Услуги Цикл
		ДобавитьСтрокуЗаказаВProducts(СтруктураЗаказа.products, СтрокаУслуги.Номенклатура, СтрокаУслуги.Количество, СтрокаУслуги.Цена);
	КонецЦикла;
	
	Возврат СтруктураЗаказа;
	
КонецФункции

Процедура ДобавитьСтрокуЗаказаВProducts(Products, Номенклатура, Количество, Цена)
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаProduct = Новый Структура;
	СтрокаProduct.Вставить("guid", Строка(Номенклатура.УникальныйИдентификатор()));
	СтрокаProduct.Вставить("name", Номенклатура.Наименование);
	СтрокаProduct.Вставить("quantity", ЧислоСтрокойДляЗаказаАпи(Количество));
	СтрокаProduct.Вставить("price", ЧислоСтрокойДляЗаказаАпи(Цена, 2));
	
	Products.Добавить(СтрокаProduct);
	
КонецПроцедуры

Функция ЧислоСтрокойДляЗаказаАпи(Значение, ЗнаковПослеЗапятой = Неопределено)
	
	Если ЗнаковПослеЗапятой = Неопределено Тогда
		Результат = Строка(Значение);
	Иначе
		Результат = Формат(Значение, "ЧДЦ=" + Строка(ЗнаковПослеЗапятой) + "; ЧРД=.; ЧГ=0");
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, ",", ".");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТокенДляОбменаЗаказамиАпи()
	
	Возврат ПланыОбмена.Website.НайтиПоНаименованию("vstore.net.ua").Токен;
	
КонецФункции

Функция ЗаказАпиУспешноПередан(Ответ, ТелоОтвета)
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат Истина;
	КонецПопытки;
	ЧтениеJSON.Закрыть();
	
	Если ТипЗнч(СтруктураОтвета) <> Тип("Структура") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("success") Тогда
		Возврат ЗначениеОтветаЗаказаАпиУспешное(СтруктураОтвета.success);
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("status") Тогда
		Возврат ЗначениеОтветаЗаказаАпиУспешное(СтруктураОтвета.status);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЗначениеОтветаЗаказаАпиУспешное(ЗначениеОтвета)
	
	Если ТипЗнч(ЗначениеОтвета) = Тип("Булево") Тогда
		Возврат ЗначениеОтвета;
	КонецЕсли;
	
	СтрокаОтвета = НРег(СокрЛП(Строка(ЗначениеОтвета)));
	
	Возврат СтрокаОтвета = "1"
		ИЛИ СтрокаОтвета = "true"
		ИЛИ СтрокаОтвета = "success"
		ИЛИ СтрокаОтвета = "ok";
	
КонецФункции

#КонецОбласти

#Область ЧекиАпи

Процедура ОбменЧекамиАпи() Экспорт
	
	СтрДанныеДляОтправки = СобратьДанныеДляОтправкиЧеки();
	Если СтрДанныеДляОтправки.Checks.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассВозврата = Новый Массив;
	СтрВозврата = Новый Структура;
	СтрВозврата.Вставить("token", ПланыОбмена.Website.НайтиПоНаименованию("vstore.net.ua").Токен);
	СтрВозврата.Вставить("Checks", СтрДанныеДляОтправки.Checks);
	
	МассВозврата.Добавить(СтрВозврата);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассВозврата);
	СтрJSON = ЗаписьJSON.Закрыть();
	
	СтрПодключение = Справочники.НастройкиПодключенияКAPI.ПолучитьСтруктуруПодключенияAPI("vstore.net.ua");
	Url = СтрПодключение.Адрес;
	Соединение = Новый HTTPСоединение(Url,,"admin","password",,,Новый ЗащищенноеСоединениеOpenSSL());
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	HTTPЗапрос = Новый HTTPЗапрос("index.php?route=checkout/oct_fastorder/purchase_receipt", Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Ответ 	= Соединение.ОтправитьДляОбработки(HTTPЗапрос);	
	мОтвет 	= Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	ИндексНайденнойСтроки = Найти(мОтвет, "[");
	НужнаяСтрокаJSON = Сред(мОтвет, ИндексНайденнойСтроки, СтрДлина(мОтвет));
	НужнаяСтрокаJSON = СтрЗаменить(НужнаяСтрокаJSON, "[", "");
	НужнаяСтрокаJSON = СтрЗаменить(НужнаяСтрокаJSON, "]", "");
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(НужнаяСтрокаJSON);
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Возврат;
	КонецПопытки;
	ЧтениеJSON.Закрыть();
	
	Если НЕ СтруктураОтвета.status Тогда
		ЗаписьЖурналаРегистрации("CheckURL", УровеньЖурналаРегистрации.Ошибка,,,СтрJSON + " #response = " + СтруктураОтвета.message);
		Возврат;
	КонецЕсли;
	
	УзелОбменаЧеками = Константы.УзелОбменаССайтомСсылкамиНаЧек.Получить();
	Если НЕ ЗначениеЗаполнено(УзелОбменаЧеками) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Чек из СтрДанныеДляОтправки.ОбъектыНаРегистрации Цикл 
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаЧеками,Чек);
	КонецЦикла;
	
КонецПроцедуры

Функция СобратьДанныеДляОтправкиЧеки()
	
	стрВозврата = Новый Структура;
	стрВозврата.Вставить("Checks", Новый Массив);
	стрВозврата.Вставить("ОбъектыНаРегистрации");
	
	СтруктураИзменений = Новый Структура("Чеки,НомерСообщенияТовары,НомерСообщенияЗаказы", Новый Массив());
	
	УзелОбменаЧеками = Константы.УзелОбменаССайтомСсылкамиНаЧек.Получить();
	Если НЕ ЗначениеЗаполнено(УзелОбменаЧеками) Тогда
		Возврат стрВозврата;
	КонецЕсли;
		
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
		
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелОбменаЧеками);
	
	СтруктураИзменений.НомерСообщенияТовары = ЗаписьСообщения.НомерСообщения;
	
	МассРегистрации = Новый Массив;
	
	МассОтбора = Новый Массив;
	МассОтбора.Добавить(Метаданные.Документы.ЧекККМ);
	Выборка = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения, МассОтбора); 
	Пока Выборка.Следующий() Цикл
		
		Данные 	= Выборка.Получить();
		Чек 	= Данные.Ссылка;
		СтрЧек 	= Новый Структура("CheckURL, Order_ID", Чек.URLЧека, Чек.ЗаказПокупателя.OrderID);
		
		СтруктураИзменений.Чеки.Добавить(СтрЧек);
		МассРегистрации.Добавить(Чек);
		
	КонецЦикла;
	
	Если СтруктураИзменений.Чеки.Количество() = 0 Тогда
		Возврат стрВозврата;
	КонецЕсли;
	
	СтрДанные 							= Новый Структура;
	стрВозврата.ОбъектыНаРегистрации 	= МассРегистрации;
	стрВозврата.Checks 					= СтруктураИзменений.Чеки;
	
	Возврат стрВозврата;
	
КонецФункции

#КонецОбласти




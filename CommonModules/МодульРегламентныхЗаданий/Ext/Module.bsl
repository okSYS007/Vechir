Процедура СоздатьУстановкуЦен(ТЗТовары)
	
	ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("РРЦ", Истина);
	Если Не ЗначениеЗаполнено(ТипЦены) Тогда
		Возврат;
	КонецЕсли;
	ЦеныНоменклатуры = Новый Массив;
	ЦеныНоменклатуры.Добавить(ТипЦены);
	ИндексСтрокиТаблицыЦен = 0;
	
	ДокументОбъект             = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	ДокументОбъект.Дата        = ТекущаяДата();
	ДокументОбъект.Комментарий = "Цена РРЦ DCLINK";
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
	НовСтрТипЦен 		= ДокументОбъект.ТипыЦен.Добавить();
	НовСтрТипЦен.ТипЦен = ТипЦены;
	ИндексСтрокиТаблицыЦен = 0;
	
	Для Каждого стр Из ТЗТовары Цикл
		
		Для Каждого ТипЦенНоменклатуры Из ЦеныНоменклатуры Цикл
			 
			Если  ?(ЗначениеЗаполнено(стр.price_uah),Число(стр.price_uah),0) = 0 или   стр.ЦенаУстановлена Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТовары = ДокументОбъект.Товары.Добавить();
			СтрокаТовары.Номенклатура = стр.Tovar;
			СтрокаТовары.ТипЦен = ТипЦенНоменклатуры;
			СтрокаТовары.ИндексСтрокиТаблицыЦен = ИндексСтрокиТаблицыЦен;
			СтрокаТовары.Цена = стр.price_uah;
			СтрокаТовары.Валюта = ТипЦенНоменклатуры.ВалютаЦены;
			
			
			СтрокаТовары.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
			СтрокаТовары.ПроцентСкидкиНаценки = ТипЦенНоменклатуры.ПроцентСкидкиНаценки;
			СтрокаТовары.СпособРасчетаЦены = ТипЦенНоменклатуры.СпособРасчетаЦены;
	КонецЦикла;
		
	КонецЦикла;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	//////////////////////Цена дилер/////////////////////////////////////////////////
	ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Дилерская цена", Истина);
	Если Не ЗначениеЗаполнено(ТипЦены) Тогда
		Возврат;
	КонецЕсли;
	ЦеныНоменклатуры = Новый Массив;
	ЦеныНоменклатуры.Добавить(ТипЦены);
	ИндексСтрокиТаблицыЦен = 0;
	
	ДокументОбъект             = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	ДокументОбъект.Дата        = ТекущаяДата();
	ДокументОбъект.Комментарий = "Цена Дилерская цена DCLINK";
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
	НовСтрТипЦен 		= ДокументОбъект.ТипыЦен.Добавить();
	НовСтрТипЦен.ТипЦен = ТипЦены;
	ИндексСтрокиТаблицыЦен = 0;
	
	Для Каждого стр Из ТЗТовары Цикл
		
		Для Каждого ТипЦенНоменклатуры Из ЦеныНоменклатуры Цикл
		

			Если  ?(ЗначениеЗаполнено(стр.dealer_price_uah),Число(стр.dealer_price_uah),0)  = 0 или   стр.ЦенаУстановлена Тогда

				Продолжить;
			КонецЕсли;
			
			СтрокаТовары = ДокументОбъект.Товары.Добавить();
			СтрокаТовары.Номенклатура = стр.Tovar;
			СтрокаТовары.ТипЦен = ТипЦенНоменклатуры;
			СтрокаТовары.ИндексСтрокиТаблицыЦен = ИндексСтрокиТаблицыЦен;
			СтрокаТовары.Цена = стр.dealer_price_uah;
			СтрокаТовары.Валюта = ТипЦенНоменклатуры.ВалютаЦены;
			СтрокаТовары.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
			СтрокаТовары.ПроцентСкидкиНаценки = ТипЦенНоменклатуры.ПроцентСкидкиНаценки;
			СтрокаТовары.СпособРасчетаЦены = ТипЦенНоменклатуры.СпособРасчетаЦены;
			стр.ЦенаУстановлена = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	
	
КонецПроцедуры	

Функция НайтиУстановкуЦен()
	
	Документ = Документы.УстановкаЦенНоменклатуры.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаЦенНоменклатуры.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	УстановкаЦенНоменклатуры.Комментарий ПОДОБНО &Комментарий";
	
	Запрос.УстановитьПараметр("Комментарий", "Создан автоматически " + Формат(ТекущаяДата(), "ДЛФ=Д"));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Документ = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Документ;
	
КонецФункции	

Процедура ДобавитьЗаписиПоОстаткам(ТЗТовары)
	
	Если ТЗТовары.Количество() > 0 Тогда 
		Склад = Справочники.Склады.НайтиПоКоду("000000001");
		Период = ТЗТовары[0].Период;
		ТЗПроводки = ТЗТовары.Скопировать(,"Номенклатура, Склад, Период, Количество");
		НаборЗаписей = РегистрыСведений.ТоварыНаСкладахПоставщиков.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Период);
		НаборЗаписей.Отбор.Склад.Установить(Склад);
		НаборЗаписей.Загрузить(ТЗПроводки);
		Попытка
			НаборЗаписей.Записать();
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	
КонецПроцедуры	

Процедура ТрансляцияДокументов() Экспорт
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	А_ОчередьТрансляции.Объект
	|ИЗ
	|	РегистрСведений.А_ОчередьТрансляции КАК А_ОчередьТрансляции";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	
	Для Каждого СтрокаДокумент из РезультатЗапроса Цикл 
		Источник = СтрокаДокумент.Объект.ПолучитьОбъект();
		
		ТипИсточника = ТипЗнч(Источник);
		МетаданныеИсточника = Источник.Метаданные();
		
		А_Подписка.СформироватьДокументУУ(Источник, МетаданныеИсточника, ТипИсточника, Ложь, РежимПроведенияДокумента.Оперативный);
		
		НаборЗаписей = РегистрыСведений.А_ОчередьТрансляции.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.установить(СтрокаДокумент.Объект);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

// к ЛИВ

//
//Например СрокДляОтправкиСообщения = 7. Это значит, что нужно
//отправить сообщение, что через 7 дней закончиться лицензия 
Процедура ОтправитьПисьмоПроОплатуЛицензийРРО(СрокДляОтправкиСообщения = 7) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеОплатЛицензийРРО.ФискальныйНомер,
		|	ДанныеОплатЛицензийРРО.ВидРРО,
		|	НачалоПериода(ДанныеОплатЛицензийРРО.ДатаОкончанияДействияЛицензии, ДЕНЬ) КАК Срок,
		|	ДанныеОплатЛицензийРРО.ОтправлятьПисьмоОбОкончанииСрокаЛицензииСюда КАК Emeil
		|ИЗ
		|	РегистрСведений.ДанныеОплатЛицензийРРО КАК ДанныеОплатЛицензийРРО
		|ГДЕ
		|	НачалоПериода(ДанныеОплатЛицензийРРО.ДатаОкончанияДействияЛицензии, ДЕНЬ) <= &ДатаОкончанияДействияЛицензии
		|	И ДанныеОплатЛицензийРРО.ОтправлятьПисьмоОбОкончанииСрокаЛицензииСюда <> """"";
	
	
	ДатаОкончанияДействияЛицензии = НачалоДня(ТекущаяДата() + (СрокДляОтправкиСообщения*60*60*24)); 
	Запрос.УстановитьПараметр("ДатаОкончанияДействияЛицензии", ДатаОкончанияДействияЛицензии);
	
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = Рез.Выбрать();
	
	ПользовательОтправкиПоПочте = Справочники.Пользователи.НайтиПоНаименованию("Почтовый пользователь", Истина);
	ТекстПисьма 				= "За фіскальними реєстраторами закінчується термін ліцензій:";
	СписокПолучателей 			= Новый СписокЗначений;
	
	сч = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		сч = сч +1;
		Если СписокПолучателей.НайтиПоЗначению(ВыборкаДетальныеЗаписи.Emeil) = Неопределено Тогда
			СписокПолучателей.Добавить(ВыборкаДетальныеЗаписи.Emeil);
		КонецЕсли;
		ТекстПисьма = ТекстПисьма + Символы.ПС + сч + ". " + ВыборкаДетальныеЗаписи.ФискальныйНомер + " Дійсний до " + Формат(ВыборкаДетальныеЗаписи.Срок, "ДЛФ=Д");  
	КонецЦикла;
	
	СтрПисьма = Новый Структура;
	СтрПисьма.Вставить("ОтправленоФоном", Истина);
	СтрПисьма.Вставить("Тело", ТекстПисьма);
	СтрПисьма.Вставить("Тема", "Закінчується термін ліцензій ПРРО");
	СтрПисьма.Вставить("УчетнаяЗапись", Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Автоматична система відправки повідоплень"));
	СтрПисьма.Вставить("Кому", СписокПолучателей);
	
	СтрПисьмо = УправлениеЭлектроннойПочтой.НаписатьПисьмо(ПользовательОтправкиПоПочте, СтрПисьма,,,,,,,Ложь); 
	СтрПисьмо.Письмо.ОтправитьПисьмо(,ПользовательОтправкиПоПочте);
	
КонецПроцедуры


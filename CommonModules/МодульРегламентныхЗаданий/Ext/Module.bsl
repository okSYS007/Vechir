		УровеньЖурналаРегистрации.Информация, Метаданные.Документы.ЭлектронноеПисьмо, ,
		НСтр("ru='Получение электронных сообщений выполнено успешно';uk='Отримання електронних повідомлень виконано успішно'"));
	Иначе
		ЗаписьЖурналаРегистрации(НСтр("ru='Получение электронных сообщений';uk='Отримання електронних повідомлень'"), 
		УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЭлектронноеПисьмо, ,
		НСтр("ru='Получение электронных сообщений выполнено с ошибками:';uk='Отримання електронних повідомлень виконано з помилками:'") + Символы.ПС + ТекстОшибок);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОчисткаСтарыхВерсииОбъектов() Экспорт
	
	КолвоДнейХранения = Константы.КоличествоДнейХраненияВерсийОбъектов.Получить();
	Если КолвоДнейХранения = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии,
	|	ВерсииОбъектов.АвторВерсии,
	|	ВерсииОбъектов.ДатаВерсии,
	|	ВерсииОбъектов.Объект
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.ДатаВерсии <= &ДатаВерсии
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерВерсии";
	
	
	Запрос.УстановитьПараметр("ДатаВерсии", КонецДня(ТекущаяДата() - (КолвоДнейХранения*60*60*24)));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗап 			= РегистрыСведений.ВерсииОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗап.Объект 		= Выборка.Объект;
		МенеджерЗап.НомерВерсии = Выборка.НомерВерсии;
		МенеджерЗап.Удалить();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчисткаСтарыхВерсийЛогирования() Экспорт
	
	КолвоДнейХранения = Константы.КоличествоДнейХраненияВерсийОбъектов.Получить();
	Если КолвоДнейХранения = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Логирование.ОбъектЛогирования,
	|	Логирование.Лог,
	|	Логирование.ДатаЛогирования
	|ИЗ
	|	РегистрСведений.Логирование КАК Логирование
	|ГДЕ
	|	Логирование.ДатаЛогирования <= &ДатаЛогирования";
	
	Запрос.УстановитьПараметр("ДатаЛогирования", КонецДня(ТекущаяДата() - (КолвоДнейХранения*60*60*24)));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗап 			= РегистрыСведений.Логирование.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗап, ВыборкаДетальныеЗаписи);
		МенеджерЗап.Удалить();
		
	КонецЦикла;
	
КонецПроцедуры


//ЗавершитьЗаказ
Процедура ЗаказВыполнен(ЗаказПокупателяСсылка) Экспорт 
	
	Об = ЗаказПокупателяСсылка.получитьОбъект();
	
	ЗапросПоБизнесПроцессамЗаказа = новый запрос;
	ЗапросПоБизнесПроцессамЗаказа.Текст = "ВЫБРАТЬ
	|	БП_ОбработкаЗаказа.Ссылка 
	|ИЗ
	|	БизнесПроцесс.БП_ОбработкаЗаказа КАК БП_ОбработкаЗаказа
	|ГДЕ
	|	БП_ОбработкаЗаказа.ЗаказПокупателя = &ЗаказПокупателя";
	ЗапросПоБизнесПроцессамЗаказа.УстановитьПараметр("ЗаказПокупателя",об.ссылка);											  
	РезультатЗапроса = ЗапросПоБизнесПроцессамЗаказа.Выполнить().Выгрузить();
	
	Для Каждого БизнесПроцесс из РезультатЗапроса Цикл 
		
		ЗапросПоЗадачамБП = новый запрос;
		ЗапросПоЗадачамБП.Текст = "ВЫБРАТЬ
		|	БП_ЗадачиИсполнителей.Ссылка
		|ИЗ
		|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
		|ГДЕ
		|	БП_ЗадачиИсполнителей.БизнесПроцесс = &БизнесПроцесс";
		ЗапросПоЗадачамБП.УстановитьПараметр("БизнесПроцесс",БизнесПроцесс.ссылка);
		РезультатЗапросаПоЗадачам = ЗапросПоЗадачамБП.Выполнить().Выгрузить();
		Для Каждого СтрокаЗадачи  из РезультатЗапросаПоЗадачам цикл
			ЗадачаОб = СтрокаЗадачи.Ссылка.получитьОбъект();
			ЗадачаОб.Удалить();
		КонецЦикла;
		
		
		БПОб = БизнесПроцесс.Ссылка.ПолучитьОБъект();
		БПОб.Завершен     = истина;
		БПОб.СтатусЗаказа = Перечисления.БП_СтатусыЗаказов.ЗаказВыполнен;
		// + S1-177 ДДГ 11 ноя 2024
		БПОб.СтатусСчетаОплаты = Перечисления.СтатусыЭлектронногоСчета.Оплачен;
		// - S1-177 ДДГ 11 ноя 2024
		БПОб.Записать();
		
		ЗапросПоБизнесПроцессамСтрокиЗаказа = новый запрос;
		ЗапросПоБизнесПроцессамСтрокиЗаказа.Текст = "ВЫБРАТЬ
		|	БП_ОбработкаСтрокиЗаказа.Ссылка
		|ИЗ
		|	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
		|ГДЕ
		|	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес = &РодительскийБизнесПроцес";
		ЗапросПоБизнесПроцессамСтрокиЗаказа.УстановитьПараметр("РодительскийБизнесПроцес",БизнесПроцесс.Ссылка);											  
		РезультатЗапросаСтрокиЗаказа = ЗапросПоБизнесПроцессамСтрокиЗаказа.Выполнить().Выгрузить();
		
		Для Каждого БизнесПроцессСтроки из РезультатЗапросаСтрокиЗаказа Цикл 
			
			ЗапросПоЗадачамБПСтроки = новый запрос;
			ЗапросПоЗадачамБПСтроки.Текст = "ВЫБРАТЬ
			|	БП_ЗадачиИсполнителей.Ссылка
			|ИЗ
			|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
			|ГДЕ
			|	БП_ЗадачиИсполнителей.БизнесПроцесс = &БизнесПроцесс";
			ЗапросПоЗадачамБПСтроки.УстановитьПараметр("БизнесПроцесс",БизнесПроцессСтроки.ссылка);
			РезультатЗапросаСтрокиПоЗадачам = ЗапросПоЗадачамБПСтроки.Выполнить().Выгрузить();
			Для Каждого СтрокаЗадачиБпСтроки  из РезультатЗапросаСтрокиПоЗадачам цикл
				ЗадачаОб = СтрокаЗадачиБпСтроки.Ссылка.получитьОбъект();
				ЗадачаОб.Удалить();	
			КонецЦикла;
			
			
			БПОбСтроки = БизнесПроцессСтроки.Ссылка.ПолучитьОБъект();
			БПОбСтроки.Завершен     = истина;

			// + S1-545 ДДГ 20 мар 2025
			Если БПОбСтроки.СтатусСтрокиЗаказа <> Перечисления.БП_СтатусыСтрокЗазака.АннулированКлиентом Тогда
			// - S1-545 ДДГ 20 мар 2025
				БПОбСтроки.СтатусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.ТоварОтгружен;
			КонецЕсли;

			БПОбСтроки.Записать();
			
		КонецЦикла;
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗаказОтменен(ЗаказПокупателяСсылка) Экспорт

	ЗапросПоБизнесПроцессамЗаказа = новый запрос;
	ЗапросПоБизнесПроцессамЗаказа.Текст = "ВЫБРАТЬ
	|	БП_ОбработкаЗаказа.Ссылка 
	|ИЗ
	|	БизнесПроцесс.БП_ОбработкаЗаказа КАК БП_ОбработкаЗаказа
	|ГДЕ
	|	БП_ОбработкаЗаказа.ЗаказПокупателя = &ЗаказПокупателя";
	ЗапросПоБизнесПроцессамЗаказа.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателяСсылка);											  
	РезультатЗапроса = ЗапросПоБизнесПроцессамЗаказа.Выполнить().Выгрузить();
	
	Для Каждого БизнесПроцесс из РезультатЗапроса Цикл 
		
		ЗапросПоЗадачамБП = новый запрос;
		ЗапросПоЗадачамБП.Текст = "ВЫБРАТЬ
		|	БП_ЗадачиИсполнителей.Ссылка
		|ИЗ
		|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
		|ГДЕ
		|	БП_ЗадачиИсполнителей.БизнесПроцесс = &БизнесПроцесс";
		ЗапросПоЗадачамБП.УстановитьПараметр("БизнесПроцесс",БизнесПроцесс.ссылка);
		РезультатЗапросаПоЗадачам = ЗапросПоЗадачамБП.Выполнить().Выгрузить();
		Для Каждого СтрокаЗадачи  из РезультатЗапросаПоЗадачам цикл
			ЗадачаОб = СтрокаЗадачи.Ссылка.получитьОбъект();
			ЗадачаОб.Удалить();
		КонецЦикла;
		
		
		БПОб = БизнесПроцесс.Ссылка.ПолучитьОБъект();
		БПОб.Завершен     = истина;
		БПОб.СтатусЗаказа = Перечисления.БП_СтатусыЗаказов.ОтказКлиента;
		БПОб.Записать();

		ЗапросПоБизнесПроцессамСтрокиЗаказа = новый запрос;
		ЗапросПоБизнесПроцессамСтрокиЗаказа.Текст = "ВЫБРАТЬ
		|	БП_ОбработкаСтрокиЗаказа.Ссылка
		|ИЗ
		|	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
		|ГДЕ
		|	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес = &РодительскийБизнесПроцес";
		ЗапросПоБизнесПроцессамСтрокиЗаказа.УстановитьПараметр("РодительскийБизнесПроцес",БизнесПроцесс.Ссылка);											  
		РезультатЗапросаСтрокиЗаказа = ЗапросПоБизнесПроцессамСтрокиЗаказа.Выполнить().Выгрузить();
		
		Для Каждого БизнесПроцессСтроки из РезультатЗапросаСтрокиЗаказа Цикл 
			
			ЗапросПоЗадачамБПСтроки = новый запрос;
			ЗапросПоЗадачамБПСтроки.Текст = "ВЫБРАТЬ
			|	БП_ЗадачиИсполнителей.Ссылка
			|ИЗ
			|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
			|ГДЕ
			|	БП_ЗадачиИсполнителей.БизнесПроцесс = &БизнесПроцесс";
			ЗапросПоЗадачамБПСтроки.УстановитьПараметр("БизнесПроцесс",БизнесПроцессСтроки.ссылка);
			РезультатЗапросаСтрокиПоЗадачам = ЗапросПоЗадачамБПСтроки.Выполнить().Выгрузить();
			Для Каждого СтрокаЗадачиБпСтроки  из РезультатЗапросаСтрокиПоЗадачам цикл
				ЗадачаОб = СтрокаЗадачиБпСтроки.Ссылка.получитьОбъект();
				ЗадачаОб.Удалить();	
			КонецЦикла;
			
			БПОбСтроки = БизнесПроцессСтроки.Ссылка.ПолучитьОБъект();
			БПОбСтроки.Завершен           = истина;
			БПОбСтроки.СтатусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.АннулированКлиентом;
			БПОбСтроки.Записать();
			
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЗакрытьЗаказПокупателя(ЗаказПокупателяСсылка, Комментарий = "") Экспорт

	ЗакрытиеЗаказаПокупателя = Документы.ЗакрытиеЗаказовПокупателей.СоздатьДокумент();
	ЗакрытиеЗаказаПокупателя.Дата = ТекущаяДата();
	ЗакрытиеЗаказаПокупателя.ВидОперации = Перечисления.ВидыОперацийЗакрытиеЗаказовПокупателей.ЗакрытиеЗаказов;
	
	СтрокаЗаказы = ЗакрытиеЗаказаПокупателя.Заказы.Добавить();
	СтрокаЗаказы.ЗаказПокупателя = ЗаказПокупателяСсылка;
	ЗакрытиеЗаказаПокупателя.Подразделение = ЗаказПокупателяСсылка.Подразделение;
	ЗакрытиеЗаказаПокупателя.Комментарий   = Комментарий;
	ЗакрытиеЗаказаПокупателя.Записать(РежимЗаписиДокумента.Проведение);

	Возврат ЗакрытиеЗаказаПокупателя;

КонецФункции

Процедура УдалитьЗадачиУточнитьУПокупателяПродлениеРезерва(ЗаказПокупателяСсылка) Экспорт
	ЗапросПоЗадачам = новый запрос;
		ЗапросПоЗадачам.Текст = "ВЫБРАТЬ
		                        |	БП_ЗадачиИсполнителей.Ссылка
		                        |ИЗ
		                        |	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
		                        |ГДЕ
		                        |	БП_ЗадачиИсполнителей.Наименование = &Наименование
		                        |	И БП_ЗадачиИсполнителей.ЗаказПокупателя = &ЗаказПокупателя";
		ЗапросПоЗадачам.УстановитьПараметр("Наименование","%Уточнить у покупателя продление резерва%");	

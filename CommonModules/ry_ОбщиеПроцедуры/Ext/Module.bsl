Процедура АнализНаличияФото() Экспорт 
	
	ЗапросПоДеталямБезФото = новый запрос;
	ЗапросПоДеталямБезФото.Текст =  "ВЫБРАТЬ
	                                |	ВложенныйЗапрос.Дата КАК ДатаВремяПриемки,
	                                |	ВложенныйЗапрос.Номенклатура,
	                                |	ВложенныйЗапрос.ХарактеристикаНоменклатуры,
	                                |	ХранилищеДополнительнойИнформации.Ссылка,
	                                |	ВложенныйЗапрос.Ссылка КАК Комплектация,
	                                |	ВложенныйЗапрос.СсылкаСкладПодразделение КАК Подразделение,
	                                |	ВложенныйЗапрос.СсылкаОтветственный КАК Кладовщик,
	                                |	ИСТИНА КАК НужноФото
	                                |ИЗ
	                                |	(ВЫБРАТЬ
	                                |		ВложенныйЗапрос.Дата КАК Дата,
	                                |		ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	                                |		ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                                |		ВложенныйЗапрос.Ссылка КАК Ссылка,
	                                |		ВложенныйЗапрос.Ссылка.Склад.Подразделение КАК СсылкаСкладПодразделение,
	                                |		ВложенныйЗапрос.Ссылка.Ответственный КАК СсылкаОтветственный
	                                |	ИЗ
	                                |		(ВЫБРАТЬ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.Дата КАК Дата,
	                                |			зетаБУКомплектацияСоставКомплекта.Номенклатура КАК Номенклатура,
	                                |			зетаБУКомплектацияСоставКомплекта.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка КАК Ссылка
	                                |		ИЗ
	                                |			Документ.зетаБУКомплектация.СоставКомплекта КАК зетаБУКомплектацияСоставКомплекта
	                                |		ГДЕ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.ВидКомплекта = ЗНАЧЕНИЕ(Перечисление.зетаБУВидыКомплектов.ДетальВнеКомплекта)
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Проведен
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Дата > &ДатаНачалаУчета) КАК ВложенныйЗапрос
	                                |	
	                                |	ОБЪЕДИНИТЬ ВСЕ
	                                |	
	                                |	ВЫБРАТЬ
	                                |		ВложенныйЗапрос.Дата,
	                                |		ВложенныйЗапрос.Номенклатура,
	                                |		ВложенныйЗапрос.ХарактеристикаНоменклатуры,
	                                |		ВложенныйЗапрос.Ссылка,
	                                |		ВложенныйЗапрос.Ссылка.Склад.Подразделение,
	                                |		ВложенныйЗапрос.Ссылка.Ответственный
	                                |	ИЗ
	                                |		(ВЫБРАТЬ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.Дата КАК Дата,
	                                |			зетаБУКомплектацияСоставКомплекта.Номенклатура КАК Номенклатура,
	                                |			зетаБУКомплектацияСоставКомплекта.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка КАК Ссылка
	                                |		ИЗ
	                                |			Документ.зетаБУКомплектация.СоставКомплекта КАК зетаБУКомплектацияСоставКомплекта
	                                |		ГДЕ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.ВидКомплекта <> ЗНАЧЕНИЕ(Перечисление.зетаБУВидыКомплектов.ДетальВнеКомплекта)
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Проведен
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Дата > &ДатаНачалаУчета
	                                |			И зетаБУКомплектацияСоставКомплекта.ВидКомплектации = ЗНАЧЕНИЕ(Перечисление.зетаБУВидыКомплектации.ОсновнаяЧастьКомплекта)) КАК ВложенныйЗапрос) КАК ВложенныйЗапрос
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	                                |		ПО ВложенныйЗапрос.ХарактеристикаНоменклатуры = ХранилищеДополнительнойИнформации.Объект
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДеталиБезФото КАК ДеталиБезФото
	                                |		ПО ВложенныйЗапрос.ХарактеристикаНоменклатуры = ДеталиБезФото.ХарактеристикаНоменклатуры
	                                |ГДЕ
	                                |	ХранилищеДополнительнойИнформации.Ссылка ЕСТЬ NULL
	                                |	И ДеталиБезФото.НужноФото ЕСТЬ NULL";
	ЗапросПоДеталямБезФото.УстановитьПараметр("ДатаНачалаУчета",дата(2020,04,01));
	
	РезультатЗапроса = ЗапросПоДеталямБезФото.Выполнить().Выгрузить();
	
	Для каждого строка из РезультатЗапроса цикл
		Менеджер = РегистрыСведений.ДеталиБезФото.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Менеджер,строка);
		Менеджер.Записать(Истина);
	КонецЦикла;
	
	
	ЗапросПоДеталямСФото = новый запрос;
	ЗапросПоДеталямСФото.Текст = "ВЫБРАТЬ
	                             |	ДеталиБезФото.Номенклатура,
	                             |	ДеталиБезФото.ХарактеристикаНоменклатуры,
	                             |	ДеталиБезФото.Подразделение,
	                             |	ДеталиБезФото.Кладовщик,
	                             |	ДеталиБезФото.ДатаВремяПриемки
	                             |ИЗ
	                             |	РегистрСведений.ДеталиБезФото КАК ДеталиБезФото
	                             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	                             |		ПО ДеталиБезФото.ХарактеристикаНоменклатуры = ХранилищеДополнительнойИнформации.Объект";
	РезультатЗапросаПоДеталямСФото = ЗапросПоДеталямСФото.Выполнить().Выгрузить();
	
	Для каждого СтрокаДеталейСФото из РезультатЗапросаПоДеталямСФото цикл
		Менеджер = РегистрыСведений.ДеталиСФото.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Менеджер,СтрокаДеталейСФото);
		Менеджер.ДатаВремяПоявленияФото = ТекущаяДата();
		Менеджер.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.ДеталиБезФото.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Номенклатура.Значение 				= СтрокаДеталейСФото.Номенклатура;
		НаборЗаписей.Отбор.Номенклатура.ВидСравнения			= ВидСравнения.Равно; 
		НаборЗаписей.Отбор.Номенклатура.Использование           = Истина; 

		НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.Значение    	= СтрокаДеталейСФото.ХарактеристикаНоменклатуры;
		НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.ВидСравнения 	= ВидСравнения.Равно; 
		НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.Использование = Истина;

		НаборЗаписей.Отбор.Подразделение.Значение 			        = СтрокаДеталейСФото.Подразделение; 
		НаборЗаписей.Отбор.Подразделение.ВидСравнения 			    = ВидСравнения.Равно; 
		НаборЗаписей.Отбор.Подразделение.Использование 			    = Истина; 
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЦикла;

	ЗапросПоДеталямБезФото = новый запрос;
	ЗапросПоДеталямБезФото.Текст =  "ВЫБРАТЬ
	                                |	ВложенныйЗапрос.СсылкаСкладПодразделение КАК Подразделение,
	                                |	ВложенныйЗапрос.СсылкаОтветственный КАК Кладовщик,
	                                |	СУММА(ВЫБОР
	                                |			КОГДА РАЗНОСТЬДАТ(ВложенныйЗапрос.Дата, &ТекущаяДата, ДЕНЬ) < 3
	                                |				ТОГДА 1
	                                |			ИНАЧЕ 0
	                                |		КОНЕЦ) КАК Категория1,
	                                |	СУММА(ВЫБОР
	                                |			КОГДА РАЗНОСТЬДАТ(ВложенныйЗапрос.Дата, &ТекущаяДата, ДЕНЬ) >= 3
	                                |					И РАЗНОСТЬДАТ(ВложенныйЗапрос.Дата, &ТекущаяДата, ДЕНЬ) < 5
	                                |				ТОГДА 1
	                                |			ИНАЧЕ 0
	                                |		КОНЕЦ) КАК Категория2,
	                                |	СУММА(ВЫБОР
	                                |			КОГДА РАЗНОСТЬДАТ(ВложенныйЗапрос.Дата, &ТекущаяДата, ДЕНЬ) > 5
	                                |				ТОГДА 1
	                                |			ИНАЧЕ 0
	                                |		КОНЕЦ) КАК Категория3
	                                |ИЗ
	                                |	(ВЫБРАТЬ
	                                |		ВложенныйЗапрос.Дата КАК Дата,
	                                |		ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	                                |		ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                                |		ВложенныйЗапрос.Ссылка КАК Ссылка,
	                                |		ВложенныйЗапрос.Ссылка.Склад.Подразделение КАК СсылкаСкладПодразделение,
	                                |		ВложенныйЗапрос.Ссылка.Ответственный КАК СсылкаОтветственный
	                                |	ИЗ
	                                |		(ВЫБРАТЬ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.Дата КАК Дата,
	                                |			зетаБУКомплектацияСоставКомплекта.Номенклатура КАК Номенклатура,
	                                |			зетаБУКомплектацияСоставКомплекта.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка КАК Ссылка
	                                |		ИЗ
	                                |			Документ.зетаБУКомплектация.СоставКомплекта КАК зетаБУКомплектацияСоставКомплекта
	                                |		ГДЕ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.ВидКомплекта = ЗНАЧЕНИЕ(Перечисление.зетаБУВидыКомплектов.ДетальВнеКомплекта)
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Проведен
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Дата МЕЖДУ &НачалоТекущегоМесяца И &КонецТекущегоМесяца) КАК ВложенныйЗапрос
	                                |	
	                                |	ОБЪЕДИНИТЬ ВСЕ
	                                |	
	                                |	ВЫБРАТЬ
	                                |		ВложенныйЗапрос.Дата,
	                                |		ВложенныйЗапрос.Номенклатура,
	                                |		ВложенныйЗапрос.ХарактеристикаНоменклатуры,
	                                |		ВложенныйЗапрос.Ссылка,
	                                |		ВложенныйЗапрос.Ссылка.Склад.Подразделение,
	                                |		ВложенныйЗапрос.Ссылка.Ответственный
	                                |	ИЗ
	                                |		(ВЫБРАТЬ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.Дата КАК Дата,
	                                |			зетаБУКомплектацияСоставКомплекта.Номенклатура КАК Номенклатура,
	                                |			зетаБУКомплектацияСоставКомплекта.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка КАК Ссылка
	                                |		ИЗ
	                                |			Документ.зетаБУКомплектация.СоставКомплекта КАК зетаБУКомплектацияСоставКомплекта
	                                |		ГДЕ
	                                |			зетаБУКомплектацияСоставКомплекта.Ссылка.ВидКомплекта <> ЗНАЧЕНИЕ(Перечисление.зетаБУВидыКомплектов.ДетальВнеКомплекта)
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Проведен
	                                |			И зетаБУКомплектацияСоставКомплекта.Ссылка.Дата МЕЖДУ &НачалоТекущегоМесяца И &КонецТекущегоМесяца
	                                |			И зетаБУКомплектацияСоставКомплекта.ВидКомплектации = ЗНАЧЕНИЕ(Перечисление.зетаБУВидыКомплектации.ОсновнаяЧастьКомплекта)) КАК ВложенныйЗапрос) КАК ВложенныйЗапрос
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	                                |		ПО ВложенныйЗапрос.ХарактеристикаНоменклатуры = ХранилищеДополнительнойИнформации.Объект
	                                |ГДЕ
	                                |	ХранилищеДополнительнойИнформации.Ссылка ЕСТЬ NULL 
	                                |
	                                |СГРУППИРОВАТЬ ПО
	                                |	ВложенныйЗапрос.СсылкаОтветственный,
	                                |	ВложенныйЗапрос.СсылкаСкладПодразделение";

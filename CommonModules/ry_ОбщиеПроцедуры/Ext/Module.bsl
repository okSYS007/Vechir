Процедура ЗаписатьДанные(Пользователь,НовыйКонтрагент)
	
//Записываем контактную информацию о контрагенте
		Попытка
		//Записываем Телефон
		Если не СокрЛП(Пользователь.Код) = "" тогда
			Телефон = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Телефон.Объект = НовыйКонтрагент;
			Телефон.Тип   = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Телефон.Вид   = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
			Телефон.Поле3 = Пользователь.КонтактныйТелефон; 
			Телефон.Прочитать();
			Если Не Телефон.Выбран() тогда
				Телефон.Объект = НовыйКонтрагент;
				Телефон.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				Телефон.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
				Телефон.Поле3 = Пользователь.Код; 
				Телефон.Представление = Пользователь.Код;
				Телефон.Записать(Ложь);
			КонецЕсли;
		КонецЕсли;
		//Записываем e-mail
		Если не СокрЛП(Пользователь.ЭлектроннаяПочта) = "" тогда
			ЭлектроннаяПочта = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			ЭлектроннаяПочта.Объект = НовыйКонтрагент;
			ЭлектроннаяПочта.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			ЭлектроннаяПочта.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами;
			ЭлектроннаяПочта.Представление = Пользователь.ЭлектроннаяПочта; 
			ЭлектроннаяПочта.Прочитать();
			Если Не ЭлектроннаяПочта.Выбран() тогда
				ЭлектроннаяПочта.Объект = НовыйКонтрагент;
				ЭлектроннаяПочта.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				ЭлектроннаяПочта.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами;
				ЭлектроннаяПочта.Представление = Пользователь.ЭлектроннаяПочта;
				ЭлектроннаяПочта.Записать();
			КонецЕсли;
		КонецЕсли;
		//Записываем фактический адрес контрагента
		Если не СокрЛП(Пользователь.Адрес) = "" тогда	
		   ФактАдресКонтрагента = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		   ФактАдресКонтрагента.Объект = НовыйКонтрагент;
		   ФактАдресКонтрагента.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		   ФактАдресКонтрагента.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
		   ФактАдресКонтрагента.Представление = Пользователь.Адрес;
		   ФактАдресКонтрагента.Прочитать();
		   Если Не ФактАдресКонтрагента.Выбран() тогда
				ФактАдресКонтрагента.Объект = НовыйКонтрагент;
				ФактАдресКонтрагента.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
				ФактАдресКонтрагента.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
				ФактАдресКонтрагента.Представление = Пользователь.Адрес;
				ФактАдресКонтрагента.Записать();
			КонецЕсли;
		КонецЕсли;
		//Записываем юридический адрес контрагента
		Если не СокрЛП(Пользователь.ЮридическийАдрес) = "" тогда
           ЮридическийАдресКонтрагента = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		   ЮридическийАдресКонтрагента.Объект = НовыйКонтрагент;
		   ЮридическийАдресКонтрагента.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		   ЮридическийАдресКонтрагента.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		   ЮридическийАдресКонтрагента.Представление = Пользователь.ЮридическийАдрес;
		   ЮридическийАдресКонтрагента.Прочитать();
		   Если Не ЮридическийАдресКонтрагента.Выбран() тогда
				ЮридическийАдресКонтрагента.Объект = НовыйКонтрагент;
				ЮридическийАдресКонтрагента.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
				ЮридическийАдресКонтрагента.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
				ЮридическийАдресКонтрагента.Представление = Пользователь.ЮридическийАдрес;
				ЮридическийАдресКонтрагента.Записать();
			КонецЕсли;
		КонецЕсли;    
	Исключение
		ЗаписьЖурналаРегистрации("Выполенение сопоставления контрагентов",,,Пользователь,ОписаниеОшибки());
		КонецПопытки;

	КонецПроцедуры

Процедура ЗаменитьЗначениеВКонтантнойИнформации(Объект,СтароеЗначение,НовоеЗначение) Экспорт 
ЗапросПоВидуИнформации = новый Запрос;
ЗапросПоВидуИнформации.Текст = "ВЫБРАТЬ
                               |	КонтактнаяИнформация.Вид
                               |ИЗ
                               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
                               |ГДЕ
                               |	КонтактнаяИнформация.Объект = &Объект
                               |	И КонтактнаяИнформация.Представление ПОДОБНО &Представление";
ЗапросПоВидуИнформации.УстановитьПараметр("Объект",Объект);
ЗапросПоВидуИнформации.УстановитьПараметр("Представление",СтароеЗначение);

РезультатЗапроса = ЗапросПоВидуИнформации.Выполнить().Выгрузить();

Если РезультатЗапроса.Количество()>0 Тогда 
	ВидИнформации = РезультатЗапроса[0].Вид;
	
	АдрессДоставки               = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	АдрессДоставки.Активность    = Истина;
	АдрессДоставки.Вид           = ВидИнформации;
	АдрессДоставки.Тип           = Перечисления.ТипыКонтактнойИнформации.Адрес;
	АдрессДоставки.Объект        = Объект;
	АдрессДоставки.Представление = НовоеЗначение;
	АдрессДоставки.Записать(Истина);
		
КонецЕсли;


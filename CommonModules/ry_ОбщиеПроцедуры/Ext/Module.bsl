Процедура ПеревестиСтатусыЗаявокНаДеталь()  Экспорт 
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗапросНаДеталь.Ссылка
	               |ИЗ
	               |	Документ.ЗапросНаДеталь КАК ЗапросНаДеталь
	               |ГДЕ
	               |	НЕ ЗапросНаДеталь.Закрыт
	               |	И ЗапросНаДеталь.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗапросыНаДетали.ЗапросНаДетальКонстантину)";
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() цикл
		об = РезультатЗапроса.ссылка.получитьОбъект();
		
		ЗапросПоПисьмам = новый запрос;
		ЗапросПоПисьмам.Текст =  "ВЫБРАТЬ
		|	ЭлектронноеПисьмо.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
		|ГДЕ
		|	ЭлектронноеПисьмо.Ссылка.Тема ПОДОБНО &Тема СПЕЦСИМВОЛ ""\""
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭлектронноеПисьмо.Ссылка.Дата УБЫВ";
		ЗапросПоПисьмам.УстановитьПараметр("Тема","%\["+РезультатЗапроса.ссылка.номер+"\]%");
		
		РезультатЗапросаПоПисьмам =ЗапросПоПисьмам.Выполнить().Выгрузить() ;
		
		Если РезультатЗапросаПоПисьмам.Количество() >0 Тогда 
			Письмо = РезультатЗапросаПоПисьмам[0].ссылка;
			
			Если Письмо.ссылка.статусПисьма = Перечисления.СтатусыПисем.Полученное и не об.СостояниеЗапроса = Перечисления.СостояниеЗавкиНаДеталь.ПолученОтвет Тогда 
				
				об = РезультатЗапроса.ссылка.получитьОбъект();
				Если не об.СостояниеЗапроса  = Перечисления.СостояниеЗавкиНаДеталь.НаУтверждении и не об.СостояниеЗапроса = Перечисления.СостояниеЗавкиНаДеталь.ДетальЗаказана Тогда 
					об.СостояниеЗапроса = Перечисления.СостояниеЗавкиНаДеталь.ПолученОтвет;
				КонецЕсли;
				
				Если не об.СостояниеЗапроса = Перечисления.СостояниеЗавкиНаДеталь.ДетальЗаказана и об.СостояниеЗапроса  = Перечисления.СостояниеЗавкиНаДеталь.НаУтверждении Тогда 
					Если Врег(Прав(Письмо.ссылка.Тема,70)) = Врег("Просьба подтвердить закупку деталей по запросу на запчасть ["+РезультатЗапроса.ссылка.номер+"]") Тогда 
						об.СостояниеЗапроса = Перечисления.СостояниеЗавкиНаДеталь.ДетальЗаказана;
						Задача = Задачи.БП_ЗадачиИсполнителей.СоздатьЗадачу();
						Задача.Дата = ТекущаяДата();
						Задача.Наименование ="Сформировать заказы по запросу";
						Задача.ЗапросНаДеталь = об.ссылка;
						Задача.Исполнитель    = об.Ответственный;
						Задача.Записать();	
					КонецЕсли;
				КонецЕсли;
				
				Попытка
					об.записать();
				Исключение
				КонецПопытки;
				
				ЗапросПоЗадачам = новый запрос;
				ЗапросПоЗадачам.Текст = "ВЫБРАТЬ
				|	БП_ЗадачиИсполнителей.Ссылка
				|ИЗ
				|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
				|ГДЕ
				|	БП_ЗадачиИсполнителей.Наименование ПОДОБНО &Наименование
				|	И НЕ БП_ЗадачиИсполнителей.Выполнена
				|	И БП_ЗадачиИсполнителей.ЗапросНаДеталь = &ЗапросНаДеталь";
				ЗапросПоЗадачам.УстановитьПараметр("Наименование","Пришел ответ на запрос. Свяжитесь с клиентом");
				ЗапросПоЗадачам.УстановитьПараметр("ЗапросНаДеталь",об.ссылка);
				РезультатЗапросНаЗапчасть = ЗапросПоЗадачам.Выполнить().Выгрузить();
				Если РезультатЗапросНаЗапчасть.Количество()>0 Тогда 
					
				иначе
					ЗадачаПользователю = Задачи.БП_ЗадачиИсполнителей.СоздатьЗадачу();
					ЗадачаПользователю.Наименование   = "Пришел ответ на запрос. Свяжитесь с клиентом";
					ЗадачаПользователю.ЗапросНаДеталь = об.ссылка;
					ЗадачаПользователю.Подразделение  = об.подразделение;
					ЗадачаПользователю.Роль           = Перечисления.БП_РолиИсполнителей.Менеджер;
					ЗадачаПользователю.Исполнитель    = об.ответственный;
					ЗадачаПользователю.Дата 		  = ТекущаяДата();
					ЗадачаПользователю.Записать();
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		ЗапросПоПисьмам = новый запрос;
		ЗапросПоПисьмам.Текст =  "ВЫБРАТЬ
		                         |	ЭлектронноеПисьмоИзменения.Ссылка КАК Ссылка
		                         |ИЗ
		                         |	Документ.ЭлектронноеПисьмо.Изменения КАК ЭлектронноеПисьмоИзменения
		                         |ГДЕ
		                         |	ЭлектронноеПисьмоИзменения.Ссылка.Тема ПОДОБНО &Тема СПЕЦСИМВОЛ ""\""
		                         |	И ЭлектронноеПисьмоИзменения.Ссылка.СтатусПисьма = ЗНАЧЕНИЕ(Перечисление.СтатусыПисем.Полученное)
		                         |	И ЭлектронноеПисьмоИзменения.Узел = &Узел
		                         |
		                         |УПОРЯДОЧИТЬ ПО
		                         |	ЭлектронноеПисьмоИзменения.Ссылка.Дата УБЫВ";
		ЗапросПоПисьмам.УстановитьПараметр("Тема","%\["+РезультатЗапроса.ссылка.номер+"\]%");
		ЗапросПоПисьмам.УстановитьПараметр("Узел", ПланыОбмена.LastMod.НайтиПоКоду("Site"));
		
		
		РезультатЗапросаПоПисьмам = ЗапросПоПисьмам.Выполнить().Выбрать() ;
		
		Пока РезультатЗапросаПоПисьмам.Следующий() цикл
			ЕмейлПользователя  = ry_ОбщиеПроцедуры.ПолучитьАдресЭлектроннойПочтыПользователя(об.Ответственный);
			НовоеПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(НовоеПисьмо,РезультатЗапросаПоПисьмам.Ссылка);
			НовоеПисьмо.УчетнаяЗапись	  = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("robot@7detalei.ru");
			НовоеПисьмо.ВидТекстаПисьма   = Перечисления.ВидыТекстовЭлектронныхПисем.Текст;
			НовоеПисьмо.Дата = ТекущаяДата();
			
			НовоеПисьмо.СтатусПисьма = Перечисления.СтатусыПисем.Исходящее;
			НовоеПисьмо.Дата = ТекущаяДата();
			НовоеПисьмо.КомуТЧ.Очистить();
			НовоеПисьмо.КопииТЧ.Очистить();
			НовоеПисьмо.Кому 			   = ЕмейлПользователя;
			НовоеПисьмо.КомуПредставление  = об.ответственный;
			НовоеПисьмо.КопииПредставление = "";
			НовоеПисьмо.ВидТекстаПисьма = Перечисления.ВидыТекстовЭлектронныхПисем.HTMLСКартинками;
			НовоеПисьмо.ОтправительАдресЭлектроннойПочты  = "parts@7detalei.ru";
			НовоеПисьмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("parts@7detalei.ru");
			НовоеПисьмо.Номер = "";
			НовоеПисьмо.ДатаТранспорта = Дата("00010101");
				
			Получатели = НовоеПисьмо.КомуТЧ.Добавить();
			Получатели.АдресЭлектроннойПочты = ЕмейлПользователя;
			Получатели.Представление 	     = об.ответственный;
			
			Если об.Куратор<> Справочники.Пользователи.ПустаяСсылка() Тогда 
				ЕмейлКуратора =  ry_ОбщиеПроцедуры.ПолучитьАдресЭлектроннойПочтыПользователя(об.Куратор);
				Получатели = НовоеПисьмо.КомуТЧ.Добавить();
				Получатели.АдресЭлектроннойПочты = ЕмейлКуратора;
				Получатели.Представление 	     = об.Куратор;
			КонецЕсли;
			
			Если Найти(РезультатЗапросаПоПисьмам.Ссылка.Тема,"Просьба подтвердить закупку деталей")<>0 Тогда 
				НовоеПисьмо.ТекстПисьма = "Необходимо выкупить запчасти по запросу №" + об.номер + Символы.ПС+Символы.ПС + НовоеПисьмо.ТекстПисьма;
				Получатели = НовоеПисьмо.КомуТЧ.Добавить();
				Получатели.АдресЭлектроннойПочты = ПолучитьАдресЭлектроннойПочты(об.Контрагент);
				Получатели.Представление 	     = об.Контрагент;
				Если об.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Дима запчасти") Тогда  
					Получатели = НовоеПисьмо.КомуТЧ.Добавить();
					Получатели.АдресЭлектроннойПочты = "zokazi.lv@gmail.com";
					Получатели.Представление 	     = "Роберт Бондаренко";
				КонецЕсли;
	            об.СодержаниеЗапроса             = Перечисления.СостояниеЗавкиНаДеталь.ДетальЗаказана;
				об.записать();
				
				//Нужно создать заказ поставщику, но откуда взять номенклатуру?
				//TODO
			КонецЕсли;	
			
			НовоеПисьмо.Записать();
			
			
			ЗапросПоВложениям = новый запрос;
			ЗапросПоВложениям.Текст = "ВЫБРАТЬ
			|	ВложенияЭлектронныхПисем.Ссылка
			|ИЗ
			|	Справочник.ВложенияЭлектронныхПисем КАК ВложенияЭлектронныхПисем
			|ГДЕ
			|	ВложенияЭлектронныхПисем.Объект = &Объект";
			ЗапросПоВложениям.УстановитьПараметр("Объект",РезультатЗапросаПоПисьмам.Ссылка);									  
			
			РезультатЗапросаПоВложениям = ЗапросПоВложениям.Выполнить().Выгрузить();
			
			Если РезультатЗапросаПоВложениям.Количество()> 0 Тогда 
				НовоеПисьмо.ЕстьВложения   = Истина;
				НовоеПисьмо.Записать();
			КонецЕсли;
			
			Для Каждого СтрокаРезультатаЗапросаПоВложениям из РезультатЗапросаПоВложениям цикл
				
				обв = СтрокаРезультатаЗапросаПоВложениям.Ссылка.ПолучитьОбъект();
				обв.Объект = НовоеПисьмо.Ссылка;
				обв.Записать();
				
			КонецЦикла;
			НовоеПисьмо.ОтправитьПисьмо();
			
			УдалениеРегистрацииДанныхПоУзлу(ПланыОбмена.LastMod.НайтиПоКоду("Site"),РезультатЗапросаПоПисьмам.Ссылка);
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры


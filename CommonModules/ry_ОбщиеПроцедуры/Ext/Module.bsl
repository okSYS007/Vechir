		Менеджер = РегистрыСведений.ДеталиБезФотоПоКатегориям.СоздатьМенеджерЗаписи();
		Менеджер.Период= ТекущаяДата();
		ЗаполнитьЗначенияСвойств(Менеджер,строка);
		Менеджер.Записать(Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура РегистрацияКартинокДляОбменаССайтом() Экспорт 
	ЗапросПоКартинкам = новый запрос;
	ЗапросПоКартинкам.Текст = "ВЫБРАТЬ ПЕРВЫЕ 20000
	                          |	RY_КартинкиКОтправкеНаСайт.Картинка
	                          |ИЗ
	                          |	РегистрСведений.RY_КартинкиКОтправкеНаСайт КАК RY_КартинкиКОтправкеНаСайт";
	РезультатЗапросаПоКартинкам = ЗапросПоКартинкам.Выполнить().Выгрузить();
	
	Если РезультатЗапросаПоКартинкам.Количество() Тогда 
		ЗапросПоКоличествуКартинокНаРегистрации = новый запрос;
		ЗапросПоКоличествуКартинокНаРегистрации.Текст = "ВЫБРАТЬ
		                                                |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ХранилищеДополнительнойИнформацииИзменения.Ссылка) КАК КоличествоКартинок
		                                                |ИЗ
		                                                |	Справочник.ХранилищеДополнительнойИнформации.Изменения КАК ХранилищеДополнительнойИнформацииИзменения";
		РезультатЗапросаПоКоличествуКартинокНаРегистрации = ЗапросПоКоличествуКартинокНаРегистрации.Выполнить().Выгрузить();
		
		Если РезультатЗапросаПоКоличествуКартинокНаРегистрации.Количество() Тогда 
			КоличествоЗаписей = РезультатЗапросаПоКоличествуКартинокНаРегистрации[0].КоличествоКартинок;	
			
				Для Каждого Картинка из РезультатЗапросаПоКартинкам цикл
					КартинкаОб = Картинка.Картинка.ПолучитьОбъект();
					Попытка
					КартинкаОб.Записать();
								Менеджер = РегистрыСведений.RY_КартинкиКОтправкеНаСайт.СоздатьМенеджерЗаписи();
					Менеджер.Картинка = КартинкаОб.Ссылка;
					Менеджер.Удалить();
						Исключение
					КонецПопытки;

				КонецЦикла;
				
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Функция ПрисутствуетФото(ХарактеристикаНоменклатура) Экспорт
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ХранилищеДополнительнойИнформации.Ссылка
	               |ИЗ
	               |	Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	               |ГДЕ
	               |	ХранилищеДополнительнойИнформации.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект",ХарактеристикаНоменклатура);				   
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		ЗначениеСвойство = ПолучитьЗначениеСойства(ХарактеристикаНоменклатура,ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("4.Вид комплектации"));	
		Если ЗначениеЗаполнено(ЗначениеСвойство) Тогда 
			Если ЗначениеСвойство = Перечисления.зетаБУВидыКомплектации.ПустаяСсылка() Тогда 
				Возврат истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат истина;
	КонецЕсли;
		
КонецФункции

Функция ПолучитьКоличествоФото(Объект) Экспорт
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ХранилищеДополнительнойИнформации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	               |ГДЕ
	               |	ХранилищеДополнительнойИнформации.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект",Объект);
	
	Возврат Запрос.Выполнить().Выгрузить().Количество();
					   	
КонецФункции

//Функция получающая заказы без Бизнес - процессов
Функция ПолучитьЗаказыБезБП()
	
	ЗапросПоЗаказамВБП = новый запрос;
	ЗапросПоЗаказамВБП.Текст = "ВЫБРАТЬ
	                           |	БП_ОбработкаЗаказа.ЗаказПокупателя
	                           |ИЗ
	                           |	БизнесПроцесс.БП_ОбработкаЗаказа КАК БП_ОбработкаЗаказа";
	МассивЗаказовВБП =  ЗапросПоЗаказамВБП.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаказПокупателя");
	//Отберем все заказы кроме тех которые есть в БП
	
	ЗапросПоЗаказамНеВБП = новый запрос;
	ЗапросПоЗаказамНеВБП.Текст = "ВЫБРАТЬ
	                             |	ЗаказПокупателя.Ссылка КАК Заказ,
	                             |	ЗаказПокупателя.Статус.Код,
	                             |	ЗаказПокупателя.Ссылка,
	                             |	ЗаказПокупателя.Дата
	                             |ИЗ
	                             |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	                             |ГДЕ
	                             |	НЕ ЗаказПокупателя.Ссылка В (&МассивЗаказов)
	                             |	И ЗаказПокупателя.Дата > &Дата
	                             |	И ЗаказПокупателя.Проведен";
	ЗапросПоЗаказамНеВБП.УстановитьПараметр("МассивЗаказов",МассивЗаказовВБП);								 

Функция ЕстьПриход(ЗаказПостацщику,Номенклатура,ХарактеристикаНоменклатуры) Экспорт 
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыПоставщикамОстатки.КоличествоОстаток
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	               |			,
	               |			ЗаказПоставщику = &ЗаказПоставщику
	               |				И Номенклатура = &Номенклатура
	               |				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ЗаказыПоставщикамОстатки";
	Запрос.УстановитьПараметр("ЗаказПоставщику",ЗаказПостацщику);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",ХарактеристикаНоменклатуры);
	
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса[0].КоличествоОстаток = 0  Тогда 
		//Товар пришел
		Возврат Истина;
	Иначе
		//Товар не пришел
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ЕстьПеремещение(ВнутреннийЗаказ,Номенклатура,ХарактеристикаНоменклатуры,Количество)
	
	ЕстьПеремещение = Ложь;
	
	ЗапросПоВнутреннимЗаказам = новый Запрос;
	ЗапросПоВнутреннимЗаказам.Текст = "ВЫБРАТЬ
	                                  |	ВнутренниеЗаказыОстатки.КоличествоОстаток
	                                  |ИЗ
	                                  |	РегистрНакопления.ВнутренниеЗаказы.Остатки(, ВнутреннийЗаказ = &ВнутреннийЗаказ) КАК ВнутренниеЗаказыОстатки";
	ЗапросПоВнутреннимЗаказам.УстановитьПараметр("ВнутреннийЗаказ",ВнутреннийЗаказ);								  
	РезультатЗапроса = ЗапросПоВнутреннимЗаказам.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество()>0 Тогда 
		КоличетсвоОстаток = РезультатЗапроса[0].КоличествоОстаток; 	
		Если КоличетсвоОстаток=0 Тогда 
			ЕстьПеремещение = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Склад =  ВнутреннийЗаказ.Заказчик;
	
	ЗапросПоОстатку = новый запрос;
	ЗапросПоОстатку.Текст = "ВЫБРАТЬ
	                        |	ТоварыНаСкладахОстатки.Номенклатура,
	                        |	ТоварыНаСкладахОстатки.КоличествоОстаток
	                        |ИЗ
	                        |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	                        |			&Дата,
	                        |			Склад = &склад
	                        |				И Номенклатура = &Номенклатура
	                        |				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыНаСкладахОстатки";
	ЗапросПоОстатку.УстановитьПараметр("Дата",ТекущаяДата());
	ЗапросПоОстатку.УстановитьПараметр("Номенклатура",Номенклатура);
	ЗапросПоОстатку.УстановитьПараметр("ХарактеристикаНоменклатуры",ХарактеристикаНоменклатуры);
	ЗапросПоОстатку.УстановитьПараметр("Склад",Склад);
	
	
	РезультатЗапроса = ЗапросПоОстатку.Выполнить().Выгрузить();
	
	
	Если РезультатЗапроса.Количество() > 0 Тогда 
		КоличествоОстаток = РезультатЗапроса[0].КоличествоОстаток;	
	Иначе
		КоличествоОстаток = 0;
	КонецЕсли;
	
	Если КоличествоОстаток >= Количество Тогда 
		ЕстьПеремещение = Истина;
	Иначе
		ЕстьПеремещение = Ложь;	
	КонецЕсли;
	
	
	
	Возврат ЕстьПеремещение;
	
КонецФункции

// Корректировка паука
Процедура УдалитьСтрокуЗаказаИзПаука(КорректировкаОбьект,ЗаказПокупателя,Строка) Экспорт

	// + 52141 ДДГ  3 июня
	ЭтоСтрокаТоварыСТО = (ТипЗнч(Строка) = Тип("ДокументТабличнаяЧастьСтрока.СТО_ЗаказНаряд.Товары"));

	ИмяПоляХарактеристика =
		?(ЭтоСтрокаТоварыСТО, "Характеристика", "ХарактеристикаНоменклатуры");

	СсылкаБП = ПолучитьБизнесПроцессПоЗаказу(ЗаказПокупателя);

	Если ЗначениеЗаполнено(СсылкаБП) Тогда
	// - 52141 ДДГ  3 июня

		об = СсылкаБП.ПолучитьОбъект();
		
		Отбор = новый Структура;
		Отбор.Вставить("Номенклатура",				Строка.Номенклатура);
		Отбор.Вставить("ХарактеристикаНоменклатуры",Строка[ИмяПоляХарактеристика]);
		Отбор.Вставить("Количество",				Строка.Количество);
		
		СтрокиЗаказа = об.СтрокиЗаказа.НайтиСтроки(Отбор);
		
		МассисИндексов = новый Массив;
		
		Для Каждого СтрокаЗАказа из СтрокиЗаказа цикл
			МассисИндексов.Добавить(Об.СтрокиЗаказа.Индекс(СтрокаЗАказа));
		КонецЦикла;
		
		Для Каждого ЭлементМассива из МассисИндексов Цикл
			об.СтрокиЗаказа.Удалить(ЭлементМассива);
		КонецЦикла;	
		об.записать();

	КонецЕсли;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БП_ОбработкаСтрокиЗаказа.Ссылка
	               |ИЗ
	               |	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	               |ГДЕ
	               |	БП_ОбработкаСтрокиЗаказа.Номенклатура = &Номенклатура
	               |	И БП_ОбработкаСтрокиЗаказа.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	               |	И БП_ОбработкаСтрокиЗаказа.Количество = &Количество
	               |	И БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес.ЗаказПокупателя = &ЗаказПокупателя";
	Запрос.УстановитьПараметр("Номенклатура",				Строка.Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",	Строка[ИмяПоляХарактеристика]);
	Запрос.УстановитьПараметр("Количество",					Строка.Количество);
	Запрос.УстановитьПараметр("ЗаказПокупателя",			ЗаказПокупателя);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультатаЗапроса из РезультатЗапроса цикл
		
		БПСтроки = СтрокаРезультатаЗапроса.ссылка.ПолучитьОбъект();
		БПСтроки.Завершен = Истина;
		БПСтроки.статусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.АннулированКлиентом;
		БПСтроки.Записать();
		
				
		ЗапросПоЗадачамБП = новый запрос;
		ЗапросПоЗадачамБП.Текст = "ВЫБРАТЬ
		|	БП_ЗадачиИсполнителей.Ссылка
		|ИЗ
		|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
		|ГДЕ
		|	БП_ЗадачиИсполнителей.БизнесПроцесс = &БизнесПроцесс";
		ЗапросПоЗадачамБП.УстановитьПараметр("БизнесПроцесс",СтрокаРезультатаЗапроса.ссылка);
		РезультатЗапросаПоЗадачам = ЗапросПоЗадачамБП.Выполнить().Выгрузить();
		Для Каждого СтрокаЗадачи  из РезультатЗапросаПоЗадачам цикл
			ЗадачаОб = СтрокаЗадачи.Ссылка.получитьОбъект();
			ЗадачаОб.Удалить();
		КонецЦикла;
	
	КонецЦикла;

	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РезервированиеТоваров.Ссылка
	               |ИЗ
	               |	Документ.РезервированиеТоваров КАК РезервированиеТоваров
	               |ГДЕ
	               |	РезервированиеТоваров.Заказ = &Заказ
	               |	И РезервированиеТоваров.Товары.Номенклатура = &Номенклатура
	               |	И РезервированиеТоваров.Товары.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры";
	Запрос.УстановитьПараметр("Заказ",ЗаказПокупателя);
	Запрос.УстановитьПараметр("Номенклатура",Строка.Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",строка.ХарактеристикаНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();					   
	
	Для каждого СтрокаРезультат из РезультатЗапроса цикл
		об = СтрокаРезультат.Ссылка.ПолучитьОбъект();
		//об.ОбменДанными.Загрузка = Истина;
		об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Попытка
		об.удалить();
	Исключение
		КонецПопытки;
	КонецЦикла;

	СтрокаКорректировка = КорректировкаОбьект.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаКорректировка,строка);
	СтрокаКорректировка.ХарактеристикаНоменклатуры      = Строка[ИмяПоляХарактеристика];
	СтрокаКорректировка.ЕдиницаИзмерения = СтрокаКорректировка.Номенклатура.ЕдиницаХраненияОстатков;
	СтрокаКорректировка.КоличествоМест 	 = -1*СтрокаКорректировка.Количество;
	СтрокаКорректировка.Количество 	   	 = -1*СтрокаКорректировка.Количество;
	СтрокаКорректировка.Сумма 		     = СтрокаКорректировка.Сумма*-1;

КонецПроцедуры


 // отрезаем все что не body
 Позиция = Найти(Текст, "<body");
 Если Позиция > 0 Тогда
  Текст = Сред(Текст, Позиция + 5);
  ИсходныйТекст = Сред(ИсходныйТекст, Позиция + 5);

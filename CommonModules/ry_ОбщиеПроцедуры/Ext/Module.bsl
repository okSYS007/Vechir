Процедура ЗакрытьОткрытьСмену() Экспорт 
	Перем ФР;
	   перем глСерверТО;
		ПолучитьСерверТОЛокал(глСерверТО).ПодключитьКлиента(Документы.ОплатаОтПокупателяПлатежнойКартой.ПолучитьФорму("ФормаДокумента"));
		Если Не ПолучитьПроверитьПараметрыДляПробитияЧекаЛок(ФР) Тогда
			Возврат;
		КонецЕсли;
		Результат = ПолучитьСерверТОЛокал(глСерверТО).ОтчетСГашением(ФР, ПолучитьСерверТОЛокал(глСерверТО).ПолучитьПарольКассираККМ());
		Результат = ПолучитьСерверТОЛокал(глСерверТО).ОткрытьСменну(ФР);
						
	

Процедура ОбработатьЗадачиВыдатьТовары(Знач пЗаказПокупателя = NULL) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БП_ЗадачиИсполнителей.Ссылка,
	|	БП_ЗадачиИсполнителей.БизнесПроцесс,
	|	БП_ЗадачиИсполнителей.ЗаказПокупателя,
	|	МИНИМУМ(ISNULL(БП_ОбработкаСтрокиЗаказа.Завершен, ЛОЖЬ)) КАК Завершить,
	|	МАКСИМУМ(ЭлектронныйСчет.ОплатаQRкодом) КАК ОплатаQRкодом
	|ИЗ
	|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
	|		ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	|		ПО БП_ЗадачиИсполнителей.БизнесПроцесс = БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйСчет КАК ЭлектронныйСчет
	|		ПО БП_ЗадачиИсполнителей.ЗаказПокупателя = ЭлектронныйСчет.Сделка
	|ГДЕ
	|	НЕ БП_ЗадачиИсполнителей.Выполнена
	|	 И БП_ЗадачиИсполнителей.БизнесПроцесс ССЫЛКА БизнесПроцесс.БП_ОбработкаЗаказа
	|	 И БП_ЗадачиИсполнителей.ТипЗадачи = ЗНАЧЕНИЕ(Перечисление.БП_ТипыЗадач.ВыдатьТовар)
	|	 И ВЫБОР
	|		КОГДА &ЗаказПокупателя IS NULL
	|		ТОГДА ИСТИНА
	|		ИНАЧЕ БП_ЗадачиИсполнителей.ЗаказПокупателя = &ЗаказПокупателя
	|	КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	БП_ЗадачиИсполнителей.Ссылка,
	|	БП_ЗадачиИсполнителей.БизнесПроцесс
	|";

	пЗаказПокупателя = ?(ЗначениеЗаполнено(пЗаказПокупателя), пЗаказПокупателя, NULL);

	Запрос.УстановитьПараметр("ЗаказПокупателя", пЗаказПокупателя);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаРезультата = РезультатЗапроса.Выбрать();

	Пока ВыборкаРезультата.Следующий() Цикл

		Если НЕ ВыборкаРезультата.Завершить Тогда
			Продолжить;
		КонецЕсли;

//		эСсылка = Документы.ЭлектронныйСчет.НайтиПоРеквизиту("Сделка", ВыборкаРезультата.ЗаказПокупателя);

//		Если НЕ ЗначениеЗаполнено(эСсылка) Тогда
//			Продолжить;
//		КонецЕсли;

		ЗаказПокупателя = ВыборкаРезультата.ЗаказПокупателя;
		ОплатаQRкодом   = ВыборкаРезультата.ОплатаQRкодом;

		ВидОплаты = ?(ОплатаQRкодом, Справочники.ВидыОплатЧекаККМ.QRкод, Справочники.ВидыОплатЧекаККМ.Сайт);
		ТипЧека   = Перечисления.ТипыЧеков.ЗачетПредоплаты;

		СтруктураВозврата = Документы.РеализацияТоваровУслуг.ВыполнитьПродажуПоЗаказу(
			  ЗаказПокупателя
			, ВидОплаты
			, ТипЧека
			, Ложь
			, Истина
			, Ложь
			, Истина
		);

		СтатусОшибки  = РазработкаСервер.ИзвлечьСвойствоИзСтруктуры(СтруктураВозврата, "Ошибка"		, Истина, Истина);
		ТекстОшибки   = РазработкаСервер.ИзвлечьСвойствоИзСтруктуры(СтруктураВозврата, "ТекстОшибки", ""	, Истина);

		Если СтатусОшибки Тогда
			Сообщить(ТекстОшибки);
		КонецЕсли;

//		Если НЕ СтатусОшибки Тогда

//			ОбъектЗадачи = ВыборкаРезультата.Ссылка.ПолучитьОбъект();
//			ОбъектЗадачи.ВыполнитьЗадачу();

//			ОбъектБП = ВыборкаРезультата.БизнесПроцесс.ПолучитьОбъект();
//			ОбъектБП.Завершен		= Истина;
//			ОбъектБП.СтатусЗаказа	= Перечисления.БП_СтатусыЗаказов.ЗаказВыполнен;
//			ОбъектБП.Записать();

//		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ВсеПодмножества(Множество)
	Ответ = Новый Массив;
	Ответ.Добавить(Новый СписокЗначений);
	Для ИндексЭлемента = 0 По Множество.Количество()-1 Цикл
		Для ИндексВарианта = 0 По Ответ.Количество()-1 Цикл
			Ответ.Добавить(Ответ[ИндексВарианта].Скопировать());
			Ответ[ИндексВарианта].Добавить(Множество[ИндексЭлемента])
		КонецЦикла
	КонецЦикла;
	Возврат Ответ
КонецФункции

Процедура ЗаполнитьПоПрименямости(ГруппаКроссов,Наименование,КаталогРодитель)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПрименяемостьМодели.Модель.Владелец КАК Производитель
	               |ИЗ
	               |	РегистрСведений.ПрименяемостьМодели КАК ПрименяемостьМодели
	               |ГДЕ
	               |	НЕ ПрименяемостьМодели.Модель.Владелец ЕСТЬ NULL
	               |	И ПрименяемостьМодели.ГруппаКроссов = &ГруппаКроссов";
	ЗАпрос.УстановитьПараметр("ГруппаКроссов",ГруппаКроссов);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультата из РезультатЗапроса цикл
		марка =  СтрокаРезультата.Производитель.Ссылка;
		
		ЭлементКаталогаВсеЗапчастиМарка = Справочники.СайтКаталог.НайтиПоНаименованию("Все запчасти "+Марка,Истина,КаталогРодитель);
		Если ЭлементКаталогаВсеЗапчастиМарка.Пустая() Тогда 
			ЭлементКаталогаВсеЗапчастиМарка              = Справочники.СайтКаталог.СоздатьГруппу();
			ЭлементКаталогаВсеЗапчастиМарка.Родитель     = КаталогРодитель;
			ЭлементКаталогаВсеЗапчастиМарка.Наименование = "Все запчасти "+Марка;
			ЭлементКаталогаВсеЗапчастиМарка.Записать();
		КонецЕсли;
		ЗаполнитьТоварами(ЭлементКаталогаВсеЗапчастиМарка,ГруппаКроссов,,,);
		
		ЭлементКаталогаМарка = Справочники.СайтКаталог.НайтиПоНаименованию(""+Наименование+" "+Марка,Истина,ЭлементКаталогаВсеЗапчастиМарка.Ссылка);
		Если ЭлементКаталогаМарка.Пустая() Тогда 
			ЭлементКаталогаМарка              = Справочники.СайтКаталог.СоздатьГруппу();
			ЭлементКаталогаМарка.Родитель     = ЭлементКаталогаВсеЗапчастиМарка;
			ЭлементКаталогаМарка.Наименование = ""+Наименование+" "+Марка;
			ЭлементКаталогаМарка.Записать();
		КонецЕсли;
		ЗаполнитьТоварами(ЭлементКаталогаМарка.Ссылка,ГруппаКроссов,,,);

		ЗапросПоМаркам = новый запрос;
		ЗапросПоМаркам.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		                       |	ПрименяемостьМодели.Модель
		                       |ИЗ
		                       |	РегистрСведений.ПрименяемостьМодели КАК ПрименяемостьМодели
		                       |ГДЕ
		                       |	ПрименяемостьМодели.Модель.Владелец = &Владелец
		                       |	И ПрименяемостьМодели.ГруппаКроссов = &ГруппаКроссов";
		ЗапросПоМаркам.УстановитьПараметр("ГруппаКроссов",ГруппаКроссов);
		ЗапросПоМаркам.УстановитьПараметр("Владелец",Марка);
		
		РезультатЗапросаПоМарке = ЗапросПоМаркам.Выполнить().Выгрузить();
		Для каждого СтрокаРезультатаМарка из РезультатЗапросаПоМарке цикл
			
			ВыборкаМодели = СтрокаРезультатаМарка.Модель;
			
			Модель = ВыборкаМодели.Ссылка;
			ЭлементКаталогаВсеЗапчастиМодель = Справочники.СайтКаталог.НайтиПоНаименованию("Все запчасти "+Марка+" "+Модель,Истина,ЭлементКаталогаМарка.Ссылка);
			Если ЭлементКаталогаВсеЗапчастиМодель.Пустая() Тогда 
				ЭлементКаталогаВсеЗапчастиМодель              = Справочники.СайтКаталог.СоздатьГруппу();
				ЭлементКаталогаВсеЗапчастиМодель.Родитель     = ЭлементКаталогаМарка.Ссылка;
				ЭлементКаталогаВсеЗапчастиМодель.Наименование = "Все запчасти "+Марка+" "+Модель;
				ЭлементКаталогаВсеЗапчастиМодель.Записать();				
			КонецЕсли;
			ЗаполнитьТоварами(ЭлементКаталогаВсеЗапчастиМодель.Ссылка,ГруппаКроссов,,,);
			
			ЭлементКаталогаМодель = Справочники.СайтКаталог.НайтиПоНаименованию(""+Наименование+" "+Марка+" "+Модель,Истина,ЭлементКаталогаВсеЗапчастиМодель.Ссылка);
			Если ЭлементКаталогаМодель.Пустая() Тогда 
				ЭлементКаталогаМодель              = Справочники.СайтКаталог.СоздатьГруппу();
				ЭлементКаталогаМодель.Родитель     = ЭлементКаталогаВсеЗапчастиМодель.Ссылка;
				ЭлементКаталогаМодель.Наименование = ""+Наименование+" "+Марка+" "+Модель;
				ЭлементКаталогаМодель.Записать();				
			КонецЕсли;
			ЗаполнитьТоварами(ЭлементКаталогаМодель.Ссылка,ГруппаКроссов,,,);
		КонецЦикла;
	КонецЦикла;		
КонецПроцедуры


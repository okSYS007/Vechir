//////////////////////// ABC-классификация ////////////////////////
Функция ПолучитьКоефициентНаценки(Цена,Номенклатура) Экспорт 
	Коеф = 0;
	Группа= Неопределено;
	ЗапросПоГруппе = новый Запрос;
	ЗапросПоГруппе.Текст =  "ВЫБРАТЬ
	                        |	ABCКлассификацияНоменклатуры.Группа
	                        |ИЗ
	                        |	РегистрСведений.ABCКлассификацияНоменклатуры КАК ABCКлассификацияНоменклатуры
	                        |ГДЕ
	                        |	ABCКлассификацияНоменклатуры.Номенклатура = &Номенклатура";
	ЗапросПоГруппе.УстановитьПараметр("Номенклатура",Номенклатура);
	
	РезультатЗапроса = ЗапросПоГруппе.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество()>0 Тогда 
		
		Группа = РезультатЗапроса[0].Группа;
		
	КонецЕсли;
	
	Если Группа = Неопределено Тогда 
		
	ИначеЕсли Группа = Перечисления.ABCDКласификацияНоменклатуры.A Тогда 
		Если Цена> 1 и Цена<=100 Тогда 
			Коеф = 1.3;	
		ИначеЕсли Цена> 100 и Цена<=500  Тогда 
			Коеф = 1.2;	
		ИначеЕсли Цена> 500 и Цена<=1000  Тогда 
			Коеф = 1.1;	
		Иначе 
			Коеф = 0;	
		КонецЕсли;
	ИначеЕсли Группа = Перечисления.ABCDКласификацияНоменклатуры.B Тогда 
		Если Цена> 1 и Цена<=100 Тогда 
			Коеф = 1.1;	
		ИначеЕсли Цена> 100 и Цена<=500  Тогда 
			Коеф = 1;	
		ИначеЕсли Цена> 500 и Цена<=1000  Тогда 
			Коеф = 0.9;	
		Иначе 
			Коеф = 0;	
		КонецЕсли;
	ИначеЕсли Группа = Перечисления.ABCDКласификацияНоменклатуры.C Тогда 
		Если Цена> 1 и Цена<=100 Тогда 
			Коеф = 0.9;	
		ИначеЕсли Цена> 100 и Цена<=500  Тогда 
			Коеф = 0.8;	
		ИначеЕсли Цена> 500 и Цена<=1000  Тогда 
			Коеф = 0.7;	
		Иначе 
			Коеф = 0;	
		КонецЕсли;
	ИначеЕсли Группа = Перечисления.ABCDКласификацияНоменклатуры.D Тогда 
		Если Цена> 1 и Цена<=100 Тогда 
			Коеф = 0.6;	
		ИначеЕсли Цена> 100 и Цена<=500  Тогда 
			Коеф = 0.6;	
		ИначеЕсли Цена> 500 и Цена<=1000  Тогда 
			Коеф = 0.6;	
		Иначе 
			Коеф = 0;	
		КонецЕсли;
	ИначеЕсли Группа = Перечисления.ABCDКласификацияНоменклатуры.E Тогда 
		Если Цена> 1 и Цена<=100 Тогда 
			Коеф = 1.3;	
		ИначеЕсли Цена> 100 и Цена<=500  Тогда 
			Коеф = 1.3;	
		ИначеЕсли Цена> 500 и Цена<=1000  Тогда 
			Коеф = 1.3;	
		Иначе 
			Коеф = 0;	
		КонецЕсли;

		
	КонецЕсли;	
	Возврат 1;	
КонецФункции


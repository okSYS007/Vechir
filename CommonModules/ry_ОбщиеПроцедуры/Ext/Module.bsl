Функция ПолучитьБизнесПроцессПоЗаказу(ЗаказПокупателя) Экспорт
	
ЗапросПоБП = новый запрос;
ЗапросПоБП.Текст = "ВЫБРАТЬ
                   |	БП_ОбработкаЗаказа.Ссылка
                   |ИЗ
                   |	БизнесПроцесс.БП_ОбработкаЗаказа КАК БП_ОбработкаЗаказа
                   |ГДЕ
                   |	БП_ОбработкаЗаказа.ЗаказПокупателя = &ЗаказПокупателя";
ЗапросПоБП.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);

РезультатЗапроса = ЗапросПоБП.Выполнить().Выгрузить();

Если РезультатЗапроса.Количество()>0 Тогда 
	Возврат РезультатЗапроса[0].ссылка;
Иначе 
	Возврат БизнесПроцессы.БП_ОбработкаЗаказа.ПустаяСсылка();
КонецЕсли;


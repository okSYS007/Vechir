Функция ИзвлечьДанныеИзСтроки(Строка)
	Строка = СтрЗаменить(Строка,"|",Символы.ПС);	
	Строка = СтрПолучитьСтроку(Строка,2);
	
	Возврат Строка;
КонецФункции
	
Функция ПолучитьСлучайныйКод(Длина) Экспорт 
	
	СтрокаВозврата = Число(СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(ТекущаяДата()),".",""),":","")," ",""));
	
	ГСЧ = Новый ГенераторСлучайныхЧисел;
	СлучЧисло = ГСЧ.СлучайноеЧисло(1, 9);
	
	СтрокаВозврата = Цел(СтрокаВозврата/СлучЧисло);
	СтрокаВозврата = Прав(СтрЗаменить(СтрокаВозврата,Символы.НПП,""),5);
	Возврат СтрокаВозврата;
		
КонецФункции

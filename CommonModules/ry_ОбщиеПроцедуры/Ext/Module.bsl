Функция ПолучитьОстатокТовара(Номенклатура, Характеристика = Неопределено, СкладИлиМассив = Неопределено, Дата = Неопределено) Экспорт

	ВсеСклады = Ложь;
	МассивСкладов = СкладИлиМассив;

	Если ТипЗнч(МассивСкладов) = Тип("Массив") Тогда
		// ничего не делаем

	ИначеЕсли ТипЗнч(МассивСкладов) = Тип("СправочникСсылка.Склады") Тогда
		Склад = МассивСкладов;
		МассивСкладов = Новый Массив;
		МассивСкладов.Добавить(Склад);

	ИначеЕсли МассивСкладов = Неопределено
	 ИЛИ МассивСкладов = NULL
	 ИЛИ ТипЗнч("МассивСкладов") = Тип("Булево")
	Тогда
		ВсеСклады = Истина;

	Иначе
		ВызватьИсключение "ПолучитьОстатокТовара параметр неверного типа: МассивСкладов " + МассивСкладов;
	КонецЕсли;

	Если Характеристика = Неопределено Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Остаток = 0;

	Запрос = Новый Запрос;
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|		&Дата
		|		, Номенклатура = &Номенклатура
		|		И ХарактеристикаНоменклатуры = &Характеристика
		|		И ВЫБОР
		|			КОГДА &ВсеСклады
		|			ТОГДА ИСТИНА
		|			ИНАЧЕ Склад В (&МассивСкладов)
		|		КОНЕЦ
		|) КАК ТоварыНаСкладахОстатки
	|";
	Запрос.УстановитьПараметр("Номенклатура"	, Номенклатура);
	Запрос.УстановитьПараметр("Характеристика"	, Характеристика);
	Запрос.УстановитьПараметр("МассивСкладов"	, МассивСкладов);
	Запрос.УстановитьПараметр("ВсеСклады"		, ВсеСклады);
	Запрос.УстановитьПараметр("Дата"			, Дата);

	РезультатЗапроса = Запрос.Выполнить();

	Если НЕ РезультатЗапроса.Пустой() Тогда 
		Остаток = РезультатЗапроса.Выгрузить()[0].КоличествоОстаток;
	КонецЕсли;

	Возврат Остаток;

КонецФункции

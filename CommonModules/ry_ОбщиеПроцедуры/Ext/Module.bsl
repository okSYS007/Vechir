Функция ПолучитьАдресЭлектроннойПочты_БезУчетаАккаунтов(Контрагент) Экспорт 
	Адрес = "";
	
	ЗапросПоАдресу = Новый запрос;
	ЗапросПоАдресу.Текст= "ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Вид = &Вид";
	ЗапросПоАдресу.УстановитьПараметр("Объект",Контрагент);	
	ЗапросПоАдресу.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);	
	ЗапросПоАдресу.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Адрес для маркетинговой рассылки"));	
																									 
	РезультетЗапроса = ЗапросПоАдресу.Выполнить().Выгрузить();
	
	Если РезультетЗапроса.Количество()>0 Тогда 
		Адрес = РезультетЗапроса[0].Представление; 	
	Иначе 
		ЗапросПоАдресу = Новый запрос;
		ЗапросПоАдресу.Текст= "ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Вид = &Вид";
		ЗапросПоАдресу.УстановитьПараметр("Объект",Контрагент);	
		ЗапросПоАдресу.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);	
		ЗапросПоАдресу.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами);	
		
		РезультетЗапроса = ЗапросПоАдресу.Выполнить().Выгрузить();
		
		Если РезультетЗапроса.Количество()>0 Тогда 
			Адрес = РезультетЗапроса[0].Представление;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Адрес = "" Тогда 
		Запрос = новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СайтПользователиКонтрагенты.Пользователь.ЭлектроннаяПочта как ЭлектроннаяПочта
		               |ИЗ
		               |	РегистрСведений.СайтПользователиКонтрагенты КАК СайтПользователиКонтрагенты
		               |ГДЕ
		               |	СайтПользователиКонтрагенты.Контрагент = &Контрагент";
		Запрос.УстановитьПараметр("Контрагент",Контрагент);
		
		РезультатЗапроса = запрос.Выполнить().Выгрузить();
		Если РезультатЗапроса.Количество() Тогда 
			Адрес = РезультатЗапроса[0].ЭлектроннаяПочта;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Адрес;
КонецФункции


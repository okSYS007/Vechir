КонецФункции

Функция ЕстьОплата(ЗаказПокупателя) Экспорт 
	
	ВозвращаемоеЗначение = Ложь;
	
	СуммаДолгаПоКорректировке = 0;
	
	ЗапросПоСуммеКорректировки = новый Запрос;
	ЗапросПоСуммеКорректировки.Текст = "ВЫБРАТЬ
	                                   |	ЕСТЬNULL(СУММА(КорректировкаЗаказаПокупателя.СуммаДокумента), 0) КАК СуммаДокумента
	                                   |ИЗ
	                                   |	Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
	                                   |ГДЕ
	                                   |	КорректировкаЗаказаПокупателя.ЗаказПокупателя = &ЗаказПокупателя
	                                   |	И КорректировкаЗаказаПокупателя.Проведен";
	ЗапросПоСуммеКорректировки.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	
	РезультатЗапросаПоСуммеКорректировки = ЗапросПоСуммеКорректировки.Выполнить().Выгрузить();
	Если РезультатЗапросаПоСуммеКорректировки.Количество()>0 Тогда 
		СуммаДолгаПоКорректировке = РезультатЗапросаПоСуммеКорректировки[0].СуммаДокумента;
	КонецЕсли;
		
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОплатаОтПокупателяПлатежнойКартой.СуммаДокумента КАК СуммаДокумента
	               |ИЗ
	               |	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
	               |ГДЕ
	               |	ОплатаОтПокупателяПлатежнойКартой.Проведен
	               |	И ОплатаОтПокупателяПлатежнойКартой.ДокументОснование = &ЗаказПокупателя
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПлатежноеПоручениеВходящее.СуммаДокумента
	               |ИЗ
	               |	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	               |ГДЕ
	               |	ПлатежноеПоручениеВходящее.Проведен
	               |	И ПлатежноеПоручениеВходящее.РасшифровкаПлатежа.Сделка = &ЗаказПокупателя
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.СуммаДокумента
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.Проведен
	               |	И ПриходныйКассовыйОрдер.РасшифровкаПлатежа.Сделка = &ЗаказПокупателя";
	Запрос.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.следующий() Тогда  
		Если РезультатЗапроса.СуммаДокумента >= ЗаказПокупателя.СуммаДокумента+СуммаДолгаПоКорректировке Тогда 
			//Полученна оплата
			ВозвращаемоеЗначение =  Истина;
		Иначе
			//Не полученна оплата
			ВозвращаемоеЗначение =  Ложь;
		КонецЕсли;
	Иначе
		ВозвращаемоеЗначение =  Ложь;
	КонецЕсли;
	
	////Если ЗначениеЗаполнено(ЗаказПокупателя) И ЗаказПокупателя.ВалютаДокумента.код <> "" Тогда 
	////	 ВозвращаемоеЗначение = Ложь;
	////КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции

Функция ЕстьПредоплата(ЗаказПокупателя) Экспорт 
	
	
	СуммаДолгаПоКорректировке = 0;
	
	ЗапросПоСуммеКорректировки = новый Запрос;
	ЗапросПоСуммеКорректировки.Текст = "ВЫБРАТЬ
	                                   |	ЕСТЬNULL(СУММА(ЕСТЬNULL(КорректировкаЗаказаПокупателя.СуммаДокумента, 0)), 0) КАК СуммаДокумента
	                                   |ИЗ
	                                   |	Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
	                                   |ГДЕ
	                                   |	КорректировкаЗаказаПокупателя.ЗаказПокупателя = &ЗаказПокупателя";
	ЗапросПоСуммеКорректировки.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	
	РезультатЗапросаПоСуммеКорректировки = ЗапросПоСуммеКорректировки.Выполнить().Выгрузить();
	Если РезультатЗапросаПоСуммеКорректировки.Количество()>0 Тогда 
		СуммаДолгаПоКорректировке = РезультатЗапросаПоСуммеКорректировки[0].СуммаДокумента;
	КонецЕсли;

	
	ВсеЕдиницыЕстьНаОстатке = Истина;
	Для каждого СтрокаЗаказа из ЗаказПокупателя.товары цикл
		Запрос = новый запрос;
		запрос.Текст= "ВЫБРАТЬ
		              |	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
		              |ИЗ
		              |	РегистрНакопления.ТоварыНаСкладах.Остатки(
		              |			&Период,
		              |			Номенклатура = &Номенклатура
		              |				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		              |				И Склад = &Склад) КАК ТоварыНаСкладахОстатки";
		Запрос.УстановитьПараметр("Период",ЗаказПокупателя.дата);
		Запрос.УстановитьПараметр("Склад",СтрокаЗаказа.Склад);
		Запрос.УстановитьПараметр("Номенклатура",СтрокаЗаказа.Номенклатура);
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",СтрокаЗаказа.ХарактеристикаНоменклатуры);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество()> 0 Тогда 
			Если РезультатЗапроса[0].КоличествоОстаток >= СтрокаЗаказа.Количество Тогда 
			иначе
				ВсеЕдиницыЕстьНаОстатке = Ложь;	
			КонецЕсли;
		иначе
			ВсеЕдиницыЕстьНаОстатке = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	
	
	ВозвращаемоеЗначение = Ложь;
	
	если ВсеЕдиницыЕстьНаОстатке Тогда  
		Запрос = новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СУММА(ЕСТЬNULL(ВложенныйЗапрос.СуммаДокумента, 0)) КАК СуммаДокумента
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		СУММА(ОплатаОтПокупателяПлатежнойКартой.СуммаДокумента) КАК СуммаДокумента
		               |	ИЗ
		               |		Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
		               |	ГДЕ
		               |		ОплатаОтПокупателяПлатежнойКартой.Проведен
		               |		И ОплатаОтПокупателяПлатежнойКартой.ДокументОснование = &ЗаказПокупателя
		               |	
		               |	ОБЪЕДИНИТЬ ВСЕ
		               |	
		               |	ВЫБРАТЬ
		               |		СУММА(ПлатежноеПоручениеВходящее.СуммаДокумента)
		               |	ИЗ
		               |		Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
		               |	ГДЕ
		               |		ПлатежноеПоручениеВходящее.Проведен
		               |		И ПлатежноеПоручениеВходящее.РасшифровкаПлатежа.Сделка = &ЗаказПокупателя
		               |	
		               |	ОБЪЕДИНИТЬ ВСЕ
		               |	
		               |	ВЫБРАТЬ
		               |		СУММА(ПриходныйКассовыйОрдер.СуммаДокумента)
		               |	ИЗ
		               |		Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		               |	ГДЕ
		               |		ПриходныйКассовыйОрдер.Проведен
		               |		И ПриходныйКассовыйОрдер.РасшифровкаПлатежа.Сделка = &ЗаказПокупателя) КАК ВложенныйЗапрос";
		Запрос.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество()>0 Тогда  
			Если РезультатЗапроса[0].СуммаДокумента >= (ЗаказПокупателя.СуммаДокумента+СуммаДолгаПоКорректировке)-(ЗаказПокупателя.СуммаДокумента+СуммаДолгаПоКорректировке)/100*70  Тогда 
				//Есть предоплата
				ВозвращаемоеЗначение = Истина;
			Иначе
				//Нет предоплаты
				ВозвращаемоеЗначение = Ложь;
			КонецЕсли;
		Иначе
			ВозвращаемоеЗначение = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаказПокупателя.ВалютаДокумента <> Константы.ВалютаРегламентированногоУчета.Получить() Тогда 
		 ВозвращаемоеЗначение = Ложь;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;	
КонецФункции


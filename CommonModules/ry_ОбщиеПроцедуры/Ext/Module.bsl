Функция ВыбратьКонтактКонтрагента(ФормаВладелец, Контрагент, ТипКонтактнойИнформации) Экспорт

	ФормаВыбора = РегистрыСведений.КонтактнаяИнформация.ПолучитьФормуСписка("ФормаСписка", ФормаВладелец);
	ФормаВыбора.РежимВыбора = Истина;

	ФормаВыбора.РегистрСведенийСписок.Отбор.Объект.Значение = Контрагент;
	ФормаВыбора.РегистрСведенийСписок.Отбор.Объект.Использование = Истина;

	СписокТиповКИ = Новый СписокЗначений;

	Если ТипЗнч(ТипКонтактнойИнформации) = Тип("СписокЗначений") Тогда
		СписокТиповКИ = ТипКонтактнойИнформации;
	Иначе
		СписокТиповКИ.Добавить(ТипКонтактнойИнформации);
	КонецЕсли;

	ФормаВыбора.РегистрСведенийСписок.Отбор.Тип.ВидСравнения = ВидСравнения.ВСписке;
	ФормаВыбора.РегистрСведенийСписок.Отбор.Тип.Значение = СписокТиповКИ;
	ФормаВыбора.РегистрСведенийСписок.Отбор.Тип.Использование = Истина;
	ФормаВыбора.ЭлементыФормы.РегистрСведенийСписок.Колонки.Тип.Видимость = Ложь;

	ВыбранныйКонтакт = ФормаВыбора.ОткрытьМодально();

	Возврат ВыбранныйКонтакт;


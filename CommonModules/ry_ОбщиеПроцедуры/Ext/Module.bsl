Функция ПреобразоватьТаблицуЗначенийВМассив(тзДанные) Экспорт
    
    мсДанные = Новый Массив;
        
    // Запишем в массив
    Для Каждого СтрокаТЗ Из тзДанные Цикл
        
        стСтрокаТаблицы = Новый Структура;
        Для Каждого ИмяКолонки Из тзДанные.Колонки Цикл
            стСтрокаТаблицы.Вставить(ИмяКолонки.Имя, СтрокаТЗ[ИмяКолонки.Имя]);
        КонецЦикла;
        
        мсДанные.Добавить(стСтрокаТаблицы);
        
    КонецЦикла;
    
    Возврат мсДанные;
    
КонецФункции

//// Функция преобразует Массив из структур в ТаблицуЗначений.
////
Функция ПреобразоватьМассивВТаблицуЗначений(мсДанные) Экспорт
    
    тзДанные = Новый ТаблицаЗначений;
    
    Для Каждого ЭлементМассива Из мсДанные Цикл
        // Рисуем колонки для таблицы
        Если тзДанные.Колонки.Количество() = 0 Тогда
            Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
                тзДанные.Колонки.Добавить(ЗначениеСтруктуры.Ключ);
            КонецЦикла;
        КонецЕсли;
        
        // Добавляем данные в таблицу
        НоваяСтрока = тзДанные.Добавить();
        Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
            НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
        КонецЦикла;
    КонецЦикла;
    
    Возврат тзДанные;
    
КонецФункции // ПреобразоватьМассивВТаблицуЗначений()

#Область ТестДрайв

Функция ЭтоЗаказТестДрайв(ЗаказПокупателя) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = (ЗаказПокупателя.СтатусИМ = Перечисления.СтатусыЗаказаИМ.ТестДрайв);
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ТестДрайв", Метаданные.Документы.ЗаказПокупателя) Тогда
		Попытка
			Результат = Результат Или ЗаказПокупателя["ТестДрайв"];
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПризнакТестДрайв(ЗаказПокупателя, ЗначениеПризнака = Истина) Экспорт
	
	Если НЕ ОбщегоНазначения.ЕстьРеквизитДокумента("ТестДрайв", Метаданные.Документы.ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗаказПокупателя["ТестДрайв"] = ЗначениеПризнака;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьСкладТестДрайв() Экспорт
	
	Склад = Справочники.Склады.НайтиПоНаименованию("Тест-драйв", Истина);
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Склад = Справочники.Склады.НайтиПоНаименованию("Тест драйв", Истина);
	КонецЕсли;
	
	Возврат Склад;
	
КонецФункции

Процедура ПроверитьПросроченныеЗаказыТестДрайв() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка,
	|	ЗаказПокупателя.Номер,
	|	ЗаказПокупателя.Дата
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Проведен
	|	И ЗаказПокупателя.Дата <= &ДатаПросрочки
	|	И ЗаказПокупателя.СтатусИМ = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказаИМ.ТестДрайв)";
	Запрос.УстановитьПараметр("ДатаПросрочки", НачалоДня(ТекущаяДата()) - 20 * 24 * 60 * 60);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоздатьЗадачуИПисьмоТестДрайв(Выборка.Ссылка, "Прострочений термін заявки тест-драйв");
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЗадачуИПисьмоТестДрайв(ЗаказПокупателя, ТекстОповещения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачиПользователя.Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	ЗадачиПользователя.Объект = &ЗаказПокупателя
	|	И ЗадачиПользователя.Наименование = &Наименование";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.УстановитьПараметр("Наименование", ТекстОповещения);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ЗадачаОб = Задачи.ЗадачиПользователя.СоздатьЗадачу();
	ЗадачаОб.Дата = ТекущаяДата();
	ЗадачаОб.Объект = ЗаказПокупателя;
	ЗадачаОб.Оповещение = Истина;
	ЗадачаОб.СрокОповещения = ТекущаяДата();
	ЗадачаОб.Наименование = ТекстОповещения;
	ЗадачаОб.Описание = ТекстОповещения + ". Замовлення " + ЗаказПокупателя.Номер + ", order id " + ЗаказПокупателя.OrderID;
	ЗадачаОб.Записать();
	
	ОтправитьПисьмоТестДрайв(ТекстОповещения, ЗадачаОб.Описание);
	
КонецПроцедуры

Процедура ОтправитьПисьмоТестДрайв(ТемаПисьма, ТекстПисьма) Экспорт
	
	Письмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();
	Письмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Автоматична система відправки повідоплень");
	Письмо.ВидТекстаПисьма = Перечисления.ВидыТекстовЭлектронныхПисем.Текст;
	Письмо.Дата = ТекущаяДата();
	Письмо.ЕстьВложения = Ложь;
	Письмо.ЗаголовокПисьма = ТемаПисьма;
	Письмо.Тема = ТемаПисьма;
	Письмо.Кому = "v.ivanov@vechir.ua; s.pichugin@vechir.ua";
	Письмо.КомуПредставление = Письмо.Кому;
	Письмо.ТекстПисьма = ТекстПисьма;
	
	Получатель = Письмо.КомуТЧ.Добавить();
	Получатель.АдресЭлектроннойПочты = "v.ivanov@vechir.ua";
	Получатель.Представление = "v.ivanov@vechir.ua";
	
	Получатель = Письмо.КомуТЧ.Добавить();
	Получатель.АдресЭлектроннойПочты = "s.pichugin@vechir.ua";
	Получатель.Представление = "s.pichugin@vechir.ua";
	
	Письмо.Записать();
	Письмо.ОтправитьПисьмо();
	
КонецПроцедуры

Функция СоздатьПеремещениеТестДрайв(ЗаказПокупателя, СкладОтправитель, СкладПолучатель, Комментарий = "") Экспорт
	
	Если НЕ ЭтоЗаказТестДрайв(ЗаказПокупателя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СкладОтправитель) Или НЕ ЗначениеЗаполнено(СкладПолучатель) Тогда
		ВызватьИсключение "Не заполнен склад отправитель или склад получатель для тест-драйв перемещения.";
	КонецЕсли;
	
	Перемещение = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(Перемещение, глЗначениеПеременной("глТекущийПользователь"));
	ОбщегоНазначения.ЗаполнитьОбязательныеРеквизитыШапкиНовогоДокумента(Перемещение, глЗначениеПеременной("глТекущийПользователь"));
	Перемещение.Дата = ТекущаяДата();
	Перемещение.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.ТоварыПродукция;
	Перемещение.СкладОтправитель = СкладОтправитель;
	Перемещение.СкладПолучатель = СкладПолучатель;
	Перемещение.Организация = ЗаказПокупателя.Организация;
	Перемещение.Ответственный = глЗначениеПеременной("глТекущийПользователь");
	Перемещение.Комментарий = Комментарий;
	
	Для Каждого СтрокаЗаказа Из ЗаказПокупателя.Товары Цикл
		СтрокаПеремещения = Перемещение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПеремещения, СтрокаЗаказа);
		СтрокаПеремещения.Качество = Справочники.Качество.Новый;
	КонецЦикла;
	
	Перемещение.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат Перемещение.Ссылка;
	
КонецФункции

Функция ТестДрайвВстановлено(ЗаказПокупателя) Экспорт
	
	СкладТестДрайв = ПолучитьСкладТестДрайв();
	Возврат СоздатьПеремещениеТестДрайв(
		ЗаказПокупателя,
		ЗаказПокупателя.СкладГруппа,
		СкладТестДрайв,
		"Тест-драйв. Встановлено за замовленням " + ЗаказПокупателя.Номер);
	
КонецФункции

Функция ТестДрайвОтказ(ЗаказПокупателя, Пользователь = Неопределено) Экспорт
	
	Если Пользователь = Неопределено Тогда
		Пользователь = глЗначениеПеременной("глТекущийПользователь");
	КонецЕсли;
	
	СкладТестДрайв = ПолучитьСкладТестДрайв();
	СкладСИ = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойСклад");
	
	Возврат СоздатьПеремещениеТестДрайв(
		ЗаказПокупателя,
		СкладТестДрайв,
		СкладСИ,
		"Тест-драйв. Відмова за замовленням " + ЗаказПокупателя.Номер);
	
КонецФункции

Процедура ПодготовитьЗаказКСписаниюСоСкладаТестДрайв(ЗаказПокупателяОбъект) Экспорт
	
	СкладТестДрайв = ПолучитьСкладТестДрайв();
	Если НЕ ЗначениеЗаполнено(СкладТестДрайв) Тогда
		ВызватьИсключение "Не найден склад Тест-драйв.";
	КонецЕсли;
	
	ЗаказПокупателяОбъект.СкладГруппа = СкладТестДрайв;
	Для Каждого СтрокаТовары Из ЗаказПокупателяОбъект.Товары Цикл
		СтрокаТовары.Размещение = СкладТестДрайв;
	КонецЦикла;
	
КонецПроцедуры

Процедура СписатьТоварыТестДрайвПоОплаченномуЗаказу(ЗаказПокупателя, ПринудительноТестДрайв = Ложь) Экспорт
	
	Если НЕ ПринудительноТестДрайв И НЕ ЭтоЗаказТестДрайв(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказОб = ЗаказПокупателя.ПолучитьОбъект();
	ПодготовитьЗаказКСписаниюСоСкладаТестДрайв(ЗаказОб);
	ЗаказОб.СтатусИМ = Перечисления.СтатусыЗаказаИМ.Завершен;
	ЗаказОб.ДополнительныеСвойства.Вставить("БезКонтроляДатыЗапрета");
	ЗаказОб.Записать(РежимЗаписиДокумента.Проведение);
	
	Документы.РеализацияТоваровУслуг.ВыполнитьПродажуПоЗаказу(
		ЗаказОб.Ссылка,
		Справочники.ВидыОплатЧекаККМ.Сайт,
		Перечисления.ТипыЧеков.ЗачетПредоплаты,
		Ложь,
		Истина,
		Ложь,
		Истина);
	
КонецПроцедуры

Процедура ТестДрайвПринятьОплату(ЗаказПокупателя) Экспорт
	
	СписатьТоварыТестДрайвПоОплаченномуЗаказу(ЗаказПокупателя, Истина);
	
КонецПроцедуры

#КонецОбласти








Процедура АвторассылкаВыгрузкаПрайсов() Экспорт 
	
	ЗапросПоАктивнымНастройкам = новый Запрос;
	ЗапросПоАктивнымНастройкам.Текст =  "ВЫБРАТЬ
	                                    |	НастрокиВыгрузки.Ссылка
	                                    |ИЗ
	                                    |	Справочник.НастрокиВыгрузки КАК НастрокиВыгрузки
	                                    |ГДЕ
	                                    |	НастрокиВыгрузки.Активность
	                                    |	И НЕ НастрокиВыгрузки.ПометкаУдаления
	                                    |	И НастрокиВыгрузки.Сохранять = 2
	                                    |	И НастрокиВыгрузки.ВыгружатьПоРасписанию";
	РезультатЗапроса = ЗапросПоАктивнымНастройкам.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультата из РезультатЗапроса цикл
		НастройкаВыгрузки = СтрокаРезультата.Ссылка;
		
		Для каждого ВремяВыгрузки из НастройкаВыгрузки.РасписаниеВыгрузки цикл
			Если ВремяВыгрузки.Время-дата("00010101000000")>ТекущаяДата()-НачалоДня(ТекущаяДата())-60*2.5 и ВремяВыгрузки.Время-дата("00010101000000")<ТекущаяДата()-НачалоДня(ТекущаяДата())+60*2.5  Тогда 
				Обработка = Обработки.ВыгрузкаПрайса.Создать();
				НастройкаВыгрузкиСсылка =НастройкаВыгрузки; 
				Обработка.НастройкаВыгрузки = НастройкаВыгрузки;
				ЗаполнитьЗначенияСвойств(Обработка,НастройкаВыгрузки);
				Обработка.НастройкаВыгрузки = НастройкаВыгрузкиСсылка;
				Обработка.Выгрузить(Ложь);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВосстановленеПароля() Экспорт 
ЗапросПоПисьмам = новый запрос;
ЗапросПоПисьмам.Текст = "ВЫБРАТЬ
                        |	ВложенныйЗапрос.Письмо,
                        |	ВложенныйЗапрос.ПисьмоИзРегистра
                        |ИЗ
                        |	(ВЫБРАТЬ
                        |		ЭлектронноеПисьмо.Ссылка КАК Письмо,
                        |		ЛогЗапросовНаВосстановлениеПароля.Письмо КАК ПисьмоИзРегистра
                        |	ИЗ
                        |		Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
                        |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛогЗапросовНаВосстановлениеПароля КАК ЛогЗапросовНаВосстановлениеПароля
                        |			ПО (ЛогЗапросовНаВосстановлениеПароля.Письмо = ЭлектронноеПисьмо.Ссылка)
                        |	ГДЕ
                        |		НЕ ЭлектронноеПисьмо.ПометкаУдаления
                        |		И ЭлектронноеПисьмо.Тема ПОДОБНО ""%Восстановление пароля 7 Деталей%"") КАК ВложенныйЗапрос
                        |ГДЕ
                        |	ВложенныйЗапрос.ПисьмоИзРегистра ЕСТЬ NULL ";
РезультатЗапроса = ЗапросПоПисьмам.Выполнить().Выгрузить();

Для каждого СтрокаТаблицы из РезультатЗапроса цикл	
	Письмо = СтрокаТаблицы.Письмо;
	ТестПисьма = Письмо.ТекстПисьма;
	ТестПисьма = СтрЗаменить(ТестПисьма,"%",Символы.ПС);
	НомерТелефонаСтрока = СтрПолучитьСтроку(ТестПисьма,3);
	НомерТелефона 	    = ИзвлечьДанныеИзСтроки(НомерТелефонаСтрока);
	
	ЗапросПоПаролю = новый Запрос;
	ЗапросПоПаролю.Текст = "ВЫБРАТЬ
	                       |	СайтПользователи.Пароль,
	                       |	СайтПользователи.ЭлектроннаяПочта
	                       |ИЗ
	                       |	Справочник.СайтПользователи КАК СайтПользователи
	                       |ГДЕ
	                       |	СайтПользователи.КонтактныйТелефон = &КонтактныйТелефон";
	ЗапросПоПаролю.УстановитьПараметр("КонтактныйТелефон",СокрЛП(НомерТелефонаСтрока));						   						   	
	РузльтатЗапросаПоПаролю = ЗапросПоПаролю.Выполнить().Выгрузить();
	
	Если РузльтатЗапросаПоПаролю.Количество() Тогда 
		Константы.БП_ИспользуемыйSMSШлюз.Получить().ПолучитьОбъект().отправитьСМС("Ваш пароль доступа на сайт 7Деталей:"+РузльтатЗапросаПоПаролю[0].Пароль,НомерТелефонаСтрока);
		
		
		ЕмейлКлиента  = РузльтатЗапросаПоПаролю[0].ЭлектроннаяПочта;
		
		Письмо1 = Документы.ЭлектронноеПисьмо.СоздатьДокумент();
		Письмо1.УчетнаяЗапись	 = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("robot@7detalei.ru");
		Письмо1.ВидТекстаПисьма   = Перечисления.ВидыТекстовЭлектронныхПисем.Текст;
		Письмо1.Тема 			 = "Восстановление пароля. Интернет магазин ""7detalei.ru""";

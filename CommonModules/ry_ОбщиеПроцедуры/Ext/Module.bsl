Функция ЗаменитьЗапретныеСимволиURL(СтрокаЗНЧ, СимволЗамены = "_") Экспорт
	Если СтрокаЗНЧ = "" Тогда 
		Возврат "";
	КонецЕсли;
	
	URL = СтрокаЗНЧ;
	Пока Истина Цикл 
		Если Найти(URL, "__") Тогда 
			URL = СтрЗаменить(URL,"__", "");
		Иначе 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	URL = СтрЗаменить(URL,Символы.НПП,СимволЗамены); //Неразрывный пробел
	URL = СтрЗаменить(URL,"-",СимволЗамены);
	URL = СтрЗаменить(URL,"+",СимволЗамены);
	URL = СтрЗаменить(URL,"*",СимволЗамены);
	URL = СтрЗаменить(URL,"=",СимволЗамены);
	URL = СтрЗаменить(URL,")",СимволЗамены);
	URL = СтрЗаменить(URL,"(",СимволЗамены);
	URL = СтрЗаменить(URL,"?",СимволЗамены);
	URL = СтрЗаменить(URL,"&",СимволЗамены);
	URL = СтрЗаменить(URL,":",СимволЗамены);
	URL = СтрЗаменить(URL,"^",СимволЗамены);
	URL = СтрЗаменить(URL,"%",СимволЗамены);
	URL = СтрЗаменить(URL,"$",СимволЗамены);
	URL = СтрЗаменить(URL,";",СимволЗамены);
	URL = СтрЗаменить(URL,"#",СимволЗамены);
	URL = СтрЗаменить(URL,"№",СимволЗамены);
	URL = СтрЗаменить(URL,"""",СимволЗамены);
	URL = СтрЗаменить(URL,"@",СимволЗамены);
	URL = СтрЗаменить(URL,"!",СимволЗамены);
	URL = СтрЗаменить(URL,"`",СимволЗамены);
	URL = СтрЗаменить(URL,"~",СимволЗамены);
	URL = СтрЗаменить(URL,".",СимволЗамены);
	URL = СтрЗаменить(URL,",",СимволЗамены);
	URL = СтрЗаменить(URL,"/",СимволЗамены);
	URL = СтрЗаменить(URL,"\",СимволЗамены);
	URL = СтрЗаменить(URL,"|",СимволЗамены);
	URL = СтрЗаменить(URL,"__",СимволЗамены);
	URL = СтрЗаменить(URL," ",СимволЗамены);
	URL = СтрЗаменить(URL,"[",СимволЗамены);
	URL = СтрЗаменить(URL,"]",СимволЗамены);
	URL = СтрЗаменить(URL,"_-_",СимволЗамены);
	URL = СтрЗаменить(URL,"Ü", "u");
	URL = СтрЗаменить(URL,"ö", "o");
	URL = СтрЗаменить(URL,"Ö", "o");
	URL = СтрЗаменить(URL,"ü", "u");
	URL = СтрЗаменить(URL,"ï", "i");
	URL = СтрЗаменить(URL,"ø", "o");
	URL = СтрЗаменить(URL,"ò", "o");
	
	Если Лев(URL, 1) = "_" Тогда 
		URL = Прав(URL, СтрДлина(URL) -1);
	КонецЕсли;
	Если Прав(URL, 1) = "_" Тогда 
		URL = Лев(URL, СтрДлина(URL) -1);
	КонецЕсли;
	
	// + Климентьев 21.09.2020
	Пока Истина Цикл 
		Если Найти(URL, "__") Тогда 
			URL = СтрЗаменить(URL,"__", "_");
		Иначе 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Пока Истина Цикл 
		Если Найти(URL, "/_") Тогда 
			URL = СтрЗаменить(URL,"/_", "/");
		Иначе 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Пока Истина Цикл 
		Если Найти(URL, "_/") Тогда 
			URL = СтрЗаменить(URL,"_/", "/");
		Иначе 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// - Климентьев 21.09.2020
	
	Возврат URL;
	

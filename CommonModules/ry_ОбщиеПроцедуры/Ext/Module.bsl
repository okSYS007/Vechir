 // вырезаем стили
 Позиция = Найти(Текст, "<style");
 Пока Позиция > 0 Цикл
  ПозицияЗакрывающегоТега = Найти(Текст, "</style>");
  Если ПозицияЗакрывающегоТега = 0 Тогда

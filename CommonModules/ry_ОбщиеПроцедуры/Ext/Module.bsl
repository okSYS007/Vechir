Функция ПолучитьДанныеПоследнейУстановленнойЦеныНаТовар(ТипЦен = NULL, Валюта = NULL, СпособРасчетаЦены = NULL, Номенклатура, Характеристика = Неопределено, Дата = Неопределено) Экспорт

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Период"					, Дата(1,1,1));
	СтруктураВозврата.Вставить("ТипЦен"					, Неопределено);
	СтруктураВозврата.Вставить("Валюта"					, Неопределено);
	СтруктураВозврата.Вставить("СпособРасчетаЦены"		, Неопределено);
	СтруктураВозврата.Вставить("ПроцентСкидкиНаценки"	, 0);
	СтруктураВозврата.Вставить("Цена"					, 0);
	СтруктураВозврата.Вставить("ПроцентПродажи"			, 0);

	Если Валюта = NULL И ТипЦен <> NULL Тогда
		Валюта = ТипЦен.ВалютаЦены;
	КонецЕсли;

	Если СпособРасчетаЦены = NULL И ТипЦен <> NULL Тогда
		СпособРасчетаЦены = ТипЦен.СпособРасчетаЦены;
	КонецЕсли;

	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Характеристика = Неопределено Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	ЗапросПоЦене = новый Запрос;
	ЗапросПоЦене.Текст = "
	|ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Период,
	|	ЦеныНоменклатурыСрезПоследних.ТипЦен,
	|	ЦеныНоменклатурыСрезПоследних.Валюта,
	|	ЦеныНоменклатурыСрезПоследних.Цена,
	|	ЦеныНоменклатурыСрезПоследних.ПроцентСкидкиНаценки,
	|	ЦеныНоменклатурыСрезПоследних.СпособРасчетаЦены,
	|	ВЫБОР
	|		КОГДА ЦеныНоменклатурыСрезПоследних.ТипЦен.ИспользоватьПроцентЦеныСвязанногоТовара
	|		ТОГДА 100 + ЦеныНоменклатурыСрезПоследних.ПроцентСкидкиНаценки
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПроцентПродажи
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|		&Дата
	|		, Номенклатура = &Номенклатура
	|		И ХарактеристикаНоменклатуры = &Характеристика
	|		И ВЫБОР
	|			КОГДА &ТипЦен IS NULL
	|			ТОГДА ИСТИНА
	|			ИНАЧЕ ТипЦен = &ТипЦен
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &Валюта IS NULL
	|			ТОГДА ИСТИНА
	|			ИНАЧЕ Валюта = &Валюта
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &СпособРасчетаЦены IS NULL
	|			ТОГДА ИСТИНА
	|			ИНАЧЕ СпособРасчетаЦены = &СпособРасчетаЦены
	|		КОНЕЦ
	|) КАК ЦеныНоменклатурыСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЦеныНоменклатурыСрезПоследних.Период УБЫВ
	|";
	ЗапросПоЦене.УстановитьПараметр("Номенклатура"			, Номенклатура);
	ЗапросПоЦене.УстановитьПараметр("Характеристика"		, Характеристика);
	ЗапросПоЦене.УстановитьПараметр("Дата"					, Дата);
	ЗапросПоЦене.УстановитьПараметр("ТипЦен"				, ТипЦен);
	ЗапросПоЦене.УстановитьПараметр("Валюта"				, Валюта);
	ЗапросПоЦене.УстановитьПараметр("СпособРасчетаЦены"		, СпособРасчетаЦены);

	РезультатЗапроса = ЗапросПоЦене.Выполнить();
	ВыборкаРезульта  = РезультатЗапроса.Выбрать();

	Если ВыборкаРезульта.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, ВыборкаРезульта);
	КонецЕсли;

	Возврат СтруктураВозврата;


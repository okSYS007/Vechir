Функция ПолучитьСоздатьКонтрагента(КонтрагентНаименование,ТелефонКонтрагента,ЕмейлКонтрагента)
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	ТелефонКонтрагента = СтрЗаменить(ТелефонКонтрагента,Символы.ПС,"");
	ТелефонКонтрагента = СтрЗаменить(ТелефонКонтрагента," ","");
	ТелефонКонтрагента = СтрЗаменить(ТелефонКонтрагента,"-","");
	ТелефонКонтрагента = СтрЗаменить(ТелефонКонтрагента,")","");
	ТелефонКонтрагента = СтрЗаменить(ТелефонКонтрагента,"(","");
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Представление ПОДОБНО &Представление";
	Запрос.УстановитьПараметр("Представление",СокрЛП(ТелефонКонтрагента));
	
	РузультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РузультатЗапроса.Количество()>0 Тогда 
		Контрагент = РузультатЗапроса[0].Объект; 
	КонецЕсли;
	
	Если СокрЛП(ЕмейлКонтрагента)<>"" и Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда 
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Представление ПОДОБНО &Представление";
		Запрос.УстановитьПараметр("Представление",СокрЛП(ЕмейлКонтрагента));
		
		РузультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РузультатЗапроса.Количество()>0 Тогда 
			Контрагент = РузультатЗапроса[0].Объект; 
		КонецЕсли;
	КонецЕсли;
	
	
	Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда 
		
		РегистрироватьКонтЛицо = Ложь;
				
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Наименование               = СокрЛП(КонтрагентНаименование);
		НовыйКонтрагент.НаименованиеПолное         = СокрЛП(КонтрагентНаименование);
		НовыйКонтрагент.ЮрФизЛицо                  = Перечисления.ЮрФизЛицо.ФизЛицо;
		НовыйКонтрагент.Покупатель                 = Истина;
		
		Если НовыйКонтрагент.покупатель Тогда  
			НовыйКонтрагент.Родитель               = Справочники.Контрагенты.НайтиПоНаименованию("Клиенты");    
		Иначе
			НовыйКонтрагент.Родитель               = Справочники.Контрагенты.НайтиПоНаименованию("Поставщики");  
		КонецЕсли;
		НовыйКонтрагент.ГруппаДоступаККонтрагенту  = Справочники.ГруппыДоступаККонтрагентам.НайтиПоНаименованию("Менеджеры");
		НовыйКонтрагент.ОсновнойМенеджерПокупателя = глЗначениеПеременной("глТекущийПользователь");
		НовыйКонтрагент.Записать();
		НоваяСтрокаТЧ = НовыйКонтрагент.МенеджерыПокупателя.Добавить();
		НоваяСтрокаТЧ.МенеджерПокупателя = глЗначениеПеременной("глТекущийПользователь");
		
		НачатьТранзакцию();
		
		ФиксироватьТранзакцию = Истина;
		
		НовыйКонтрагент.УстановитьНовыйКод();
		ПроверитьОсновнойДоговорКонтрагента(НовыйКонтрагент,Ложь,Истина);
		//ФормаКонтрагента = НовыйКонтрагент.ПолучитьФорму("ФормаЭлемента");
		//ФормаКонтрагента.НаборКонтактнойИнформации.Отбор.Объект.Установить(НовыйКонтрагент.Ссылка);
		
		НоваяЗапись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		
		НоваяЗапись.Вид    = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		НоваяЗапись.Тип    = Перечисления.ТипыКонтактнойИнформации.Телефон;
		НоваяЗапись.Объект = НовыйКонтрагент.Ссылка;
		НоваяЗапись.Представление = ТелефонКонтрагента;
		НоваяЗапись.Представление = СтрЗаменить(НоваяЗапись.Представление,Символы.ПС,"");
		НоваяЗапись.Представление = СтрЗаменить(НоваяЗапись.Представление," ","");
		НоваяЗапись.Представление = СтрЗаменить(НоваяЗапись.Представление,"-","");
		НоваяЗапись.Представление = СтрЗаменить(НоваяЗапись.Представление,")","");
		НоваяЗапись.Представление = СтрЗаменить(НоваяЗапись.Представление,"(","");

		НоваяЗапись.Записать(Истина);
		Если НЕ ПустаяСтрока(ЕмейлКонтрагента) Тогда
			НоваяЗапись               = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			НоваяЗапись.Вид           = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами;
			НоваяЗапись.Тип           = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			НоваяЗапись.Объект        = НовыйКонтрагент.Ссылка;
			НоваяЗапись.Представление = ЕмейлКонтрагента;
			НоваяЗапись.Записать(Истина);
		КонецЕсли;
		
		//Попытка
		//	ФормаКонтрагента.ЗаписатьВФорме();
		//Исключение
		//	ОбщегоНазначения.СообщитьОбОшибке("Не удалось записать контрагента: " + ОписаниеОшибки());
		//	ФиксироватьТранзакцию = Ложь;
		//КонецПопытки;
		
		// если не записали ничего - значит проблемы аозникли
				
		Если ФиксироватьТранзакцию Тогда
			ЗафиксироватьТранзакцию();
			Контрагент =  НовыйКонтрагент.Ссылка;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Контрагент;
КонецФункции

Функция ПолучитьДоговорКонтрагентаПоПодразделению(Контрагент,Подразделение) Экспорт 
	ЗапросПоОрганизации = Новый запрос;
	ЗапросПоОрганизации.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                            |	ДоговорыКонтрагентов.Ссылка
	                            |ИЗ
	                            |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	                            |ГДЕ
	                            |	ДоговорыКонтрагентов.Организация.Подразделение = &Подразделение
	                            |	И ДоговорыКонтрагентов.Владелец = &Контрагент";
	ЗапросПоОрганизации.УстановитьПараметр("Подразделение",Подразделение);
	ЗапросПоОрганизации.УстановитьПараметр("Контрагент",Контрагент);
	
	РезультатЗапроса = ЗапросПоОрганизации.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		ДоговорКонтрагента = РезультатЗапроса[0].ссылка;
	Иначе
		ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ДоговорКонтрагента;
КонецФункции


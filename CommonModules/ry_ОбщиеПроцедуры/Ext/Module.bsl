Функция ПолучитьЦеныТоваров(ТипЦен, Валюта = Неопределено, МассивТоваров, Дата = Неопределено) Экспорт

	Если МассивТоваров.Количество() < 1 Тогда
		ПустаяТаблица = Новый ТаблицаЗначений;
		КолонкиПТ = ПустаяТаблица.Колонки;
		КолонкиПТ.Добавить("Номенклатура");
		КолонкиПТ.Добавить("ХарактеристикаНоменклатуры");
		КолонкиПТ.Добавить("Цена");
		Возврат ПустаяТаблица;
	КонецЕсли;

	Если Валюта = Неопределено Тогда
		Валюта = ТипЦен.ВалютаЦены;
	КонецЕсли;

	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	ЗапросПоЦене = новый Запрос;
	ЗапросПоЦене.Текст = "
	|
	|ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры
	|ПОМЕСТИТЬ
	|	Товары
	|ИЗ
	|	Справочник.Номенклатура
	|КАК
	|	СпрНоменклатура
	|
	|ГДЕ Ссылка В (&МассивТоваров)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СпрХарактеристики.Владелец КАК Номенклатура,
	|	СпрХарактеристики.Ссылка КАК ХарактеристикаНоменклатуры
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры
	|КАК
	|	СпрХарактеристики
	|
	|ГДЕ Ссылка В (&МассивТоваров)
	|;
	|
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.ХарактеристикаНоменклатуры,
	|	ISNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена
	|ИЗ
	|	Товары
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|		&Дата,
	|		ТипЦен = &ТипЦен
	|		И Валюта = &Валюта
	|		И (Номенклатура, ХарактеристикаНоменклатуры) В (
	|			ВЫБРАТЬ Номенклатура, ХарактеристикаНоменклатуры ИЗ Товары
	|		)
	|) КАК ЦеныНоменклатурыСрезПоследних
	|ПО Товары.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	| И Товары.ХарактеристикаНоменклатуры = ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры
	|
	|";

	ЗапросПоЦене.УстановитьПараметр("МассивТоваров",	МассивТоваров);
	ЗапросПоЦене.УстановитьПараметр("ТипЦен",			ТипЦен);
	ЗапросПоЦене.УстановитьПараметр("Валюта",			Валюта);
	ЗапросПоЦене.УстановитьПараметр("Дата",				Дата);

	РезультатЗапроса = ЗапросПоЦене.Выполнить();

	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	Возврат ТаблицаРезультата;

КонецФункции

Функция ИзвлечьЦенуИзТаблицыЦен(ТаблицаЦен, Номенклатура, Характеристика = Неопределено) Экспорт

	Цена = 0;

	Если Характеристика = Неопределено Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура",				Номенклатура);
	СтруктураПоиска.Вставить("ХарактеристикаНоменклатуры",	Характеристика);

	НайденныеСтроки = ТаблицаЦен.НайтиСтроки(СтруктураПоиска);

	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
		Цена = НайденнаяСтрока.Цена;
	КонецЕсли;

	Возврат Цена;


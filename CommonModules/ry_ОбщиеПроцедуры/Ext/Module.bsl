Функция ПолучитьЗаказыБезБП_Новая()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументЗаказПокупателя.Ссылка,
		|	ДокументЗаказПокупателя.Дата
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ДокументЗаказПокупателя
		|		ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.БП_ОбработкаЗаказа КАК БП_ОбработкаЗаказа
		|		ПО (БП_ОбработкаЗаказа.ЗаказПокупателя = ДокументЗаказПокупателя.Ссылка)
		|ГДЕ
		|	БП_ОбработкаЗаказа.Ссылка ЕСТЬ NULL
		|	И ДокументЗаказПокупателя.Проведен
		|	И ДокументЗаказПокупателя.Дата > &Дата
		|	И ДокументЗаказПокупателя.Проект = &Проект";

	ДатаВыборки = ТекущаяДатаСеанса() - 1 * 24 * 3600;

	Запрос.УстановитьПараметр("Дата"	, ДатаВыборки);
	Запрос.УстановитьПараметр("Проект"	, Справочники.Проекты.НайтиПоКоду("S00000085"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	Возврат ТаблицаРезультата;


		Для Каждого СтрокаЗадача из РезультатЗапроса Цикл 
			Менеджер = РегистрыСведений.ОбъектыКУдалению.СоздатьМенеджерЗаписи();
			Менеджер.Объект = СтрокаЗадача.Ссылка;
			Менеджер.Записать();
		КонецЦикла;

КонецПроцедуры

Процедура ЗакрытьЗадачиОтправкиТовара(ЗаказПокупателяСсылка, СтрокаЗаказа, УдалитьПолностью = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БП_ЗадачиИсполнителей.Ссылка
	|ИЗ
	|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
	|ГДЕ
	|	  БП_ЗадачиИсполнителей.ЗаказПокупателя = &ЗаказПокупателя
	|	И БП_ЗадачиИсполнителей.ТипЗадачи = &ТипЗадачи
	|	И НЕ БП_ЗадачиИсполнителей.Выполнена
	|	И БП_ЗадачиИсполнителей.Номенклатура = &Номенклатура
	|	И БП_ЗадачиИсполнителей.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	БП_ЗадачиИсполнителейТоварыКВыдачеКлиенту.Ссылка
	|ИЗ
	|	Задача.БП_ЗадачиИсполнителей.ТоварыКВыдачеКлиенту КАК БП_ЗадачиИсполнителейТоварыКВыдачеКлиенту
	|ГДЕ
	|	  БП_ЗадачиИсполнителейТоварыКВыдачеКлиенту.Ссылка.ЗаказПокупателя = &ЗаказПокупателя
	|	И БП_ЗадачиИсполнителейТоварыКВыдачеКлиенту.Ссылка.ТипЗадачи = &ТипЗадачи
	|	И НЕ БП_ЗадачиИсполнителейТоварыКВыдачеКлиенту.Ссылка.Выполнена
	|	И БП_ЗадачиИсполнителейТоварыКВыдачеКлиенту.Номенклатура = &Номенклатура
	|	И БП_ЗадачиИсполнителейТоварыКВыдачеКлиенту.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|";

	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателяСсылка);
	Запрос.УстановитьПараметр("ТипЗадачи", Перечисления.БП_ТипыЗадач.ОтправитьТовар);
	Запрос.УстановитьПараметр("Номенклатура", СтрокаЗаказа.Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", СтрокаЗаказа.ХарактеристикаНоменклатуры);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаРезультата = РезультатЗапроса.Выбрать();

	Пока ВыборкаРезультата.Следующий() Цикл

		ЗадачаОб = ВыборкаРезультата.Ссылка.ПолучитьОбъект();

		Если УдалитьПолностью Тогда
			ЗадачаОб.Удалить();
		Иначе
			ЗадачаОб.УстановитьПометкуУдаления(Истина);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьСтрокуЗаказа(ЗаказПокупателя,Номенклатура,ХарактеристикаНоменклатуры,цена) Экспорт 
		ЗапросПоСтрокеЗаказа = новый Запрос;
		ЗапросПоСтрокеЗаказа.Текст = "ВЫБРАТЬ
		                             |	СтрокиЗаказа.Ссылка Как СтрокаЗаказа
		                             |ИЗ
		                             |	Справочник.СтрокиЗаказа КАК СтрокиЗаказа
		                             |ГДЕ
		                             |	СтрокиЗаказа.ЗаказПокупателя = &ЗаказПокупателя
		                             |	И СтрокиЗаказа.Номенклатура = &Номенклатура
		                             |	И СтрокиЗаказа.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		                             |	И СтрокиЗаказа.ЦенаПродажи = &ЦенаПродажи";
		ЗапросПоСтрокеЗаказа.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
		ЗапросПоСтрокеЗаказа.УстановитьПараметр("Номенклатура",Номенклатура);
		ЗапросПоСтрокеЗаказа.УстановитьПараметр("ХарактеристикаНоменклатуры",ХарактеристикаНоменклатуры);
		ЗапросПоСтрокеЗаказа.УстановитьПараметр("ЦенаПродажи",Цена);
		
		РезультатЗапроса = ЗапросПоСтрокеЗаказа.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество() >0 Тогда 
			
			СтрокаЗаказа = РезультатЗапроса[0].СтрокаЗаказа;
		Иначе
			СтрокаЗаказа  = Справочники.СтрокиЗаказа.ПустаяСсылка();
		КонецЕсли;
		
		Возврат СтрокаЗаказа;
	КонецФункции

Процедура ПроверитьСрокРезерва() Экспорт 
	ЗапросПоНевыполненнымЗаказам = новый запрос;
	ЗапросПоНевыполненнымЗаказам.Текст = "ВЫБРАТЬ
	|	ЗаказыПокупателейОстатки.ЗаказПокупателя
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ) КАК ЗаказыПокупателейОстатки
	|ГДЕ
	|	ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|	И ЗаказыПокупателейОстатки.ЗаказПокупателя.Дата > &Дата";
	ЗапросПоНевыполненнымЗаказам.УстановитьПараметр("Дата",Дата("20150522"));
	
	РезультатЗапроса = ЗапросПоНевыполненнымЗаказам.Выполнить().Выгрузить();
		
		Для каждого СтрокаРезультат из РезультатЗапроса цикл
			ЗаказПокупателя       = СтрокаРезультат.ЗаказПокупателя;
			КоличествоДнейРезерва = ЗаказПокупателя.КоличествоДнейРезерва;
			
			СтатусЗаказа = ПолучитьСтатусЗаказа(ЗаказПокупателя);
			
			Если (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.ЗаказВРаботе) 
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.СборкаЗаказа) 
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.ОтказКлиента)
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.Удален) 
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.ГотовКОтгрузке) 
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.ЕстьПроблемныеПозиции) 
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.ЗаказВыполнен)
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.ОтказСклада)
				или (СтатусЗаказа=Перечисления.БП_СтатусыЗаказов.Удален)Тогда
				
				Продолжить;
			КонецЕсли;
			
			Если ЗаказПокупателя.Дата +КоличествоДнейРезерва*60*60*24 <= ТекущаяДата() и не КоличествоДнейРезерва=0 Тогда 
				//Найдем уже присутствующюю задачу
				ЗапросПоЗадачамОплата = новый запрос;
				ЗапросПоЗадачамОплата.Текст = "ВЫБРАТЬ
				|	БП_ЗадачиИсполнителей.Ссылка,
				|	БП_ЗадачиИсполнителей.БизнесПроцесс КАК БП
				|ИЗ
				|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
				|ГДЕ
				|	НЕ БП_ЗадачиИсполнителей.Выполнена
				|	И БП_ЗадачиИсполнителей.Наименование ПОДОБНО &Наименование
				|	И БП_ЗадачиИсполнителей.ЗаказПокупателя = &ЗаказПокупателя";
				ЗапросПоЗадачамОплата.УстановитьПараметр("Система", Справочники.Пользователи.Система);
				ЗапросПоЗадачамОплата.УстановитьПараметр("Наименование","Уточнить у покупателя продление резерва");
				ЗапросПоЗадачамОплата.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
				
				РезультатЗапросаОплата = ЗапросПоЗадачамОплата.Выполнить().Выгрузить();
				
				Если РезультатЗапросаОплата.Количество() >0 Тогда 
					Продолжить;
				Иначе
					Если ПолучитьОстатокПоЗаказу(ЗаказПокупателя)>0 Тогда 
						Задача = Задачи.БП_ЗадачиИсполнителей.СоздатьЗадачу();
						Задача.Наименование = "Уточнить у покупателя продление резерва";
						Если ЗаказПокупателя.Ответственный = Справочники.Пользователи.Сайт Тогда 
							Задача.Подразделение = Справочники.Подразделения.НайтиПоКоду("4");	
						Иначе
							Задача.Подразделение = ЗаказПокупателя.Подразделение;	
						КонецЕсли;
						Задача.Роль = Перечисления.БП_РолиИсполнителей.Менеджер;
						Задача.ЗаказПокупателя = ЗаказПокупателя;
						Задача.Дата = ТекущаяДата();
						Задача.Записать();
						ОтправитьСМСОбОкончанииСрокаРезерва(ЗаказПокупателя);
						ОтправитьEmailОбОкончанииСрокаРезерва(ЗаказПокупателя);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ЗаказПокупателя.ответственный = Справочники.Пользователи.Сайт 
				и ЗаказПокупателя.Статус = Справочники.СтатусыСтрокиЗаказа.Корзина и не ЕстьБППоЗаказу(ЗаказПокупателя) Тогда 
				Если (ТекущаяДата() - ЗаказПокупателя.дата)/(60*60*24) >2 и ЗаказПокупателя.Контрагент.Наименование = "Гость" Тогда 
					ЗаказПокупателяОб = ЗаказПокупателя.ПолучитьОбъект();
					ЗаказПокупателяОб.статус = Справочники.СтатусыСтрокиЗаказа.АннулированКлиентом;
					ЗаказПокупателяОб.Товары.Очистить();
					ЗаказПокупателяОб.Записать(РежимЗаписиДокумента.Проведение);
					
					//ЗакрытиеЗаказовПокупателей = Документы.ЗакрытиеЗаказовПокупателей.СоздатьДокумент();
					//ЗакрытиеЗаказовПокупателей.ВидОперации = Перечисления.ВидыОперацийЗакрытиеЗаказовПокупателей.ЗакрытиеЗаказов;
					//ЗакрытиеЗаказовПокупателей.Дата = ТекущаяДата();
					//ЗакрытиеЗаказовПокупателей.Ответственный = ПараметрыСеанса.ТекущийПользователь;
					//ЗаказДляЗакрытия = ЗакрытиеЗаказовПокупателей.Заказы.Добавить();
					//ЗаказДляЗакрытия.ЗаказПокупателя = ЗаказПокупателя;
					//ЗакрытиеЗаказовПокупателей.Комментарий = "Закрыт автоматически";
					//ЗакрытиеЗаказовПокупателей.Записать(РежимЗаписиДокумента.Проведение);
				ИначеЕсли (ТекущаяДата() - ЗаказПокупателя.дата)/(60*60*24)>48 и  не ЕстьБППоЗаказу(ЗаказПокупателя) Тогда 
					
					ЗаказПокупателяОб = ЗаказПокупателя.ПолучитьОбъект();
					ЗаказПокупателяОб.статус = Справочники.СтатусыСтрокиЗаказа.АннулированКлиентом;
					ЗаказПокупателяОб.Товары.Очистить();
					ЗаказПокупателяОб.Записать(РежимЗаписиДокумента.Проведение);
					
					//ЗакрытиеЗаказовПокупателей = Документы.ЗакрытиеЗаказовПокупателей.СоздатьДокумент();
					//ЗакрытиеЗаказовПокупателей.ВидОперации = Перечисления.ВидыОперацийЗакрытиеЗаказовПокупателей.ЗакрытиеЗаказов;
					//ЗакрытиеЗаказовПокупателей.Дата = ТекущаяДата();
					//ЗакрытиеЗаказовПокупателей.Ответственный = ПараметрыСеанса.ТекущийПользователь;
					//ЗаказДляЗакрытия = ЗакрытиеЗаказовПокупателей.Заказы.Добавить();
					//ЗаказДляЗакрытия.ЗаказПокупателя = ЗаказПокупателя;
					//ЗакрытиеЗаказовПокупателей.Комментарий = "Закрыт автоматически";
					//ЗакрытиеЗаказовПокупателей.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
КонецПроцедуры

Процедура ОтправитьСМСОбОкончанииСрокаРезерва(ЗаказПокупателя)
	
	НомерТелефона = ry_ОбщиеПроцедуры.ПолучитьНомерТелефонаКонтрагента(ЗаказПокупателя.Контрагент);

	
	Если ЗаказПокупателя.ПересылКлиента Тогда 
		НомерЗаказа = ?(ЗначениеЗаполнено(ЗаказПокупателя.СайтНомер),ЗаказПокупателя.СайтНомер,ЗаказПокупателя.Номер);
		Попытка
			ОправитьСМС = Константы.БП_ИспользуемыйSMSШлюз.Получить().ПолучитьОбъект().отправитьСМС("Ваш резерв "+ЗаказПокупателя.Организация.Подразделение+" " +НомерЗаказа+" истекает.",НомерТелефона);

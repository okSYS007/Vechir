функция ПолучитьКурсВалютыЦен(Дата,Валюта= Неопределено) Экспорт
	
	Курс = 0;
	Если Валюта = Неопределено Тогда 
		Валюта = Справочники.Валюты.НайтиПоКоду("978");	
	КонецЕсли;
	ЗапросПоКурсу = новый Запрос;
	ЗапросПоКурсу.Текст =  "ВЫБРАТЬ
	                       |	КурсыВалютДляЦенСрезПоследних.Курс
	                       |ИЗ
	                       |	РегистрСведений.КурсыВалютДляЦен.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсыВалютДляЦенСрезПоследних";
	ЗапросПоКурсу.УстановитьПараметр("Валюта",Валюта);
	ЗапросПоКурсу.УстановитьПараметр("Дата",Дата);

	
	РезультатЗапроса =  ЗапросПоКурсу.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество()>0 Тогда 
		
		Курс = РезультатЗапроса[0].Курс;
		
	КонецЕсли;
	
	Возврат Курс;
	
КонецФункции


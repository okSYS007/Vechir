		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Представление ПОДОБНО &Представление";
	
	Запрос.УстановитьПараметр("Представление", Представление);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаРезультата = РезультатЗапроса.Выбрать();

	Если ВыборкаРезультата.Следующий() Тогда

		НайденныйОбъект = ВыборкаРезультата.Объект;

		Если ВыборкаРезультата.Объект = Контрагент Тогда
			ТекстОшибки  = "Контакт уже привязан.";
		Иначе
			СтатусОшибки = Истина;
			ТекстОшибки  = "Контакт: " + Представление + " уже привязан к объекту: " + НайденныйОбъект;
		КонецЕсли;

	Иначе
		СоздатьЗаписьНомерТелефонаКонтрагента(Контрагент, Представление);
	КонецЕсли;

	СтруктураОтвета.Вставить("СтатусОшибки", СтатусОшибки);
	СтруктураОтвета.Вставить("ТекстОшибки" , ТекстОшибки);

	Возврат СтруктураОтвета;


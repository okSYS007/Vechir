// + S1-177 ДДГ 14 окт 2024
// обнов S1-545 ДДГ 20 мар 2025
Функция НайтиБП_ОбработкаСтрокиЗаказа(ЗаказИлиБизнесПроцес, СтрокаЗаказа, ИмяПоляХарактеристика = "ХарактеристикаНоменклатуры") Экспорт

	ТипПараметра = ТипЗнч(ЗаказИлиБизнесПроцес);

	ЭтоЗаказ
		  = ТипПараметра = Тип("ДокументСсылка.ЗаказПокупателя")
		ИЛИ ТипПараметра = Тип("ДокументОбъект.ЗаказПокупателя")
	;

	ТекстЗапроса = "ВЫБРАТЬ
	               |	БП_ОбработкаСтрокиЗаказа.Ссылка
	               |ИЗ
	               |	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	               |ГДЕ
	               |	БП_ОбработкаСтрокиЗаказа.Номенклатура = &Номенклатура
	               |	И БП_ОбработкаСтрокиЗаказа.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	               |	И БП_ОбработкаСтрокиЗаказа.Количество = &Количество
	               |	И БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес = &Родитель";

	Если ЭтоЗаказ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РодительскийБизнесПроцес = &Родитель", "РодительскийБизнесПроцес.Заказ = &Родитель")
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номенклатура",				СтрокаЗаказа.Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",	СтрокаЗаказа[ИмяПоляХарактеристика]);
	Запрос.УстановитьПараметр("Количество",					СтрокаЗаказа.Количество);
	Запрос.УстановитьПараметр("Родитель",					ЗаказИлиБизнесПроцес);

	РезультатЗапроса  = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	МассивРезультата  = ТаблицаРезультата.ВыгрузитьКолонку("Ссылка");

	Возврат МассивРезультата;

КонецФункции

Функция СоздатьБП_ОбработкаСтрокиЗаказа(
	  Строка
	, РодительскийБизнесПроцесс
	, ИмяПоляХарактеристика = "ХарактеристикаНоменклатуры"
	, СтатусСтрокиЗаказа
	, ХолодныйСтарт = Ложь
	, ЗаказПоставщику = Неопределено
) Экспорт

	БП = БизнесПроцессы.БП_ОбработкаСтрокиЗаказа.СоздатьБизнесПроцесс();
	БП.Дата         			       = ТекущаяДата();
	БП.Количество   		           = Строка.Количество;
	БП.Номенклатура 			       = Строка.Номенклатура;
	БП.ХарактеристикаНоменклатуры      = Строка[ИмяПоляХарактеристика];
	БП.Цена 	    			       = Строка.Цена;

	Попытка 
		БП.СкладВыдачи  		           = Строка.Склад;
	Исключение
		БП.СкладВыдачи  		           = Строка.Размещение;
	КонецПопытки;

	БП.РодительскийБизнесПроцес        = РодительскийБизнесПроцесс;
	БП.СтатусСтрокиЗаказа 	           = СтатусСтрокиЗаказа;
	БП.НомерСтроки 		  		       = Строка.НомерСтроки;

	Попытка
		БП.СпособДоставки			       = Строка.СпособДоставки;
		БП.АдресДоставки		           = Строка.АдресДоставки;
		БП.КомментарийДляПеремещенияТовара = Строка.Комментарий;
	Исключение
	КонецПопытки;

	Если ХолодныйСтарт Тогда
		БП.Стартован = Истина;
	КонецЕсли;

	БП.ЗаказПоставщику = ЗаказПоставщику;

	БП.Записать();

	Возврат БП;

КонецФункции

Функция ЛиВыполненаОбработкаВсехСтрокЗаказа(РодительскийБизнесПроцесс) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(ISNULL(БП_ОбработкаСтрокиЗаказа.Завершен, ЛОЖЬ)) КАК Завершено
		|ИЗ
		|	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
		|ГДЕ
		|	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес = &РодительскийБизнесПроцес";

	Запрос.УстановитьПараметр("РодительскийБизнесПроцес", РодительскийБизнесПроцесс);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаРезультата = РезультатЗапроса.Выбрать();

	Выполнена = ВыборкаРезультата.Следующий() И ВыборкаРезультата.Завершено;

	Возврат Выполнена;

КонецФункции

Процедура УдалитьЗадачиБизнесПроцесса(БизнесПроцессСсылка) Экспорт

	ЗапросПоЗадачамБП = новый запрос;
	ЗапросПоЗадачамБП.Текст = "ВЫБРАТЬ
	|	БП_ЗадачиИсполнителей.Ссылка
	|ИЗ
	|	Задача.БП_ЗадачиИсполнителей КАК БП_ЗадачиИсполнителей
	|ГДЕ
	|	БП_ЗадачиИсполнителей.БизнесПроцесс = &БизнесПроцесс";
	ЗапросПоЗадачамБП.УстановитьПараметр("БизнесПроцесс",БизнесПроцессСсылка);
	РезультатЗапросаПоЗадачам = ЗапросПоЗадачамБП.Выполнить().Выгрузить();
	Для Каждого СтрокаЗадачи  из РезультатЗапросаПоЗадачам цикл
		ЗадачаОб = СтрокаЗадачи.Ссылка.получитьОбъект();
		ЗадачаОб.Удалить();
	КонецЦикла;

КонецПроцедуры

Процедура ЗавершитьБизнесПроцессОбработкиСтрокиЗаказа(БизнесПроцессСсылка, Отмена = Ложь) Экспорт

	УдалитьЗадачиБизнесПроцесса(БизнесПроцессСсылка);

	СтатусСтрокиЗаказа =
		?(Отмена
		, Перечисления.БП_СтатусыСтрокЗазака.АннулированКлиентом
		, Перечисления.БП_СтатусыСтрокЗазака.ТоварОтгружен
	);

	БПОбСтроки = БизнесПроцессСсылка.ПолучитьОБъект();
	БПОбСтроки.Завершен				= Истина;
	БПОбСтроки.СтатусСтрокиЗаказа	= СтатусСтрокиЗаказа;
	БПОбСтроки.Записать();


Процедура ПроверкаОтложенногоСпросаПриЗаписи(Источник, Отказ) Экспорт
Если не Источник.ОтработанПоСистемеОтлСпроса Тогда 	
	Если ТипЗнч(Источник) = тип("ДокументОбъект.зетаБУКомплектация") Тогда  
		
		ЗапросПоЗапчастям = новый запрос;
		ЗапросПоЗапчастям.Текст = "ВЫБРАТЬ
		|	ЗапросНаДетальТовары.Номенклатура,
		|	ЗапросНаДетальТовары.Ссылка.Покупатель,
		|	ЗапросНаДетальТовары.Ссылка.Дата,
		|	ЗапросНаДетальТовары.Ссылка.Номер,
		|	ЗапросНаДетальТовары.Ссылка как Запрос
		|ИЗ
		|	Документ.ЗапросНаДеталь.Товары КАК ЗапросНаДетальТовары
		|ГДЕ
		|	ЗапросНаДетальТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗапросыНаДетали.ОтложенныйСпрос)
		|	И НЕ ЗапросНаДетальТовары.Ссылка.Закрыт
		|	И НЕ ЗапросНаДетальТовары.Ссылка.ОтправленSMS
		// + ДДГ 27 окт 2023
		|	И ЗапросНаДетальТовары.Ссылка.Покупатель.Ссылка IS NOT NULL
		// - ДДГ 27 окт 2023
		|";
		Результат = ЗапросПоЗапчастям.Выполнить().Выгрузить();						  
		
		
		Для Каждого СтрокаОстатки из Результат цикл
			КоличествоОстаток = 0;
			СтрокиВДокументе = Источник.СоставКомплекта.НАйтистроки(новый структура("Номенклатура",СтрокаОстатки.Номенклатура));
			Попытка
				Для Каждого строкаДокумента из СтрокиВДокументе цикл
					КоличествоОстаток = КоличествоОстаток+1;
					Если ЗначениеЗаполнено(Источник.ДокументОснование) Тогда 
						СтрокиОснования = Источник.ДокументОснование.СоставКомплекта.НайтиСтроки(новый Структура("Номенклатура",строкаДокумента.Номенклатура)); 	
						Для Каждого строкаОснование из СтрокиОснования цикл
							КоличествоОстаток  = КоличествоОстаток - строкаОснование.Количество;
						КонецЦикла;
					КонецЕсли;
				
				
					Если КоличествоОстаток>0 Тогда 
						ОтправитьСмсИЕмейлПоОтложенномуСпросу(СтрокаОстатки.Запрос.Номер,СтрокаОстатки.Запрос.Дата,СтрокаОстатки.Запрос.Покупатель,СтрокаОстатки.Номенклатура,Источник.Склад.Подразделение);	
						СоздатьЗадачуМенеджеру(СтрокаОстатки.Запрос,СтрокаОстатки.Номенклатура,строкаДокумента.ХарактеристикаНоменклатуры,Источник.Склад.Подразделение,Источник.Склад);
					КонецЕсли;
				
				КонецЦикла;
			
			Исключение
			
			КонецПопытки;
			
			//Если (СтрокаОстатки.Остаток - СтрокаОстатки.Резерв) >0 Тогда 
			//	Отбор = новый Структура;
			//	Отбор.Вставить("Номенклатура",СтрокаОстатки.Номенклатура);
			//	
			//	Строки = Результат.НайтиСтроки(Отбор);
			//	
			//	Для Каждого Строка из строки цикл
			//		
			//		ОтправитьСмсИЕмейлПоОтложенномуСпросу(Строка.Номер,Строка.Дата,Строка.Покупатель,Строка.Номенклатура,СтрокаОстатки.Подразделение);	
			//		СоздатьЗадачуМенеджеру(Строка.Ссылка,Строка.Номенклатура,СтрокаОстатки.ХарактеристикаНоменклатуры,СтрокаОстатки.Подразделение,СтрокаОстатки.Склад);
			//		
			//	КонецЦикла;
			//КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Источник) = тип("ДокументОбъект.ПоступлениеТоваровУслуг") тогда
		
		
		ЗапросПоЗапчастям = новый запрос;
		ЗапросПоЗапчастям.Текст = "ВЫБРАТЬ
		|	ЗапросНаДетальТовары.Номенклатура,
		|	ЗапросНаДетальТовары.Ссылка.Покупатель,
		|	ЗапросНаДетальТовары.Ссылка.Дата,
		|	ЗапросНаДетальТовары.Ссылка.Номер,
		|	ЗапросНаДетальТовары.Ссылка как Запрос
		|ИЗ
		|	Документ.ЗапросНаДеталь.Товары КАК ЗапросНаДетальТовары
		|ГДЕ
		|	ЗапросНаДетальТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗапросыНаДетали.ОтложенныйСпрос)
		|	И НЕ ЗапросНаДетальТовары.Ссылка.Закрыт
		|	И НЕ ЗапросНаДетальТовары.Ссылка.ОтправленSMS
		// + ДДГ 27 окт 2023
		|	И ЗапросНаДетальТовары.Ссылка.Покупатель.Ссылка IS NOT NULL
		// - ДДГ 27 окт 2023
		|";
		Результат = ЗапросПоЗапчастям.Выполнить().Выгрузить();						  
		
		
		Для Каждого СтрокаОстатки из Результат цикл
			КоличествоОстаток = 0;
			СтрокиВДокументе = Источник.Товары.НАйтистроки(новый структура("Номенклатура",СтрокаОстатки.Номенклатура));
			
			Для Каждого строкаДокумента из СтрокиВДокументе цикл
				Если не ЗначениеЗаполнено(строкаДокумента.Заказ) Тогда 
					КоличествоОстаток = КоличествоОстаток+1;
				КонецЕсли;
				
				Если КоличествоОстаток>0 Тогда 
					ОтправитьСмсИЕмейлПоОтложенномуСпросу(СтрокаОстатки.Запрос.Номер,СтрокаОстатки.Запрос.Дата,СтрокаОстатки.Запрос.Покупатель,СтрокаОстатки.Номенклатура,строкаДокумента.Склад.Подразделение);	
					СоздатьЗадачуМенеджеру(СтрокаОстатки.Запрос,СтрокаОстатки.Номенклатура,строкаДокумента.ХарактеристикаНоменклатуры,строкаДокумента.Склад.Подразделение,строкаДокумента.Склад);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	Источник.ОтработанПоСистемеОтлСпроса = Истина;
	Попытка
		Если Источник.проведен Тогда 
		Источник.записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Источник.записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	Исключение
		Сообщить("Произошла ошибка при проверке отложенного спроса " + ОписаниеОшибки());
	КонецПопытки;
	
КонецЕсли;
КонецПроцедуры


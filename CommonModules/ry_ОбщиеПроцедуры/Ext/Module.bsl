	|КАК КонтактнаяИнформация
	|ГДЕ КонтактнаяИнформация.Объект = &Объект
	|  И КонтактнаяИнформация.Тип    = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|  И КонтактнаяИнформация.Вид    = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|;
	|
	|ВЫБРАТЬ ТелефоныКонтрагента.Представление
	|ПОМЕСТИТЬ ВсеТелефоныКонтрагента
	|ИЗ ТелефоныКонтрагента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление
	| ИЗ РегистрСведений.КонтактнаяИнформация
	|КАК КонтактнаяИнформация
	|ГДЕ ИСТИНА В (ВЫБРАТЬ КОЛИЧЕСТВО(*) < 1 ИЗ ТелефоныКонтрагента)
	|  И КонтактнаяИнформация.Объект			= &Объект
	|  И КонтактнаяИнформация.Тип				= ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|  И КонтактнаяИнформация.Вид.Наименование	= ""мобильный""
	|;
	|
	|ВЫБРАТЬ
	|	РегистрСведенийАллокацииАккаунтовСрезПоследних.Аккаунт,
	|	РегистрСведенийАллокацииАккаунтовСрезПоследних.Подтверждено,
	|	РегистрСведенийАллокацииАккаунтовСрезПоследних.Аккаунт.ПометкаУдаления КАК ПометкаУдаления
	|ПОМЕСТИТЬ АллокацииКонтрагентов
	|ИЗ РегистрСведений.АллокацииАккаунтов.СрезПоследних(
	|	, ИСТИНА В (ВЫБРАТЬ КОЛИЧЕСТВО(*) < 1 ИЗ ВсеТелефоныКонтрагента)
	|	И ВидАллокации = ЗНАЧЕНИЕ(Перечисление.ВидыАллокаций.Контрагенты)
	|	И ОбъектАллокации = &Объект
	|) КАК РегистрСведенийАллокацииАккаунтовСрезПоследних
	|
	|ГДЕ ТипАллокации <> ЗНАЧЕНИЕ(Перечисление.ТипАллокации.Отвязка)
	|;
	|
	|ВЫБРАТЬ
	|	ВсеТелефоныКонтрагента.Представление,
	|	ИСТИНА КАК ПодтвержденАккаунт,
	|	ЛОЖЬ КАК ПометкаУдаленияАккаунт,
	|	ИСТИНА КАК Основная,
	|	ИСТИНА КАК Подтверждено,
	|	ЛОЖЬ КАК ПометкаУдаления
	|ИЗ ВсеТелефоныКонтрагента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.Логин КАК Представление,
	|	АллокацииКонтрагентов.Подтверждено КАК ПодтвержденАккаунт,
	|	АллокацииКонтрагентов.ПометкаУдаления КАК ПометкаУдаленияАккаунт,
	|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.Основная КАК Основная,
	|	АллокацииАккаунтовСрезПоследних.Подтверждено,
	|	АллокацииАккаунтовСрезПоследних.ОбъектАллокации.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ РегистрСведений.АллокацииАккаунтов.СрезПоследних(
	|	, ИСТИНА В (ВЫБРАТЬ КОЛИЧЕСТВО(*) < 1 ИЗ ВсеТелефоныКонтрагента)
	|	И Аккаунт В (ВЫБРАТЬ Аккаунт ИЗ АллокацииКонтрагентов)
	|	И ВидАллокации = ЗНАЧЕНИЕ(Перечисление.ВидыАллокаций.ПользователиСайтов)
	|	И ОбъектАллокации ССЫЛКА Справочник.КонтактнаяИнформация
	|) КАК АллокацииАккаунтовСрезПоследних
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ АллокацииКонтрагентов
	|ПО АллокацииАккаунтовСрезПоследних.Аккаунт = АллокацииКонтрагентов.Аккаунт
	|
	|ГДЕ ТипАллокации <> ЗНАЧЕНИЕ(Перечисление.ТипАллокации.Отвязка)
	|  И ОбъектАллокации.ВидЛогина = 1
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПометкаУдаленияАккаунт ВОЗР,
	|	ПометкаУдаления ВОЗР,
	|	ПодтвержденАккаунт УБЫВ,
	|	Подтверждено УБЫВ,
	|	Основная УБЫВ
	|");

	Запрос.УстановитьПараметр("Объект", Контрагент);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаРезультата = РезультатЗапроса.Выбрать();

	Если ВыборкаРезультата.Следующий() Тогда
		Представление = ВыборкаРезультата.Представление;
	КонецЕсли;

	Возврат Представление;


// выделил S1-545 ДДГ 26 мар 2025
Функция ЗапуститьЗаказ(
	  ЗаказПокупателя
	, ДатаЗаказа = Неопределено
	, ПроверитьПередСозданием = Истина
) Экспорт

	Если ПроверитьПередСозданием Тогда

		СсылкаБП = ПолучитьБизнесПроцессПоЗаказу(ЗаказПокупателя);

		Если ЗначениеЗаполнено(СсылкаБП) Тогда
			БП = СсылкаБП.ПолучитьОбъект();
			Возврат БП;
		КонецЕсли;

	КонецЕсли;

	ТоварыЗаказа = ЗаказПокупателя.Товары;
	СтрокТоваров = ТоварыЗаказа.Количество();

	Если СтрокТоваров = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	СписокСтрокДляОбновленияЖурнала = новый СписокЗначений;
	////УправлениеСтатусамиСтрокЗаказов.ОбработатьИзменения(ЗаказПокупателя,СписокСтрокДляОбновленияЖурнала);
	////УправлениеСтатусамиСтрокЗаказов.ОбновитьЖурналСтрокЗаказа(СписокСтрокДляОбновленияЖурнала);

	БП = СоздатьБП_ОбработкаЗаказа(ЗаказПокупателя, ДатаЗаказа);

	Возврат БП;

КонецФункции

// выделил S1-545 ДДГ 26 мар 2025
Функция СоздатьБП_ОбработкаЗаказа(ЗаказПокупателя, ДатаЗаказа = Неопределено)

	ТоварыЗаказа = ЗаказПокупателя.Товары;

	БП = БизнесПроцессы.БП_ОбработкаЗаказа.СоздатьБизнесПроцесс();

	Если ДатаЗаказа = Неопределено Тогда
		БП.Дата = ЗаказПокупателя.Дата;
	Иначе
		БП.Дата = ДатаЗаказа;
	КонецЕсли;

	БП.ЗаказПокупателя = ЗаказПокупателя;
	БП.СтатусЗаказа = Перечисления.БП_СтатусыЗаказов.ЗаказПолучен;

	Для каждого СтрокаТовара Из ТоварыЗаказа Цикл

		СтрокаБП = БП.СтрокиЗаказа.Добавить();
		СтрокаБП.Номенклатура		= СтрокаТовара.Номенклатура;
		СтрокаБП.ХарактеристикаНоменклатуры = СтрокаТовара.ХарактеристикаНоменклатуры;
		СтрокаБП.Количество  		= СтрокаТовара.Количество;
		СтрокаБП.Цена         		= СтрокаТовара.Цена;
		//СтрокаБП.СкладВыдачи        = СтрокаТовара.Склад;
		СтрокаБП.СкладВыдачи        = ЗаказПокупателя.СкладГруппа;
		СтрокаБП.СтатусСтрокиЗаказа = Перечисления.БП_СтатусыСтрокЗазака.Зарегистрирован;
		//СтрокаБП.АдресДоставки  	= СтрокаТовара.АдресДоставки;
		СтрокаБП.АдресДоставки  	= "";
		//СтрокаБП.СпособДоставки 	= СтрокаТовара.СпособДоставки;
		СтрокаБП.СпособДоставки 	= ЗаказПокупателя.СпособДоставки;
		СтрокаБП.Количество			= СтрокаТовара.Количество;

	КонецЦикла;

	БП.Записать();
	БП.Старт();

	Возврат БП;

КонецФункции

//Проставление способов доставки
Процедура ПроставитьСпособыДоставки() Экспорт 
	
	ЗапросПоИзмененнымКонтрагентам = новый Запрос;
	ЗапросПоИзмененнымКонтрагентам.Текст = "ВЫБРАТЬ
	                                       |	КонтрагентыИзменения.Ссылка
	                                       |ИЗ
	                                       |	Справочник.Контрагенты.Изменения КАК КонтрагентыИзменения
	                                       |ГДЕ
	                                       |	КонтрагентыИзменения.Узел = &Узел";
	ЗапросПоИзмененнымКонтрагентам.УстановитьПараметр("Узел",ПланыОбмена.LastMod.НайтиПоКоду("Site"));	
	ВыборкаКонтрагентов = ЗапросПоИзмененнымКонтрагентам.Выполнить().Выбрать();
	
	Пока ВыборкаКонтрагентов.Следующий() цикл
		Если не ВыборкаКонтрагентов.ссылка.этоГруппа Тогда 
			
			об = ВыборкаКонтрагентов.ссылка.ПолучитьОбъект();
			try
				Отказ = Ложь;
				форма = об.ПолучитьФорму("ФормаЭлемента");
				форма.ПроверитьОсновнойДоговорКонтрагентаДляРегЗадания(Отказ, истина);
				форма.записатьВФорме();
				
				ЗапросПоДоговорам = Новый Запрос;
				ЗапросПоДоговорам.Текст = "ВЫБРАТЬ
				                          |	ДоговорыКонтрагентов.Ссылка
				                          |ИЗ
				                          |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
				                          |ГДЕ
				                          |	ДоговорыКонтрагентов.Организация = &Организация
				                          |	И НЕ ДоговорыКонтрагентов.СкрытьНаСайте";
				ЗапросПоДоговорам.УстановитьПараметр("Организация",Справочники.Организации.НайтиПоНаименованию("ИП Костин Константин Николаевич СПБ"));	
				РезультатЗапроса = ЗапросПоДоговорам.Выполнить().Выгрузить();
				
				если РезультатЗапроса.Количество() Тогда 
					об.ОсновнойДоговорКонтрагента = РезультатЗапроса[0].Ссылка;	
				КонецЕсли;
			except
			endtry;
			Если ВыборкаКонтрагентов.Ссылка.Покупатель Тогда 
				ВыборкаАдресов = Справочники.АдресаСамовывоза.Выбрать();
				Пока ВыборкаАдресов.Следующий() цикл
					Для к=1 по 20 Цикл 
						Если не АдресЗанят(ВыборкаКонтрагентов.ссылка,"Адрес доставки "+к) и не АдресУжеЕсть(ВыборкаКонтрагентов.ссылка,ВыборкаАдресов.Наименование) Тогда 
							АдрессДоставки               = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
							АдрессДоставки.Активность    = Истина;
							АдрессДоставки.Вид           = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Адрес доставки "+к);
							АдрессДоставки.Тип           = Перечисления.ТипыКонтактнойИнформации.Адрес;
							АдрессДоставки.Объект        = ВыборкаКонтрагентов.ссылка;
							АдрессДоставки.Представление = ВыборкаАдресов.Наименование;
							АдрессДоставки.Записать(Истина);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		УдалениеРегистрацииДанныхПоУзлу(ПланыОбмена.LastMod.НайтиПоКоду("Site"),ВыборкаКонтрагентов.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

Функция АдресЗанят(Контрагент,Адрес)
	
	ВозвращаемоеЗначение = Ложь;
	
	
	Если Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию(Адрес).Пустая() Тогда 
			Элемент = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
			Элемент.ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты;
			Элемент.Наименование = Адрес;
			Элемент.Тип  = Перечисления.ТипыКонтактнойИнформации.Адрес;
			Элемент.Записать();
	КонецЕсли;
	
	ЗапросПоАдресу = новый Запрос;
	ЗапросПоАдресу.Текст =  "ВЫБРАТЬ
	                        |	КонтактнаяИнформация.Объект
	                        |ИЗ
	                        |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                        |ГДЕ
	                        |	КонтактнаяИнформация.Вид = &Вид
	                        |	И КонтактнаяИнформация.Объект = &Объект" ;
	ЗапросПоАдресу.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию(Адрес));
	ЗапросПоАдресу.УстановитьПараметр("Объект",Контрагент);
	
	Результат = ЗапросПоАдресу.Выполнить().Выгрузить();
	Если Результат.Количество()>0 Тогда 
		ВозвращаемоеЗначение = Истина;	
	Иначе
		ВозвращаемоеЗначение = Ложь;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция АдресУжеЕсть(Контрагент,Адрес)
	
	ВозвращаемоеЗначение = Ложь;
	
	ЗапросПоАдресу = новый Запрос;
	ЗапросПоАдресу.Текст =  "ВЫБРАТЬ
	                        |	КонтактнаяИнформация.Объект
	                        |ИЗ
	                        |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                        |ГДЕ
	                        |	КонтактнаяИнформация.Объект = &Объект
	                        |	И КонтактнаяИнформация.Представление ПОДОБНО &Представление" ;
	ЗапросПоАдресу.УстановитьПараметр("Представление",Адрес);
	ЗапросПоАдресу.УстановитьПараметр("Объект",Контрагент);
	
	Результат = ЗапросПоАдресу.Выполнить().Выгрузить();
	Если Результат.Количество()>0 Тогда 
		ВозвращаемоеЗначение = Истина;	
	Иначе
		ВозвращаемоеЗначение = Ложь;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ПолучитьСтатусЗаказа(ЗаказПокупателя) Экспорт 
	ЗапросПоБП = новый Запрос;
	ЗапросПоБП.Текст = "ВЫБРАТЬ
	                   |	БП_ОбработкаЗаказа.СтатусЗаказа как Статус
	                   |ИЗ
	                   |	БизнесПроцесс.БП_ОбработкаЗаказа КАК БП_ОбработкаЗаказа
	                   |ГДЕ
	                   |	БП_ОбработкаЗаказа.ЗаказПокупателя = &ЗаказПокупателя";
	ЗапросПоБП.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	
	РезультатЗапроса = ЗапросПоБП.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.Статус;
	Иначе
		Возврат ЗаказПокупателя.статус;
	КонецЕсли;	
КонецФункции

Функция ПолучитьСтатусСтрокиЗаказа(ЗаказПокупателя,Номенклатура,ХарактеристикаНоменклатуры) Экспорт 
	ЗапросПоБП = новый Запрос;
	ЗапросПоБП.Текст = "ВЫБРАТЬ
	                   |	БП_ОбработкаСтрокиЗаказа.СтатусСтрокиЗаказа
	                   |ИЗ
	                   |	БизнесПроцесс.БП_ОбработкаСтрокиЗаказа КАК БП_ОбработкаСтрокиЗаказа
	                   |ГДЕ
	                   |	БП_ОбработкаСтрокиЗаказа.РодительскийБизнесПроцес.ЗаказПокупателя = &ЗаказПокупателя
	                   |	И БП_ОбработкаСтрокиЗаказа.Номенклатура = &Номенклатура
	                   |	И БП_ОбработкаСтрокиЗаказа.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры";
	ЗапросПоБП.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя);
	ЗапросПоБП.УстановитьПараметр("Номенклатура",Номенклатура);
	ЗапросПоБП.УстановитьПараметр("ХарактеристикаНоменклатуры",ХарактеристикаНоменклатуры);
	
	РезультатЗапроса = ЗапросПоБП.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.СтатусСтрокиЗаказа;
	Иначе
		Возврат ЗаказПокупателя.статус;
	КонецЕсли;	

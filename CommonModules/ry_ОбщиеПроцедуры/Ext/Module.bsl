Процедура ОбработатьПлатежи() Экспорт 
	перем ФР;
	перем глСерверТО;
		//ПолучитьСерверТО().ПодключитьКлиента(Неопределено);
	ПолучитьСерверТОЛокал(глСерверТО).ПодключитьКлиента(Документы.ОплатаОтПокупателяПлатежнойКартой.ПолучитьФорму("ФормаДокумента"));
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОплатаОтПокупателяПлатежнойКартой.Ссылка
	|ИЗ
	|	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
	|ГДЕ
	|	ОплатаОтПокупателяПлатежнойКартой.Дата > &Дата
	|	И ОплатаОтПокупателяПлатежнойКартой.НомерЧекаККМ = 0
	|	И ОплатаОтПокупателяПлатежнойКартой.Проведен
	|	И ОплатаОтПокупателяПлатежнойКартой.Ответственный = &Ответственный";
	запрос.УстановитьПараметр("Дата",Дата("20170824235959"));
	Запрос.УстановитьПараметр("Ответственный",Справочники.Пользователи.Сайт);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультата из РезультатЗапроса цикл
		
		Об = СтрокаРезультата.ссылка.получитьОбъект();
		
		

		Если Об.НомерЧекаККМ <> 0 Тогда             
			Продолжить;;
		КонецЕсли;
		
		Если Не ПолучитьПроверитьПараметрыДляПробитияЧекаЛок(ФР) Тогда
			Возврат;
		КонецЕсли;
				
		//ЭтотОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		//Если (НЕ Проведен) ИЛИ Модифицированность Тогда
		//	Предупреждение("Операция не выполнена!");
		//	Возврат;
		//КонецЕсли;
		
		Позиция         = Неопределено;
		НомерСмены      = Неопределено;
		ТаблицаПлатежей = Новый ТаблицаЗначений();
		ТаблицаПлатежей.Колонки.Добавить("Заголовок");
		ТаблицаПлатежей.Колонки.Добавить("Сумма");
		ТаблицаПлатежей.Колонки.Добавить("НДС");
		
		Для Каждого Позиция Из Об.РасшифровкаПлатежа Цикл
			СтрокаТаблицы    = ТаблицаПлатежей.Добавить();
			Если Об.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя Тогда 
				СтрокаТаблицы.Заголовок = "Оплата по заказу "+ Об.ДокументОснование.СайтНомер;
			Иначе
				СтрокаТаблицы.Заголовок = "Возврат по заказу "+ Об.РасшифровкаПлатежа[0].ДокументРасчетовСКонтрагентом.Сделка.СайтНомер;	
			КонецЕсли;
			СтрокаТаблицы.Сумма     = Позиция.СуммаПлатежа;
			//СтрокаТаблицы.НДС       = УчетНДС.ПолучитьСтавкуНДС(Позиция.СтавкаНДС);
			СтрокаТаблицы.НДС       = УчетНДС.ПолучитьСтавкуНДС(Позиция.СтавкаНДС);
		КонецЦикла;
		
		Если Об.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя Тогда
			Результат = ПолучитьСерверТОЛокал(глСерверТО).ПечатьЧекаПКО(ФР,
			ПолучитьСерверТОЛокал(глСерверТО).ПолучитьПарольКассираККМ(),
			Об.НомерЧекаККМ,
			НомерСмены,
			ТаблицаПлатежей,
			0,
			Об.СуммаДокумента,
			Об.Ссылка);
		Иначе
			Результат = ПолучитьСерверТОЛокал(глСерверТО).ПечатьЧекаРКО(ФР,
			ПолучитьСерверТОЛокал(глСерверТО).ПолучитьПарольКассираККМ(),
			Об.НомерЧекаККМ,
			НомерСмены,
			ТаблицаПлатежей,
			0,
			Об.СуммаДокумента,
			Об.Ссылка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат) Тогда
					Продолжить;
		КонецЕсли;
		
		Об.Записать(РежимЗаписиДокумента.Запись);

	КонецЦикла;
	# Если Клиент Тогда 
    ЗавершитьРаботуСистемы(ложь);
	#КонецЕсли
КонецПроцедуры


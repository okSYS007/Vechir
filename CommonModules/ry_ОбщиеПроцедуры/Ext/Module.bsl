Функция	ПолучитьДоговорКонтрагента(Контрагент,Организация) Экспорт 
	
	ВозвращаемоеЗначение = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Владелец = &Контрагент
	               |	И ДоговорыКонтрагентов.Организация = &Организация";
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		ВозвращаемоеЗначение = РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции

Функция ВернутьДоговорЕслиОдин(Контрагент, Организация) Экспорт
	ВозвращаемоеЗначение = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка КАК Договор
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Владелец = &Владелец
	               |	И ДоговорыКонтрагентов.Организация = &Организация
	               |	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)";
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат СоздатьДоговорЕслиНеНашли(Контрагент, Организация);	
	КонецЕсли;
	
	Результат = Результат.Выгрузить();
	
	Если Результат.Количество() = 1 Тогда
		ВозвращаемоеЗначение = Результат[0].Договор;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции

Функция СоздатьДоговорЕслиНеНашли(Контрагент, Организация) Экспорт
	
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Если Организация.НеДействует Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	Если Организация.ИНН = "" Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	НовыйДоговор.Владелец = Контрагент;
	НовыйДоговор.Организация = Организация;
	НовыйДоговор.Наименование = "Договор с контрагентом: " + Контрагент.Наименование;
	НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");
	НовыйДоговор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	НовыйДоговор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
	Попытка
		НовыйДоговор.Записать();
	Исключение
		Сообщить("Не удалось записать Договор по причине: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат НовыйДоговор.Ссылка;
КонецФункции


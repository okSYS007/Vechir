Процедура ПроведениеДокументовСменнаИзОбработки(Касса,Дата) Экспорт 
    ДокументСмена = ПолучитьДокументСмена(Дата,Касса);	

	Менеджер = РегистрыСведений.ДокументыСменаКПроведению.СоздатьМенеджерЗаписи();
	Менеджер.ДокументСмена = ДокументСмена;
	Менеджер.Записать(Истина);
	
КонецПроцедуры

Функция ПолучитьДокументСмена(Дата,Касса) Экспорт 
	ВозвращаемоеЗначение = Документы.Смена.ПустаяСсылка();
 	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Смена.Ссылка
	               |ИЗ
	               |	Документ.Смена КАК Смена
	               |ГДЕ
	               |	Смена.Дата МЕЖДУ &НачалоДня И &КонецДня
	               |	И Смена.Касса = &Касса";
	Запрос.УстановитьПараметр("НачалоДня",НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецДня",КонецДня(Дата));
	Запрос.УстановитьПараметр("Касса",Касса);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		ВозвращаемоеЗначение = РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ПолучитьРасходыЗаДень(Дата,Подразделение) Экспорт 
	СуммаРасхода = 0;
	ЗапросПоРасходам = новый запрос;
	ЗапросПоРасходам.Текст = "ВЫБРАТЬ
	                         |	ЕстьNull(СУММА(РасходныйКассовыйОрдер.СуммаДокумента),0) КАК СуммаДокумента
	                         |ИЗ
	                         |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	                         |ГДЕ
	                         |	РасходныйКассовыйОрдер.Проведен
	                         |	И РасходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	                         |	И РасходныйКассовыйОрдер.Подразделение = &Подразделение
	                         |	И РасходныйКассовыйОрдер.ВидОперации В(&ВидОперации)";
	ЗапросПоРасходам.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	ЗапросПоРасходам.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	ЗапросПоРасходам.УстановитьПараметр("Подразделение",Подразделение);
	
	СписокВидовОпераций = Новый  СписокЗначений;
	СписокВидовОпераций.Добавить(Перечисления.ВидыОперацийРКО.ОплатаПоставщику);
	СписокВидовОпераций.Добавить(Перечисления.ВидыОперацийРКО.РасходДенежныхСредствПрочее);
	СписокВидовОпераций.Добавить(Перечисления.ВидыОперацийРКО.ПрочиеРасчетыСКонтрагентами);
	СписокВидовОпераций.Добавить(Перечисления.ВидыОперацийРКО.РасчетыПоКредитамИЗаймамСКонтрагентами);

	ЗапросПоРасходам.УстановитьПараметр("ВидОперации",СписокВидовОпераций);
	
	

	РезультатЗапроса = ЗапросПоРасходам.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаРасхода = РезультатЗапроса[0].СуммаДокумента; 	
	КонецЕсли;
	
	ЗапросПоАвансовым = новый запрос;
	ЗапросПоАвансовым.Текст = "ВЫБРАТЬ
	                          |	естьNull(СУММА(АвансовыйОтчет.СуммаДокумента),0) КАК СуммаДокумента
	                          |ИЗ
	                          |	Документ.АвансовыйОтчет КАК АвансовыйОтчет
	                          |ГДЕ
	                          |	АвансовыйОтчет.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	                          |	И АвансовыйОтчет.Проведен
	                          |	И АвансовыйОтчет.Подразделение = &Подразделение";
	ЗапросПоАвансовым.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	ЗапросПоАвансовым.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	ЗапросПоАвансовым.УстановитьПараметр("Подразделение",Подразделение);
	
	РезультатЗапроса = ЗапросПоАвансовым.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаРасхода = РезультатЗапроса[0].СуммаДокумента; 	
	КонецЕсли;
	
	Возврат СуммаРасхода;
		
КонецФункции

Функция ПолучитьДневнойОборот(Дата,Подразделение) Экспорт
	
	СуммаОборот = 0;
	
	ЗапросПоПродаже = новый запрос;
	ЗапросПоПродаже.Текст= "ВЫБРАТЬ
	                       |	ЕстьNULL(СУММА(РеализацияТоваровУслуг.СуммаДокумента),0) КАК СуммаДокумента
	                       |ИЗ
	                       |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	                       |ГДЕ
	                       |	РеализацияТоваровУслуг.Проведен
	                       |	И РеализацияТоваровУслуг.Подразделение = &Подразделение
	                       |	И РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	                       |	И НЕ РеализацияТоваровУслуг.ОплаченоЧеком";
	ЗапросПоПродаже.УстановитьПараметр("Подразделение",Подразделение);
	ЗапросПоПродаже.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	ЗапросПоПродаже.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	
	РезультатЗапроса = ЗапросПоПродаже.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОборот = РезультатЗапроса[0].СуммаДОкумента;	
	КонецЕсли;
	
	ЗапросПоПродаже = новый запрос;
	ЗапросПоПродаже.Текст= "ВЫБРАТЬ
	                       |	ЕстьNull(СУММА(ОтчетОРозничныхПродажах.СуммаДокумента),0) КАК СуммаДокумента
	                       |ИЗ
	                       |	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	                       |ГДЕ
	                       |	ОтчетОРозничныхПродажах.Проведен
	                       |	И ОтчетОРозничныхПродажах.Подразделение = &Подразделение
	                       |	И ОтчетОРозничныхПродажах.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	ЗапросПоПродаже.УстановитьПараметр("Подразделение",Подразделение);
	ЗапросПоПродаже.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	ЗапросПоПродаже.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	
	РезультатЗапроса = ЗапросПоПродаже.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОборот = СуммаОборот+ РезультатЗапроса[0].СуммаДОкумента;	
	КонецЕсли;
	
	ЗапросПоВозврат = новый запрос;
	ЗапросПоВозврат.Текст= "ВЫБРАТЬ
	                       |	ЕстьNull(СУММА(ВозвратТоваровОтПокупателя.СуммаДокумента),0) КАК СуммаДокумента
	                       |ИЗ
	                       |	Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	                       |ГДЕ
	                       |	ВозвратТоваровОтПокупателя.Проведен
	                       |	И ВозвратТоваровОтПокупателя.Подразделение = &Подразделение
	                       |	И ВозвратТоваровОтПокупателя.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	ЗапросПоВозврат.УстановитьПараметр("Подразделение",Подразделение);
	ЗапросПоВозврат.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	ЗапросПоВозврат.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	
	РезультатЗапроса = ЗапросПоВозврат.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОборот = СуммаОборот - РезультатЗапроса[0].СуммаДОкумента;	
	КонецЕсли;

	Возврат СуммаОборот;
	
КонецФункции

Функция ПолучитьПродажиЗаДаДень(Дата,Подразделение)
	
	ВозвращаемемоеЗначение = 0;
	ЗапросПоДокументам = новый запрос;
	ЗапросПоДокументам.Текст = "ВЫБРАТЬ
	                           |	СУММА(ВложенныйЗапрос.СуммаПродажБезУчетаВозвратов) КАК Сумма,
	                           |	ВложенныйЗапрос.Подразделение,
	                           |	СУММА(ВложенныйЗапрос.СтоимостьEURОборот) КАК СуммаEUR
	                           |ИЗ
	                           |	(ВЫБРАТЬ
	                           |		СУММА(ПродажиОбороты.СтоимостьОборот) КАК СуммаПродажБезУчетаВозвратов,
	                           |		ПродажиОбороты.Подразделение КАК Подразделение,
	                           |		СУММА(ПродажиОбороты.СтоимостьEURОборот) КАК СтоимостьEURОборот
	                           |	ИЗ
	                           |		РегистрНакопления.Продажи.Обороты(&НачалоДня, &КонецДня, Запись, Подразделение = &Подразделение) КАК ПродажиОбороты
	                           |	
	                           |	СГРУППИРОВАТЬ ПО
	                           |		ПродажиОбороты.Подразделение) КАК ВложенныйЗапрос
	                           |
	                           |СГРУППИРОВАТЬ ПО
	                           |	ВложенныйЗапрос.Подразделение";
	ЗапросПоДокументам.УстановитьПараметр("Подразделение",Подразделение);
	ЗапросПоДокументам.УстановитьПараметр("НачалоДня",НачалоДня(Дата));
	ЗапросПоДокументам.УстановитьПараметр("КонецДня",КонецДня(Дата));
	РезультатЗапроса = ЗапросПоДокументам.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() Тогда 
		Если Подразделение.Локация = Справочники.Локации.Россия Тогда 
			ВозвращаемемоеЗначение = РезультатЗапроса[0].Сумма;
		Иначе
			ВозвращаемемоеЗначение = РезультатЗапроса[0].СуммаEUR;
		КонецЕсли;
	КонецЕсли;
	
	Возврат  ВозвращаемемоеЗначение;
	
КонецФункции

Функция ПолучитьСуммуОплатНаличными(Дата,Подразделение) Экспорт
	
	СуммаОплатНаличными = 0;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(ВложенныйЗапрос.СуммаДокумента, 0) - ЕСТЬNULL(ВложенныйЗапрос.Сумма, 0) КАК ОплатыНаличными
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СУММА(ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Сумма) КАК Сумма,
	               |		СРЕДНЕЕ(ОтчетОРозничныхПродажах.СуммаДокумента) КАК СуммаДокумента,
	               |		ОтчетОРозничныхПродажах.Ссылка КАК Ссылка,
	               |		ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Ссылка КАК Ссылка1
	               |	ИЗ
	               |		Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОРозничныхПродажах.ОплатаПлатежнымиКартами КАК ОтчетОРозничныхПродажахОплатаПлатежнымиКартами
	               |			ПО (ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Ссылка = ОтчетОРозничныхПродажах.Ссылка)
	               |	ГДЕ
	               |		ОтчетОРозничныхПродажах.Подразделение = &Подразделение
	               |		И ОтчетОРозничныхПродажах.Проведен
	               |		И ОтчетОРозничныхПродажах.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ОтчетОРозничныхПродажах.Ссылка,
	               |		ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Ссылка) КАК ВложенныйЗапрос";
	Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОплатНаличными = РезультатЗапроса[0].ОплатыНаличными;	
	КонецЕсли;
	
	
	ЗапросПоРасходам = новый запрос;
	ЗапросПоРасходам.Текст = "ВЫБРАТЬ
	                         |	ЕСТЬNULL(СУММА(РасходныйКассовыйОрдер.СуммаДокумента), 0) КАК СуммаДокумента
	                         |ИЗ
	                         |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	                         |ГДЕ
	                         |	РасходныйКассовыйОрдер.Проведен
	                         |	И РасходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	                         |	И РасходныйКассовыйОрдер.Подразделение = &Подразделение
	                         |	И РасходныйКассовыйОрдер.ВидОперации В(&ВидОперации)";
	ЗапросПоРасходам.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	ЗапросПоРасходам.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	ЗапросПоРасходам.УстановитьПараметр("Подразделение",Подразделение);
	
	СписокВидовОпераций = Новый  СписокЗначений;
	СписокВидовОпераций.Добавить(Перечисления.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю);

	ЗапросПоРасходам.УстановитьПараметр("ВидОперации",СписокВидовОпераций);
	
	

	РезультатЗапроса = ЗапросПоРасходам.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОплатНаличными = СуммаОплатНаличными - РезультатЗапроса[0].СуммаДокумента; 	
	КонецЕсли;
	
	Возврат СуммаОплатНаличными;
	
КонецФункции

Функция ПолучитьСуммуОплатБезналом(Дата,Подразделение) Экспорт
	СуммаОплатБезнал = 0;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	естьNULL(СУММА(ЕСТЬNULL(ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Сумма, 0)),0) КАК ОплатыБезналичными
	               |ИЗ
	               |	Документ.ОтчетОРозничныхПродажах.ОплатаПлатежнымиКартами КАК ОтчетОРозничныхПродажахОплатаПлатежнымиКартами
	               |ГДЕ
	               |	ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Ссылка.Проведен
	               |	И ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Ссылка.Подразделение = &Подразделение";
	Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОплатБезнал = РезультатЗапроса[0].ОплатыБезналичными;	
	КонецЕсли;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(ПлатежноеПоручениеВходящее.СуммаДокумента), 0) КАК СуммаДокумента
	               |ИЗ
	               |	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	               |ГДЕ
	               |	ПлатежноеПоручениеВходящее.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ПлатежноеПоручениеВходящее.Ссылка.Проведен
	               |	И ПлатежноеПоручениеВходящее.Подразделение = &Подразделение";
	Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	Запрос.УстановитьПараметр("Подразделение",Подразделение);

	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОплатБезнал = СуммаОплатБезнал + РезультатЗапроса[0].СуммаДокумента;	
	КонецЕсли;	
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(ОплатаОтПокупателяПлатежнойКартой.СуммаДокумента), 0) КАК СуммаДокумента
	               |ИЗ
	               |	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
	               |ГДЕ
	               |	ОплатаОтПокупателяПлатежнойКартой.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ОплатаОтПокупателяПлатежнойКартой.Ссылка.Проведен
	               |	И ОплатаОтПокупателяПлатежнойКартой.Подразделение = &Подразделение";
	Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	Запрос.УстановитьПараметр("Подразделение",Подразделение);

	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОплатБезнал = СуммаОплатБезнал + РезультатЗапроса[0].СуммаДокумента;	
	КонецЕсли;
	
		
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(ПлатежноеПоручениеИсходящее.СуммаДокумента), 0) КАК СуммаДокумента
	               |ИЗ
	               |	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
	               |ГДЕ
	               |	ПлатежноеПоручениеИсходящее.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ПлатежноеПоручениеИсходящее.Ссылка.Проведен
	               |	И ПлатежноеПоручениеИсходящее.Подразделение = &Подразделение
	               |	И ПлатежноеПоручениеИсходящее.ВидОперации = &ВидОперации";
	Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Дата));
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Запрос.УстановитьПараметр("ВидОперации",Перечисления.ВидыОперацийППИсходящее.ВозвратДенежныхСредствПокупателю);

	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		СуммаОплатБезнал = СуммаОплатБезнал - РезультатЗапроса[0].СуммаДокумента;	
	КонецЕсли;

	
	Возврат СуммаОплатБезнал;
	
КонецФункции

Функция ПолучитьКоличествоПосетителей(Подразделение,НачалоПериода,КонецПериода) экспорт
	Запрос = новый запрос;
	ЗАпрос.Текст = "ВЫБРАТЬ
	               |	Смена.КоличествоПосетителей
	               |ИЗ
	               |	Документ.Смена КАК Смена
	               |ГДЕ
	               |	Смена.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И Смена.Проведен
	               |	И Смена.Подразделение = &Подразделение";
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",КонецПериода);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Возврат РезультатЗапроса[0].КоличествоПосетителей;
	КонецЕсли;
КонецФункции
	

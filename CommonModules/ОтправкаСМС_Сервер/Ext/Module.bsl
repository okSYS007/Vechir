	ТЗ_Запроса.Колонки.Добавить("sended"	,Новый ОписаниеТипов("Дата"));
	ТЗ_Запроса.Колонки.Добавить("sign"		,Новый ОписаниеТипов("Строка"));
	ТЗ_Запроса.Колонки.Добавить("status"	,Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100,ДопустимаяДлина.Переменная)));
	ТЗ_Запроса.Колонки.Добавить("wappush"	,Новый ОписаниеТипов("Строка"));	

	RecordSet = Новый COMОбъект("ADODB.RecordSet");
    Command = Новый COMОбъект("ADODB.Command");
    Command.ActiveConnection = Соединение;
    RecordSet = Новый COMОбъект("ADODB.RecordSet");

    Command.CommandText = "select * from " + Константы.ЛогинСМС.Получить(); //
    RecordSet = Command.Execute(); //Выполнение и получение набора данных
	//Для НомерКолонки = 0 По RecordSet.Fields.Count-1 Цикл
	//    ТЗ_Запроса.Колонки.Добавить(RecordSet.Fields.Item(НомерКолонки).Name,,RecordSet.Fields.Item(НомерКолонки).Name, 15);
	//КонецЦикла;
    Если не RecordSet.EOF() Тогда
        RecordSet.MoveFirst();
        Пока RecordSet.EOF() = 0 Цикл
            СтрокаТаблицыЗначений = ТЗ_Запроса.Добавить();
			Для Каждого Колонка Из ТЗ_Запроса.Колонки Цикл
				СтрокаТаблицыЗначений[Колонка.Имя] = RecordSet.Fields(Колонка.Имя).Value; 		
			КонецЦикла;
			
			//Для НомерКолонки = 0 По RecordSet.Fields.Count-1 Цикл
			//    СтрокаТаблицыЗначений[НомерКолонки] = RecordSet.Fields(RecordSet.Fields.Item(НомерКолонки).Name).Value;
			//КонецЦикла;
            RecordSet.MoveNext();
        КонецЦикла;
        RecordSet.Close();
        КонецЕсли;
    Возврат ТЗ_Запроса;

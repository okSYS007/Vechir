Процедура ОтправкаEMAIL_ЗаказПокупателяОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	//Дандали В. 03.09.2024 + №009169
	Возврат;
	//Дандали В. 03.09.2024 +
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не Источник.СтатусЗаказа.АвтоматическиОтправлятьПоУсловию_EMAIL Тогда 
		//ИЛИ Не ЗначениеЗаполнено(Источник.СтатусЗаказа.ШаблонEMAIL) Тогда 
		Возврат;	
	КонецЕсли;
	
	ПараметрыШаблона 	= Неопределено;
	ШаблонEMAIL 		= Неопределено;
	ШаблонТемыEMAIL 	= Неопределено;
	
	СоотвествуетУсловиямАвтоотправки = Справочники.СтатусыЗаказов.ПроверитьУсловияАвтоматическойОтправкиСообщений(Источник.Ссылка,ПараметрыШаблона,,Истина);
	Если НЕ СоотвествуетУсловиямАвтоотправки ИЛИ ТипЗнч(ПараметрыШаблона) <> Тип("Структура") ИЛИ 
		НЕ (ПараметрыШаблона.Свойство("ШаблонEMAIL", ШаблонEMAIL) И ПараметрыШаблона.Свойство("ШаблонТемыEMAIL", ШаблонТемыEMAIL)) Тогда 
		Возврат;
	КонецЕсли;
	
	Если АдресВЧерномСписке(Источник.Контрагент, СокрЛП(Источник.АдресЭлектроннойПочтыПредставление)) Тогда 
		Возврат;
	КонецЕсли;
	
	//ШаблонEMAIL = Источник.СтатусЗаказа.ШаблонEMAIL;
	ТекстСМС = "";
	
	Если ШаблонEMAIL.ИспользоватьВыражение Тогда
		
		Выполнить("ТекстEMAIL = " + СтрЗаменить(ШаблонEMAIL.Выражение,"ЭтотОбъект","Источник"));
	Иначе
		ТекстEMAIL = СокрЛП(ШаблонEMAIL.Текст);
	КонецЕсли;
	
	Если ШаблонТемыEMAIL.ИспользоватьВыражение Тогда
		
		Выполнить("ТекстТемыEMAIL = " + СтрЗаменить(ШаблонТемыEMAIL.Выражение,"ЭтотОбъект","Источник"));
	Иначе
		ТекстТемыEMAIL = СокрЛП(ШаблонТемыEMAIL.Текст);
	КонецЕсли;
	
	ПредставлениеЭлектроннойПочты = СокрЛП(Источник.АдресЭлектроннойПочтыПредставление);
	
	Если БылаАналогичнаяОтправка(Источник,ПредставлениеЭлектроннойПочты,ТекстEMAIL,ШаблонEMAIL.Тип) Тогда 
		Возврат;	
	КонецЕсли;
	
	//Сообщить("Сообщение ТекстEMAIL отправлено!");
	//Сообщить(ТекстEMAIL);
	
	ПисьмоОтправлено = Ложь;
	УправлениеЭлектроннойПочтой.ОтправитьПисьмо(Константы.ОсновнаяУчетнаяЗаписьЭлПочты.Получить(), ТекстEMAIL, ПредставлениеЭлектроннойПочты, ТекстТемыEMAIL, ПисьмоОтправлено);
	
	Если Источник <> Неопределено И ПисьмоОтправлено = Истина Тогда 
		НаборЗаписей = РегистрыСведений.ОтправленныеСообщения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Телефон.Значение			= ПредставлениеЭлектроннойПочты;
		НаборЗаписей.Отбор.Телефон.Использование 	= Истина;
		НаборЗаписей.Отбор.Адресат.Значение			= СокрЛП(Источник.Контрагент);
		НаборЗаписей.Отбор.Адресат.Использование 	= Истина;
		НаборЗаписей.Отбор.Заказ.Значение			= Источник.Ссылка;
		НаборЗаписей.Отбор.Заказ.Использование 		= Истина;
		НаборЗаписей.Прочитать();
		
		Запись = НаборЗаписей.Добавить();
		Запись.Период			=  ТекущаяДата();
		Запись.Телефон 			=  ПредставлениеЭлектроннойПочты;
		Запись.Адресат 			=  СокрЛП(Источник.Контрагент);
		Запись.Заказ 			=  Источник.Ссылка;
		
		Запись.Текст 			=  ТекстEMAIL;
		Запись.СтатусОтправки 	=  Перечисления.СтатусыОтправкиСМС.ПустаяСсылка();
		Запись.Шаблон 			=  ?(ШаблонEMAIL = Неопределено, Справочники.ШаблоныСообщений.ПустаяСсылка(), ШаблонEMAIL);
		Запись.ТипШаблона		=	ШаблонEMAIL.Тип;
		Запись.ДатаОтправки 	=  ТекущаяДата();
		Запись.ИД_Сообщения		=  СокрЛП(Новый УникальныйИдентификатор); 
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция СоотвествуетУсловиямАвтоотправки(ЗаказПокупателя)
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЗаказПокупателя.СтатусЗаказа);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтатусыЗаказовУсловиеАвтоматическойОтправки.РеквизитДокумента,
	               |	СтатусыЗаказовУсловиеАвтоматическойОтправки.ВидСравнения,
	               |	СтатусыЗаказовУсловиеАвтоматическойОтправки.ЗначениеРеквизитаДокумента
	               |ИЗ
	               |	Справочник.СтатусыЗаказов.УсловияАвтоматическойОтправки КАК СтатусыЗаказовУсловиеАвтоматическойОтправки
	               |ГДЕ
	               |	СтатусыЗаказовУсловиеАвтоматическойОтправки.Ссылка = &Ссылка
	               |	И СтатусыЗаказовУсловиеАвтоматическойОтправки.Использовать = ИСТИНА";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если ЗаказПокупателя[Выборка.РеквизитДокумента] <> Выборка.ЗначениеРеквизитаДокумента Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция БылаАналогичнаяОтправка(ЗаказПокупателя, Телефон, Текст, ТипШаблона)
	
	СтатусыОтправки = Новый Массив();
	СтатусыОтправки.Добавить(Перечисления.СтатусыОтправкиСМС.ACCEPTD);
	СтатусыОтправки.Добавить(Перечисления.СтатусыОтправкиСМС.ENROUTE);
	СтатусыОтправки.Добавить(Перечисления.СтатусыОтправкиСМС.DELIVRD);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя.Ссылка);
	Запрос.УстановитьПараметр("СтатусыОтправки", СтатусыОтправки);
	Запрос.УстановитьПараметр("Телефон", Телефон);
	Запрос.УстановитьПараметр("Текст", Лев(Текст,500));
	Запрос.УстановитьПараметр("ТипШаблона", ТипШаблона); 
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(*) КАК КоличествоОтправленныхСообщений
	               |ИЗ
	               |	РегистрСведений.ОтправленныеСообщения.СрезПоследних(
	               |			,
	               |			Заказ = &ЗаказПокупателя
	               |				И Телефон = &Телефон
	               |				И Текст ПОДОБНО &Текст
	               |				И ТипШаблона = &ТипШаблона) КАК ОтправленныеСообщенияСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда 
		КоличествоОтправленныхСообщений = 0;
	Иначе
		КоличествоОтправленныхСообщений = Выборка.КоличествоОтправленныхСообщений; 	
	КонецЕсли;
	
	Возврат КоличествоОтправленныхСообщений > 0;
	
КонецФункции

Функция ОтправитьTurboSMS(НомерПолучателя, ТекстСообщения, Шаблон = Неопределено, ЗаказПокупателя = Неопределено) Экспорт

	Driver = "MySQL ODBC 3.51 Driver";
	SERVER = "sql.turbosms.ua";
	DataBase = "users";
	UID = Константы.ЛогинСМС.Получить();
	PWD = Константы.ПарольСМС.Получить(); 
	ConnectionString = "DRIVER=MySQL ODBC 3.51 Driver;SERVER=sql.turbosms.ua;DataBase=users;UID="+UID+";PWD="+PWD+";Mode=Read|Write";
	
	Соединение = Новый COMОбъект("ADODB.Connection");
	Соединение.Mode=3;
	Соединение.ConnectionTimeout = 15;
	Соединение.CursorLocation= 3;
	Соединение.ConnectionString = ConnectionString;
	
	Попытка
		Соединение.Open();
	Исключение
		Сообщить("Не могу подключиться к базе!!!");
		Сообщить(описаниеошибки());
		Возврат 0;
	КонецПопытки;
	
	Соединение.Execute("SET NAMES cp1251");
	
	НЗ=Новый COMОбъект("ADODB.Recordset");
	НЗ.Open("SELECT * FROM " + Константы.ЛогинСМС.Получить(),Соединение,2,3); 
	Нз.AddNew();
	Нз.Fields("number").Value	= НомерПолучателя;
	Нз.Fields("message").Value	= ТекстСообщения;
	Нз.Fields("sign").Value		= Константы.АльфаИмя.Получить();
	Нз.Update();
	Ид=Нз.Fields("id").Value;
	Нз.Close();
	Нз="";
	Соединение.Close();
	Соединение ="";

	Если ЗаказПокупателя <> Неопределено Тогда 
		НаборЗаписей = РегистрыСведений.ОтправленныеСообщения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Телефон.Значение			= НомерПолучателя;
		НаборЗаписей.Отбор.Телефон.Использование 	= Истина;
		НаборЗаписей.Отбор.Адресат.Значение			= СокрЛП(ЗаказПокупателя.Контрагент);
		НаборЗаписей.Отбор.Адресат.Использование 	= Истина;
		НаборЗаписей.Отбор.Заказ.Значение			= ЗаказПокупателя;
		НаборЗаписей.Отбор.Заказ.Использование 		= Истина;
		НаборЗаписей.Прочитать();
		
		Запись = НаборЗаписей.Добавить();
		Запись.Период			=  ТекущаяДата();
		Запись.Телефон 			=  НомерПолучателя;
		Запись.Адресат 			=  СокрЛП(ЗаказПокупателя.Контрагент);
		Запись.Заказ 			=  ЗаказПокупателя;
		
		Запись.Текст 			=  ТекстСообщения;
		Запись.СтатусОтправки 	=  Перечисления.СтатусыОтправкиСМС.ПустаяСсылка();
		Запись.Шаблон 			=  ?(Шаблон = Неопределено, Справочники.ШаблоныСообщений.ПустаяСсылка(), Шаблон);
		Запись.ТипШаблона		= 	Шаблон.Тип;
		Запись.ДатаОтправки 	=  ТекущаяДата();
		Запись.ИД_Сообщения		=  Ид; 
		НаборЗаписей.Записать();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СостояниеTurboSMS() Экспорт 
    Соединение = Новый COMОбъект("ADODB.Connection");
    СтрокаСоединение = "DRIVER={MySQL ODBC 3.51 Driver};SERVER=94.249.146.189;DataBase=users;UID=" + Константы.ЛогинСМС.Получить() +";PWD=" + Константы.ПарольСМС.Получить();
    Попытка
        Соединение.Open(СтрокаСоединение);
    Исключение
        Сообщить("Не могу подключиться к базе!!!");
        Сообщить(описаниеошибки());
        Возврат Ложь;
    КонецПопытки;
		
	Соединение.Execute("SET NAMES cp1251");//Установим кодировку
	

Функция АдресВЧерномСписке(Владелец, АдресЭлектроннойПочты) Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец"				, Владелец);
	Запрос.УстановитьПараметр("АдресЭлектроннойПочты"	, АдресЭлектроннойПочты);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧерныйСписокEMAIL.ЗапретИспользования
	               |ИЗ
	               |	РегистрСведений.ЧерныйСписокEMAIL КАК ЧерныйСписокEMAIL
	               |ГДЕ
	               |	ЧерныйСписокEMAIL.Владелец = &Владелец
	               |	И ЧерныйСписокEMAIL.АдресЭлектроннойПочты ПОДОБНО &АдресЭлектроннойПочты";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Результат = Выборка.ЗапретИспользования;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНомерПолучателяИзЗаказа(ЗаказСсылка, Интерактивно = Ложь) Экспорт
	
	НомерПолучателя = "";
	Если ПолучитьФункциональнуюОпцию("ОтдельныйНомерДляСМС") Тогда
		НомерПолучателя = СокрЛП(ЗаказСсылка.ТелефонДляСМС);
		Если ПустаяСтрока(НомерПолучателя) Тогда
			#Если Клиент Тогда
				Если ПолучитьФункциональнуюОпцию("ОтдельныйНомерДляСМС") И Интерактивно Тогда 
					Ответ = Вопрос("Не указан номер, для отправки СМС. Использовать основной номер из заказа?",РежимДиалогаВопрос.ДаНет);
					Если Ответ = КодВозвратаДиалога.Нет Тогда 
						Возврат НомерПолучателя;
					КонецЕсли;
				КонецЕсли;
			#КонецЕсли
			НомерПолучателя = СокрЛП(ЗаказСсылка.КонтактныйТелефонПредставление);
		КонецЕсли;
	Иначе
		НомерПолучателя = СокрЛП(ЗаказСсылка.КонтактныйТелефонПредставление);
	КонецЕсли;
	
	Возврат НомерПолучателя;
	
КонецФункции
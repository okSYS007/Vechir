Функция ТребуетсяУдалениеДанныхНаМобильномУстройстве(Данные, УзелУстройства)

	Если (УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23") И ТипЗнч(Данные) = Тип("СправочникОбъект.ЕдиницыИзмерения") Тогда
		Если ТипЗнч(Данные.Владелец) <> Тип("СправочникСсылка.Номенклатура") Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("РегистрСведенийНаборЗаписей.Штрихкоды") Тогда
		Если ТипЗнч(Данные.Отбор.Владелец.Значение) <> Тип("СправочникСсылка.Номенклатура") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;


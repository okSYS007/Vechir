			ЗаписатьXML(ЗаписьXML, Данные.Отбор.Характеристика.Значение, "ХарактеристикаНоменклатуры");
		КонецЕсли;
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("Records");
	Для Каждого СтрокаНабора Из Данные Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Record");
		ЗаписатьXML(ЗаписьXML, СтрокаНабора.Штрихкод, "Штрихкод");
		ЗаписатьXML(ЗаписьXML, СтрокаНабора.Владелец, "Владелец");
		Если УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23" Тогда
			ЗаписатьXML(ЗаписьXML, СтрокаНабора.ЕдиницаИзмерения, "ЕдиницаИзмерения");
			ЗаписатьXML(ЗаписьXML, СтрокаНабора.СерияНоменклатуры, "СерияНоменклатуры");
			ЗаписатьXML(ЗаписьXML, СтрокаНабора.ХарактеристикаНоменклатуры, "ХарактеристикаНоменклатуры");
		ИначеЕсли УзелУстройства.Конфигурация = "BASRetail" Тогда
			ЗаписатьXML(ЗаписьXML, "00000000-0000-0000-0000-000000000000", "ЕдиницаИзмерения");
			ЗаписатьXML(ЗаписьXML, "00000000-0000-0000-0000-000000000000", "СерияНоменклатуры");
			ЗаписатьXML(ЗаписьXML, СтрокаНабора.Характеристика, "ХарактеристикаНоменклатуры");
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	ЗаписьXML.ЗаписатьКонецЭлемента();

Процедура ЗаписатьДанные(ЗаписьXML, Данные, УзелУстройства, ВыгружатьКартинкиПринудительно = Ложь) Экспорт

	#Если Клиент Тогда
	Состояние(СокрЛП(Данные));
	ОбработкаПрерыванияПользователя();
	#КонецЕсли
	Если ТипЗнч(Данные) = Тип("СправочникОбъект.Номенклатура")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Номенклатура") Тогда
		ВыгрузкаВМобильнуюБазуСправочникНоменклатура(ЗаписьXML, Данные, УзелУстройства, ВыгружатьКартинкиПринудительно);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Контрагенты")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Контрагенты") Тогда
		ВыгрузкаВМобильнуюБазуСправочникКонтрагенты(ЗаписьXML, Данные, УзелУстройства);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Организации")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Организации") Тогда
		ВыгрузкаВМобильнуюБазуСправочникОрганизации(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Склады")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Склады") Тогда
		ВыгрузкаВМобильнуюБазуСправочникСклады(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.СерииНоменклатуры")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.СерииНоменклатуры") Тогда
		ВыгрузкаВМобильнуюБазуСправочникСерииНоменклатуры(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.ХарактеристикиНоменклатуры")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		ВыгрузкаВМобильнуюБазуСправочникХарактеристикиНоменклатуры(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Пользователи")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Пользователи") Тогда
		ВыгрузкаВМобильнуюБазуСправочникПользователи(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("РегистрСведенийНаборЗаписей.Штрихкоды") Тогда
		ВыгрузкаВМобильнуюБазуРегистрСведенийШтрихкоды(ЗаписьXML, Данные, УзелУстройства);
	ИначеЕсли ТипЗнч(Данные) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		ВыгрузкаВМобильнуюБазуДокументЗаказПоставщику(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("РегистрСведенийНаборЗаписей.vrgНастройкиМобильныхУстройств") Тогда
		ВыгрузкаВМобильнуюБазуРегистрСведенийНастройкиМобильныхУстройств(ЗаписьXML, Данные, УзелУстройства);
	ИначеЕсли (УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23")
		И (ТипЗнч(Данные) = Тип("СправочникОбъект.ДоговорыКонтрагентов") ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.ДоговорыКонтрагентов")) Тогда
		ВыгрузкаВМобильнуюБазуСправочникДоговорыКонтрагентов(ЗаписьXML, Данные);
	ИначеЕсли (УзелУстройства.Конфигурация = "BASRetail" И (ТипЗнч(Данные) = Тип("СправочникОбъект.ВидыЦен") ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.ВидыЦен")))
		ИЛИ ((УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23")
		И (ТипЗнч(Данные) = Тип("СправочникОбъект.ТипыЦенНоменклатуры") ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.ТипыЦенНоменклатуры"))) Тогда
		ВыгрузкаВМобильнуюБазуСправочникТипыЦенНоменклатуры(ЗаписьXML, Данные);
	ИначеЕсли (УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23")
		И (ТипЗнч(Данные) = Тип("СправочникОбъект.ЕдиницыИзмерения")ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.ЕдиницыИзмерения")) Тогда
		ВыгрузкаВМобильнуюБазуСправочникЕдиницыИзмерения(ЗаписьXML, Данные, УзелУстройства);
	ИначеЕсли УзелУстройства.Конфигурация = "BASRetail" И (ТипЗнч(Данные) = Тип("СправочникОбъект.БазовыеЕдиницыИзмерения") ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.БазовыеЕдиницыИзмерения")) Тогда
		ВыгрузкаВМобильнуюБазуСправочникБазовыеЕдиницыИзмерения(ЗаписьXML, Данные);
		
	//+NovashIV_24.01.2023	
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Области")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Области") Тогда
		ВыгрузкаВМобильнуюБазуСправочникОбласти(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Районы")

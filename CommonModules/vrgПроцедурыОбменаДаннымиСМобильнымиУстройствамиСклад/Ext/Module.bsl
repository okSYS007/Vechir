		КонецЕсли;
		Если Данные.Отбор.ХарактеристикаНоменклатуры.Использование Тогда
			ЗаписатьXML(ЗаписьXML, Данные.Отбор.ХарактеристикаНоменклатуры.Значение, "ХарактеристикаНоменклатуры");
		КонецЕсли;
	ИначеЕсли УзелУстройства.Конфигурация = "BASRetail" Тогда
		ЗаписатьXML(ЗаписьXML, "00000000-0000-0000-0000-000000000000", "ЕдиницаИзмерения");

#КонецОбласти

#Область ВыгрузкаТиповДанных

Процедура ВыгрузкаВМобильнуюБазуОбщихРеквизитовСправочников(ЗаписьXML, Данные, ВыгружатьПризнакГруппы = Истина, ВыгружатьРодителя = Истина, ВыгружатьВладельца = Ложь, ВыгружатьКод = Истина, УзелУстройства = Неопределено)

	ЗаписатьXML(ЗаписьXML, Данные.Ссылка.УникальныйИдентификатор(), "Ref");

	Если ВыгружатьПризнакГруппы Тогда
		ЗаписатьXML(ЗаписьXML, Данные.ЭтоГруппа, "IsFolder");
	КонецЕсли;

	ЗаписатьXML(ЗаписьXML, Данные.ПометкаУдаления, "DeletionMark");

	Если ВыгружатьВладельца Тогда
		ЗаписатьXML(ЗаписьXML, Данные.Владелец, "Owner", НазначениеТипаXML.Явное);
	КонецЕсли;

	Если ВыгружатьРодителя Тогда
		ЗаписатьXML(ЗаписьXML, Данные.Родитель.УникальныйИдентификатор(), "Parent");
	КонецЕсли;

	Если ВыгружатьКод Тогда
		ЗаписатьXML(ЗаписьXML, Данные.Код, "Code");
	КонецЕсли;

	ЗаписатьXML(ЗаписьXML, Данные.Наименование, "Description");

КонецПроцедуры

Процедура ВыгрузкаВМобильнуюБазуОбщихРеквизитовДокументов(ЗаписьXML, Данные)
	
	ЗаписатьXML(ЗаписьXML, Данные.Ссылка.УникальныйИдентификатор(), "Ref");

	ЗаписатьXML(ЗаписьXML, Данные.ПометкаУдаления, "DeletionMark");

	ЗаписатьXML(ЗаписьXML, Данные.Дата, "Date");

	ЗаписатьXML(ЗаписьXML, Данные.Номер, "Number");

	ЗаписатьXML(ЗаписьXML, Данные.Проведен, "Posted");

КонецПроцедуры

Процедура ВыгрузкаВМобильнуюБазуСправочникНоменклатура(ЗаписьXML, Данные, УзелУстройства, ВыгружатьКартинкиПринудительно)

	ЗаписьXML.ЗаписатьНачалоЭлемента("CatalogObject.Номенклатура");

	ВыгрузкаВМобильнуюБазуОбщихРеквизитовСправочников(ЗаписьXML, Данные);

	Если Не Данные.ЭтоГруппа Тогда
		ЗаписатьXML(ЗаписьXML, Данные.Весовой, "Весовой");
		Если УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23" Тогда
			ЕдиницаХраненияОстатков = Данные.ЕдиницаХраненияОстатков;
			ОсновноеИзображениеНоменклатуры = Данные.ОсновноеИзображение;
		ИначеЕсли УзелУстройства.Конфигурация = "BASRetail" Тогда
			ЕдиницаХраненияОстатков = "00000000-0000-0000-0000-000000000000";
			ОсновноеИзображениеНоменклатуры = Неопределено;
		КонецЕсли;
		ЗаписатьXML(ЗаписьXML, ЕдиницаХраненияОстатков, "ЕдиницаХраненияОстатков");
		ЗаписатьXML(ЗаписьXML, ЗначениеЗаполнено(ОсновноеИзображениеНоменклатуры), "ОсновноеИзображениеДобавлено");
		ЗаписатьXML(ЗаписьXML, Данные.Артикул, "Артикул");
		ОсновноеИзображение = Новый ХранилищеЗначения(Неопределено);
		Если ЗначениеЗаполнено(ОсновноеИзображениеНоменклатуры)
			И (УзелУстройства.ВыгружатьКартинки ИЛИ ВыгружатьКартинкиПринудительно) Тогда
			ОсновноеИзображение = ОсновноеИзображениеНоменклатуры.Хранилище;
		КонецЕсли;
		ЗаписатьXML(ЗаписьXML, ОсновноеИзображение, "ОсновноеИзображение");
		ЕдиницаИзмерения = "00000000-0000-0000-0000-000000000000";
		Если УзелУстройства.Конфигурация = "BASRetail" Тогда
			ЕдиницаИзмерения = Данные.ЕдиницаИзмерения;
		КонецЕсли;
		ЗаписатьXML(ЗаписьXML, ЕдиницаИзмерения, "ЕдиницаИзмерения");
		ЗаписатьXML(ЗаписьXML, Данные.ВестиУчетПоСериям, "ВестиУчетПоСериям");
	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры 

Процедура ВыгрузкаВМобильнуюБазуСправочникЕдиницыИзмерения(ЗаписьXML, Данные, УзелУстройства)

	ЗаписьXML.ЗаписатьНачалоЭлемента("CatalogObject.ЕдиницыИзмерения");

	ВыгрузкаВМобильнуюБазуОбщихРеквизитовСправочников(ЗаписьXML, Данные, Ложь, Ложь, Истина, , УзелУстройства);

	Если УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23" Тогда

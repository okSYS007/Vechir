	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.НаправленияЗатрат")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.НаправленияЗатрат") Тогда
		ВыгрузкаВМобильнуюБазуСправочникНаправленияЗатрат(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.СтатьиЗатрат")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.СтатьиЗатрат") Тогда
		ВыгрузкаВМобильнуюБазуСправочникСтатьиЗатрат(ЗаписьXML, Данные);
		
	//	
	//-NovashIV_24.01.2023
		
		//ИначеЕсли ТипЗнч(Данные) = Тип("ДокументОбъект.ПеремещениеТоваров") Тогда
	//	ВыгрузкаВМобильнуюБазуДокументПеремещениеТоваров(ЗаписьXML, Данные);
	//ИначеЕсли ТипЗнч(Данные) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
	//	ВыгрузкаВМобильнуюБазуДокументПоступлениеТоваровУслуг(ЗаписьXML, Данные);
	//ИначеЕсли ТипЗнч(Данные) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
	//	ВыгрузкаВМобильнуюБазуДокументРеализацияТоваровУслуг(ЗаписьXML, Данные);
	//ИначеЕсли ТипЗнч(Данные) = Тип("ДокументОбъект.ИнвентаризацияТоваровНаСкладе") Тогда

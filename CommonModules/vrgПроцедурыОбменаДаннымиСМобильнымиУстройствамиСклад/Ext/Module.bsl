				|		ХозрасчетныйВидыСубконто.ВидСубконто В(&ВидСубконто)
				|		И ХозрасчетныйВидыСубконто.Количественный
				|	
				|	СГРУППИРОВАТЬ ПО
				|		ХозрасчетныйВидыСубконто.Ссылка) КАК ХозрасчетныйВидыСубконто
				|ГДЕ
				|	ХозрасчетныйВидыСубконто.ВидСубконто = 2
				|";
				ВидСубконто = Новый СписокЗначений;
				ВидСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады);
				ВидСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
				ЗапросСчетов.УстановитьПараметр("ВидСубконто", ВидСубконто);
				РезультатЗапросаСчетов = ЗапросСчетов.Выполнить();
				Если НЕ РезультатЗапросаСчетов.Пустой() Тогда
					СчетаУчета = ЗапросСчетов.Выполнить().Выгрузить().ВыгрузитьКолонку("Счет");
				КонецЕсли;
				Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


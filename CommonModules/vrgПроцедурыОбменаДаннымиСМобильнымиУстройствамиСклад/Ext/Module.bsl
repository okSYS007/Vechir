	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.НаселенныеПункты")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.НаселенныеПункты") Тогда
		ВыгрузкаВМобильнуюБазуСправочникНаселенныеПункты(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Улицы")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Улицы") Тогда
		ВыгрузкаВМобильнуюБазуСправочникУлицы(ЗаписьXML, Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникОбъект.Подразделения")
		ИЛИ ТипЗнч(Данные) = Тип("СправочникСсылка.Подразделения") Тогда

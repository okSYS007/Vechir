	Если УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23" Тогда
		ЗаписатьXML(ЗаписьXML, Данные.Отбор.ЕдиницаИзмерения.Значение, "ЕдиницаИзмерения");
		Если Данные.Отбор.СерияНоменклатуры.Использование Тогда

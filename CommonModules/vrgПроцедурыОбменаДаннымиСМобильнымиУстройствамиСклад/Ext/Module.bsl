Процедура ЗаписатьДанныеРегистраСведенийЦеныНоменклатурыМобильные(УзелУстройства) Экспорт

	ТаблицаРазличий = ПолучитьТаблицуРазличийДляРегистраСведенийЦеныНоменклатурыМобильные(УзелУстройства);
	Если ТаблицаРазличий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ТаблицаРазличий Цикл

		Если СтрокаТаблицы.Цена <> 0 Тогда
			НаборЗаписей = РегистрыСведений.vrgЦеныНоменклатурыМобильныеСклад.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаТаблицы.Номенклатура);
			НаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(СтрокаТаблицы.ЕдиницаИзмерения);
			НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.Установить(СтрокаТаблицы.ХарактеристикаНоменклатуры);
			НаборЗаписей.Отбор.ТипЦен.Установить(СтрокаТаблицы.ТипЦен);
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Номенклатура = СтрокаТаблицы.Номенклатура;
			НоваяЗапись.ТипЦен = СтрокаТаблицы.ТипЦен;
			НоваяЗапись.ЕдиницаИзмерения = СтрокаТаблицы.ЕдиницаИзмерения;
			НоваяЗапись.ХарактеристикаНоменклатуры = СтрокаТаблицы.ХарактеристикаНоменклатуры;
			НоваяЗапись.Цена = СтрокаТаблицы.Цена;
			НаборЗаписей.Записать();
		Иначе
			НаборЗаписейОчистка = РегистрыСведений.vrgЦеныНоменклатурыМобильныеСклад.СоздатьНаборЗаписей();
			НаборЗаписейОчистка.Отбор.Номенклатура.Установить(СтрокаТаблицы.Номенклатура);
			НаборЗаписейОчистка.Отбор.ЕдиницаИзмерения.Установить(СтрокаТаблицы.ЕдиницаИзмерения);
			НаборЗаписейОчистка.Отбор.ХарактеристикаНоменклатуры.Установить(СтрокаТаблицы.ХарактеристикаНоменклатуры);
			НаборЗаписейОчистка.Отбор.ТипЦен.Установить(СтрокаТаблицы.ТипЦен);
			НаборЗаписейОчистка.Прочитать();
			Если НаборЗаписейОчистка.Количество() > 0 Тогда
				НаборЗаписейОчистка.Очистить();
				НаборЗаписейОчистка.Записать();
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;


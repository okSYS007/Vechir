Функция ПолучитьМассивВсехУзловОбменаСМобильнымиУстройствами() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Мобильные.Ссылка
	|ИЗ
	|	ПланОбмена.vrgМобильныеСклад КАК Мобильные
	|ГДЕ
	|	Мобильные.Ссылка <> &ЭтотУзелМобильные
	|";

	Запрос.УстановитьПараметр("ЭтотУзелМобильные", ПланыОбмена.vrgМобильныеСклад.ЭтотУзел());
	МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат МассивСсылок;



#Область ФункцииВебСервиса

Функция ВыгрузитьДанныеНаМобильноеУстройство(УзелУстройства, ОбновлятьРегистрыСведений = Истина) Экспорт

	Если ОбновлятьРегистрыСведений Тогда
		ЗаписатьДанныеРегистраСведенийОстаткиНаСкладахМобильныеСклад(УзелУстройства);
		ЗаписатьДанныеРегистраСведенийЦеныНоменклатурыМобильные(УзелУстройства);
		//ЗаписатьДанныеРегистраСведенийОстаткиЗаказовПоставщикамМобильные(УзелУстройства);
	КонецЕсли;

	ЗаписьXML = Новый ЗаписьXML;

	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелУстройства);

	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8", "http://v8.1c.ru/data");

	ТипДанныхУдаления = Тип("УдалениеОбъекта");

	//ЕстьОграничениеДоступностиРедактирования = ЗначениеЗаполнено(УзелУстройства.КоличествоДнейДоступностиРедактированияДокументов);
	//ДатаОграниченияВыгрузкиДокументов = НачалоДня(ТекущаяДата()) - УзелУстройства.КоличествоДнейДоступностиРедактированияДокументов * 24*60*60;
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(УзелУстройства, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл

		Данные = ВыборкаИзменений.Получить();

		//Если ЕстьОграничениеАктуальностиДокументов И Метаданные.Документы.Содержит(Данные.Метаданные()) Тогда
		//	Если Данные.Дата < ДатаОграниченияВыгрузкиДокументов Тогда
		//		Продолжить;
		//	КонецЕсли;
		//КонецЕсли;

		// Если перенос данных не нужен, то, возможно, необходимо записать удаление данных
		Если Не НуженПереносДанных(Данные, УзелУстройства) Тогда
		
			УдалениеДанныхНаМобильномУстройстве = ТребуетсяУдалениеДанныхНаМобильномУстройстве(Данные, УзелУстройства); // получим, пока еще данные не преобразованы

			// уберем регистрацию этих данных на будущее
			Если НЕ УдалениеДанныхНаМобильномУстройстве Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелУстройства, Данные);
			КонецЕсли;
			
			УдалениеДанных(Данные);
			
			Если УдалениеДанныхНаМобильномУстройстве Тогда
				ЗаписатьДанные(ЗаписьXML, Данные, УзелУстройства);
			КонецЕсли;
			
		Иначе
			
			// Записываем данные в сообщение
			ЗаписатьДанные(ЗаписьXML, Данные, УзелУстройства);
			
		КонецЕсли;

	КонецЦикла;

	ЗаписьСообщения.ЗакончитьЗапись();

	Возврат Новый ХранилищеЗначения(ЗаписьXML.Закрыть(), Новый СжатиеДанных(9));

КонецФункции

Процедура ПринятьДанныеСМобильногоУстройства(УзелУстройства, ДанныеОбмена, ОчиститьИзменения = Истина) Экспорт

	//Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ДанныеОбмена.Получить());
		ЧтениеСообщения = ПланыОбмена.СоздатьЧтениеСообщения();
		ЧтениеСообщения.НачатьЧтение(ЧтениеXML);
		
		ЗаписьЖурналаРегистрации("Данные обмена"+УзелУстройства.код,УровеньЖурналаРегистрации.Ошибка,,ДанныеОбмена.Получить());
		
		Если ОчиститьИзменения Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(ЧтениеСообщения.Отправитель, ЧтениеСообщения.НомерПринятого);
		КонецЕсли;

		МассивДокументовДляПроведения = Новый Массив;
		НачатьТранзакцию();
		Пока ВозможностьЧтенияXML(ЧтениеXML) Цикл
			
			Данные = ПрочитатьXML(ЧтениеXML);
			Если ТипЗнч(Данные) = Тип("УдалениеОбъекта") Тогда
				Продолжить;
			КонецЕсли;

			Если Не Данные = Неопределено Тогда
				
				//Данные.ОбменДанными.Отправитель = ЧтениеСообщения.Отправитель;
				Данные.ОбменДанными.Загрузка = Истина;
				//Если Данные.Дата > (ТекущаяДата() - (60*60*24*30)) Тогда
				Если  Данные.Номер = "МБ000000727"  Или Данные.Номер = "00000000271" Тогда
					Продолжить;
				КонецЕсли;
	
				
				Данные.Записать();
			   // КонецЕсли;
			КонецЕсли;

			// если это непомеченный на удаление документ и в настройках узла задано проведение
			Если УзелУстройства.РежимЗаписиДокументовПриОбмене = "Проводить"
				И Метаданные.Документы.Содержит(Данные.Метаданные()) И НЕ Данные.ПометкаУдаления Тогда
					МассивДокументовДляПроведения.Добавить(Данные.Ссылка);
			КонецЕсли;

		КонецЦикла;
		ЗафиксироватьТранзакцию();
		
		ЧтениеСообщения.ЗакончитьЧтение();
		ЧтениеXML.Закрыть();
	//Исключение
	//	#Если Клиент Тогда
	//	Сообщить("Неудачная попытка чтения данных обмена по причине: " + ОписаниеОшибки());
	//	#КонецЕсли
	//КонецПопытки;

	ВыполнитьОтложенноеПроведениеДокументов(МассивДокументовДляПроведения);

КонецПроцедуры

Процедура ВыполнитьОтложенноеПроведениеДокументов(МассивМобильныхДокументов)

	Если МассивМобильныхДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗапросДокументов = Новый Запрос;
	ЗапросДокументов.УстановитьПараметр("МассивМобильныхДокументов", МассивМобильныхДокументов);
	ЗапросДокументов.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	vrgСоответствияМобильныхДокументов.ОсновнойДокумент
	|ИЗ
	|	РегистрСведений.vrgСоответствияМобильныхДокументов КАК vrgСоответствияМобильныхДокументов
	|ГДЕ
	|	vrgСоответствияМобильныхДокументов.МобильныйДокумент В (&МассивМобильныхДокументов)
	|	И НЕ vrgСоответствияМобильныхДокументов.ОсновнойДокумент.ПометкаУдаления
	|";
	ВыборкаДокументов = ЗапросДокументов.Выполнить().Выбрать();
	Пока ВыборкаДокументов.Следующий() Цикл
		ДокументОбъект = ВыборкаДокументов.ОсновнойДокумент.ПолучитьОбъект();
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ВыполнитьНачальнуюИнициализациюДляУзлаМобильногоУстройства(УзелУстройства, ЗаписыватьДанные = Истина) Экспорт

	//ЗаписатьДанныеРегистраСведенийОстаткиНаСкладахМобильныеСклад(УзелУстройства);
	//ЗаписатьДанныеРегистраСведенийЦеныНоменклатурыМобильные(УзелУстройства);
	//ЗаписатьДанныеРегистраСведенийОстаткиЗаказовПоставщикамМобильные(УзелУстройства);

	ЗаписьXML = Неопределено;
	Если ЗаписыватьДанные Тогда
		ЗаписьXML = Новый ЗаписьXML;

		ЗаписьXML.УстановитьСтроку("UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();

		ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
		ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелУстройства);

		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8", "http://v8.1c.ru/data");
	КонецЕсли;

	ЗарегистрироватьЗаписатьИзмененияНачальныхДанных(УзелУстройства, ЗаписыватьДанные, ЗаписьXML);

	Если ЗаписыватьДанные Тогда
		ЗаписьСообщения.ЗакончитьЗапись();
		Возврат Новый ХранилищеЗначения(ЗаписьXML.Закрыть(), Новый СжатиеДанных(9));
	КонецЕсли;

КонецФункции

Функция ИзменитьПараметрыНоменклатуры(УзелУстройства, ДанныеОбмена, ТекстОшибки) Экспорт

	СтруктураПараметров = ДесериализаторJSON(ДанныеОбмена);
	//Попытка
	//	СправочникСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(СтруктураПараметров.Номенклатура)));
	//Исключение
	//	ТекстОшибки = ТекстОшибки + "Не удалось записать реквизиты: " + ОписаниеОшибки();
	//	Возврат Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
	//КонецПопытки;

	СправочникСсылка = СтруктураПараметров.Номенклатура;
	Если СтруктураПараметров.Свойство("Расположение") Тогда
		СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
		СправочникОбъект.Расположение = СтруктураПараметров.Расположение;

		Попытка
			СправочникОбъект.Записать();
		Исключение
			ТекстОшибки = ТекстОшибки + "Не удалось изменить номенклатуру: " + ОписаниеОшибки();
			//Возврат Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
		КонецПопытки;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("ТаблицаНовыхШтрихкодов") Тогда
		Для Каждого СтрокаШтрихкода Из СтруктураПараметров.ТаблицаНовыхШтрихкодов Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаШтрихкода.Штрихкод) Тогда
				Продолжить;
			КонецЕсли;
			ЗаписьРегистра = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
			ЗаписьРегистра.Владелец = СправочникСсылка;
			ЗаписьРегистра.Штрихкод = СтрокаШтрихкода.Штрихкод;
			ЗаписьРегистра.ХарактеристикаНоменклатуры = СтрокаШтрихкода.Характеристика;
			Если УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23" Тогда
				ЗаписьРегистра.ЕдиницаИзмерения = СправочникСсылка.ЕдиницаХраненияОстатков;
				ЗаписьРегистра.Качество = Справочники.Качество.Новый;
			КонецЕсли;
			ЗаписьРегистра.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128;
			Попытка
				ЗаписьРегистра.Записать();
			Исключение
				
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелУстройства);

	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8",  "http://v8.1c.ru/data");

	ЗаписатьДанные(ЗаписьXML, СправочникСсылка, УзелУстройства);
	ЗапросШтрихкоды = Новый Запрос;
	ЗапросШтрихкоды.УстановитьПараметр("Владелец", СправочникСсылка);
	Если УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23" Тогда
		ЗапросШтрихкоды.Текст =
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Владелец КАК Владелец,
		|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Штрихкоды.СерияНоменклатуры КАК СерияНоменклатуры,
		|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Владелец = &Владелец
		|";
	ИначеЕсли УзелУстройства.Конфигурация = "BASRetail" Тогда
		ЗапросШтрихкоды.Текст =
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Владелец КАК Владелец,
		|	Штрихкоды.Характеристика КАК ХарактеристикаНоменклатуры
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Владелец = &Владелец
		|";
	КонецЕсли;
	Выборка = ЗапросШтрихкоды.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Штрихкод.Установить(Выборка.Штрихкод);
		НаборЗаписей.Отбор.Владелец.Установить(Выборка.Владелец);
		Если УзелУстройства.Конфигурация = "УТП" ИЛИ УзелУстройства.Конфигурация = "УТ23" Тогда
			НаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(Выборка.ЕдиницаИзмерения);
			НаборЗаписей.Отбор.СерияНоменклатуры.Установить(Выборка.СерияНоменклатуры);
			НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.Установить(Выборка.ХарактеристикаНоменклатуры);
		ИначеЕсли УзелУстройства.Конфигурация = "BASRetail" Тогда
			НаборЗаписей.Отбор.Характеристика.Установить(Выборка.ХарактеристикаНоменклатуры);
		КонецЕсли;
		НаборЗаписей.Прочитать();
		ЗаписатьДанные(ЗаписьXML, НаборЗаписей, УзелУстройства);
	КонецЦикла;

	ЗаписьСообщения.ЗакончитьЗапись();

	Возврат Новый ХранилищеЗначения(ЗаписьXML.Закрыть(), Новый СжатиеДанных(9));

КонецФункции

Функция ПолучитьКартинкуНоменклатуры(УзелУстройства, Номенклатура, ПолучатьОнлайн, ТекстОшибки) Экспорт

	НоменклатураСсылка = ДесериализаторJSON(Номенклатура);
	Если ПолучатьОнлайн Тогда
		Возврат НоменклатураСсылка.ОсновноеИзображение.Хранилище;
	Иначе
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку("UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписатьДанные(ЗаписьXML, НоменклатураСсылка, УзелУстройства, Истина);
		Возврат Новый ХранилищеЗначения(ЗаписьXML.Закрыть(), Новый СжатиеДанных(9));
	КонецЕсли;

КонецФункции

Функция ВыгрузитьЦеныНаМобильноеУстройство(УзелУстройства) Экспорт

	ЗаписатьДанныеРегистраСведенийЦеныНоменклатурыМобильные(УзелУстройства);

	ЗаписьXML = Новый ЗаписьXML;

	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелУстройства);

	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8",  "http://v8.1c.ru/data");

	ТаблицаЦен = ВыгрузитьДанныеРегистраСведенийНаМобильноеУстройство(УзелУстройства, "vrgЦеныНоменклатурыМобильныеСклад");
	НаборЗаписей = РегистрыСведений.vrgЦеныНоменклатурыМобильныеСклад.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(ТаблицаЦен);
	ЗаписатьДанные(ЗаписьXML, НаборЗаписей, УзелУстройства);

	ЗаписьСообщения.ЗакончитьЗапись();

	Возврат Новый ХранилищеЗначения(ЗаписьXML.Закрыть(), Новый СжатиеДанных(9));

КонецФункции

Функция ВыгрузитьОстаткиНаМобильноеУстройство(УзелУстройства) Экспорт

	ЗаписатьДанныеРегистраСведенийОстаткиНаСкладахМобильныеСклад(УзелУстройства);

	ЗаписьXML = Новый ЗаписьXML;

	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелУстройства);

	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8",  "http://v8.1c.ru/data");

	ТаблицаОстатков = ВыгрузитьДанныеРегистраСведенийНаМобильноеУстройство(УзелУстройства, "vrgОстаткиНаСкладахМобильныеСклад");
	НаборЗаписей = РегистрыСведений.vrgОстаткиНаСкладахМобильныеСклад.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(ТаблицаОстатков);
	ЗаписатьДанные(ЗаписьXML, НаборЗаписей, УзелУстройства);

	ЗаписьСообщения.ЗакончитьЗапись();

	Возврат Новый ХранилищеЗначения(ЗаписьXML.Закрыть(), Новый СжатиеДанных(9));


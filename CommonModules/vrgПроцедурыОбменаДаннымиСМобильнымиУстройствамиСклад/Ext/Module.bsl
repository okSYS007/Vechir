Процедура ЗаписатьДанныеРегистраСведенийОстаткиНаСкладахМобильныеСклад(УзелУстройства) Экспорт

	ТаблицаРазличий = ПолучитьТаблицуРазличийДляРегистраСведенийОстаткиНаСкладахМобильныеСклад(УзелУстройства);
	Если ТаблицаРазличий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ТаблицаРазличий Цикл

		Если СтрокаТаблицы.Количество <> 0 Тогда
			НаборЗаписей = РегистрыСведений.vrgОстаткиНаСкладахМобильныеСклад.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Склад.Установить(СтрокаТаблицы.Склад);
			НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаТаблицы.Номенклатура);
			НаборЗаписей.Отбор.СерияНоменклатуры.Установить(СтрокаТаблицы.СерияНоменклатуры);
			НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.Установить(СтрокаТаблицы.ХарактеристикаНоменклатуры);
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Склад = СтрокаТаблицы.Склад;
			НоваяЗапись.Номенклатура = СтрокаТаблицы.Номенклатура;
			НоваяЗапись.СерияНоменклатуры = СтрокаТаблицы.СерияНоменклатуры;
			НоваяЗапись.ХарактеристикаНоменклатуры = СтрокаТаблицы.ХарактеристикаНоменклатуры;
			НоваяЗапись.Количество = СтрокаТаблицы.Количество;
			НаборЗаписей.Записать();
		Иначе
			НаборЗаписейОчистка = РегистрыСведений.vrgОстаткиНаСкладахМобильныеСклад.СоздатьНаборЗаписей();
			НаборЗаписейОчистка.Отбор.Склад.Установить(СтрокаТаблицы.Склад);
			НаборЗаписейОчистка.Отбор.Номенклатура.Установить(СтрокаТаблицы.Номенклатура);
			НаборЗаписейОчистка.Отбор.СерияНоменклатуры.Установить(СтрокаТаблицы.СерияНоменклатуры);
			НаборЗаписейОчистка.Отбор.ХарактеристикаНоменклатуры.Установить(СтрокаТаблицы.ХарактеристикаНоменклатуры);
			НаборЗаписейОчистка.Прочитать();
			Если НаборЗаписейОчистка.Количество() > 0 Тогда
				НаборЗаписейОчистка.Очистить();
				НаборЗаписейОчистка.Записать();
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;


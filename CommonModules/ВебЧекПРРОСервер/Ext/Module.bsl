Функция СформироватьXMLчекаНаСервере (СтруктураРезультата)
	
	ERECEIPTXML=Новый ЗаписьXML();
	ERECEIPTXML.УстановитьСтроку("windows-1251");
	
	ERECEIPTXML.ЗаписатьОбъявлениеXML();
	//	
	ERECEIPTXML.ЗаписатьНачалоЭлемента("check"); 
	ERECEIPTXML.ЗаписатьАтрибут("number",XMLСтрока(СтруктураРезультата.ВходныеПараметрыПРРО.НомерЧекаВСмене));
	ERECEIPTXML.ЗаписатьАтрибут("fn",XMLСтрока(СтруктураРезультата.ВходныеПараметрыПРРО.FN ));
	ERECEIPTXML.ЗаписатьАтрибут("operationtype",XMLСтрока(СтруктураРезультата.ВходныеПараметрыПРРО.ВидОперации ));
	ERECEIPTXML.ЗаписатьАтрибут("uuid",XMLСтрока(Новый УникальныйИдентификатор()) );
	
	ERECEIPTXML.ЗаписатьНачалоЭлемента("checkhead"); 
	
	ERECEIPTXML.ЗаписатьНачалоЭлемента("ver"); 
	ERECEIPTXML.ЗаписатьТекст(XMLСтрока("1")); 
	ERECEIPTXML.ЗаписатьКонецЭлемента(); 
	
	ERECEIPTXML.ЗаписатьКонецЭлемента(); 	
	
	ФормаОплаты = "1";
	
	//	//формы оплаты
	ERECEIPTXML.ЗаписатьНачалоЭлемента("payments"); 
	Если  СтруктураРезультата.ВходныеПараметрыПРРО.Оплаты.Количество() > 0 Тогда
		Для Каждого СтрокаCHECKPAY  из СтруктураРезультата.ВходныеПараметрыПРРО.Оплаты  Цикл
			
			ERECEIPTXML.ЗаписатьНачалоЭлемента("payment"); 
			ERECEIPTXML.ЗаписатьАтрибут("id",XMLСтрока(СтрокаCHECKPAY.ID) ); 
			ERECEIPTXML.ЗаписатьАтрибут("sum",XMLСтрока(СтрокаCHECKPAY.Сумма) ); 
			ERECEIPTXML.ЗаписатьКонецЭлемента(); 
			ФормаОплаты = СтрокаCHECKPAY.ID;
		КонецЦикла;
	КонецЕсли;
	ERECEIPTXML.ЗаписатьКонецЭлемента(); 
	
	//	// товары
	ERECEIPTXML.ЗаписатьНачалоЭлемента("goods"); 
	
	Если  СтруктураРезультата.ВходныеПараметрыПРРО.Товары.Количество() > 0 Тогда
		НомерСтроки =1;
		
		Для Каждого СтрокаCHECKBODY  из СтруктураРезультата.ВходныеПараметрыПРРО.Товары Цикл
			ERECEIPTXML.ЗаписатьНачалоЭлемента("good"); 
			ERECEIPTXML.ЗаписатьАтрибут("code",XMLСтрока("0") ); 
			ERECEIPTXML.ЗаписатьАтрибут("name",XMLСтрока(СтрокаCHECKBODY.Наименование) ); 
			ERECEIPTXML.ЗаписатьАтрибут("quantity",XMLСтрока(СтрокаCHECKBODY.Количество) ); 
			ERECEIPTXML.ЗаписатьАтрибут("price",XMLСтрока(СтрокаCHECKBODY.Цена) ); 
			ERECEIPTXML.ЗаписатьАтрибут("sum",XMLСтрока(СтрокаCHECKBODY.Сумма) ); 
			ERECEIPTXML.ЗаписатьАтрибут("taxrate",XMLСтрока(СтрокаCHECKBODY.СтавкаНалога) ); 
			//	ERECEIPTXML.ЗаписатьАтрибут("uktzed",XMLСтрока(СтрокаCHECKBODY.УКТЗЕД) ); 			
			ERECEIPTXML.ЗаписатьКонецЭлемента(); 
			НомерСтроки =НомерСтроки +1;
			
		КонецЦикла;
	КонецЕсли;
	ERECEIPTXML.ЗаписатьКонецЭлемента(); 
	
	Если ФормаОплаты = "2" 
		И СтруктураРезультата.ВходныеПараметрыПРРО.Свойство("ДанныеОбОплате")
		И СтруктураРезультата.ВходныеПараметрыПРРО.ДанныеОбОплате.Количество() > 0 Тогда 
		
		СтрДанныеОбОплате = СтруктураРезультата.ВходныеПараметрыПРРО.ДанныеОбОплате[0];
		
		
		ERECEIPTXML.ЗаписатьНачалоЭлемента("L");
			
		ERECEIPTXML.ЗаписатьАтрибут("PC", XMLСтрока("СПЛАТА"));
		ERECEIPTXML.ЗаписатьАтрибут("PSNM",XMLСтрока(СтрДанныеОбОплате.ПлатежнаяСистема));
		ERECEIPTXML.ЗаписатьАтрибут("RRN", XMLСтрока(СтрДанныеОбОплате.КодRRN));
		ERECEIPTXML.ЗаписатьАтрибут("PE", XMLСтрока(СтрДанныеОбОплате.КодАвторизации));
		ERECEIPTXML.ЗаписатьАтрибут("PD", XMLСтрока(СтрДанныеОбОплате.ПлатежнаяКарта));
		ERECEIPTXML.ЗаписатьАтрибут("PB", XMLСтрока(СтрДанныеОбОплате.ТерминалID));
		ERECEIPTXML.ЗаписатьАтрибут("PA", XMLСтрока(СтрДанныеОбОплате.Эквайер));
		
		ERECEIPTXML.ЗаписатьКонецЭлемента(); 
		
	КонецЕсли;
	
	ERECEIPTXML.ЗаписатьКонецЭлемента(); 
	возврат ERECEIPTXML.Закрыть();
	

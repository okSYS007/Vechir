				конецЦикла;  
				
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли СтрокаКоманда = "SendMessage" Тогда
		ЗаписьXML.ЗаписатьАтрибут("CheckID", XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.CheckID));	
		ЗаписьXML.ЗаписатьАтрибут("Dest", XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.Dest));	
		ЗаписьXML.ЗаписатьАтрибут("messagetype", XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.messagetype));	
		ЗаписьXML.ЗаписатьАтрибут("FN", XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.FN));	
		
	ИначеЕсли СтрокаКоманда = "GetCheckCloudurl" Тогда	
		ЗаписьXML.ЗаписатьАтрибут("TaxNum", XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.ПараметрыКоманды.TaxNum));	
		ЗаписьXML.ЗаписатьАтрибут("FN", XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.FN));	
	КонецЕсли;		

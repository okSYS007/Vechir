&НаСервере
Функция ПолучитьXMLкомандынаСервере(СтруктураКоманды)	
	СтрокаКоманда = СтруктураКоманды.Команда;	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("InputParameters");
	ЗаписьXML.ЗаписатьНачалоЭлемента("Parameters");
	
	Если СтрокаКоманда ="Initialization" или СтрокаКоманда ="GetCurrentStatus"  или СтрокаКоманда ="Finalization" или СтрокаКоманда ="ShowOperators" или СтрокаКоманда ="ShowDataRRO"  или СтрокаКоманда ="GetSettingRRO" или СтрокаКоманда ="OfflineToOnline" или СтрокаКоманда ="StatusBar"   Тогда
		ЗаписьXML.ЗаписатьАтрибут("FN" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.FN));	
	иначеесли СтрокаКоманда ="OpenShift" или СтрокаКоманда ="ReportZ" или СтрокаКоманда ="ReportX"  Тогда
		ЗаписьXML.ЗаписатьАтрибут("FN" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.FN));
		ЗаписьXML.ЗаписатьАтрибут("Operatorid" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметрыПРРО.ОператорИД));
		Сообщить(" тест " +  СтруктураКоманды.ВходныеПараметрыПРРО.ОператорИД);

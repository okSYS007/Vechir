&НаСервере
Функция ОбработатьРезультатВыполненияПоследнейКомандынаСервере (СтруктураРезультата) 
	перем СтрокаXML;
	
	СтруктураРезультата.Результат = Истина;
	ОтветФРБулево = ложь;
	
	Драйвер = ВебЧекПРРОСервер.СоздатьОбъектПРРО();
	
	СтрокаXML = ПолучитьXMLкомандынаСервере(СтруктураРезультата);
	СтрокаXMLStatus = ПолучитьXMLStatusBar(СтруктураРезультата.ВходныеПараметрыПРРО.FN);
	СтрокаXMLОтвет = "";
	Если СтруктураРезультата.Команда = "Initialization"  Тогда
		ОтветФРБулево=Драйвер.Initialization(СтрокаXML);	
		СтрокаXMLОтвет = Драйвер.StatusBarXML();
		
	иначеесли  СтруктураРезультата.Команда = "OfflineToOnline"  Тогда		
		ОтветФРБулево=Драйвер.OfflineToOnline(СтрокаXML);		
		СтрокаXMLОтвет = Драйвер.StatusBarXML();
		
	иначеесли  СтруктураРезультата.Команда = "GetCurrentStatus"  Тогда		
		ОтветФРБулево=Драйвер.GetCurrentStatus(СтрокаXML);		
		СтрокаXMLОтвет = Драйвер.StatusBarXML(СтрокаXMLStatus);
		
	иначеесли  СтруктураРезультата.Команда = "GetCheck"  Тогда		
		ОтветФРБулево=Драйвер.GetCheck(СтрокаXML);
		СтрокаXMLОтвет = Драйвер.StatusBarXML(СтрокаXMLStatus);
	иначеесли  СтруктураРезультата.Команда = "GetSettingRRO"  Тогда		
		ОтветФРБулево=Драйвер.GetSetingsRRO(СтрокаXML);
		СтрокаXMLОтвет = Драйвер.StatusBarXML(СтрокаXMLStatus);
		
		СтруктураРезультата.Вставить("СтрокаXMLОтвет", СтрокаXMLОтвет);
		Возврат СтруктураРезультата;
	иначеесли  СтруктураРезультата.Команда = "Finalization"  Тогда

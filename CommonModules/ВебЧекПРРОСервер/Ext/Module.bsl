		ОтветФРБулево=Драйвер.ReportZ(СтрокаXML);
		СтрокаXMLОтвет = Драйвер.StatusBarXML(СтрокаXMLStatus);
		
	иначеесли  СтруктураРезультата.Команда = "ReportX"  Тогда
		ОтветФРБулево=Драйвер.ReportX(СтрокаXML);
		СтрокаXMLОтвет = Драйвер.StatusBarXML(СтрокаXMLStatus);
		
	иначеесли  СтруктураРезультата.Команда = "CashInOut"  Тогда
		ОтветФРБулево=Драйвер.CashInOut(СтрокаXML);
		СтрокаXMLОтвет = Драйвер.StatusBarXML(СтрокаXMLStatus);
		
		
	иначеесли  СтруктураРезультата.Команда = "FiscalReceipt"  Тогда

		ОтветФРБулево=Драйвер.FiscalReceipt(СтрокаXML);
		СтрокаXMLОтвет = Драйвер.StatusBarXML(СтрокаXMLStatus)
		
		
	иначеесли  СтруктураРезультата.Команда = "ShowPrintByCheckFn"  Тогда
		ОтветФРБулево=Драйвер.ShowPrintByCheckFn(СтрокаXML);	
		СтрокаXMLОтвет = Драйвер.StatusBarXML();
		
			
	иначеесли  СтруктураРезультата.Команда = "GetShifts"  Тогда

Функция ВыполнитьКомандуПРРОнаСервере(Команда,ВходныеПараметрыПРРО = неопределено)  Экспорт
	ПЕРЕМ РезультатВыполнения,ВыходныеПараметрыПРРО;
	ПодключитьПРРОнаСервере(ВходныеПараметрыПРРО.FN);
	
	СтруктураПараметров = Новый Структура("Результат, ВыходныеПараметрыПРРО,ВходныеПараметрыПРРО,Команда", РезультатВыполнения, ВыходныеПараметрыПРРО,ВходныеПараметрыПРРО,Команда);
	ОбработатьРезультатВыполненияПоследнейКомандынаСервере (СтруктураПараметров);
	Если не  СтруктураПараметров.Результат  Тогда 
		//ВывестиОшибку(СтруктураПараметров);
		//сообщить("Ошибка");
	иначе
		сообщить("Команда <"+СтруктураПараметров.Команда+"> Выполнена успешно !",СтатусСообщения.Информация);
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Просмотр чеков",,,,ЗначениеВСтрокуВнутр(СтруктураПараметров));
	
	Возврат СтруктураПараметров;
	


&НаКлиенте
Процедура ОК(Команда)
	
	Если Доступно Тогда 
		ЧерезКнопкуОК = Истина;
		ПроверитьПароль();
		Закрыть();
		ЧерезКнопкуОК = Ложь;
	Иначе 
		Сообщить("Немає доступу!");
	КонецЕсли;
	
	

КонецПроцедуры

&НаСервере
Функция ПроверитьПароль()
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Сообщить("Вкажіть користувача");
		Возврат Ложь;
	КонецЕсли;
	
	ПарольНеверный = Ложь;
	ЗапретДоступа = Ложь;
	//ПарольАдминистратора = "gfhjkm911";
	//Если (ИмяСобытия = "ВходВПрограмму" И (Пароль = Пользователь.Пароль ИЛИ Пароль = ПарольАдминистратора))
	//	ИЛИ (ИмяСобытия = "ОткрытиеФормыНастроек" И Пароль = "911911") Тогда
	СтруктураОтвета = Разработка.ПроверитьПарольПользователя(Пользователь, Пароль);
	Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
		СтруктураОтвета.Свойство("ЗапретДоступа", ЗапретДоступа);
		СтруктураОтвета.Свойство("ПарольНеверный", ПарольНеверный);
		Если ЗапретДоступа Тогда
			Сообщить(СтруктураОтвета.ТекстОшибки);
		КонецЕсли;
	Иначе // если нет интернета, можно проверять с локальным паролем
		ПарольНеверный = (Пароль <> Константы.ПарольДляВходаНаУстройстве.Получить());
	КонецЕсли;
	Если ПарольНеверный = Истина Тогда
		Сообщить("Невірний пароль");
	КонецЕсли;
	АутентификацияПройдена = НЕ(ЗапретДоступа ИЛИ ПарольНеверный);
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Пользователь = Константы.ПользовательПоУмолчанию.Получить();
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ЗапросПользователи = Новый Запрос;
		ЗапросПользователи.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|";
		ВыборкаПользователей = ЗапросПользователи.Выполнить().Выбрать();
		Если НЕ ВыборкаПользователей.Следующий() Тогда
			Константы.ПользовательПоУмолчанию.Установить(Справочники.Пользователи.ПустаяСсылка());
			Отказ = Истина;
		ИначеЕсли ВыборкаПользователей.Количество() = 1 Тогда
			Пользователь = ВыборкаПользователей.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("ИмяСобытия") Тогда
		ИмяСобытия = Параметры.ИмяСобытия;
		
		Если ИмяСобытия = "ОткрытиеФормыНастроек" Тогда
			Пользователь = "Администратор";
			Элементы.Пользователь.ТолькоПросмотр = Истина;
			АутентификацияПройдена = Ложь;
			Элементы.ОК.Заголовок = "Увійти в налаштування >>>";
			ЭтотОбъект.Заголовок = "";
		ИначеЕсли ИмяСобытия = "ВходВПрограмму" Тогда
			//Пользователь = Константы.ПользовательУстройства.Получить();
			//Элементы.Пользователь.ТолькоПросмотр = Истина;
			АутентификацияПройдена = Ложь;
			ЧерезКнопкуОК = Ложь;
			Элементы.ОК.Заголовок = "Увійти >>>";
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры


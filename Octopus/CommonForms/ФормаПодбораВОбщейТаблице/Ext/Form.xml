			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникНоменклатура.Ссылка,
	СправочникНоменклатура.ПометкаУдаления,
	СправочникНоменклатура.Родитель,
	СправочникНоменклатура.ЭтоГруппа,
	СправочникНоменклатура.Код,
	СправочникНоменклатура.Наименование,
	СправочникНоменклатура.Предопределенный,
	СправочникНоменклатура.ИмяПредопределенныхДанных,
	СправочникНоменклатура.Весовой,
	ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
	ЕСТЬNULL(Остатки.Количество, 0) КАК ОстатокТовара,
	ЕСТЬNULL(НоменклатураПодбора.Количество, 0) КАК Количество
ИЗ
	Справочник.Номенклатура КАК СправочникНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.vrgОстаткиНаСкладахМобильныеСклад КАК Остатки
		ПО (Остатки.Номенклатура = СправочникНоменклатура.Ссылка)
			И (Остатки.Склад.Код = "000000001")
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.vrgЦеныНоменклатурыМобильныеСклад КАК Цены
		ПО (Цены.Номенклатура = СправочникНоменклатура.Ссылка)
			И (Цены.ТипЦен = &amp;ТипЦен)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураПодбора КАК НоменклатураПодбора
		ПО (НоменклатураПодбора.Номенклатура = СправочникНоменклатура.Ссылка)
		</QueryText>
				<MainTable>InformationRegister.vrgОстаткиНаСкладахМобильныеСклад</MainTable>

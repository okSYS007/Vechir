// Процедура помещает результаты подбора в хранилище
&НаСервере
Процедура ЗаписатьПодборВХранилище() 
	
	//ПоместитьВоВременноеХранилище(Товары.Выгрузить(), АдресТоваровДокумента);

	НаборВыбранныхТоваров = РегистрыСведений.НоменклатураПодбора.СоздатьНаборЗаписей();
	НаборВыбранныхТоваров.Прочитать();
	
	ПоместитьВоВременноеХранилище(НаборВыбранныхТоваров.Выгрузить(), АдресТоваровДокумента);
	
	НаборВыбранныхТоваров.Очистить();
	НаборВыбранныхТоваров.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьТовар(Номенклатура, Цена = 0)

	МенеджерВыбранныхТоваров = РегистрыСведений.НоменклатураПодбора.СоздатьМенеджерЗаписи();
	МенеджерВыбранныхТоваров.Номенклатура = Номенклатура;
	МенеджерВыбранныхТоваров.Прочитать();
	
	МенеджерВыбранныхТоваров.Номенклатура = Номенклатура;
	МенеджерВыбранныхТоваров.Количество = МенеджерВыбранныхТоваров.Количество + 1;
	МенеджерВыбранныхТоваров.Цена = Цена;
	МенеджерВыбранныхТоваров.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьТовар(Номенклатура, Цена = 0, Количество = 0)

	МенеджерВыбранныхТоваров = РегистрыСведений.НоменклатураПодбора.СоздатьМенеджерЗаписи();
	МенеджерВыбранныхТоваров.Номенклатура = Номенклатура;
	МенеджерВыбранныхТоваров.Прочитать();
	
	Если Количество <> 0 Тогда
		
		МенеджерВыбранныхТоваров.Номенклатура = Номенклатура;
		// + 020485 VoroshkevichNK 22.02.2017
		//МенеджерВыбранныхТоваров.Количество = Количество;
		МенеджерВыбранныхТоваров.Количество = ?(Номенклатура.Весовой, Количество, Цел(Количество));
		// - 020485 VoroshkevichNK 22.02.2017
		МенеджерВыбранныхТоваров.Цена = Цена;
		МенеджерВыбранныхТоваров.Записать();
		
	ИначеЕсли МенеджерВыбранныхТоваров.Выбран() Тогда
		
		МенеджерВыбранныхТоваров.Удалить();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтбор(Список, Отбор, ИмяПоля, Текст)

	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Элемент = Неопределено;
	Для каждого Эл Из Отбор.Элементы Цикл
		
		Если Эл.ЛевоеЗначение = Поле Тогда
			Элемент = Эл;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Текст <> "" Тогда
		
		Если Элемент = Неопределено Тогда
			Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Элемент.ЛевоеЗначение = Поле;
		КонецЕсли;
		
		Элемент.ВидСравнения =  ВидСравненияКомпоновкиДанных.Содержит;
		Элемент.ПравоеЗначение = Текст;
		Элемент.Использование = Истина;
		Если СтарыйВидОтображения = Неопределено Тогда
			СтарыйВидОтображения = Список.Отображение;
		КонецЕсли;
		Список.Отображение = ОтображениеТаблицы.Список;
		
	Иначе
		
		Если Элемент <> Неопределено Тогда
			Отбор.Элементы.Удалить(Элемент);
		КонецЕсли;
		
		Если Список.Отображение = ОтображениеТаблицы.Список Тогда
			Список.Отображение = СтарыйВидОтображения;
		КонецЕсли;
		
		СтарыйВидОтображения = Неопределено;
		
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ЦенаПриИзменении(Элемент)

	Сумма = Количество * Цена;

КонецПроцедуры

&НаКлиенте
Процедура УменьшитьКоличество(Команда)

	Количество = Количество - 1;
	КоличествоПриИзменении(Элементы.Количество);

	мКоличествоЗапомнить = Количество;
КонецПроцедуры

&НаКлиенте
Процедура УвеличитьКоличество(Команда)
	
	Количество = Количество + 1;
	КоличествоПриИзменении(Элементы.Количество);	
	
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикаНоменклатурыПриИзменении(Элемент)

	Остаток = Разработка.ПолучитьОстаток(Номенклатура, Склад, СерияНоменклатуры, ХарактеристикаНоменклатуры, ЕдиницаИзмерения);
	Если НЕ ЭтоИнвентаризация Тогда
		Цена = Разработка.ПолучитьЦену(Номенклатура, ЕдиницаИзмерения, ТипЦен, ХарактеристикаНоменклатуры);
		Сумма = Количество * Цена;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СерияНоменклатурыПриИзменении(Элемент)

	Остаток = Разработка.ПолучитьОстаток(Номенклатура, Склад, СерияНоменклатуры, ХарактеристикаНоменклатуры, ЕдиницаИзмерения);
	Если НЕ ЭтоИнвентаризация Тогда
		Цена = Разработка.ПолучитьЦену(Номенклатура, ЕдиницаИзмерения, ТипЦен, ХарактеристикаНоменклатуры);
		Сумма = Количество * Цена;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СерияНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	МассивСерий = 	получитьСерии(Склад,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения);
	СЗСерий = Новый СписокЗначений;
	СЗСерий.ЗагрузитьЗначения(МассивСерий);
	
	НастройкиКомп = Новый НастройкиКомпоновкиДанных;
	
	ОтборСписка = НастройкиКомп.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборСписка.ПравоеЗначение = СЗСерий;
	ОтборСписка.Использование = Истина;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ФиксированныеНастройки", НастройкиКомп);
	ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	
	ОткрытьФорму(
		"Справочник.СерииНоменклатуры.Форма.ФормаВыбора",
		ПараметрыФормы,
		Элемент
	);
КонецПроцедуры  


&НаКлиенте
Процедура ПослеВыбораСерии(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ВыбранноеЗначение <> Неопределено Тогда
		СерияНоменклатуры = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры



&НаСервере
Функция получитьСерии(Склад,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения) 
	
	
	МассивСсылок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	vrgОстаткиНаСкладахМобильныеСклад.СерияНоменклатуры КАК СерияНоменклатуры
		|ИЗ
		|	РегистрСведений.vrgОстаткиНаСкладахМобильныеСклад КАК vrgОстаткиНаСкладахМобильныеСклад
		|ГДЕ
		|	vrgОстаткиНаСкладахМобильныеСклад.Склад = &Склад
		|	И vrgОстаткиНаСкладахМобильныеСклад.Номенклатура = &Номенклатура
		|	И vrgОстаткиНаСкладахМобильныеСклад.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|	И vrgОстаткиНаСкладахМобильныеСклад.Количество > 0";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	//Запрос.УстановитьПараметр("СерияНоменклатуры", СерияНоменклатуры);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивСсылок.Добавить(ВыборкаДетальныеЗаписи.СерияНоменклатуры);
	КонецЦикла;
	
	Возврат  МассивСсылок

	
	
	
КонецФункции









&НаСервере
Процедура МодельТСДПриИзмененииНаСервере()

	УстановитьДоступность();
	Если НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.РучныеНастройки") Тогда
		Возврат;
	КонецЕсли;

	Если НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Caribe_PL_45L")
		ИЛИ НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Caribe_PL_40L") Тогда
			ИмяСобытияСканирования = "scan.rcv.message";
			ИмяПоляШтрихкода = "barocode";
	ИначеЕсли НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Caribe_PL_55L") Тогда
		ИмяСобытияСканирования = "com.action.SCAN_RESULT";
		ИмяПоляШтрихкода = "scanContext";
	ИначеЕсли НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Urovo_i6300")
		ИЛИ НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Urovo_i6310") Тогда
			ИмяСобытияСканирования = "android.intent.ACTION_DECODE_DATA";
			ИмяПоляШтрихкода = "barcode_string";
	ИначеЕсли НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Newland_MT65_Beluga")
		ИЛИ НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Newland_MT90") Тогда
			ИмяСобытияСканирования = "nlscan.action.SCANNER_RESULT";
			ИмяПоляШтрихкода = "SCAN_BARCODE1";
	ИначеЕсли НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Zebra_TC21") Тогда
		//глКомпонента.УстановитьПараметр("Category", "android.intent.category.DEFAULT");
		ИмяСобытияСканирования = "com.iksoftware.zebra.SCAN";
		ИмяПоляШтрихкода = "com.symbol.datawedge.data_string";
	ИначеЕсли НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Symbol_MC40") Тогда
		//глКомпонента.УстановитьПараметр("Category", "android.intent.category.DEFAULT");
		ИмяСобытияСканирования = "com.symbol.datawedge.DWDEMO";
		ИмяПоляШтрихкода = "com.symbol.datawedge.data_string";
	ИначеЕсли НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.LTP_83") Тогда
		ИмяСобытияСканирования = "scan.rcv.message";
		ИмяПоляШтрихкода = "barocode";
	ИначеЕсли НаборКонстант.МодельТСД = ПредопределенноеЗначение("Перечисление.МоделиТСД.Sunmi_L2") Тогда
		ИмяСобытияСканирования = "com.sunmi.scanner.ACTION_DATA_CODE_RECEIVED";
		ИмяПоляШтрихкода = "data";
	КонецЕсли;

	НаборКонстант.ИмяСобытияСканирования = ИмяСобытияСканирования;
	НаборКонстант.ИмяПоляШтрихкода = ИмяПоляШтрихкода;

КонецПроцедуры


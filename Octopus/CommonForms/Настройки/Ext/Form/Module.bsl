
&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	Если Модифицированность Тогда
		Записать();
	КонецЕсли;

	Попытка
		РезультатПроверки = Разработка.Пинг();
	Исключение
		ТехническоеОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	Если РезультатПроверки = Истина Тогда
		Сообщить("Перевірка підключення до бази успішно пройдена");
	Иначе
		Сообщить("Перевірка підключення до бази не пройдена.
		|Перевірте правильність введених даних для підключення, наявність інтернету на пристрої, а також публікацію основної бази на стороні сервера.
		|
		|Або зверніться по допомогу до технічного фахівця: " + ТехническоеОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры


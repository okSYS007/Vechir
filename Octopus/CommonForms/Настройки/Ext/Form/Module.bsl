&НаСервере
Функция  ПроверитьНоменклатуруНаСервере()
	СтруктураВозврата = Новый Структура;
	Телотруктура = Новый Структура;
	
	МассивГуидов = Новый Массив;
	
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураНоменлктары = Новый Структура;
		СтруктураНоменлктары.Вставить("guid",XMLСтрока(ВыборкаДетальныеЗаписи.Ссылка));
		МассивГуидов.Добавить(СтруктураНоменлктары);
	КонецЦикла;
	
	Телотруктура.Вставить("products",МассивГуидов);
	Телотруктура.Вставить("node_code",ПланыОбмена.vrgМобильныеСклад.ЭтотУзел().Код);
	
	ЗаписьJSON  = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

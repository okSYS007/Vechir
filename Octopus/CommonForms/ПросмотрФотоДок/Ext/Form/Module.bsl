&НаКлиенте
Процедура УдалитьФото(Команда)

	ТекДанные = Элементы.АдресаФото.ТекущиеДанные;

	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НомерДетали	= НомерДетали;
	НомерФото	= ТекДанные.НомерФото;

	НомерФото = УдалитьФотоНаСервере(НомерДетали, НомерФото);

	ОбновитьФорму();

	УстановитьСтрокуФотоТекущей(НомерФото);

КонецПроцедуры

&НаСервере
Функция УдалитьФотоНаСервере(НомерДетали, НомерФото)

	ИндексСтроки = -1;

	МенеджерЗаписи = РегистрыСведений.ФотоДляВыгрузки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УИД	= НомерДетали;
	МенеджерЗаписи.НомерФото	= НомерФото;
	МенеджерЗаписи.Прочитать();

	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;

	КолВоФото = ПолучитьКолВоФотоДетали(НомерДетали);

	ПоляФото = ФотоДляОтображения.Выгрузить(, "ИмяПоляКартинки, ИмяСтраницыКартинки");

	НайденнаяСтрока = НайтиСтрокуТаблицыФормыНаСервере(ФотоДляОтображения, "НомерФото", НомерФото);

	Если НайденнаяСтрока <> Неопределено Тогда

		ИндексСтроки	= ФотоДляОтображения.Индекс(НайденнаяСтрока);

		ВсегоСтрок		= ФотоДляОтображения.Количество();
		ПоследнийИндекс	= ВсегоСтрок - 1;
		ПоследняяСтрока	= ФотоДляОтображения[ПоследнийИндекс];

		ИмяСтраницыКартинки	= ПоследняяСтрока.ИмяСтраницыКартинки;

		СтраницаКартинки	= Элементы.Найти(ИмяСтраницыКартинки);

		Если СтраницаКартинки <> Неопределено Тогда
			СтраницаКартинки.Видимость = Ложь;
		КонецЕсли;

		ФотоДляОтображения.Удалить(НайденнаяСтрока);

	КонецЕсли;

	ВсегоСтрок		= ФотоДляОтображения.Количество();
	ПоследнийИндекс	= ПоследнийИндекс - 1;

	Для ИДХ = 0 По ПоследнийИндекс Цикл

		Порядок		= ИДХ + 1;

		ПредСтрока	= ПоляФото[ИДХ];
		ТекСтрока	= ФотоДляОтображения[ИДХ];
		ТекНомер	= ТекСтрока.НомерФото;

		ТекСтрока.НомерФото				= Порядок;
		ТекСтрока.ИмяПоляКартинки		= ПредСтрока.ИмяПоляКартинки;
		ТекСтрока.ИмяСтраницыКартинки	= ПредСтрока.ИмяСтраницыКартинки;

		МенеджерЗаписи = РегистрыСведений.ФотоДляВыгрузки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УИД	= НомерДетали;
		МенеджерЗаписи.НомерФото	= ТекНомер;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.НомерФото	= Порядок;
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);

	КонецЦикла;

	НомерФото = 0;

	ИндексСтроки = ?(
		  (ИндексСтроки < ВсегоСтрок) И (ИндексСтроки >= 0)
		, ИндексСтроки
		, ПоследнийИндекс
	);

	Если ИндексСтроки > 0 Тогда
		НомерФото = ФотоДляОтображения[ИндексСтроки].НомерФото;
	КонецЕсли;

	Возврат НомерФото;

КонецФункции


&НаКлиенте
Процедура ОтправитьФото(Команда)

	Если ФотоДляОтображения.Количество() < 1 Тогда
		Сообщить("Немає фото для відправки.");
		Возврат;
	КонецЕсли;

	

		СтатусОшибки = ОтправитьФотографии(НомерДетали);

		Если НЕ СтатусОшибки Тогда
			Закрыть();
		КонецЕсли;

	

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьФотоКомплекта(ОтветПользователя, ПодчиненныеНомера) Экспорт

	Если ОтветПользователя <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СтатусОшибки = Ложь;

	Для Каждого СтрокаНомера Из ПодчиненныеНомера Цикл
		СтатусОшибки = ОтправитьФотографии(СтрокаНомера.НомерДетали) ИЛИ СтатусОшибки;
	КонецЦикла;

	Если НЕ СтатусОшибки Тогда
		СтатусОшибки = ОтправитьФотографии(НомерДетали);
	КонецЕсли;

	Если НЕ СтатусОшибки Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ОтправитьФотографии(НомерДеталиЧислом) Экспорт

	ОтветСервера = ОтправитьФотоНаСервер(НомерДеталиЧислом);

	СтатусОшибки = (НЕ ЗначениеЗаполнено(ОтветСервера));

	//НомерДеталиСтрокой = Формат(НомерДеталиЧислом, "ЧРГ=' '");

	Если СтатусОшибки Тогда

		ТекстСообщения =  "Помилка, фотографії деталі " + Наименование + " не були відправлені. "
			+ "Перевірте наявність фотографій і з'єднання.";

		ПоказатьПредупреждение(, ТекстСообщения, , "Отправка не удалась");

	Иначе

		ТекстСообщения = "Передача фотографій деталі " + Наименование + " завершена успішно.";

	КонецЕсли;

	Возврат СтатусОшибки;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПодчиненныеНомераДеталей(НомерКомплектаЧислом)
	Возврат Обработки.ФотографированиеЗапчастей.ПолучитьПодчиненныеНомераДеталей(НомерКомплектаЧислом);
КонецФункции

Функция ОтправитьФотоНаСервер(НомерДеталиЧислом) Экспорт

	

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФотоДляВыгрузки.НомерФото КАК ИмяФайла,
		|	ФотоДляВыгрузки.ДатаСоздания,
		|	ФотоДляВыгрузки.Фото
		|ИЗ
		|	РегистрСведений.ФотоДляВыгрузки
		|КАК
		|	ФотоДляВыгрузки
		|
		|ГДЕ  ФотоДляВыгрузки.УИД = &НомерДетали
		|";

	Запрос.УстановитьПараметр("НомерДетали",	НомерДеталиЧислом);

	РезультатЗапроса	= Запрос.Выполнить();

	ТаблицаРезультата	= РезультатЗапроса.Выгрузить();

	ХранилищеТаблицы	= Новый ХранилищеЗначения(ТаблицаРезультата);
	Прокси = ПроцедурыОбменаДанными.ПолучитьПрокси();

	Если Прокси = Неопределено Тогда
		Возврат -1;
	КонецЕсли;
	
	Док = Документы.vrgТребованияНакладнаяМобыльный.ПолучитьСсылку(Новый УникальныйИдентификатор(НомерДеталиЧислом));
	Номер = Док.Номер;
	ОтветСервера = Прокси.ЗагрузитьФото(Номер, ХранилищеТаблицы);

		Если ЗначениеЗаполнено(ОтветСервера) Тогда
			Для Каждого СтрокаФото Из ТаблицаРезультата Цикл
				МенеджерЗаписи = РегистрыСведений.ФотоДляВыгрузки.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.УИД	= НомерДетали;
				МенеджерЗаписи.НомерФото	= СтрокаФото.ИмяФайла;
				МенеджерЗаписи.Прочитать();
			
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Удалить();
			КонецЕсли;
			КонецЦикла;

		КонецЕсли;

	
	Возврат ОтветСервера;

КонецФункции


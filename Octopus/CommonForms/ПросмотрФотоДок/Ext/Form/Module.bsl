&НаСервереБезКонтекста
Функция ПолучитьКолВоФотоДетали(НомерДетали)

	НаборФото = РегистрыСведений.ФотоДляВыгрузки.СоздатьНаборЗаписей();

	НаборФото.Отбор.УИД.Установить(НомерДетали);

	НаборФото.Прочитать();

	КолВоФото = НаборФото.Количество();

	Возврат КолВоФото;

КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//Заголовок = ПолучитьЗаголовокФормы(НомерДетали, КолВоФото);
	ОбновитьНадписьКолВоФотоНомерДетали();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗаголовокФормы(Наименование, КолВоФото)

	Если ЗначениеЗаполнено(Наименование) Тогда
		Заголовок = Строка(КолВоФото) + " фото" +Наименование;
	Иначе
		Заголовок = "Фото деталей";
	КонецЕсли;

	Возврат Заголовок;

КонецФункции

&НаКлиенте
Процедура ОбновитьНадписьКолВоФотоНомерДетали()

	Если ЗначениеЗаполнено(Наименование) Тогда
		НадписьКолВоФотоНомерДетали = Строка(КолВоФото) + " фото " + Наименование;
	Иначе
		НадписьКолВоФотоНомерДетали = Строка(КолВоФото) + " фото";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()

	Элементы.АдресаФото.Обновить();

	//Заголовок = ПолучитьЗаголовокФормы(НомерДетали, КолВоФото);

	ОбновитьНадписьКолВоФотоНомерДетали();

КонецПроцедуры


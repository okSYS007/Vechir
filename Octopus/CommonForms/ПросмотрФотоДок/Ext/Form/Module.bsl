&НаСервере
Процедура ВывестиКартинкиНаФорму()

	Запрос = Новый Запрос(АдресаФото.ТекстЗапроса);

	ПараметрыЗапроса = АдресаФото.Параметры.Элементы;

	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
		Запрос.Параметры.Вставить(Строка(ПараметрЗапроса.Параметр), ПараметрЗапроса.Значение);
	КонецЦикла;

	Запрос.Параметры.Вставить("ПолучатьХранилище", ИСТИНА);

	Результат = Запрос.Выполнить();

	ТаблицаРезультата = Результат.Выгрузить();

	ВсегоСтрок		= ТаблицаРезультата.Количество();
	ПоследнийИндекс	= ВсегоСтрок - 1;

	Для ИДХ=0 По ПоследнийИндекс Цикл
		СтрокаТР = ТаблицаРезультата[ИДХ];
		ВывестиКартинкуНаФорму(СтрокаТР, ИДХ);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиКартинкуНаФорму(СтрокаТР, ИДХ)

	Порядок  = ИДХ + 1;

	ИмяСтраницы = "СтраницаКартинок"	+ Порядок;
	ИмяЭлемента = "ПолеКартинки"		+ Порядок;

	ДобавитьСтрокуФото(СтрокаТР, ИмяСтраницы, ИмяЭлемента);

	СтраницаКартинки	= ПолучитьСтраницуКартинки(ИмяСтраницы);
	ПолеКартинки		= ПолучитьПолеКартинки(СтраницаКартинки, ИмяЭлемента, ИДХ);

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуФото(СтрокаТР, ИмяСтраницы, ИмяЭлемента)

			ДанныеКартинки = СтрокаТР.ХранилищеФото.Получить();
		АдресХранилища = ПоместитьВоВременноеХранилище(ДанныеКартинки, УникальныйИдентификатор);
	
	НоваяСтрока = ФотоДляОтображения.Добавить();
	НоваяСтрока.НомерФото			= СтрокаТР.НомерФото;
	НоваяСтрока.АдресХранилища		= АдресХранилища;
	НоваяСтрока.ИмяПоляКартинки		= ИмяЭлемента;
	НоваяСтрока.ИмяСтраницыКартинки	= ИмяСтраницы;

КонецПроцедуры

&НаСервере
Функция ПолучитьСтраницуКартинки(ИмяСтраницы)

	ИмяЭлемента		= ИмяСтраницы;
	ТипЭлемента		= Тип("ГруппаФормы");

	НоваяГруппа		= Элементы.Найти(ИмяЭлемента);

	Если НоваяГруппа = Неопределено Тогда
		НоваяГруппа = Элементы.Добавить(ИмяЭлемента, ТипЭлемента, Элементы.СтраницыКартинок);
	КонецЕсли;

	НоваяГруппа.Видимость	= Истина;
	НоваяГруппа.Вид			= ВидГруппыФормы.Страница;
	//НоваяГруппа.Заголовок	= ЗаголовокСтраницы;

	Возврат НоваяГруппа;

КонецФункции

&НаСервере
Функция ПолучитьПолеКартинки(ГруппаРодитель, ИмяЭлемента, ИДХ)

	РеференсКартинки	= Элементы.Фото;
	ТипЭлемента			= Тип("ПолеФормы");

	НовыйЭлемент = Элементы.Найти(ИмяЭлемента);

	Если НовыйЭлемент = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, ТипЭлемента, ГруппаРодитель);
	КонецЕсли;

	ЗаполнитьНастройкиЭлементаПоРеференсу(НовыйЭлемент, РеференсКартинки);

	НовыйЭлемент.ПоложениеЗаголовка	= РеференсКартинки.ПоложениеЗаголовка;

	Если НЕ ЗначениеЗаполнено(НовыйЭлемент.ПутьКДанным) Тогда
		НовыйЭлемент.ПутьКДанным = "ФотоДляОтображения[" + ИДХ + "].АдресХранилища";
	КонецЕсли;

	Возврат НовыйЭлемент;

КонецФункции

&НаСервере
Процедура ЗаполнитьНастройкиГруппыПоРеференсу(Группа, Референс)
	Группа.Вид									= Референс.Вид;
	Группа.Группировка							= Референс.Группировка;
	Группа.ОтображатьЗаголовок					= Референс.ОтображатьЗаголовок;
	Группа.Отображение							= Референс.Отображение;
	Группа.ГоризонтальноеПоложениеПодчиненных	= Референс.ГоризонтальноеПоложениеПодчиненных;
	Группа.ШиринаПодчиненныхЭлементов			= Референс.ШиринаПодчиненныхЭлементов;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЭлементаПоРеференсу(Элемент, Референс)
	Элемент.Вид							= Референс.Вид;
	Элемент.Высота						= Референс.Высота;
	Элемент.Ширина						= Референс.Ширина;
	Элемент.РастягиватьПоВертикали		= Референс.РастягиватьПоВертикали;
	Элемент.РастягиватьПоГоризонтали	= Референс.РастягиватьПоГоризонтали;
	Элемент.АвтоМаксимальнаяВысота		= Референс.АвтоМаксимальнаяВысота;
	Элемент.АвтоМаксимальнаяШирина		= Референс.АвтоМаксимальнаяШирина;
	Элемент.МаксимальнаяВысота			= Референс.МаксимальнаяВысота;
	Элемент.МаксимальнаяШирина			= Референс.МаксимальнаяШирина;
	Элемент.ВертикальноеПоложение		= Референс.ВертикальноеПоложение;
	Элемент.ГоризонтальноеПоложение		= Референс.ГоризонтальноеПоложение;
КонецПроцедуры


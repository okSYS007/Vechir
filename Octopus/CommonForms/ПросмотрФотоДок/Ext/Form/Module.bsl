&НаКлиенте
Процедура ДобавитьФото(Команда)

	НомерФото = СнятьФото();
	ОбновитьФорму();
	УстановитьСтрокуФотоТекущей(НомерФото);

КонецПроцедуры

&НаКлиенте
Функция СнятьФото()

	//Если НомерДетали <= 0 Тогда
	//	Сообщить("Нельзя добавить фото без привязки к номеру б/у.");
	//	Возврат -1;
	//КонецЕсли;

	ДанныеФото = КлиентОбщий.ПолучитьДанныеФотоСнимка();

	Если ДанныеФото = Неопределено Тогда 
		Возврат -1;
	КонецЕсли;

	ТекущееФото		= ДанныеФото.ПолучитьДвоичныеДанные();
	АдресФото		= ПоместитьВоВременноеХранилище(ТекущееФото, УникальныйИдентификатор);

	СтруктураЗаписи	= ДобавитьФотоВРегистр(НомерДетали, АдресФото,,типДок);
	КолВоФото		= ПолучитьКолВоФотоДетали(НомерДетали);
	ИДХ				= КолВоФото - 1;

	ВывестиКартинкуНаФорму(СтруктураЗаписи, ИДХ);

	НомерФото = СнятьФото();

	НомерФото = ?(НомерФото < 0, СтруктураЗаписи.НомерФото, НомерФото);

	Возврат НомерФото;

КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьФотоВРегистр(НомерДетали, АдресФото, ЭтоАдресНаСайте = Ложь,типДок = Неопределено)

	//Пользователь1С	= ПолучениеНастроек.ПолучитьПользователя1С();
	НомерФото		= ПолучитьПоследнийНомерФото(НомерДетали);
	ХранилищеФото	= Неопределено;

	МенеджерЗаписи = РегистрыСведений.ФотоДляВыгрузки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УИД				        = НомерДетали;
	МенеджерЗаписи.НомерФото				= НомерФото;
	МенеджерЗаписи.Док                      = типДок;

	
		ДанныеФото		= ПолучитьИзВременногоХранилища(АдресФото);
		ХранилищеФото	= Новый ХранилищеЗначения(ДанныеФото);

		МенеджерЗаписи.Фото			= ХранилищеФото;

	

	//МенеджерЗаписи.Автор					= Пользователь1С;
	МенеджерЗаписи.ДатаСоздания				= ТекущаяДата();
	МенеджерЗаписи.Записать();

	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("НомерФото",		НомерФото);
	//СтруктураЗаписи.Вставить("ЭтоАдресНаСайте", ЭтоАдресНаСайте);
	//СтруктураЗаписи.Вставить("АдресФото",		АдресФото);
	СтруктураЗаписи.Вставить("ХранилищеФото",	ХранилищеФото);

	Возврат СтруктураЗаписи;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоследнийНомерФото(НомерДетали)

	ПоследнийНомер = 0;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ISNULL(МАКСИМУМ(ФотоДляВыгрузки.НомерФото), 0)
		|		КАК ПоследнийНомер
		|ИЗ
		|	РегистрСведений.ФотоДляВыгрузки
		|		КАК ФотоДляВыгрузки
		|ГДЕ
		|	ФотоДляВыгрузки.УИД = &НомерДетали
		|";

	Запрос.УстановитьПараметр("НомерДетали", НомерДетали);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПоследнийНомер = ВыборкаДетальныеЗаписи.ПоследнийНомер;
	КонецЕсли;

	ПоследнийНомер = ПоследнийНомер + 1;

	Возврат ПоследнийНомер;

КонецФункции


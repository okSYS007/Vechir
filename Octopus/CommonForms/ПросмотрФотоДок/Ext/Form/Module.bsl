&НаКлиенте
Процедура АдресаФотоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура АдресаФотоПриАктивизацииСтроки(Элемент)

	ТекДанные = Элементы.АдресаФото.ТекущиеДанные;

	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НомерФото = ТекДанные.НомерФото;

	НайденнаяСтрока = НайтиСтрокуТаблицыФормы(ФотоДляОтображения, "НомерФото", НомерФото);

	Если НайденнаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяСтраницыКартинки = НайденнаяСтрока.ИмяСтраницыКартинки;

	СтраницаКартинки = Элементы.Найти(ИмяСтраницыКартинки);

	Если СтраницаКартинки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.СтраницыКартинок.ТекущаяСтраница <> СтраницаКартинки Тогда
		Элементы.СтраницыКартинок.ТекущаяСтраница = СтраницаКартинки;
	КонецЕсли;

	ТекущийЭлемент = Элементы.АдресаФото;

//	Если ТекДанные.ЭтоАдресНаСайте Тогда
//		Фото = ТекДанные.АдресФото;
//	Иначе

//		НомерДетали	= ТекДанные.НомерДетали;
//		НомерФото	= ТекДанные.НомерФото;

//		ИзвлечьФотоИзХранилища(НомерДетали, НомерФото);

//	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтраницыКартинокПриСменеСтраницы(Элемент, ТекущаяСтраница)

	НайденнаяСтрока = НайтиСтрокуТаблицыФормы(ФотоДляОтображения, "ИмяСтраницыКартинки", ТекущаяСтраница.Имя);

	Если НайденнаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НомерФото	= НайденнаяСтрока.НомерФото;

	УстановитьСтрокуФотоТекущей(НомерФото);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтрокуФотоТекущей(НомерФото)

	КлючЗаписи	= ПолучитьКлючЗаписи(НомерДетали, НомерФото);

	Если Элементы.АдресаФото.ТекущаяСтрока <> КлючЗаписи Тогда
		Элементы.АдресаФото.ТекущаяСтрока = КлючЗаписи;
	КонецЕсли;

	ТекущийЭлемент = Элементы.АдресаФото;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКлючЗаписи(НомерДетали, НомерФото)

	СтруктураИзмерений = Новый Структура;
	СтруктураИзмерений.Вставить("УИД",	НомерДетали);
	СтруктураИзмерений.Вставить("НомерФото",	НомерФото);

	КлючЗаписи = РегистрыСведений.ФотоДляВыгрузки.СоздатьКлючЗаписи(СтруктураИзмерений);

	Возврат КлючЗаписи;

КонецФункции

&НаСервере
Процедура ИзвлечьФотоИзХранилища(НомерДетали, НомерФото)

	МенеджерЗаписи = РегистрыСведений.ma_ФотоЗарезервированныхНомеровБУ.СоздатьМенеджерЗаписи();

	МенеджерЗаписи.НомерДетали	= НомерДетали;
	МенеджерЗаписи.НомерФото	= НомерФото;

	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	ХранилищеФото	= МенеджерЗаписи.ХранилищеФото;
	ДанныеФото		= ХранилищеФото.Получить();
	АдресФото		= ПоместитьВоВременноеХранилище(ДанныеФото, УникальныйИдентификатор);

	Фото = АдресФото;

КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуТаблицыФормы(КоллекцияФормы, ИмяПоля, ЗначениеПоля)

	НайденнаяСтрока = Неопределено;

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить(ИмяПоля, ЗначениеПоля);

	НайденныеСтроки = ФотоДляОтображения.НайтиСтроки(СтруктураПоиска);

	Если НайденныеСтроки.Количество() < 1 Тогда
		Возврат НайденнаяСтрока;
	КонецЕсли;

	НайденнаяСтрока = НайденныеСтроки[0];

	Возврат НайденнаяСтрока;

КонецФункции

&НаСервере
Функция НайтиСтрокуТаблицыФормыНаСервере(КоллекцияФормы, ИмяПоля, ЗначениеПоля)

	НайденнаяСтрока = Неопределено;

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить(ИмяПоля, ЗначениеПоля);

	НайденныеСтроки = ФотоДляОтображения.НайтиСтроки(СтруктураПоиска);

	Если НайденныеСтроки.Количество() < 1 Тогда
		Возврат НайденнаяСтрока;
	КонецЕсли;

	НайденнаяСтрока = НайденныеСтроки[0];

	Возврат НайденнаяСтрока;

КонецФункции


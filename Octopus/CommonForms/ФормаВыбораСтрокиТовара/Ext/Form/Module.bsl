
&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении(Элемент)

	ЕдиницаИзмеренияПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЕдиницаИзмеренияПриИзмененииНаСервере()

	Коэффициент = ЕдиницаИзмерения.Коэффициент;
	Остаток = Остаток * СтарыйКоэффициент / Коэффициент;
	Количество = Количество * СтарыйКоэффициент / Коэффициент;
	СтарыйКоэффициент = Коэффициент;
	Если НЕ ЭтоИнвентаризация Тогда
		Цена = Разработка.ПересчитатьЦенуПриИзмененииЕдиницы(Цена, СтараяЕдиницаИзмерения, ЕдиницаИзмерения);
		СтараяЕдиницаИзмерения = ЕдиницаИзмерения;
		Сумма = Количество * Цена;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)

	Цена = ?(Количество > 0, Сумма/Количество, 0);

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.СтруктураСтрокаТовары);
	СтараяЕдиницаИзмерения = ЕдиницаИзмерения;
	СтарыйКоэффициент = Коэффициент;
	ОбновитьПоказатьКартинкуТовара();
	Параметры.СтруктураСтрокаТовары.Свойство("ЦветФонаСтроки", ЦветФонаСтроки);
	Параметры.СтруктураСтрокаТовары.Свойство("ТипЦен", ТипЦен);
	Параметры.СтруктураСтрокаТовары.Свойство("Склад", Склад);
	Элементы.ГруппаСтраницы.ЦветФона = ЦветФонаСтроки;
	Элементы.Цена.Видимость = НЕ ЭтоИнвентаризация;
	Элементы.Сумма.Видимость = НЕ ЭтоИнвентаризация;
	Если ЭтоИнвентаризация Тогда
		Элементы.Остаток.Заголовок = "Учет";
		Элементы.Количество.Заголовок = "Факт";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)

	Модифицированность = Истина;
	ПриИзмененииНоменклатурыНаСервере();
	Элементы.ГруппаСтраницы.ЦветФона = ПолучитьЦветСтроки();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНоменклатурыНаСервере()

	Артикул = Номенклатура.Артикул;
	ЕдиницаИзмерения = Номенклатура.ЕдиницаХраненияОстатков;
	СтараяЕдиницаИзмерения = ЕдиницаИзмерения;
	Коэффициент = ЕдиницаИзмерения.Коэффициент;
	СтарыйКоэффициент = Коэффициент;
	Количество = ?(Количество = 0, 1, Количество);
	Остаток = Разработка.ПолучитьОстаток(Номенклатура, Склад, СерияНоменклатуры, ХарактеристикаНоменклатуры, ЕдиницаИзмерения);
	Если НЕ ЭтоИнвентаризация Тогда
		Цена = Разработка.ПолучитьЦену(Номенклатура, ЕдиницаИзмерения, ТипЦен, ХарактеристикаНоменклатуры);
		Сумма = Количество * Цена;
	КонецЕсли;
	ОбновитьПоказатьКартинкуТовара();

КонецПроцедуры

&НаКлиенте
Процедура Готово(Команда)

	ЗакрытьПринудительно = Истина;
	ПеренестиДанныеВСтрокуДокумента();

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиДанныеВСтрокуДокумента()

	СтруктураСтроки = Новый Структура("НомерСтроки, Артикул, Номенклатура, Количество, Остаток, Цена, ЕдиницаИзмерения, Коэффициент, Сумма, СерияНоменклатуры, ХарактеристикаНоменклатуры, Примечание, Этикетка");
	ЗаполнитьЗначенияСвойств(СтруктураСтроки, ЭтаФорма);
	ОповеститьОВыборе(СтруктураСтроки);

КонецПроцедуры


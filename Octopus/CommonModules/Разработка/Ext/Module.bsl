Процедура ПроверитьЗаполнениеПланаОбмена() Экспорт
	
	НайденныйГлавныйУзел = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду("Г");
	Если Не ЗначениеЗаполнено(НайденныйГлавныйУзел) Тогда
		НовыйУзел = ПланыОбмена.vrgМобильныеСклад.СоздатьУзел();
		НовыйУзел.Код = "Г";
		НовыйУзел.Наименование = "Головна база";
		НовыйУзел.Записать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Константы.УзелЦентральнойБазы.Получить()) Тогда
		Константы.УзелЦентральнойБазы.Установить(ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду("Г"));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПланыОбмена.vrgМобильныеСклад.ЭтотУзел().Код) Тогда
		Сообщить("Увага! Встановіть код поточної бази в плані обміну, без цього обмін з основною базою неможливий!");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекущийПрефикс() Экспорт
	
	ТекПрефиксНумерацииДокументов = Константы.ПрефиксНумерацииДокументов.Получить();
	Если Не ЗначениеЗаполнено(ТекПрефиксНумерацииДокументов) Тогда
		ТекПрефиксНумерацииДокументов = "АА";
	КонецЕсли;
	
	МесяцСтрока = СокрЛП(Месяц(ТекущаяДата()));
	ДеньСтрока = СокрЛП(День(ТекущаяДата()));

	МесяцСтрока = ?(СтрДлина(МесяцСтрока) = 1, "0", "") + МесяцСтрока;
	ДеньСтрока = ?(СтрДлина(ДеньСтрока) = 1, "0", "") + ДеньСтрока;

	ТекПрефиксНумерацииДокументов = ТекПрефиксНумерацииДокументов + ДеньСтрока + МесяцСтрока;

	Возврат ТекПрефиксНумерацииДокументов;


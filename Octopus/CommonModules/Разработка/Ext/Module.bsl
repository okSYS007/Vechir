Процедура ПриЗаписиДокументаЗарегистрироватьИзмененияПриЗаписи(Источник, Отказ) Экспорт
	Регистировать = Истина;
	Если Источник.ОбменДанными.Загрузка Тогда
		Если Источник.ОбменДанными.Отправитель <> ПланыОбмена.vrgМобильныеСклад.ЭтотУзел() Тогда
			// Для узла, по которому пришли изменения, их регистрировать не нужно
			Регистировать = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	
	Если Регистировать Тогда 
		ПланыОбмена.ЗарегистрироватьИзменения(Константы.УзелЦентральнойБазы.Получить(), Источник.Ссылка);
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьНоменклатуруПоШтрихкоду(Знач Штрихкод, ПолучитьСтруктуру = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.УстановитьПараметр("СокрЛПШтрихкод", СокрЛП(Штрихкод));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Владелец КАК Номенклатура,
	|	Штрихкоды.Владелец.Артикул КАК Артикул,
	|	ВЫБОР
	|		КОГДА Штрихкоды.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА Штрихкоды.ЕдиницаИзмерения
	|		ИНАЧЕ Штрихкоды.Владелец.ЕдиницаХраненияОстатков
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА Штрихкоды.ЕдиницаИзмерения.Коэффициент > 0
	|			ТОГДА Штрихкоды.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Коэффициент,
	|	Штрихкоды.СерияНоменклатуры КАК СерияНоменклатуры,
	|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод ПОДОБНО &СокрЛПШтрихкод
	|	ИЛИ Штрихкоды.Штрихкод ПОДОБНО &Штрихкод
	|";
	Выборка = Запрос.Выполнить().Выбрать();
	Если ПолучитьСтруктуру Тогда
		Выборка.Следующий();
		СтруктураНоменклатуры = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры");
		ЗаполнитьЗначенияСвойств(СтруктураНоменклатуры, Выборка);
		Возврат СтруктураНоменклатуры;
	Иначе
		Возврат Выборка;
	КонецЕсли;

КонецФункции

Функция ПроверитьЕстьНоменклатураСерияВДокументах(Номенклатура,Серия) Экспорт
	
		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	vrgТребованияНакладнаяМобыльныйТовары.Ссылка КАК Ссылка,
		|	vrgТребованияНакладнаяМобыльныйТовары.Номенклатура КАК Номенклатура,
		|	vrgТребованияНакладнаяМобыльныйТовары.СерияНоменклатуры КАК СерияНоменклатуры
		|ИЗ
		|	Документ.vrgТребованияНакладнаяМобыльный.Товары КАК vrgТребованияНакладнаяМобыльныйТовары
		|ГДЕ
		|	vrgТребованияНакладнаяМобыльныйТовары.Номенклатура = &Номенклатура
		|	И vrgТребованияНакладнаяМобыльныйТовары.СерияНоменклатуры = &СерияНоменклатуры";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СерияНоменклатуры", Серия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Возврат  Истина;
		
	КонецЦикла;
	
	Возврат Ложь;
	
	
КонецФункции

Функция ЗапросПроверитьВерсию() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекущаяВерсия", Метаданные.Версия);
	Результат.Вставить("Узел", ПланыОбмена.vrgМобильныеСклад.ЭтотУзел().Код);
	
	Параметры = Результат.Узел + "/" + Метаданные.Версия; 
	Параметры = СтрЗаменить(Параметры, ".", "_");
	HTTPСоединение = Новый HTTPСоединение("31.134.113.57", 80, "ryslanyakovlev_1", "7338108");                                 
	HTTPЗапрос = Новый HTTPЗапрос("Test_Vechir_1c_prog/en_US/hs/api/app-version/" + Параметры);
	//HTTPЗапрос = Новый HTTPЗапрос("VechirSrv1C/en_US/hs/api/app-version/" + Параметры);
	//HTTPЗапрос = Новый HTTPЗапрос("1C_Xatanet/en_US/hs/api/app-version/" + Параметры);
	Ответ = HTTPСоединение.Получить(HTTPЗапрос);         
	
	СтрокаJson = Ответ.ПолучитьТелоКакСтроку();
	ЧтениеJson = Новый ЧтениеJSON;
	ЧтениеJson.УстановитьСтроку(СтрокаJson); 
	Данные = ПрочитатьJSON(ЧтениеJson,Истина);
	//Сообщить(СтрокаJson);
	Результат.Вставить("ВерсияНаСервере", СтрЗаменить(Данные["max_version"],"_","."));
	Результат.Успех = СтрЗаменить(Данные["max_version"],"_",".") = Метаданные.Версия;
	Возврат Результат;

Функция ПолучитьЦену(Номенклатура, ЕдиницаИзмерения, ТипЦен, ХарактеристикаНоменклатуры) Экспорт

	ЗапросЦены = Новый Запрос;
	ЗапросЦены.УстановитьПараметр("Номенклатура", Номенклатура);
	ЗапросЦены.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	ЗапросЦены.УстановитьПараметр("ТипЦен", ТипЦен);
	ЗапросЦены.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЦеныНоменклатурыМобильныеСклад.Цена КАК Цена,
	|	ЦеныНоменклатурыМобильныеСклад.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.vrgЦеныНоменклатурыМобильныеСклад КАК ЦеныНоменклатурыМобильныеСклад
	|ГДЕ
	|	ЦеныНоменклатурыМобильныеСклад.Номенклатура = &Номенклатура
	|	И ЦеныНоменклатурыМобильныеСклад.ТипЦен = &ТипЦен
	|	И ЦеныНоменклатурыМобильныеСклад.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|";
	ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();
	Цена = 0;
	Если ВыборкаЦены.Следующий() Тогда
		Цена = ПересчитатьЦенуПриИзмененииЕдиницы(ВыборкаЦены.Цена, ВыборкаЦены.ЕдиницаИзмерения, ЕдиницаИзмерения);
	КонецЕсли;
	Возврат Цена;

КонецФункции

Функция ПересчитатьЦенуПриИзмененииЕдиницы(Знач Цена, Знач ЕдиницаЦены, Знач НоваяЕдиница) Экспорт

	НовоеЗначениеЦены = Цена;

	Если ЕдиницаЦены <> НоваяЕдиница Тогда
		Если НЕ ЗначениеЗаполнено(НоваяЕдиница) Тогда // параметр единицы не задан, значить надо возвращать в единице цены
			Если НЕ ЗначениеЗаполнено(ЕдиницаЦены) Тогда // если не задана единица цены, то будем счатать цену нулевой
				НовоеЗначениеЦены = 0;
			Иначе
				НоваяЕдиница = ЕдиницаЦены;
			КонецЕсли;
		Иначе // если единица цены не совпадает с параметром, то надо пересчитать
			Если НЕ ЗначениеЗаполнено(ЕдиницаЦены) Тогда // если не задана единица цены, то будем счатать цену нулевой
				НовоеЗначениеЦены = 0;
			Иначе
				КоэффициентЦены = ЕдиницаЦены.Коэффициент;
				НовоеЗначениеЦены  = ?(НЕ ЗначениеЗаполнено(КоэффициентЦены), 0, 
									 НовоеЗначениеЦены * НоваяЕдиница.Коэффициент / КоэффициентЦены)
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат НовоеЗначениеЦены;

КонецФункции

Функция ПолучитьОстаток(Номенклатура, Склад, СерияНоменклатуры, ХарактеристикаНоменклатуры, ЕдиницаИзмерения = Неопределено) Экспорт

	НаборЗаписей = РегистрыСведений.vrgОстаткиНаСкладахМобильныеСклад.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
	НаборЗаписей.Отбор.Склад.Установить(Склад);
	НаборЗаписей.Отбор.СерияНоменклатуры.Установить(СерияНоменклатуры);
	НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.Установить(ХарактеристикаНоменклатуры);
	НаборЗаписей.Прочитать();

	ТекОстаток = 0;
	Если НаборЗаписей.Количество() > 0 Тогда
		ТекОстаток = НаборЗаписей[0].Количество;
	КонецЕсли;

	Если ЕдиницаИзмерения <> Неопределено И Номенклатура.ЕдиницаХраненияОстатков <> ЕдиницаИзмерения Тогда
		ТекОстаток = ТекОстаток * Номенклатура.ЕдиницаХраненияОстатков.Коэффициент / ?(ЕдиницаИзмерения.Коэффициент=0,1,ЕдиницаИзмерения.Коэффициент);
	КонецЕсли;
	Возврат ТекОстаток;


Функция ПолучитьПрокси(СообщатьОбОшибках = Истина, ИмяОперации = Неопределено) Экспорт

	Адрес = Константы.АдресПодключенияКБазе.Получить();
	Пользователь = Константы.ИмяПользователяДляПодключенияКБазе.Получить();
	Пароль = Константы.ПарольПользователяДляПодключенияКБазе.Получить();

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Если СообщатьОбОшибках Тогда
			Сообщить("Не заповнено адресу підключення до стаціонарної бази.");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Адрес = Адрес + "/ws/vrgroupmobile.1cws?wsdl";
		Определения = Новый WSОпределения(Адрес, Пользователь, Пароль);

		Прокси = Новый WSПрокси(Определения, "http://www.1c.ru/SB/MobileExchange", "vrgPortableDataTerminalExchange", "vrgPortableDataTerminalExchangeSoap", , 40*60);
		Прокси.Пользователь = Пользователь;
		Прокси.Пароль = Пароль;
	Исключение
		Если СообщатьОбОшибках Тогда
			Сообщить(?(ЗначениеЗаполнено(ИмяОперации),"["+ИмяОперации+"] ","") + "Не вдалося встановити WS-з'єднання зі стаціонарною базою.
			|Перевірте підключення до інтернету");
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;

	Возврат Прокси;


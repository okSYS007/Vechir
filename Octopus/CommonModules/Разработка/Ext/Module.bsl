Функция ИзменитьПараметрыНоменклатуры(СтруктураПараметров) Экспорт

	ТекстОшибки = "";
	РезультатОбмена = Истина;
	Прокси = ПолучитьПрокси();
	Если Прокси = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДанныеОбмена = Прокси.ИзменитьПараметрыНоменклатуры(ПланыОбмена.vrgМобильныеСклад.ЭтотУзел().Код,
													СериализаторJSON(СтруктураПараметров),
													ТекстОшибки);

	НазваниеПроцедуры = "[Изменение параметров номенклатуры] ";
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Сообщить(НазваниеПроцедуры + ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ДанныеОбмена.Получить());

		ЧтениеСообщения = ПланыОбмена.СоздатьЧтениеСообщения();
		ЧтениеСообщения.НачатьЧтение(ЧтениеXML);
		ПланыОбмена.УдалитьРегистрациюИзменений(ЧтениеСообщения.Отправитель,ЧтениеСообщения.НомерПринятого);

		НоменклатураСсылка = Неопределено;
		НачатьТранзакцию();
		Пока ВозможностьЧтенияXML(ЧтениеXML) Цикл
			Данные = ПрочитатьXML(ЧтениеXML);
			Если Не Данные = Неопределено Тогда
				Данные.Записать();
				Если ТипЗнч(Данные) = Тип("СправочникОбъект.Номенклатура") Тогда
					НоменклатураСсылка = Данные.Ссылка;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
		ЧтениеСообщения.ЗакончитьЧтение();
		ЧтениеXML.Закрыть();
		Возврат НоменклатураСсылка;
	Исключение
		ТекстОшибки = ТекстОшибки + ОписаниеОшибки();
	КонецПопытки;

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Сообщить(НазваниеПроцедуры + ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПолучитьКартинкуНоменклатуры(Номенклатура, ПолучатьОнлайн = Ложь) Экспорт

	ТекстОшибки = "";
	Прокси = ПолучитьПрокси();
	Если Прокси = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ХранилищеПолученныхДанных = Прокси.ПолучитьКартинкуНоменклатуры(ПланыОбмена.vrgМобильныеСклад.ЭтотУзел().Код, СериализаторJSON(Номенклатура), ПолучатьОнлайн, ТекстОшибки);
	Исключение
	КонецПопытки;

	НазваниеПроцедуры = "[Обновление картинки номенклатуры] ";
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Сообщить(НазваниеПроцедуры + ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;

	ДанныеХранилища = ХранилищеПолученныхДанных.Получить();

	Если ПолучатьОнлайн Тогда
		Возврат ДанныеХранилища;
	Иначе
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ДанныеХранилища);
		Пока ВозможностьЧтенияXML(ЧтениеXML) Цикл
			Данные = ПрочитатьXML(ЧтениеXML);
			Если Не Данные = Неопределено Тогда
				Данные.Записать();
			КонецЕсли;
		КонецЦикла;
		ЧтениеXML.Закрыть();
		Возврат Истина;
	КонецЕсли;


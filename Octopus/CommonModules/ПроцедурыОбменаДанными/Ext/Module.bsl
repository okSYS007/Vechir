Функция ПолучитьПрокси() Экспорт
	
		Адрес 		 = Константы.АдресПодключенияКБазе.Получить();
		Пользователь = Константы.ИмяПользователяДляПодключенияКБазе.Получить();
		Пароль 		 = Константы.ПарольПользователяДляПодключенияКБазе.Получить();
		
	
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Сообщить("Не заповнено адресу підключення до стаціонарної бази.");
		Возврат Неопределено;
	КонецЕсли;                                                 

	Попытка
		SSL = Новый ЗащищенноеСоединениеOpenSSL();
		//SSL  = Неопределено;
		
		Адрес = Адрес + "/ws/mobileSto.1cws?wsdl";
		Определения = Новый WSОпределения(Адрес,Пользователь,Пароль,,,);
		

		Прокси = Новый WSПрокси(Определения, "http://www.1c.ru/SB/MobileExchange", "MobileExchange", "MobileExchangeSoap",,,);
		
		Прокси.Пользователь = Пользователь;
		Прокси.Пароль = Пароль;
	Исключение
		Сообщить("Не вдалося встановити WS-з'єднання зі стаціонарною базою.
		|Перевірте параметри підключення. Причина:"+ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат Прокси;

КонецФункции


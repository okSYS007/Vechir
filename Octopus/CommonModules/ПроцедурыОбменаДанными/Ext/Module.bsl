функция ОтправкаФотоПриОбмене() Экспорт 
	
	Запрос_1 = Новый Запрос;
	Запрос_1.Текст = 
	"ВЫБРАТЬ
	|	ФотоДляВыгрузки.УИД КАК УИД,
	|	ФотоДляВыгрузки.Док КАК Док
	|ИЗ
	|	РегистрСведений.ФотоДляВыгрузки КАК ФотоДляВыгрузки
	|
	|СГРУППИРОВАТЬ ПО
	|	ФотоДляВыгрузки.УИД,
	|	ФотоДляВыгрузки.Док";
	
	РезультатЗапроса_1 = Запрос_1.Выполнить();
	
	ВыборкаДетальныеЗаписи_1 = РезультатЗапроса_1.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи_1.Следующий() Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФотоДляВыгрузки.НомерФото КАК ИмяФайла,
		|	ФотоДляВыгрузки.ДатаСоздания КАК ДатаСоздания,
		|	ФотоДляВыгрузки.Фото КАК Фото
		|ИЗ
		|	РегистрСведений.ФотоДляВыгрузки КАК ФотоДляВыгрузки
		|ГДЕ
		|	ФотоДляВыгрузки.УИД = &НомерДетали";
		
		Запрос.УстановитьПараметр("НомерДетали",	ВыборкаДетальныеЗаписи_1.УИД);
		
		РезультатЗапроса	= Запрос.Выполнить();
		
		ТаблицаРезультата	= РезультатЗапроса.Выгрузить();
		
		ХранилищеТаблицы	= Новый ХранилищеЗначения(ТаблицаРезультата);
		
		Прокси = ПолучитьПрокси();
		
		Если Прокси = Неопределено Тогда
			Возврат -1;
		КонецЕсли;
		
		//Попытка 
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи_1.Док) Тогда 
			Док = Null;
			Если ТипЗнч(ВыборкаДетальныеЗаписи_1.Док) = Тип("ДокументСсылка.vrgТребованияНакладнаяМобыльный") Тогда 
				//Док = Документы.vrgТребованияНакладнаяМобыльный.ПолучитьСсылку(Новый УникальныйИдентификатор(ВыборкаДетальныеЗаписи_1.УИД));
				Док = ВыборкаДетальныеЗаписи_1.Док;
				ТипДок = "Требование";
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи_1.Док) = Тип("ДокументСсылка.vrgРеализацияМобильная") Тогда 
				//Док = Документы.vrgРеализацияМобильная.ПолучитьСсылку(Новый УникальныйИдентификатор(ВыборкаДетальныеЗаписи_1.УИД));
				Док = ВыборкаДетальныеЗаписи_1.Док;

				ТипДок = "РТИУ";
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи_1.Док) = Тип("ДокументСсылка.vrgЗаказКлиентаМобильный") Тогда 
				//Док = Документы.vrgРеализацияМобильная.ПолучитьСсылку(Новый УникальныйИдентификатор(ВыборкаДетальныеЗаписи_1.УИД));
				Док = ВыборкаДетальныеЗаписи_1.Док;
                          
				ТипДок = "ЗаказПокупателя";
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи_1.Док) = Тип("ДокументСсылка.vrgВозвратМобильный") Тогда 
				//Док = Документы.vrgРеализацияМобильная.ПолучитьСсылку(Новый УникальныйИдентификатор(ВыборкаДетальныеЗаписи_1.УИД));
				Док = ВыборкаДетальныеЗаписи_1.Док;
                          
				ТипДок = "ВозвратПокупателю";
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи_1.Док) = Тип("ДокументСсылка.vrgИнвентаризацияМобильная") Тогда 
				//Док = Документы.vrgРеализацияМобильная.ПолучитьСсылку(Новый УникальныйИдентификатор(ВыборкаДетальныеЗаписи_1.УИД));
				Док = ВыборкаДетальныеЗаписи_1.Док;
                          
				ТипДок = "Инвентаризация";

			КонецЕсли;
			
						
			Если ЗначениеЗаполнено(Док) Тогда
				
				Номер = Док.Номер;
							
				ОтветСервера = Прокси.ЗагрузитьФото(Номер, ХранилищеТаблицы,ТипДок,Док.УИДДокумента);
				
				Если ЗначениеЗаполнено(ОтветСервера) Тогда
					Для Каждого СтрокаФото Из ТаблицаРезультата Цикл
						МенеджерЗаписи = РегистрыСведений.ФотоДляВыгрузки.СоздатьМенеджерЗаписи();
						МенеджерЗаписи.УИД	= ВыборкаДетальныеЗаписи_1.УИД;
						МенеджерЗаписи.НомерФото	= СтрокаФото.ИмяФайла;
						МенеджерЗаписи.Прочитать();
						
						Если МенеджерЗаписи.Выбран() Тогда
							МенеджерЗаписи.Удалить();
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
			
			
			//Исключение
		//КонецПопытки;
	КонецЦикла;
	
	//Сообщить("Все фотографии отправленны!");
	
	Возврат ОтветСервера;
	//-NovashIV_19.02.2023
КонецФункции


Функция ЭтоУТ(Склад) Экспорт 
	
	ЭтоУТ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Склад) Тогда 
		Возврат ЭтоУТ;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПарметрыПроксиБаз.Склад,
		|	ПарметрыПроксиБаз.КодМагазина КАК КодМагазина
		|ИЗ
		|	РегистрСведений.ПарметрыПроксиБаз КАК ПарметрыПроксиБаз
		|ГДЕ
		|	ПарметрыПроксиБаз.Склад = &Склад
		|";
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ЭтоУТ = НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КодМагазина);		
	КонецЕсли;
	
	Возврат ЭтоУТ;
	
КонецФункции




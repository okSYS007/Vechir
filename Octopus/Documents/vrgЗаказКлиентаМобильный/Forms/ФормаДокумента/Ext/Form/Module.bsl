Функция СформироватьТребованиеНакладнаяСервер()

	Если УжеЕстьТребование(Объект.Ссылка) Тогда
		Сообщить("По замовленню вже є вимога накладна");
		Возврат Неопределено;
	КонецЕсли;
	
	ДокТребование = Документы.vrgТребованияНакладнаяМобыльный.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ДокТребование, Объект,,"Дата, Номер, УИДДокумента");
	
	ДокТребование.Дата 							= ТекущаяДата();
	ДокТребование.Абонент 						= Объект.Контрагент;
	ДокТребование.Заказ							= Объект.Ссылка;
	ДокТребование.СозданНаМобильномУстройстве 	= Истина;

	//ДокТребование.Товары.Загрузить(Объект.Товары.Выгрузить());
	Попытка
		ДокТребование.Записать();
		Сообщить("Документ вимога створено");
		Возврат  ДокТребование.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
		 Возврат Неопределено;
Конецфункции
&НаСервереБезКонтекста
Функция УжеЕстьТребование(Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	vrgТребованияНакладнаяМобыльный.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.vrgТребованияНакладнаяМобыльный КАК vrgТребованияНакладнаяМобыльный
		|ГДЕ
		|	vrgТребованияНакладнаяМобыльный.Заказ = &Заказ
		|	И НЕ vrgТребованияНакладнаяМобыльный.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции // УжеЕстьТребование()





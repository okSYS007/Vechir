Процедура ШтрихкодПриИзменении(Элемент)

	ОбработатьВводШтрихкодаНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВводШтрихкодаНаКлиенте(ДобавлятьНовуюСтрокуТоваров = Ложь)

	ТекущаяСтрока = Неопределено;
	Модифицированность = Истина;
	Если НЕ ЗначениеЗаполнено(СокрЛП(Штрихкод)) Тогда
		Возврат;
	КонецЕсли;
	ОбработатьВводШтрихкодаНаСервере();

	Если РучнойВводКоличества И ШтрихкодНайден Тогда
		ТекущийЭлемент = Элементы.Номенклатура;
		ОткрытьФорму("ОбщаяФорма.ФормаВводаКоличества", , ЭтотОбъект);
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросДобавлятьНовуюСтрокуТоваровЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		Если РучнойВводКоличества Тогда
			ТекущийЭлемент = Элементы.Номенклатура;
			ОткрытьФорму("ОбщаяФорма.ФормаВводаКоличества", , ЭтотОбъект);
			Возврат;
		Иначе
			ДобавитьОбработатьСтрокуТоваров();
			Если ТипЗнч(ТекущаяСтрока) = Тип("Число") Тогда
				Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары;
				Элементы.Товары.ТекущаяСтрока = ТекущаяСтрока;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если НажатаКомандаСканированияЧерезКамеру Тогда
		ЗапуститьСканированиеЧерезКамеруУстройства();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбработатьВводШтрихкодаНаСервере()

	ВыборкаШтрихкода = Разработка.ПолучитьНоменклатуруПоШтрихкоду(Штрихкод);
	ШтрихкодНайден = (ВыборкаШтрихкода.Количество() <> 0);
	Если ВыборкаШтрихкода.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШтрихкода, , "Штрихкод");
		//Цена = Разработка.ПолучитьЦену(Номенклатура, ЕдиницаИзмерения, Объект.ТипЦен);
		//Сумма = Цена * Количество;
		//МассивСтрок = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура, СерияНоменклатуры", Номенклатура, СерияНоменклатуры));
		//Если МассивСтрок.Количество() = 0 Тогда
		//	Возврат Ложь;
		Если НЕ РучнойВводКоличества Тогда
			ДобавитьОбработатьСтрокуТоваров();
		КонецЕсли;
	Иначе
		Сообщить("По штрихкоду """ + СокрЛП(Штрихкод) + """ не знайдено жодного товару!");
	КонецЕсли;

	Штрихкод = "";

	Возврат Истина;

КонецФункции

&НаСервере
Процедура ДобавитьОбработатьСтрокуТоваров()

	МассивСтрок = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура, СерияНоменклатуры, ХарактеристикаНоменклатуры, ЕдиницаИзмерения", Номенклатура, СерияНоменклатуры, ХарактеристикаНоменклатуры, ЕдиницаИзмерения));
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаТовары = МассивСтрок[0];
	Иначе
		СтрокаТовары = Объект.Товары.Вставить(0);
		СтрокаТовары.Остаток = Разработка.ПолучитьОстаток(Номенклатура, Объект.Склад, СерияНоменклатуры, ХарактеристикаНоменклатуры, ЕдиницаИзмерения);
		//СтрокаТовары.Артикул = Номенклатура.Артикул;
	КонецЕсли;
	СтрокаТовары.Номенклатура = Номенклатура;
	СтрокаТовары.СерияНоменклатуры = СерияНоменклатуры;
	СтрокаТовары.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
	СтрокаТовары.ЕдиницаИзмерения = ЕдиницаИзмерения;
	СтрокаТовары.Коэффициент = Коэффициент;
	//+NovashIV_21.04.2023 007375
	Если СтрокаТовары.Остаток < СтрокаТовары.Количество + ?(РучнойВводКоличества, РучноеКоличество, 1) Тогда 
		Сообщить("Неможливо ввести більше залишку!");
	Иначе
		СтрокаТовары.Количество = СтрокаТовары.Количество + ?(РучнойВводКоличества, РучноеКоличество, 1);
		СтрокаТовары.Отсканировано = (СтрокаТовары.Количество = СтрокаТовары.КоличествоЗаказ И СтрокаТовары.КоличествоЗаказ > 0);
	КонецЕсли;
	//-NovashIV_21.04.2023 007375
	СтрокаТовары.Цена = Разработка.ПолучитьЦену(Номенклатура, ЕдиницаИзмерения, Объект.ТипЦен, ХарактеристикаНоменклатуры);
	СтрокаТовары.Сумма = СтрокаТовары.Цена * СтрокаТовары.Количество;
	
		
	Количество = СтрокаТовары.Количество;
	Цена = СтрокаТовары.Цена;
	Сумма = СтрокаТовары.Сумма;
	КоличествоЗаказ = СтрокаТовары.КоличествоЗаказ;
	ТекущаяСтрока = СтрокаТовары.ПолучитьИдентификатор();

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьДополнительныеДанныеВТоварахНаСервере();

	РежимОбновленияКартинок = Константы.РежимОбновленияКартинок.Получить();

	УправлениеФормамиСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	
	Если Объект.Оплачен Тогда 
		
		Элементы.КнопкаЗафиксироватьОплатуБезналичные.Доступность = Ложь;
		Элементы.КнопкаЗафиксироватьОплатуНаличные.Доступность    = Ложь;


		Элементы.КнопкаЗафиксироватьОплатуБезналичные.ЦветФона = ?(Объект.ОплаченБезналичными,WebЦвета.ЗеленоватоЖелтый,WebЦвета.Белый);
		Элементы.КнопкаЗафиксироватьОплатуНаличные.ЦветФона    = ?(Объект.ОплаченНаличными,WebЦвета.ЗеленоватоЖелтый,WebЦвета.Белый);
	Иначе
		
		
		
		Если Объект.Организация = Справочники.Организации.НайтиПоКоду("000000005") Тогда
			Элементы.КнопкаЗафиксироватьОплатуБезналичные.Видимость = Ложь;
			Элементы.КнопкаЗафиксироватьОплатуНаличные.Видимость    = Истина;
			
		ИначеЕсли Объект.Организация = Справочники.Организации.НайтиПоКоду("000000000") Тогда
			
			Элементы.КнопкаЗафиксироватьОплатуБезналичные.Видимость =Истина;
			Элементы.КнопкаЗафиксироватьОплатуНаличные.Видимость    = Ложь;
			
		КонецЕсли;
		
		
		
		
	КонецЕсли;
	
	Если Объект.БезналичныйРасчет Тогда 
		
		Элементы.КнопкаЗафиксироватьОплатуБезналичные.Доступность = Ложь;
		Элементы.КнопкаЗафиксироватьОплатуНаличные.Доступность    = Ложь;

			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеДанныеВТоварахНаСервере()

	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		СтрокаТовары.Остаток = Разработка.ПолучитьОстаток(СтрокаТовары.Номенклатура, Объект.Склад, СтрокаТовары.СерияНоменклатуры, СтрокаТовары.ХарактеристикаНоменклатуры, СтрокаТовары.ЕдиницаИзмерения);
		СтрокаТовары.Отсканировано = (СтрокаТовары.Количество = СтрокаТовары.КоличествоЗаказ И СтрокаТовары.КоличествоЗаказ > 0);
		//СтрокаТовары.Артикул = СтрокаТовары.Номенклатура.Артикул;
	КонецЦикла;

КонецПроцедуры


КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруСтрокиТабЧастиТовары(ЭтоДобавление = Ложь, ЗаполнитьТекущимиДанными = Ложь)

	СтруктураСтроки = Новый Структура("НомерСтроки, Артикул, Номенклатура, Количество, Остаток, ЕдиницаИзмерения, Коэффициент, Цена, Сумма, СерияНоменклатуры, ХарактеристикаНоменклатуры");
	ЦветФонаСтроки = Новый Цвет;
	Если ЗаполнитьТекущимиДанными Тогда
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, ТекущиеДанные);
		ЦветФонаСтроки = ПолучитьЦветСтроки(ТекущиеДанные);
	КонецЕсли;
	Если ЭтоДобавление Тогда
		СтруктураСтроки.НомерСтроки = Объект.Товары.Количество() + 1;
	КонецЕсли;
	СтруктураСтроки.Вставить("РежимОбновленияКартинок", РежимОбновленияКартинок);
	СтруктураСтроки.Вставить("ЦветФонаСтроки", ЦветФонаСтроки);
	СтруктураСтроки.Вставить("Склад", Объект.Склад);
	//СтруктураСтроки.Вставить("ТипЦен", Объект.ТипЦен);

	Возврат СтруктураСтроки;

КонецФункции

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаВводаКоличества" Тогда
		Если ТипЗнч(ВыбранноеЗначение) <> Тип("Число") ИЛИ НЕ ВыбранноеЗначение > 0 Тогда
			Возврат;
		КонецЕсли;
		РучноеКоличество = ВыбранноеЗначение;
		ДобавитьОбработатьСтрокуТоваров();
		//ТекущийЭлемент = Элементы.Штрихкод;
		//#Если МобильноеПриложениеКлиент Тогда
		//НачатьРедактированиеЭлемента();
		//#КонецЕсли

	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаВыбораСтрокиТовара" Тогда

		Модифицированность = Истина;
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
		Если ВыбранноеЗначение.НомерСтроки > Объект.Товары.Количество() Тогда
			ТекущиеДанные = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
		Иначе
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
		КонецЕсли;
		ТекущаяСтрока = ТекущиеДанные.ПолучитьИдентификатор();
		Элементы.Товары.ТекущаяСтрока = ТекущаяСтрока;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)

	УправлениеФормамиКлиент.ВыполнитьПереопределяемуюКоманду(ЭтаФорма, Команда);

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если Автосохранение Тогда
		Возврат;
	КонецЕсли;

	УправлениеФормамиСервер.ОбработкаПроверкиЗаполненияДокументов(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);

КонецПроцедуры










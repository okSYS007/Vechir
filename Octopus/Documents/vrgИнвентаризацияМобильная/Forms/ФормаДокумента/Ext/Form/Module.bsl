
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если Автосохранение Тогда
		Возврат;
	КонецЕсли;

	УправлениеФормамиСервер.ОбработкаПроверкиЗаполненияДокументов(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);

КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)

	Если ОткрытаФормаРедактированияНоменклатуры Тогда
		Возврат;
	КонецЕсли;
	Если ФормаДокументаЗаблокирована Тогда
		Возврат;
	КонецЕсли;

	Если Событие = "UniversalBroadcastEvent" и Источник = глНомерУстройства Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Данные);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		МассивЭлементов = ДокументDOM.ПолучитьЭлементыПоИмени("FilterData");
		Если МассивЭлементов.Количество() Тогда
			Штрихкод = МассивЭлементов[0].ТекстовоеСодержимое;
			ОбработатьВводШтрихкодаНаКлиенте();
			Если ОткрытаФормаСтроки Тогда
				СтруктураСканирования = Новый Структура();
				СтруктураСканирования.Вставить("Номенклатура", Номенклатура);
				СтруктураСканирования.Вставить("Количество", Количество);
				СтруктураСканирования.Вставить("ЦветФонаСтроки", ПолучитьЦветСтроки(Элементы.Товары.ТекущиеДанные));
				Оповестить("UniversalBroadcastEvent", СтруктураСканирования, ЭтаФорма);
			КонецЕсли;
		КонецЕсли;
		//Если ТипЗнч(ТекущаяСтрока) = Тип("Число") Тогда
		//	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары;
		//	Элементы.Товары.ТекущаяСтрока = ТекущаяСтрока;
		//КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтруктуруСтрокиТабЧастиТовары(ЭтоДобавление = Ложь, ЗаполнитьТекущимиДанными = Ложь)

	СтруктураСтроки = Новый Структура("НомерСтроки, Артикул, Номенклатура, Количество, Остаток, СерияНоменклатуры, ХарактеристикаНоменклатуры, Примечание, Этикетка");
	ЦветФонаСтроки = Новый Цвет;
	Если ЗаполнитьТекущимиДанными Тогда
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, ТекущиеДанные);
		ЦветФонаСтроки = ПолучитьЦветСтроки(ТекущиеДанные);
		СтруктураСтроки.Остаток = ТекущиеДанные.КоличествоУчет;
	КонецЕсли;
	Если ЭтоДобавление Тогда
		СтруктураСтроки.НомерСтроки = Объект.Товары.Количество() + 1;
	КонецЕсли;
	СтруктураСтроки.Вставить("РежимОбновленияКартинок", РежимОбновленияКартинок);
	СтруктураСтроки.Вставить("ЦветФонаСтроки", ЦветФонаСтроки);
	СтруктураСтроки.Вставить("ЭтоИнвентаризация", Истина);

	Возврат СтруктураСтроки;


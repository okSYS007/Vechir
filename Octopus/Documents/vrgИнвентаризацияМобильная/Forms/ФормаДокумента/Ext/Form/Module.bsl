&НаКлиенте
Процедура ОткрытьСписокФото(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда 
		Сообщить("Сохраните документ для создания фото!");
	Иначе 	
		
		Объект.УИДДокумента = Объект.Ссылка.УникальныйИдентификатор(); 
		Модифицированность = Истина;
		Записать();
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыОтбора = Новый Структура("УИД",Объект.Ссылка.УникальныйИдентификатор());
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("УИД",Объект.Ссылка.УникальныйИдентификатор());
		ПараметрыФормы.Вставить("Наименование",Объект.Номер);
		ПараметрыФормы.Вставить("Склады",Null);
		ПараметрыФормы.Вставить("типДок",Объект.Ссылка);
		
		ОткрытьФорму("ОбщаяФорма.ПросмотрФотоДок", ПараметрыФормы, ЭтотОбъект);
		
	КонецЕсли;
КонецПроцедуры









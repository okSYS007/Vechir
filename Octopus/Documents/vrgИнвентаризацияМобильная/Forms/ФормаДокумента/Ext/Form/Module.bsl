&НаКлиенте
Процедура ИзменитьПараметрыНоменклатуры(Команда)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Сообщить("У поточному рядку не вказана номенклатура");
		Возврат;
	КонецЕсли;

	ОписаниеОповещенияОЗакрытииРедактированияНоменклатуры = Новый ОписаниеОповещения("ЗакрытиеРедактированияНоменклатуры", ЭтаФорма);
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ, ИдентификаторСтроки, ИзменениеПараметровНоменклатуры",
						ТекущиеДанные.Номенклатура, Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор(), Истина), ЭтаФорма,
						, , , ОписаниеОповещенияОЗакрытииРедактированияНоменклатуры);
	ОткрытаФормаРедактированияНоменклатуры = Истина;

КонецПроцедуры


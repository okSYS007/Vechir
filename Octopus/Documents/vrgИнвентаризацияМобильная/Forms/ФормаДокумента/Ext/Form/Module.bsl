Процедура ПослеОтветаНаВопрос(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьУчетнымиОстаткамиНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаВводаКоличества" Тогда
		Если ТипЗнч(ВыбранноеЗначение) <> Тип("Число") ИЛИ НЕ ВыбранноеЗначение > 0 Тогда
			Возврат;
		КонецЕсли;
		РучноеКоличество = ВыбранноеЗначение;
		ДобавитьОбработатьСтрокуТоваров();
		Штрихкод = "";
		//ТекущийЭлемент = Элементы.Штрихкод;
		//#Если МобильноеПриложениеКлиент Тогда
		//НачатьРедактированиеЭлемента();
		//#КонецЕсли

	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаВыбораСтрокиТовара" Тогда

		Модифицированность = Истина;
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
		Если ВыбранноеЗначение.НомерСтроки > Объект.Товары.Количество() Тогда
			ТекущиеДанные = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
		Иначе
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
		КонецЕсли;
		ТекущаяСтрока = ТекущиеДанные.ПолучитьИдентификатор();
		ТекущиеДанные.КоличествоУчет = ВыбранноеЗначение.Остаток;
		Элементы.Товары.ТекущаяСтрока = ТекущаяСтрока;

	КонецЕсли;


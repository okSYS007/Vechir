&НаКлиенте
Процедура ЗаполнитьУчетнымиОстатками(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Сообщить("Не вказано склад!");
		Возврат;
	КонецЕсли;

	Если Объект.Товары.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект);
		ТекстВопроса = "Табличну частину товарів буде перезаповнено. Продовжити?";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	ЗаполнитьУчетнымиОстаткамиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчетнымиОстаткамиНаСервере()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Если ЗначениеЗаполнено(Объект.Группа) Тогда
		Запрос.УстановитьПараметр("Группа", Объект.Группа);
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СпрНоменклатура.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ НоменклатураГруппы
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
		|ГДЕ
		|	НЕ СпрНоменклатура.ПометкаУдаления
		|	И НЕ СпрНоменклатура.ЭтоГруппа
		|	И СпрНоменклатура.Родитель В ИЕРАРХИИ(&Группа)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиНаСкладахМобильныеСклад.Номенклатура КАК Номенклатура,
		|	ОстаткиНаСкладахМобильныеСклад.Номенклатура.Артикул КАК Артикул,
		|	ОстаткиНаСкладахМобильныеСклад.Номенклатура.Наименование КАК Наименование,
		|	ОстаткиНаСкладахМобильныеСклад.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ОстаткиНаСкладахМобильныеСклад.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ОстаткиНаСкладахМобильныеСклад.Количество КАК КоличествоУчет
		|ИЗ
		|	РегистрСведений.vrgОстаткиНаСкладахМобильныеСклад КАК ОстаткиНаСкладахМобильныеСклад
		|ГДЕ
		|	ОстаткиНаСкладахМобильныеСклад.Склад = &Склад
		|	И ОстаткиНаСкладахМобильныеСклад.Номенклатура В
		|			(ВЫБРАТЬ
		|				НоменклатураГруппы.Ссылка
		|			ИЗ
		|				НоменклатураГруппы КАК НоменклатураГруппы)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ОстаткиНаСкладахМобильныеСклад.Номенклатура КАК Номенклатура,
		|	ОстаткиНаСкладахМобильныеСклад.Номенклатура.Артикул КАК Артикул,
		|	ОстаткиНаСкладахМобильныеСклад.Номенклатура.Наименование КАК Наименование,
		|	ОстаткиНаСкладахМобильныеСклад.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ОстаткиНаСкладахМобильныеСклад.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ОстаткиНаСкладахМобильныеСклад.Количество КАК КоличествоУчет
		|ИЗ
		|	РегистрСведений.vrgОстаткиНаСкладахМобильныеСклад КАК ОстаткиНаСкладахМобильныеСклад
		|ГДЕ
		|	ОстаткиНаСкладахМобильныеСклад.Склад = &Склад
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;
	Объект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры


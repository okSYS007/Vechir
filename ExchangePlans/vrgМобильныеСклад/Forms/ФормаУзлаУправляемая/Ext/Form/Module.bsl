&НаСервере
// Выполняет заполнение настроек компоновщика на основе переданных параметров
//
// Параметры:
//  СхемаКомпоновки - схема компоновки данных, для которой компонуются настройки
//  НастройкиКомпоновки - настройки компоновки, загружаемые в компоновщик
//
Процедура ЗаполнитьНастройкиКомпоновщика(СхемаКомпоновки, НастройкиКомпоновки)
	
	Адрес = Новый УникальныйИдентификатор();
	URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновки, Адрес);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
	
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
	
КонецПроцедуры	

&НаСервере
// Заполняет настройки компоновщика ранее сохраненными данными отбора
//
Процедура ЗагрузитьНастройкиОтбора()

	Если НЕ ЗначениеЗаполнено(Объект.Конфигурация) Тогда
		Возврат;
	КонецЕсли;

	СхемаКомпоновки = ПланыОбмена.vrgМобильныеСклад.ПолучитьМакет("СхемаКомпоновкиНастроекОбмена" + СокрЛП(Объект.Конфигурация));
	НастройкиКомпоновки = СхемаКомпоновки.НастройкиПоУмолчанию;
	ЗаполнитьНастройкиКомпоновщика(СхемаКомпоновки, НастройкиКомпоновки);
	
	ОбъектУзла = РеквизитФормыВЗначение("Объект");
	СтруктураОтбора = ОбъектУзла.ХранилищеОтбораСхемыОбмена.Получить();
	
	Если ТипЗнч(СтруктураОтбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураОтбора.Количество() > 0 Тогда	
		vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ЗаполнитьОтборКомпоновкиИзСтруктуры(КомпоновщикНастроек.Настройки.Отбор, СтруктураОтбора);
	КонецЕсли;

КонецПроцедуры

&НаСервере
// Заполняет настройки компоновщика стандартными настройками, определенными при разработке
//
Процедура ЗагрузитьСтандартныеНастройки()

	Если НЕ ЗначениеЗаполнено(Объект.Конфигурация) Тогда
		Возврат;
	КонецЕсли;

	СхемаКомпоновки = ПланыОбмена.vrgМобильныеСклад.ПолучитьМакет("СхемаКомпоновкиНастроекОбмена" + СокрЛП(Объект.Конфигурация));
	НастройкиКомпоновки = СхемаКомпоновки.НастройкиПоУмолчанию;
	ЗаполнитьНастройкиКомпоновщика(СхемаКомпоновки, НастройкиКомпоновки);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Если ПланыОбмена.vrgМобильныеСклад.ЭтотУзел() = ТекущийОбъект.Ссылка Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.vrgНастройкиМобильныхУстройств.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УзелУстройства.Установить(Объект.Ссылка);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		ЗаписьНастроек = НаборЗаписей.Добавить();
		ЗаписьНастроек.УзелУстройства = Объект.Ссылка;
		ЗаписьНастроек.ИдентификаторУстройства = Строка(Новый УникальныйИдентификатор);
		НаборЗаписей.Записать();
	КонецЕсли;
	ПланыОбмена.ЗарегистрироватьИзменения(Объект.Ссылка, НаборЗаписей);

КонецПроцедуры

&НаКлиенте
Процедура КонфигурацияПриИзменении(Элемент)

	Если КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество() Тогда
		ОписаниеОповещенияИзменениеКонфигурации = Новый ОписаниеОповещения("ВопросИзменениеКонфигурацииЗавершение", ЭтаФорма);
		ТекстВопроса = "При изменении конфигурации будут удалены установленные ранее настройки отбора данных. Уверены, что хотите продолжить?";
		ПоказатьВопрос(ОписаниеОповещенияИзменениеКонфигурации, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;
	ВопросИзменениеКонфигурацииЗавершение(КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ВопросИзменениеКонфигурацииЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт

	НеобходимоМенятьЗначениеКонфигурации = (Результат = КодВозвратаДиалога.Да);
	Если НеобходимоМенятьЗначениеКонфигурации Тогда
		Попытка
			ЗагрузитьСтандартныеНастройки();
			КонфигурацияСтароеЗначение = Объект.Конфигурация;
		Исключение
			ТекстСообщения = "Не удалось загрузить стандартные настройки: %1";
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Сообщить(ТекстСообщения);
			НеобходимоМенятьЗначениеКонфигурации = Ложь;
		КонецПопытки;
	КонецЕсли;

	Если НЕ НеобходимоМенятьЗначениеКонфигурации Тогда
		Объект.Конфигурация = КонфигурацияСтароеЗначение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если НЕ ПланыОбмена.vrgМобильныеСклад.ЭтотУзел() = Объект.Ссылка И НЕ ЗначениеЗаполнено(Объект.Конфигурация) Тогда
		Сообщить("Укажите имя конфигурации: это необходимо для корректной работы мобильного блока!");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	Модифицированность = Истина;


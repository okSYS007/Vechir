&НаКлиенте
Процедура ОбновитьОстатки(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.Ссылка = ЭтотУзел Тогда
		Возврат;
	КонецЕсли;

	УзелОбмена = ТекущиеДанные.Ссылка;
	//ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ВопросНачальнаяИнициализацияЗавершение", ЭтаФорма, ДополнительныеПараметры);
	//ТекстВопроса = "Операция может занять длительное время. Продолжить?";
	//ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	vrgОстаткиНаСкладахМобильныеСклад.Склад,
		|	vrgОстаткиНаСкладахМобильныеСклад.Номенклатура,
		|	vrgОстаткиНаСкладахМобильныеСклад.СерияНоменклатуры,
		|	vrgОстаткиНаСкладахМобильныеСклад.ХарактеристикаНоменклатуры,
		|	vrgОстаткиНаСкладахМобильныеСклад.Количество
		|ИЗ
		|	РегистрСведений.vrgОстаткиНаСкладахМобильныеСклад КАК vrgОстаткиНаСкладахМобильныеСклад";
	
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыСведений.vrgОстаткиНаСкладахМобильныеСклад.СоздатьНаборЗаписей();
	Для Каждого Строка из РезультатЗапроса Цикл
		Набор.Отбор.Номенклатура.Значение = Строка.Номенклатура;
		Набор.Отбор.Номенклатура.Использование = Истина;
		
		Набор.Отбор.ХарактеристикаНоменклатуры.Значение = Строка.ХарактеристикаНоменклатуры;
		Набор.Отбор.ХарактеристикаНоменклатуры.Использование = Истина;
		
		//Набор.Отбор.Количество.Значение = Строка.Количество;
		//Набор.Отбор.Количество.Использование = Истина;
		//
		Набор.Отбор.СерияНоменклатуры.Значение = Строка.СерияНоменклатуры;
		Набор.Отбор.СерияНоменклатуры.Использование = Истина;
		
		Набор.Отбор.Склад.Значение = Строка.Склад;
		Набор.Отбор.Склад.Использование = Истина;
		
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Набор);
	КонецЦикла;

КонецПроцедуры

Процедура ОбновлениеОстатковРегистрНаСервере(КодУстройства,ИдентификаторУстройства)
	//+NovashIV_15.05.2023

	УстановитьПривилегированныйРежим(Истина);

	УзелУстройства = ПолучитьПроверитьУзелУстройства(КодУстройства, ИдентификаторУстройства);

	ДанныеОбмена = vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ВыгрузитьОстаткиНаМобильноеУстройство(УзелУстройства);
	УстановитьПривилегированныйРежим(Ложь);
	//-NovashIV_15.05.2023
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеОстатковРегистр(Команда)
	//+NovashIV_15.05.2023
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.Ссылка = ЭтотУзел Тогда
		Возврат;
	КонецЕсли;

	УзелОбмена = ТекущиеДанные.Ссылка;

	КодУстройства           = УзелОбмена.Код;
	
	ЗаписьНастроек = РегистрыСведений.vrgНастройкиМобильныхУстройств.СоздатьМенеджерЗаписи();
	ЗаписьНастроек.УзелУстройства = УзелОбмена;
	ЗаписьНастроек.Прочитать();
	Если ЗаписьНастроек.Выбран() Тогда
		ИдентификаторУстройства = ЗаписьНастроек.ИдентификаторУстройства;
	КонецЕсли;

	ОбновлениеОстатковРегистрНаСервере(КодУстройства,ИдентификаторУстройства);
	//-NovashIV_15.05.2023
КонецПроцедуры

Функция ПолучитьПроверитьУзелУстройства(КодУстройства, ИдентификаторУстройства, ТекстОшибки = Неопределено)
	//+NovashIV_15.05.2023
	
	ИспользуетсяМобильноеПриложениеOctopus = Константы.vrg_ИспользуетсяМобильноеПриложениеOctopus.Получить();
	Если НЕ ИспользуетсяМобильноеПриложениеOctopus Тогда
		ВызватьИсключение("Синхронизация с мобильными устройствами отключена.");
	КонецЕсли;
	
	УзелУстройства = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(КодУстройства);
	
	Если УзелУстройства.Пустая() Тогда
		ВызватьИсключение("Устройство с кодом " + КодУстройства+" не опознано");
	ИначеЕсли УзелУстройства.ЗапретДоступа Тогда
		ВызватьИсключение("Доступ к данным с этого устройства запрещен.");
	Иначе
		ЗаписьНастроек = РегистрыСведений.vrgНастройкиМобильныхУстройств.СоздатьМенеджерЗаписи();
		ЗаписьНастроек.УзелУстройства = УзелУстройства;
		ЗаписьНастроек.Прочитать();
		Если ЗаписьНастроек.Выбран() Тогда
			Если ЗначениеЗаполнено(ИдентификаторУстройства) И ЗначениеЗаполнено(ЗаписьНастроек.ИдентификаторУстройства)
				И ИдентификаторУстройства <> ЗаписьНастроек.ИдентификаторУстройства Тогда
				ВызватьИсключение("Данный узел обмена уже закреплен за другим устройством.");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат УзелУстройства;
	//-NovashIV_15.05.2023
	
КонецФункции











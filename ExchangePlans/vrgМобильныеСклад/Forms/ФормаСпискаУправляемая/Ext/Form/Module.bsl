
&НаКлиенте
Процедура СоставОтправляемыхДанных(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	//ОбменДаннымиКлиент.ОткрытьСоставОтправляемыхДанных(ТекущиеДанные.Ссылка);
	ПроцедурыОбменаДаннымиКлиент.ПоказатьЗарегистрированныеИзмененияДляУзла(ТекущиеДанные.Ссылка, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура НачальнаяИнициализация(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.Ссылка = ЭтотУзел Тогда
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура("УзелОбмена", ТекущиеДанные.Ссылка);
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ВопросНачальнаяИнициализацияЗавершение", ЭтаФорма, ДополнительныеПараметры);
	ТекстВопроса = "Операция может занять длительное время. Продолжить?";
	ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыполнитьНачальнуюИнициализациюУзла(УзелОбмена)

	Попытка
		vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ВыполнитьНачальнуюИнициализациюДляУзлаМобильногоУстройства(УзелОбмена, Ложь);
		Сообщить("Готово!");
	Исключение
		Сообщить("Не удалось выполнить начальную инициализацию по причине " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВопросНачальнаяИнициализацияЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьНачальнуюИнициализациюУзла(ДополнительныеПараметры.УзелОбмена);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВключитьОтключитьОбменСМобильнымиУстройствамиНаСервере()

	Если ИспользуетсяМобильноеПриложениеOctopus Тогда
		Константы.vrg_ИспользуетсяМобильноеПриложениеOctopus.Установить(Ложь);
	Иначе
		Константы.vrg_ИспользуетсяМобильноеПриложениеOctopus.Установить(Истина);
	КонецЕсли;
	УстановитьТекстКомандыВключитьОтключитьОбменСМобильнымиУстройствами();

КонецПроцедуры

&НаКлиенте
Процедура ВключитьОтключитьОбменСМобильнымиУстройствами(Команда)

	ИспользуетсяМобильноеПриложениеOctopus = ПолучитьЗначениеКонстантыИспользованияOctopus();
	Если ИспользуетсяМобильноеПриложениеOctopus Тогда
		ТекстВопроса = "Данная функция делает невозможной синхронизацию с мобильными устройствами. Вы уверены, что хотите отключить механизмы обмена и регистрации данных?";
	Иначе
		ТекстВопроса = "Данная функция включает возможность синхронизации с мобильными устройствами. Вы уверены, что хотите продолжить?";
	КонецЕсли;
	ОписаниеОповещенияЗавершения = Новый ОписаниеОповещения("ВопросВключитьОтключитьОбменСМобильнымиУстройствамиЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещенияЗавершения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ВопросВключитьОтключитьОбменСМобильнымиУстройствамиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ВключитьОтключитьОбменСМобильнымиУстройствамиНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьТекстКомандыВключитьОтключитьОбменСМобильнымиУстройствами()

	ИспользуетсяМобильноеПриложениеOctopus = ПолучитьЗначениеКонстантыИспользованияOctopus();
	Если ИспользуетсяМобильноеПриложениеOctopus Тогда
		ТекстКнопки = "Синхронизация с мобильными устройствами включена";
		КартинкаКнопки = БиблиотекаКартинок.Утвердить;
	Иначе
		ТекстКнопки = "Синхронизация с мобильными устройствами отключена";
		КартинкаКнопки = БиблиотекаКартинок.Остановить;
	КонецЕсли;
	Элементы.ФормаВключитьОтключитьОбменСМобильнымиУстройствами.Заголовок = ТекстКнопки;
	Элементы.ФормаВключитьОтключитьОбменСМобильнымиУстройствами.Картинка = КартинкаКнопки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеКонстантыИспользованияOctopus()

	Возврат Константы.vrg_ИспользуетсяМобильноеПриложениеOctopus.Получить();

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗначениеКонстантыИспользованияХозрасчетного()

	Возврат Константы.vrg_ИспользоватьХозрасчетныйДляОстатковOctopus.Получить();

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтотУзел = ПланыОбмена.vrgМобильныеСклад.ЭтотУзел();
	УстановитьТекстКомандыВключитьОтключитьОбменСМобильнымиУстройствами();
	УстановитьТекстКомандыВключитьОтключитьИспользоватьХозрасчетныйДляОстатков();
	ВерсияУстройств = Константы.DeviceVersion.Получить();
	
	Элементы.ФормаВключитьОтключитьХозрасчетныйДляОстатков.Видимость = (Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный") <> Неопределено);

КонецПроцедуры


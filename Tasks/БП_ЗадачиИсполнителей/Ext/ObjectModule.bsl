
Процедура ОбработкаПроверкиВыполнения(Результат)
	
	Если Наименование = "Проставить способы доставки" Тогда 
		Результат = Истина;
		////Для Каждого СтрокаТовары из ЭтотОбъект.ЗаказПокупателя.Товары Цикл
		////	Если не ЗначениеЗаполнено(СтрокаТовары.СпособДоставки) Тогда 
		////		Результат = Ложь;
		////	КонецЕсли;
		////КонецЦикла;
		Если не ЗначениеЗаполнено(ЭтотОбъект.ЗаказПокупателя.СпособДоставки) Тогда 
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если Выполнена и не Наименование = "Система ждет выполнения дочерних БП" Тогда
		Исполнитель = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
КонецПроцедуры


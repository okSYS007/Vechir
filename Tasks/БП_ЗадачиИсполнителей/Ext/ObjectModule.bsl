Процедура ПриВыполнении(Отказ)
	ДатаВремяВыполненияЗадачи = ТекущаяДата();
	
	Если Наименование = "Проставить цену по запросу" Тогда 
	КонецЕсли;
	
	Если Наименование = "Отправить заказ клиенту" Тогда 
		
		Для Каждого СтрокаТовары из ТоварыКВыдачеКлиенту цикл
			Запрос = новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	РеализацияТоваровУслугТовары.Ссылка
			               |ИЗ
			               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
			               |ГДЕ
			               |	РеализацияТоваровУслугТовары.Номенклатура = &Номенклатура
			               |	И РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
			               |	И РеализацияТоваровУслугТовары.Ссылка.Сделка = &Сделка";
			Запрос.УстановитьПараметр("Номенклатура",СтрокаТовары.Номенклатура);
			Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",СтрокаТовары.ХарактеристикаНоменклатуры);
			Запрос.УстановитьПараметр("Сделка",ЗаказПокупателя);
			
			РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			
			Если РезультатЗапроса.Количество() Тогда 
			Иначе
				Сообщить("Вы не можете отправить данный товар, так как его нет в Реализации товаров и услуг.",СтатусСообщения.Важное);
				Отказ  = Истина;
			
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;		
КонецПроцедуры

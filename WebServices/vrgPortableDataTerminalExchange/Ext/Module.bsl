	ДанныеНастройки = Новый Структура;
	ДанныеНастройки.Вставить("УзелИнформационнойБазы", УзелУстройства);
	ДанныеНастройки.Вставить("ДатаПоследнейВыгрузки", ТекущаяДата());
	ДанныеНастройки.Вставить("ДатаПоследнегоОбмена", ТекущаяДата());
	ДанныеНастройки.Вставить("КомментарийПриВыгрузкеДанных", "Операция произошла с ошибками: см. журнал регистрации");

	ДанныеНастройки.Вставить("ДатаПоследнейЗагрузки", ТекущаяДата());
	ДанныеНастройки.Вставить("КомментарийПриЗагрузкеДанных", КомментарийПриЗагрузкеДанных);
	ДанныеНастройки.Вставить("ДатаНачалаЗагрузки", ТекущаяДата());

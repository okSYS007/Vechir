Функция ИзменитьПараметрыНоменклатуры(КодУстройства, ДанныеОбмена, ТекстОшибки)

	УстановитьПривилегированныйРежим(Истина);

	УзелУстройства = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(КодУстройства);
	Данные = Новый ХранилищеЗначения(Неопределено);

	Если УзелУстройства.Пустая() Тогда
		ТекстОшибки = ТекстОшибки + ("Устройство с кодом " + КодУстройства+" не опознано.");
		Возврат Данные;
	КонецЕсли;

	Попытка
		Данные = vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ИзменитьПараметрыНоменклатуры(УзелУстройства, ДанныеОбмена, ТекстОшибки);
	Исключение
		ТекстОшибки = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Данные;

КонецФункции


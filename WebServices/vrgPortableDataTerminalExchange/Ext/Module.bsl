		КомментарийПриВыгрузкеДанных = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Выгрузка данных с устройства", УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ПланыОбмена.vrgМобильныеСклад, УзелУстройства, КомментарийПриВыгрузкеДанных);
	КонецПопытки;

	Результат = Истина;
	КомментарийПриЗагрузкеДанных = "";
	Попытка
		ДанныеОбмена = vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ВыгрузитьДанныеНаМобильноеУстройство(УзелУстройства, ОбновлятьРегистрыСведений);

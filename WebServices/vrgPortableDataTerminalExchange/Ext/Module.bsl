Функция ПроверитьПарольПользователя(КодУстройства, Пользователь, Пароль, ТекстОшибки)

	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ЗапретДоступа", Ложь);
	СтруктураОтвета.Вставить("ТекстОшибки", "");

	УзелУстройства = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(КодУстройства);

	Если УзелУстройства.Пустая() Тогда
		СтруктураОтвета.ЗапретДоступа = Истина;
		СтруктураОтвета.ТекстОшибки = "Устройство с кодом " + КодУстройства + " не опознано.";
	ИначеЕсли УзелУстройства.ЗапретДоступа Тогда
		Если УзелУстройства.ЗапретДоступа Тогда
			СтруктураОтвета.ЗапретДоступа = Истина;
			СтруктураОтвета.ТекстОшибки = "Доступ к данным с этого устройства запрещен.";
		КонецЕсли;
	КонецЕсли;

	Если СтруктураОтвета.ЗапретДоступа Тогда
		Возврат vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.СериализаторJSON(СтруктураОтвета);
	КонецЕсли;

	ЗаписьНастроек = РегистрыСведений.vrgНастройкиМобильныхУстройств.СоздатьМенеджерЗаписи();
	ЗаписьНастроек.УзелУстройства = УзелУстройства;
	ЗаписьНастроек.Прочитать();
	СтруктураОтвета.Вставить("ПарольНеверный", УзелУстройства.ПарольДляВходаНаУстройстве <> Пароль);
	СтруктураОтвета.Вставить("ИдентификаторУстройства", ЗаписьНастроек.ИдентификаторУстройства);
	СтруктураОтвета.Вставить("ПарольДляВходаНаУстройстве", УзелУстройства.ПарольДляВходаНаУстройстве);

	Возврат vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.СериализаторJSON(СтруктураОтвета);

КонецФункции

Функция ВыполнитьОбменДанными(КодУстройства, ИдентификаторУстройства, ДанныеМобильногоПриложения, ОбновлятьРегистрыСведений)

	УстановитьПривилегированныйРежим(Истина);



Функция ПолучитьДанные(КодУстройства)

	УстановитьПривилегированныйРежим(Истина);

	УзелУстройства = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(КодУстройства);

	Если УзелУстройства.Пустая() Тогда
		ВызватьИсключение("Устройство с кодом " + КодУстройства+" не опознано");
	ИначеЕсли УзелУстройства.ЗапретДоступа Тогда
		ВызватьИсключение("Доступ к данным с этого устройства запрещен.");
	КонецЕсли;

	Результат = Истина;
	КомментарийПриЗагрузкеДанных = "";
	Попытка
	ДанныеОбмена = vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ВыгрузитьДанныеНаМобильноеУстройство(УзелУстройства);
	Исключение
		ДанныеОбмена = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
		Результат = Ложь;
		КомментарийПриЗагрузкеДанных = ОписаниеОшибки();
	КонецПопытки;

	ДанныеНастройки = Новый Структура;
	ДанныеНастройки.Вставить("УзелИнформационнойБазы", УзелУстройства);
	ДанныеНастройки.Вставить("ДатаПоследнейЗагрузки", ТекущаяДата());
	ДанныеНастройки.Вставить("КомментарийПриЗагрузкеДанных", КомментарийПриЗагрузкеДанных);
	ДанныеНастройки.Вставить("ДатаНачалаЗагрузки", ТекущаяДата());
	ДанныеНастройки.Вставить("ДатаПоследнегоОбмена", ТекущаяДата());
	ДанныеНастройки.Вставить("Результат", Результат);
	ДанныеНастройки.Вставить("ТипОбменаДанными", Перечисления.vrgТипыОбменаДанными.ЗагрузкаДанных);
	vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ЗафиксироватьЗавершениеОбмена(ДанныеНастройки);

	Возврат ДанныеОбмена;

КонецФункции

Функция ЗаписатьДанные(КодУстройства, ДанныеМобильногоПриложения)

	УстановитьПривилегированныйРежим(Истина);

	УзелУстройства = ПланыОбмена.vrgМобильныеСклад.НайтиПоКоду(КодУстройства);

	Если УзелУстройства.Пустая() Тогда
		ВызватьИсключение("Устройство с кодом " + КодУстройства+" не опознано");
	ИначеЕсли УзелУстройства.ЗапретДоступа Тогда
		ВызватьИсключение("Доступ к данным с этого устройства запрещен.");
	КонецЕсли;

	ДанныеНастройки = Новый Структура;
	ДанныеНастройки.Вставить("УзелИнформационнойБазы", УзелУстройства);
	ДанныеНастройки.Вставить("ДатаПоследнейВыгрузки", ТекущаяДата());
	ДанныеНастройки.Вставить("ДатаПоследнегоОбмена", ТекущаяДата());
	ДанныеНастройки.Вставить("КомментарийПриВыгрузкеДанных", "Операция произошла с ошибками: см. журнал регистрации");
	ДанныеНастройки.Вставить("ДатаНачалаВыгрузки", ТекущаяДата());
	ДанныеНастройки.Вставить("Результат", Ложь);
	ДанныеНастройки.Вставить("ТипОбменаДанными", Перечисления.vrgТипыОбменаДанными.ВыгрузкаДанных);
	vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ЗафиксироватьЗавершениеОбмена(ДанныеНастройки);

	Результат = Истина;
	КомментарийПриВыгрузкеДанных = "";
	Попытка
		vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ПринятьДанныеСМобильногоУстройства(УзелУстройства, ДанныеМобильногоПриложения, Истина);
		ДанныеНастройки.КомментарийПриВыгрузкеДанных = КомментарийПриВыгрузкеДанных;
		ДанныеНастройки.Результат = Результат;
		ДанныеНастройки.ДатаПоследнейВыгрузки = ТекущаяДата();
		vrgПроцедурыОбменаДаннымиСМобильнымиУстройствамиСклад.ЗафиксироватьЗавершениеОбмена(ДанныеНастройки);
	Исключение
		Результат = Ложь;
		КомментарийПриВыгрузкеДанных = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Выгрузка данных с устройства", УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ПланыОбмена.vrgМобильныеСклад, УзелУстройства, КомментарийПриВыгрузкеДанных);
	КонецПопытки;

КонецФункции


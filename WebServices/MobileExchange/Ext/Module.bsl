КонецФункции

функция ПолучитьТаблицуБезФотоСервер()
	   	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХранилищеДополнительнойИнформации.Объект
		|ПОМЕСТИТЬ ДопИнфо
		|ИЗ
		|	Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
		|ГДЕ
		|	ХранилищеДополнительнойИнформации.Объект ССЫЛКА Справочник.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ХранилищеДополнительнойИнформации.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.Артикул,
		|	Номенклатура.Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.Ссылка В
		|				(ВЫБРАТЬ
		|					ДопИнфо.Объект
		|				ИЗ
		|					ДопИнфо)";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Колонки.Добавить("УИД");
	Для Каждого Строка из РезультатЗапроса Цикл
		Строка.УИД = Строка.Ссылка.УникальныйИдентификатор();
	КонецЦикла;
	Возврат  РезультатЗапроса
	
КонецФункции

Функция ЗагрузитьФото(УИД = Неопределено,ДополнительныеПараметры,ТипДок = Неопределено,УИДДокумента = Неопределено)
	
	 ЗаписьЖурналаРегистрации("Обмен мобм",,,"Нач 1");
	 
	ТаблицаФотографий = ДополнительныеПараметры.Получить();
	СсылнаНоменклатура = Null;
	//СсылнаНоменклатура = Документы.vrgТребованияНакладнаяМобыльный.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Если ТипДок = "РТИУ" Тогда 
		СсылнаНоменклатура = НайтиДокПоНомеруРеализация(УИДДокумента);
	ИначеЕсли ТипДок = "Требование" Тогда
		СсылнаНоменклатура = НайтиДокПоНомеру(УИДДокумента);
	ИначеЕсли ТипДок = "ЗаказПокупателя" Тогда
		СсылнаНоменклатура = НайтиДокПоЗаказ(УИДДокумента);
	ИначеЕсли ТипДок = "ВозвратПокупателю" Тогда
		СсылнаНоменклатура = НайтиДокПоВозврату(УИДДокумента);
	ИначеЕсли ТипДок = "Инвентаризация" Тогда
		СсылнаНоменклатура = НайтиДокПоИнвентаризации(УИДДокумента);
	Иначе
		
		Возврат "";
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(СсылнаНоменклатура) Тогда
		
		
		Для каждого СтрокаФото Из ТаблицаФотографий Цикл 
			
			
			НовыйОбъект = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
			НовыйОбъект.ВидДанных = Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение;
			
			
			
			НовыйОбъект.Хранилище = Новый ХранилищеЗначения(Новый Картинка(СтрокаФото.Фото.Получить()), Новый СжатиеДанных);
			НовыйОбъект.Объект = СсылнаНоменклатура;
			НовыйОбъект.ИмяФайла = ""+СсылнаНоменклатура.Номер + СтрокаФото.ИмяФайла + "Создан на OCT";
			НовыйОбъект.Записать();
			
			

		КонецЦикла;
		
		
		Возврат УИД;
	Иначе
		
		
		Возврат "";
		
	КонецЕсли;
	
	
КонецФункции
	
функция НайтиДокПоНомеру(УИДДокумента)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	vrgТребованияНакладнаяМобыльный.Ссылка,
	|	vrgТребованияНакладнаяМобыльный.Номер
	|ИЗ
	|	Документ.vrgТребованияНакладнаяМобыльный КАК vrgТребованияНакладнаяМобыльный
	|ГДЕ
	|	vrgТребованияНакладнаяМобыльный.УИДДокумента ПОДОБНО &УИДДокумента";
	
	Запрос.УстановитьПараметр("УИДДокумента", УИДДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	
КонецФункции


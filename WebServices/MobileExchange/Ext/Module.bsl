функция НайтиДокПоНомеруРеализация(УИДДокумента)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	vrgРеализацияМобильная.Ссылка,
	|	vrgРеализацияМобильная.Номер,
	|	vrgРеализацияМобильная.УИДДокумента
	|ИЗ
	|	Документ.vrgРеализацияМобильная КАК vrgРеализацияМобильная
	|ГДЕ
	|	vrgРеализацияМобильная.УИДДокумента ПОДОБНО &УИДДокумента";
	
	Запрос.УстановитьПараметр("УИДДокумента", УИДДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
КонецФункции


Функция НайтиНоменклатуру(ДополнительныеПараметры)
	СтруктураПараметров = ДополнительныеПараметры.Получить();
	СтрокаПоиска 		= СтруктураПараметров.СтрокаПоиска;
	
	 	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.Наименование,
		|	Номенклатура.Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование = &Наименование
		|	ИЛИ Номенклатура.Артикул = &Артикул";
	
	Запрос.УстановитьПараметр("Артикул", СтрокаПоиска);
	Запрос.УстановитьПараметр("Наименование", СтрокаПоиска);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Колонки.Добавить("УИД");
	Для Каждого Строка из РезультатЗапроса Цикл
		Строка.УИД = Строка.Ссылка.УникальныйИдентификатор();
	КонецЦикла; 
		
	
	Возврат Новый ХранилищеЗначения(РезультатЗапроса, Новый СжатиеДанных(9));
КонецФункции


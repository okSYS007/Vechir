Функция ВыполнитьЗапрос(СтруктураДаных,ДополнительныеПараметры)
	
	УстановитьПривилегированныйРежим(Истина);
		
	СтруктураВЗапрос = СтруктураДаных.Получить();
	
	СтруктураДополнительныеПараметры = ДополнительныеПараметры.Получить();
	
	Если СтруктураВЗапрос = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапроса 		= СтруктураВЗапрос.ТекстЗапроса;
	СтруктураПараметров = СтруктураВЗапрос.СтруктураПараметров;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Для Каждого Элемент Из СтруктураПараметров Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;		
	
	Результат = Запрос.Выполнить().Выгрузить();	
	
	Возврат Новый ХранилищеЗначения(Результат, Новый СжатиеДанных(9));
	


&НаКлиенте
Перем РазрешеноЗакрытие;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяШрифта = Справочники.Константы.НайтиЗначение("ДопОписаниеШрифтПоУмолчанию", "Montserrat");

	ШрифтПоУмолчанию = ИмяШрифта + ", sans-serif";

	РазмерШрифтаПоУмолчанию = Справочники.Константы.НайтиЗначение("ДопОписаниеРазмерШрифтаПоУмолчанию", "13pt");

	СтильПодСтрокиПоУмолчанию
		= "font-family: " + ШрифтПоУмолчанию
		+ ";font-size: " + РазмерШрифтаПоУмолчанию
		+ ";font-style: normal;font-weight: normal;text-decoration: none;"
	;

	Вложения = Параметры.Вложения;

	Если ТипЗнч(Вложения) <> Тип("Структура") Тогда
		Вложения = Новый Структура;
	КонецЕсли;

	ИсходнаяСтрока = Параметры.ИсходнаяСтрока;

	Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока) Тогда
		ИсходнаяСтрока = СфПоУмолчаниюСтрокуХТМЛ(СтильПодСтрокиПоУмолчанию);
	КонецЕсли;

	ДокФормат.УстановитьHTML(ИсходнаяСтрока, Вложения);
	ДокФормат.ПолучитьHTML(ДокХТМЛ, Вложения);

	Отладка = Параметры.Отладка;

	Элементы.ГруппаХТМЛ.Видимость = Отладка;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СфПоУмолчаниюСтрокуХТМЛ(СтильПодСтроки)

	СтрокаХТМЛ = "
	|<html>
	|<head>
	|<style type=""text/css"">
	|body{margin:0;padding:8px;}
	|p{line-height:1.15;margin:0;white-space:pre-wrap;}
	|ol,ul{margin-top:0;margin-bottom:0;}
	|img{border:none;}
	|li>p{display:inline;}
	|</style>
	|</head>
	|<body>
	|<p><span style=""" + СтильПодСтроки + """>введите описание</span></p>
	|</body>
	|</html>";

	Возврат СтрокаХТМЛ;

КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РазрешеноЗакрытие = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)

	Если НЕ РазрешеноЗакрытие Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранить(Команда)

	РазрешеноЗакрытие = Истина;

	ДокФормат.ПолучитьHTML(ДокХТМЛ, Вложения);

	КомандаШрифтПоУмолчанию(Неопределено);

	Закрыть(ДокХТМЛ);

КонецПроцедуры

&НаКлиенте
Процедура ДокФорматПриИзменении(Элемент)
	ДокФормат.ПолучитьHTML(ДокХТМЛ, Вложения);
КонецПроцедуры

&НаКлиенте
Процедура ДокХТМЛПриИзменении(Элемент)
	ДокХТМЛПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДокХТМЛПриИзмененииНаСервере()
	ДокФормат.УстановитьHTML(ДокХТМЛ, Вложения);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменить(Команда)

	РазрешеноЗакрытие = Истина;

	Закрыть(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура КомандаШрифтПоУмолчанию(Команда)
	УстановитьСтиль(Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаРазмерПоУмолчанию(Команда)
	УстановитьСтиль(, Истина);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтиль(ЗаменитьШрифт = Ложь, ЗаменитьРазмер = Ложь)

	ДокФормат.ПолучитьHTML(ДокХТМЛ, Вложения);

	ЧтениеХТМЛ = Новый ЧтениеHTML; 
	ЧтениеХТМЛ.УстановитьСтроку(ДокХТМЛ);

	ПостроительДОМ = Новый ПостроительDOM;	
	ДокументХТМЛ = ПостроительДОМ.Прочитать(ЧтениеХТМЛ);

	ЭлементыПараграфы = ДокументХТМЛ.ПолучитьЭлементыПоИмени("p");

	Для Каждого Элемент Из ЭлементыПараграфы Цикл

		ДочерниеУзлы = Элемент.ДочерниеУзлы;

		Если ДочерниеУзлы.Количество() < 1 Тогда
			Продолжить;
		КонецЕсли;

		ЭлементыПереводыСтрок = Элемент.ПолучитьЭлементыПоИмени("br");

		Если ЭлементыПереводыСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		ЭлементыПодСтроки = Элемент.ПолучитьЭлементыПоИмени("span");

		Если ЭлементыПодСтроки.Количество() < 1 Тогда

			НовыйЭлементПодСтрока = ДокументХТМЛ.СоздатьЭлемент("span");

			Для Каждого ДочернийУзел Из ДочерниеУзлы Цикл
				Элемент.УдалитьДочерний(ДочернийУзел);
				НовыйЭлементПодСтрока.ДобавитьДочерний(ДочернийУзел);
			КонецЦикла;

			Элемент.ДобавитьДочерний(НовыйЭлементПодСтрока);

			ЭлементыПодСтроки = Элемент.ПолучитьЭлементыПоИмени("span");

		КонецЕсли;

		Для Каждого ЭлементПодСтрока Из ЭлементыПодСтроки Цикл

			СтрокаСтиля = ЭлементПодСтрока.ПолучитьАтрибут("style");

			Если СтрокаСтиля = Неопределено Тогда
				ЭлементПодСтрока.УстановитьАтрибут("style", СтильПодСтрокиПоУмолчанию);
				Продолжить;
			КонецЕсли;

			СоотвСтиля  = СфСоответствиеЭлементовСтиля(СтрокаСтиля);

			Если СоотвСтиля.Количество() < 1 Тогда
				ЭлементПодСтрока.УстановитьАтрибут("style", СтильПодСтрокиПоУмолчанию);
				Продолжить;
			КонецЕсли;

			ОбновитьАтрибут = Ложь;

			ШрифтСтиля = СоотвСтиля.Получить("font-family");

			Если ШрифтСтиля = Неопределено Тогда
				СоотвСтиля.Вставить("font-family", ШрифтПоУмолчанию);
				ОбновитьАтрибут = Истина;
			ИначеЕсли ЗаменитьШрифт И ШрифтСтиля <> ШрифтПоУмолчанию Тогда
				СоотвСтиля.Вставить("font-family", ШрифтПоУмолчанию);
				ОбновитьАтрибут = Истина;
			КонецЕсли;

			РазмерШрифта = СоотвСтиля.Получить("font-size");

			Если РазмерШрифта = Неопределено Тогда
				СоотвСтиля.Вставить("font-size", РазмерШрифтаПоУмолчанию);
				ОбновитьАтрибут = Истина;
			ИначеЕсли ЗаменитьРазмер И РазмерШрифта <> РазмерШрифтаПоУмолчанию Тогда
				СоотвСтиля.Вставить("font-size", РазмерШрифтаПоУмолчанию);
				ОбновитьАтрибут = Истина;
			КонецЕсли;

			Если ОбновитьАтрибут Тогда

				МассивСтиля = Новый Массив;

				Для Каждого КлючЗначение Из СоотвСтиля Цикл
					МассивСтиля.Добавить(КлючЗначение.Ключ + ": " + КлючЗначение.Значение);
				КонецЦикла;

				НоваяСтрокаСтиля = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивСтиля, ";");
				ЭлементПодСтрока.УстановитьАтрибут("style", НоваяСтрокаСтиля);

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	ЗаписьДОМ  = Новый ЗаписьDOM;
	ЗаписьХТМЛ = Новый ЗаписьHTML;
	ЗаписьХТМЛ.УстановитьСтроку();

 	ЗаписьДОМ.Записать(ДокументХТМЛ, ЗаписьХТМЛ);

	ДокХТМЛ = ЗаписьХТМЛ.Закрыть();

	ДокХТМЛПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Функция СфСоответствиеЭлементовСтиля(СтрокаСтиля)

	СоотвСтиля = Новый Соответствие;

	МассивСтиля = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаСтиля, ";");

	Для Каждого ПодСтрокаСтиля Из МассивСтиля Цикл

		МассивПодСтрокСтиля = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПодСтрокаСтиля, ":");

		ВсегоПодСтрок = МассивПодСтрокСтиля.Количество();

		Если ВсегоПодСтрок < 1 Тогда
			Продолжить;
		КонецЕсли;

		ИмяЭлемента = СокрЛП(МассивПодСтрокСтиля[0]);
		ЗначениеЭлемента = Неопределено;

		Если ВсегоПодСтрок > 1 Тогда
			ЗначениеЭлемента = МассивПодСтрокСтиля[1];
		КонецЕсли;

		Если ВсегоПодСтрок > 2 Тогда
			МассивПодСтрокСтиля.Удалить(0);
			ЗначениеЭлемента = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивПодСтрокСтиля, ";");
		КонецЕсли;

		Если ЗначениеЭлемента <> Неопределено Тогда
			ЗначениеЭлемента = СокрЛП(ЗначениеЭлемента);
		КонецЕсли;

		СоотвСтиля.Вставить(ИмяЭлемента, ЗначениеЭлемента);

	КонецЦикла;

	Возврат СоотвСтиля;

КонецФункции









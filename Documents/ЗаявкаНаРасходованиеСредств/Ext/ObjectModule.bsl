Функция ПолучитьДанныеПоЛимитам(Подразделение,Проект,СтатьяДДС,Организация,Период) Экспорт 
	Типпериода = Неопределено;	
	ЕстьПроект = Ложь;
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛимитыБюджетированияПоСтатьям.ТипПериода
	               |ИЗ
	               |	РегистрНакопления.ЛимитыБюджетированияПоСтатьям КАК ЛимитыБюджетированияПоСтатьям
	               |ГДЕ
	               |	ЛимитыБюджетированияПоСтатьям.Период МЕЖДУ &НачалоПериода И &КонецПериода
	              // |	И ЛимитыБюджетированияПоСтатьям.Подразделение = &Подразделение
	               |	И ЛимитыБюджетированияПоСтатьям.Статья = &Статья
	               |	И ЛимитыБюджетированияПоСтатьям.Проект = &Проект
	               |	И ЛимитыБюджетированияПоСтатьям.Организация = &Организация
	               |	И ЛимитыБюджетированияПоСтатьям.ВидДвижения = &ВидДвижения";
	
	Запрос.УстановитьПараметр("НачалоПериода",НачалоГода(Дата));
	Запрос.УстановитьПараметр("ВидДвижения",ВидДвиженияНакопления.Приход);

	Запрос.УстановитьПараметр("КонецПериода",КонецГода(Дата));
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Запрос.УстановитьПараметр("Организация",?(Организация.А_БухгалтерскийУчет,А_ОбщегоНазначения.ПолучитьОрганизациюУУ(Организация),Организация));

	Запрос.УстановитьПараметр("Статья",СтатьяДДС);
	Запрос.УстановитьПараметр("Проект",Проект);
	
	РезультатаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если не РезультатаЗапроса.Количество() Тогда 
		Запрос = новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛимитыБюджетированияПоСтатьям.ТипПериода
		               |ИЗ
		               |	РегистрНакопления.ЛимитыБюджетированияПоСтатьям КАК ЛимитыБюджетированияПоСтатьям
		               |ГДЕ
		               |	ЛимитыБюджетированияПоСтатьям.Период МЕЖДУ &НачалоПериода И &КонецПериода
		               |	И ЛимитыБюджетированияПоСтатьям.Подразделение = &Подразделение
		               |	И ЛимитыБюджетированияПоСтатьям.Статья = &Статья
		               |	И ЛимитыБюджетированияПоСтатьям.Проект = &Проект
		               |	И ЛимитыБюджетированияПоСтатьям.Организация = &Организация
		               |	И ЛимитыБюджетированияПоСтатьям.ВидДвижения = &ВидДвижения";
		
		Запрос.УстановитьПараметр("НачалоПериода",НачалоГода(Дата));
		Запрос.УстановитьПараметр("КонецПериода",КонецГода(Дата));
		Запрос.УстановитьПараметр("Подразделение",Подразделение);
		Запрос.УстановитьПараметр("Статья",СтатьяДДС);
		Запрос.УстановитьПараметр("ВидДвижения",ВидДвиженияНакопления.Приход);
		Запрос.УстановитьПараметр("Проект",Справочники.Проекты.ПустаяСсылка());
		Запрос.УстановитьПараметр("Организация",?(Организация.А_БухгалтерскийУчет,А_ОбщегоНазначения.ПолучитьОрганизациюУУ(Организация),Организация));


		
		РезультатаЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатаЗапроса.Количество() Тогда 
			Типпериода = РезультатаЗапроса[0].ТипПериода; 
		КонецЕсли;
	Иначе
		Типпериода = РезультатаЗапроса[0].ТипПериода;
		ЕстьПроект = Истина;

	КонецЕсли;			
	
	
	Если Типпериода = Перечисления.ТипыПериодов.Месяц Тогда 
		ТипПериодаЗапроса = "Месяц";
		ПериодЗапроса = НачалоМесяца(Период);
	ИначеЕсли Типпериода = Перечисления.ТипыПериодов.ТриМесяца Тогда 
		ТипПериодаЗапроса = "Квартал";
		ПериодЗапроса = НачалоКвартала(Период);
	ИначеЕсли Типпериода = Перечисления.ТипыПериодов.ПодГода Тогда 
		ТипПериодаЗапроса = "Полугодие" ;
		ПериодЗапроса = НачалоПолугодия(Период);
	ИначеЕсли Типпериода = Перечисления.ТипыПериодов.Год Тогда 
		ТипПериодаЗапроса = "Год";
		ПериодЗапроса = НачалоГода(Период);	
	ИначеЕсли Типпериода = Перечисления.ТипыПериодов.БезОграничений Тогда
		ТипПериодаЗапроса = "";
		ПериодЗапроса =Период;
	Иначе
		ТипПериодаЗапроса = "Год";

		ПериодЗапроса =Период;
	КонецЕсли;
	///////////////////////////////////////////////////////Суммы по проекту///////////////////////////////////////////////////////
	
		ЛимитПоПроектуВсего = 0;
		ЛимитПоПроектуИзрасходованно = 0;
		ЛимитПоПроектуОстаток = 0;
		Если ЕстьБюджетПоПоекту(Проект) Тогда 
			
			РезультатЗапросаПоЛимитам = Запрос.Выполнить().Выгрузить();
			
			ЗапросПоЛимитамПроекта = новый запрос;
			ЗапросПоЛимитамПроекта.Текст  ="ВЫБРАТЬ
			                               |	СУММА(ЛимитыБюджетированияПоСтатьямОбороты.СуммаРасход) КАК СуммаРасход,
			                               |	0 КАК СуммаПриход
			                               |ПОМЕСТИТЬ ПредИтог
			                               |ИЗ
			                               |	РегистрНакопления.ЛимитыБюджетированияПоСтатьям.Обороты(
			                               |			,
			                               |			,
			                               |			,
			                               |			ПроектУправленческий = &Проект
			                               |				И Статья ССЫЛКА Справочник.СтатьиДвиженияДенежныхСредств) КАК ЛимитыБюджетированияПоСтатьямОбороты
			                               |ГДЕ
			                               |	ИСТИНА
			                               |	И ЛимитыБюджетированияПоСтатьямОбороты.Статья.ВидСтатьи = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
			                               |
			                               |ОБЪЕДИНИТЬ ВСЕ
			                               |
			                               |ВЫБРАТЬ
			                               |	0,
			                               |	СУММА(ЛимитыБюджетированияПоСтатьямОбороты.СуммаПриход)
			                               |ИЗ
			                               |	РегистрНакопления.ЛимитыБюджетированияПоСтатьям.Обороты(
			                               |			,
			                               |			,
			                               |			,
			                               |			Проект = &Проект
			                               |				И Статья ССЫЛКА Справочник.СтатьиДвиженияДенежныхСредств) КАК ЛимитыБюджетированияПоСтатьямОбороты
			                               |ГДЕ
			                               |	ИСТИНА
			                               |	И ЛимитыБюджетированияПоСтатьямОбороты.Статья.ВидСтатьи = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
			                               |;
			                               |
			                               |////////////////////////////////////////////////////////////////////////////////
			                               |ВЫБРАТЬ
			                               |	СУММА(ПредИтог.СуммаРасход) КАК СуммаРасход,
			                               |	СУММА(ПредИтог.СуммаПриход) КАК СуммаПриход
			                               |ИЗ
			                               |	ПредИтог КАК ПредИтог";
			
			
			
			ЗапросПоЛимитамПроекта.УстановитьПараметр("Проект",Проект);
			ЗапросПоЛимитамПроекта.УстановитьПараметр("Организация",?(Организация.А_БухгалтерскийУчет,А_ОбщегоНазначения.ПолучитьОрганизациюУУ(Организация),Организация));
			РезультатЗапросаПоЛимитамПроекта = ЗапросПоЛимитамПроекта.Выполнить().Выгрузить();
			
			Если РезультатЗапросаПоЛимитамПроекта.Количество() Тогда
				
				ЛимитПоПроектуОстаток = РезультатЗапросаПоЛимитамПроекта[0].СуммаПриход - РезультатЗапросаПоЛимитамПроекта[0].СуммаРасход;
				
				
			КонецЕсли;
			
		КонецЕсли;
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	Запрос = новый запрос;
	Запрос.Текст  ="ВЫБРАТЬ
	               |	ЛимитыБюджетированияПоСтатьямОбороты.СуммаОборот,
				   |	ЛимитыБюджетированияПоСтатьямОбороты.СуммаПриход,
	               |	ЛимитыБюджетированияПоСтатьямОбороты.СуммаРасход,
				   |    &ТипПериодаЗапросаБюджет как ТипПериодаЗапроса,
				   |    &ЕстьПроект как ЕстьПроект,
				   |    &ЛимитПоПроектуВсего,
				   |    &ЛимитПоПроектуИзрасходованно,
				   |    &ЛимитПоПроектуОстаток
	               |ИЗ
	               |	РегистрНакопления.ЛимитыБюджетированияПоСтатьям.Обороты(
	               |			,
	               |			,"
				   +ТипПериодаЗапроса+",
	               |			Организация = &Организация
	               |				И выбор когда  &ЕстьПроект тогда Истина иначе Подразделение = &Подразделение конец
	               |				И Выбор когда (&ТипПериодаЗапросаБюджет есть null или  &ТипПериодаЗапросаБюджет = """" или  &ТипПериодаЗапросаБюджет = неопределено) тогда ПроектУправленческий = &ПроектУправленческий иначе Проект = &Проект конец
	               |				И Статья = &Статья) КАК ЛимитыБюджетированияПоСтатьямОбороты
				   |ГДЕ"+?(ТипПериодаЗапроса=""," Истина"," ЛимитыБюджетированияПоСтатьямОбороты.Период = &Период")+"
             	   |	";
				   
				   
		Запрос.УстановитьПараметр("Подразделение",Подразделение);
		Запрос.УстановитьПараметр("Статья",СтатьяДДС);
		Запрос.УстановитьПараметр("Проект",?(ЕстьПроект,Проект,Справочники.Проекты.ПустаяСсылка()));
		Запрос.УстановитьПараметр("ПроектУправленческий",Проект);

		Запрос.УстановитьПараметр("Организация",?(Организация.А_БухгалтерскийУчет,А_ОбщегоНазначения.ПолучитьОрганизациюУУ(Организация),Организация));
		Запрос.УстановитьПараметр("Период",ПериодЗапроса);
		Запрос.УстановитьПараметр("ТипПериодаЗапроса",ТипПериодаЗапроса);
		Запрос.УстановитьПараметр("ТипПериодаЗапросаБюджет",Типпериода); 
		Запрос.УстановитьПараметр("ЕстьПроект",ЕстьПроект);
		Запрос.УстановитьПараметр("ЛимитПоПроектуВсего",ЛимитПоПроектуВсего);
		Запрос.УстановитьПараметр("ЛимитПоПроектуИзрасходованно",ЛимитПоПроектуИзрасходованно);
		Запрос.УстановитьПараметр("ЛимитПоПроектуОстаток",ЛимитПоПроектуОстаток);
		РезультатЗапросаПоЛимитам = Запрос.Выполнить().Выгрузить();

				
		Если РезультатЗапросаПоЛимитам.Количество() Тогда 
			Возврат РезультатЗапросаПоЛимитам[0];
		Иначе
			Возврат Новый Структура("СуммаОборот,СуммаПриход,СуммаРасход,ТипПериодаЗапроса,ЕстьПроект,ЛимитПоПроектуВсего,ЛимитПоПроектуИзрасходованно,ЛимитПоПроектуОстаток",0,0,0,Типпериода,ЕстьПроект,0,0,ЛимитПоПроектуОстаток);
		КонецЕсли;
		
КонецФункции
			   
Функция НачалоПолугодия(Знач Дата) Экспорт
    
    ПервыйДеньГода = НачалоГода(Дата);
    ПервыйДеньИюля = НачалоМесяца(ДобавитьМесяц(ПервыйДеньГода, 6));
    
    Если Месяц(Дата) < 7 Тогда
        Возврат ПервыйДеньГода;
    Иначе
        Возврат ПервыйДеньИюля;
    КонецЕсли;
    
КонецФункции

Функция ПроверитьВозможностьПроведения()
	
	ПроводитьМожно = Истина;
	
	Для Каждого Строка из РасшифровкаПлатежа Цикл  
		
		ДанныеПоЛимитам =  ПолучитьДанныеПоЛимитам(ЦФО,Строка.Проект,Строка.СтатьяДвиженияДенежныхСредств,Организация,Дата);
		если не Строка.СверхБюджета Тогда 
			Если СуммаДокумента>ДанныеПоЛимитам.СуммаОборот Тогда 
				ПроводитьМожно =  Ложь;
				Сообщить("По статті "+Строка.СтатьяДвиженияДенежныхСредств+" недостатньо вільного ліміту!",СтатусСообщения.ОченьВажное);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ПроводитьМожно;
	
КонецФункции

Функция ЕстьБюджетПоПоекту(Проект)
	
	ЕстьПроект = Ложь;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛимитыБюджетированияПоСтатьям.ТипПериода
	               |ИЗ
	               |	РегистрНакопления.ЛимитыБюджетированияПоСтатьям КАК ЛимитыБюджетированияПоСтатьям
	               |ГДЕ 	             
	               |     ЛимитыБюджетированияПоСтатьям.Проект = &Проект
	               |	И ЛимитыБюджетированияПоСтатьям.Организация = &Организация
	               |	И ЛимитыБюджетированияПоСтатьям.ВидДвижения = &ВидДвижения";
	

	Запрос.УстановитьПараметр("ВидДвижения",ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("Организация",?(Организация.А_БухгалтерскийУчет,А_ОбщегоНазначения.ПолучитьОрганизациюУУ(Организация),Организация));
	Запрос.УстановитьПараметр("Проект",Проект);
	
	РезультатаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если  РезультатаЗапроса.Количество() Тогда 
		ЕстьПроект = Истина;
	КонецЕсли;	
	
	Возврат ЕстьПроект;
КонецФункции


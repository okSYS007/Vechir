&НаКлиенте
Процедура УстановитьДоступность()
	
	ПолучитьОстаткиДС(Объект.ФормаОплаты);
	Если Объект.Статус = Перечисления.СтатусыРеестраНаОплатуДС.Черновик Тогда 
		
		Элементы.ФормаНаСогласование.Доступность = Истина;
		Элементы.ЗаявкиНаРасходованиеДСПодобратьЗаявки.Доступность = Истина;
		
	иначе
		Элементы.ФормаНаСогласование.Доступность = Ложь;
		Элементы.ЗаявкиНаРасходованиеДСПодобратьЗаявки.Доступность = Ложь;
		
	КонецЕсли;
	
	Если Объект.Статус = Перечисления.СтатусыРеестраНаОплатуДС.Согласована Тогда 
		Элементы.ЗаявкиНаРасходованиеДССоздатьДокументы.Доступность = Истина;
	иначе
		Элементы.ЗаявкиНаРасходованиеДССоздатьДокументы.Доступность = Ложь;	
	КонецЕсли;
	
	СогласованиеДоступноНаКлиенте();
	
КонецПроцедуры
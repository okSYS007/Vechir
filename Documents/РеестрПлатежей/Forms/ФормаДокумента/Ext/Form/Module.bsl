&НаКлиенте
Процедура Согласовать(Команда)
	СогласоватьНаСервере();
	СогласованиеДоступноНаКлиенте();
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура СогласоватьНаСервере()
	
	запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	|	ЗадачаЗадачаИсполнителяЗадачиПоИсполнителю.Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя.ЗадачиПоИсполнителю КАК ЗадачаЗадачаИсполнителяЗадачиПоИсполнителю
	|ГДЕ
	|	ЗадачаЗадачаИсполнителяЗадачиПоИсполнителю.БизнесПроцесс.Предмет = &Предмет
	|	И НЕ ЗадачаЗадачаИсполнителяЗадачиПоИсполнителю.Выполнена";
	Запрос.УстановитьПараметр("Предмет",Объект.Ссылка);
	
	РезультатЗапроса = запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		Об = РезультатЗапроса[0].Ссылка.получитьОбъект();
		
		СогласованиеОбъект = Об.БизнесПроцесс.ПолучитьОбъект();
		СогласованиеОбъект.ДобавитьРезультатСогласования(
		Об.ТочкаМаршрута,
		ПараметрыСеанса.ТекущийПользователь,Перечисления.РезультатыСогласования.Согласовано,
		Об.РезультатВыполнения,
		Об.ДатаИсполнения);
		
		СогласованиеОбъект.Записать();
		БизнесПроцессыИЗадачиВызовСервера.ВыполнитьЗадачу(РезультатЗапроса[0].Ссылка);
		
	КонецЕсли;
	
	СогласованиеДоступноНаНаСервере();
	
	
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	ОтклонитьНоСервере();
	СогласованиеДоступноНаКлиенте();

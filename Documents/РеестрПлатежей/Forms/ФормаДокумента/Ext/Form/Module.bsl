&НаКлиенте
Процедура СогласованиеДоступноНаКлиенте()
	
	СогласованиеДоступно = СогласованиеДоступноНаНаСервере();
	
	Если СогласованиеДоступно Тогда 	
		Элементы.ФормаОтклонить.Доступность = Истина; 
		Элементы.ФормаСогласовать.Доступность = Истина;
		
	Иначе
		
		Элементы.ФормаОтклонить.Доступность = Ложь; 
		Элементы.ФормаСогласовать.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры


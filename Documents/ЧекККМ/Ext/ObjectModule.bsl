Функция	ПолучитьДоговорКонтрагента(Контрагент,Организация,ВидДоговора) Экспорт 
	
	ВозвращаемоеЗначение = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Владелец = &Контрагент
	               |	И ДоговорыКонтрагентов.Организация = &Организация
	               |	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора";
	Запрос.УстановитьПараметр("ВидДоговора",ВидДоговора);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() Тогда 
		ВозвращаемоеЗначение = РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции

Функция ПолучитьЦеныПоПартиям(Данные)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеИзПТУ.Номенклатура,
		|	ДанныеИзПТУ.СерияНоменклатуры,
		|	ДанныеИзПТУ.ХарактеристикаНоменклатуры,
		|	ДанныеИзПТУ.Склад
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	&ТЗДанные КАК ДанныеИзПТУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ПартииТоваровНаСкладахОстаткиИОбороты.НДСКонечныйОстаток) КАК НДСКонечныйОстаток,
		|	СУММА(ПартииТоваровНаСкладахОстаткиИОбороты.СтоимостьКонечныйОстаток) КАК СтоимостьКонечныйОстаток,
		|	СУММА(ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток) КАК КоличествоКонечныйОстаток,
		|	ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура,
		|	ПартииТоваровНаСкладахОстаткиИОбороты.СерияНоменклатуры
		|ИЗ
		|	РегистрНакопления.ПартииТоваровНаСкладах.ОстаткиИОбороты(
		|			,
		|			&ДатаДок,
		|			,
		|			,
		|			(Номенклатура, СерияНоменклатуры, ХарактеристикаНоменклатуры, Склад) В
		|				(ВЫБРАТЬ
		|					ВТ_Данные.Номенклатура,
		|					ВТ_Данные.СерияНоменклатуры,
		|					ВТ_Данные.ХарактеристикаНоменклатуры,
		|					ВТ_Данные.Склад
		|				ИЗ
		|					ВТ_Данные КАК ВТ_Данные)) КАК ПартииТоваровНаСкладахОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ПартииТоваровНаСкладахОстаткиИОбороты.СерияНоменклатуры,
		|	ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура";
	
	Запрос.УстановитьПараметр("ДатаДок", Дата);
	Запрос.УстановитьПараметр("ТзДанные", Данные);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


Процедура СформироватьВозвратОтПокупателя()
	
	ВозвратОтПокупателя 						= Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	ВозвратОтПокупателя.Заполнить(ЧекККМПродажа.РеализацияТоваров);

	ВозвратОтПокупателя.Дата 			       	= ТекущаяДата() ;
	ВозвратОтПокупателя.ВалютаДокумента         = Константы.ВалютаРегламентированногоУчета.Получить();
	ВозвратОтПокупателя.КурсВзаиморасчетов      = 1;
	ВозвратОтПокупателя.КратностьВзаиморасчетов = 1;
	ВозвратОтПокупателя.Подразделение		   	= ЧекККМПродажа.ЗаказПокупателя.Подразделение;
	ВозвратОтПокупателя.ОтражатьВБухгалтерскомУчете = Ложь;	
	ВозвратОтПокупателя.ОтражатьВУправленческомУчете = Истина;

	Для Каждого Строка из ВозвратОтПокупателя.Товары Цикл 
		
		Строка.НалоговоеНазначение = Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_НеоблагаемаяХозДеятельность;
		Строка.СхемаРеализации     = Справочники.СхемыРеализации.Товары;
		СчетаУчета  = БухгалтерскийУчет.ПолучитьСчетаУчетаНоменклатуры(Справочники.Организации.ПустаяСсылка(),Строка.Номенклатура.Ссылка,Справочники.Склады.ПустаяСсылка(), Строка.Номенклатура.Ссылка.ВидНоменклатуры);
			СчетУчетаБУ = СчетаУчета.СчетУчетаБУ;
			
			Строка.СчетУчетаБУ = ?(СчетУчетаБУ = ПланыСчетов.Хозрасчетный.ПустаяСсылка(),ПланыСчетов.Хозрасчетный.НайтиПоКоду("281"),СчетУчетаБУ);
	
		
	КонецЦикла;
	
	//Дандали В. 26.11.2024 + //Частичный возврат
	НужноПересчитатьСуммуОплаты = Ложь;
	Если ВозвратОтПокупателя.Товары.Количество() <> 0 
		И ВозвратОтПокупателя.Товары.Количество() > Товары.Количество() Тогда
		
		МассНаУдаление = Новый Массив;
		//заполнение идет по реализации. уберем товары, которых нет в чеке на возврат
		Для Каждого стрТовар из ВозвратОтПокупателя.Товары Цикл 
			стрПоиска = Новый Структура;
			стрПоиска.Вставить("Номенклатура", стрТовар.Номенклатура);
			стрПоиска.Вставить("СерияНоменклатуры", стрТовар.СерияНоменклатуры);
			НайденныеТоварыВЧекеНаВозврат = Товары.НайтиСтроки(стрПоиска);
			Если НайденныеТоварыВЧекеНаВозврат.Количество() = 0 Тогда
				МассНаУдаление.Добавить(стрТовар);
				НужноПересчитатьСуммуОплаты = Истина;  
				Продолжить;
			КонецЕсли;
			
			//Кейс когда продали например 3 ед. товаров, а вернули меньше (например 1) 
			Если НайденныеТоварыВЧекеНаВозврат[0].Количество <> стрТовар.Количество Тогда
				стрТовар.Количество = НайденныеТоварыВЧекеНаВозврат[0].Количество;	
				стрТовар.Сумма		= стрТовар.Цена * стрТовар.Количество;
				ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(стрТовар, ВозвратОтПокупателя);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого стрУдаление из МассНаУдаление Цикл
			ВозвратОтПокупателя.Товары.Удалить(стрУдаление);	
		КонецЦикла;
	КонецЕсли;
	
	Если НужноПересчитатьСуммуОплаты И Оплата.Количество() = 1 Тогда
		Если Оплата.Итог("Сумма") <> Товары.Итог("Сумма") Тогда
			Оплата[0].Сумма = Товары.Итог("Сумма");	
		КонецЕсли;
	КонецЕсли;	
	//Дандали В. 26.11.2024 -
	
	Если ВозвратОтПокупателя.Товары.Количество() Тогда 
		ВозвратОтПокупателя.Записать();
		ВозвратОтПокупателя.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьОплатуОтПокупателяПлатежнойКартой()
	
	Запрос = новый запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ОплатаОтПокупателяПлатежнойКартой.Ссылка
			               |ИЗ
			               |	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
			               |ГДЕ
			               |	ОплатаОтПокупателяПлатежнойКартой.ДокументОснование = &ДокументОснование
			               |	И НЕ ОплатаОтПокупателяПлатежнойКартой.ПометкаУдаления";
			Запрос.УстановитьПараметр("ДокументОснование",ЗаказПокупателя.ссылка);
			
			РезультатЗапроса = запрос.Выполнить().Выгрузить();
			
			Если не РезультатЗапроса.Количество() Тогда
				
				
				ДокОб 								= Документы.ОплатаОтПокупателяПлатежнойКартой.СоздатьДокумент();
				ДокОб.Дата 							= Дата;
				ДокОб.Ответственный 				= Ответственный;
				ДокОб.ДокументОснование				= ЗаказПокупателя.Ссылка;
				ДокОб.ОтражатьВБухгалтерскомУчете 	= Истина;
				ДокОб.Комментарий                   = "#Создано автоматический при оплате на кассе";
				ДокОб.ВидОперации 					= Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя;
				ДокОб.ВалютаДокумента 				= Константы.ВалютаРегламентированногоУчета.Получить();
				ДокОб.ВидОплаты						= Справочники.ВидыОплатЧекаККМ.НайтиПоНаименованию("Платежная карта");
				ДокОб.Контрагент                    = ЗаказПокупателя.Контрагент;
				////Дандали В. 25.06.2025 +
				//Если ЭтотОбъект.Комментарий = "#Створено з обробки робоче місце ІМ" Тогда
				//	ДокОб.ДоговорЭквайринга = Справочники.ДоговорыЭквайринга.НайтиПоКоду("000000006"); //Нова пей
				//Иначе
				//	ДокОб.ДоговорЭквайринга = Справочники.ДоговорыЭквайринга.НайтиПоКоду("000000005"); //Приват
				//КонецЕсли;
				////Дандали В. 25.06.2025 -
				
				//Дандали В. 10.03.2026 +
				Попытка
					Менеджер 			    = РегистрыСведений.СпособыДоставкиОрганизации.СоздатьМенеджерЗаписи();
					Менеджер.СпособДоставки = ЗаказПокупателя.СпособОплаты;
					Менеджер.Прочитать();
				Исключение
					Менеджер = Неопределено;
				КонецПопытки;
				
				Если Менеджер <> Неопределено
					И ЗначениеЗаполнено(Менеджер.Организация)
					И ЗначениеЗаполнено(Менеджер.ДоговорЭквайринга) Тогда				
					ДокОб.ДоговорЭквайринга = Менеджер.ДоговорЭквайринга;
				Иначе
					Если ЭтотОбъект.Комментарий = "#Створено з обробки робоче місце ІМ" Тогда
						ДокОб.ДоговорЭквайринга = Справочники.ДоговорыЭквайринга.НайтиПоКоду("000000006"); //Нова пей
					Иначе
						ДокОб.ДоговорЭквайринга = Справочники.ДоговорыЭквайринга.НайтиПоКоду("000000005"); //Приват
					КонецЕсли;
				КонецЕсли;
				//Дандали В. 10.03.2026 -
				
				//Дандали В. 26.03.2026 +
				Если ЗаказПокупателя.СпособДоставки = "Доставка у відділення «Нова Пошта»" 
					И Найти("Оплата при отриманні", ЗаказПокупателя.СпособОплаты) <> Неопределено Тогда
					ДокОб.ДоговорЭквайринга = Справочники.ДоговорыЭквайринга.НайтиПоКоду("000000006"); //Нова пей
				КонецЕсли;
				//Дандали В. 26.03.2026 -
				
				
				ДокОб.ДоговорВзаиморасчетовЭквайрера= ДокОб.ДоговорЭквайринга.ДоговорВзаиморасчетов;            

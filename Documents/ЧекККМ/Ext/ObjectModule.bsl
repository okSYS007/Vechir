// ОБРАБОТЧИКИ СОБЫТИЙ

// Процедура - обработчик события "ОбработкаЗаполнения".
//
Процедура ОбработкаЗаполнения(Основание)

	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЧекККМ") Тогда

		// Заполним вид операции.
		ВидыОперацийЧек = Перечисления.ВидыОперацийЧекККМ;
		Если Основание.ВидОперации = ВидыОперацийЧек.Продажа Тогда
			ВидОперации = ВидыОперацийЧек.Возврат;
			ЧекККМПродажа = Основание;
		Иначе
			Возврат;
		КонецЕсли;

		// Заполним реквизиты из стандартного набора.
		ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, Основание);

		КассаККМ = Основание.КассаККМ;
		ВладелецДисконтнойКарты = Основание.ВладелецДисконтнойКарты;

		// Скопируем состав.
		Товары.Загрузить(Основание.Товары.Выгрузить());

		СоставНабора.Загрузить(Основание.СоставНабора.Выгрузить());
		СерийныеНомера.Загрузить(Основание.СерийныеНомера.Выгрузить());
		СерийныеНомераСоставНабора.Загрузить(Основание.СерийныеНомераСоставНабора.Выгрузить());
		АкцизныеМарки.Загрузить(Основание.АкцизныеМарки.Выгрузить());
		
		Оплата.Загрузить(Основание.Оплата.Выгрузить());
		
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
		
		СуммаДокОснование 	= Основание.СуммаДокумента;
		Организация			= Основание.Организация;
		
		ВидыОперацийЧек 	= Перечисления.ВидыОперацийЧекККМ.Продажа;
		ДокументОснование 	= Основание;
		СуммаДокумента		= СуммаДокОснование;
		
		ТипЦен				= Справочники.ТипыЦенНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор("de527c98-6381-11ee-bf31-00155d0a1408"));
		НоменклатураВыручка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор("cd4a4817-593e-11ee-bf2c-00155d0a1408")); 
		КассаККМ			= Справочники.КассыККМ.ПолучитьСсылку(Новый УникальныйИдентификатор("746737d7-5931-11ee-bf2c-00155d0a1408"));
		Склад				= Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор("20c0dc66-c2cd-11eb-bae1-00155d0a3d01"));
		ВидОплатыКартой		= Справочники.ВидыОплатЧекаККМ.ПолучитьСсылку(Новый УникальныйИдентификатор("e828139c-36ce-11ee-bf28-00155d0a1408"));
		
		//Товары
		стрТовары 					= Товары.Добавить();
		стрТовары.Количество 		= 1;
		стрТовары.Коэффициент		= 1;
		стрТовары.Номенклатура 		= НоменклатураВыручка;
		стрТовары.Цена				= СуммаДокОснование;
		стрТовары.Сумма				= СуммаДокОснование;
		стрТовары.ЕдиницаИзмерения 	= НоменклатураВыручка.ЕдиницаХраненияОстатков;
		
		стрОплата 			= Оплата.Добавить();
		стрОплата.ВидОплаты = ВидОплатыКартой;
		стрОплата.Сумма		= СуммаДокумента;
		
	КонецЕсли;

КонецПроцедуры // ОбработкаЗаполнения()

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	мУдалятьДвижения = НЕ ЭтоНовый();

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СуммаДокумента = Товары.Итог("Сумма");
	УчетСерийныхНомеров.УдалитьНеиспользуемыеСтрокиПодчиненнойТЧ(ЭтотОбъект, мПараметрыСвязиСтрокТЧ, "Товары");

	СтатусОтправкиПоПочте = А_ОбщегоНазначенияСервер.ПолучитьСтатусОтправкиДокумента(Ссылка);
	
КонецПроцедуры // ПередЗаписью()

// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Дерево значений, содержащее имена необходимых полей в запросе по шапке.
	Перем ДеревоПолейЗапросаПоШапке;

	
	Если мУдалятьДвижения Тогда
		ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);
	КонецЕсли;

	СтруктураШапкиДокумента = ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);

	// Заполним по шапке документа дерево параметров, нужных при проведении.
	ДеревоПолейЗапросаПоШапке = ОбщегоНазначения.СформироватьДеревоПолейЗапросаПоШапке();
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "Константы", "ВалютаУправленческогоУчета"    , "ВалютаУправленческогоУчета");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "Константы", "КурсВалютыУправленческогоУчета", "КурсВалютыУправленческогоУчета");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "Склад"    , "ВидСклада"                     , "ВидСклада");

	// Сформируем запрос на дополнительные параметры, нужные при проведении, по данным шапки документа.
	СтруктураШапкиДокумента = УправлениеЗапасами.СформироватьЗапросПоДеревуПолей(ЭтотОбъект, ДеревоПолейЗапросаПоШапке, СтруктураШапкиДокумента, мВалютаРегламентированногоУчета);
	СтруктураШапкиДокумента.Вставить("КонтролироватьОстаткиТоваровПриОперативномПроведенииЧековККМ", УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "КонтролироватьОстаткиТоваровПриОперативномПроведенииЧековККМ"));

	// Заголовок для сообщений об ошибках проведения.
	Заголовок = ОбщегоНазначения.ПредставлениеДокументаПриПроведении(СтруктураШапкиДокумента);
	
	СтатусЧека = Перечисления.СтатусыЧековККМ.Пробитый;
	
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	// Проверим корректность заполнения штрихкодов акцизных марок
	ПроверитьКорректностьЗаполненияАкцизныхМарок(Отказ);

	// Проверим допустимость для пользователя цен документа.
	УправлениеДопПравамиПользователей.ПроверитьДопустимостьЦенОтпуска(ЭтотОбъект, "Товары", Отказ);

	// Получим необходимые данные для проведения и проверки заполнения по табличной части "Товары".
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("Номенклатура", "Номенклатура");
	СтруктураПолей.Вставить("Услуга"      , "Номенклатура.Услуга");

	Если ВидОперации <> Перечисления.ВидыОперацийЧекККМ.Возврат Тогда
		СтруктураПолей.Вставить("Количество"   , "Количество * Коэффициент /Номенклатура.ЕдиницаХраненияОстатков.Коэффициент");
		СтруктураПолей.Вставить("Сумма"        , "Сумма");
	Иначе
		СтруктураПолей.Вставить("КоличествоДок", "Количество * Коэффициент /Номенклатура.ЕдиницаХраненияОстатков.Коэффициент");
		СтруктураПолей.Вставить("СуммаДок"     , "Сумма");
	КонецЕсли;

	СтруктураПолей.Вставить("Цена"                               , "Цена");
	СтруктураПолей.Вставить("Набор"                              , "Номенклатура.Набор");
	СтруктураПолей.Вставить("Комплект"                           , "Номенклатура.Комплект");
	СтруктураПолей.Вставить("ХарактеристикаНоменклатуры"         , "ХарактеристикаНоменклатуры");
	СтруктураПолей.Вставить("ЕдиницаИзмерения"                   , "ЕдиницаИзмерения");
	СтруктураПолей.Вставить("СерияНоменклатуры"                  , "СерияНоменклатуры");
	СтруктураПолей.Вставить("ПроцентСкидкиНаценки"               , "ПроцентСкидкиНаценки");
	СтруктураПолей.Вставить("ПроцентАвтоматическихСкидок"        , "ПроцентАвтоматическихСкидок");
	СтруктураПолей.Вставить("УсловиеАвтоматическойСкидки"        , "УсловиеАвтоматическойСкидки");
	СтруктураПолей.Вставить("ЗначениеУсловияАвтоматическойСкидки", "ЗначениеУсловияАвтоматическойСкидки");
	СтруктураПолей.Вставить("КлючСтроки"                         , "КлючСтроки");
	СтруктураПолей.Вставить("КоличествоВЕдиницахДокумента"       , "Количество");

	РезультатЗапросаПоТоварам = ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Товары", СтруктураПолей);

	Если ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат И ЗначениеЗаполнено(ЧекККМПродажа) И Не ОбменДанными.Загрузка Тогда
		РезультатЗапросаПоТоварамОснования = ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЧекККМПродажа, "Товары", СтруктураПолей);
		ТаблицаТоваровДокумента = РезультатЗапросаПоТоварам.Выгрузить();
		ТаблицаТоваровДокумента.Свернуть("Номенклатура, Цена, ХарактеристикаНоменклатуры, СерияНоменклатуры", "КоличествоДок");
		ТаблицаТоваровДокументаОснования = РезультатЗапросаПоТоварамОснования.Выгрузить();
		ТаблицаТоваровДокументаОснования.Свернуть("Номенклатура, Цена, ХарактеристикаНоменклатуры, СерияНоменклатуры", "КоличествоДок");
		ТаблицаТоваровДокументаОснования.Индексы.Добавить("Номенклатура, Цена, ХарактеристикаНоменклатуры, СерияНоменклатуры");

		Для Каждого СтрокаТаблицыТоваровДокумента Из ТаблицаТоваровДокумента Цикл
			СтрокиОснования = ТаблицаТоваровДокументаОснования.НайтиСтроки(
			                  Новый Структура ("Номенклатура, Цена, ХарактеристикаНоменклатуры, СерияНоменклатуры",
			                                   СтрокаТаблицыТоваровДокумента.Номенклатура,
			                                   СтрокаТаблицыТоваровДокумента.Цена,
			                                   СтрокаТаблицыТоваровДокумента.ХарактеристикаНоменклатуры,
			                                   СтрокаТаблицыТоваровДокумента.СерияНоменклатуры));

			Продано = 0;
			Если СтрокиОснования.Количество() > 0 Тогда
				Если СтрокиОснования[0].КоличествоДок >= СтрокаТаблицыТоваровДокумента.КоличествоДок Тогда
					Продолжить;
				Иначе
					Продано = СтрокиОснования[0].КоличествоДок;
				КонецЕсли;
			КонецЕсли;

			ОбщегоНазначения.СообщитьОбОшибке(НСтр("ru='По документу основанию товара ""';uk='По документу підставі товару ""'") + СтрокаТаблицыТоваровДокумента.Номенклатура
			                    + НСтр("ru='"" по цене ""';uk='"" за ціною ""'") + ОбщегоНазначения.ФорматСумм(СтрокаТаблицыТоваровДокумента.Цена, мВалютаРегламентированногоУчета)+ """ "
			                    + Символы.ПС + ? (ЗначениеЗаполнено(СтрокаТаблицыТоваровДокумента.ХарактеристикаНоменклатуры),
			                         НСтр("ru='с характеристикой ""';uk='з характеристикою ""'") + СтрокаТаблицыТоваровДокумента.ХарактеристикаНоменклатуры + """", "")
			                    + ? (ЗначениеЗаполнено(СтрокаТаблицыТоваровДокумента.СерияНоменклатуры),
			                         НСтр("ru='с серией ""';uk='з серією ""'") + СтрокаТаблицыТоваровДокумента.СерияНоменклатуры + """", "")
			                    + НСтр("ru='продано ""';uk='продано ""'") + Продано +НСтр("ru='"", возвращается от покупателя ""';uk='"", повертається від покупця ""'")
			                    + СтрокаТаблицыТоваровДокумента.КоличествоДок + """.", Отказ, Заголовок);
		КонецЦикла;
	КонецЕсли;

	// Подготовим таблицу товаров для проведения.
	ТаблицаПоТоварам = ПодготовитьТаблицуТоваров(РезультатЗапросаПоТоварам, СтруктураШапкиДокумента);

	// Проверить заполнение ТЧ "Товары".
	ПроверитьЗаполнениеТабличнойЧастиТовары(ТаблицаПоТоварам, СтруктураШапкиДокумента, Отказ, Заголовок);

	// Получим необходимые данные для проведения и проверки заполнения по табличной части "Оплата".
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ВидОплаты", "ВидОплаты");
	СтруктураПолей.Вставить("Сумма"    , "Сумма");

	ТаблицаПоОплате = ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Оплата", СтруктураПолей).Выгрузить();

	// Проверить заполнение ТЧ "Оплата".
	ПроверитьЗаполнениеТабличнойЧастиОплата(ТаблицаПоОплате, Отказ, Заголовок);

	// Проверить заполнение ТЧ "Состав набора".
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("Номенклатура");
	СтруктураПолей.Вставить("Количество");
	СтруктураПолей.Вставить("Цена");
	ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "СоставНабора", СтруктураПолей, Отказ, Заголовок);

	Если Не Отказ Тогда

		// Подготовим таблицу скидок для проведения.
		ТаблицаПоСкидкам = ПодготовитьТаблицуСкидок(ТаблицаПоТоварам, СтруктураШапкиДокумента);

		ДвиженияПоРегистрам(РежимПроведения, СтруктураШапкиДокумента, ТаблицаПоТоварам, ТаблицаПоСкидкам, Отказ, Заголовок);
	КонецЕсли;
	
	//РРО
	
	Если НЕ ЧекПробитНаККМ 
		И Товары.Количество() > 0
		И Оплата.Количество() > 0 Тогда
		
		//МассПараметров = Новый Массив;
		//МассПараметров.Добавить(Ссылка);
		//ФоновыеЗадания.Выполнить("ОтправкаДокументовПРРО.ПровестиДокументПоПРРО", МассПараметров,Новый УникальныйИдентификатор,"Отправка чека через интерфейс кассира");
		
		стрОтвета = ОтправкаДокументовПРРО.ПровестиДокументПоПРРО(Ссылка);
		
		Если стрОтвета.Успешно Тогда
			ЧекПробитНаККМ = Истина;
			ФискальныйНомерЧека = стрОтвета.ФискальныйНомер;
			URLЧека = стрОтвета.URL;
			Записать();
			Если ЗначениеЗаполнено(Ссылка.ДокументОснование)
				И ТипЗнч(Ссылка.ДокументОснование) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда	
				//Проставим статус в документе оплаты 
				ДокОплата = Ссылка.ДокументОснование.ПолучитьОбъект();
				ДокОплата.СтатусДокумента = Перечисления.СтатусыДокументовОплаты.ЕстьДокументОплаты;
				ДокОплата.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
		
	Если ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда
		СформироватьВозвратОтПокупателя();
	Иначе
		Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда 
			Если ЗаказПокупателя.Организация = Справочники.Организации.НайтиПоНаименованию("ВЕЧІР ТЕЛЕКОМ ТОВ") тогда
				СформироватьОплатуОтПокупателяПлатежнойКартой();
			КонецЕсли;
		КонецЕсли;
		//Дандали В. 12.11.2025 +
		Если КассаККМ.Владелец <> Справочники.Организации.НайтиПоНаименованию("ВЕЧІР ТЕЛЕКОМ ТОВ") Тогда 
			СформироватьПоступлениеТоваров();
		КонецЕсли;
		//Дандали В. 12.11.2025 -
		
		СформироватьРеализациюТоваров();
		
	КонецЕсли;
	
	//Дандали В. 30.01.2026 +
	Если ТекущаяДата() > (КонецДня(ТекущаяДата()) + 11)- 60*60 + 30*60 //23:30:11
		И НЕ А_ОбщегоНазначенияСервер.СегодняУжеЕстьЧек() Тогда
		
		Если СтатусОтправкиПоПочте <> Перечисления.СтатусыОтправкиДокументовПоПочте.ОтправленПоПочте Тогда 
			А_ОбщегоНазначенияСервер.ЗаписатьДокументВОчередьНаОтправку(Ссылка);
		ИначеЕсли СтатусОтправкиПоПочте = Перечисления.СтатусыОтправкиДокументовПоПочте.ОтправленПоПочте 
			И А_ОбщегоНазначенияСервер.ПолучитьСтатусОтправкиДокумента(Ссылка) = "" Тогда
			А_ОбщегоНазначенияСервер.УстановитьСтатусОтправкиПоПочте(Ссылка, Перечисления.СтатусыОтправкиДокументовПоПочте.ОтправленПоПочте);
		КонецЕсли;
		
	КонецЕсли;
	//Дандали В. 30.01.2026 -
	
	//Дандали В. 15.04.2026 +
	Если ЗначениеЗаполнено(URLЧека) Тогда
		УзелОбмена = Константы.УзелОбменаССайтомСсылкамиНаЧек.Получить();
		Если НЕ ЗначениеЗаполнено(УзелОбмена) Тогда
			Возврат;
		КонецЕсли;
		
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Ссылка);
	КонецЕсли;
	//Дандали В. 15.04.2026 -
	
КонецПроцедуры // ОбработкаПроведения()

Процедура СформироватьПоступлениеТоваров()
	
		Если ЗначениеЗаполнено(ПоступлениеТоваров) Тогда 
			
			Об = ПоступлениеТоваров.ПолучитьОбъект();
			
		Иначе
			
			Об = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
			Об.Организация 		  = КассаККМ.Владелец;
			Об.Контрагент  		  = Справочники.Контрагенты.НайтиПоНаименованию("ВЕЧІР ТЕЛЕКОМ, ТОВ");
			Об.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоКоду("F00242565");
			Об.Дата		   	                  = НачалоДня(ТекущаяДата()) + 60*60*8;
			Об.ВидОперации	                  = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
			Об.Комментарий 	                  = "#Автоматически создан ИМ";
			Об.ВалютаДокумента 	              = Константы.ВалютаРегламентированногоУчета.Получить();
			Об.КратностьВзаиморасчетов        = 1;
			Об.КурсВзаиморасчетов             = 1;
			Об.ВидПоступления 	              = Перечисления.ВидыПоступленияТоваров.НаСклад;
			Об.СкладОрдер                     = ЗаказПокупателя.СкладГруппа;
			Об.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("631");
			Об.СчетУчетаРасчетовПоАвансам     = ПланыСчетов.Хозрасчетный.НайтиПоКоду("631");
			Об.ОтражатьВУправленческомУчете   = Ложь;
			Об.ОтражатьВБухгалтерскомУчете    = Истина;
			Об.Ответственный				  = ПараметрыСеанса.ТекущийПользователь;
			об.Подразделение			      = ЗаказПокупателя.Подразделение;
			Об.Проект 						  = ЗаказПокупателя.Проект;
		КонецЕсли;
		
		Для Каждого Строка из Товары Цикл 
			
			Если Строка.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			
				Продолжить;	
			
			КонецЕсли; 
			СтрокаТовара = об.Товары.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаТовара,Строка);
			СтрокаТовара.Склад = ЗаказПокупателя.СкладГруппа;
			
			СчетаУчета  = БухгалтерскийУчет.ПолучитьСчетаУчетаНоменклатуры(Справочники.Организации.ПустаяСсылка(),СтрокаТовара.Номенклатура.Ссылка,Справочники.Склады.ПустаяСсылка(), СтрокаТовара.Номенклатура.Ссылка.ВидНоменклатуры);
			СчетУчетаБУ = СчетаУчета.СчетУчетаБУ;
			
			СтрокаТовара.СчетУчетаБУ = ?(СчетУчетаБУ = ПланыСчетов.Хозрасчетный.ПустаяСсылка(),ПланыСчетов.Хозрасчетный.НайтиПоКоду("281"),СчетУчетаБУ);
		КонецЦикла;
		
		ДанныеПоЦенам = ПолучитьЦеныПоПартиям(об.Товары.Выгрузить());
		
		Для Каждого Строка из об.Товары Цикл
			
			Если Строка.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			
				Продолжить;	
			
			КонецЕсли; 
			
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Номенклатура", Строка.Номенклатура);
			СтрПоиска.Вставить("СерияНоменклатуры", Строка.СерияНоменклатуры);
			НайденныеСтроки = ДанныеПоЦенам.НайтиСтроки(СтрПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				НайденнаяЦена = ?(НайденныеСтроки[0].КоличествоКонечныйОстаток=0,1,НайденныеСтроки[0].СтоимостьКонечныйОстаток / НайденныеСтроки[0].КоличествоКонечныйОстаток);
				//Дандали В. 25.08.2025 +
				Если Об.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("e818acc3-d3f3-11e5-84b2-005056875f16")) // ФОП ШЕВЧУК Оксана
					И НайденныеСтроки[0].НДСКонечныйОстаток > 0 
					И НайденныеСтроки[0].КоличествоКонечныйОстаток > 0 Тогда
					НайденнаяЦена = НайденнаяЦена + НайденныеСтроки[0].НДСКонечныйОстаток / НайденныеСтроки[0].КоличествоКонечныйОстаток;			
				КонецЕсли;
				//Дандали В. 25.08.2025 -
				
				Строка.Цена = ?(НайденнаяЦена <1 ,1,НайденнаяЦена);
				строка.Сумма = Строка.Цена * Строка.Количество;
			Иначе
				Строка.Цена = 1;
				Строка.Сумма = 1;
				Об.флНетЦеныСебестоимости = Истина;	
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(Об.Организация) 
			ИЛИ НЕ ЗначениеЗаполнено(Об.Контрагент)
			ИЛИ НЕ ЗначениеЗаполнено(Об.ДоговорКонтрагента)
			ИЛИ НЕ ЗначениеЗаполнено(Об.СкладОрдер) Тогда
				Сообщить(НСтр("ru='Не удалось провести поступление товаров и услуг';uk='Не вдалося провести надходження товарів та послуг'"));
			Возврат;	
		КонецЕсли;
		
		об.Записать();
		об.Записать(РежимЗаписиДокумента.Проведение);

		ПоступлениеТоваров = об.Ссылка;
		Записать();

КонецПроцедуры

Процедура СформироватьРеализациюТоваров()
	
		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	(ВЫРАЗИТЬ(РеализацияТоваровУслуг.Ссылка.Сделка КАК Документ.ЗаказПокупателя)) = &Заказ
		|	И НЕ РеализацияТоваровУслуг.Ссылка.ПометкаУдаления
		|	И РеализацияТоваровУслуг.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Заказ", ЗаказПокупателя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		РеализацияТоваров = ВыборкаДетальныеЗаписи.Ссылка;
		Записать();
	КонецЕсли;
	
	


	Если не ЗначениеЗаполнено(РеализацияТоваров)  Тогда 
		
		Реализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Реализация.Склад     			   = ЗаказПокупателя.СкладГруппа;
		//Реализация.Заполнить(ЗаказПокупателя);
		
		Реализация.Дата 			       = ТекущаяДата() ;
		Реализация.ВалютаДокумента         = Константы.ВалютаРегламентированногоУчета.Получить();
		Реализация.КурсВзаиморасчетов      = 1;
		Реализация.КратностьВзаиморасчетов = 1;
		Реализация.Контрагент			   = ЗаказПокупателя.Контрагент;
		Реализация.ДоговорКонтрагента 	   = ЗаказПокупателя.ДоговорКонтрагента;
		Реализация.Организация 			   = ЗаказПокупателя.Организация;
		Реализация.Склад     			   = ЗаказПокупателя.СкладГруппа;
		Реализация.ВидОперации     		   = Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия;
		Реализация.Подразделение		   = ЗаказПокупателя.Подразделение;
		Реализация.ОтражатьВБухгалтерскомУчете = Ложь;	
		Реализация.ОтражатьВУправленческомУчете = Истина;
		Реализация.Сделка = ЗаказПокупателя;
		Реализация.ВидПередачи = Перечисления.ВидыПередачиТоваров.СоСклада;
		Реализация.Проект 	   = ЗаказПокупателя.Проект;
		//Дандали В. 08.04.2024 +
		//Задача №008870
		Реализация.УчитыватьНДС 	= Истина;
		Реализация.СуммаВключаетНДС = Истина;
		//Дандали В. 25.11.2025 +
		Если ЗаказПокупателя.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")) Тогда //Вечер
			Реализация.АвторасчетНДС 	= Истина;
		Иначе
			Реализация.АвторасчетНДС 	= Ложь;
		КонецЕсли;
		//Дандали В. 25.11.2025 -
		
		//Дандали В. 08.04.2024 -

		Реализация.Товары.Загрузить(ЗаказПокупателя.Товары.Выгрузить());
		Для Каждого Строка из Реализация.Товары Цикл 
			Если ЗаказПокупателя.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")) Тогда //Вечер
				Строка.ставкаНДС = Перечисления.СтавкиНДС.НДС20;
			Иначе
				Строка.ставкаНДС = Перечисления.СтавкиНДС.БезНДС;
			КонецЕсли;
			
			Строка.НалоговоеНазначение = Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_Облагаемая;
			Строка.СхемаРеализации     = Справочники.СхемыРеализации.Товары;
			СчетаУчета  = БухгалтерскийУчет.ПолучитьСчетаУчетаНоменклатуры(Справочники.Организации.ПустаяСсылка(),Строка.Номенклатура.Ссылка,Справочники.Склады.ПустаяСсылка(), Строка.Номенклатура.Ссылка.ВидНоменклатуры);
			СчетУчетаБУ = СчетаУчета.СчетУчетаБУ;
			
			Строка.СчетУчетаБУ = ?(СчетУчетаБУ = ПланыСчетов.Хозрасчетный.ПустаяСсылка(),ПланыСчетов.Хозрасчетный.НайтиПоКоду("281"),СчетУчетаБУ);
			
			СписатьСРезерва = Ложь;
			СтрПоиска = Новый Структура;
			СтрПоиска.Вставить("Номенклатура", строка.Номенклатура);
			СтрПоиска.Вставить("СерияНоменклатуры", строка.СерияНоменклатуры);
			
			НайденныеСтроки = ЗаказПокупателя.Товары.НайтиСтроки(СтрПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ДанныеЗаказа = НайденныеСтроки[0];
				Если ЗначениеЗаполнено(ДанныеЗаказа.Размещение) Тогда
					Строка.Склад = ДанныеЗаказа.Размещение;
					СписатьСРезерва = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если СписатьСРезерва Тогда
				Строка.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.ИзРезерва;
			Иначе
				Строка.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.СоСклада;
			КонецЕсли;
			
		КонецЦикла;
		
		Реализация.Услуги.Загрузить(ЗаказПокупателя.Услуги.Выгрузить());
		
		Для каждого СтрУ Из Реализация.Услуги  Цикл
			
			СтрУ.СхемаРеализации = Справочники.СхемыРеализации.НайтиПоНаименованию("ИМ");
			СтрУ.ЗаказПокупателя = ЗаказПокупателя;
			
		КонецЦикла; 
		
		Если Реализация.Товары.Количество() ИЛИ Реализация.Услуги.Количество() Тогда 
			Реализация.Записать();
			//Дандали В. 12.11.2025 +
			//Если ПолучитьСтатусЗаказа(ЗаказПокупателя)<> "Новий (оплачений)" Тогда 
			Если ЗаказПокупателя.СтатусИМ <> Перечисления.СтатусыЗаказаИМ.НовоеОплачено Тогда
			//Дандали В. 12.11.2025 -
			
				Попытка
				Реализация.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				//Сообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
			РеализацияТоваров = Реализация.Ссылка;
			Записать();
		КонецЕсли;
		
		//Дандали В. 02.02.2024     
		//Реализация по бух учету 
		//Дандали В. 08.03.2024 + 
		Если ЗаказПокупателя.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("e818acc3-d3f3-11e5-84b2-005056875f16")) Тогда //ФОП ШЕВЧУК Оксана
		//Дандали В. 08.02.2024
			РеализацияБух = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			РеализацияБух.Склад     			   		= ЗаказПокупателя.СкладГруппа;
			РеализацияБух.СозданПоЧекуККМ				= Истина;
			РеализацияБух.Дата 			       			= ТекущаяДата() ;
			РеализацияБух.ВалютаДокумента         		= Константы.ВалютаРегламентированногоУчета.Получить();
			РеализацияБух.КурсВзаиморасчетов      		= 1;
			РеализацияБух.КратностьВзаиморасчетов 		= 1;
			РеализацияБух.Контрагент			   		= Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор("1882c70e-281f-11e8-80dd-363164353037")); //ШЕВЧУК ОКсана ФОП
			РеализацияБух.ДоговорКонтрагента 	   		= Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор("48b27d68-b5db-11ee-bf3c-00155d0a1408"));
			РеализацияБух.Организация 			   		= Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("fb9d803a-0f76-459e-a239-1900ccd279a9")); //Вечир телеком ТОВ
			РеализацияБух.Склад     			   		= ЗаказПокупателя.СкладГруппа;
			РеализацияБух.ВидОперации     		   		= Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия;
			РеализацияБух.Подразделение		   			= ЗаказПокупателя.Подразделение;
			РеализацияБух.ОтражатьВБухгалтерскомУчете 	= Истина;	

Функция СуществуютДокументыМаршрутныйЛист()
	
	СумествуютДокументыЗаДанныйПериод = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МаршрутныйЛист.Ссылка КАК Документ
		|ИЗ
		|	Документ.МаршрутныйЛист КАК МаршрутныйЛист
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(МаршрутныйЛист.ПериодРегистрации, МЕСЯЦ) = &ПериодРегистрации
		|	И МаршрутныйЛист.Ссылка <> &Ссылка
		|	И МаршрутныйЛист.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ПериодРегистрации", НачалоМесяца(ПериодРегистрации));
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СумествуютДокументыЗаДанныйПериод = Истина;
		Сообщить("Документ за такий період вже існує - " + ВыборкаДетальныеЗаписи.Документ);
	КонецЕсли;

	Возврат СумествуютДокументыЗаДанныйПериод;
	
КонецФункции
